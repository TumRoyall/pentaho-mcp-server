    <entry>
      <name>insert etl log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO GRC_PROD_IAS.IAS_ETL_JOB_LOGS(
		UNIKEY_ID,
		CHANNEL,
		NODE,
		JOB_NAME,
		PARAMETERS,
		FROM_DATE,
		"TO_DATE",
		STATE,
		CREATE_DATE)
VALUES (
     	'${UNIKEY_ID}',
		'${CHANNEL}',
		'internal',
		'${Internal.Job.Name}',
		'${PARAMETERS}',
		TRUNC(SYSDATE),
		NULL,
		2,
		TRUNC(SYSDATE)
);

COMMIT</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>conn_ias_dc</connection>
