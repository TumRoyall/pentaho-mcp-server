      <name>update log success</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE GRC_PROD_IAS.IAS_ETL_JOB_LOGS
SET 
	STATE = 0,
	"TO_DATE" = TRUNC(SYSDATE),
	LAST_UPDATE_DATE = TRUNC(SYSDATE)
WHERE
	UNIKEY_ID = '${UNIKEY_ID}'
	AND TRUNC(CREATE_DATE) = TRUNC(SYSDATE)
	AND STATE = 2
	AND TO_DATE IS NULL;

COMMIT</sql>
