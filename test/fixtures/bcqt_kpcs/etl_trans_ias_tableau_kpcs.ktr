  <step>
    <name>ias_remediation_recommendation</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_ias_dc</connection>
    <sql>SELECT  
    	rcm.REMEDIATION_RECOMMENTION_ID,
    	rcm.PROGRAM_RECOMMEND_CODE,

    -- Đơn vị ROOT (CN / HO)
    	org_root.ORG_GROUP        AS ORG_GROUP_ROOT,
    	org_root.ORG_NAME_MANAGE  AS ORG_NAME_ROOT,

    -- Đơn vị trực tiếp (PGD / CN / HO)
    	org.ORG_GROUP             AS ORG_GROUP,
    	org.ORG_NAME              AS ORG_NAME,
		org.ORG_CODE_MANAGE       AS ORG_CODE_MANAGER,

    	rcm.DETECT_GROUP as TYPE,
        rcm.org_code,
        pr.CODE,
		pr.PERIOD,
        pr.year,
		pr.REMEDIATION_PERIOD_ID,
        rcm.REMEDIATION_DATE,
        case
            when trunc(pr.DATE_LIMIT) >= trunc(REMEDIATION_DATE) then 1
            when trunc(pr.DATE_LIMIT) &lt; trunc(REMEDIATION_DATE) then 0
            else null
        end as DUE_STATUS, 
        rcm.RECOMMEND_STATUS,
        rcm.RISK_LEVEL,
	    rcm.PROGRAM_RELEASE_CODE,
		rcm.IS_ASSIGNED_TO_UNIT,
    	TRUNC(rcm.CREATE_DATE)      AS CREATE_DATE,
    	TRUNC(rcm.LAST_UPDATE_DATE) AS UPDATE_DATE

FROM GRC_PROD_IAS.ias_remediation_recommendation rcm

LEFT JOIN GRC_PROD_ADM.ADM_ORGANIZATIONS ORG 
ON ORG.ORG_CODE = rcm.ORG_CODE AND ORG.IS_DELETED = 0

LEFT JOIN GRC_PROD_ADM.ADM_ORGANIZATIONS org_root 
ON org_root.ORG_CODE = ORG.ORG_CODE_MANAGE AND ORG.IS_DELETED = 0

LEFT JOIN GRC_PROD_IAS.ias_remediation_period pr
       ON rcm.REMEDIATION_PERIOD_ID = pr.REMEDIATION_PERIOD_ID and pr.is_deleted = 0

where rcm.is_deleted = 0</sql>
    <limit>0</limit>
