  <step>
    <name>logic lay data</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_ias_dc</connection>
    <sql>WITH PROGRAM_ROLES AS (
    SELECT
        PROGRAM_RELEASE_CODE,
        MAX(CASE WHEN SYS_CATEGORY_CODE = 'PROGRAM-AUDIT-MANAGER' THEN SYS_USER_NAME END) AS AM_USER,
        MAX(CASE WHEN SYS_CATEGORY_CODE = 'PROGRAM-CAE' THEN SYS_USER_NAME END) AS CAE_USER,
        COUNT(DISTINCT CASE WHEN SYS_CATEGORY_CODE = 'PROGRAM-DEPUTY-AUDIT-MANAGER' THEN SYS_USER_NAME END) AS DEPUTY_COUNT,
        MAX(CASE WHEN SYS_CATEGORY_CODE = 'PROGRAM-DEPUTY-AUDIT-MANAGER' THEN SYS_USER_NAME END) AS SINGLE_DEPUTY_USER
    FROM GRC_PROD_IAS.IAS_PROGRAM_INFO_RESOURCE
    WHERE IS_DELETED = 0
    GROUP BY PROGRAM_RELEASE_CODE
),

CONTROL_MEMBERS_PER_RR AS (
    SELECT
        LRR.PROGRAM_RECOMMEND_CODE,
        LISTAGG(DISTINCT sv.user_name, ',') WITHIN GROUP (ORDER BY sv.user_name) AS CONTROL_MEMBER_USERNAMES
    FROM GRC_PROD_IAS.IAS_REMEDIATION_RECOMMENDATION LRR
    JOIN GRC_PROD_IAS.IAS_PROGRAM_DETECTION_RECOMMENDATION_INTERNAL PDRI2
        ON PDRI2.CODE = LRR.PROGRAM_RECOMMEND_CODE
       AND PDRI2.IS_DELETED = 0
    JOIN GRC_PROD_IAS.IAS_PROGRAM_DETECTION_RECOMMENDATION_REF REF2
        ON REF2.PROGRAM_DETECT_CODE = PDRI2.PROGRAM_DETECTION_CODE
       AND REF2.PROGRAM_RELEASE_CODE = PDRI2.PROGRAM_RELEASE_CODE
       AND REF2.IS_DELETED = 0
    JOIN GRC_PROD_IAS.IAS_PROGRAM_IDENTITY_INTERNAL IDT2
        ON IDT2.IDENTIFY_CODE = REF2.IDENTITY_CODE
       AND IDT2.PROGRAM_RELEASE_CODE = PDRI2.PROGRAM_RELEASE_CODE
       AND IDT2.IS_DELETED = 0
    JOIN GRC_PROD_IAS.IAS_PROGRAM_PROCEDURE PP
        ON PP.CODE = IDT2.PROCEDURE_CODE
       AND PP.IS_DELETED = 0
    JOIN GRC_PROD_IAS.IAS_PROGRAM_SECTION_SUPERVISOR SV
        ON SV.PROGRAM_SECTION_CODE = PP.SECTION_L1_CODE
       AND SV.IS_DELETED = 0
    GROUP BY LRR.PROGRAM_RECOMMEND_CODE
),

BASE_DATA AS (
    SELECT
		RR.REMEDIATION_RECOMMENTION_ID,
        RR.PROGRAM_RECOMMEND_CODE,
        RR.PROGRAM_RELEASE_CODE,
        RR.RECOMMEND_STATUS,
        RR.RISK_LEVEL,
        RR.REMEDIATION_PERIOD_ID,
        IDT.CREATED_BY AS IDENTITY_USER,
        PDRI.CREATED_BY AS DETECT_USER,
        CMP.CONTROL_MEMBER_USERNAMES,
        PR.AM_USER,
        PR.CAE_USER,
        PR.DEPUTY_COUNT,
        PR.SINGLE_DEPUTY_USER

    FROM GRC_PROD_IAS.IAS_REMEDIATION_RECOMMENDATION RR
    LEFT JOIN GRC_PROD_IAS.IAS_REMEDIATION_PERIOD RP
        ON RP.REMEDIATION_PERIOD_ID = RR.REMEDIATION_PERIOD_ID
    LEFT JOIN PROGRAM_ROLES PR
        ON RR.PROGRAM_RELEASE_CODE = PR.PROGRAM_RELEASE_CODE
    LEFT JOIN GRC_PROD_IAS.IAS_PROGRAM_DETECTION_RECOMMENDATION_INTERNAL PDRI
        ON PDRI.CODE = RR.PROGRAM_RECOMMEND_CODE
       AND PDRI.IS_DELETED = 0
    LEFT JOIN GRC_PROD_IAS.IAS_PROGRAM_DETECTION_RECOMMENDATION_REF REF
        ON REF.PROGRAM_DETECT_CODE = PDRI.PROGRAM_DETECTION_CODE
       AND REF.PROGRAM_RELEASE_CODE = PDRI.PROGRAM_RELEASE_CODE
       AND REF.IS_DELETED = 0
    LEFT JOIN GRC_PROD_IAS.IAS_PROGRAM_IDENTITY_INTERNAL IDT
        ON IDT.IDENTIFY_CODE = REF.IDENTITY_CODE
       AND IDT.PROGRAM_RELEASE_CODE = PDRI.PROGRAM_RELEASE_CODE
       AND IDT.IS_DELETED = 0
    LEFT JOIN CONTROL_MEMBERS_PER_RR CMP
        ON CMP.PROGRAM_RECOMMEND_CODE = RR.PROGRAM_RECOMMEND_CODE
),

FILTERED_RESOURCES AS (
    SELECT DISTINCT
        PIR.SYS_FULL_NAME,
        PIR.SYS_USER_NAME,
        PIR.PROGRAM_RELEASE_CODE
    FROM GRC_PROD_IAS.IAS_PROGRAM_INFO_RESOURCE PIR
    WHERE PIR.IS_DELETED = 0
      AND PIR.SYS_CATEGORY_CODE IN (
            'PROGRAM-AUDIT-MANAGER',
            'PROGRAM-DEPUTY-AUDIT-MANAGER',
            'PROGRAM-AUDITOR',
            'PROGRAM-AUDIT-LEADER',
            'PROGRAM-CAE'
      )
      AND EXISTS (
          SELECT 1
          FROM BASE_DATA BD
          WHERE BD.PROGRAM_RELEASE_CODE = PIR.PROGRAM_RELEASE_CODE
      )
),

USER_REC_MAPPING AS (
    SELECT DISTINCT
		BD.REMEDIATION_RECOMMENTION_ID AS ID,
        RES.SYS_FULL_NAME AS FULL_NAME,
        RES.SYS_USER_NAME AS USER_NAME,
        BD.PROGRAM_RECOMMEND_CODE,
        BD.RECOMMEND_STATUS,
        BD.RISK_LEVEL,
        BD.REMEDIATION_PERIOD_ID
    FROM FILTERED_RESOURCES RES
    LEFT JOIN BASE_DATA BD
        ON RES.PROGRAM_RELEASE_CODE = BD.PROGRAM_RELEASE_CODE
       AND (
            RES.SYS_USER_NAME = BD.IDENTITY_USER
         OR RES.SYS_USER_NAME = BD.DETECT_USER
         OR INSTR(',' || BD.CONTROL_MEMBER_USERNAMES || ',', ',' || RES.SYS_USER_NAME || ',') > 0
         OR RES.SYS_USER_NAME = BD.AM_USER
       )
),

FILTERED_DATA AS (
    SELECT *
    FROM USER_REC_MAPPING M
    WHERE M.USER_NAME IS NOT NULL
)

SELECT
	ID,
    FULL_NAME,
    USER_NAME,
