<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>mini</name>
    <parameters>
    </parameters>
  </info>
  <order>
    <hop>
      <from>in</from>
      <to>out</to>
      <enabled>Y</enabled>
