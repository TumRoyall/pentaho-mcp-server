      <xloc>115</xloc>
      <yloc>45</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Table input 6 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select case 
                    when upper(tsdb) = 'YES' then 'Y'
                    when upper(tsdb) = 'NO' then 'N'
                    else 'N'
                end as tsdb,
(case when sub_product in ('189', '192') and y_category like '1700%' then 'SME' 
when sub_product in ('190', '191', '198') and Y_category like '1700%' then 'NHS' 
when sub_product = '193' and Y_category like '1700%' then 'CIB' 
when sub_product = '194' and Y_category like '1700%' then 'FI' 
when y_category like '1700%' then 'INDIV'  
when t.sector >= 1910 and t.sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)  
then 'NHS'  
when t.sector >= 1910 and t.sector &lt;= 1969 then 'INDIV'  
when t.sector >= 1970 and t.sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)  
then 'NHS'  
when t.sector >= 1970 and t.sector &lt;= 1979 then 'CIB'  
when t.sector >= 1980 and t.sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)  
then 'NHS'  
when t.sector >= 1980 and t.sector &lt;= 1999 then 'SME'
else t.y_khoi end) y_khoi,
t.* from apps.tr_ku t where transaction_date = to_date('${PRD_ID}','yyyyMMdd')--from etl.int_tienvay t
and soku not like 'LD%' and soku not like 'PD%' and soku not like 'VND%'
and gl like '275%'</sql>
