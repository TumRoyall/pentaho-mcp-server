  <step>
    <name>Table input 6</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select case 
                    when upper(tsdb) = 'YES' then 'Y'
                    when upper(tsdb) = 'NO' then 'N'
                    else 'N'
                end as tsdb,
(case when sub_product in ('189', '192') and y_category like '1700%' then 'SME' 
when sub_product in ('190', '191', '198') and Y_category like '1700%' then 'NHS' 
when sub_product = '193' and Y_category like '1700%' then 'CIB' 
when sub_product = '194' and Y_category like '1700%' then 'FI' 
when y_category like '1700%' then 'INDIV'  
when t.sector >= 1910 and t.sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)  
then 'NHS'  
when t.sector >= 1910 and t.sector &lt;= 1969 then 'INDIV'  
when t.sector >= 1970 and t.sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)  
then 'NHS'  
when t.sector >= 1970 and t.sector &lt;= 1979 then 'CIB'  
when t.sector >= 1980 and t.sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)  
then 'NHS'  
when t.sector >= 1980 and t.sector &lt;= 1999 then 'SME'
else t.y_khoi end) y_khoi,
t.*,
case WHEN
ftp_prod in
(--'TD504', ( theo ##RE-798733##)
'TD505','TD506','TD507','TD508','TD510','TD511',
'TD512','TD513','TD514','TD515','TD516','TD518','TD519',
'TD520','TD521','TD522','TD523','TD524','TD525','TD526',
'TD527','TD528','TD529','TD530','TD542','TD543','TD544','TD545') then 'TD101'
when mbld_type in ('4150021','4150022') then 'TD550'
when mbld_type in ('1150028','1150029','1160026','1160027') then 'TD551'
when mbld_type in ('1160003') then 'TD552'
when mbld_type in ('2150021') then 'TD553'
when mbld_type in ('1160005') then 'TD557'
when mbld_type in ('1160045') then 'TD558'
when mbld_type in ('1160021','1160022','1160023') then 'TD547'
when mbld_type in ('1150021','1150022','1150023','1160028','1160029','1160030','1160031') then 'TD548'
when mbld_type in ('4150023') then 'TD549' else ftp_prod end ftp_prod_chuan from apps.tr_ku t where transaction_date = to_date('${PRD_ID}','yyyyMMdd')--etl.int_tienvay t</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
