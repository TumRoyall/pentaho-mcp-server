      <xloc>272</xloc>
      <yloc>144</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>APPS.TR_KU</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select 
(case when x.soku like 'PD%' then substr (x.soku,1,14) else x.soku end) taikhoan,
x.mbld_type,
x.product_code,
x.productgr_code,
x.y_category category,
x.sub_product,
(case when to_number (x.mjacctcd) &lt; 10000 then 12 else to_number(x.kyhan/30) end) loc_term,
(case 
when to_number (x.mjacctcd) &lt; 10000 then 'NH'
when to_number (x.kyhan/30) &lt;=12 then 'NH'
when (to_number (x.kyhan/30) >12 and to_number (x.kyhan/30) &lt;= 60) then 'TH'
else 'DH' end) loaikyhan,
x.sector,
x.nhomno2 nhomno_xhtd,
x.nhomno nhomno_liendoi,x.khoi,x.product_type,x.ftp_prod ftp_code,x.project_id from apps.tr_ku x
where transaction_date= 
(select max(dayid) from apps.mb_dim_time where dayid &lt;='30-apr-2021'--to_date(${PRD_ID},'yyyyMMdd')
and is_working_day=1)
group by (case when x.soku like 'PD%' then substr (x.soku,1,14) else x.soku end) ,
x.mbld_type,
x.product_code,
x.productgr_code,
x.y_category ,
x.sub_product ,
(case when to_number (x.mjacctcd) &lt; 10000 then 12 else to_number(x.kyhan/30) end) ,
(case 
when to_number (x.mjacctcd) &lt; 10000 then 'NH'
when to_number (x.kyhan/30) &lt;=12 then 'NH'
when (to_number (x.kyhan/30) >12 and to_number (x.kyhan/30) &lt;= 60) then 'TH'
else 'DH' end) ,
x.sector,
x.nhomno2 ,
x.nhomno,x.khoi,x.product_type,x.ftp_prod,x.project_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
