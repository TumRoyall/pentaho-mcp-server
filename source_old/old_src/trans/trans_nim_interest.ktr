  <step>
    <name>APPS.MB_TR_KU_TATTOAN</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select 
(case when x.soku like 'PD%' then substr (x.soku,1,14) else x.soku end) taikhoan,
x.mbld_type,
x.product_code,
x.productgr_code,
x.category category,
x.sub_product,
(case when to_number (x.category) &lt; 10000 then 12 else x.kyhan/30 end) loc_term,
(case 
when to_number (x.category) &lt; 10000 then 'NH'
when to_number (x.kyhan/30) &lt;=12 then 'NH'
when (to_number (x.kyhan/30) >12 and to_number (x.kyhan/30) &lt;= 60) then 'TH'
else 'DH' end) loaikyhan,
x.sector,
x.nhomno_xhtd nhomno_xhtd,
x.nhomno nhomno_liendoi,x.khoi,x.product_type
from 
(select dense_rank () over (partition by (case when a.soku like 'PD%' then substr (a.soku,1,14) else a.soku end) order by a.transaction_date desc) stt, 
a.*
from apps.mb_tr_ku_tattoan a
where 
last_day(a.transaction_date)= to_date('${PRD_ID}','yyyyMMdd') 
and substr(a.gl,1,1)=2
) x
where x.stt = 1
group by (case when x.soku like 'PD%' then substr (x.soku,1,14) else x.soku end) ,
x.mbld_type,
x.product_code,
x.productgr_code,
x.category ,
x.sub_product,
(case when to_number (x.category) &lt; 10000 then 12 else x.kyhan/30 end) ,
(case 
when to_number (x.category) &lt; 10000 then 'NH'
when to_number (x.kyhan/30) &lt;=12 then 'NH'
when (to_number (x.kyhan/30) >12 and to_number (x.kyhan/30) &lt;= 60) then 'TH'
else 'DH' end) ,
x.sector,
x.nhomno_xhtd,
x.nhomno,x.khoi,x.product_type</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
