    <connection>tckt_dc</connection>
    <sql>SELECT 
NULL PHAN_LOAI_THE
,NULL loai_giao_dich
,B.SECTOR_CODE
,NULL CHG_CODE
,a.MA_CN
,a.makh
,nvl(a.khoi,cus.KHOI) khoi
,a.fee_pay tienno
,'ETL.TMP_FILE_THN_HT_MTHL' SOURE_IMPORT
,a.product_code
,TO_DATE('${PRD_ID}', 'YYYYMMDD') PARTITION_DATE
,a.fee_pay TIENNO_VND
,NULL bin8
,NULL bin6
,CASE WHEN nvl(a.khoi,cus.KHOI) = 'NHS' THEN '68621' ELSE '68601' END acctnbr                       
, NVL(C1.T24_LINE, C2.T24_LINE) || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)  LINE_T24
, SUBSTR(NVL(C1.T24_LINE, C2.T24_LINE), -4) 
                          || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)         LINE_GL
, NVL(C1.LEVEL3_COA_CODE, C2.LEVEL3_COA_CODE)                                      TK
, cus.SECTOR
, cus.PHAN_KHUC PKKH    
FROM etl.TMP_FILE_THN_HT_MTHL    a
left join apps.FIN_SMY_CUSTOMER_MONTHLY cus on A.makh = cus.makh and cus.transaction_date = last_day(to_date(${PRD_ID}, 'yyyymmdd'))
LEFT JOIN ETL.MPA_MAPPING_SECTOR B ON cus.khoi = B.KHOI
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C1 
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C1.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C1.SECTOR_CODE IS NOT NULL THEN INSTR(B.SECTOR_CODE, C1.SECTOR_CODE)
        ELSE 0 END
    END > 0
  AND (CASE WHEN nvl(a.khoi,cus.KHOI) = 'NHS' THEN '68621' ELSE '68601' END) = C1.CATE_CODE
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C2
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C2.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C2.SECTOR_CODE IS NULL THEN 1
        ELSE 0 END
    END > 0
  AND (CASE WHEN nvl(a.khoi,cus.KHOI) = 'NHS' THEN '68621' ELSE '68601' END) = C2.CATE_CODE
  )</sql>
