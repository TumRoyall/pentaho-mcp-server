  <step>
    <name>KSS_TSDB</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH nguon AS
(
SELECT
    NULL    PHAN_LOAI_THE 
  , NULL    LOAI_GIAO_DICH
  , NULL     CHG_CODE
  ,                 MA_CN
  ,                 KHOI
  ,CASE WHEN makh IS NULL AND khoi ='SME' THEN '1000'
              WHEN makh IS NULL AND khoi ='CIB' THEN '3000'
              WHEN makh IS NULL AND khoi ='INDIV' THEN '1700'
              WHEN makh IS NULL AND khoi ='NHS' THEN '1910'
              ELSE makh END makh
  ,                 TIENNO
  ,                 SOURE_IMPORT
  ,                 TIENNO_VND  
  ,                 PARTITION_DATE      
  ,                 ACCTNBR      
  , NULL     PRODUCT_CODE
  , NULL    BIN8
  , NULL    BIN6
FROM
(
SELECT
  t1.CNC2  MA_CN
  ,CASE WHEN T1.KHOI IN ('KHCN','INDIV') THEN 'INDIV' ELSE t1.KHOI END KHOI
  ,nvl(obc.CODE_T24,null) MAKH
  ,nvl(t1.PHI_DINHGIA,0) TIENNO
  ,'APPS.FIN_KSS_TSDB_CHITIET_MONTHLY' SOURE_IMPORT
  ,TO_DATE('${PRD_ID}', 'YYYYMMDD')       PARTITION_DATE
  ,nvl(t1.PHI_DINHGIA,0) TIENNO_VND
 , '68602'   ACCTNBR                                                                   
FROM APPS.FIN_KSS_TSDB_CHITIET_MONTHLY t1
LEFT JOIN ETL.ODS_BC_CMV03 obc
ON T1.MA_TS =obc.MA_TAI_SAN
AND t1.SO_BAOCAO =obc.SO_BC
WHERE t1.transaction_date =add_months(to_date(${PRD_ID}, 'yyyymmdd'),-1)
)
)
SELECT
a.PHAN_LOAI_THE
,a.loai_giao_dich
,B.SECTOR_CODE
,a.CHG_CODE
,a.MA_CN
,A.makh
,nvl(a.khoi,cus.KHOI) khoi
,(-1)* a.tienno tienno
,a.SOURE_IMPORT
,a.product_code
,a.PARTITION_DATE
,(-1)* a.TIENNO_VND TIENNO_VND
,a.bin8
,a.bin6
,a.acctnbr                      
, NVL(C1.T24_LINE, C2.T24_LINE) || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)  LINE_T24
, SUBSTR(NVL(C1.T24_LINE, C2.T24_LINE), -4)
                          || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)         LINE_GL
, NVL(C1.LEVEL3_COA_CODE, C2.LEVEL3_COA_CODE)                                      TK
, cus.SECTOR
, cus.PHAN_KHUC PKKH             
FROM nguon    a
left join apps.FIN_SMY_CUSTOMER_MONTHLY cus on A.makh = cus.makh and cus.transaction_date = last_day(to_date(${PRD_ID}, 'yyyymmdd'))
LEFT JOIN ETL.MPA_MAPPING_SECTOR B ON cus.khoi = B.KHOI
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C1
  ON CASE
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C1.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C1.SECTOR_CODE IS NOT NULL THEN INSTR(B.SECTOR_CODE, C1.SECTOR_CODE)
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C1.CATE_CODE
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C2
  ON CASE
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C2.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C2.SECTOR_CODE IS NULL THEN 1
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C2.CATE_CODE
</sql>
