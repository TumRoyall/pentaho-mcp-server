    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
    NULL                                                                              AS PHAN_LOAI_THE
  , NULL                                                                              AS LOAI_GIAO_DICH
  , B.SECTOR_CODE
  , A.CHG_CODE
  , A.CO_CODE                                                                         AS MA_CN
  , A.MAKH                          
  , CUS.KHOI                          
  , A.SOTIEN                                                                          AS TIENNO
  , 'ETL.TMP_THU_CHI_SONGPHUONG'                                                      AS SOURE_IMPORT
  , A.PRODUCT_CODE                          
  , TO_DATE('${PRD_ID}', 'YYYYMMDD')                                                  AS PARTITION_DATE
  , A.SOTIEN                                                                          AS TIENNO_VND
  , NULL                                                                              AS BIN8
  , NULL                                                                              AS BIN6
  , A.ACCTNBR
  , NVL(C1.T24_LINE, C2.T24_LINE) || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)    AS LINE_T24
  , SUBSTR(NVL(C1.T24_LINE, C2.T24_LINE), -4) 
                            || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)          AS LINE_GL
  , NVL(C1.LEVEL3_COA_CODE, C2.LEVEL3_COA_CODE)                                       AS TK
  , cus.SECTOR
  , cus.PHAN_KHUC AS PKKH
from (SELECT A.CHG_CODE, A.CO_CODE, A.MAKH, A.KHOI, SUM(A.SOTIEN) SOTIEN, A.PRODUCT_CODE, A.ACCTNBR FROM
ETL.TMP_THU_CHI_SONGPHUONG A
group by
A.CHG_CODE, A.CO_CODE, A.MAKH, A.KHOI, A.PRODUCT_CODE, A.ACCTNBR) A
LEFT JOIN ETL.MPA_MAPPING_SECTOR B ON A.KHOI = B.KHOI
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C1 
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C1.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C1.SECTOR_CODE IS NOT NULL THEN INSTR(B.SECTOR_CODE, C1.SECTOR_CODE)
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C1.CATE_CODE
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C2
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C2.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C2.SECTOR_CODE IS NULL THEN 1
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C2.CATE_CODE
LEFT JOIN ETL.ORS_TR_KHACHHANG_ACTIVE_M D ON A.MAKH = D.MAKH
LEFT JOIN ETL.ORS_MB_SME_PKKH_M E ON A.MAKH = E.MAKH AND E.PK_TYPE = 'PK_100' AND E.DTT_TYPE = '3'
left join apps.FIN_SMY_CUSTOMER_MONTHLY cus on a.makh = cus.makh and cus.transaction_date = last_day(to_date(${PRD_ID}, 'yyyymmdd'))</sql>
