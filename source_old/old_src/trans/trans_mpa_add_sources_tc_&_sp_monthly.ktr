    <connection>tckt_dc</connection>
    <sql>WITH 
khoi_xac_dinh as (
    select 
    	a.KHOI,
    	a.MAKH,
        a.loai_tien,
        a.ma_cn,
        count(a.ma_gd) sl_gd,
        sum(a.GIA_TRI_GD_NGUYENTE) sotien,
        sum(a.GIA_TRI_GD_VND) sotien_qd,
        sum(a.PHI_NGUYEN_TE) phi,
        sum(a.PHI_VND) phi_vnd
    from APPS.FIN_PNL_CITAD_MONTHLY  a
    where partition_date =to_date(${PRD_ID}, 'yyyymmdd')
    AND a.KHOI in ('INDIV', 'SME', 'CIB', 'DVC', 'FI', 'NHS', 'BO')
    group by a.KHOI,
        a.loai_tien,
        a.ma_cn,
        a.makh      
),
v_xd2 as (
    select 
    	a.KHOI,
        a.loai_tien,
        count(a.ma_gd) sl_gd,
        sum(a.GIA_TRI_GD_NGUYENTE) sotien,
        sum(a.GIA_TRI_GD_VND) sotien_qd,
        sum(a.PHI_NGUYEN_TE) phi,
        sum(a.PHI_VND) phi_vnd
    from APPS.FIN_PNL_CITAD_MONTHLY  a
   where a.partition_date =to_date(${PRD_ID}, 'yyyymmdd')
    AND a.KHOI in ('INDIV', 'SME', 'CIB', 'DVC', 'FI', 'NHS')
    group by a.KHOI,
        a.loai_tien
),
khoi_xd_total as (
    select loai_tien,
        sum(sl_gd) sl_gd,
        sum(sotien) sotien,
        sum(sotien_qd) sotien_qd,
        sum(phi) phi,
        sum(phi_vnd) phi_vnd
    from V_XD2
    group by loai_tien
),
khoi_ko_xac_dinh as (
    SELECT
    	a.loai_tien,
        count(a.ma_gd) sl_Gd,
        sum(a.GIA_TRI_GD_NGUYENTE) sotien,
        sum(a.GIA_TRI_GD_VND) sotien_qd,
        sum(a.PHI_NGUYEN_TE) phi,
        sum(a.PHI_VND) phi_vnd
    from APPS.FIN_PNL_CITAD_MONTHLY  a
    where a.partition_date =to_date(${PRD_ID}, 'yyyymmdd')
    AND nvl(a.KHOI, 'N/A') not in ('INDIV', 'SME', 'CIB', 'DVC', 'FI', 'NHS', 'BO')
    group by a.loai_tien
),
phan_bo_them as (
    select CASE WHEN T.KHOI = 'BO' THEN 'MB'
     ELSE T.KHOI END Khoi,
    	CASE WHEN t.khoi ='INDIV' THEN '1700'
    		WHEN T.KHOI = 'SME' THEN '1000'
    		WHEN T.KHOI = 'CIB' THEN '3000'
    		WHEN T.KHOI = 'FI' THEN '8000'
    		WHEN T.KHOI = 'NHS' THEN '1910'
    		WHEN T.KHOI = 'DVC' THEN '1100'
    		END  MAKH,  
    	'VN0010001' MA_CN, 
        t.loai_tien,
        round(t.sl_gd / x.sl_gd * k.sl_gd) sl_gd,
        t.sotien / x.sotien * k.sotien sotien,
        t.sotien_qd / x.sotien_qd * k.sotien_qd sotien_qd,
        t.phi / x.phi * k.phi phi,
        t.phi_vnd / x.phi_vnd * k.phi_vnd phi_vnd
    from v_xd2 t
        join khoi_xd_total x on t.loai_tien = x.loai_tien
        join khoi_ko_xac_dinh k on t.loai_tien = k.loai_tien
)
,
ALL_CITAD AS 
((
SELECT 
TO_DATE('${PRD_ID}', 'YYYYMMDD')	 NGAY_GD, -- SET NGAY CUOI CUNG CUA THANG chay toi
CASE WHEN KHOI ='BO' THEN 'MB'
ELSE khoi END khoi,
CASE WHEN KHOI ='BO' THEN '2001' 
ELSE MAKH END makh,
LOAI_TIEN,
ma_cn,
sum(phi) TIENNO,
SUM(phi_vnd) TIENNO_VND,
'APPS.FIN_PNL_CITAD_MONTHLY' SOURE_IMPORT
FROM khoi_xac_dinh a
GROUP BY 
CASE WHEN KHOI ='BO' THEN 'MB'
ELSE khoi END,
CASE WHEN KHOI ='BO' THEN '2001' 
ELSE MAKH END ,
LOAI_TIEN,
ma_cn
)				
UNION ALL 
(SELECT 
TO_DATE('${PRD_ID}', 'YYYYMMDD')	 NGAY_GD, -- SET NGAY CUOI CUNG CUA THANG chay toi
KHOI,
MAKH,
loai_tien,
MA_CN,
phi TIENO,
phi_vnd TIENO_VND,
'APPS.FIN_PNL_CITAD_MONTHLY' SOURE_IMPORT
FROM phan_bo_them
)
)
SELECT 
a.PHAN_LOAI_THE
,a.loai_giao_dich
,B.SECTOR_CODE
,a.CHG_CODE
,a.MA_CN
,a.makh
,a.KHOI
,a.tienno*(-1) TIENNO
,a.SOURE_IMPORT
,a.product_code
,a.PARTITION_DATE
,a.TIENNO_VND*(-1) TIENNO_VND
,a.bin8
,a.bin6
,a.acctnbr
, NVL(C1.T24_LINE, C2.T24_LINE) || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)  LINE_T24
, SUBSTR(NVL(C1.T24_LINE, C2.T24_LINE), -4) 
                          || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)         LINE_GL
, NVL(C1.LEVEL3_COA_CODE, C2.LEVEL3_COA_CODE)                                      TK
, cus.SECTOR
, cus.PHAN_KHUC PKKH
--, NULL CHG_TYPE		
FROM 
	(
SELECT 
    NULL    PHAN_LOAI_THE
  , NULL    LOAI_GIAO_DICH
  , NULL 	CHG_CODE
  , MA_CN
  ,KHOI
  ,MAKH
  ,TIENNO 
  ,SOURE_IMPORT
  ,'15411' 	PRODUCT_CODE
  ,TO_DATE('${PRD_ID}', 'YYYYMMDD')	PARTITION_DATE
  ,TIENNO_VND
  , NULL BIN8
  , NULL  BIN6
  , CASE WHEN makh ='2001' THEN '68113' ELSE '68101' end	ACCTNBR											 
FROM ALL_CITAD) a
LEFT JOIN ETL.MPA_MAPPING_SECTOR B ON A.khoi = B.KHOI
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C1 
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C1.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C1.SECTOR_CODE IS NOT NULL THEN INSTR(B.SECTOR_CODE, C1.SECTOR_CODE)
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C1.CATE_CODE
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C2
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C2.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C2.SECTOR_CODE IS NULL THEN 1
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C2.CATE_CODE
left join apps.FIN_SMY_CUSTOMER_MONTHLY cus on A.makh = cus.makh and cus.transaction_date = last_day(to_date(${PRD_ID}, 'yyyymmdd'))</sql>
