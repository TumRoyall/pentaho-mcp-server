  <step>
    <name>APPS.FIN_ODS_CHARGE_BIDV_DAILY_RPT 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH KHOI_XACDINH AS 
(
SELECT 
 makh,
CASE WHEN khoi IS NULL THEN 'MB' ELSE KHOI END khoi, -- D/C BO SUNG KHOI NULL VE KHOI MB
 ma_cn,
 currency,
 count(FT_id) SL_buttoan,
 sum(TIENNO) sotien,
 sum(TIENNO_VND)  sotien_quydoi,
 sum(phi_vnd) tongphi
FROM APPS.FIN_ODS_CHARGE_BIDV_DAILY_RPT 
 where partition_date = to_date('${PRD_ID}', 'yyyymmdd')
-- AND khoi in ('CIB','SME','INDIV','NHS','FI','DVC')
  group by 
  makh,
  khoi,
  ma_cn,
  currency
 )
 ,
 KHOI_XACDINH_2 AS 
(
SELECT 
 khoi,
 ma_cn,
 currency,
 count(FT_id) SL_buttoan,
 sum(TIENNO) sotien,
 sum(TIENNO_VND)  sotien_quydoi,
 sum(phi_vnd) tongphi
 FROM APPS.FIN_ODS_CHARGE_BIDV_DAILY_RPT 
 where partition_date = to_date('${PRD_ID}', 'yyyymmdd')
-- AND khoi in ('CIB','SME','INDIV','NHS','FI','DVC')
  group by 
  khoi,
  currency,
  ma_cn
 )
 ,
 total AS 
(
SELECT 
 --khoi,
 currency,
 count(FT_id) SL_buttoan,
 sum(TIENNO) sotien,
 sum(TIENNO_VND)  sotien_quydoi,
 sum(phi_vnd) tongphi
 FROM APPS.FIN_ODS_CHARGE_BIDV_DAILY_RPT 
 where partition_date = to_date('${PRD_ID}', 'yyyymmdd')
-- AND khoi in ('CIB','SME','INDIV','NHS','FI','DVC')
  group by 
  --khoi,
  currency
 )
--  ,
-- KHOI_KO_XACDINH_total AS 
--(
--SELECT 
-- --khoi,
-- currency,
-- count(FT_id) SL_buttoan,
-- sum(TIENNO) sotien,
-- sum(TIENNO_VND)  sotien_quydoi,
-- sum(phi_vnd) tongphi
-- FROM ETL.FIN_ODS_CHARGE_BIDV_DAILY_RPT 
--where partition_date = to_date('${PRD_ID}', 'yyyymmdd')
-- AND nvl(khoi,'N/A') not in ('CIB','SME','INDIV','NHS','FI','DVC')
--  group by 
--    currency
-- )
-- ,
-- PHANBO_BOSUNG AS
-- ( 
--SELECT 
--CASE WHEN a.khoi ='INDIV' THEN '1700'
--        WHEN a.KHOI = 'SME' THEN '1000'
--        WHEN a.KHOI = 'CIB' THEN '3000'
--        WHEN a.KHOI = 'FI' THEN '8000'
--        WHEN a.KHOI = 'NHS' THEN '1910'
--        WHEN a.KHOI = 'DVC' THEN '1100'
--        when a.khoi is null then '2001'
--        END  MAKH,
-- case when a.khoi is null  then 'MB' else a.khoi end khoi,
-- a.ma_cn,
-- a.currency,
-- round(a.SL_buttoan/b.SL_buttoan*c.SL_buttoan) sl_buttoan,
-- round(a.sotien/b.sotien*c.sotien) sotien,
-- round(a.sotien_quydoi/b.sotien_quydoi*c.sotien_quydoi) sotien_quydoi,
-- round(a.tongphi/b.tongphi*c.tongphi) tongphi
--FROM KHOI_XACDINH_2 a
--left join total b on a.currency = b.currency
--left join KHOI_KO_XACDINH_total c on a.currency = c.currency 
-- )
 ,
 bidv_tong AS
 (
 select * from  KHOI_XACDINH
-- union all select * from PHANBO_BOSUNG
) --select * from  bidv_tong;
SELECT 
a.PHAN_LOAI_THE
,a.loai_giao_dich
,B.SECTOR_CODE
,a.CHG_CODE
,a.MA_CN
,a.makh
,a.KHOI
,(-1)*a.tong_phi tienno
,a.SOURE_IMPORT
,a.product_code
,a.PARTITION_DATE
,(-1)*a.tong_phi tienno_VNd
,a.bin8
,a.bin6
,a.acctnbr
, NVL(C1.T24_LINE, C2.T24_LINE) || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)  LINE_T24
, SUBSTR(NVL(C1.T24_LINE, C2.T24_LINE), -4) 
                          || NVL(C1.T24_LINE_SEQ_NBR, C2.T24_LINE_SEQ_NBR)         LINE_GL
, NVL(C1.LEVEL3_COA_CODE, C2.LEVEL3_COA_CODE)                                      TK
, cus.SECTOR
, cus.PHAN_KHUC PKKH 
, NULL CHG_TYPE     
FROM 
  (
SELECT 
    NULL    PHAN_LOAI_THE
  , NULL    LOAI_GIAO_DICH
  , NULL  CHG_CODE
  , MA_CN
  ,KHOI
  ,MAKH
  ,tongphi tong_phi
  , 'APPS.FIN_ODS_CHARGE_BIDV_DAILY_RPT' SOURE_IMPORT
  ,'15411'  PRODUCT_CODE
  ,TO_DATE('${PRD_ID}', 'YYYYMMDD') PARTITION_DATE
--  ,tongphi
  , NULL BIN8
  , NULL  BIN6
  , CASE WHEN makh ='2001' THEN '68113' ELSE '68101' end  ACCTNBR                      
FROM bidv_tong) a
LEFT JOIN ETL.MPA_MAPPING_SECTOR B ON A.khoi = B.KHOI
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C1 
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C1.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C1.SECTOR_CODE IS NOT NULL THEN INSTR(B.SECTOR_CODE, C1.SECTOR_CODE)
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C1.CATE_CODE
LEFT JOIN (SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NOT NULL
      UNION ALL
      SELECT SECTOR_CODE
        , T24_LINE
        , LEVEL3_COA_CODE
        , T24_LINE_SEQ_NBR
        , CATE_CODE
        , CATE_RANGE
      FROM (SELECT SECTOR_CODE
            , T24_LINE
            , LEVEL3_COA_CODE
            , T24_LINE_SEQ_NBR
            , CATE_CODE
            , CATE_RANGE
            , ROW_NUMBER() OVER (PARTITION BY CATE_CODE ORDER BY CATE_RANGE NULLS LAST) RN
          FROM ETL.SUB_ACG_LINE_MAP_DAILY WHERE SECTOR_CODE IS NULL)
      WHERE RN = 1) C2
  ON CASE 
    WHEN B.KHOI = 'SME' AND B.SECTOR_CODE IS NULL AND C2.SECTOR_CODE IS NULL THEN 1
    ELSE CASE
        WHEN C2.SECTOR_CODE IS NULL THEN 1
        ELSE 0 END
    END > 0
  AND A.ACCTNBR = C2.CATE_CODE
left join apps.FIN_SMY_CUSTOMER_MONTHLY cus on A.makh = cus.makh and cus.transaction_date = last_day(to_date('${PRD_ID}', 'yyyymmdd'))</sql>
    <limit>0</limit>
