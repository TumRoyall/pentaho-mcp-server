  <step>
    <name>NHS_KPI_CREDIT_CARD_NOW</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>cds_dc_etl_ods</connection>
    <sql>/*select
BIN,
CARD_MODULE,
CARD_CLASS,
ISSUE_BRANCH_CODE,
CARD_ID,
CARD_NUMBER,
CONTRACT_ID,
CONTRACT_NUMBER,
PRODUCT_NAME,
PRODUCT_CODE,
PRODUCT_GROUP,
CARD_MAIN_SUB,
CREDIT_LIMIT,
CONTRACT_NAME,
DATE_OPEN,
CARD_INFO_STATUS,
CONTR_STATUS,
PRODUCTION_STATUS,
CLIENT__ID,
ADD_INFO_03,
CARD_STATUS,
T24_CUSTOMER_CODE,
NGAY_KICH_HOAT_CHUAN,
RM_CODE,
ISSUE_DATE,
CARD_DESCENT,
CARD_LEVEL,
REQ_BRANCH_CODE,
BUSINESS_CODE,
KENH_PHATHANH,
IS_PHYSICAL_CARD,
T24_PROD_CODE
from
way4rpt.NHS_KPI_CREDIT_CARD_NOW
--where card_status in('THE_SAN_SANG_SU_DUNG','THE_KHOA_TAM_THOI')
*/
select
a.bin8 BIN,
a.card_module CARD_MODULE,
a.card_class CARD_CLASS,
a.issue_branch_code ISSUE_BRANCH_CODE,
to_number(a.card_id) CARD_ID,
a.card_nbr CARD_NUMBER,
to_number(a.w4_contract_id) CONTRACT_ID,
a.arrangement_nbr CONTRACT_NUMBER,
p.name PRODUCT_NAME,
a.w4_product_code PRODUCT_CODE,
a.W4_PRODUCT_GROUP_CODE PRODUCT_GROUP,
/*p.appl_pr_group__id PRODUCT_GROUP,*/
a.Main_Sub_Card_Ind CARD_MAIN_SUB,
a.Limit_Amt CREDIT_LIMIT,
a.Card_Holder_Name CONTRACT_NAME,
a.card_open_date DATE_OPEN,
a.card_info_status CARD_INFO_STATUS,
a.contr_status CONTR_STATUS,
a.production_status PRODUCTION_STATUS,
a.w4_client_id CLIENT__ID,
a.acnt_add_info_03 ADD_INFO_03,
a.Card_Status_Final CARD_STATUS,
a.T24_CUST_ID T24_CUSTOMER_CODE,
null NGAY_KICH_HOAT_CHUAN,
a.MAIN_SELL_RM_CODE RM_CODE,
a.LAST_CARD_CREATION_DATE ISSUE_DATE,
a.CARD_GROUP CARD_DESCENT,
a.CARD_SEGMENT CARD_LEVEL,
substr(a.RQD_BRANCH_CODE,-4) REQ_BRANCH_CODE,
a.business_program_code BUSINESS_CODE,
a.CARD_ISSUE_CHANNEL KENH_PHATHANH,
a.physical_ind IS_PHYSICAL_CARD,
a.T24_Product_Code T24_PROD_CODE
from CDT.CREDIT_CARD_MTH partition for(to_date('${PRD_ID}','yyyyMMdd')) a
left join cdt.card_appl_prod_w4t24 p 
  on (p.amnd_state='A' and p.internal_code=a.w4_current_internal_code)
where 1=1
and trunc(a.txn_date)=to_date('${PRD_ID}','yyyyMMdd')</sql>
    <limit>0</limit>
