    <connection>tckt_dc</connection>
    <sql>WITH TMP_SODU_TTTM as
(
select 
  A.ARRANGEMENT_NBR TAIKHOAN,
  A.APNT_CUST_NBR MAKH,
  A.BRANCH_CODE MA_CN,
  A.CURRENCY_CODE NTE,
  A.DIVISION_CODE KHOI,
  NULL AS CHANNEL,
SUM (NVL(-A.CLOSING_FCY_BAL,0)) SODU_THOIDIEM,
SUM (NVL(-A.CLOSING_FCY_BAL,0)*nvl(r1.CONVERSION_RATE, 1) /nvl(r2.CONVERSION_RATE, 1)) SODU_THOIDIEM_USD
FROM ETL.ODS_TF_BAL_MTH A
LEFT JOIN ETL.ORS_GL_DAILY_RATES r1 on r1.CONVERSION_DATE = a.TXN_DATE
  and r1.FROM_CURRENCY = a.CURRENCY_CODE
  and r1.TO_CURRENCY = 'VND'
left join ETL.ORS_GL_DAILY_RATES r2 on r2.CONVERSION_DATE = a.TXN_DATE
  and r2.TO_CURRENCY = 'VND'
  and r2.FROM_CURRENCY = 'USD'
group by A.ARRANGEMENT_NBR,
  A.APNT_CUST_NBR,
  A.BRANCH_CODE,
  A.CURRENCY_CODE,
  A.DIVISION_CODE
union all
select 
a.ARRANGEMENT_NBR,
a.T24_CUST_ID,
a.BRANCH_CODE,
case when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE = 'USD' then a.BUY_CURRENCY_CODE
  when a.BUY_CURRENCY_CODE ='VND' and a.SELL_CURRENCY_CODE = 'USD' then a.SELL_CURRENCY_CODE
  when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE not in ('USD', 'VND') then a.BUY_CURRENCY_CODE
  when a.BUY_CURRENCY_CODE = 'VND' and a.SELL_CURRENCY_CODE not in ('USD', 'VND') then a.SELL_CURRENCY_CODE
  when a.BUY_CURRENCY_CODE &lt;&gt; 'VND' and a.SELL_CURRENCY_CODE &lt;&gt; 'VND' then a.BUY_CURRENCY_CODE end,
a.DIVISION_CODE,
CASE WHEN A.RELATED_EB_TXN_CODE like 'FXBIZ%' then 'ONLINE'
    when a.RELATED_EB_TXN_CODE like '%FX%LCT%' then 'ONLINE'
else 'OFFLINE' end CHANNEL,
sum (case when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE = 'USD' then a.BUY_AMT
    when a.BUY_CURRENCY_CODE ='VND' and a.SELL_CURRENCY_CODE = 'USD' then a.SELL_AMT
    when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE not in ('USD', 'VND') then a.BUY_AMT
    when a.BUY_CURRENCY_CODE = 'VND' and a.SELL_CURRENCY_CODE not in ('USD', 'VND') then a.SELL_AMT
    when a.BUY_CURRENCY_CODE &lt;&gt; 'VND' and a.SELL_CURRENCY_CODE &lt;&gt; 'VND' then 2*a.BUY_AMT
  else 0 end),
sum(case when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE = 'USD' then a.BUY_AMT
      when a.BUY_CURRENCY_CODE ='VND' and a.SELL_CURRENCY_CODE = 'USD' then a.SELL_AMT
      when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE not in ('USD', 'VND') then a.BUY_AMT * nvl(r1.CONVERSION_RATE, 1) /nvl(r2.CONVERSION_RATE, 1)
      when a.BUY_CURRENCY_CODE = 'VND' and a.SELL_CURRENCY_CODE not in ('USD', 'VND') then a.SELL_AMT * nvl(r3.CONVERSION_RATE, 1) / nvl(r2.CONVERSION_RATE, 1)
      when a.BUY_CURRENCY_CODE &lt;&gt; 'VND' and a.SELL_CURRENCY_CODE &lt;&gt; 'VND' then 2*a.BUY_AMT * nvl(r1.CONVERSION_RATE, 1) /nvl(r2.CONVERSION_RATE, 1)
  else 0 end) SODU_THOIDIEM_USD
FROM ETL.ODS_FX_BAL A
LEFT JOIN ETL.ORS_GL_DAILY_RATES r1 on r1.CONVERSION_DATE = a.DEAL_DATE
  and r1.FROM_CURRENCY = a.BUY_CURRENCY_CODE
  and r1.TO_CURRENCY = 'VND'
left join ETL.ORS_GL_DAILY_RATES r2 on r2.CONVERSION_DATE = a.DEAL_DATE
  and r2.TO_CURRENCY = 'VND'
  and r2.FROM_CURRENCY = 'USD'
left join ETL.ORS_GL_DAILY_RATES r3 on r3.CONVERSION_DATE = a.DEAL_DATE
  AND r3.FROM_CURRENCY = a.SELL_CURRENCY_CODE
  AND r3.TO_CURRENCY = 'VND'
group by
  a.ARRANGEMENT_NBR,
  a.T24_CUST_ID,
  a.BRANCH_CODE,
  case when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE = 'USD' then a.BUY_CURRENCY_CODE
    when a.BUY_CURRENCY_CODE ='VND' and a.SELL_CURRENCY_CODE = 'USD' then a.SELL_CURRENCY_CODE
    when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE not in ('USD', 'VND') then a.BUY_CURRENCY_CODE
    when a.BUY_CURRENCY_CODE = 'VND' and a.SELL_CURRENCY_CODE not in ('USD', 'VND') then a.SELL_CURRENCY_CODE
    when a.BUY_CURRENCY_CODE &lt;&gt; 'VND' and a.SELL_CURRENCY_CODE &lt;&gt; 'VND' then a.BUY_CURRENCY_CODE end,
  a.DIVISION_CODE,
  CASE WHEN A.RELATED_EB_TXN_CODE like 'FXBIZ%' then 'ONLINE'
    when a.RELATED_EB_TXN_CODE like '%FX%LCT%' then 'ONLINE'
  else 'OFFLINE' end
),
TMP_PHI_HHMG_FX as
(
select
  SCT TAIKHOAN,
  MAKH ,
  MA_CN,
  KHOI_THEOPLKHOI KHOI,
  SUM(TIENNO_VND) PNL_TTTM
FROM ETL.ETL_MB_AGG_THLK_TOI_SP_TMP3 O
where PARTITION_DATE = to_date('${PRD_ID}','YYYYMMDD')
  AND exists 
  (select 1 from APPS.MB_MAP_TOI_LINE P
    where date_tx =to_date('${PRD_ID}','YYYYMMDD')
  and MACHITIEU in ('E2','E14')
  and O.linet24 =P.linet24)
  and nvl (ACCTNBR, '0') = '68224'
GROUP BY 
SCT,
MAKH,
MA_CN,
KHOI_THEOPLKHOI),
TMP_PNL_TTTM as
(
  select
    SCT TAIKHOAN,
    MAKH ,
    MA_CN,
    KHOI_THEOPLKHOI KHOI,
    LINET24,
    SUM(TIENNO_VND) PNL_TTTM
  FROM ETL.ETL_MB_AGG_THLK_TOI_SP_TMP3 O
  where PARTITION_DATE = to_date('${PRD_ID}','YYYYMMDD')
  AND exists 
    (select 1 from APPS.MB_MAP_TOI_LINE P
    where date_tx =to_date('${PRD_ID}','YYYYMMDD')
      and MACHITIEU in ('E2','E14')
      and O.linet24 =P.linet24)
  and nvl (ACCTNBR, '0') &lt;&gt; '68224'
  GROUP BY 
    SCT,
    MAKH,
    MA_CN,
    KHOI_THEOPLKHOI,
    LINET24
),
TMP_PNL_FX as
(select 
  COALESCE(F.FX, B.ARRANGEMENT_NBR, C.ARRANGEMENT_NBR, D.ARRANGEMENT_NBR) TAIKHOAN,
  A.CUS_ID MAKH,
  A.CO_CODE MA_CN,
  A.KHOI ,
  Sum(AMOUNT) PNL_FX
FROM ETL.TMP_F2B_PNL_FX A
LEFT JOIN ETL.REP_MAP_PNL_FX B
  ON 1=1--B.RANK_NUM = 1
    AND B.F2B_ARRANGEMENT_NBR = A.DEALID
    AND A.CUS_ID = B.T24_CUST_ID
LEFT JOIN ETL.REP_MAP_PNL_FX  C
  ON 1=1--c.RANK_NUM = 1
    AND A.COMMENTS = C.RELATED_EB_TXN_CODE
    AND A.CUS_ID = C.T24_CUST_ID
LEFT JOIN ETL.REP_MAP_PNL_FX  D
  ON 1=1--d.RANK_NUM = 1
    AND d.RELATED_EB_TXN_CODE LIKE 'FB%'
    AND REPLACE(A.COMMENTS,'_','') = REPLACE(D.RELATED_EB_TXN_CODE,' ','')
    AND A.CUS_ID = D.T24_CUST_ID
LEFT JOIN 
( SELECT 
    SUBSTR(COMMENTS,10,12) FX,
    COMMENTS,
    DEALID,
    CUS_ID
  FROM ETL.TMP_F2B_PNL_FX 
  WHERE SUBSTR(COMMENTS,1,9) ='CTQT.APPS'
    GROUP BY SUBSTR(COMMENTS,10,12),COMMENTS,DEALID,CUS_ID
) F
  ON A.COMMENTS= f.COMMENTS
    AND A.DEALID = f.DEALID
    AND A.CUS_ID = f.CUS_ID
GROUP BY 
  COALESCE(F.FX, B.ARRANGEMENT_NBR, C.ARRANGEMENT_NBR, D.ARRANGEMENT_NBR)
  ,A.CUS_ID
  ,A.CO_CODE
  ,A.KHOI
),
TMP_FIN_TTTM_TRANS_DAILY as
(
  SELECT
    CONTRACT_ID TAIKHOAN,
    CCY,
    MAKH,
    CN MA_CN,
    CHANNEL,--cm
    KHOI,
    SUM(DOANHSO) DOANHSO
  from APPS.FIN_TTTM_TRANS_DAILY 
  WHERE TRANSACTION_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') AND  TO_DATE('${PRD_ID}','YYYYMMDD')
  GROUP BY
    CONTRACT_ID,
    CCY,
    MAKH,
    CN,
    CHANNEL,
    KHOI)


SELECT 
TO_DATE('${PRD_ID}','YYYYMMDD') TRANSACTION_DATE,
  COALESCE(A.TAIKHOAN, B.TAIKHOAN, C.TAIKHOAN, D.TAIKHOAN, E.TAIKHOAN
  ) TAIKHOAN,
  --COALESCE(A.MAKH, B.MAKH, to_char(C.MAKH)
  COALESCE(A.MAKH, B.MAKH, to_char(C.MAKH), E.MAKH
  , D.MAKH,
      substr (G.PARTY_KEY, instr (G.PARTY_KEY,'.',1,2) + 1, length (G.PARTY_KEY) - instr (G.PARTY_KEY,'.',1,2)),
      substr (h.PARTY_KEY, instr (h.PARTY_KEY,'.',1,2) + 1, length (h.PARTY_KEY) - instr (h.PARTY_KEY,'.',1,2))) MAKH,
  --COALESCE(A.MA_CN, B.MA_CN, C.MA_CN, D.MA_CN,
  COALESCE(A.MA_CN, B.MA_CN, C.MA_CN, D.MA_CN, E.MA_CN,
   G.BRANCH_CODE, H.BRANCH_CODE) MA_CNC2,
  COALESCE(A.NTE, B.CCY
  , G.CURRENCY_CODE, H.SELL_CURRENCY_CODE) NTE,
  COALESCE(A.KHOI, B.KHOI, C.KHOI, D.KHOI,e.KHOI--, G.KHOI--, H.KHOI
  ) KHOI,
  COALESCE(G.ARRANGEMENT_OPENING_DATE, H.ARRANGEMENT_OPENING_DATE) ARRANGEMENT_OPENING_DATE,
  COALESCE(G.ARRANGEMENT_CLOSED_DATE, H.ARRANGEMENT_CLOSED_DATE) ARRANGEMENT_CLOSED_DATE,
  CASE WHEN A.CHANNEL IS NOT NULL THEN A.CHANNEL
    WHEN B.CHANNEL IS NOT NULL THEN B.CHANNEL
    WHEN NVL (K.ONLINE_LC_IND,'0') = '1' THEN 'ONLINE'
    WHEN NVL (L.ONLINE_IND,'0') = '1' THEN 'ONLINE'
  ELSE 'OFFLINE' END CHANNEL, 
  case when G.SPCL_LC_TYPE in ('87-LC UPAS - NOI DIA','10-LC UPAS','15-LC UPAS XAC NHAN','14-LC UPAS CHUYEN NHUONG') then '1'
    when G.CREDIT_LETTER_NBR like '%UP%' then '1' else '0' end UPAS_LC,
  NVL(A.SODU_THOIDIEM_USD,0) SODU_THOIDIEM_USD,
  NVL(B.DOANHSO,0) DOANHSO_USD,
  NVL(C.PNL_FX,0) + NVL(D.PNL_TTTM,0) PNL_TTTM,
  --e.PNL_TTTM PHI_HHMG
  NVL(E.PNL_TTTM,0) PHI_HHMG
FROM TMP_SODU_TTTM A
FULL JOIN TMP_FIN_TTTM_TRANS_DAILY B ON  A.TAIKHOAN = B.TAIKHOAN
  AND NVL(A.MAKH,0) = NVL(B.MAKH,0)
  AND NVL(A.KHOI,0) = NVL(B.KHOI,0)
  AND NVL(A.MA_CN,0) = NVL(B.MA_CN,0)
FULL JOIN  TMP_PNL_FX C ON  COALESCE(A.TAIKHOAN, B.TAIKHOAN) = C.TAIKHOAN
  AND NVL(COALESCE(A.MAKH, B.MAKH),0) = NVL(C.MAKH,0)
  AND NVL(COALESCE(A.KHOI, B.KHOI),0) = NVL(C.KHOI,0)
  AND NVL(COALESCE(A.MA_CN, B.MA_CN),0) = NVL(C.MA_CN,0)
FULL JOIN TMP_PNL_TTTM D ON  COALESCE(A.TAIKHOAN, B.TAIKHOAN, C.TAIKHOAN) = D.TAIKHOAN
  AND NVL(COALESCE(to_char(A.MAKH), to_char(B.MAKH), to_char(C.MAKH)),'0') = to_char(NVL(D.MAKH,'0'))
  AND NVL(COALESCE(A.KHOI, B.KHOI, C.KHOI),'0') = NVL(D.KHOI,'0')
  AND NVL(COALESCE(A.MA_CN, B.MA_CN, C.MA_CN),'0') = NVL(D.MA_CN,'0')
FULL JOIN TMP_PHI_HHMG_FX E ON  COALESCE(A.TAIKHOAN,B.TAIKHOAN, C.TAIKHOAN, D.TAIKHOAN) = E.TAIKHOAN
  AND NVL(COALESCE(to_char(A.MAKH), to_char(B.MAKH), to_char(C.MAKH), D.MAKH),0) = NVL(E.MAKH,0)
  AND NVL(COALESCE(A.KHOI,B.KHOI, C.KHOI, D.KHOI),0) = NVL(E.KHOI,0)
  AND NVL(COALESCE(A.MA_CN, B.MA_CN, C.MA_CN, D.MA_CN),0) = NVL(E.MA_CN,0)  
LEFT JOIN ETL.ODS_TF_CONTRACT G ON COALESCE(A.TAIKHOAN, B.TAIKHOAN, C.TAIKHOAN, D.TAIKHOAN,E.TAIKHOAN) = G.ARRANGEMENT_NBR
LEFT JOIN ETL.ODS_FX_CONTRACT H ON COALESCE(A.TAIKHOAN, B.TAIKHOAN, C.TAIKHOAN, D.TAIKHOAN,E.TAIKHOAN) = H.ARRANGEMENT_NBR
LEFT JOIN (select ARRANGEMENT_NBR, '1' ONLINE_LC_IND from ETL.ODS_CAL_BPMLC_BPM_LCNK group by ARRANGEMENT_NBR) K
  ON COALESCE(A.TAIKHOAN, B.TAIKHOAN, C.TAIKHOAN, D.TAIKHOAN,E.TAIKHOAN) = K.ARRANGEMENT_NBR
LEFT JOIN (select FT_NBR, '1' ONLINE_IND from ETL.ODS_CAL_BPMREMITTANCE_TRANS_DAILY group by FT_NBR) L
  on COALESCE(A.TAIKHOAN, B.TAIKHOAN, C.TAIKHOAN, D.TAIKHOAN,E.TAIKHOAN) = L.FT_NBR</sql>
    <limit>0</limit>
