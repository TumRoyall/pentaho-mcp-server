  <step>
    <name>Source 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>stg_oth_dc</connection>
    <sql>SELECT last_day(to_date(${PRD_ID},'YYYYMMDD')) transaction_date 
, loyalty_account_no 
, status 
, NVL(balance,0) balance
FROM (SELECT c.* 
, row_number() over( 
                    PARTITION BY c.loyalty_account_no 
                    ORDER BY c.last_update_date DESC 
                    , c.record_no DESC) rank_num
FROM OLS.ACCOUNT_BALANCE_SNPST c
)
WHERE rank_num = 1
/*
SELECT last_day(to_date(${PRD_ID},'YYYYMMDD')) transaction_date 
, loyalty_account_no 
, status 
, NVL(balance,0) balance
FROM (SELECT c.* 
, row_number() over( 
                    PARTITION BY c.loyalty_account_no 
                    ORDER BY c.last_update_date DESC 
                    , c.record_no DESC) rank_num
FROM OLS.ACCOUNT_BALANCE_SNPST c
WHERE c.last_update_date &lt;= last_day(to_date(${PRD_ID},'YYYYMMDD'))+1 -interval '1' second)
WHERE rank_num = 1
*/</sql>
