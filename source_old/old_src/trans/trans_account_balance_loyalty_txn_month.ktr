    <connection>stg_oth_dc</connection>
    <sql>SELECT TRUNC(a.post_date) transaction_date 
, a.transaction_ref_no 
, a.transaction_type 
, a.loyalty_account_no 
, NVL(a.point_earned,0) point_earned 
, NVL(a.POINT_REDEEMED,0) POINT_REDEEMED 
, NVL(a.point_adjusted,0) point_adjusted 
, a.product_account_no 
, c.product_code_level4 product_code 
, a.TRANSACTION_REF_NO bank_ref_no 
, a.NETT_TRANSACTION_AMT AMT_OF_TXN 
, a.SETTLEMENT_DATETIME EXPIRY_DATE 
, a.CARD_ID 
, a.CSN 
, b.EXTERNAL_REFERENCE_NO MAKH 
, a.SCHEME_ID 
, d.description_english SCHEME_NAME 
, a.ITEM_CODE 
, e.item_name
FROM OLS.TRANSACTIONS_SNPST a
LEFT JOIN OLS.CLIENT_SNPST b          ON a.csn = b.CSN
LEFT JOIN OLS.PRODUCT_ACCOUNT_SNPST c ON a.product_account_no = c.product_account_no
LEFT JOIN OLS.SCHEME_SNPST d          ON a.scheme_id = d.scheme_id
LEFT JOIN OLS.Item e                  ON a.item_code = e.item_code
WHERE a.post_date BETWEEN TRUNC(to_date(${PRD_ID},'YYYYMMDD'),'MONTH') AND last_day(to_date(${PRD_ID},'YYYYMMDD')) +1 -interval '1' second</sql>
