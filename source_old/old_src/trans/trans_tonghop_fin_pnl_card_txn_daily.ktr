  <step>
    <name>ODS_CAL_CHG_TXN_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with REF_CARD_CHG_CODE_MAP_TRUNG as (
    select
        a.CHG_CODE,
        A.PL_CATEGORY CATEG_THU,
        B.PL_CATEGORY CATEG_CHI
    from
        APPS.REF_CARD_CHG_CODE_MAP a
        join APPS.REF_CARD_CHG_CODE_MAP b on a.CHG_CODE_TYPE = 'THU'
        and b.CHG_CODE_TYPE = 'CHI'
        and a.CHG_CODE = b.CHG_CODE
)
select
    a.TXN_DATE TRANSACTION_DATE,
    a.RELATION_TXN_NBR TRANS_REF,
    a.CHG_CODE,
    a.CHG_NAME,
    a.CURRENCY_CODE NTE,
    a.FCY_TXN_AMT CHG_AMT_FCY,
    a.LCY_TXN_AMT CHG_AMT_LCY,
    a.TXN_NARRATIVE,
    a.T24_LINE,
    a.COA_CODE,
    a.BRANCH_CODE CN,
    a.PL_CATE_CODE PL_CATEGORY,
    a.T24_CUST_ID MAKH,
    a.PARTY_FULL_NAME TENKH,
    a.SECTOR_CODE SECTOR,
    a.DIVISION_CODE KHOI,
    a.CONSOL_KEY,
    a.RM_CODE,
    a.ENTRY_ID,
    a.INPUTTER,
    c.CARD_CHANNEL_TYPE,
    nvl (c.CARD_TYPE, d.CARD_TYPE) CARD_TYPE,
    nvl (c.CARD_MODULE, d.CARD_MODULE) CARD_MODULE,
    nvl (c.CARD_SERVICE, d.CARD_SERVICE) CARD_SERVICE,
    nvl (c.CARD_PRODUCT, d.CARD_PRODUCT) CARD_PRODUCT,
    nvl (c.CARD_ISSUER, d.CARD_ISSUER) CARD_ISSUER,
    a.DATA_SOURCE
from
    ETL.ODS_CAL_CHG_TXN_DAILY a
    left join REF_CARD_CHG_CODE_MAP_TRUNG b on a.CHG_CODE = b.CHG_CODE
    left join APPS.REF_CARD_CHG_CODE_MAP c on c.CHG_CODE_TYPE = 'THU'
    and (
        (
            b.CATEG_CHI is null
            and a.CHG_CODE = c.CHG_CODE
        )
        or (
            b.CATEG_CHI is not null
            and a.CHG_CODE = c.CHG_CODE
            and a.PL_CATE_CODE = c.PL_CATEGORY
        )
    )
    left join APPS.REF_CARD_CHG_CODE_MAP d on d.CHG_CODE_TYPE = 'CHI'
    and (
        (
            b.CATEG_CHI is null
            and a.CHG_CODE = d.CHG_CODE
        )
        or (
            b.CATEG_CHI is not null
            and a.CHG_CODE = d.CHG_CODE
            and a.PL_CATE_CODE = d.PL_CATEGORY
        )
    )
where
    a.TXN_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    and not (
        A.DATA_SOURCE = 'T24'
        and A.PL_CATE_CODE in ('52292', '67026')
        and substr (A.RELATION_TXN_NBR, 1, 2) = 'FT'
    )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
