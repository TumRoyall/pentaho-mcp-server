  <step>
    <name>ETL.ODS_PL_TXN_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select                    
a.TXN_DATE TRANSACTION_DATE,
a.RELATION_TXN_NBR TRANS_REF,
a.CHG_CODE,
b.DESCRIPTION CHG_NAME,
a.CURRENCY_CODE NTE,
a.FCY_AMT CHG_AMT_FCY,
a.LCY_AMT CHG_AMT_LCY,
a.NARRATIVE TXN_NARRATIVE,
a.T24_LINE,
a.COA_CODE,
a.BRANCH_CODE CN,
a.PL_CATE_CODE PL_CATEGORY,
a.T24_CUST_ID MAKH,
a.PARTY_FULL_NAME TENKH,
a.PARTY_SECTOR_CODE SECTOR,
a.PARTY_DIVISION_CODE KHOI,
null CONSOL_KEY,
a.RM_CODE,
a.ENTRY_ID,
null INPUTTER,
b.CARD_CHANNEL_TYPE,
b.CARD_TYPE,
b.CARD_MODULE,
b.CARD_SERVICE,
b.CARD_PRODUCT,
b.CARD_ISSUER,
a.SOURCE_TABLE_NAME DATA_SOURCE,
a.GL_LINE,
a.CHG_TYPE,
a.CHG_PRODUCT_CODE,
a.REPORT_DIVISION_CODE,
a.REPORT_ITEM_CODE,
a.REPORT_ITEM_NAME,
a.EB_REPORT_ITEM_IND

from ETL.ODS_PL_TXN_DAILY_PNL_CARD a
left join APPS.REF_CARD_CHG_CODE_MAP b
on a.CHG_CODE= b.CHG_CODE
and a.CHG_TYPE = b.CHG_CODE_TYPE
where a.TXN_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
and  (a.REPORT_ITEM_CODE like ('A205%')
or  a.PL_CATE_CODE in ('52796','67026','52795','52294'))
</sql>
    <limit>0</limit>
