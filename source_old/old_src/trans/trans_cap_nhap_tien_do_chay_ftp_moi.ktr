        <jsScript_script>//Script here


var tr=""
var td_tablename = "&lt;td>"+TABLE_NAME+"&lt;/td>"
var td_sourcesystem = "&lt;td>"+SOURCE_SYSTEM+"&lt;/td>"
var td_transactiondate = "&lt;td>"+SYN_DATE+"&lt;/td>"
var td_etldate = "&lt;td>"+ETL_DATE+"&lt;/td>"
var td_soluong = "&lt;td>"+SO_LUONG+"&lt;/td>"


tr = "&lt;tr>"
        + td_tablename
        + td_sourcesystem
        + td_transactiondate
		+ td_etldate 
		+ td_soluong
    +"&lt;/tr>"</jsScript_script>
      </jsScript>
