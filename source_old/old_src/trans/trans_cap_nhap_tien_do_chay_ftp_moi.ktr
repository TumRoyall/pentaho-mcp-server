    <connection>tckt_dc</connection>
    <sql>select 
a.TABLE_NAME,
to_char(b.SYN_DATE,'YYYYMMDD') as SYN_DATE,
TO_CHAR(b.ETL_DATE,'YYYYMMDD HH24:MI:SS') as ETL_DATE,
b.SO_LUONG,
b.SOURCE_SYSTEM
from 
(
SELECT trim(regexp_substr('APPS.FTP_CHOVAY_TT_DAILY,APPS.FTP_CHOVAY_THAUCHI_DAILY,APPS.FTP_CHOVAY_NOQUAHAN_DAILY,APPS.FTP_TERM_DEPOSIT_DAILY,APPS.FTP_CASA_DAILY,APPS.FTP_TPDN_DAILY,APPS.FTP_CD_ONLINE_DAILY,APPS.FTP_TERM_DEPOSIT_UPASLC_DAILY,APPS.FTP_CHOVAY_UPASLC_DAILY,APPS.FTP_CHOVAY_RDF_DAILY,APPS.FTP_DUPHONG_DAILY,APPS.FTP_MUANO_DAILY,APPS.FTP_TIENMAT_DAILY,APPS.FTP_THE_TRATRUOC_DAILY,APPS.FTP_THE_TINDUNG_DAILY,APPS.FTP_DIEUCHINH_TATTOAN_DAILY,ETL.FTP_TONGHOP_PILOT,APPS.FTP_TONGHOP,APPS.FTP_TR_F2B,APPS.FTP_CD_THUCAP_DAILY,APPS.FTP_LC_NON_RECOURSE_DAILY', '[^,]+', 1, LEVEL)) table_name
  FROM dual
CONNECT BY LEVEL &lt;= regexp_count('APPS.FTP_CHOVAY_TT_DAILY,APPS.FTP_CHOVAY_THAUCHI_DAILY,APPS.FTP_CHOVAY_NOQUAHAN_DAILY,APPS.FTP_TERM_DEPOSIT_DAILY,APPS.FTP_CASA_DAILY,APPS.FTP_TPDN_DAILY,APPS.FTP_CD_ONLINE_DAILY,APPS.FTP_TERM_DEPOSIT_UPASLC_DAILY,APPS.FTP_CHOVAY_UPASLC_DAILY,APPS.FTP_CHOVAY_RDF_DAILY,APPS.FTP_DUPHONG_DAILY,APPS.FTP_MUANO_DAILY,APPS.FTP_TIENMAT_DAILY,APPS.FTP_THE_TRATRUOC_DAILY,APPS.FTP_THE_TINDUNG_DAILY,APPS.FTP_DIEUCHINH_TATTOAN_DAILY,ETL.FTP_TONGHOP_PILOT,APPS.FTP_TONGHOP,APPS.FTP_TR_F2B,APPS.FTP_CD_THUCAP_DAILY,APPS.FTP_LC_NON_RECOURSE_DAILY', ',')+1
) a
left join apps.syn_log b on a.table_name = upper(b.table_name) and b.syn_date =to_date('${PRD_ID}','yyyyMMdd')</sql>
