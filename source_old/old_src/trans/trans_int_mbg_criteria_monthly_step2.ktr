    <connection>tckt_dc</connection>
    <sql>WITH criteria_condition
AS(
SELECT
REPORT_CODE,
SUB_NAME,
REPORT_NAME,
REPORT_ITEM_TYPE,
REPORT_ITEM_DETAIL_CODE,
RPT_ITEM_CODE,
NO_SEQ,
RPT_SEQ,
IS_SHOW_FLAG,
REPORT_ITEM_NAME,
SUM_LEVEL,
REPORT_ITEM_SMY_OPERATOR,
NOTE,
TRIM (REGEXP_SUBSTR(substr (REPORT_ITEM_SMY_FRML, 
instr (REPORT_ITEM_SMY_FRML, '(',1,1)+1,
instr (REPORT_ITEM_SMY_FRML, ')',1,1) - instr (REPORT_ITEM_SMY_FRML, '(',1,1) - 1),
'([^,]+)',1,LEVEL, NULL, 1)) AS REPORT_ITEM_SMY_FRML
from etl.file_MBG_CRITERIA_MAP
where SUM_LEVEL = '${SUM_LEVEL}'
AND REPORT_ITEM_SMY_FRML LIKE 'SUM%'
AND nvl (DATA_SOURCE, 'A') NOT LIKE '%CAL%'
CONNECT BY REGEXP_SUBSTR(substr (REPORT_ITEM_SMY_FRML, 
instr (REPORT_ITEM_SMY_FRML, '(',1,1)+1,
instr (REPORT_ITEM_SMY_FRML, ')',1,1) - instr (REPORT_ITEM_SMY_FRML, '(',1,1) - 1)
, '([^,]+)',1,LEVEL, NULL, 1) IS NOT NULL
AND PRIOR RPT_ITEM_CODE = RPT_ITEM_CODE
AND PRIOR DBMS_RANDOM.VALUE IS NOT NULL)
SELECT
to_date (${PRD_ID}, 'YYYYMMDD') transaction_date,
A.REPORT_CODE,
A.SUB_NAME,
A.REPORT_NAME,
A.REPORT_ITEM_TYPE,
A.REPORT_ITEM_DETAIL_CODE,
A.RPT_ITEM_CODE,
A.NO_SEQ,
A.RPT_SEQ,
A.IS_SHOW_FLAG,
A.REPORT_ITEM_NAME,
A.SUM_LEVEL,
sum (
CASE WHEN A.NOTE = 'QUY_NAM' THEN nvl (b.amt_lcy, 0) * 12 / to_number (to_char (to_date (${PRD_ID}, 'YYYYMMDD'), 'MM'))
ELSE nvl (b.amt_lcy, 0) end) amt_lcy
FROM criteria_condition a
LEFT JOIN ETL.INT_MBG_CRITERIA_MONTHLY  b
ON B.SUM_LEVEL = TO_NUMBER('${SUM_LEVEL}') - 1
AND a.sub_name = b.sub_name
AND a.REPORT_ITEM_SMY_FRML = b.RPT_ITEM_CODE
GROUP BY A.REPORT_CODE,
A.SUB_NAME,
A.REPORT_NAME,
A.REPORT_ITEM_TYPE,
A.REPORT_ITEM_DETAIL_CODE,
A.RPT_ITEM_CODE,
A.NO_SEQ,
A.RPT_SEQ,
A.IS_SHOW_FLAG,
A.REPORT_ITEM_NAME,
A.SUM_LEVEL
</sql>
