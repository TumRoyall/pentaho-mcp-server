  <step>
    <name>HDV_BQ</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>WITH v_HDV_BQ as (
    select
        khoi,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then SUM (
                SODU_VND * (to_number (to_char (transaction_date, 'DD'))) /(
                    to_number (
                        to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                    ) + 1
                )
            ) / 1e9
            else SUM (
                SODU_VND * (to_number (to_char (transaction_date, 'DD'))) /(
                    to_number (
                        to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                    )
                )
            ) / 1e9
        end value_lk
    from
        apps.tr_hdv_bq
    where
        TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR')
        and trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') -1
        and substr (GL, 1, 2) in ('42', '43')
        and substr (PRODUCT_CODE, 1, 2) in ('11', '12', '13')
    group by
        khoi
),
v_MB_TR_HDV_BQ_DAILY_201804 as (
    select
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD')) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        khoi,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk
    from
        (
            select
                khoi,
                sum (SODU_VND) * to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) / 1e9 ducuoi_vnd
            from
                apps.MB_TR_HDV_BQ_DAILY_201804
            where
                TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                and substr (GL, 1, 2) in ('42', '43')
                and substr (PRODUCT_CODE, 1, 2) in ('11', '12', '13')
            group by
                khoi
        )
    group by
        khoi
),
v_tr_tk as (
    select
        khoi,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD')) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk
    from
        (
            select
                nvl(sum (DUCUOI_VND) / 1e9, 0) ducuoi_vnd,
                khoi
            from
                apps.tr_tk
            where
                TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                and substr (GL, 1, 2) in ('42', '43')
                and substr (PRODUCT_CODE, 1, 2) in ('11', '12', '13')
                and to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
                and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            group by
                khoi
        )
    group by
        khoi
),
v_tr_tg as (
    select
        khoi,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD')) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk
    from
        (
            select
                khoi,
                nvl(sum (DUCUOI_VND) / 1e9, 0) ducuoi_vnd
            from
                apps.tr_tg
            where
                TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                and substr (GL, 1, 2) in ('42', '43')
                and substr (PRODUCT_CODE, 1, 2) in ('11', '12', '13')
                and to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
                and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            group by
                khoi
        )
    group by
        khoi
)
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
    sum(coalesce(a.value, b.value, c.value)) value,
    coalesce(a.khoi, b.khoi, c.khoi) line,
    'HDV_BQ' ma_ct,
    'Huy động vốn bình quân lũy kế tháng' ten_ct
FROM
    v_MB_TR_HDV_BQ_DAILY_201804 a full
    join v_tr_tk b on 1 = 2 full
    join v_tr_tg c on 1 = 2
WHERE
    coalesce(a.khoi, b.khoi, c.khoi) IN ('CIB', 'SME', 'INDIV', 'NHS', 'DVC', 'FI')
group by
    coalesce(a.khoi, b.khoi, c.khoi)
UNION
ALL
SELECT
    TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
    sum(coalesce(a.value, b.value, c.value)) value,
    'ALL' LINE,
    'HDV_BQ' ma_ct,
    'Huy động vốn bình quân lũy kế tháng' ten_ct
FROM
    v_MB_TR_HDV_BQ_DAILY_201804 a full
    join v_tr_tk b on 1 = 2 full
    join v_tr_tg c on 1 = 2
UNION
ALL
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
    sum(
        coalesce(a.value_lk, b.value_lk, c.value_lk, d.value_lk)
    ) value,
    coalesce(a.khoi, b.khoi, c.khoi, d.khoi) line,
    'HDV_BQ_LK' ma_ct,
    'Huy động vốn bình quân lũy kế' ten_ct
FROM
    v_MB_TR_HDV_BQ_DAILY_201804 a full
    join v_tr_tk b on 1 = 2 full
    join v_tr_tg c on 1 = 2 full
    join v_hdv_bq d on 1 = 2
WHERE
    coalesce(a.khoi, b.khoi, c.khoi, d.khoi) IN ('CIB', 'SME', 'INDIV', 'NHS', 'DVC', 'FI')
group by
    coalesce(a.khoi, b.khoi, c.khoi, d.khoi)
UNION
ALL
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
    sum(
        coalesce(a.value_lk, b.value_lk, c.value_lk, d.value_lk)
    ) value,
    'ALL' line,
    'HDV_BQ_LK' ma_ct,
    'Huy động vốn bình quân lũy kế' ten_ct
FROM
    v_MB_TR_HDV_BQ_DAILY_201804 a full
    join v_tr_tk b on 1 = 2 full
    join v_tr_tg c on 1 = 2 full
    join v_hdv_bq d on 1 = 2</sql>
