  <step>
    <name>HD33 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>with v_hd33 as(
    select
        to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
        case
            when term between 0
            and 179 then 'CD_TD_1M_5M'
            when term between 180
            and 209 then 'CD_TD_6M'
            when term between 210
            and 364 then 'CD_TD_7M_11M'
            when term between 365
            and 389 then 'CD_TD_12M'
            when term between 390
            and 449 then 'CD_TD_13M'
            when term >= 450 then 'CD_TD_ABV_13M'
        end ma_ct,
        case
            when term between 0
            and 179 then 'CDs thời điểm từ 1-5M'
            when term between 180
            and 209 then 'CDs thời điểm từ 6M'
            when term between 210
            and 364 then 'CDs thời điểm từ 7M-11M'
            when term between 365
            and 389 then 'CDs thời điểm từ 12M'
            when term between 390
            and 449 then 'CDs thời điểm từ 13M'
            when term >= 450 then 'CDs thời điểm > 13 tháng'
        end ten_ct,
        'ALL' line,
        sum (FACE_AMOUNT) / 1e9 value
    from
        apps.MB_QTRR_HD33
    where
        TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    group by
        case
            when term between 0
            and 179 then 'CD_TD_1M_5M'
            when term between 180
            and 209 then 'CD_TD_6M'
            when term between 210
            and 364 then 'CD_TD_7M_11M'
            when term between 365
            and 389 then 'CD_TD_12M'
            when term between 390
            and 449 then 'CD_TD_13M'
            when term >= 450 then 'CD_TD_ABV_13M'
        end,
        case
            when term between 0
            and 179 then 'CDs thời điểm từ 1-5M'
            when term between 180
            and 209 then 'CDs thời điểm từ 6M'
            when term between 210
            and 364 then 'CDs thời điểm từ 7M-11M'
            when term between 365
            and 389 then 'CDs thời điểm từ 12M'
            when term between 390
            and 449 then 'CDs thời điểm từ 13M'
            when term >= 450 then 'CDs thời điểm > 13 tháng'
        end
)
select
    *
from
    v_hd33
union
all
select
    a.transaction_date,
    'HDV_TD_CD_ONLINE' ma_ct,
    'HDV thời điểm CDs online' ten_ct,
    'ALL' line,
    sum(value) value
from
    v_hd33 a
group by
    a.transaction_date</sql>
