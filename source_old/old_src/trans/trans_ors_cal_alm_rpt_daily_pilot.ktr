  <step>
    <name>COF_CKH_NEW</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE, 
        'COF_CKH_NEW' ma_ct, 
        'COF deal CKH phát sinh trong kỳ' ten_ct,
        'ALL' line,
       sum (DUCUOI_VND * LS)/ sum (ducuoi_vnd) VALUE
from
(select
DUCUOI_VND, LS
from apps.tr_tk partition for (to_date ('${PRD_ID}', 'YYYYMMDD')) 
where /*TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') and to_date ('${PRD_ID}', 'YYYYMMDD')
and*/ substr (GL,1,2) in ('42', '43')
and substr (PRODUCT_CODE,1,2) in ('11', '12', '13')
and TRANSACTION_DATE = NGAYMS
and NTE = 'VND'
and nvl (NHOMSP, '0') &lt;&gt; '18510'
union all
select FACE_AMOUNT, INTEREST_RATE/100 from apps.MB_QTRR_HD33
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') and to_date ('${PRD_ID}', 'YYYYMMDD')
and TRANSACTION_DATE = ISSUE_DATE
and substr (PRODUCT,1,2) in ('11', '12', '13'))</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
      <value-meta>
        <type>Date</type>
        <storagetype>normal</storagetype>
        <name>TRANSACTION_DATE</name>
        <length>0</length>
        <precision>-1</precision>
        <origin>COF_CKH_NEW</origin>
        <comments>TRANSACTION_DATE</comments>
        <conversion_Mask/>
