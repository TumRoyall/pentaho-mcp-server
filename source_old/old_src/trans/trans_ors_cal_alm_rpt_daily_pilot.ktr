  <step>
    <name>DN_BQ</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>with v_chovay_bq_daily as (
    select
        case
            when khoi = 'NHS' then 'INDIV'
            else khoi
        end as line,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk
    from
        (
            select
                sum (SODU_VND) * to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) / 1e9 ducuoi_vnd,
                khoi,
                to_date('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE
            from
                apps.mb_tr_chovay_bq_daily
            where
                TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
            group by
                khoi
        )
    group by
        case
            when khoi = 'NHS' then 'INDIV'
            else khoi
        end
),
v_tr_ku as (
    select
        case
            when khoi = 'NHS' then 'INDIV'
            else khoi
        end as line,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk
    from
        (
            select
                nvl(sum(DUCUOI_VND) / 1e9, 0) ducuoi_vnd,
                khoi
            from
                apps.tr_ku
            where
                TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                and substr(gl, 1, 1) = '2'
                and substr(gl, 1, 2) &lt;&gt; '20'
                and to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
                and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
                and khoi IN ('CIB', 'SME', 'INDIV', 'NHS')
            group by
                khoi
        )
    group by
        case
            when khoi = 'NHS' then 'INDIV'
            else khoi
        end
),
v_tr_chovay_bq as (
    select
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then SUM (
                SODU_VND * (to_number (to_char (transaction_date, 'DD'))) /(
                    to_number (
                        to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                    ) + 1
                )
            ) / 1e9
            else SUM (
                SODU_VND * (to_number (to_char (transaction_date, 'DD'))) /(
                    to_number (
                        to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                    )
                )
            ) / 1e9
        end as value_lk,
        case
            when khoi = 'NHS' then 'INDIV'
            else khoi
        end as line
    from
        apps.TR_CHOVAY_BQ
    where
        TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR')
        and trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') - 1 --and khoi IN ('CIB', 'SME', 'INDIV', 'NHS')
    group by
        case
            when khoi = 'NHS' then 'INDIV'
            else khoi
        end
)
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'DN_BQ' ma_ct,
    'Quy mô dư nợ bình quân tháng' ten_ct,
    line,
    sum(value) as value
from
    (
        select
            line,
            value
        from
            v_chovay_bq_daily
        union
        all
        select
            line,
            value
        from
            v_tr_ku
    )
group by
    line
UNION
ALL
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'DN_BQ' ma_ct,
    'Quy mô dư nợ bình quân tháng' ten_ct,
    'ALL' line,
    sum(value) as value
from
    (
        select
            nvl(a.line, b.line) line,
            nvl(a.value, b.value) value
        from
            v_chovay_bq_daily a full
            join v_tr_ku b on 1 = 2
    )
UNION
ALL
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'DN_BQ_LK' ma_ct,
    'Quy mô dư nợ bình quân lũy kế' ten_ct,
    line,
    sum(value_lk) as value
from
    (
        select
            coalesce(a.line, b.line, c.line) line,
            sum(coalesce(a.value_lk, b.value_lk, c.value_lk)) as value_lk
        from
            v_tr_chovay_bq a full
            join v_chovay_bq_daily b on 1 = 2 full
            join v_tr_ku c on 1 = 2
        where
            coalesce(a.line, b.line, c.line) IN ('CIB', 'SME', 'INDIV', 'NHS')
        group by
            coalesce(a.line, b.line, c.line)
    )
group by
    line
UNION
ALL
select
    TO_DATE('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'DN_BQ_LK' ma_ct,
    'Quy mô dư nợ bình quân lũy kế' ten_ct,
    'ALL' line,
    sum(value_lk) as value
from
    (
        select
            coalesce(a.line, b.line, c.line) line,
            sum(coalesce(a.value_lk, b.value_lk, c.value_lk)) as value_lk
        from
            v_tr_chovay_bq a full
            join v_chovay_bq_daily b on 1 = 2 full
            join v_tr_ku c on 1 = 2
        group by
            coalesce(a.line, b.line, c.line)
    )</sql>
    <limit>0</limit>
