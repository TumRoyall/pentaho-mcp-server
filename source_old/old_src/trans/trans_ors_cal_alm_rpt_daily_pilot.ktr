  <step>
    <name>rep_doanhso_td</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>with v_temp as(
select
to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date ,
case when  KHOI = 'NHS' then 'INDIV' else khoi end  line,
SUM( case when CCY = 'VND' then  (-PSNO_VND)/1E9 else 0 end) DOANHSO_GIANNGAN_LK_TUAN_VND,
SUM( case when CCY = 'USD' then  (-PSNO_VND)/1E9 else 0 end) DOANHSO_GIANNGAN_LK_TUAN_USD
,
SUM (case when CCY = 'VND' then (-PSNO_VND * LS) else 0 end) LS_GIANNGAN_LK_TUAN_VND_TS,
SUM (case when CCY = 'VND' then -PSNO_VND else 0 end ) LS_GIANNGAN_LK_TUAN_VND_MS,
SUM (case when CCY = 'USD' then (-PSNO_VND * LS) else 0 end) LS_GIANNGAN_LK_TUAN_USD_TS,
SUM (case when CCY = 'USD' then -PSNO_VND else 0 end )  LS_GIANNGAN_LK_TUAN_USD_MS

from apps.rep_doanhso_td
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'IW') and to_date ('${PRD_ID}', 'YYYYMMDD')
and substr (SBV_CODE,1,1) = '2'
and substr (SBV_CODE,1,2) &lt;&gt; '20'
and substr (nvl (CATEG, '00000'),1,4) &lt;&gt; '1700'
and CCY in ( 'VND','USD')
--and khoi in ('CIB','SME','INDIV')
group by case when  KHOI = 'NHS' then 'INDIV' else khoi end
)
select transaction_date, 'ALL' line, ma_ct, 
       case when ma_ct = 'DOANHSO_GIANNGAN_LK_TUAN_VND' then 'Doanh số giải ngân VND lũy kế tuần'
            when ma_ct = 'DOANHSO_GIANNGAN_LK_TUAN_USD' then 'Doanh số giải ngân USD lũy kế tuần'
            when ma_ct = 'LS_GIANNGAN_LK_TUAN_VND' then 'Lãi suất bình quân các khoản giải ngân VND lũy kế tuần'
            when ma_ct = 'LS_GIANNGAN_LK_TUAN_USD' then 'Lãi suất bình quân các khoản giải ngân USD lũy kế tuần'
       end ten_ct,
       value
from (
select transaction_date, 'ALL'line, 
       sum(DOANHSO_GIANNGAN_LK_TUAN_VND) DOANHSO_GIANNGAN_LK_TUAN_VND,
       sum(DOANHSO_GIANNGAN_LK_TUAN_USD) DOANHSO_GIANNGAN_LK_TUAN_USD,
       case when sum(LS_GIANNGAN_LK_TUAN_VND_MS) =0 then 0 
            else sum(LS_GIANNGAN_LK_TUAN_VND_TS)/sum(LS_GIANNGAN_LK_TUAN_VND_MS) end LS_GIANNGAN_LK_TUAN_VND,
       case when sum(LS_GIANNGAN_LK_TUAN_USD_MS) =0 then 0
            else sum(LS_GIANNGAN_LK_TUAN_USD_TS)/sum(LS_GIANNGAN_LK_TUAN_USD_MS) end LS_GIANNGAN_LK_TUAN_USD
       from v_temp
       group by transaction_date) UNPIVOT(VALUE FOR ma_ct IN(DOANHSO_GIANNGAN_LK_TUAN_VND AS
                                                     'DOANHSO_GIANNGAN_LK_TUAN_VND',
                                                     DOANHSO_GIANNGAN_LK_TUAN_USD AS
                                                      'DOANHSO_GIANNGAN_LK_TUAN_USD',
                                                     LS_GIANNGAN_LK_TUAN_VND as
                                                     'LS_GIANNGAN_LK_TUAN_VND',
                                                     LS_GIANNGAN_LK_TUAN_USD as
                                                     'LS_GIANNGAN_LK_TUAN_USD' )) a
union all
select transaction_date, line, ma_ct, 
       case when ma_ct = 'DOANHSO_GIANNGAN_LK_TUAN_VND' then 'Doanh số giải ngân VND lũy kế tuần'
            when ma_ct = 'DOANHSO_GIANNGAN_LK_TUAN_USD' then 'Doanh số giải ngân USD lũy kế tuần'
            when ma_ct = 'LS_GIANNGAN_LK_TUAN_VND' then 'Lãi suất bình quân các khoản giải ngân VND lũy kế tuần'
            when ma_ct = 'LS_GIANNGAN_LK_TUAN_USD' then 'Lãi suất bình quân các khoản giải ngân USD lũy kế tuần'
       end ten_ct,
       value

from (select transaction_date, line, 
       sum(DOANHSO_GIANNGAN_LK_TUAN_VND) DOANHSO_GIANNGAN_LK_TUAN_VND,
       sum(DOANHSO_GIANNGAN_LK_TUAN_USD) DOANHSO_GIANNGAN_LK_TUAN_USD,
       case when sum(LS_GIANNGAN_LK_TUAN_VND_MS) =0 then 0 
            else sum(LS_GIANNGAN_LK_TUAN_VND_TS)/sum(LS_GIANNGAN_LK_TUAN_VND_MS) end LS_GIANNGAN_LK_TUAN_VND,
       case when sum(LS_GIANNGAN_LK_TUAN_USD_MS) =0 then 0
            else sum(LS_GIANNGAN_LK_TUAN_USD_TS)/sum(LS_GIANNGAN_LK_TUAN_USD_MS) end LS_GIANNGAN_LK_TUAN_USD
       from v_temp where line in ('CIB','SME','INDIV')
       group by transaction_date,line) UNPIVOT(VALUE FOR ma_ct IN(DOANHSO_GIANNGAN_LK_TUAN_VND AS
                                                     'DOANHSO_GIANNGAN_LK_TUAN_VND',
                                                     DOANHSO_GIANNGAN_LK_TUAN_USD AS
                                                      'DOANHSO_GIANNGAN_LK_TUAN_USD',
                                                     LS_GIANNGAN_LK_TUAN_VND as
                                                     'LS_GIANNGAN_LK_TUAN_VND',
                                                     LS_GIANNGAN_LK_TUAN_USD as
                                                     'LS_GIANNGAN_LK_TUAN_USD' )) a</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
