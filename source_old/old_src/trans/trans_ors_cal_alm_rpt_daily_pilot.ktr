  <step>
    <name>RPT_CEO_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT
TXN_DATE TRANSACTION_DATE,
IND MA_CT,
IND_NAME TEN_CT,
KHOI LINE,
VAL VALUE
FROM 
RPT.RPT_CEO_DAILY
WHERE TXN_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
