  <step>
    <name>tk_tattoan 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>with tmp_tk_tattoan as (
  select
    a.ngaydh,
    TRANSACTION_DATE,
    sum (ducuoi_vnd) / 1e9 value,
    case
      when KYHAN_TXT like '%M' then case
        when to_number (replace (KYHAN_TXT, 'M')) between 0
        and 5 then '1M_5M'
        when to_number (replace (KYHAN_TXT, 'M')) IN (6, 12, 13) then KYHAN_TXT
        when to_number (replace (KYHAN_TXT, 'M')) between 7
        and 11 then '7M_11M'
        when to_number (replace (KYHAN_TXT, 'M')) > 13 then 'ABV_13M'
      end
      when KYHAN_TXT like '%D' then case
        when to_number (replace (KYHAN_TXT, 'D')) between 0
        and 179 then '1M_5M'
        when to_number (replace (KYHAN_TXT, 'D')) between 180
        and 209 then '6M'
        when to_number (replace (KYHAN_TXT, 'D')) between 210
        and 364 then '7M_11M'
        when to_number (replace (KYHAN_TXT, 'D')) between 365
        and 389 then '12M'
        when to_number (replace (KYHAN_TXT, 'D')) between 390
        and 449 then '13M'
        when to_number (replace (KYHAN_TXT, 'D')) >= 450 then 'ABV_13M'
      end
      when KYHAN_TXT like '%W' then case
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 0
        and 179 then '1M_5M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 180
        and 209 then '6M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 210
        and 364 then '7M_11M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 365
        and 389 then '12M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 390
        and 449 then '13M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 >= 450 then 'ABV_13M'
      end
      else '1M_5M'
    end nhom_kyhan
  from
    apps.mb_tr_tk_tattoan a
  where
    a.TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    and substr (a.GL, 1, 2) in ('42', '43')
    and substr (a.PRODUCT_CODE, 1, 2) in ('11', '12', '13')
  group by
    case
      when KYHAN_TXT like '%M' then case
        when to_number (replace (KYHAN_TXT, 'M')) between 0
        and 5 then '1M_5M'
        when to_number (replace (KYHAN_TXT, 'M')) IN (6, 12, 13) then KYHAN_TXT
        when to_number (replace (KYHAN_TXT, 'M')) between 7
        and 11 then '7M_11M'
        when to_number (replace (KYHAN_TXT, 'M')) > 13 then 'ABV_13M'
      end
      when KYHAN_TXT like '%D' then case
        when to_number (replace (KYHAN_TXT, 'D')) between 0
        and 179 then '1M_5M'
        when to_number (replace (KYHAN_TXT, 'D')) between 180
        and 209 then '6M'
        when to_number (replace (KYHAN_TXT, 'D')) between 210
        and 364 then '7M_11M'
        when to_number (replace (KYHAN_TXT, 'D')) between 365
        and 389 then '12M'
        when to_number (replace (KYHAN_TXT, 'D')) between 390
        and 449 then '13M'
        when to_number (replace (KYHAN_TXT, 'D')) >= 450 then 'ABV_13M'
      end
      when KYHAN_TXT like '%W' then case
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 0
        and 179 then '1M_5M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 180
        and 209 then '6M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 210
        and 364 then '7M_11M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 365
        and 389 then '12M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 between 390
        and 449 then '13M'
        when to_number (replace (KYHAN_TXT, 'W')) * 7 >= 450 then 'ABV_13M'
      end
      else '1M_5M'
    end,
    ngaydh,
    TRANSACTION_DATE
)
select
  transaction_date,
  case
    when nhom_kyhan = '1M_5M' then 'HDV_TATTOAN_DH_1M_5M'
    when nhom_kyhan = '6M' then 'HDV_TATTOAN_DH_6M'
    when nhom_kyhan = '12M' then 'HDV_TATTOAN_DH_12M'
    when nhom_kyhan = '13M' then 'HDV_TATTOAN_DH_13M'
    when nhom_kyhan = '7M_11M' then 'HDV_TATTOAN_DH_7M_11M'
    when nhom_kyhan = 'ABV_13M' then 'HDV_TATTOAN_DH_ABV_13M'
  end ma_ct,
  case
    when nhom_kyhan = '1M_5M' then 'Huy động vốn tất toán đúng hạn 1-5M'
    when nhom_kyhan = '7M_11M' then 'Huy động vốn tất toán đúng hạn 7-11M'
    when nhom_kyhan = '6M' then 'Huy động vốn tất toán đúng hạn 6M'
    when nhom_kyhan = '12M' then 'Huy động vốn tất toán đúng hạn 12M'
    when nhom_kyhan = '13M' then 'Huy động vốn tất toán đúng hạn 13M'
    when nhom_kyhan = 'ABV_13M' then 'Huy động vốn tất toán đúng hạn trên 13M'
  end ten_ct,
  'ALL' line,
  sum(value) value
from
  tmp_tk_tattoan
where
  transaction_date >= ngaydh - 1
group by
  nhom_kyhan,
  transaction_date
union
all
select
  transaction_date,
  'HDV_TATTOAN_DH' ma_ct,
  'Huy động vốn tất toán đúng hạn' ten_ct,
  'ALL' line,
  sum(value) value
from
  tmp_tk_tattoan
where
  transaction_date >= ngaydh - 1
  group by transaction_date
union
all
select
  transaction_date,
  case
    when nhom_kyhan = '1M_5M' then 'HDV_TATTOAN_TH_1M_5M'
    when nhom_kyhan = '6M' then 'HDV_TATTOAN_TH_6M'
    when nhom_kyhan = '12M' then 'HDV_TATTOAN_TH_12M'
    when nhom_kyhan = '13M' then 'HDV_TATTOAN_TH_13M'
    when nhom_kyhan = '7M_11M' then 'HDV_TATTOAN_TH_7M_11M'
    when nhom_kyhan = 'ABV_13M' then 'HDV_TATTOAN_TH_ABV_13M'
  end ma_ct,
  case
    when nhom_kyhan = '1M_5M' then 'Huy động vốn tất toán trước hạn 1-5M'
    when nhom_kyhan = '7M_11M' then 'Huy động vốn tất toán trước hạn 7-11M'
    when nhom_kyhan = '6M' then 'Huy động vốn tất toán trước hạn 6M'
    when nhom_kyhan = '12M' then 'Huy động vốn tất toán trước hạn 12M'
    when nhom_kyhan = '13M' then 'Huy động vốn tất toán trước hạn 13M'
    when nhom_kyhan = 'ABV_13M' then 'Huy động vốn tất toán trước hạn trên 13M'
  end ten_ct,
  'ALL' line,
  sum(value) value
from
  tmp_tk_tattoan
where
  transaction_date &lt; ngaydh - 1
group by
  nhom_kyhan,
  transaction_date
union all
select
  transaction_date,
  'HDV_TATTOAN_TH' ma_ct,
  'Huy động vốn tất toán trước hạn' ten_ct,
  'ALL' line,
  sum(value) value
from
  tmp_tk_tattoan
where
  transaction_date &lt; ngaydh - 1
group by
  transaction_date</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
