  <step>
    <name>TR_TK</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>with v_temp as(
    select
        sum (ducuoi_vnd) / 1e9 value,
        khoi,
        case
            when KYHAN_TXT like '%M' then case
                --when to_number (replace (KYHAN_TXT, 'M')) &lt; 1 then 'DUOI_1M'
                when to_number (replace (KYHAN_TXT, 'M')) between 0
                and 5 then '1M_5M'
                when to_number (replace (KYHAN_TXT, 'M')) between 7
                and 11 then '7M_11M'
                when to_number (replace (KYHAN_TXT, 'M')) IN (6, 12, 13) then KYHAN_TXT
                when to_number (replace (KYHAN_TXT, 'M')) > 13 then 'ABV_13M'
            end
            when KYHAN_TXT like '%D' then case
                when to_number (replace (KYHAN_TXT, 'D')) between 0
                and 179 then '1M_5M'
                when to_number (replace (KYHAN_TXT, 'D')) between 180
                and 209 then '6M'
                when to_number (replace (KYHAN_TXT, 'D')) between 210
                and 364 then '7M_11M'
                when to_number (replace (KYHAN_TXT, 'D')) between 365
                and 389 then '12M'
                when to_number (replace (KYHAN_TXT, 'D')) between 390
                and 449 then '13M'
                when to_number (replace (KYHAN_TXT, 'D')) >= 450 then 'ABV_13M'
            end
            when KYHAN_TXT like '%W' then case
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 0
                and 179 then '1M_5M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 180
                and 209 then '6M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 210
                and 364 then '7M_11M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 365
                and 389 then '12M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 390
                and 449 then '13M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 >= 450 then 'ABV_13M'
            end
            else '1M_5M'
        end nhom_kyhan,
        start_date,
        ngayms
    from
        apps.tr_tk a
    where
        a.TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
        and substr (a.GL, 1, 2) in ('42', '43')
        and substr (a.PRODUCT_CODE, 1, 2) in ('11', '12', '13')
        and khoi is not null
    group by
        khoi,
        start_date,
        ngayms,
        case
            when KYHAN_TXT like '%M' then case
                --when to_number (replace (KYHAN_TXT, 'M')) &lt; 1 then 'DUOI_1M'
                when to_number (replace (KYHAN_TXT, 'M')) between 0
                and 5 then '1M_5M'
                when to_number (replace (KYHAN_TXT, 'M')) between 7
                and 11 then '7M_11M'
                when to_number (replace (KYHAN_TXT, 'M')) IN (6, 12, 13) then KYHAN_TXT
                when to_number (replace (KYHAN_TXT, 'M')) > 13 then 'ABV_13M'
            end
            when KYHAN_TXT like '%D' then case
                when to_number (replace (KYHAN_TXT, 'D')) between 0
                and 179 then '1M_5M'
                when to_number (replace (KYHAN_TXT, 'D')) between 180
                and 209 then '6M'
                when to_number (replace (KYHAN_TXT, 'D')) between 210
                and 364 then '7M_11M'
                when to_number (replace (KYHAN_TXT, 'D')) between 365
                and 389 then '12M'
                when to_number (replace (KYHAN_TXT, 'D')) between 390
                and 449 then '13M'
                when to_number (replace (KYHAN_TXT, 'D')) >= 450 then 'ABV_13M'
            end
            when KYHAN_TXT like '%W' then case
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 0
                and 179 then '1M_5M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 180
                and 209 then '6M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 210
                and 364 then '7M_11M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 365
                and 389 then '12M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 between 390
                and 449 then '13M'
                when to_number (replace (KYHAN_TXT, 'W')) * 7 >= 450 then 'ABV_13M'
            end
            else '1M_5M'
        end
)
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    case
        when nhom_kyhan = '1M_5M' then 'HDV_TD_1M_5M'
        when nhom_kyhan = '6M' then 'HDV_TD_6M'
        when nhom_kyhan = '7M_11M' then 'HDV_TD_7M_11M'
        when nhom_kyhan = '12M' then 'HDV_TD_12M'
        when nhom_kyhan = '13M' then 'HDV_TD_13M'
        when nhom_kyhan = 'ABV_13M' then 'HDV_TD_ABV_13M'
    end ma_ct,
    case
        -- when nhom_kyhan = '1M_5M' then 'HĐV thời điểm từ 1-5M'
        -- when nhom_kyhan = '7M_11M' then 'HĐV thời điểm từ 6-12M'
        -- when nhom_kyhan = '13M_15M' then 'HĐV thời điểm từ 13-15M'
        -- when nhom_kyhan = 'ABV_15M' then 'HĐV thời điểm > 15 tháng'
        when nhom_kyhan = '1M_5M' then 'HĐV thời điểm từ 1-5M'
        when nhom_kyhan = '6M' then 'HĐV thời điểm 6M'
        when nhom_kyhan = '7M_11M' then 'HĐV thời điểm từ 7-11M'
        when nhom_kyhan = '12M' then 'HĐV thời điểm 12M'
        when nhom_kyhan = '13M' then 'HĐV thời điểm 13M'
        when nhom_kyhan = 'ABV_13M' then 'HĐV thời điểm > 13 tháng'
    end ten_ct,
    khoi line,
    sum(value) value
from
    v_temp a
group by
    nhom_kyhan,
    khoi ---------------
union
all
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    case
        when nhom_kyhan = '1M_5M' then 'HDV_TD_1M_5M'
        when nhom_kyhan = '6M' then 'HDV_TD_6M'
        when nhom_kyhan = '7M_11M' then 'HDV_TD_7M_11M'
        when nhom_kyhan = '12M' then 'HDV_TD_12M'
        when nhom_kyhan = '13M' then 'HDV_TD_13M'
        when nhom_kyhan = 'ABV_13M' then 'HDV_TD_ABV_13M'
    end ma_ct,
    case
        when nhom_kyhan = '1M_5M' then 'HĐV thời điểm từ 1-5M'
        when nhom_kyhan = '6M' then 'HĐV thời điểm 6M'
        when nhom_kyhan = '7M_11M' then 'HĐV thời điểm từ 7-11M'
        when nhom_kyhan = '12M' then 'HĐV thời điểm 12M'
        when nhom_kyhan = '13M' then 'HĐV thời điểm 13M'
        when nhom_kyhan = 'ABV_13M' then 'HĐV thời điểm > 13 tháng'
    end ten_ct,
    'ALL' line,
    sum(value) value
from
    v_temp a
group by
    nhom_kyhan ---------------
union
all
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    case
        when nhom_kyhan = '1M_5M' then 'HDV_MOMOI_1M_5M'
        when nhom_kyhan = '6M' then 'HDV_MOMOI_6M'
        when nhom_kyhan = '7M_11M' then 'HDV_MOMOI_7M_11M'
        when nhom_kyhan = '12M' then 'HDV_MOMOI_12M'
        when nhom_kyhan = '13M' then 'HDV_MOMOI_13M'
        when nhom_kyhan = 'ABV_13M' then 'HDV_MOMOI_ABV_13M'
    end ma_ct,
    case
         when nhom_kyhan = '1M_5M' then 'Huy động vốn mở mới từ 1-5M'
        when nhom_kyhan = '6M' then 'Huy động vốn mở mới 6M'
        when nhom_kyhan = '7M_11M' then 'Huy động vốn mở mới từ 7-11M'
        when nhom_kyhan = '12M' then 'Huy động vốn mở mới 12M'
        when nhom_kyhan = '13M' then 'Huy động vốn mở mới 13M'
        when nhom_kyhan = 'ABV_13M' then 'Huy động vốn mở mới > 13 tháng'
    end ten_ct,
    'ALL' line,
    sum(value) value
from
    v_temp a
where
    to_date ('${PRD_ID}', 'YYYYMMDD') = start_date
    -- and nhom_kyhan &lt;&gt; 'DUOI_1M'
group by
    nhom_kyhan
union
all
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'HDV_MOMOI' ma_ct,
    'Huy động vốn mở mới' ten_ct,
    'ALL' line,
    sum(value) value
from
    v_temp a
where
    to_date ('${PRD_ID}', 'YYYYMMDD') = start_date --and nhom_kyhan&lt;&gt; 'DUOI_1M' 
union
all
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    case
       when nhom_kyhan = '1M_5M' then 'HDV_QUAYVONG_1M_5M'
        when nhom_kyhan = '6M' then 'HDV_QUAYVONG_6M'
        when nhom_kyhan = '7M_11M' then 'HDV_QUAYVONG_7M_11M'
        when nhom_kyhan = '12M' then 'HDV_QUAYVONG_12M'
        when nhom_kyhan = '13M' then 'HDV_QUAYVONG_13M'
        when nhom_kyhan = 'ABV_13M' then 'HDV_QUAYVONG_ABV_13M'
    end ma_ct,
    case
        when nhom_kyhan = '1M_5M' then 'Huy động vốn quay vòng từ 1-5M'
        when nhom_kyhan = '6M' then 'Huy động vốn quay vòng 6M'
        when nhom_kyhan = '7M_11M' then 'Huy động vốn quay vòng từ 7-11M'
        when nhom_kyhan = '12M' then 'Huy động vốn quay vòng 12M'
        when nhom_kyhan = '13M' then 'Huy động vốn quay vòng 13M'
        when nhom_kyhan = 'ABV_13M' then 'Huy động vốn quay vòng > 13 tháng'
    end ten_ct,
    'ALL' line,
    sum(value) value
from
    v_temp a
where
    --nhom_kyhan &lt;&gt; 'DUOI_1M'
    1=1
    and to_date ('${PRD_ID}', 'YYYYMMDD') > start_date
    and ngayms = to_date ('${PRD_ID}', 'YYYYMMDD')
group by
    nhom_kyhan
union
all
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'HDV_QUAYVONG' ma_ct,
    'Huy động vốn quay vòng' ten_ct,
    'ALL' line,
    sum(value) value
from
    v_temp a
where
    to_date ('${PRD_ID}', 'YYYYMMDD') > start_date
    and ngayms = to_date ('${PRD_ID}', 'YYYYMMDD')</sql>
