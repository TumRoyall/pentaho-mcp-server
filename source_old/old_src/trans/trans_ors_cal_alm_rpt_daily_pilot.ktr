  <step>
    <name>TPDN_BQ 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>WITH v_sk_tpdn_bq_daily_bt as (
    select
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk,
        khoi line
    from
        (
            select
                sum (FACE_AMOUNT + CKPT_CONLAI) * to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) / 1e9 ducuoi_vnd,
                ISSUER_KHOI khoi
            from
                apps.MB_TR_SK_TPDN_BQ_DAILY
            where
                TRANS_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
            group by
                ISSUER_KHOI
        )
    group by
        khoi
),
v_sk_tpdn as (
    select
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD')) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DD'))
            )
        end value,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT' then sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                ) + 1
            )
            else sum(ducuoi_vnd) /(
                to_number(
                    to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                )
            )
        end value_lk,
        khoi line
    from
        (
            select
                nvl(sum (FACE_AMOUNT + CKPT_CONLAI) / 1e9, 0) ducuoi_vnd,
                ISSUER_KHOI khoi
            from
                apps.MB_TR_SK_TPDN
            where
                TRANS_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                and to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
                and to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
                and ISSUER_KHOI IN ('CIB', 'SME')
            group by
                ISSUER_KHOI
        )
    GROUP BY
        khoi
),
v_sk_tpdn_bq_daily_lk as (
    select
        ISSUER_KHOI line,
        case
            when to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DY') = 'SAT'
            and (
                to_date ('${PRD_ID}', 'YYYYMMDD') &lt;&gt; last_day(to_date ('${PRD_ID}', 'YYYYMMDD'))
            ) then SUM (
                (FACE_AMOUNT + CKPT_CONLAI) * (to_number (to_char (TRANS_DATE, 'DD'))) /(
                    to_number (
                        to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                    ) + 1
                )
            ) / 1e9
            else SUM (
                (FACE_AMOUNT + CKPT_CONLAI) * (to_number (to_char (TRANS_DATE, 'DD'))) /(
                    to_number (
                        to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
                    )
                )
            ) / 1e9
        end value_lk
    from
        apps.MB_TR_SK_TPDN_BQ_DAILY
    where
        TRANS_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR')
        and trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') -1
        and TRANS_DATE = last_day (TRANS_DATE)
    group by
        issuer_khoi
)
select
    to_date('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'TP_BQ' ma_ct,
    'Quy mô TPDN bình quân tháng' ten_ct,
    line,
    sum(value) value
from
    (
        select
            line,
            value
        from
            v_sk_tpdn_bq_daily_bt
        union
        all
        select
            line,
            value
        from
            v_sk_tpdn
    )
group by
    line
UNION
ALL
select
    to_date('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'TP_BQ' ma_ct,
    'Quy mô TPDN bình quân tháng' ten_ct,
    'ALL' line,
    sum(value) value
from
    (
        select
            line,
            value
        from
            v_sk_tpdn_bq_daily_bt
        union
        all
        select
            line,
            value
        from
            v_sk_tpdn
    )
UNION
ALL
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'TP_BQ_LK' ma_ct,
    'Quy mô TPDN bình quân lũy kế' ten_ct,
    line,
    sum(value_lk) value
from
    (
        select
            line,
            value_lk
        from
            v_sk_tpdn
        union
        all
        select
            line,
            value_lk
        from
            v_sk_tpdn_bq_daily_lk
        union
        all
        select
            line,
            value_lk
        from
            v_sk_tpdn_bq_daily_bt
    )
group by
    line
UNION
ALL
select
    to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
    'TP_BQ_LK' ma_ct,
    'Quy mô TPDN bình quân lũy kế' ten_ct,
    'ALL' line,
    sum(value_lk) value
from
    (
        select
            line,
            value_lk
        from
            v_sk_tpdn
        union
        all
        select
            line,
            value_lk
        from
            v_sk_tpdn_bq_daily_lk
        union
        all
        select
            line,
            value_lk
        from
            v_sk_tpdn_bq_daily_bt
    )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
