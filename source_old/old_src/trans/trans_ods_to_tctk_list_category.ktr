      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT TXN_DATE,
	SOURCE_TABLE_NAME,
	ENTRY_ID,
	RELATION_TXN_NBR,
	CURRENCY_CODE,
	FCY_AMT,
	LCY_AMT,
	BRANCH_CODE,
	PARTY_KEY,
	T24_CUST_ID,
	PARTY_FULL_NAME,
	COA_CODE,
	T24_LINE,
	GL_LINE,
	PL_CATE_CODE,
	GL_CMB_CODE,
	GL_SEGMENT_VALUE_CMB,
	GL_DEPT_CODE,
	RECEIVE_CHG_CODE,
	PAYMENT_CHG_CODE,
	CHG_PRODUCT_CODE,
	ARRANGEMENT_PRODUCT_CODE,
	TXN_CHANNEL_CODE,
	PARTY_SECTOR_CODE,
	PARTY_DIVISION_CODE,
	REPORT_DIVISION_CODE,
	LEVEL1_REPORT_ITEM_CODE,
	REPORT_ITEM_CODE,
	REPORT_ITEM_NAME,
	EB_REPORT_ITEM_IND,
	RM_CODE,
	CREATED_BY,
	CREATION_DATE,
	LAST_UPDATED_BY,
	LAST_UPDATE_DATE,
	CHG_TYPE,
	CHG_CODE,
	NARRATIVE,
	ARRANGEMENT_NBR,
	PL_TOTAL_PARENT_ITEM_NAME,
	PL_TOTAL_PARENT_ITEM_CODE,
	TXN_CODE,
	regexp_substr(RELATION_TXN_NBR, '[^-]+', 1, 2) F2B_FO_DEAL,
	regexp_substr(RELATION_TXN_NBR, '[^-]+', 1, 3) F2B_TXN_TYPE,
	regexp_substr(NARRATIVE, '[^ ]+', 1, 4) F2B_DEAL_TYPE
FROM ETL.ODS_PL_TXN_DAILY
WHERE TXN_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
	AND REPORT_DIVISION_CODE in ('TREASURY','FI')
	AND substr(LEVEL1_REPORT_ITEM_CODE, 1, 1) IN ('A', 'B')
	AND regexp_substr(RELATION_TXN_NBR, '[^-]+', 1, 1) = 'F2B'
UNION ALL
SELECT TXN_DATE,
	SOURCE_TABLE_NAME,
	ENTRY_ID,
	RELATION_TXN_NBR,
	CURRENCY_CODE,
	FCY_AMT,
	LCY_AMT,
	BRANCH_CODE,
	PARTY_KEY,
	T24_CUST_ID,
	PARTY_FULL_NAME,
	COA_CODE,
	T24_LINE,
	GL_LINE,
	PL_CATE_CODE,
	GL_CMB_CODE,
	GL_SEGMENT_VALUE_CMB,
	GL_DEPT_CODE,
	RECEIVE_CHG_CODE,
	PAYMENT_CHG_CODE,
	CHG_PRODUCT_CODE,
	ARRANGEMENT_PRODUCT_CODE,
	TXN_CHANNEL_CODE,
	PARTY_SECTOR_CODE,
	PARTY_DIVISION_CODE,
	REPORT_DIVISION_CODE,
	LEVEL1_REPORT_ITEM_CODE,
	REPORT_ITEM_CODE,
	REPORT_ITEM_NAME,
	EB_REPORT_ITEM_IND,
	RM_CODE,
	CREATED_BY,
	CREATION_DATE,
	LAST_UPDATED_BY,
	LAST_UPDATE_DATE,
	CHG_TYPE,
	CHG_CODE,
	NARRATIVE,
	ARRANGEMENT_NBR,
	PL_TOTAL_PARENT_ITEM_NAME,
	PL_TOTAL_PARENT_ITEM_CODE,
	TXN_CODE,
	NULL F2B_FO_DEAL,
	NULL F2B_TXN_TYPE,
	NULL F2B_DEAL_TYPE
FROM ETL.ODS_PL_TXN_DAILY
WHERE TXN_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
	AND REPORT_DIVISION_CODE in ('TREASURY','FI')
	AND substr(LEVEL1_REPORT_ITEM_CODE, 1, 1) IN ('A', 'B')
	AND regexp_substr(RELATION_TXN_NBR, '[^-]+', 1, 1) &lt;&gt; 'F2B'</sql>
