  <step>
    <name>LAY LS KKH EUR</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <sql>SELECT 
A.CURRENCY,
'NHS' KHOI,
A.DATE_APPLY, 
A.AMOUNT
FROM FTP_DIC_LS_KKH A WHERE A.KHOI = 'INDIV'
AND A.DATE_APPLY = TO_DATE(${PRD_ID}, 'yyyyMMdd')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>106</xloc>
      <yloc>154</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>LAY LS KKH EUR (NEW)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <sql>--TINH LS KKH CHO DONG EUR BASE TR�N USD
SELECT A.KHOI,
       A.CURRENCY,
       A.TRANSACTION_DATE DATE_APPLY,
       SUM(nvl(B.AMOUNT, 0) * nvl(C.AMOUNT, 0)) TU,
       SUM(nvl(C.AMOUNT, 0)) MAU,
       ROUND(DECODE(SUM(nvl(C.AMOUNT, 0)),
                    0,
                    NULL,
                    SUM(nvl(B.AMOUNT, 0) * nvl(C.AMOUNT, 0)) /
                    SUM(nvl(C.AMOUNT, 0))),
             2) AMOUNT
  FROM (
        --to hop CURRENCY va TERM
        Select C.KHOI,
                'EUR' currency,
                --a.currency,
                b.term,
                b.term_map,
                to_date(${PRD_ID}, 'yyyyMMdd') TRANSACTION_DATE
          from FTP_DIC_CURRENCY_FTP_BASE a,
                FTP_DIC_TERM_FTP_BASE     b,
                ftp_dic_khoi_ftp_base     C
         WHERE A.Currency = 'USD' --IN ('VND','USD')
        ) A
  LEFT JOIN
---Lay FTP BASE MAP QUA CURRENCY, TERM &amp; TRANSACTION_DATE
 (SELECT A.CURRENCY,
         A.TERM,
         A.DATE_APPLY,
         A.AMOUNT,
         to_date(${PRD_ID}, 'yyyyMMdd') TRANSACTION_DATE
    FROM FTP_DIC_FTP_BASE a
    JOIN (select CURRENCY, TERM, MAX(DATE_APPLY) DATE_APPLY
           from FTP_DIC_FTP_BASE
          WHERE DATE_APPLY &lt;= TO_DATE(${PRD_ID}, 'yyyyMMdd')
          GROUP BY CURRENCY, TERM) B
      on A.CURRENCY = B.CURRENCY
     AND A.TERM = B.TERM
     AND A.DATE_APPLY = B.DATE_APPLY
     ) B
    ON A.CURRENCY = B.CURRENCY
   AND A.TERM_MAP = B.TERM
   AND A.TRANSACTION_DATE = B.TRANSACTION_DATE
  LEFT JOIN
--LAY PERCENTILE
 (SELECT *
    FROM (select A.ATTRIBUTE_ID KHOI,
                 'EUR' CCY,
                 --A.CCY,
                 A.DATE_APPLY,
                 TO_DATE(${PRD_ID}, 'yyyyMMdd') TRANSACTION_DATE,
                 A.D,
                 A.W1,
                 A.W2,
                 A.W3,
                 A.M1,
                 A.M2,
                 A.M3,
                 A.M4,
                 A.M5,
                 A.M6,
                 A.M7,
                 A.M8,
                 A.M9,
                 A.M10,
                 A.M11,
                 A.M12,
                 A.M24,
                 A.M36,
                 A.M48,
                 A.M60,
                 A.ABOVE_M60
            from FTP_DIC_PERCENTILE A
            JOIN (select B.ATTRIBUTE_ID, B.CCY, MAX(B.DATE_APPLY) DATE_APPLY
                   from FTP_DIC_PERCENTILE B
                  WHERE B.TYPE_ID = 'UNIT'
                 and B.source_id ='VN'
                    AND B.DATE_APPLY &lt;=
                        to_date(substr(to_char(TO_DATE(substr(${PRD_ID}, 1, 6) || '01',
                                                       'yyyyMMdd') - 1,
                                               'yyyyMMdd'),
                                       1,
                                       6) || '01',
                                'yyyyMMdd') - 1
                 --TO_DATE(${PRD_ID}, 'yyyyMMdd')
                  GROUP BY B.ATTRIBUTE_ID, B.CCY) B
              ON A.ATTRIBUTE_ID = B.ATTRIBUTE_ID
             AND A.CCY = B.CCY
             AND A.DATE_APPLY = B.DATE_APPLY
           WHERE A.TYPE_ID = 'UNIT'
             AND A.CCY = 'USD'
             and a.source_id ='VN'
          --AND A.DATE_APPLY &lt;= TO_DATE(${PRD_ID}, 'yyyyMMdd')
           GROUP BY A.ATTRIBUTE_ID,
                    A.CCY,
                    A.DATE_APPLY,
                    A.D,
                    A.W1,
                    A.W2,
                    A.W3,
                    A.M1,
                    A.M2,
                    A.M3,
                    A.M4,
                    A.M5,
                    A.M6,
                    A.M7,
                    A.M8,
                    A.M9,
                    A.M10,
                    A.M11,
                    A.M12,
                    A.M24,
                    A.M36,
                    A.M48,
                    A.M60,
                    A.ABOVE_M60
          
          ) A UNPIVOT INCLUDE NULLS(AMOUNT FOR TERM IN(D AS 'O/N',
                                                       W1 AS '1W',
                                                       W2 AS '2W',
                                                       W3 AS '3W',
                                                       M1 AS '1M',
                                                       M2 AS '2M',
                                                       M3 AS '3M',
                                                       M4 AS '4M',
                                                       M5 AS '5M',
                                                       M6 AS '6M',
                                                       M7 AS '7M',
                                                       M8 AS '8M',
                                                       M9 AS '9M',
                                                       M10 AS '10M',
                                                       M11 AS '11M',
                                                       M12 AS '12M',
                                                       M24 AS '24M',
                                                       M36 AS '36M',
                                                       M48 AS '48M',
                                                       M60 AS '60M',
                                                       ABOVE_M60 AS 'RE'))) C
    ON A.KHOI = C.KHOI
   AND A.CURRENCY = C.CCY
   AND A.TRANSACTION_DATE = C.TRANSACTION_DATE
   AND A.TERM = C.TERM
 GROUP BY A.KHOI, A.CURRENCY, A.TRANSACTION_DATE
</sql>
