    <connection>tckt_dc</connection>
    <sql>WITH criteria_acctno AS (
    SELECT
        REPORT_CODE,
        SUB_NAME,
        REPORT_NAME,
        REPORT_ITEM_TYPE,
        REPORT_ITEM_DETAIL_CODE,
        RPT_ITEM_CODE,
        NO_SEQ,
        RPT_SEQ,
        IS_SHOW_FLAG,
        REPORT_ITEM_NAME,
        SUM_LEVEL,

        CASE
            WHEN UPPER(ACCT_NO) LIKE '%NOT%IN%'
                 AND REPORT_ITEM_SMY_OPERATOR = '+' THEN '-'
            WHEN UPPER(ACCT_NO) LIKE '%NOT%IN%'
                 AND REPORT_ITEM_SMY_OPERATOR = '-' THEN '+'
            ELSE REPORT_ITEM_SMY_OPERATOR
        END REPORT_ITEM_SMY_OPERATOR,

        TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,

        TRIM(
            REGEXP_SUBSTR(ACCT_NO, '''([^'']+)''', 1, LEVEL, NULL, 1)
        ) AS CF_BS_ITEM_CODE

    FROM ETL.FILE_MBG_CRITERIA_MAP
    WHERE SUM_LEVEL = 1
      AND DATA_SOURCE = 'RPT2_PS_CO'

    CONNECT BY REGEXP_SUBSTR(
                   ACCT_NO,
                   '''([^'']+)''',
                   1,
                   LEVEL,
                   NULL,
                   1
               ) IS NOT NULL
           AND PRIOR RPT_ITEM_CODE = RPT_ITEM_CODE
           AND PRIOR DBMS_RANDOM.VALUE IS NOT NULL
),

criteria_coa_code_cttv AS (
    SELECT
        REPORT_CODE,
        SUB_NAME,
        REPORT_NAME,
        REPORT_ITEM_TYPE,
        REPORT_ITEM_DETAIL_CODE,
        RPT_ITEM_CODE,
        NO_SEQ,
        RPT_SEQ,
        IS_SHOW_FLAG,
        REPORT_ITEM_NAME,
        SUM_LEVEL,

        CASE
            WHEN UPPER(COA_CODE_CTTV) LIKE '%NOT%IN%'
                 AND REPORT_ITEM_SMY_OPERATOR = '+' THEN '-'
            WHEN UPPER(COA_CODE_CTTV) LIKE '%NOT%IN%'
                 AND REPORT_ITEM_SMY_OPERATOR = '-' THEN '+'
            ELSE REPORT_ITEM_SMY_OPERATOR
        END REPORT_ITEM_SMY_OPERATOR,

        TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,

        TRIM(
            REGEXP_SUBSTR(COA_CODE_CTTV, '''([^'']+)''', 1, LEVEL, NULL, 1)
        ) AS CF_BS_ITEM_CODE

    FROM ETL.FILE_MBG_CRITERIA_MAP
    WHERE SUM_LEVEL = 1
      AND DATA_SOURCE = 'RPT2_PS_CO'

    CONNECT BY REGEXP_SUBSTR(
                   COA_CODE_CTTV,
                   '''([^'']+)''',
                   1,
                   LEVEL,
                   NULL,
                   1
               ) IS NOT NULL
           AND PRIOR RPT_ITEM_CODE = RPT_ITEM_CODE
           AND PRIOR DBMS_RANDOM.VALUE IS NOT NULL
),

criteria_coa_code_mb AS (
    SELECT
        REPORT_CODE,
        SUB_NAME,
        REPORT_NAME,
        REPORT_ITEM_TYPE,
        REPORT_ITEM_DETAIL_CODE,
        RPT_ITEM_CODE,
        NO_SEQ,
        RPT_SEQ,
        IS_SHOW_FLAG,
        REPORT_ITEM_NAME,
        SUM_LEVEL,

        CASE
            WHEN UPPER(COA_CODE_MB) LIKE '%NOT%IN%'
                 AND REPORT_ITEM_SMY_OPERATOR = '+' THEN '-'
            WHEN UPPER(COA_CODE_MB) LIKE '%NOT%IN%'
                 AND REPORT_ITEM_SMY_OPERATOR = '-' THEN '+'
            ELSE REPORT_ITEM_SMY_OPERATOR
        END REPORT_ITEM_SMY_OPERATOR,

        TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,

        TRIM(
            REGEXP_SUBSTR(COA_CODE_MB, '''([^'']+)''', 1, LEVEL, NULL, 1)
        ) AS CF_BS_ITEM_CODE

    FROM ETL.FILE_MBG_CRITERIA_MAP
    WHERE SUM_LEVEL = 1
      AND DATA_SOURCE = 'RPT2_PS_CO'

    CONNECT BY REGEXP_SUBSTR(
                   COA_CODE_MB,
                   '''([^'']+)''',
                   1,
                   LEVEL,
                   NULL,
                   1
               ) IS NOT NULL
           AND PRIOR RPT_ITEM_CODE = RPT_ITEM_CODE
           AND PRIOR DBMS_RANDOM.VALUE IS NOT NULL
),

TMP_CRITERIA_MAP_RPT2 AS (

    /* ================= ACCT_NO ================= */

    SELECT
        A1.TRANSACTION_DATE,
        A1.REPORT_CODE,
        A1.SUB_NAME,
        A1.REPORT_NAME,
        A1.REPORT_ITEM_TYPE,
        A1.REPORT_ITEM_DETAIL_CODE,
        A1.RPT_ITEM_CODE,
        A1.NO_SEQ,
        A1.RPT_SEQ,
        A1.IS_SHOW_FLAG,
        A1.REPORT_ITEM_NAME,
        A1.SUM_LEVEL,

        CASE
            WHEN A1.REPORT_ITEM_SMY_OPERATOR = '-'
                THEN (-1) * NVL(A1.PS_CO, 0)
            ELSE NVL(A1.PS_CO, 0)
        END AMT_LCY

    FROM (
        SELECT
            TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
            A.REPORT_CODE,
            A.SUB_NAME,
            A.REPORT_NAME,
            A.REPORT_ITEM_TYPE,
            A.REPORT_ITEM_DETAIL_CODE,
            A.RPT_ITEM_CODE,
            A.NO_SEQ,
            A.RPT_SEQ,
            A.IS_SHOW_FLAG,
            A.REPORT_ITEM_NAME,
            A.SUM_LEVEL,
            A.REPORT_ITEM_SMY_OPERATOR,
            SUM(NVL(B.PS_CO, 0)) PS_CO

        FROM criteria_acctno A
        LEFT JOIN (
            SELECT
                TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
                ACCT_NO,
                SUB_NAME,
                SUM(NVL(PS_NO, 0)) PS_NO,
                SUM(NVL(PS_CO, 0)) PS_CO
            FROM APPS.REF_MBG_CDTK_MONTHLY
            WHERE TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'YYYY')
                              AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
            GROUP BY ACCT_NO, SUB_NAME
        ) B
               ON A.SUB_NAME = B.SUB_NAME
              AND A.TRANSACTION_DATE = B.TRANSACTION_DATE
              AND A.CF_BS_ITEM_CODE = B.ACCT_NO

        WHERE A.CF_BS_ITEM_CODE IS NOT NULL

        GROUP BY
            A.REPORT_CODE,
            A.SUB_NAME,
            A.REPORT_NAME,
            A.REPORT_ITEM_TYPE,
            A.REPORT_ITEM_DETAIL_CODE,
            A.RPT_ITEM_CODE,
            A.NO_SEQ,
            A.RPT_SEQ,
            A.IS_SHOW_FLAG,
            A.REPORT_ITEM_NAME,
            A.SUM_LEVEL,
            A.REPORT_ITEM_SMY_OPERATOR
    ) A1

    UNION ALL

    /* ================= COA_CODE_CTTV ================= */

    SELECT
        A2.TRANSACTION_DATE,
        A2.REPORT_CODE,
        A2.SUB_NAME,
        A2.REPORT_NAME,
        A2.REPORT_ITEM_TYPE,
        A2.REPORT_ITEM_DETAIL_CODE,
        A2.RPT_ITEM_CODE,
        A2.NO_SEQ,
        A2.RPT_SEQ,
        A2.IS_SHOW_FLAG,
        A2.REPORT_ITEM_NAME,
        A2.SUM_LEVEL,

        CASE
            WHEN A2.REPORT_ITEM_SMY_OPERATOR = '-'
                THEN (-1) * NVL(A2.PS_CO, 0)
            ELSE NVL(A2.PS_CO, 0)
        END AMT_LCY

    FROM (
        SELECT
            TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
            A.REPORT_CODE,
            A.SUB_NAME,
            A.REPORT_NAME,
            A.REPORT_ITEM_TYPE,
            A.REPORT_ITEM_DETAIL_CODE,
            A.RPT_ITEM_CODE,
            A.NO_SEQ,
            A.RPT_SEQ,
            A.IS_SHOW_FLAG,
            A.REPORT_ITEM_NAME,
            A.SUM_LEVEL,
            A.REPORT_ITEM_SMY_OPERATOR,
            SUM(NVL(B.PS_CO, 0)) PS_CO

        FROM criteria_coa_code_cttv A
        LEFT JOIN (
            SELECT
                TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
                COA_CODE_CTTV,
                SUB_NAME,
                SUM(NVL(PS_NO, 0)) PS_NO,
                SUM(NVL(PS_CO, 0)) PS_CO
            FROM APPS.REF_MBG_CDTK_MONTHLY
            WHERE TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'YYYY')
                              AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
            GROUP BY COA_CODE_CTTV, SUB_NAME
        ) B
               ON A.SUB_NAME = B.SUB_NAME
              AND A.TRANSACTION_DATE = B.TRANSACTION_DATE
              AND A.CF_BS_ITEM_CODE = B.COA_CODE_CTTV

        WHERE A.CF_BS_ITEM_CODE IS NOT NULL

        GROUP BY
            A.REPORT_CODE,
            A.SUB_NAME,
            A.REPORT_NAME,
            A.REPORT_ITEM_TYPE,
            A.REPORT_ITEM_DETAIL_CODE,
            A.RPT_ITEM_CODE,
            A.NO_SEQ,
            A.RPT_SEQ,
            A.IS_SHOW_FLAG,
            A.REPORT_ITEM_NAME,
            A.SUM_LEVEL,
            A.REPORT_ITEM_SMY_OPERATOR
    ) A2

    UNION ALL

    /* ================= COA_CODE_MB ================= */

    SELECT
        A3.TRANSACTION_DATE,
        A3.REPORT_CODE,
        A3.SUB_NAME,
        A3.REPORT_NAME,
        A3.REPORT_ITEM_TYPE,
        A3.REPORT_ITEM_DETAIL_CODE,
        A3.RPT_ITEM_CODE,
        A3.NO_SEQ,
        A3.RPT_SEQ,
        A3.IS_SHOW_FLAG,
        A3.REPORT_ITEM_NAME,
        A3.SUM_LEVEL,

        CASE
            WHEN A3.REPORT_ITEM_SMY_OPERATOR = '-'
                THEN (-1) * NVL(A3.PS_CO, 0)
            ELSE NVL(A3.PS_CO, 0)
        END AMT_LCY

    FROM (
        SELECT
            TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
            A.REPORT_CODE,
            A.SUB_NAME,
            A.REPORT_NAME,
            A.REPORT_ITEM_TYPE,
            A.REPORT_ITEM_DETAIL_CODE,
            A.RPT_ITEM_CODE,
            A.NO_SEQ,
            A.RPT_SEQ,
            A.IS_SHOW_FLAG,
            A.REPORT_ITEM_NAME,
            A.SUM_LEVEL,
            A.REPORT_ITEM_SMY_OPERATOR,
            SUM(NVL(B.PS_CO, 0)) PS_CO

        FROM criteria_coa_code_mb A
        LEFT JOIN (
            SELECT
                TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
                COA_CODE_MB,
                SUB_NAME,
                SUM(NVL(PS_NO, 0)) PS_NO,
                SUM(NVL(PS_CO, 0)) PS_CO
            FROM APPS.REF_MBG_CDTK_MONTHLY
            WHERE TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'YYYY')
                              AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
            GROUP BY COA_CODE_MB, SUB_NAME
        ) B
               ON A.SUB_NAME = B.SUB_NAME
              AND A.TRANSACTION_DATE = B.TRANSACTION_DATE
              AND A.CF_BS_ITEM_CODE = B.COA_CODE_MB

        WHERE A.CF_BS_ITEM_CODE IS NOT NULL

        GROUP BY
            A.REPORT_CODE,
            A.SUB_NAME,
            A.REPORT_NAME,
            A.REPORT_ITEM_TYPE,
            A.REPORT_ITEM_DETAIL_CODE,
            A.RPT_ITEM_CODE,
            A.NO_SEQ,
            A.RPT_SEQ,
            A.IS_SHOW_FLAG,
            A.REPORT_ITEM_NAME,
            A.SUM_LEVEL,
            A.REPORT_ITEM_SMY_OPERATOR
    ) A3
)

SELECT
    TRANSACTION_DATE,
    REPORT_CODE,
    SUB_NAME,
    REPORT_NAME,
    REPORT_ITEM_TYPE,
    REPORT_ITEM_DETAIL_CODE,
    RPT_ITEM_CODE,
    NO_SEQ,
    RPT_SEQ,
    IS_SHOW_FLAG,
    REPORT_ITEM_NAME,
    SUM_LEVEL,
    SUM(AMT_LCY) AMT_LCY
FROM TMP_CRITERIA_MAP_RPT2
GROUP BY
    TRANSACTION_DATE,
    REPORT_CODE,
    SUB_NAME,
    REPORT_NAME,
    REPORT_ITEM_TYPE,
    REPORT_ITEM_DETAIL_CODE,
    RPT_ITEM_CODE,
    NO_SEQ,
    RPT_SEQ,
    IS_SHOW_FLAG,
    REPORT_ITEM_NAME,
    SUM_LEVEL</sql>
