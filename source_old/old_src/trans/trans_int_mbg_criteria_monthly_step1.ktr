    <connection>tckt_dc</connection>
    <sql>WITH criteria_condition AS (
    SELECT
        REPORT_CODE,
        SUB_NAME,
        REPORT_NAME,
        REPORT_ITEM_TYPE,
        REPORT_ITEM_DETAIL_CODE,
        RPT_ITEM_CODE,
        NO_SEQ,
        RPT_SEQ,
        IS_SHOW_FLAG,
        REPORT_ITEM_NAME,
        SUM_LEVEL,
        REPORT_ITEM_SMY_OPERATOR,
        CASE
            WHEN PERIOD = 'T' THEN TO_DATE(${PRD_ID}, 'YYYYMMDD')
            WHEN PERIOD = 'Y-1' THEN TRUNC(TO_DATE(${PRD_ID}, 'YYYYMMDD'), 'YEAR') - 1
            WHEN PERIOD = 'CK' THEN ADD_MONTHS(TO_DATE(${PRD_ID}, 'YYYYMMDD'), -12)
        END AS TRANSACTION_DATE,
        TRIM(
            REGEXP_SUBSTR(
                CF_BS_ITEM_CODE,
                '''([^'']+)''',
                1,
                LEVEL,
                NULL,
                1
            )
        ) AS CF_BS_ITEM_CODE
    FROM etl.file_MBG_CRITERIA_MAP
    WHERE SUM_LEVEL = 1
      AND DATA_SOURCE = 'RPT1'
    CONNECT BY REGEXP_SUBSTR(
                   CF_BS_ITEM_CODE,
                   '''([^'']+)''',
                   1,
                   LEVEL,
                   NULL,
                   1
               ) IS NOT NULL
           AND PRIOR RPT_ITEM_CODE = RPT_ITEM_CODE
           AND PRIOR DBMS_RANDOM.VALUE IS NOT NULL
)

SELECT
    TO_DATE(${PRD_ID}, 'YYYYMMDD') AS TRANSACTION_DATE,
    A.REPORT_CODE,
    A.SUB_NAME,
    A.REPORT_NAME,
    A.REPORT_ITEM_TYPE,
    A.REPORT_ITEM_DETAIL_CODE,
    A.RPT_ITEM_CODE,
    A.NO_SEQ,
    A.RPT_SEQ,
    A.IS_SHOW_FLAG,
    A.REPORT_ITEM_NAME,
    A.SUM_LEVEL,
    SUM(
        CASE
            WHEN A.REPORT_ITEM_SMY_OPERATOR = '-' THEN NVL(-B.AMT_LCY, 0)
            ELSE NVL(B.AMT_LCY, 0)
        END
    ) AS AMT_LCY
FROM criteria_condition A
LEFT JOIN APPS.FILE_MBG_REPORT_ITEM_MONTHLY B
       ON A.SUB_NAME = B.SUB_NAME
      AND A.TRANSACTION_DATE = B.TXN_DATE
      AND A.CF_BS_ITEM_CODE = B.CF_BS_ITEM_CODE
GROUP BY
    A.REPORT_CODE,
    A.SUB_NAME,
    A.REPORT_NAME,
    A.REPORT_ITEM_TYPE,
    A.REPORT_ITEM_DETAIL_CODE,
    A.RPT_ITEM_CODE,
    A.NO_SEQ,
    A.RPT_SEQ,
    A.IS_SHOW_FLAG,
    A.REPORT_ITEM_NAME,
    A.SUM_LEVEL
</sql>
