  <step>
    <name>Input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with txn_map as (
    select to_date(${PRD_ID}, 'YYYYMMDD') partition_date,
        b.MAKH,
        a.MA_GD_ID,
        a.SERVICE_PARTNER_CODE,
        a.SERVICE_PARTNER_NAME,
        a.TRANS_DATE,
        a.TAI_KHOAN,
        abs(a.AMOUNT) AMOUNT,
        a.TEN_GD,
        a.KENH_GD,
        a.TYPECODE,
        a.MERCHANT,
        a.MUC_PHI_CHOT,
        a.LOAI_DV,
        a.TELCO,
        a.LOAI_GD,
        a.CURRENCY,
        b.TXN_TYPE
    from etl.FILE_KSS_BAAS_TXN a
    left join etl.FILE_KSS_BAAS_TXN_TYPE_MAP b
        on a.SERVICE_PARTNER_CODE = b.SERVICE_PARTNER_CODE
        and (nvl(a.TEN_GD, 'x') like nvl(b.TEN_GD, 'x') or b.TEN_GD is null)
        and (nvl(a.KENH_GD, 'x') = b.KENH_GD or b.KENH_GD is null)
        and (nvl(a.TYPECODE, 'x') = b.TYPECODE or b.TYPECODE is null)
        and (nvl(a.MERCHANT, 'x') = b.MERCHANT or b.MERCHANT is null)
        and (nvl(a.MUC_PHI_CHOT, 'x') = b.MUC_PHI_CHOT or b.MUC_PHI_CHOT is null)
        and (nvl(a.LOAI_DV, 'x') = b.LOAI_DV or b.LOAI_DV is null)
        and (nvl(a.TELCO, 'x') = b.TELCO or b.TELCO is null)
        and (nvl(a.LOAI_GD, 'x') = b.LOAI_GD or b.LOAI_GD is null)
),
quymo_gd as (
    select service_partner_code,
        TXN_TYPE,
        sum(amount) QUYMO_DSGD,
        count(1) QUYMO_SLGD
    from txn_map
    group by service_partner_code, txn_type
),
quymo_casa as (
    SELECT SOTK, sum(sodu_binhquan_vnd) QUYMO_CASA
    FROM APPS.FIN_HDV_SMY_MONTHLY
    WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
    and (product_code like '11%' or product_code = '12111')
    group by sotk
),
t as (
    select a.partition_date,
        a.MAKH,
        a.SERVICE_PARTNER_CODE,
        a.SERVICE_PARTNER_NAME,
        a.TRANS_DATE,
        a.TAI_KHOAN,
        a.TEN_GD,
        a.KENH_GD,
        a.TYPECODE,
        a.MERCHANT,
        a.MUC_PHI_CHOT,
        a.LOAI_DV,
        a.TELCO,
        a.LOAI_GD,
        a.CURRENCY,
        b.TXN_TYPE,
        sum(a.amount) DSGD,
        count(1) SLGD,
        nvl(b.QUYMO_DSGD,0) QUYMO_DSGD,
        nvl(b.QUYMO_SLGD,0) QUYMO_SLGD,
        nvl(c.QUYMO_CASA,0) QUYMO_CASA,
        d.UNIT,
        nvl(d.chg_rate,0) chg_rate,
        d.MIN_CHG_AMT,
        d.MAX_CHG_AMT,
        d.VAT
    from txn_map a
    left join quymo_gd b
        on a.txn_type = b.txn_type
        and a.service_partner_code = b.service_partner_code
    left join quymo_casa c
        on a.tai_khoan = c.sotk
    left join etl.FILE_KSS_BAAS_BIEUPHI d
        on a.txn_type = d.txn_type
        and a.service_partner_code = d.service_partner_code
        and (nvl(b.QUYMO_DSGD, 0) >= d.FROM_DSGD or d.FROM_DSGD is null)
        and (nvl(b.QUYMO_DSGD, 0) &lt; d.TO_DSGD or d.TO_DSGD is null)
        and (nvl(b.QUYMO_SLGD, 0) >= d.FROM_SLGD or d.FROM_SLGD is null)
        and (nvl(b.QUYMO_SLGD, 0) &lt; d.TO_SLGD or d.TO_SLGD is null)
        and (nvl(c.QUYMO_CASA, 0) >= d.FROM_CASA or d.FROM_CASA is null)
        and (nvl(c.QUYMO_CASA, 0) &lt; d.TO_CASA or d.TO_CASA is null)
    group by a.partition_date,
        a.MAKH,
        a.SERVICE_PARTNER_CODE,
        a.SERVICE_PARTNER_NAME,
        a.TRANS_DATE,
        a.TAI_KHOAN,
        a.TEN_GD,
        a.KENH_GD,
        a.TYPECODE,
        a.MERCHANT,
        a.MUC_PHI_CHOT,
        a.LOAI_DV,
        a.TELCO,
        a.LOAI_GD,
        a.CURRENCY,
        b.TXN_TYPE,
        nvl(b.QUYMO_DSGD,0),
        nvl(b.QUYMO_SLGD,0),
        nvl(c.QUYMO_CASA,0),
        d.UNIT,
        d.chg_rate,
        d.MIN_CHG_AMT,
        d.MAX_CHG_AMT,
        d.VAT
)
select partition_date,
    MAKH,
    SERVICE_PARTNER_CODE,
    SERVICE_PARTNER_NAME,
    TRANS_DATE,
    TAI_KHOAN,
    TEN_GD,
    KENH_GD,
    TYPECODE,
    MERCHANT,
    MUC_PHI_CHOT,
    LOAI_DV,
    TELCO,
    LOAI_GD,
    CURRENCY,
    TXN_TYPE,
    DSGD,
    SLGD,
    QUYMO_DSGD,
    QUYMO_SLGD,
    QUYMO_CASA,
    UNIT,
    chg_rate,
    MIN_CHG_AMT,
    MAX_CHG_AMT,
    case
        when UNIT = 'SLGD' then SLGD * chg_rate
        when UNIT = 'DSGD' then DSGD * chg_rate
        else 0
    end CHG_AMT_TRUOC_VAT,
    case
        when UNIT = 'SLGD' then SLGD * chg_rate * (1+VAT)
        when UNIT = 'DSGD' then DSGD * chg_rate * (1+VAT)
        else 0
    end CHG_AMT_SAU_VAT
from t
</sql>
