    <connection>tckt_dc</connection>
    <sql>select transaction_date,cn,ftp_prod, khoi,nte,
sum(case when a.nte = 'VND' then round(ftp_trdc) else round(ftp_trdc,2) end) ftp_tdc ,
sum(case when a.nte = 'VND' then round(ftp_sdc) else round(ftp_sdc,2) end) ftp_sdc ,'THAUCHI' ftp_source,term term_ftp,term_id term_goc,
sum(abs(a.sodu_goc) -abs(a.sodu_dp)) sodu_tinh_ftp
from apps.ftp_cal_mv_thauchi a
where khoi is not null
and transaction_date =  to_date(${PRD_ID},'yyyyMMdd')
group by transaction_date,cn,ftp_prod, khoi,nte,term,term_id
order by transaction_date,cn,ftp_prod, khoi, nte,term,term_id</sql>
    <limit>0</limit>
