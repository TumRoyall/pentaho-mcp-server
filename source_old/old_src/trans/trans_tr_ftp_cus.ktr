  </step>
  <step>
    <name>FTP_LC_MTD</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
to_date('${PRD_ID}','YYYYMMDD') TRANSACTION_DATE,
a.MAKH MAKH,
b.HOTEN TENKH,
nvl(a.SECTOR,b.SECTOR) SECTOR,
a.SOTK TAIKHOAN,
a.TERM_FTP KYHAN,
sum(a.FCY_AMT)/to_char (to_date('${PRD_ID}','YYYYMMDD'), 'DD') SODU,
c.FTP_CATEGORY MA_SP_FTP,
a.CNC2 CNC2,
c.GL_LINE LINE_GL,
a.CCY NTE,
sum(-a.FTP_HT_FCY) AMT_FTP,
sum(-a.FTP_HT_LCY) AMT_LCY,
a.VALUE_DATE NGAYPS,
a.KHOI KHOI,
sum(a.LCY_AMT)/to_char (to_date('${PRD_ID}','YYYYMMDD'), 'DD') SODU_VND,
a.PRODUCT_CODE PRODUCT_CODE,
sum(-a.FTP_TT_FCY) AMT_FTP_TT,
sum(-a.FTP_TT_LCY) AMT_LCY_TT,
a.FTP_CODE FTP_CODE,
a.SOURCE_TABLE SOURCE_TABLE,
a.FTP_GROUP FTP_GROUP
FROM APPS.FTP_LC_NON_RECOURSE_DAILY a 
LEFT JOIN etl.ORS_TR_KHACHHANG b 
ON a.MAKH = b.MAKH 
LEFT JOIN apps.FTP_MAP_HTOAN C 
ON a.FTP_CODE =c.FTP_PROD AND a.KHOI =c.KHOI 
WHERE a.TRANSACTION_DATE BETWEEN trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH')-1 AND to_date('${PRD_ID}','YYYYMMDD')-1
AND a.FTP_HT_LCY > 0
GROUP BY 
a.MAKH, 
b.HOTEN, 
nvl(a.SECTOR,b.SECTOR), 
a.SOTK , 
a.TERM_FTP,
c.FTP_CATEGORY, 
a.CNC2,
c.GL_LINE, 
a.CCY,
a.VALUE_DATE,
a.KHOI, 
a.PRODUCT_CODE, 
a.FTP_CODE, 
a.SOURCE_TABLE ,
a.FTP_GROUP</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
