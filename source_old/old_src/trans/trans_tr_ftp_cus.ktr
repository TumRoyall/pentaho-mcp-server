  </step>
  <step>
    <name>CHOVAY_NOQUAHAN</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select 
  to_date('${PRD_ID}','YYYYMMDD') TRANSACTION_DATE, 
  a.MAKH,
  b.HOTEN as TENKH,
  nvl(a.SECTOR,b.SECTOR) as SECTOR,
  a.SOTK as TAIKHOAN,
  a.TERM_FTP as KYHAN,
  sum(a.FCY_AMT)/to_char (to_date('${PRD_ID}','YYYYMMDD'), 'DD') SODU,
  c.FTP_CATEGORY as MA_SP_FTP,
  a.CNC2 as CNC2,
  c.GL_LINE as LINE_GL,
  a.CCY as NTE,
  sum(-a.FTP_HT_FCY) as AMT_FTP,
  sum(-a.FTP_HT_LCY) as AMT_LCY,
  a.VALUE_DATE as NGAYPS,
  a.KHOI as KHOI,
  sum(a.LCY_AMT)/to_char (to_date('${PRD_ID}','YYYYMMDD'), 'DD') as SODU_VND,
  a.PRODUCT_CODE as PRODUCT_CODE,
  sum(-a.FTP_TT_FCY) as AMT_FTP_TT,
  sum(-a.FTP_TT_LCY) as AMT_LCY_TT,
  a.FTP_CODE as FTP_CODE,
  a.SOURCE_TABLE as SOURCE_TABLE,
  a.FTP_GROUP as FTP_GROUP
FROM APPS.FTP_CHOVAY_NOQUAHAN_DAILY a 
LEFT JOIN etl.ORS_TR_KHACHHANG b 
ON a.MAKH = b.MAKH 
LEFT JOIN apps.FTP_MAP_HTOAN C 
ON a.FTP_CODE =c.FTP_PROD AND a.KHOI =c.KHOI 
WHERE a.TRANSACTION_DATE BETWEEN trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH')-1 AND to_date('${PRD_ID}','YYYYMMDD')-1
AND FTP_HT_FCY > 0
GROUP BY 
  a.MAKH, 
  b.HOTEN, 
  nvl(a.SECTOR,b.SECTOR), 
  a.SOTK , 
  a.TERM_FTP,
  c.FTP_CATEGORY, 
  a.CNC2,
  c.GL_LINE, 
  a.CCY,
  a.VALUE_DATE,
  a.KHOI, 
  a.PRODUCT_CODE, 
  a.FTP_CODE, 
  a.SOURCE_TABLE ,
  a.FTP_GROUP</sql>
    <limit>0</limit>
