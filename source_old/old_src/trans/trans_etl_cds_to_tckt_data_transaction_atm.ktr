    <connection>cds_dc_etl_ods</connection>
    <sql>select PARTITION_DATE AS TRANSACTION_DATE,
		ATM_ID,
		ATM_TYPE,
		ATM_NAME,
		ATM_STATUS_DESC,
		ATM_ADDRESS,
		OPR_BRANCH_CODE,
		OPR_BRANCH_NAME,
		DEV_BRANCH_CODE,
		DEV_BRANCH_NAME,
		ATM_ACCOUNT_NUMBER
from cdt.ATM_CRM_LIST_ALL a
WHERE A.PARTITION_DATE = to_date(${PRD_ID},'YYYYMMDD')</sql>
