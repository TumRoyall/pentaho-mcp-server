  <step>
    <name>Table input 3 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with v_ngayms as (
     select distinct ngayms
     from  etl.ftp_int_tr_tk t1
     where transaction_date= to_date('${PRD_ID}','yyyyMMdd')
),

v_time as (
  select t1.ngayms , max(date_apply) date_apply
  from v_ngayms t1
  left join (select distinct date_apply from apps.ftp_dic_map_term_by_dateapply) t2
  on t1.ngayms >= t2.date_apply
  group by t1.ngayms
)
select a.cn,a.transaction_date,a.nte,
a.soso,a.makh,a.customer_name hoten,a.ls --sotk (luu y thay bang tr_tk vs bang int_tgtk)
,a.ftp_code ftp_prod,a.product_code,
a.khoi,
--nvl(a.ls_dacbiet,hddb.gia_hddb) ls_dacbiet,
a.ls_dacbiet,
a.sodu sodu_goc,--nvl(b.dp_cuthe_ftp_luyke,0) sodu_dp,
a.kh_taidinhgia term,
d.term_id term_goc,
nvl(b.kh_taidinhgia,nvl(a.kh_taidinhgia,d.term_id)) term_ftp,
c.vung_mien,
a.ngayms,
a.ngaydh,
a.ngay_tdls ngay_tdls_goc,
case --when a.ngay_tdls is null or a.kh_taidinhgia is null 
--or (HD110 v� product code sau: 12312, 12314, 12316, 12317, 13211 a nh� 
--or b.mis_code is not null
when a.ngay_tdls is null -- sua ngay 1/7/2016
then a.ngayms else to_date(a.ngay_tdls,'yyyyMMdd') end ngay_tdls from etl.ftp_int_tr_tk a
/*left join tr_khachhang kh
on a.makh = kh.makh
join apps.ftp_dic_mis_ftp_mapping f
on a.product_code = f.mis_code*/
/*left join ftp_pilot_hddb hddb
on a.soso = hddb.soso
and a.transaction_date >= to_date(hddb.start_date,'yyyyMMdd')
and a.transaction_date &lt;= to_date(hddb.end_date,'yyyyMMdd')
and 1=0 */ -- chay pilot lan 3
join v_time t
on a.ngayms = t.ngayms
left join apps.ftp_dic_map_term_by_dateapply d
on a.ngaydh- greatest(a.ngayms,to_date('20160118','yyyyMMdd')) >= d.from_day
and a.ngaydh - greatest(a.ngayms,to_date('20160118','yyyyMMdd')) &lt;= d.to_day
and a.nte = d.curr_id
and t.date_apply = d.date_apply
left join apps.ftp_dic_vungmien_khuvuc c
on a.cn= c.cn_cap_2
         LEFT JOIN
             apps.ftp_dic_tdg_thanoi b
         ON a.product_code = b.mis_code AND a.nte = b.nte
WHERE  a.check_ftp is not null and
 nvl(TO_DATE (b.date_apply, 'yyyyMMdd'),sysdate) =
            nvl((SELECT   MAX (TO_DATE (b2.date_apply, 'yyyyMMdd'))
                FROM   apps.ftp_dic_tdg_thanoi b2
               WHERE       TO_DATE (b2.date_apply, 'yyyyMMdd') &lt;= a.transaction_date
                       AND a.nte = b2.nte
                       AND a.product_code = b2.mis_code),sysdate)
--where a.product_code = 12313
--and kh_taidinhgia is not null
and transaction_date = to_date('${PRD_ID}','yyyyMMdd')</sql>
