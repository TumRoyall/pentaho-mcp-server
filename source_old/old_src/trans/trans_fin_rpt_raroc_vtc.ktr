  <step>
    <name>FIN_LNTT_RWA_KHOI_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with t as
    (select transaction_date,
        khoi,
        NULL pkkh,
        NULL product_code,
        'ETL.FIN_LNTT_RWA_KHOI_MONTHLY' source_table,
        chi_tieu_chi_tiet,
        value
    from (SELECT * FROM ETL.FIN_LNTT_RWA_KHOI_MONTHLY WHERE transaction_date = to_date('${PRD_ID}', 'YYYYMMDD'))
    unpivot(
          value for chi_tieu_chi_tiet in (RWA_CR_TSK,RWA_CR_TT1,RWA_OR,RWA_CR_TT2,RWA_MR,DTTTRR,DTTSRR,CPHD,LNTT_CPHD,RWA_TOTAL,VONPB_CR_TT1,VONPB_CR_TSK,VONPB_OR,VONPB_CR_TT2,VONPB_MR,VONPB_TOTAL)
    ))
select t.*,
    a.ten_chi_tieu,
    a.chi_tieu,
    a.loai_chi_tieu,
    NULL PARENT_LEVEL1,
    NULL PARENT_LEVEL2,
    NULL PARENT_LEVEL3,
    NULL PARENT_LEVEL1_NAME,
    NULL PARENT_LEVEL2_NAME,
    NULL PARENT_LEVEL3_NAME,
    NULL PRODUCT_NAME
from t
left join ETL.FILE_MAP_CHITIEU_RAROC a
    on t.chi_tieu_chi_tiet = a.chi_tieu_chi_tiet
</sql>
    <limit>0</limit>
