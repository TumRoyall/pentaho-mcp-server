  <step>
    <name>FIN_LNTT_RWA_PKKH_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with t as
    (select transaction_date,
        khoi,
        nvl(pkkh, 'KXD') pkkh,
        nvl(product_code, 'KXD') product_code,
        'ETL.FIN_LNTT_RWA_PKKH_MONTHLY' source_table,
        chi_tieu_chi_tiet,
        value
    from (SELECT * FROM ETL.FIN_LNTT_RWA_PKKH_MONTHLY WHERE transaction_date = to_date('${PRD_ID}', 'YYYYMMDD'))
    unpivot(
        value for chi_tieu_chi_tiet in (RWA_CR_TSK,RWA_CR_TT1,RWA_OR,RWA_CR_TT2,RWA_MR,DTTTRR,DTTSRR,CPHD,LNTT_CPHD,RWA_TOTAL,VONPB_CR_TT1,VONPB_CR_TSK,VONPB_OR,VONPB_CR_TT2,VONPB_MR,VONPB_TOTAL)
    ))
select t.*,
    a.ten_chi_tieu,
    a.chi_tieu,
    a.loai_chi_tieu,
    b.PARENT_LEVEL1,
    b.PARENT_LEVEL2,
    b.PARENT_LEVEL3,
    b.PARENT_LEVEL1_NAME,
    b.PARENT_LEVEL2_NAME,
    b.PARENT_LEVEL3_NAME,
    b.PRODUCT_NAME
from t
left join ETL.FILE_MAP_CHITIEU_RAROC a
    on t.chi_tieu_chi_tiet = a.chi_tieu_chi_tiet
left join etl.ORS_MB_PRODUCT_CODE b
    on t.product_code = b.product_code</sql>
