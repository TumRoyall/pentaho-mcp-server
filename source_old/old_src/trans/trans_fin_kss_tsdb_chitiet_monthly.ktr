    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with
nguon_1 as 
(
SELECT 
last_day(a.transaction_date) TRANSACTION_DATE,
a.ngay_denghi,
a.ngay_pheduyet ,
a.thoidiem_thamdinh_gannhat ngay_thamdinhgannhat,
a.so_baocao,
a.ma_taisan ma_ts,
a.chi_nhanh cnc1,
a.pgd cnc2,
a.vung_amc,
a.nguoi_denghi canbo_denghi,
a.loai_kh,
a.khoi_ql khoi,
a.khachhang_name ten_kh,
a.loai_taisan loai_ts,
a.lan_thamdinh,
a.giatri_dinhgia,
a.phi_dinhgia,
a.donvi_dinhgia,
a.trangthai_hientai trangthai_hoso,
TT thang_doisoat_char,
last_day(a.ngay_pheduyet) thang_pheduyet
from ETL.FILE_KSS_TSDB_LIST_MONTHLY a
where a.transaction_date = (to_date('${PRD_ID}','yyyymmdd'))
group by 
last_day(a.transaction_date),
a.ngay_denghi,
a.ngay_pheduyet,
a.thoidiem_thamdinh_gannhat ,
a.so_baocao,
a.ma_taisan ,
a.chi_nhanh ,
a.pgd ,
a.vung_amc,
a.nguoi_denghi ,
a.loai_kh,
a.khoi_ql ,
a.khachhang_name ,
a.loai_taisan ,
a.lan_thamdinh,
a.giatri_dinhgia,
a.phi_dinhgia,
a.donvi_dinhgia,
a.trangthai_hientai,
last_day(a.ngay_pheduyet),
TT
) 
,
nguon as 
(
select a.*,b.ht_count_mats from nguon_1 a
left join (select ma_taisan,count(1) ht_count_mats from ETL.FILE_KSS_TSDB_LIST_MONTHLY 
where transaction_date =(to_date('${PRD_ID}','yyyymmdd'))
group by ma_taisan) b
on a.ma_ts = b.ma_taisan
)
,
OUT_1 AS 
(
--select count(1)
--from 
--(
select 
a.TRANSACTION_DATE,
a.ngay_denghi,
a.ngay_pheduyet,
a.ngay_thamdinhgannhat,
a.so_baocao,
a.ma_ts,
a.cnc1,
a.cnc2,
a.vung_amc,
a.canbo_denghi,
a.loai_kh,
a.khoi,
a.ten_kh,
a.loai_ts,
a.lan_thamdinh,
to_number(a.giatri_dinhgia) giatri_dinhgia,
to_number(a.phi_dinhgia) phi_dinhgia,
a.donvi_dinhgia,
a.trangthai_hoso,
a.ht_count_mats,
b.item HT_MATS_SOBCAO,
b.asset_valt_date ht_ngaythamdinh_ske_tsbd,
b.arrangement_nbr ht_ma_md_tsbd,
b.deal_input_date ht_ngaynhap_tsbd,
c.ngay_de_nghi ht_ngay_denghi,
c.ngay_phe_duyet ht_ngay_phe_duyet,
c.thoi_diem_gan_nhat ht_ngay_thamdinh_gannhat,
c.so_bc ht_so_baocao,
c.ma_tai_san ht_ma_ts,
a.thang_doisoat_char,
upper(c.ma_chi_nhanh) ht_cnc1,
upper(c.ma_phong_giao_dich) ht_cnc2,
case when c.khoi_kdql ='KHỐI KHCN' THEN 'KHCN' 
        when c.khoi_kdql ='KHỐI SME' THEN 'SME'                    
        when c.khoi_kdql ='KHỐI CIB' THEN 'CIB'   
        ELSE c.khoi_kdql end  ht_khoi,
c.ten_khach_hang ht_ten_khach_hang,
case when ( c.loai_ts  in ('BĐS và QTS phát sinh từ BĐS') or c.loai_ts like '%BĐS%' or c.loai_ts like '%QTS%') then 'BĐS' ELSE 'ĐS' END ht_loai_ts,
C.GIA_TRI_DINH_GIA ht_giatri_dinhgia,
case when c.thoi_diem_gan_nhat is not null and  (c.ngay_phe_duyet - c.thoi_diem_gan_nhat)/365 &lt; 1 then 'Tái thẩm &lt; 1 năm' 
       when c.thoi_diem_gan_nhat is not null and (c.ngay_phe_duyet - c.thoi_diem_gan_nhat)/365 >= 1 and (c.ngay_phe_duyet - c.thoi_diem_gan_nhat)/360 &lt;=2 then 'Tái thẩm 1-2 năm'
       when c.thoi_diem_gan_nhat is not null and (c.ngay_phe_duyet - c.thoi_diem_gan_nhat)/365 > 2  then 'Tái thẩm > 2 năm'
       when c.thoi_diem_gan_nhat is  null then 'Lần đầu' 
else null end  HT_LAN_THAMDINH,
c.trang_thai_hs ht_trang_thai_hs,
c.trang_thai_tt ht_trang_thai_tt
from nguon a
left join etl.ODS_CAL_CLT_STMT_MTH b
on nvl(a.ma_ts||'-'||a.so_baocao,0) =b.item
left join etl.ODS_BC_CMV03 c 
on nvl(c.ma_tai_san||'-'||c.so_bc,0) = nvl(a.ma_ts||'-'||a.so_baocao,0)
--where a.so_baocao ='24.326579.AMC.0'
)
,
out_2 
as(
SELECT 
last_day(NGAY_PHEDUYET) THANG_DOISOAT,
thang_doisoat_char,
to_date('${PRD_ID}','yyyymmdd') TRANSACTION_DATE,
a.NGAY_DENGHI,
a.NGAY_PHEDUYET,
a.NGAY_THAMDINHGANNHAT,
a.SO_BAOCAO,
a.MA_TS,
a.CNC1,
a.CNC2,
a.CANBO_DENGHI,
a.LOAI_KH,
a.KHOI,
a.TEN_KH,
a.LOAI_TS,
a.LAN_THAMDINH,
a.GIATRI_DINHGIA,
a.PHI_DINHGIA,
a.DONVI_DINHGIA,
a.TRANGTHAI_HOSO,
a.HT_COUNT_MATS,
a.HT_MATS_SOBCAO,
a.HT_NGAYTHAMDINH_SKE_TSBD,
a.HT_MA_MD_TSBD,
a.HT_NGAYNHAP_TSBD,
a.HT_NGAY_DENGHI,
a.HT_NGAY_PHE_DUYET,
a.HT_NGAY_THAMDINH_GANNHAT,
a.HT_SO_BAOCAO,
a.HT_MA_TS,
a.HT_CNC1,
a.HT_CNC2,
a.HT_KHOI,
a.HT_TEN_KHACH_HANG,
a.HT_LOAI_TS,
a.HT_GIATRI_DINHGIA,
a.HT_LAN_THAMDINH,
case when a.HT_LAN_THAMDINH ='Lần đầu' then 1
    when a.HT_LAN_THAMDINH ='Tái thẩm &lt; 1 năm'  then 0.25
     when a.HT_LAN_THAMDINH ='Tái thẩm 1-2 năm'  then 0.35
      when a.HT_LAN_THAMDINH ='Tái thẩm > 2 năm'  then 1 end HT_TYLE_PHI,
case when bp1.cach_tinh_phi='GIATRI' then nvl(bp1.mucphi_vnd,0)
WHEN bp1.cach_tinh_phi='TYLE' AND bp1.phi_max_vnd IS NULL THEN bp1.tyle *nvl(a.ht_giatri_dinhgia,0) -- bossung
  else least (nvl(bp1.tyle,0)*nvl(a.ht_giatri_dinhgia,0), bp1.phi_max_vnd) end HT_PHI,
(case when a.HT_LAN_THAMDINH ='Lần đầu' then 1
    when a.HT_LAN_THAMDINH ='Tái thẩm &lt; 1 năm'  then 0.25
     when a.HT_LAN_THAMDINH ='Tái thẩm 1-2 năm'  then 0.35
      when a.HT_LAN_THAMDINH ='Tái thẩm > 2 năm'  then 1 end)
      * 
      (case when bp1.cach_tinh_phi='GIATRI' then nvl(bp1.mucphi_vnd,0)
      WHEN bp1.cach_tinh_phi='TYLE' AND bp1.phi_max_vnd IS NULL THEN bp1.tyle *nvl(a.ht_giatri_dinhgia,0) -- bosssung
  else least (nvl(bp1.tyle,0)*nvl(a.ht_giatri_dinhgia,0), bp1.phi_max_vnd) end    ) ht_phi_dinhgia,
  a.ht_trang_thai_hs,
  a.ht_trang_thai_tt,
(case when a.LAN_THAMDINH ='Lần đầu' then 1
    when a.LAN_THAMDINH ='Tái thẩm &lt; 1 năm'  then 0.25
     when a.LAN_THAMDINH ='Tái thẩm 1-2 năm'  then 0.35
      when a.LAN_THAMDINH ='Tái thẩm > 2 năm'  then 1 end) --tyle_phi_import
   * 
    (case when bp1.cach_tinh_phi='GIATRI' then nvl(bp1.mucphi_vnd,0)
    WHEN bp1.cach_tinh_phi='TYLE' AND bp1.phi_max_vnd IS NULL THEN bp1.tyle *nvl(a.ht_giatri_dinhgia,0)  -- bosssung
  else least (nvl(bp1.tyle,0)*nvl(a.giatri_dinhgia,0), bp1.phi_max_vnd) end    )    ht_phi_nguon_import
FROM OUT_1 a 
LEFT JOIN ETL.FILE_KSS_TSDB_BIEUPHI  bp1
on (case when a.ht_loai_ts ='ĐS' THEN 'DONGSAN' ELSE 'BDS' end )=bp1.loai_taisan
and (a.ht_giatri_dinhgia) > bp1.giatri_min_trieu and (a.ht_giatri_dinhgia) &lt;= bp1.giatri_max_trieu 
)
select 
a.*,
a.ngay_denghi - a.ht_ngay_denghi ss_ngay_denghi,
a.ngay_pheduyet - a.ht_ngay_phe_duyet ss_ngay_pheduyet,
case when nvl(to_char(a.ngay_thamdinhgannhat),0) = nvl(to_char(a.ht_ngay_thamdinh_gannhat),0) then 0 else 1 end ss_ngay_thamdinh_gannhat, 
case when a.so_baocao = a.ht_so_baocao then 0 else 1 end ss_so_bc,
case when a.ma_ts = a.ht_ma_ts then 0 else 1 end ss_ma_ts,
case when a.cnc1 = a.ht_cnc1 then 0 else 1 end ss_cnc1,
case when a.cnc2 = a.ht_cnc2 then 0 else 1 end ss_cnc2,
case when a.khoi = a.ht_khoi then 0 else 1 end ss_khoi,
case when a.ten_kh = a.ht_ten_khach_hang then 0 else 1 end ss_ten_kh,
case when a.loai_ts = a.ht_loai_ts then 0 else 1 end ss_loai_ts,
nvl(a.giatri_dinhgia,0) - nvl(a.ht_giatri_dinhgia,0)  ss_giatri_dinhgia,
case when a.lan_thamdinh = a.ht_lan_thamdinh then 0 else 1 end ss_lan_thamdinh,
nvl(a.phi_dinhgia,0) - nvl(a.ht_phi_dinhgia,0) ss_phi_dinhgia,
nvl(a.phi_dinhgia,0) - nvl(a.ht_phi_nguon_import,0) ss_phi_dinhgia_nguon_import,
case when nvl(to_char(a.ngay_pheduyet,'yyyymmdd'),0) = nvl(to_char(a.ht_ngaynhap_tsbd,'yyyymmdd'),0) then 0 else 1 end ss_ngay_nhap_tsdb 
from out_2 a</sql>
