    <connection>cds_dc_etl_ods</connection>
    <sql>SELECT 
W4_CONTRACT_ID ,
ARRANGEMENT_NBR ,
W4_PRODUCT_CODE,
T24_PRODUCT_CODE 
FROM (
SELECT 
W4_CONTRACT_ID ,
ARRANGEMENT_NBR ,
W4_PRODUCT_CODE,
T24_PRODUCT_CODE 
FROM cdt.CREDIT_CARD_DLY ccd 
WHERE txn_date =to_date(${PRD_ID},'yyyyMMdd')
) 
GROUP BY W4_CONTRACT_ID ,
ARRANGEMENT_NBR ,
W4_PRODUCT_CODE,
T24_PRODUCT_CODE</sql>
