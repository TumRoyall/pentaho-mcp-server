    <connection>cds_dc_etl_ods</connection>
    <sql>select TXN_DATE,
      RELATION_TXN_NBR,
      CURRENCY_CODE,
      FCY_AMT,
      LCY_AMT,
      PL_CATE_CODE,
      COA_CODE,
      NARRATIVE,
      W4_DOC_ID,
      W4_DOC_RRN,
      W4_CONTRACT_ID,
      ARRANGEMENT_NBR,
      ARRANGEMENT_NAME,
      CARD_ID,
      CARD_NUMBER,
      BRANCH_CODE,
      T24_CUST_ID,
      DIVISION_CODE,
      CONTRACT_CLASS,
      W4_PRD_CODE,
      CHG_CODE,
      CHG_PRODUCT_CODE,
      SOURCE_TYPE,
      CREATED_BY,
      CREATION_DATE,
      LAST_UPDATED_BY,
      LAST_UPDATE_DATE,
      REPORT_DIVISION_CODE,
      REPORT_ITEM_CODE,
      DEVICE_ID,PL_PRODUCT_CODE

from CDT.PL_CARD_FEE_TXN_DAILY
where txn_date between trunc(to_date('${PRD_ID}','yyyyMMdd'),'MONTH') and to_date('${PRD_ID}','yyyyMMdd')
and SOURCE_TYPE IN ('N14', 'N15', 'N16','N20')</sql>
