    <connection>cds_dc_etl_ods</connection>
    <sql>select TXN_DATE,
      W4_CONTRACT_ID,
      ARRANGEMENT_NBR,
      ARRANGEMENT_NAME,
      CURRENCY_CODE,
      T24_CUST_CREDIT_RATING,
      AMT_SBV_3948,
      T24_ACCOUNT_3948,
      CATE_CODE_3948,
      AMT_SBV_4599,
      T24_ACCOUNT_4599,
      CATE_CODE_4599,
      AMT_SBV_7020,
      CATE_CODE_7020,
      AMT_SBV_9410,
      T24_ACCOUNT_9410,
      CATE_CODE_9410,
      AMT_SBV_0000,
      T24_ACCOUNT_0000,
      CATE_CODE_0000,
      BRANCH_CODE,
      T24_CUST_ID,
      DIVISION_CODE,
      CONTRACT_CLASS,
      M_TRANSACTION_ID,
      RELATION_TXN_NBR,
      PL_CARD_INT_TXN_DAILY_ID,
      CREATED_BY,
      CREATION_DATE,
      LAST_UPDATED_BY,
      LAST_UPDATE_DATE,
      SOURCE_TYPE,
      REPORT_DIVISION_CODE,
      REPORT_ITEM_CODE,
      CHG_CODE,
      CHG_PRODUCT_CODE,
      W4_PRD_CODE,
      PL_PRODUCT_CODE,
      CARD_ID,
      CARD_NUMBER

from CDT.PL_CARD_INT_TXN_DAILY
where txn_date between trunc(to_date('${PRD_ID}','yyyyMMdd'),'MONTH') and to_date('${PRD_ID}','yyyyMMdd')
and SOURCE_TYPE IN ('N1','N2','N5')</sql>
