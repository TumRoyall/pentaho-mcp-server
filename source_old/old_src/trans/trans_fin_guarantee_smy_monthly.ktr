  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select
    to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
    coalesce (a.md_id, b.md_id, c.md_id, d.md_id, e.md_id) MD_ID,
    coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) MAKH,
    p.KHOI,
    (
        case
            when p.khoi = 'CIB'
            and p.sector = '3035' then 'FDI'
            when p.khoi = 'CIB' then 'CIB_CONLAI'
            when p.khoi = 'SME' then n.PKKH
            else 'KHAC'
        END
    ) PHAN_KHUC,
    (
        case
            when p.creation_date >= trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') then 'MOI'
            else 'CU'
        end
    ) CUS_TYPE,
    coalesce (a.cn, b.cn, c.cn, d.cn, e.cn, t.BRANCH_CODE) CN,
    u.PARENT_BRANCH_CODE_T24,
    u.TINH_THANH,
    u.VUNG_MIEN,
    u.TIEU_VUNG,
    coalesce (
        a.PRODUCT_CODE,
        b.PRODUCT_CODE,
        c.PRODUCT_CODE,
        d.PRODUCT_CODE,
        e.PRODUCT_CODE,
        t.PRODUCT_CODE
    ) PRODUCT_CODE,
    case
        when v.SP_DV in ('SPS1', 'DVS1', 'SPSO', 'DVSO') then 'ONLINE'
        else 'OFFLINE'
    end KENH_GD,
    coalesce (
        a.LOAI_PHI,
        d.LOAI_PHI,
        nvl (t.COMM_PERIOD_TYPE, 'CHARGE')
    ) LOAI_PHI,
    nvl (a.sl_md, 0) SLHD_MD,
    nvl (a.sl_md_lk, 0) SLHD_MD_LK,
    nvl (a.sl_md_psmoi, 0) SLHD_PSMOI,
    nvl (a.sl_md_psmoi_lk, 0) SLHD_PSMOI_LK,
    nvl (a.SODU_BL_THOIDIEM, 0) SODU_BL_THOIDIEM,
    nvl (b.SODU_BL_BQ, 0) SODU_BL_BQ_THANG,
    nvl (c.SODU_BL_BQ_LK, 0) SODU_BL_BQ_LK,
    NVL (d.DOANHSO_BL_MOI_THANG, 0) DOANHSO_BL_MOI_THANG,
    NVL (d.DOANHSO_BL_TATTOAN_THANG, 0) DOANHSO_BL_TATTOAN_THANG,
    NVL (d.DOANHSO_BL_MOI_LK, 0) DOANHSO_BL_MOI_LK,
    NVL (d.DOANHSO_BL_TATTOAN_LK, 0) DOANHSO_BL_TATTOAN_LK,
    NVL (d.PHI_THUCTHU_THANG, 0) PHI_THUCTHU_THANG,
    NVL (d.PHI_PHANBO_THANG, 0) PHI_PHANBO_THANG,
    NVL (d.PHI_DUTHU_THANG, 0) PHI_DUTHU_THANG,
    NVL (d.PHI_THUCTHU_LK, 0) PHI_THUCTHU_LK,
    NVL (d.PHI_PHANBO_LK, 0) PHI_PHANBO_LK,
    NVL (d.PHI_DUTHU_LK, 0) PHI_DUTHU_LK,
    nvl (e.rwa_baolanh, 0) RWA_BAOLANH,
    case
        when nvl (k.DUNO_THOIDIEM, 0) &lt;&gt; 0 then '1'
        else '0'
    end IS_DUNO_THOIDIEM,
    case
        when nvl (l.TPDN_THOIDIEM, 0) &lt;&gt; 0 then '1'
        else '0'
    end IS_TPDN_THOIDIEM,
    case
        when nvl (m.DOANHSO_TTTM, 0) &lt;&gt; 0 then '1'
        else '0'
    end IS_DOANHSO_TTTM,
    case
        when (
            nvl (k.DUNO_THOIDIEM, 0) + nvl (l.TPDN_THOIDIEM, 0)
        ) &lt;&gt; 0 then '1'
        else '0'
    end KH_CO_DUNO_TP,
    case
        when nvl (m.DOANHSO_TTTM, 0) &lt;&gt; 0 then '1'
        else '0'
    end KH_CO_TTTM,
    case
        when coalesce(x.sodu_bq_vnd_lk, y.tpdn_bq_vnd_lk, 0) &lt;&gt; 0 then '1'
        else '0'
    end IS_DN_BQ_LK
from
    etl.ORS_CAL_BAOLANH_MD_QUYMO a full
    join (
        select
            cn,
            PRODUCT_CODE,
            MD_ID,
            MAKH,
            sum (SODUBQ_VND) sodu_bl_bq
        from
            etl.ORS_TR_SDBQ_BAOLANH
        where
            transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
        group by
            MD_ID,
            MAKH,
            cn,
            PRODUCT_CODE
    ) b on a.md_id = b.md_id
    and a.makh = b.makh
    and a.cn = b.cn
    and a.product_code = b.product_code full
    join (
        select
            cn,
            PRODUCT_CODE,
            MD_ID,
            MAKH,
            sum (SODUBQ_VND_LK) sodu_bl_bq_lk
        from
            etl.ORS_CAL_TR_SDBQ_BAOLANH_LK
        where
            transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
        group by
            MD_ID,
            cn,
            PRODUCT_CODE,
            MAKH
    ) c on coalesce (a.md_id, b.md_id) = c.md_id
    and coalesce (a.makh, b.makh) = c.makh
    and coalesce (a.cn, b.cn) = c.cn
    and coalesce (a.product_code, b.product_code) = c.product_code full
    join (
        select
            cn,
            PRODUCT_CODE,
            a.loai_phi,
            MD_ID,
            MAKH,
            NVL (
                SUM (
                    case
                        when transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
                        and to_date ('${PRD_ID}', 'YYYYMMDD') THEN DOANHSO_GIAINGAN_VND
                    END
                ),
                0
            ) DOANHSO_BL_MOI_THANG,
            NVL (
                SUM (
                    case
                        when transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
                        and to_date ('${PRD_ID}', 'YYYYMMDD') THEN DOANHSO_TATTOAN_VND
                    END
                ),
                0
            ) DOANHSO_BL_TATTOAN_THANG,
            NVL (
                SUM (
                    case
                        when transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
                        and to_date ('${PRD_ID}', 'YYYYMMDD') THEN PHI_THUCTHU_VND
                    END
                ),
                0
            ) PHI_THUCTHU_THANG,
            NVL (
                SUM (
                    case
                        when transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
                        and to_date ('${PRD_ID}', 'YYYYMMDD') THEN PHI_PHANBO_VND
                    END
                ),
                0
            ) PHI_PHANBO_THANG,
            NVL (
                SUM (
                    case
                        when transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
                        and to_date ('${PRD_ID}', 'YYYYMMDD') THEN PHI_DUTHU_VND
                    END
                ),
                0
            ) PHI_DUTHU_THANG,
            NVL (SUM (DOANHSO_GIAINGAN_VND), 0) DOANHSO_BL_MOI_LK,
            NVL (SUM (DOANHSO_TATTOAN_VND), 0) DOANHSO_BL_TATTOAN_LK,
            NVL (SUM (PHI_THUCTHU_VND), 0) PHI_THUCTHU_LK,
            NVL (SUM (PHI_PHANBO_VND), 0) PHI_PHANBO_LK,
            NVL (SUM (PHI_DUTHU_VND), 0) PHI_DUTHU_LK
        from
            apps.FIN_BAOLANH_TRANS_DAILY a
        where
            transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR')
            and to_date ('${PRD_ID}', 'YYYYMMDD')
        group by
            MD_ID,
            MAKH,
            cn,
            PRODUCT_CODE,
            a.loai_phi
    ) d on coalesce (a.md_id, b.md_id, c.md_id) = d.md_id
    and coalesce (a.makh, b.makh, c.makh) = d.makh
    and coalesce (a.cn, b.cn, c.cn) = d.cn
    and coalesce (a.product_code, b.product_code, c.product_code) = d.product_code full
    join (
        select
            cn,
            PRODUCT_CODE,
            CONTRACT_ID md_id,
            customer_id makh,
            sum (rwa) rwa_baolanh
        from
            etl.ORS_MB_CAR_RRTD_KHOANPHAIDOI
        where
            transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
            and CREDIT_TYPE = 'BAO_LANH'
        group by
            CONTRACT_ID,
            customer_id,
            cn,
            PRODUCT_CODE
    ) e on coalesce (a.md_id, b.md_id, c.md_id, d.md_id) = e.md_id
    and coalesce (a.makh, b.makh, c.makh, d.makh) = e.makh
    and coalesce (a.cn, b.cn, c.cn, d.cn) = e.cn
    and coalesce (
        a.product_code,
        b.product_code,
        c.product_code,
        d.product_code
    ) = e.product_code
    left join (
        select
            MAKH,
            SUM (DUCUOI_VND) DUNO_THOIDIEM
        from
            ETL.ORS_TR_KU_M
        where
            transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
            and substr (gl, 1, 1) = '2'
            and substr (gl, 1, 2) &lt;&gt; '20'
        group by
            MAKH
    ) k on coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = k.makh
    left join (
        select
            --makh,
            ISSUER,
            sum (face_amount) TPDN_THOIDIEM
        from
            etl.ORS_MB_TR_SK_TPDN
        where
            transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
        group by
            ISSUER
    ) l on coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = l.ISSUER
    left join (
        select
            MAKH,
            sum (DOANHSO) DOANHSO_TTTM
        from
            apps.FIN_TTTM_TRANS_DAILY
        where
            transaction_date between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR')
            and to_date ('${PRD_ID}', 'YYYYMMDD')
        group by
            makh
    ) m on coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = m.makh
    left join etl.ORS_MB_SME_PKKH_M n on n.PK_TYPE = 'PK_100'
    and n.DTT_TYPE = '3'
    and coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = n.makh
    left join etl.ors_tr_khachhang p on coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = p.makh
    left join etl.ODS_GUARANTEE_CONTRACT t on coalesce (a.md_id, b.md_id, c.md_id, d.md_id, e.md_id) = t.ARRANGEMENT_NBR
    left join etl.REF_AICT_BRANCH_M u on u.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
    and coalesce (a.cn, b.cn, c.cn, d.cn, e.cn, t.BRANCH_CODE) = u.BRANCH_CODE_T24
    left join etl.ORS_MB_PRODUCT_CODE v on coalesce (
        a.PRODUCT_CODE,
        b.PRODUCT_CODE,
        c.PRODUCT_CODE,
        d.PRODUCT_CODE,
        e.PRODUCT_CODE,
        t.PRODUCT_CODE
    ) = v.PRODUCT_CODE
    left join (
        select
            makh,
            sum(sodu_bq_vnd_lk) sodu_bq_vnd_lk
        from
            etl.ors_cal_tr_chovay_bq_lk
        group by
            makh
    ) x on coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = x.makh
    left join (
        select
            issuer,
            sum(tpdn_bq_vnd_lk) tpdn_bq_vnd_lk
        from
            etl.ors_cal_mb_tr_sk_tpdn_bq_lk y
        group by
            issuer
    ) y on coalesce (a.makh, b.makh, c.makh, d.makh, e.makh) = y.issuer</sql>
