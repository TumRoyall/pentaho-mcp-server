  <step>
    <name>apps.fin_saoke_muano_bq_daily</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT
     TO_DATE('${PRD_ID}','YYYYMMDD') transaction_date,
     'QMBQ_MUANO' chitieu,
     khoi,
     CASE
         WHEN nte = 'VND' THEN 'VND'
         ELSE 'USD'
     END currency_code,
     'TDH' loai_kyhan,
     SUM(NVL(sodu_vnd,0)) value
 FROM
     apps.fin_saoke_muano_bq_daily fsmbd
 WHERE
     transaction_date = TO_DATE('${PRD_ID}','YYYYMMDD')
 GROUP BY
     khoi,
     CASE
         WHEN nte = 'VND' THEN 'VND'
         ELSE 'USD'
     END</sql>
