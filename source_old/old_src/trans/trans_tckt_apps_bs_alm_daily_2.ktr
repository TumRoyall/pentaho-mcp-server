        <length>50</length>
        <precision>-1</precision>
        <origin>ETL.CAL_PL_ALM_DAILY</origin>
        <comments>CHITIEU</comments>
        <conversion_Mask/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol>,</grouping_symbol>
        <currency_symbol/>
        <trim_type>none</trim_type>
        <case_insensitive>N</case_insensitive>
