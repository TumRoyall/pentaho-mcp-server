  <step>
    <name>ETL.CAL_PL_ALM_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
  TO_DATE(${PRD_ID}, 'yyyyMMdd') transaction_date, 
  d_type chitieu, 
  CASE WHEN a.sct IN ('0511100267866', '2555139298958','0511104635002') 
            THEN 'NHS' 
       WHEN NVL(pdc.sp_dv, 0) IN ('SPS1', 'DVS1') 
            THEN 'NHS' 
       ELSE NVL(a.division_code, kh.khoi) 
  END khoi, 
  CASE WHEN a.currency_code = 'VND' THEN 'VND' ELSE 'USD' END currency_code, 
  COALESCE (
    b.loaikyhan, 
    c.loaikyhan, 
    d.loaikyhan, 
    e.loaikyhan, 
    f.loaikyhan, 
    g.loaikyhan, 
    h.loaikyhan, 
    CASE WHEN d_type IN ('PL_TPDN', 'PL_MUANO') THEN 'TDH' 
         WHEN d_type = 'PL_CHOVAY' THEN 'NH' 
         WHEN d_type = 'PL_TIENGUI' THEN 'CKH' 
    END
  ) loai_kyhan, 
  SUM(NVL(lcy_amt,0)) value 
FROM 
  etl.cal_pl_alm_daily a 
LEFT JOIN (
    SELECT 
      arrangement_nbr taikhoan, 
      product_code, 
      CASE  WHEN REPLACE(arrangement_term, 'M') &lt;= 12 THEN 'NH' 
            WHEN REPLACE(arrangement_term, 'M') &lt;= 60 THEN 'TH' 
            ELSE 'DH' 
      END loaikyhan 
    FROM 
      etl.ods_loan_contract
  ) b ON a.d_type IN ('PL_CHOVAY', 'PL_MUANO') 
  AND a.sct = b.taikhoan 
LEFT JOIN (
    SELECT 
      a.arrangement_nbr taikhoan, 
      a.product_code, 
      CASE  WHEN REPLACE(a.arrangement_term, 'M') &lt;= 12 THEN 'NH' 
            WHEN REPLACE(a.arrangement_term, 'M') &lt;= 60 THEN 'TH' 
            ELSE 'DH' 
      END loaikyhan 
    FROM 
      etl.ods_pd_contract a 
      LEFT JOIN etl.ods_loan_contract b ON a.arrangement_nbr = 'PD' || b.arrangement_nbr 
    WHERE 
      a.rank_num = 1
  ) c ON a.d_type IN ('PL_CHOVAY', 'PL_MUANO') 
  AND a.sct = c.taikhoan 
LEFT JOIN (
    SELECT 
      arrangement_nbr taikhoan, 
      product_code, 
      CASE WHEN product_code = '12419' THEN 'CKH' 
        ELSE 'KKH' 
      END loaikyhan 
    FROM 
      etl.ods_casa_contract
  ) d ON a.d_type IN ('PL_TIENGUI') 
  AND a.sct = d.taikhoan 
LEFT JOIN (
    SELECT 
      arrangement_nbr taikhoan, 
      product_code, 
      'CKH' loaikyhan 
    FROM 
      etl.ods_td_contract
  ) e ON a.d_type IN ('PL_TIENGUI') 
  AND a.sct = e.taikhoan 
LEFT JOIN (
    SELECT 
      arrangement_nbr taikhoan, 
      product_code, 
      'KKH' loaikyhan 
    FROM 
      etl.ods_internal_contract
  ) f ON a.d_type IN ('PL_TIENGUI') 
  AND a.sct = f.taikhoan 
  LEFT JOIN (
    SELECT 
      arrangement_nbr taikhoan, 
      product_code, 
      CASE WHEN product_code = '12419' THEN 'CKH' ELSE 'KKH' END loaikyhan 
    FROM 
      etl.ods_ovd_contract
  ) G ON a.d_type IN ('PL_TIENGUI') 
  AND a.sct = G.taikhoan 
  LEFT JOIN (
    SELECT 
      arrangement_nbr taikhoan, 
      product_code, 
      'TDH' loaikyhan 
    FROM 
      etl.ods_bond_contract
  ) h ON a.d_type IN ('PL_TPDN') 
  AND a.sct = h.taikhoan 
  LEFT JOIN etl.ors_tr_khachhang kh ON a.makh = kh.makh 
  LEFT JOIN etl.ors_mb_product_code pdc ON COALESCE (
    b.product_code, c.product_code, d.product_code, 
    e.product_code, f.product_code, 
    G.product_code, H.product_code
  ) = pdc.product_code 
GROUP BY 
  d_type, 
  CASE WHEN a.sct IN (
    '0511100267866', '2555139298958', 
    '0511104635002'
  ) THEN 'NHS' WHEN nvl(pdc.sp_dv, 0) IN ('SPS1', 'DVS1') THEN 'NHS' ELSE nvl(a.division_code, kh.khoi) END, 
  CASE WHEN a.currency_code = 'VND' THEN 'VND' ELSE 'USD' END, 
  COALESCE (
    b.loaikyhan, 
    c.loaikyhan, 
    d.loaikyhan, 
    e.loaikyhan, 
    f.loaikyhan, 
    g.loaikyhan, 
    h.loaikyhan, 
    CASE WHEN d_type IN ('PL_TPDN', 'PL_MUANO') THEN 'TDH' WHEN d_type = 'PL_CHOVAY' THEN 'NH' WHEN d_type = 'PL_TIENGUI' THEN 'CKH' END
  )
</sql>
    <limit>0</limit>
