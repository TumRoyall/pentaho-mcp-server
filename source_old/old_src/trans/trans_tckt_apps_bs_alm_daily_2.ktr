    <connection>tckt_dc</connection>
    <sql>SELECT
     TO_DATE('${PRD_ID}','YYYYMMDD') transaction_date,
     CASE
         WHEN substr(coa_code,1,1) = '2' THEN 'FTP_CHOVAY'
         ELSE 'FTP_UPASLC'
     END chitieu,
     khoi,
     CASE
         WHEN ccy = 'VND' THEN 'VND'
         ELSE 'USD'
     END currency_code,
     CASE
         WHEN term_hd = 'RE'                        THEN 'TDH'
         WHEN term_hd LIKE '%W' THEN 'NH'
         WHEN to_number(replace(term_hd,'M') ) &lt;= 12 THEN 'NH'
         ELSE 'TDH'
     END loai_kyhan,
     SUM(NVL(-ftp_ht_lcy,0)) value
 FROM
     apps.ftp_chovay_upaslc_daily
 WHERE
     transaction_date BETWEEN trunc(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') AND TO_DATE('${PRD_ID}','YYYYMMDD')
 GROUP BY
     CASE
         WHEN substr(coa_code,1,1) = '2' THEN 'FTP_CHOVAY'
         ELSE 'FTP_UPASLC'
     END,
     khoi,
     CASE
         WHEN ccy = 'VND' THEN 'VND'
         ELSE 'USD'
