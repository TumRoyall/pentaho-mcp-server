    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT
     TO_DATE('${PRD_ID}','YYYYMMDD') transaction_date,
     'FTP_CDS_THUCAP' chitieu,
     khoi,
     CASE
         WHEN ccy = 'VND' THEN 'VND'
         ELSE 'USD'
     END currency_code,
     'CKH' loai_kyhan,
     SUM(NVL(ftp_ht_lcy,0)) value
 FROM
     apps.ftp_cd_thucap_daily
 WHERE
     transaction_date BETWEEN trunc(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') AND TO_DATE('${PRD_ID}','YYYYMMDD')
 GROUP BY
     khoi,
     CASE
