  <step>
    <name>apps.ftp_chovay_...</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT
     TO_DATE('${PRD_ID}','YYYYMMDD') transaction_date,
     'FTP_CHOVAY' chitieu,
     khoi,
     CASE
         WHEN ccy = 'VND' THEN 'VND'
         ELSE 'USD'
     END currency_code,
     CASE
         WHEN term_hd = 'RE'                        THEN 'TDH'
         WHEN term_hd LIKE '%W' THEN 'NH'
         WHEN to_number(replace(term_hd,'M') ) &lt;= 12 THEN 'NH'
         ELSE 'TDH'
     END loai_kyhan,
     SUM(NVL(-ftp_ht_lcy,0)) value
 FROM
     (
         SELECT
             *
         FROM
             apps.ftp_chovay_tt_daily fctd
         WHERE
             transaction_date BETWEEN trunc(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') AND TO_DATE('${PRD_ID}','YYYYMMDD')
         UNION ALL
         SELECT
             *
         FROM
             apps.ftp_chovay_thauchi_daily
         WHERE
             transaction_date BETWEEN trunc(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') AND TO_DATE('${PRD_ID}','YYYYMMDD')
         UNION ALL
         SELECT
             *
         FROM
             apps.ftp_chovay_noquahan_daily
         WHERE
             transaction_date BETWEEN trunc(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') AND TO_DATE('${PRD_ID}','YYYYMMDD')
     )
 GROUP BY
     khoi,
     CASE
         WHEN ccy = 'VND' THEN 'VND'
         ELSE 'USD'
     END,
     CASE
         WHEN term_hd = 'RE'                        THEN 'TDH'
         WHEN term_hd LIKE '%W' THEN 'NH'
         WHEN to_number(replace(term_hd,'M') ) &lt;= 12 THEN 'NH'
         ELSE 'TDH'
     END</sql>
