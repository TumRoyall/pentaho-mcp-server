    <connection>gl_dc</connection>
    <sql>SELECT 
    S.COMPANY_CODE,
    S.BRANCH_CODE,
    S.BRANCH_NAME,
    S.SOURCE_TYPE,
    S.DATA_TYPE,
    S.PERIOD_CODE,
    S.PERIOD_TYPE,
    S.SRC_ACCT_CODE,
    S.DES_ACCT_CODE,
    S.DES_ACCT_NAME,
    S.TRX_NUM,
    S.TRX_DATE,
    S.GL_DATE,
    S.CURRENCY_CODE,
    S.CUST_CODE,
    S.CUST_NAME,
    S.TRX_DESC,
    S.ENTERED_DR,
    S.ENTERED_CR,
    S.TRX_START_DATE,
    S.TRX_END_DATE,
    S.SEQ_NUM,
    S.BEF_CLS_FLAG,
    S.CODE_NUMBER
FROM MBG.MBG_TRX_JOURNALS S, MBG.MBG_RPT_DATA_STATUS T
WHERE T.REPORT_CODE='SCTTK'
AND T.PERIOD_TYPE = S.PERIOD_TYPE
AND T.PERIOD_CODE = S.PERIOD_CODE
AND T.COMPANY_CODE = S.COMPANY_CODE
AND T.PERIOD_CODE = '${PRD_M}'
AND T.STATUS_FLAG = 'Y'</sql>
    <limit>0</limit>
    <lookup/>
