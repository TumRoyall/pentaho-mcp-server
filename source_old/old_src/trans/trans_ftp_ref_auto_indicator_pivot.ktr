    <connection>tckt_dc</connection>
    <sql>SELECT  
TRANSACTION_DATE, 
CURRENCY_CODE, 
SUM(NVL(CP_BHTG,0)) CP_BHTG, 
SUM(NVL(SDBQ_DTBB_VND_12M,0)) SDBQ_DTBB_VND_12M, 
SUM(NVL(SDBQ_DTBB_VND_A12M,0)) SDBQ_DTBB_VND_A12M, 
SUM(NVL(SDBQ_DTBB_USD_12M,0)) SDBQ_DTBB_USD_12M, 
SUM(NVL(SDBQ_DTBB_USD_A12M,0)) SDBQ_DTBB_USD_A12M, 
SUM(NVL(CPVON_CASA,0)) CPVON_CASA, 
SUM(NVL(CPVON_TD,0)) CPVON_TD, 
SUM(NVL(CPVON_CCTGOL,0)) CPVON_CCTGOL, 
SUM(NVL(SDBQ_CASA,0)) SDBQ_CASA, 
SUM(NVL(SDBQ_TERM_DEPOSIT,0)) SDBQ_TERM_DEPOSIT, 
SUM(NVL(SDBQ_CCTGOL,0)) SDBQ_CCTGOL, 
SUM(NVL(SDBQ_LOAN,0)) SDBQ_LOAN, 
SUM(NVL(SDBQ_TP_TCKT,0)) SDBQ_TP_TCKT, 
SUM(NVL(SDBQ_MUANO,0)) SDBQ_MUANO, 
SUM(NVL(SDBQ_TIENMAT,0)) SDBQ_TIENMAT, 
SUM(NVL(SDBQ_TG_NHNN,0)) SDBQ_TG_NHNN, 
SUM(NVL(SDBQ_TPCP_AFS,0)) SDBQ_TPCP_AFS, 
SUM(NVL(SDBQ_TCTD_KKH,0)) SDBQ_TCTD_KKH, 
SUM(NVL(TN_TCTD_KKH,0)) TN_TCTD_KKH, SUM(NVL(TN_TPCP_AFS,0)) TN_TPCP_AFS from ETL.TMP_FTP_REF_AUTO_INDICATOR  a 
PIVOT 
(sum(VALUE)   
for MA_CT 
  in ( 
'CP_BHTG' CP_BHTG, 
'SDBQ_DTBB_VND_12M' SDBQ_DTBB_VND_12M, 
'SDBQ_DTBB_VND_A12M' SDBQ_DTBB_VND_A12M, 
'SDBQ_DTBB_USD_12M' SDBQ_DTBB_USD_12M, 
'SDBQ_DTBB_USD_A12M' SDBQ_DTBB_USD_A12M, 
'CPVON_CASA' CPVON_CASA, 
'CPVON_TD' CPVON_TD, 
'CPVON_CCTGOL' CPVON_CCTGOL, 
'SDBQ_CASA' SDBQ_CASA, 
'SDBQ_TERM_DEPOSIT' SDBQ_TERM_DEPOSIT, 
'SDBQ_CCTGOL' SDBQ_CCTGOL, 
'SDBQ_LOAN' SDBQ_LOAN, 
'SDBQ_TP_TCKT' SDBQ_TP_TCKT, 
'SDBQ_MUANO' SDBQ_MUANO, 
'SDBQ_TIENMAT' SDBQ_TIENMAT, 
'SDBQ_TG_NHNN' SDBQ_TG_NHNN, 
'SDBQ_TPCP_AFS' SDBQ_TPCP_AFS, 
'SDBQ_TCTD_KKH' SDBQ_TCTD_KKH, 
'TN_TCTD_KKH' TN_TCTD_KKH, 
'TN_TPCP_AFS' TN_TPCP_AFS)) 
GROUP BY  
TRANSACTION_DATE, 
CURRENCY_CODE 
</sql>
