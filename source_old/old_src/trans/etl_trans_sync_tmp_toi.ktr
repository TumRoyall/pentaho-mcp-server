  <step>
    <name>apps.TOI_SOURCE_INPUT </name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH thu_lai_khac AS (

  SELECT a.TRANSACTION_DATE,

        a.NARR,

        NVL(REGEXP_SUBSTR(a.NARR, ' ((PDLD|PDPD|LD)[0-9]\S*)', 1, 1, NULL, 1), a.SOTK) SOTK,

        a.MAKH,

        CASE

              WHEN a.MAKH IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'

              ELSE a.PHAN_KHUC

        END CUS_STATUS,

        a.KHOI_PLKHOI KHOI,

        a.PRODUCT_CODE,

        decode(b.SP_DV, 'SPS1', 'E2E', 'SPSO', 'O2O', 'DVS1', 'E2E', 'DVSO', 'O2O', 'SPS2', 'E2E', 'DVS2', 'E2E', 'OFFLINE') KENH,

        CASE

              WHEN upper(a.MACHITIEU) IN ('B41') THEN 'THUFTP_DUPHONGTD_B4'

              WHEN upper(a.MACHITIEU) IN ('B42') THEN 'THUFTP_DUPHONGTP_B4'

              ELSE upper(a.CHITIEU)

        END CHITIEU,

        a.TIENNO_VND

  FROM apps.TOI_SOURCE_INPUT a

  LEFT JOIN etl.ORS_MB_PRODUCT_CODE b

        ON a.PRODUCT_CODE = b.PRODUCT_CODE

  WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')

        AND (

              MACHITIEU = 'A2'

              OR (

                    substr(MACHITIEU, 1, 1) IN ('A', 'B')

                    AND SUBSTR(CHITIEU_PLKHOI, 1, 5) NOT IN ('A1113', 'A1114', 'A1223', 'A1224', 'A1135', 'A1215', 'A1134')

              )

        )

)

SELECT a.TRANSACTION_DATE,

  a.KHOI,

  a.CUS_STATUS,

  a.PRODUCT_CODE,

  a.KENH,

  CASE

        WHEN coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 12 THEN '1'

        WHEN coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 12 AND coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 60 THEN '2'

        WHEN coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 60 THEN '3'

        WHEN a.PRODUCT_CODE LIKE '26%' THEN '1'

        when a.PRODUCT_CODE in ('74231','74331') then '3'

        ELSE COALESCE(f.NHOM_KYHAN, '1')

  END TERM,

  COALESCE(f.SUB_PRODUCT, c.SUB_PRODUCT_CODE, d.SUB_PRODUCT_CODE) SUB_PRODUCT,

  COALESCE(f.PRODUCTGR_CODE, c.PRODUCT_GROUP_CODE, d.PRODUCT_GROUP_CODE) PRODUCT_GROUP_CODE,

  coalesce(f.PRODUCT_TYPE, c.PROGRAM_CODE, NULL) PRODUCT_TYPE,

  COALESCE(f.MBLD_TYPE, c.CAMPAIGN_CODE, NULL) CAMPAIGN_CODE,

  COALESCE(f.PROJECT_ID, c.PROJECT_ID, NULL) PROJECT_CODE,

  COALESCE(c.LOAN_INDUSTRY_CODE, d.LOAN_INDUSTRY_CODE, NULL) UOL,

  a.CHITIEU,

  sum(TIENNO_VND) AMOUNT

FROM thu_lai_khac a

LEFT JOIN etl.ods_loan_contract c

  ON REGEXP_SUBSTR(a.SOTK, 'LD[0-9]+') = c.arrangement_nbr

LEFT JOIN etl.ods_pd_contract d

  ON a.SOTK = d.arrangement_nbr

  and d.rank_num = 1

LEFT JOIN (

  SELECT LD_ID, PRODUCTGR_CODE, PRODUCT_CODE, PRODUCT_TYPE, PROJECT_ID, SUB_PRODUCT, MBLD_TYPE, NHOM_KYHAN,

        row_number() OVER (PARTITION BY LD_ID ORDER BY PRODUCTGR_CODE) rn

  FROM apps.FIN_LOAN_SMY_MONTHLY

  WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')

) f

  ON a.SOTK = f.LD_ID

  AND f.rn = 1

WHERE a.SOTK IS NOT NULL

GROUP BY a.TRANSACTION_DATE,

  a.KHOI,

  a.CUS_STATUS,

  a.PRODUCT_CODE,

  a.KENH,

  CASE

        WHEN coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 12 THEN '1'

        WHEN coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 12 AND coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 60 THEN '2'

        WHEN coalesce(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 60 THEN '3'

        WHEN a.PRODUCT_CODE LIKE '26%' THEN '1'

        when a.PRODUCT_CODE in ('74231','74331') then '3'

        ELSE COALESCE(f.NHOM_KYHAN, '1')

  END,

  COALESCE(f.SUB_PRODUCT, c.SUB_PRODUCT_CODE, d.SUB_PRODUCT_CODE),

  COALESCE(f.PRODUCTGR_CODE, c.PRODUCT_GROUP_CODE, d.PRODUCT_GROUP_CODE),

  coalesce(f.PRODUCT_TYPE, c.PROGRAM_CODE, NULL),

  COALESCE(f.MBLD_TYPE, c.CAMPAIGN_CODE, NULL),

  COALESCE(f.PROJECT_ID, c.PROJECT_ID, NULL),

  COALESCE(c.LOAN_INDUSTRY_CODE, d.LOAN_INDUSTRY_CODE, NULL),

a.CHITIEU</sql>
