  <step>
    <name>apps.TOI_SOURCE_INPUT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH tbt AS (
  SELECT a.TRANSACTION_DATE,
        a.NARR,
        REGEXP_SUBSTR(
              a.NARR,
              '(^| )((PDLD|PDPD|LD)[0-9]\S*|[0-9]{3}-[A-Z]\S*)',
              1,
              1,
              NULL,
              2
        ) SOTK,
        nvl(REGEXP_SUBSTR(
            a.NARR,
            'CODE( [^ ]+)? ([0-9]+)',
            1,
            1,
            'i',
            2
        ), a.MAKH) MAKH,
        a.PHAN_KHUC CUS_STATUS,
        a.KHOI_PLKHOI KHOI,
        a.PRODUCT_CODE,
        CHITIEU,
        decode(b.SP_DV, 'SPS1', 'E2E', 'SPSO', 'O2O', 'DVS1', 'E2E', 'DVSO', 'O2O', 'SPS2', 'E2E', 'DVS2', 'E2E', 'OFFLINE') KENH,
        a.TIENNO_VND
  FROM apps.TOI_SOURCE_INPUT a
  LEFT JOIN etl.ORS_MB_PRODUCT_CODE b
        ON a.PRODUCT_CODE = b.PRODUCT_CODE
  WHERE TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
  AND MACHITIEU IN ('E18')
)
SELECT a.TRANSACTION_DATE,
  a.MAKH,
  CASE
        WHEN a.SOTK LIKE 'PDLD%' THEN REGEXP_SUBSTR(a.SOTK, 'LD[0-9]+')
        ELSE a.SOTK
  END SOTK,
  a.NARR,
  a.KHOI,
  CASE
        WHEN a.MAKH IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
        ELSE a.CUS_STATUS
  END CUS_STATUS,
  case
        when regexp_like(a.SOTK, '^[0-9]{3}-[A-Z]\S*$') then '26111'
        else a.PRODUCT_CODE
  end PRODUCT_CODE,
  a.KENH,
  CASE
        WHEN nvl(c.ARRANGEMENT_TERM, 0) &lt;= 12 THEN '1'
        WHEN nvl(c.ARRANGEMENT_TERM, 0) > 12 AND nvl(c.ARRANGEMENT_TERM, 0) &lt;= 60 THEN '2'
        WHEN nvl(c.ARRANGEMENT_TERM, 0) > 60 THEN '3'
        WHEN regexp_like(a.SOTK, '^[0-9]{3}-[A-Z]\S*$') THEN '1'
        when a.PRODUCT_CODE in ('74231','74331') then '3'
        ELSE nvl(f.NHOM_KYHAN, '1')
    END TERM,
  COALESCE(f.SUB_PRODUCT, c.SUB_PRODUCT_CODE, d.SUB_PRODUCT_CODE) SUB_PRODUCT,
  COALESCE(f.PRODUCTGR_CODE, c.PRODUCT_GROUP_CODE, d.PRODUCT_GROUP_CODE) PRODUCT_GROUP_CODE,
  COALESCE(f.PRODUCT_TYPE, c.PROGRAM_CODE) PRODUCT_TYPE,
  COALESCE(f.MBLD_TYPE, c.CAMPAIGN_CODE) CAMPAIGN_CODE,
  COALESCE(f.PROJECT_ID, c.PROJECT_ID) PROJECT_CODE,
  COALESCE(c.LOAN_INDUSTRY_CODE, d.LOAN_INDUSTRY_CODE) UOL,
  CHITIEU,
  sum(TIENNO_VND) AMOUNT
FROM tbt a
LEFT JOIN etl.ods_loan_contract c
  ON CASE
              WHEN a.SOTK LIKE 'PDLD%' THEN REGEXP_SUBSTR(a.SOTK, 'LD[0-9]+')
              ELSE a.SOTK
        END = c.arrangement_nbr
LEFT JOIN etl.ods_pd_contract d
  ON a.SOTK = d.arrangement_nbr
  and d.rank_num = 1
LEFT JOIN (
  SELECT LD_ID, PRODUCTGR_CODE, PRODUCT_CODE, PRODUCT_TYPE, PROJECT_ID, SUB_PRODUCT, MBLD_TYPE, NHOM_KYHAN,
        row_number() OVER (PARTITION BY LD_ID ORDER BY PRODUCTGR_CODE) rn
  FROM apps.FIN_LOAN_SMY_MONTHLY
  WHERE TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
) f
  ON a.SOTK = f.LD_ID
  and f.rn = 1
GROUP BY a.TRANSACTION_DATE,
  a.MAKH,
  CASE
        WHEN a.SOTK LIKE 'PDLD%' THEN REGEXP_SUBSTR(a.SOTK, 'LD[0-9]+')
        ELSE a.SOTK
  END,
  a.KHOI,
  CASE
        WHEN a.MAKH IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
        ELSE a.CUS_STATUS
  END,
  case
        when regexp_like(a.SOTK, '^[0-9]{3}-[A-Z]\S*$') then '26111'
        else a.PRODUCT_CODE
  end,
  a.KENH,
  CASE
        WHEN nvl(c.ARRANGEMENT_TERM, 0) &lt;= 12 THEN '1'
        WHEN nvl(c.ARRANGEMENT_TERM, 0) > 12 AND nvl(c.ARRANGEMENT_TERM, 0) &lt;= 60 THEN '2'
        WHEN nvl(c.ARRANGEMENT_TERM, 0) > 60 THEN '3'
        WHEN regexp_like(a.SOTK, '^[0-9]{3}-[A-Z]\S*$') THEN '1'
        when a.PRODUCT_CODE in ('74231','74331') then '3'
        ELSE nvl(f.NHOM_KYHAN, '1')
    END,
  COALESCE(f.SUB_PRODUCT, c.SUB_PRODUCT_CODE, d.SUB_PRODUCT_CODE),
  COALESCE(f.PRODUCTGR_CODE, c.PRODUCT_GROUP_CODE, d.PRODUCT_GROUP_CODE),
  COALESCE(f.PRODUCT_TYPE, c.PROGRAM_CODE),
  COALESCE(f.MBLD_TYPE, c.CAMPAIGN_CODE),
  COALESCE(f.PROJECT_ID, c.PROJECT_ID),
  COALESCE(c.LOAN_INDUSTRY_CODE, d.LOAN_INDUSTRY_CODE),
  CHITIEU,
  a.NARR</sql>
    <limit>0</limit>
