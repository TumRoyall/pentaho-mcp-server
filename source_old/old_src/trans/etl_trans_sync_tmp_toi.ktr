  <step>
    <name>apps.FIN_PNL_KENHSO_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH acc_list AS

  (SELECT * FROM

  (SELECT SOTK, TYPE,

        row_number() OVER (PARTITION BY SOTK ORDER BY TYPE) rn

        FROM (SELECT DISTINCT account_number SOTK, 'BAAS/BANKHUB' TYPE

              FROM apps.ACC_BAAS_BANKHUB

              WHERE TRANSACTION_date = to_date(${PRD_ID}, 'YYYYMMDD')

                    AND TYPE = 'BAAS'

              UNION ALL

              SELECT b.SOTK, 'BAAS/BANKHUB' TYPE

              FROM apps.ACC_BAAS_BANKHUB a

              LEFT JOIN (SELECT MAKH, ARRANGEMENT_NBR sotk

                                FROM etl.ODS_CASA_CONTRACT) b

                    ON a.CUSTOMER = b.MAKH

              WHERE a.TRANSACTION_date = to_date(${PRD_ID}, 'YYYYMMDD')

                    AND a.TYPE = 'BANKHUB' AND a.status = 'ACTIVE'))

  WHERE rn = 1),

t1 AS (

  SELECT a.TRANSACTION_DATE,

        a.KHOI,

        CASE

              WHEN a.makh IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'

              ELSE b.PHAN_KHUC

        END CUS_STATUS,

        coalesce(a.PRODUCT_CODE, e.PRODUCT_CODE, f.PRODUCT_CODE) PRODUCT_CODE,

        CASE

              WHEN nvl(a.LOC_TERM, 0) &lt;= 12 THEN '1'

              WHEN nvl(a.LOC_TERM, 0) > 12 AND nvl(a.LOC_TERM, 0) &lt;= 60 THEN '2'

              WHEN nvl(a.LOC_TERM, 0) > 60 THEN '3'

              WHEN a.PRODUCT_CODE LIKE '26%' THEN '1'

              WHEN a.d_type = 'BOND' THEN '3'

              ELSE nvl(f.TERM_TYPE, '1')

        END TERM,

        CASE

              WHEN a.D_TYPE = 'DEPOSIT' AND (substr(a.product_code,1,2) = '11' or a.product_code = '12111')

                    and (a.taikhoan in ('0511100267866',

                                '0515100096005',

                                '0515100097001',

                                '0511104635002',

                                '0515186886666',

                                '2555139298958',

                                '0511104309008',

                                '0511104310006',

                                '0511104311002',

                                '0511155856666',

                                '0515102226666',

                                '0515118886666',

                                '6695189696155',

                                '8871199999999',

                                '8831199999999',

                                '8335168851555',

                                '8391199999999')

                          or b.app_biz_status = 'ACTIVE'

                          OR c.sotk IS NOT NULL) THEN 'E2E'

              WHEN a.D_TYPE = 'DEPOSIT' AND substr(a.product_code,1,2) IN ('12', '13') and a.product_code &lt;&gt; '12111'

                    AND substr(d.sp_dv, 1, 3) = 'SPS' THEN 'E2E'

              WHEN a.D_TYPE in ('LOAN', 'MUA_NO') THEN decode(d.SP_DV, 'SPS1', 'E2E', 'SPSO', 'O2O', 'DVS1', 'E2E', 'DVSO', 'O2O', 'SPS2', 'E2E', 'DVS2', 'E2E', 'OFFLINE')

              ELSE 'OFFLINE'

        END KENH,

        a.SUB_PRODUCT,

        a.PRODUCTGR_CODE PRODUCT_GROUP_CODE,

        a.PRODUCT_TYPE,

        a.MBLD_TYPE CAMPAIGN_CODE,

        a.PROJECT_ID PROJECT_CODE,

        e.LOAN_INDUSTRY_CODE UOL,

        a.FTP_CODE,

        sum(CASE WHEN a.D_TYPE = 'DEPOSIT' THEN a.REAL_INTEREST_VND ELSE 0 END) CHILAI_HUYDONG_C1,

        sum(CASE WHEN a.D_TYPE = 'DEPOSIT' THEN a.INTEREST_FTP_VND ELSE 0 END) THUFTP_HUYDONG_D1,

        sum(CASE WHEN a.D_TYPE in ('LOAN', 'MUA_NO') THEN a.REAL_INTEREST_VND ELSE 0 END) THULAI_TINDUNG_A1,

        sum(CASE WHEN a.D_TYPE in ('LOAN', 'MUA_NO') THEN a.INTEREST_FTP_VND ELSE 0 END) CHIFTP_TINDUNG_B1,

        sum(CASE WHEN a.D_TYPE = 'BOND' THEN a.REAL_INTEREST_VND ELSE 0 END) THULAI_TRAIPHIEU_A3,

        sum(CASE WHEN a.D_TYPE = 'BOND' THEN a.INTEREST_FTP_VND ELSE 0 END) CHIFTP_TRAIPHIEU_B3

  FROM apps.MB_AGG_NIM_M a

  LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY b

        ON a.TRANSACTION_DATE = b.TRANSACTION_DATE

        AND a.MAKH = b.MAKH

  LEFT JOIN acc_list c

        ON a.TAIKHOAN = c.SOTK

  LEFT JOIN etl.ORS_MB_PRODUCT_CODE d

        ON a.product_code = d.product_code

  LEFT JOIN etl.ODS_LOAN_CONTRACT e

        ON a.TAIKHOAN = e.ARRANGEMENT_NBR

  LEFT JOIN etl.ODS_LOAN_BAL_MTH f

        ON a.TAIKHOAN = f.ARRANGEMENT_NBR

  WHERE a.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')

  GROUP BY a.TRANSACTION_DATE,

        a.KHOI,

        CASE

              WHEN a.makh IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'

              ELSE b.PHAN_KHUC

        END,

        coalesce(a.PRODUCT_CODE, e.PRODUCT_CODE, f.PRODUCT_CODE),

        CASE

              WHEN nvl(a.LOC_TERM, 0) &lt;= 12 THEN '1'

              WHEN nvl(a.LOC_TERM, 0) > 12 AND nvl(a.LOC_TERM, 0) &lt;= 60 THEN '2'

              WHEN nvl(a.LOC_TERM, 0) > 60 THEN '3'

              WHEN a.PRODUCT_CODE LIKE '26%' THEN '1'

              WHEN a.d_type = 'BOND' THEN '3'

              ELSE nvl(f.TERM_TYPE, '1')

        END,

        CASE

              WHEN a.D_TYPE = 'DEPOSIT' AND (substr(a.product_code,1,2) = '11' or a.product_code = '12111')

                    and (a.taikhoan in ('0511100267866',

                                '0515100096005',

                                '0515100097001',

                                '0511104635002',

                                '0515186886666',

                                '2555139298958',

                                '0511104309008',

                                '0511104310006',

                                '0511104311002',

                                '0511155856666',

                                '0515102226666',

                                '0515118886666',

                                '6695189696155',

                                '8871199999999',

                                '8831199999999',

                                '8335168851555',

                                '8391199999999')

                          or b.app_biz_status = 'ACTIVE'

                          OR c.sotk IS NOT NULL) THEN 'E2E'

              WHEN a.D_TYPE = 'DEPOSIT' AND substr(a.product_code,1,2) IN ('12', '13') and a.product_code &lt;&gt; '12111'

                    AND substr(d.sp_dv, 1, 3) = 'SPS' THEN 'E2E'

              WHEN a.D_TYPE in ('LOAN', 'MUA_NO') THEN decode(d.SP_DV, 'SPS1', 'E2E', 'SPSO', 'O2O', 'DVS1', 'E2E', 'DVSO', 'O2O', 'SPS2', 'E2E', 'DVS2', 'E2E', 'OFFLINE')

              ELSE 'OFFLINE'

        END,

        a.SUB_PRODUCT,

        a.PRODUCTGR_CODE,

        a.PRODUCT_TYPE,

        a.MBLD_TYPE,

        a.PROJECT_ID,

        e.LOAN_INDUSTRY_CODE,

        a.FTP_CODE

)

SELECT *

FROM t1

UNPIVOT (

    AMOUNT FOR CHITIEU IN (

        CHILAI_HUYDONG_C1,

        CHIFTP_TINDUNG_B1,

        THUFTP_HUYDONG_D1,

        THULAI_TINDUNG_A1,

        THULAI_TRAIPHIEU_A3,

        CHIFTP_TRAIPHIEU_B3

    )

)

WHERE amount &lt;&gt; 0</sql>
    <limit>0</limit>
