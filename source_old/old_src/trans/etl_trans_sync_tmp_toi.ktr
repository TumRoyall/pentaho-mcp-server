  <step>
    <name> smy.pl_txn_daily</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>WITH sme_pk AS (
    SELECT 
        T24_CUST_ID,
        CASE
            WHEN STANDARD_SEGMENT_CODE IN ('21','SME_MICRO') THEN 'SIEUNHO'
            WHEN STANDARD_SEGMENT_CODE IN ('22','SME_SMALL') THEN 'NHO'
            WHEN STANDARD_SEGMENT_CODE IN ('23','SME_MEDIUM') THEN 'VUA'
        END AS SEGMENT_CODE
    FROM smy.CUST_SEGMENT_DAILY
    WHERE TXN_DATE = (
        SELECT MAX(TXN_DATE)
        FROM smy.CUST_SEGMENT_DAILY
        WHERE TXN_DATE &lt;= TO_DATE('${PRD_ID}', 'YYYYMMDD')
    )
      AND PARTY_TYPE_CODE = 'CUS'
),
pk AS (
    SELECT 
        a.T24_CUST_ID,
        CASE
            WHEN a.T24_CUST_ID IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
            WHEN a.DIVISION_CODE = 'CIB' AND a.SECTOR_CODE IN ('3035', '3535') THEN 'FDI'
            WHEN A.DIVISION_CODE = 'SME' THEN COALESCE(b.SEGMENT_CODE, 'KXD')
            WHEN A.DIVISION_CODE IN ('INDIV', 'NHS') THEN
                CASE
                    WHEN A.SECTOR_CODE IN ('1688','1689','1690','1691','1699','1666','1660') THEN 'PRIVATE'
                    WHEN A.SEGMENT_CODE IN ('3', '4', '5') THEN 'PRIORITY'
                    ELSE 'MASS'
                END
            WHEN A.DIVISION_CODE = 'DVC' THEN DECODE(
                A.SECTOR_CODE,
                '1095', 'BHXH VN',
                '1096', 'BHXH BQP',
                '1097', 'KBNN',
                '1098', 'Du an ODA',
                '1099', 'Bo ban nganh',
                'DVC'
            )
            ELSE NVL(A.DIVISION_CODE, 'KXD')
        END AS PHAN_KHUC,
        a.division_code
    FROM smy.CUST_INFO_MTH a
    LEFT JOIN sme_pk b
        ON a.T24_CUST_ID = b.T24_CUST_ID
    WHERE a.txn_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
),
hhmg AS (
    SELECT 
        TO_DATE('${PRD_ID}', 'YYYYMMDD') AS TRANSACTION_DATE,
        a.NARRATIVE AS NARR,
        d.DETAILS_EXTEND AS SOTK,
        a.T24_CUST_ID AS MAKH,
        c.PHAN_KHUC AS CUS_STATUS,
        a.REPORT_DIVISION_CODE AS KHOI,
        COALESCE(e.product_code, f.product_code, a.ARRANGEMENT_PRODUCT_CODE, a.CHG_PRODUCT_CODE) AS PRODUCT_CODE,
        DECODE(b.product_type, 'SPS1', 'E2E', 'SPSO', 'O2O', 'DVS1', 'E2E', 'DVSO', 'O2O', 'SPS2', 'E2E', 'DVS2', 'E2E', 'OFFLINE') AS KENH,
        a.LCY_AMT,
        CASE
            WHEN UPPER(g.MACHITIEU) IN ('B41') THEN 'THUFTP_DUPHONGTD_B4'
            WHEN UPPER(g.MACHITIEU) IN ('B42') THEN 'THUFTP_DUPHONGTP_B4'
            ELSE UPPER(g.CHITIEU)
        END AS CHITIEU
    FROM smy.pl_txn_daily a
    LEFT JOIN ods.product b
        ON COALESCE(a.arrangement_product_code, a.chg_product_code) = b.PRODUCT_CODE
        AND b.current_flag = 'Y'
    LEFT JOIN pk c
        ON NVL(REGEXP_SUBSTR(
            a.NARRATIVE,
            'CODE( [^ ]+)? ([0-9]+)',
            1,
            1,
            'i',
            2
        ), a.T24_CUST_ID) = c.t24_cust_id
    LEFT JOIN smy.FT_ENTRY d
        ON a.RELATION_TXN_NBR = d.FT_ID
    LEFT JOIN ods.loan_contract e
        ON d.DETAILS_EXTEND = e.ARRANGEMENT_NBR
    LEFT JOIN ods.FX_CONTRACT f
        ON d.DETAILS_EXTEND = f.ARRANGEMENT_NBR
    LEFT JOIN (
        SELECT *
        FROM (
            SELECT 
                GL_LINE,
                TOI_REPORT_ITEM_CODE AS MACHITIEU,
                TOI_REPORT_ITEM_NAME AS CHITIEU,
                ROW_NUMBER() OVER (PARTITION BY GL_LINE ORDER BY TXN_DATE DESC) AS rn
            FROM ext.PL_MAPPING_TOI
        )
        WHERE rn = 1
    ) g
        ON a.GL_LINE = g.GL_LINE
    WHERE a.txn_date BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MONTH') AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
      AND a.PL_CATE_CODE IN ('68224', '68221', '52285') 
)
SELECT 
    a.TRANSACTION_DATE,
    a.SOTK,
    a.MAKH,
    a.KHOI,
    a.CUS_STATUS,
    a.PRODUCT_CODE,
    a.KENH,
    CASE
        WHEN COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 12 THEN '1'
        WHEN COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 12 AND COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 60 THEN '2'
        WHEN COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 60 THEN '3'
        WHEN a.PRODUCT_CODE LIKE '26%' THEN '1'
        WHEN a.PRODUCT_CODE IN ('74231','74331') THEN '3'
        ELSE COALESCE(f.TERM_TYPE, '1')
    END AS TERM,
    COALESCE(f.SUB_PRODUCT_CODE, d.SUB_PRODUCT_CODE) AS SUB_PRODUCT,
    COALESCE(f.PRODUCT_GROUP_CODE, d.PRODUCT_GROUP_CODE) AS PRODUCT_GROUP_CODE,
    f.PROGRAM_CODE AS PRODUCT_TYPE,
    f.CAMPAIGN_CODE AS CAMPAIGN_CODE,
    f.PROJECT_CODE AS PROJECT_CODE,
    COALESCE(f.LOAN_INDUSTRY_CODE, d.LOAN_INDUSTRY_CODE) AS UOL,
    a.CHITIEU,
    SUM(a.LCY_AMT) AS AMOUNT
FROM hhmg a
LEFT JOIN ods.loan_contract c
    ON REGEXP_SUBSTR(a.SOTK, 'LD[0-9]+') = c.arrangement_nbr
LEFT JOIN (
    SELECT 
        d.*,
        ROW_NUMBER() OVER (PARTITION BY d.arrangement_nbr ORDER BY LAST_UPDATE_DATE DESC) AS rank_num
    FROM ods.pd_contract d
) d
    ON a.SOTK = d.arrangement_nbr
    AND d.rank_num = 1
LEFT JOIN (
    SELECT 
        ARRANGEMENT_NBR, 
        PRODUCT_GROUP_CODE, 
        PRODUCT_CODE, 
        PROGRAM_CODE, 
        PROJECT_CODE, 
        SUB_PRODUCT_CODE, 
        CAMPAIGN_CODE, 
        LOAN_INDUSTRY_CODE, 
        term_type,
        ROW_NUMBER() OVER (PARTITION BY ARRANGEMENT_NBR ORDER BY PRODUCT_GROUP_CODE) AS rn
    FROM smy.LOAN_BAL_MTH
    WHERE TXN_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
) f
    ON a.SOTK = f.ARRANGEMENT_NBR
    AND f.rn = 1
GROUP BY 
    a.TRANSACTION_DATE,
    a.SOTK,
    a.MAKH,
    a.KHOI,
    a.CUS_STATUS,
    a.PRODUCT_CODE,
    a.KENH,
    CASE
        WHEN COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 12 THEN '1'
        WHEN COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 12 AND COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) &lt;= 60 THEN '2'
        WHEN COALESCE(c.ARRANGEMENT_TERM, d.ARRANGEMENT_TERM) > 60 THEN '3'
        WHEN a.PRODUCT_CODE LIKE '26%' THEN '1'
        WHEN a.PRODUCT_CODE IN ('74231','74331') THEN '3'
        ELSE COALESCE(f.TERM_TYPE, '1')
    END,
    COALESCE(f.SUB_PRODUCT_CODE, d.SUB_PRODUCT_CODE),
    COALESCE(f.PRODUCT_GROUP_CODE, d.PRODUCT_GROUP_CODE),
    f.PROGRAM_CODE,
    f.CAMPAIGN_CODE,
    f.PROJECT_CODE,
    COALESCE(f.LOAN_INDUSTRY_CODE, d.LOAN_INDUSTRY_CODE),
    a.CHITIEU</sql>
