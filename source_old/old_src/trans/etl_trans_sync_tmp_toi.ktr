  <step>
    <name>APPS.REP_TOI_FINAL_TT_KH</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH f AS (

  select transaction_date,

        khoi,

        CASE

          WHEN makh IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'

          ELSE cus_status

      END cus_status,

        PRODUCT_CODE,

        sum(THULAI_TINDUNG_A1) THULAI_TINDUNG_A1,

        sum(THU_LAI_KHAC_A2) THU_LAI_KHAC_A2,

        sum(THULAI_TRAIPHIEU_A3) THULAI_TRAIPHIEU_A3,

        sum(CHIFTP_TINDUNG_B1) CHIFTP_TINDUNG_B1,

        sum(CHIFTP_KHAC_B2) CHIFTP_KHAC_B2,

        sum(CHIFTP_TRAIPHIEU_B3) CHIFTP_TRAIPHIEU_B3,

        sum(THUFTP_DUPHONGTD_B4) THUFTP_DUPHONGTD_B4,

        sum(THUFTP_DUPHONGKHAC_B3) THUFTP_DUPHONGKHAC_B3,

        sum(THUFTP_DUPHONGTP_B4) THUFTP_DUPHONGTP_B4,

        sum(CHILAI_HUYDONG_C1) CHILAI_HUYDONG_C1,

        sum(CHILAI_KHAC_C2) CHILAI_KHAC_C2,

        sum(CHILAI_TRAIPHIEU_C3) CHILAI_TRAIPHIEU_C3,

        sum(THUFTP_HUYDONG_D1) THUFTP_HUYDONG_D1,

        sum(THUFTP_KHAC_D2) THUFTP_KHAC_D2,

        sum(DV_BAOLANH_E1) DV_BAOLANH_E1,

        sum(DV_TTQT_E2) DV_TTQT_E2,

        sum(DV_TTTN_E3) DV_TTTN_E3,

        sum(DV_THE_E4) DV_THE_E4,

        sum(DV_UTBHCK_E5) DV_UTBHCK_E5,

        sum(DV_TUVAN_E6) DV_TUVAN_E6,

        sum(DV_NGANQUY_E7) DV_NGANQUY_E7,

        sum(DV_GIUHO_E8) DV_GIUHO_E8,

        sum(DV_KIEUHOI_E9) DV_KIEUHOI_E9,

        sum(DV_NHDT_E10) DV_NHDT_E10,

        sum(DV_COMMO_E13) DV_COMMO_E13,

        sum(DV_KHAC_E13) DV_KHAC_E13,

        sum(FX_NTE_E14) FX_NTE_E14,

        sum(DTK_THU_E15) DTK_THU_E15,

        sum(DTK_CHIFTP_E16) DTK_CHIFTP_E16,

        sum(BT_KHAC_E17) BT_KHAC_E17,

        sum(BT_XLN_E18) BT_XLN_E18,

        sum(DP_DAUTU_F1) DP_DAUTU_F1,

        sum(DP_LC_F2) DP_LC_F2,

        sum(DP_BL_F3) DP_BL_F3,

        sum(DP_TD_F4) DP_TD_F4,

        sum(DP_K) DP_K

    from apps.REP_TOI_FINAL_TT_KH

    where transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')

    GROUP BY transaction_date,

        khoi,

        PRODUCT_CODE,

        CASE

          WHEN makh IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'

          ELSE cus_status

      END

)

SELECT

    TRANSACTION_DATE,

    KHOI,

    CUS_STATUS,

    PRODUCT_CODE,

    CHITIEU,

    AMOUNT

FROM f

UNPIVOT (

    AMOUNT FOR CHITIEU IN (

        THULAI_TINDUNG_A1,

        THU_LAI_KHAC_A2,

        THULAI_TRAIPHIEU_A3,

        CHIFTP_TINDUNG_B1,

        CHIFTP_KHAC_B2,

        CHIFTP_TRAIPHIEU_B3,

        THUFTP_DUPHONGTD_B4,

        THUFTP_DUPHONGKHAC_B3,

        THUFTP_DUPHONGTP_B4,

        CHILAI_HUYDONG_C1,

        CHILAI_KHAC_C2,

        CHILAI_TRAIPHIEU_C3,

        THUFTP_HUYDONG_D1,

        THUFTP_KHAC_D2,

        DV_BAOLANH_E1,

        DV_TTQT_E2,

        DV_TTTN_E3,

        DV_THE_E4,

        DV_UTBHCK_E5,

        DV_TUVAN_E6,

        DV_NGANQUY_E7,

        DV_GIUHO_E8,

        DV_KIEUHOI_E9,

        DV_NHDT_E10,

        DV_COMMO_E13,

        DV_KHAC_E13,

        FX_NTE_E14,

        DTK_THU_E15,

        DTK_CHIFTP_E16,

        BT_KHAC_E17,

        BT_XLN_E18,

        DP_DAUTU_F1,

        DP_LC_F2,

        DP_BL_F3,

        DP_TD_F4,

        DP_K

    )

)

where amount &lt;&gt; 0</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
