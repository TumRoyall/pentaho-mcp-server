    <name>Table input 3 2 6</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <sql>select transaction_Date,cn, ftp_prod, khoi, nte, 
sum(ftp_sdc) ftp_sdc from 
(
select '20160524' transaction_Date,cn, ftp_prod, khoi, nte, 
sum(case when a.nte = 'VND' then round(nvl(ftp_sdc,0)) else round(nvl(ftp_sdc,0),2) end) ftp_sdc from apps.ftp_tonghop a
where transaction_date >= to_date('20160520','yyyyMMdd')
and transaction_date &lt;= to_date('20160522','yyyyMMdd')
and ftp_sdc > 0
and ftp_source = 'NO_QH'
and not ((nte in ('USD','EUR') and ftp_sdc &lt;5)
      or (nte= 'VND' and ftp_sdc &lt;10000))
group by cn, ftp_prod, khoi, nte
--order by transaction_date,cn,ftp_prod
union all 
select '20160524' transaction_Date,cn, ftp_prod, khoi, nte, 
sum(case when a.nte = 'VND' then round(nvl(ftp_sdc,0)) else round(nvl(ftp_sdc,0),2) end) ftp_sdc from apps.ftp_tonghop a
where transaction_date >= to_date('20160523','yyyyMMdd')
and transaction_date &lt;= to_date('20160524','yyyyMMdd')
and ftp_sdc > 0
and not ((nte in ('USD','EUR') and ftp_sdc &lt;5)
      or (nte= 'VND' and ftp_sdc &lt;10000))
group by cn, ftp_prod, khoi, nte
order by transaction_date,cn,ftp_prod)
group by transaction_Date,cn, ftp_prod, khoi, nte
order by transaction_date,cn,ftp_prod</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
