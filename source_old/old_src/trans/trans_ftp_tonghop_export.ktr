    <connection>tckt_dc</connection>
    <sql>select to_char(transaction_date,'yyyyMMdd') transaction_Date,cn, ftp_prod, khoi, nte, 
sum(case when a.nte = 'VND' then round(nvl(ftp_sdc,0)) else round(nvl(ftp_sdc,0),2) end) ftp_sdc from apps.ftp_tonghop a
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and ftp_sdc > 0
group by to_char(transaction_date,'yyyyMMdd'),cn, ftp_prod, khoi, nte
order by transaction_date,cn,ftp_prod</sql>
