  <step>
    <name>Table input 2 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <sql>select '20161031' transaction_Date,cn, ftp_prod, khoi, nte, 
sum(case when a.nte = 'VND' then round(ftp_thoai) else round(ftp_thoai,2) end) ftp_thoai ,
sum(case when a.nte = 'VND' then round(ftp_huong) else round(ftp_huong,2) end) ftp_huong
from
(
select a.*,b.amount ti_le,a.ftp_thoai* b.amount ftp_huong from (
select a.transaction_date,a.ngayms, a.soso,a.ftp_prod,a.product_code,a.nte,a.term_goc,a.term_ftp,a.cn,a.khoi,
a.rutgoc_amt,a.ftp_thoai, max(b.date_apply) date_apply from apps.ftp_cal_rgtp_ttth_recal a
left join apps.ftp_dic_tyle_tattoan b
on a.ftp_prod = b.ftp_code
and a.nte = b.currency
and a.term_ftp = b.term
and a.transaction_date>= b.date_apply
where a.transaction_date >= to_date('20160801','yyyyMMdd')
and a.transaction_date &lt;= to_date('20161031','yyyyMMdd')
and not (a.cn= 'VN0010001' and khoi = 'FI')
group by a.transaction_date,a.ngayms, a.soso,a.ftp_prod,a.product_code,a.nte,a.term_goc,a.term_ftp,a.cn,a.khoi,
a.rutgoc_amt,a.ftp_thoai) a
left join apps.ftp_dic_tyle_tattoan b
on a.ftp_prod = b.ftp_code
and a.nte = b.currency
and a.term_ftp = b.term
and a.date_apply = b.date_apply) a
group by cn, ftp_prod, khoi, nte</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
