    <connection>tckt_dc</connection>
    <sql>select cn,
       transaction_date,
       nte,
       soku,
       ftp_prod,
       mb_per,
       khoi,
       y_gia_hddb,
       sodu,
       sodu_dp,
       ngaydh,
       ngayvay,
       ngay_golive,
       interest_type,
       source_of_fund,
       ngay_tdls_goc,
       ngay_tdls,
       term_ftp,
       term_goc,
       vung_mien,
       ftp_base_amount,
       pttk_goc,
       ftp_phutroi_amount,
       ftp_dc_alco,
       ftp_chiphi_tk,
       ftp_chiphi_dtbb,
       ftp_chiphi_bhtg,
       sodu_ftp,
       ftp_tdc,
	   ftp_rate,
       ftp_sdc ftp_sdc_old,
       /*case when y_gia_hddb is not null then 0
			when FTP_PROD = 'TD572' and  NGAYVAY  = NGAY_TDLS and NGAY_TDLS >= '1jul22' and ftp_rate-0.8 &lt; LS - 0.2 then 
				 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ftp_rate-0.8)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)

			when FTP_PROD = 'TD572' and  NGAYVAY  = NGAY_TDLS and NGAY_TDLS >= '1jul22' and ftp_rate-0.8 > LS - 0.2 then 
				 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (LS - 0.2)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)


            when  FTP_PROD = 'TD574' and KHOI = 'CIB' and NTE in ('VND', 'USD') and ftp_rate > LS - 1.2 then
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-1.2)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)


            when NTE in ('VND', 'USD') and ftp_rate > LS - 0.2 then 
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-0.2)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)


            else (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * ftp_rate / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end) end ftp_sdc,*/



		case when y_gia_hddb is not null then 0

          when  FTP_PROD = 'TD574' and KHOI = 'CIB' and NTE in ('VND', 'USD') and NGAYVAY &lt;'03apr2023' and ftp_rate > LS - 1 then
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-1)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)

          when  FTP_PROD = 'TD574' and KHOI = 'CIB' and NTE in ('VND', 'USD') and NGAYVAY between '03apr2023' and '11jun2023' and ftp_rate > LS - 1.2 then
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-1.2)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)
          when  FTP_PROD = 'TD574' and KHOI = 'CIB' and NTE in ('VND', 'USD') and NGAYVAY >'11jun2023' then 
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * ftp_rate / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)
                    
                    
          when  FTP_PROD = 'TD579' and ftp_rate > LS - 0.5 then
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-0.5)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)
           
          when  FTP_PROD = 'TD538' then
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-0.5)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)
          
          when NTE in ('VND', 'USD') and ftp_rate > LS - 0.2 then 
                 (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * (ls-0.2)  / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end)


          else (( sodu - sodu_dp) 
                   * (case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per, 100) / 100
                         else 1
                    end)) * ftp_rate / (case when ngay_tdls >= '1-jan-2018' then 36500 else 36000 end) end ftp_sdc,
       ftp_hddb,
       term_dn,
       ftp_sdc_apply_all,
       makh,
       product_code,
       biendo_khoi,
       biendo_sanpham,
       biendo_vungmien,
       ftp_sdc_biendo_khoi,
       ftp_sdc_biendo_sanpham,
       ftp_sdc_biendo_vungmien,
       ls,
       hoten,
       ftp_line,
       ftp_category,
       origin_y_gia_hddb,
       ngay_hddb,
       ftp_fix
  from etl.tmp_FTP_CAL_BV_TIENVAY</sql>
    <limit>0</limit>
