    <sql>SELECT TRANSACTION_DATE
      ,BRANCH_CODE_T24
      ,BRANCH_NAME_T24
      ,CNC2_TYPE
      ,PARENT_BRANCH_CODE_T24
      ,PARENT_BRANCH_NAME_T24
