    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT TXN_DATE,
	DIVISION_CODE,
	PARTY_TYPE_CODE,
	PARTY_KEY,
	T24_CUST_ID,
	PARTY_FULL_NAME,
	PROJECT_CUST_IND,
	LATEST_YEAR_REVENUE,
	LATEST_03_YEAR_AVG_REVENUE,
	LATEST_06_MONTH_AVG_LOAN_BAL,
	LATEST_06_MONTH_AVG_DEP_BAL,
	ADD_SEGMENT_CODE,
	ADD_SEGMENT_NAME,
	STANDARD_SEGMENT_CODE,
	STANDARD_SEGMENT_NAME,
	CONTACT_DATE,
	PROSP_CUST_CREATED_DATE,
	LATEST_CHANGE_DATE,
	CHANGE_REASON,
	SEGMENT_STATUS,
	CREATED_BY,
	CREATION_DATE,
	LAST_UPDATED_BY,
	LAST_UPDATE_DATE,
	VAT_INT_SERIAL,
	ESTAB_LIC_CODE,
	LATEST_4YEAR_REVENUE,
	LATEST_3YEAR_REVENUE,
	LATEST_2YEAR_REVENUE,
	LATEST_1YEAR_REVENUE,
	REVENUE
FROM smy.CUST_SEGMENT_DAILY
WHERE txn_date = (
	SELECT
		CASE
			WHEN WORKING_DATE_IND = 'H' THEN LAST_WORKING_DATE
			WHEN WORKING_DATE_IND = 'W' THEN CALENDAR_DATE
		END TXN_DATE
	FROM ods.DATES_REF
	WHERE CALENDAR_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
)
</sql>
