    <connection>ors_dc</connection>
    <sql>SELECT TRANSACTION_DATE
      ,PK_TYPE
      ,DTT_TYPE
      ,PKKH
      ,MAKH
      ,CN
      ,HOTEN
      ,SECTOR
      ,KHOI
      ,CREATION_DATE
      ,CHOVAY_BQ_LK
      ,HDV_BQ_LK
      ,DOANHTHU_THUAN_1Y
      ,DOANHTHU_THUAN_3Y
  FROM APPS.MB_SME_PKKH_M T
 WHERE T.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')</sql>
