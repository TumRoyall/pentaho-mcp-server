    <connection>dwh_sor_dc</connection>
    <sql>SELECT SNAPSHOT_DT,
    CST_CODE,
    IVSM_AMT
FROM PRD_SOR.MBPRD.CST_SEG_TVR
WHERE SNAPSHOT_DT = (
    SELECT MAX(SNAPSHOT_DT)
    FROM PRD_SOR.MBPRD.CST_SEG_TVR
    WHERE SNAPSHOT_DT &lt;= TO_DATE('${PRD_ID}', 'YYYYMMDD')
)
AND IVSM_AMT IS NOT NULL</sql>
