    <connection>cds_dc_etl_ods</connection>
    <sql>SELECT dt.bin8 BIN
      ,dt.CARD_MODULE
      ,dt.CARD_CLASS
      ,dt.issue_branch_code ISSUE_BRANCH_CODE
      ,dt.card_id CARD_ID
      ,dt.card_nbr CARD_NUMBER
      ,dt.w4_contract_id CONTRACT_ID
      ,dt.arrangement_nbr CONTRACT_NUMBER
      ,prod.name PRODUCT_NAME
      ,dt.w4_product_code PRODUCT_CODE
      ,dt.w4_product_group_code PRODUCT_GROUP
      --,prod.appl_pr_group__id PRODUCT_GROUP
      ,dt.main_sub_card_ind CARD_MAIN_SUB
      ,dt.limit_amt CREDIT_LIMIT
      ,dt.ARRANGEMENT_NAME CONTRACT_NAME
      ,dt.card_open_date DATE_OPEN
      ,dt.card_info_status CARD_INFO_STATUS
      ,dt.contr_status CONTR_STATUS
      ,dt.production_status PRODUCTION_STATUS
      ,dt.w4_client_id CLIENT__ID
      ,dt.acnt_add_info_03 ADD_INFO_03
      ,dt.card_status_final CARD_STATUS
      ,dt.t24_cust_id T24_CUSTOMER_CODE
      ,null NGAY_KICH_HOAT_CHUAN
      ,dt.main_sell_rm_code RM_CODE
      ,dt.last_card_creation_date ISSUE_DATE
      ,dt.card_group CARD_DESCENT
      ,dt.card_segment CARD_LEVEL
      ,dt.t24_product_code T24_PROD_CODE
      ,dt.business_program_code BUSINESS_CODE
      ,dt.card_issue_channel KENH_PHATHANH
      ,dt.physical_ind IS_PHYSICAL_CARD
FROM CDT.CREDIT_CARD_MTH partition for(TO_DATE('${PRD_ID}','yyyyMMdd')) dt
LEFT JOIN CDT.CARD_APPL_PROD_W4T24 prod
  ON (PROD.AMND_STATE='A' and prod.internal_code=dt.w4_current_internal_code)
WHERE 1=1
AND trunc(DT.TXN_DATE)=TO_DATE('${PRD_ID}','yyyyMMdd')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
