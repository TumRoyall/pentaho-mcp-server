  <step>
    <name>TR_CHOVAY_BQ</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select
add_months(last_day(to_date(${PRD_ID}, 'YYYYMMDD')),-1) transaction_date,
SOTK,
NTE,
MAKH,
KYHAN,
CN,
CATEGORY,
SECTOR,
KHOI,
MBLD_TYPE,
PRODUCT_CODE,
SUB_PRO sub_product,
LS,
NHOMNO_XHTD,
PRODUCTGR_CODE,
sum (SODU_VND * to_char (TRANSACTION_DATE, 'DD')/ to_char (add_months(last_day(to_date(${PRD_ID}, 'YYYYMMDD')),-1), 'DDD')) SODU_BQ_VND_LK
from apps.tr_chovay_bq
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') and add_months(last_day(to_date(${PRD_ID}, 'YYYYMMDD')),-1)
--hoangtl chinh sua ngay 04/11/2024: and to_date ('${PRD_ID}', 'YYYYMMDD')
group by
SOTK,
NTE,
MAKH,
KYHAN,
CN,
CATEGORY,
SECTOR,
KHOI,
MBLD_TYPE,
PRODUCT_CODE,
SUB_PRO,
LS,
NHOMNO_XHTD,
PRODUCTGR_CODE</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
