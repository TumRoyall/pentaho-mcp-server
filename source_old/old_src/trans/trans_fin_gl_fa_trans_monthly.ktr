    <connection>tckt_dc</connection>
    <sql>SELECT NGAY_CT,
       TK_GL,
       TEN_TK,
       SO_CT,
       SO_GD,
       MA_CN,
       MA_KHOI,
       MA_PB,
       MA_BP,
       MA_NHOMCHA,
       MA_NHOMCON,
       MA_TSGL,
       MA_PAM,
       NGAY_HT,
       LOAI_GD,
       DIENGIAI,
       NT_GHINO,
       NT_GHICO,
       BT_GHINO,
       BT_GHICO,
       MA_BPM,
       SOTS,
       NGAYXUAT,
       LAST_DAY(NGAY_CT) TRANSACTION_DATE
  FROM ETL.FILE_GL_FA_TRANS_CCLD
  WHERE LAST_DAY(NGAY_CT) = TO_DATE('${PRD_ID}', 'yyyyMMdd')
UNION ALL
SELECT NGAY_CT,
       TK_GL,
       TEN_TK,
       SO_CT,
       SO_GD,
       MA_CN,
       MA_KHOI,
       MA_PB,
       MA_BP,
       MA_NHOMCHA,
       MA_NHOMCON,
       MA_TSGL,
       MA_PAM,
       NGAY_HT,
       LOAI_GD,
       DIENGIAI,
       NT_GHINO,
       NT_GHICO,
       BT_GHINO,
       BT_GHICO,
       MA_BPM,
       SOTS,
       NGAYXUAT,
       LAST_DAY(NGAY_CT) TRANSACTION_DATE
  FROM ETL.FILE_GL_FA_TRANS_TSCD
  WHERE LAST_DAY(NGAY_CT) = TO_DATE('${PRD_ID}', 'yyyyMMdd')</sql>
