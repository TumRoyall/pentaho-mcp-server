    <sql>SELECT 
to_date(${PRD_ID}, 'yyyymmdd') PARTITION_DATE,-- Set là ngày cuối --cùng của tháng hiện tại PARTITION_DATE
A.FT_ID,
A.SENDER_BANK_CODE,
A.VALUE_DATE,
A.CURRENCY,
A.SENDER_ACCOUNT,
A.SENDER_NAME,
A.MESSAGE_TYPE,
A.STATUS,
A.CLASS_FT,
A.FT_ORG,
A.SUB_BRANCH_FT_ORG MA_CN,
A.LOB_FT_ORG KHOI,
CASE WHEN A.LOB_FT_ORG = 'SME' AND B1.DR_CUS IS NULL THEN '1000'
    WHEN A.LOB_FT_ORG = 'FI' AND B1.DR_CUS IS NULL THEN '8000'
    WHEN A.LOB_FT_ORG = 'NHS' AND B1.DR_CUS IS NULL THEN '1910'
    WHEN A.LOB_FT_ORG = 'CIB' AND B1.DR_CUS IS NULL  THEN '3000'
    WHEN A.LOB_FT_ORG = 'DVC' AND B1.DR_CUS IS NULL  THEN '1100'
    WHEN A.LOB_FT_ORG = 'INDIV' AND B1.DR_CUS IS NULL THEN '1700'
   ELSE coalesce (B1.DR_CUS,'') END MAKH,    
A.RATE,
A.TXN_DATE,
TO_CHAR(TO_DATE(A.LAST_UPDATE_TIME,'hh24:MI:SS'),'hh24:MI:SS') Thoi_gian_GD,
A.AMOUNT TIENNO,
CASE WHEN A.CURRENCY ='VND' THEN TO_NUMBER(A.AMOUNT) 
    ELSE ROUND(TO_NUMBER(AMOUNT)*A.RATE)
    END TIENNO_VND,
A.FEE PHI,
CASE WHEN A.CURRENCY ='VND' THEN round(a.fee) 
    ELSE ROUND(a.fee*A.RATE,2)
    END PHI_VND,
CASE WHEN A.CURRENCY ='VND' THEN round(A.FEE*10/100) 
    ELSE round((A.FEE*10/100)*A.RATE,2) 
    END VAT,
 CASE WHEN A.CURRENCY ='VND' THEN  round(a.fee + (A.FEE*10/100)) 
    ELSE round((a.fee + (A.FEE*10/100))*A.RATE,2) 
    END TONG_PHI_VND
FROM RPT.CHARGE_BIDV_DAILY A
LEFT JOIN SMY.FT_ENTRY B1
ON (A.FT_ID =B1.FT_ID) AND B1.PARTITION_DATE =A.TXN_DATE
Where a.txn_date BETWEEN --ADD_MONTHS(TRUNC(TO_DATE(${PRD_ID},'YYYYMMDD'),'MM'),-1)+25 AND TRUNC(TO_DATE(${PRD_ID},'YYYYMMDD'),'MM')+24 
--TO_DATE(20250526,'YYYYMMDD') AND TO_DATE(20250825,'YYYYMMDD') --yc dvnb 200902 diepbtb.ho
to_date('${PRD_ID_FR}', 'yyyymmdd') and to_date('${PRD_ID_TO}', 'yyyymmdd') </sql>
    <limit>0</limit>
