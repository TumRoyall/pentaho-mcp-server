  <step>
    <name>ETL.temp_ftp_term_deposit</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select to_date('${PRD_ID}','YYYYMMDD') as transaction_date, a.* 
from APPS.FTP_TERM_DEPOSIT_DAILY a 
where a.transaction_date =
(select max(dayid) from apps.mb_dim_time
where is_working_day=1
and dayid &lt;to_Date(${PRD_ID},'yyyyMMdd'))</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
