  <step>
    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select to_date('${PRD_ID}','YYYYMMDD') as transaction_date, a.* 
from APPS.ftp_muano_daily a 
where a.transaction_date =
(select max(dayid) from apps.mb_dim_time
where is_working_day=1
and dayid &lt;to_Date(${PRD_ID},'yyyyMMdd'))</sql>
