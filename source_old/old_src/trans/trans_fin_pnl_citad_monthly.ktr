  </step>
  <step>
    <name>Input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
		to_date ('${PRD_ID}', 'YYYYMMDD') PARTITION_DATE,--'SET NGAY CUOI CUNG CUA THANG REQUEST CHAY' PARTITION_DATE,
		ct.TRX_DATE TXN_DATE,
        ct.MAKH,
        ct.MA_CN,
        ct.FT MA_GD,
        ct.KHOI,
        ct.TRX_TYPE LOAI_DIEN,
        substr(ct.SD_TIME, 9, 6) THOI_GIAN,
        ct.CONG_TT,
        ct.CURRENCY LOAI_TIEN,
        '1' SL_GD,
        ct.AMOUNT GIA_TRI_GD_NGUYENTE,
        ROUND(ct.AMOUNT * r.CONVERSION_RATE) GIA_TRI_GD_VND,
        least(
            greatest(
                TO_NUMBER(ct.AMOUNT) * thamchieu.F_FEE_PERCENTAGE / 100,
                thamchieu.f_fee_min
            ),
            f_fee_max
        ) PHI_NGUYEN_TE,
        ROUND(
            least(
                greatest(
                    TO_NUMBER(ct.AMOUNT) * thamchieu.F_FEE_PERCENTAGE / 100,
                    thamchieu.f_fee_min
                ),
                f_fee_max
            ) * r.CONVERSION_RATE
        ) PHI_VND
    FROM ETL.ODS_CITAD_TBLREPORT_DIENDI ct
    LEFT JOIN etl.ORS_GL_DAILY_RATES R 
    on ct.TRX_DATE = r.CONVERSION_DATE
        and ct.CURRENCY = r.FROM_CURRENCY
        and r.TO_CURRENCY = 'VND'
        join (SELECT * FROM ETL.ORS_THAM_CHIEU_PHI_CITAD) thamchieu 
        on ct.CURRENCY = thamchieu.v_currency
        and ct.trx_type like nvl(thamchieu.v_trx_type, '%')
        and (
            case
                when thamchieu.V_SD_TIME_TYPE = '>' then case
                    when TO_NUMBER(substr(ct.SD_TIME, 9, 4)) > thamchieu.V_SD_TIME then 1
                    else 0
                end
                when thamchieu.V_SD_TIME_TYPE = '>=' then case
                    when TO_NUMBER(substr(ct.SD_TIME, 9, 4)) >= thamchieu.V_SD_TIME then 1
                    else 0
                end
                when thamchieu.V_SD_TIME_TYPE = '&lt;' then case
                    when TO_NUMBER(substr(ct.SD_TIME, 9, 4)) &lt; thamchieu.V_SD_TIME then 1
                    else 0
                end
                when thamchieu.V_SD_TIME_TYPE = '&lt;=' then case
                    when TO_NUMBER(substr(ct.SD_TIME, 9, 4)) &lt;= thamchieu.V_SD_TIME then 1
                    else 0
                end
                when thamchieu.V_SD_TIME_TYPE = '=' then case
                    when TO_NUMBER(substr(ct.SD_TIME, 9, 4)) = thamchieu.V_SD_TIME then 1
                    else 0
                end
                else 1
            end
        ) = 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
