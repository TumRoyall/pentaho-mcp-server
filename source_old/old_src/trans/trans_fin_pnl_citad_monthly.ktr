    <sql>DELETE APPS.FIN_PNL_CITAD_MONTHLY WHERE PARTITION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD');</sql>
    <set_params>N</set_params>
    <insert_field/>
    <update_field/>
    <delete_field/>
    <read_field/>
    <arguments>
    </arguments>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
