  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select a.cn,a.transaction_date,a.nte, a.soku,a.makh,a.ls, a.hoten, a.ftp_prod,a.product_code, a.khoi,
       a.sodu_goc, a.sodu_dp, a.term, a.vung_mien, a.term_id,
nvl(ftp_base_amount,0) ftp_base_amount,
nvl(b.amount,0) ftp_dc_alco,
nvl(tk_amount,0) ftp_chiphi_tk,
nvl(dtbb_cp_dtbb,0) ftp_chiphi_dtbb,
nvl(bhtg_tile_bhtg,0) ftp_chiphi_bhtg,
nvl(c.amount,0) FTP_PTTK,
--(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- (-1)*sodu_dp end) * (nvl(ftp_base_amount,0)/100+ nvl(b.amount,0)) /360 ftp_sdc_sai,
--(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_trdc,
--(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.amount,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc,
(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(c.amount,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_trdc,
(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.amount,0)+ nvl(c.amount,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc,
biendo_khoi,biendo_sanpham,biendo_vungmien,
--(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.biendo_khoi,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc_biendo_khoi,
--(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.biendo_sanpham,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc_biendo_sanpham,
--(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.biendo_vungmien,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc_biendo_vungmien,
(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.biendo_khoi,0)+ nvl(c.amount,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc_biendo_khoi,
(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.biendo_sanpham,0)+ nvl(c.amount,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc_biendo_sanpham,
(case when sodu_dp = 0 then -1*sodu_goc else (-1)*sodu_goc- sodu_dp end) * (nvl(ftp_base_amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)+ nvl(b.biendo_vungmien,0)+ nvl(c.amount,0)) /(case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end) ftp_sdc_biendo_vungmien,
ftp_line, ftp_category
FROM
(
select a.*,
(SELECT bhtg.tile_bhtg
                      FROM apps.ftp_dic_chiphi_bhtg bhtg
                     WHERE bhtg.ccy = a.nte and bhtg.date_tx =
                           (SELECT MAX(date_tx)
                              FROM apps.ftp_dic_chiphi_bhtg bhtg_m
                             WHERE bhtg_m.ccy = a.nte
and bhtg_m.date_tx >= to_date('20160118','yyyyMMdd') 
                               AND bhtg_m.date_tx &lt;=to_date(${PRD_ID},'yyyyMMdd'))) bhtg_tile_bhtg,
(SELECT dtbb.cp_dtbb 
                      FROM apps.ftp_dic_chiphi_dtbb dtbb
                     WHERE dtbb.ccy = a.nte and dtbb.date_tx =
                           (SELECT MAX(date_tx)
                              FROM apps.ftp_dic_chiphi_dtbb dtbb_m
                             WHERE dtbb_m.ccy = a.nte
and dtbb_m.date_tx >= to_date('20160118','yyyyMMdd')                          
                               AND dtbb_m.date_tx &lt;=to_date(${PRD_ID},'yyyyMMdd'))) dtbb_cp_dtbb,
(SELECT tk.amount
                      FROM apps.ftp_dic_chiphi_tk tk
                     WHERE tk.currency = a.nte and tk.date_apply =
                           (SELECT MAX(date_apply)
                              FROM apps.ftp_dic_chiphi_tk tk_m
                             WHERE tk_m.currency = a.nte
and tk_m.date_apply >= to_date('20160118','yyyyMMdd')
                               AND tk_m.date_apply &lt;= to_date(${PRD_ID},'yyyyMMdd')
                               )) tk_amount,
--
(SELECT ftp_base.amount
                      FROM apps.ftp_dic_ftp_base ftp_base
                     WHERE ftp_base.currency = a.nte 
                     AND ftp_base.term = a.term_id
                     and ftp_base.date_apply =
                           (SELECT MAX(date_apply)
                              FROM apps.ftp_dic_ftp_base ftp_base_m
                           WHERE a.nte = ftp_base_m.Currency
                            AND a.term_id = ftp_base_m.term
                            AND to_date(${PRD_ID},'yyyyMMdd') >= ftp_base_m.date_apply  
                               )) ftp_base_amount,
nvl((SELECT MAX(date_apply) ngay_dc_alco
                              FROM etl.tmp_FTP_DIC_DIEUCHINH_ALCO B
                             WHERE B.FTP_PRODUCT = A.ftp_prod
                               AND B.KHOI = A.KHOI
                               AND B.VUNG_MIEN = 'HANOI'--A.VUNG_MIEN
                               AND B.CURRENCY = A.nte
                               AND B.TERM = a.term_id
                               AND B.DATE_APPLY &lt;= to_date(${PRD_ID},'yyyyMMdd')
                               ),to_date('20160118','yyyyMMdd')) ngay_dc_alco
from
(
select a.cn,a.transaction_date,a.nte,a.soku,a.ftp_prod,a.product_code,a.khoi,a.sodu_goc,a.sodu_dp,a.term,a.vung_mien,b.term_id,a.makh,a.ls,a.hoten from
(
select 'VN0010001' cn,a.transaction_date,a.nte,a.acc soku,'TD403' ftp_prod,a.product_code,'NHS' khoi,a.sodu sodu_goc,
--nvl(b.dp_cuthe_ftp_luyke,0) sodu_dp,
nvl(b.dp_cuthe_ftp,0) sodu_dp,
c.term,d.vung_mien,a.makh,a.ls, e.hoten from etl.int_ftp_tr_tg_viettel a--apps.tr_tg a

--da thay doi, mapping du phong theo ngay, k phai mapping voi ngay cuoi thang
left join apps.mb_tr_ku_dp b
on a.acc = b.soku
and b.transaction_date = a.transaction_date
left join (select date_tx,ccy, ceil(sum(time_payment)/12) term
 from  apps.FTP_RESULT_thauchi_FINAL
group by date_tx,ccy) c
on a.nte = c.ccy
and c.date_tx = add_months(trunc(a.transaction_date,'MONTH'),-1) -1
left join apps.ftp_dic_vungmien_khuvuc d
on 'VN0010001'= d.cn_cap_2
left join etl.tmp_toi_khachhang e--apps.tr_khachhang e
on nvl(a.makh,'-1') = e.makh
where a.transaction_Date = to_date(${PRD_ID},'yyyyMMdd') and a.acc = '9994100052006'
--and a.soku = '6600101347008'
) a
left join apps.ftp_dic_map_term b
on round(a.term) >= b.from_day
and round(a.term) &lt;= b.to_day
and a.nte = b.curr_id) a
)
A 
Left join (
     SELECT /*+ materialize */  *
      FROM apps.FTP_DIC_PHUTROI A
      WHERE A.DATE_APPLY =
      (
            SELECT MAX(DATE_APPLY)
            FROM apps.FTP_DIC_PHUTROI B
            WHERE B.CURRENCY = A.CURRENCY
            AND B.TERM = A.TERM
            AND B.DATE_APPLY &lt;=
            to_date('${PRD_ID}', 'yyyyMMdd')
      )
)C
on C.CURRENCY = A.nte AND C.TERM = a.term_id
LEFT JOIN etl.tmp_FTP_DIC_DIEUCHINH_ALCO B
                             ON B.FTP_PRODUCT = A.ftp_prod
                               AND B.KHOI = A.KHOI
                               AND B.VUNG_MIEN = 'HANOI'--A.VUNG_MIEN
                               AND B.CURRENCY = A.nte
                               AND B.TERM = a.term_id
                               AND B.DATE_APPLY = a.ngay_dc_alco
--left join apps.ftp_dic_line_mapping g
left join apps.ftp_mapping_toi g
on a.ftp_prod = g.ftp_prod
and a.khoi =g.khoi</sql>
