    <connection>tckt_dc</connection>
    <sql>select a.cn,a.transaction_date,a.nte,a.soku,a.makh,a.ls, a.hoten,a.ftp_prod,a.product_code,a.mb_per,a.khoi,a.y_gia_hddb,-1* a.sodu sodu,a.sodu_dp,
a.ngaydh,a.ngayvay,a.ngay_golive,a.interest_type,source_of_fund,-- in ('7','8','9')
a.ngay_tdls_goc,a.ngay_tdls,a.term_ftp,a.term_goc,a.term_dn,a.vung_mien,
nvl(ftp_base_amount,0) ftp_base_amount,
a.y_pttk pttk_goc,
--case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end ftp_phutroi_amount,
case when a.term_goc in ('84M','120M','180M','RE') then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end ftp_phutroi_amount,
--nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) ftp_phutroi_amount, 
nvl(b.amount,0) ftp_dc_alco,
nvl(tk_amount,0) ftp_chiphi_tk,
nvl(dtbb_cp_dtbb,0) ftp_chiphi_dtbb,
nvl(bhtg_tile_bhtg,0) ftp_chiphi_bhtg,
-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
-sodu_dp sodu_ftp,
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
-sodu_dp)*
(nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0))/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) 
ftp_tdc,
--sua lai ngay 11/1
case when a.y_gia_hddb is not null then 0 else
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
- sodu_dp) * (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) 
end 
ftp_sdc,
case when a.y_gia_hddb is not null then a.y_gia_hddb*
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
-sodu_dp)/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) else 0 end ftp_hddb,
--tinh sdc cho tat ca
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
- sodu_dp) * (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) 
ftp_sdc_apply_all,
biendo_khoi,biendo_sanpham,biendo_vungmien,
case when a.y_gia_hddb is not null then 0 else
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
- sodu_dp) * (nvl(b.biendo_khoi,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) 
end 
ftp_sdc_biendo_khoi,
case when a.y_gia_hddb is not null then 0 else
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
- sodu_dp) * (nvl(b.biendo_sanpham,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) 
end 
ftp_sdc_biendo_sanpham,
case when a.y_gia_hddb is not null then 0 else
(-1*a.sodu* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)
- sodu_dp) * (nvl(b.biendo_vungmien,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end) 
end 
ftp_sdc_biendo_vungmien, g.ftp_line, g.ftp_category
FROM
(
select a.*,
--nvl(tk.amount,0)+nvl(dtbb.cp_dtbb,0)+nvl(bhtg.tile_bhtg,0)
(SELECT bhtg.tile_bhtg
                      FROM apps.ftp_dic_chiphi_bhtg bhtg
                     WHERE bhtg.ccy = a.nte and bhtg.date_tx =
                           (SELECT MAX(date_tx)
                              FROM apps.ftp_dic_chiphi_bhtg bhtg_m
                             WHERE bhtg_m.ccy = a.nte
                             and bhtg_m.date_tx >= to_date('20160118','yyyyMMdd')
                               AND bhtg_m.date_tx &lt;=trunc(a.ngay_tdls,'MONTH')-1)) bhtg_tile_bhtg,
(SELECT dtbb.cp_dtbb 
                      FROM apps.ftp_dic_chiphi_dtbb dtbb
                     WHERE dtbb.ccy = a.nte and dtbb.date_tx =
                           (SELECT MAX(date_tx)
                              FROM apps.ftp_dic_chiphi_dtbb dtbb_m
                             WHERE dtbb_m.ccy = a.nte         
                             and dtbb_m.date_tx >= to_date('20160118','yyyyMMdd')                 
                               AND dtbb_m.date_tx &lt;=trunc(a.ngay_tdls,'MONTH')-1)) dtbb_cp_dtbb,
(SELECT tk.amount
                      FROM apps.ftp_dic_chiphi_tk tk
                     WHERE tk.currency = a.nte and tk.date_apply =
                           (SELECT MAX(date_apply)
                              FROM apps.ftp_dic_chiphi_tk tk_m
                             WHERE tk_m.currency = a.nte
                             and tk_m.date_apply >= to_date('20160118','yyyyMMdd') 
                               AND tk_m.date_apply &lt;= trunc(a.ngay_tdls,'MONTH')
                               )) tk_amount,
--
(SELECT pttk.amount
                      FROM apps.ftp_dic_phutroi pttk
                     WHERE pttk.currency = a.nte 
                     AND pttk.term = a.term_goc
                     and pttk.date_apply =
                           (SELECT MAX(date_apply)
                              FROM apps.ftp_dic_phutroi pttk_m
                           WHERE a.nte = pttk_m.Currency
                            AND a.term_goc = pttk_m.term
                            AND a.ngayvay >= pttk_m.date_apply  
                               )) ftp_phutroi_amount,
--
(SELECT ftp_base.amount
                      FROM apps.ftp_dic_ftp_base ftp_base
                     WHERE ftp_base.currency = a.nte 
                     AND ftp_base.term = trim(a.term_ftp)
                     and ftp_base.date_apply =
                           (SELECT MAX(date_apply)
                              FROM apps.ftp_dic_ftp_base ftp_base_m
                           WHERE a.nte = ftp_base_m.Currency
                            AND trim(a.term_ftp) = ftp_base_m.term
                            AND a.ngay_tdls >= ftp_base_m.date_apply  
                               )) ftp_base_amount,
nvl((SELECT MAX(date_apply) ngay_dc_alco
                              FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                             WHERE B.FTP_PRODUCT = A.ftp_prod
                               AND B.KHOI = A.KHOI
                               AND B.VUNG_MIEN = 'HANOI'--A.VUNG_MIEN
                               AND B.CURRENCY = A.nte
                               AND B.TERM = trim(a.term_ftp)
                               AND B.DATE_APPLY &lt;= a.ngay_tdls 
                               ),to_date('20160118','yyyyMMdd')) ngay_dc_alco
                            
                               
from
(
select  a.cn,a.transaction_date,a.nte,a.soku,
-- them phan lay ma ftp td452 voi ma upaslc
case 
	when (A.y_category='21065' and A.sub_product in (184,186)) then 'TD452'
	else 'TD561' 
end ftp_prod,
a.product_code,
--to_number(a.mb_per) mb_per,
--case when a.mb_per is not null then to_number(a.mb_per) end mb_per,
a.mb_per,
a.y_khoi khoi,
--nvl(a.y_gia_hddb,hddb.gia_hddb) y_gia_hddb ,
a.y_gia_hddb,
--ftp nho hon 0 thi de bang 0
a.sodu,
nvl(dp.dp_cuthe_ftp,0) sodu_dp,
to_date(tdls_daqua,'yyyyMMdd') ngay_tdls_goc,
case when interest_type = '1' or ftp_prod= 'TD302' 
then a.ngayvay else nvl(to_date(tdls_daqua,'yyyyMMdd'),a.ngayvay) end ngay_tdls,
a.ngaydh,a.ngayvay,to_date('20160118','yyyyMMdd') ngay_golive,a.interest_type,source_of_fund ,--in ('7','8','9')
case when interest_type = '1' then b.term_id else nvl(Y_TS_TDLS,b.term_id) end term_ftp,
b.term_id term_goc,b1.term_id term_dn,c.vung_mien,
case when apps.is_number(a.y_pttk)=1 then to_number(a.y_pttk) else 0 end y_pttk ,a.makh,a.ls, '' hoten from etl.ftp_int_tienvay a
/*left join tr_khachhang kh 
on a.makh = kh.makh*/
left join apps.mb_tr_ku_dp dp
on a.soku = dp.soku
and dp.transaction_date = a.transaction_date
left join apps.ftp_dic_map_term b
on a.ngaydh- greatest(a.ngayvay,to_date('20160118','yyyyMMdd')) >= b.from_day
and a.ngaydh - greatest(a.ngayvay,to_date('20160118','yyyyMMdd')) &lt;= b.to_day
and a.nte = b.curr_id
left join apps.ftp_dic_map_term b1
on a.ngaydh- a.ngayvay >= b1.from_day
and a.ngaydh - a.ngayvay &lt;= b1.to_day
and a.nte = b1.curr_id
left join apps.ftp_dic_vungmien_khuvuc c
on a.cn= c.cn_cap_2
where a.transaction_date = to_date(${PRD_ID},'yyyyMMdd')
--and substr(a.gl,1,1) = 2 and substr(a.gl,1,2) &lt;&gt; '20' and  a.soku like 'LD%'
and a.gl= '3592' and a.soku like 'LD%'
)
a)A LEFT JOIN apps.FTP_DIC_DIEUCHINH_ALCO B
                             ON B.FTP_PRODUCT = A.ftp_prod
                               AND B.KHOI = A.KHOI
                               AND B.VUNG_MIEN = 'HANOI'--A.VUNG_MIEN
                               AND B.CURRENCY = A.nte
                               AND B.TERM = trim(a.term_ftp)
                               AND B.DATE_APPLY = a.ngay_dc_alco
--left join apps.ftp_dic_line_mapping g
left join apps.ftp_mapping_toi g
on a.ftp_prod = g.ftp_prod
and a.khoi =g.khoi</sql>
