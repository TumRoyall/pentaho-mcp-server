    <connection>tckt_dc</connection>
    <sql>select a.cn,a.transaction_date,a.nte,a.soku,a.makh,a.ls, '' hoten,a.ftp_prod,a.product_code,a.mb_per,a.khoi,a.y_gia_hddb,-1* a.sodu sodu,a.sodu_dp,
a.ngaydh,a.ngayvay,a.ngay_golive,a.interest_type,source_of_fund,-- in ('7','8','9')
a.ngay_tdls_goc,a.ngay_tdls,a.term_ftp,a.term_goc,a.term_dn,a.vung_mien,
nvl(ftp_base_amount,0) ftp_base_amount,
a.y_pttk pttk_goc,
case when a.term_goc in ('84M','120M','180M','RE') then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end ftp_phutroi_amount,
--nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) ftp_phutroi_amount, 
nvl(b.amount,0) ftp_dc_alco,
nvl(tk_amount,0) ftp_chiphi_tk,
nvl(dtbb_cp_dtbb,0) ftp_chiphi_dtbb,
nvl(bhtg_tile_bhtg,0) ftp_chiphi_bhtg,
(-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end) sodu_ftp,
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end))*
(nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0))/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  
ftp_tdc,

--sua lai ngay 11/1
case when a.y_gia_hddb is not null then 0 else
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)) * (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  
end 
ftp_sdc,

--lynt6 Them truong ftp_rate phuc vu Chinh sua FTP cho san pham cho vay du an KHCN
--nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) ftp_rate,
case when a.FTP_PROD = 'TD572' and  NGAYVAY  = NGAY_TDLS and NGAY_TDLS >= '3apr23' and NGAY_TDLS&lt;= '11jun23' then 
          (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)) - 0.8
      when a.FTP_PROD = 'TD572' and  NGAYVAY  = NGAY_TDLS and NGAY_TDLS >= '1jul22' and NGAY_TDLS&lt; '3apr23' then 
           (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0)) - 1.29
	else (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0))
end ftp_rate,
case when a.y_gia_hddb is not null then a.y_gia_hddb*
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end))/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  else 0 end ftp_hddb,
--tinh sdc cho tat ca
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)) * (nvl(ftp_base_amount,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  
ftp_sdc_apply_all,
biendo_khoi,biendo_sanpham,biendo_vungmien,
case when a.y_gia_hddb is not null then 0 else
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)) * (nvl(b.biendo_khoi,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  
end 
ftp_sdc_biendo_khoi,
case when a.y_gia_hddb is not null then 0 else
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)) * (nvl(b.biendo_sanpham,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  
end 
ftp_sdc_biendo_sanpham,
case when a.y_gia_hddb is not null then 0 else
((-1*a.sodu-sodu_dp)* 
(case when source_of_fund in (select source_of_fund from APPS.FTP_SOURCE_OF_FUND) then nvl(mb_per,100)/100 else 1 end)) * (nvl(b.biendo_vungmien,0)+ case when a.term_goc = 'RE' then nvl(ftp_phutroi_amount,0) else nvl(a.y_pttk,nvl(ftp_phutroi_amount,0)) end+nvl(b.amount,0)+nvl(tk_amount,0)+nvl(dtbb_cp_dtbb,0)+nvl(bhtg_tile_bhtg,0) )/(case when a.ngay_tdls>='1-jan-2018' then 36500 else 36000 end)  
end 
ftp_sdc_biendo_vungmien, g.ftp_line, g.ftp_category
,a.ftp_fix,
a.ngay_hddb,
a.origin_y_gia_hddb
from etl.etl_ftp_precal_tienvay_tmp2 a
join etl.etl_ftp_precal_tienvay_tmp3 c
on  a.soku= c.soku
left join apps.FTP_DIC_DIEUCHINH_ALCO b
on nvl(c.date_apply,'18-jan-2016')= b.date_apply
and b.FTP_PRODUCT = A.ftp_prod
                               AND b.KHOI = A.KHOI
                               AND b.VUNG_MIEN = 'HANOI'--A.VUNG_MIEN
                               AND b.CURRENCY = A.nte
                               AND b.TERM = trim(a.term_ftp)
--left join apps.ftp_dic_line_mapping g
left join apps.ftp_mapping_toi g
on a.ftp_prod = g.ftp_prod
and a.khoi =g.khoi
where a.transaction_Date= to_date(${PRD_ID},'yyyyMMdd')</sql>
