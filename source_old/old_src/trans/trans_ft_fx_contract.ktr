  <step>
    <name>FX_BAL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>select 
	A.TXN_DATE 
	,A.ARRANGEMENT_NBR
	,A.DEAL_TYPE
	,'FX_DEALS' EXPR_IMPR
	,case when a.SELL_CURRENCY_CODE = 'VND' /*and a.BUY_CURRENCY_CODE = 'USD'*/ then a.BUY_CURRENCY_CODE
		when a.BUY_CURRENCY_CODE ='VND' /*and a.SELL_CURRENCY_CODE = 'USD'*/ then a.SELL_CURRENCY_CODE
		/*when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE not in ('USD', 'VND') then a.BUY_CURRENCY_CODE
		when a.BUY_CURRENCY_CODE = 'VND' and a.SELL_CURRENCY_CODE not in ('USD', 'VND') then a.SELL_CURRENCY_CODE*/
		when a.BUY_CURRENCY_CODE &lt;&gt; 'VND' and a.SELL_CURRENCY_CODE &lt;&gt; 'VND' then a.BUY_CURRENCY_CODE end CURRENCY_CODE
	,A.DIVISION_CODE
	,case
		when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE = 'USD' then a.BUY_AMT
		when a.BUY_CURRENCY_CODE ='VND' and a.SELL_CURRENCY_CODE = 'USD' then a.SELL_AMT
		when a.SELL_CURRENCY_CODE = 'VND' and a.BUY_CURRENCY_CODE not in ('USD', 'VND') then a.BUY_AMT * nvl(r1.RVAL_RATE, 1) /nvl(r2.RVAL_RATE, 1)
		when a.BUY_CURRENCY_CODE = 'VND' and a.SELL_CURRENCY_CODE not in ('USD', 'VND') then a.SELL_AMT * nvl(r3.RVAL_RATE, 1) / nvl(r2.RVAL_RATE, 1)
		when a.BUY_CURRENCY_CODE &lt;&gt; 'VND' and a.SELL_CURRENCY_CODE &lt;&gt; 'VND' then 2*a.BUY_AMT * nvl(r1.RVAL_RATE, 1) /nvl(r2.RVAL_RATE, 1)
	else 0 end USD_AMT
	,A.T24_CUST_ID
	,A.BRANCH_CODE
	,A.RELATED_EB_TXN_CODE
from SMY.FX_BAL A
LEFT JOIN smy.exchange_rate_daily r1 on r1.exchange_rate_date = a.DEAL_DATE
	and r1.FROM_CURRENCY_CODE = a.BUY_CURRENCY_CODE
	and r1.TO_CURRENCY_CODE = 'VND'
left join smy.exchange_rate_daily r2 on r2.exchange_rate_date = a.DEAL_DATE
	and r2.TO_CURRENCY_CODE = 'VND'
	and r2.FROM_CURRENCY_CODE = 'USD'
left join smy.exchange_rate_daily r3 on r3.exchange_rate_date = a.DEAL_DATE
	AND r3.FROM_CURRENCY_CODE = a.SELL_CURRENCY_CODE
	AND r3.TO_CURRENCY_CODE = 'VND'
WHERE a.TXN_DATE = to_date('${PRD_ID}','YYYYMMDD')
and T24_CUST_ID not in ('999999')
and a.txn_date=a.deal_date</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
