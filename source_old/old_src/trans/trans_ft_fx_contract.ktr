    <name>TF_BAL_MTH 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>WITH MAP_FX AS
  (SELECT 
	ARRANGEMENT_NBR,
	T24_CUST_ID,
	RELATED_EB_TXN_CODE,
	F2B_ARRANGEMENT_NBR,
	ROW_NUMBER () OVER (PARTITION BY A.RELATED_EB_TXN_CODE,T24_CUST_ID  ORDER BY A.RELATED_EB_TXN_CODE DESC) RANK_NUM
  FROM SMY.FX_BAL A
  WHERE TXN_DATE BETWEEN TRUNC (TO_DATE ('${PRD_ID}','YYYYMMDD'), 'MONTH') AND TO_DATE('${PRD_ID}','YYYYMMDD')
  GROUP BY 
	ARRANGEMENT_NBR,
	T24_CUST_ID,
	RELATED_EB_TXN_CODE,
	F2B_ARRANGEMENT_NBR)
	select 
		TO_DATE ('${PRD_ID}','YYYYMMDD') TXN_DATE
		,ARRANGEMENT_NBR
		,T24_CUST_ID
		,RELATED_EB_TXN_CODE
		,F2B_ARRANGEMENT_NBR
	FROM MAP_FX A
	Where RANK_NUM =  1</sql>
