  <step>
    <name>FX_BAL 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>select 
	FX_BAL_ID
	,LAST_DAY(TXN_DATE) TXN_DATE
	,ARRANGEMENT_NBR
	,DEAL_TYPE
	,DEAL_DATE
	,BUY_VALUE_DATE
	,BASE_CURRENCY_CODE
	,BUY_CURRENCY_CODE
	,BUY_AMT
	,BUY_LCY_AMT
	,SELL_CURRENCY_CODE
	,SELL_AMT
	,SELL_LCY_AMT
	,ARRANGEMENT_STATUS_CODE
	,SPOT_EXCHANGE_RATE
	,FWD_EXCHANGE_RATE
	,BRANCH_CODE
	,PARTY_KEY
	,T24_CUST_ID
	,PARTY_FULL_NAME
	,DIVISION_CODE
	,RM_CODE
	,CROSS_SELL_RM_CODE
	,SECTOR_CODE
	,CATE_CODE
	,PRODUCT_CODE
	,PAYMENT_ACCOUNT_NBR
	,RECEIVE_ACCOUNT_NBR
	,F2B_ARRANGEMENT_NBR
	,FX_DESC
	,ADD_INFO
	,RELATED_TXN_NBR
	,RELATED_EB_TXN_CODE
	,CREATED_BY
	,CREATION_DATE
	,LAST_UPDATED_BY
	,LAST_UPDATE_DATE
	,ARRANGEMENT_RM_CODE
from SMY.FX_BAL
where TXN_date = 
(select max (CALENDAR_DATE) from ODS.DATES_REF
where CALENDAR_DATE &lt;= to_date ('${PRD_ID}', 'YYYYMMDD')
and WORKING_DATE_IND = 'W')
</sql>
