	,ORIG_SELL_VALUE_DATE
	,BUY_INT_RATE
	,SELL_INT_RATE
	,PAYMENT_ACCOUNT_NBR
	,RECEIVE_ACCOUNT_NBR
	,ARRANGEMENT_STATUS_CODE
	,RM_ID
	,INPUTTER
	,COMMIT_DATE_TIME
	,AUTHORISER
	,AUTH_DEPT_CODE
	,AUTH_DATE_TIME
	,LIMIT_CODE
	,CREATED_BY
	,CREATION_DATE
	,LAST_UPDATED_BY
	,LAST_UPDATE_DATE
, product_code
, f2b_arrangement_nbr
FROM ODS.FX_CONTRACT</sql>
