    <sql>--ODS
/*select 
APP_KEY BPM_ID
,BRANCH_CODE
,PARTY_KEY T24_CUST_ID
,LC_NBR CREDIT_LETTER_NBR
,TF_NBR ARRANGEMENT_NBR
,APP_CREATED_DATE CREATED_DATE
,APP_CREATED_BY INIT_SYSTEM_CODE
 from ODS.APP_IMPR_LC a
  where upper (a.TASK_STATUS) NOT IN ('ABORTED') 
  and a.APP_PROCESS_KEY = '2'
  and upper (a.INIT_SYSTEM_CODE) = 'BIZ'

*/
select 
BPM_ID
,branch_id BRANCH_CODE
,t24_code T24_CUST_ID
,lc_number CREDIT_LETTER_NBR
,tf_number ARRANGEMENT_NBR
,created_time CREATED_DATE
,created_by_system INIT_SYSTEM_CODE
from bpmlc.BPM_LCNK a
where upper (a.STATUS) NOT IN ('ABORTED')
and a.process_id = '2'
and upper (a.created_by_system) = 'BIZ'</sql>
