    <connection>ods_dc</connection>
    <sql>select 
b.FT_NBR
,c.INIT_SYSTEM_CODE SOURCE_REQUEST
,b.APP_CREATED_DATE TXN_DATE
FROM ODS.APP_RT_OUTWARD a
  LEFT JOIN ODS.SUB_APP_RT_OUTWARD b ON a.APP_KEY = b.APP_KEY
  LEFT JOIN ODS.APP_RT c ON a.APP_KEY = c.APP_KEY
  where c.INIT_SYSTEM_CODE in ('APP', 'BIZ')
  and b.FT_NBR is not null
</sql>
