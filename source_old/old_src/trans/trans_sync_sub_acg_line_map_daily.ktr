  <step>
    <name>Source BDSD nội mạng Viettel</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with t1 as (
  select
    last_day(add_months(a.transaction_date, 1)) transaction_date ,
    a.receiver_id,
    a.sotk stk,
    a.makh ma_kh,
    a.nha_cung_cap,
    a.telco,
    a.source_app_id,
    a.msg_type,
    a.msg_type_2,
    a.soluong,
    a.total_mess_short,
    a.msg_type_desc,
    a.gtgd,
    a.Nhom_level_1,
    a.Nhom_level_2,
    c.maphi,
    c.SOTIEN TONG_CP_THEO_MAPHI
  from
    apps.FIN_SMS_SMY_MONTHLY a
    left join etl.file_tmp_chg_sms c on a.NHA_CUNG_CAP = c.NHA_CUNG_CAP
    and decode(a.telco, 'VIETTEL', a.telco, 'OTHER') = c.TELCO
    and case
      when a.NHA_CUNG_CAP = 'VIETTEL'
      and a.telco = 'VIETTEL'
      and a.Nhom_level_1 = 'BDSD' then 'BDSD'
      else 'OTHER'
    end = c.Nhom_level_1
  where
    a.Nhom_level_1 not in ('BDSD VTPay', 'OTP VTPay')
    and a.transaction_date = last_day(add_months(to_date('${PRD_ID}', 'YYYYMMDD'), -1))
)
select
  t1.*,
  TONG_CP_THEO_MAPHI /(
    select
      count(distinct receiver_id)
    from
      t1
    where
      nha_cung_cap = 'VIETTEL'
      and telco = 'VIETTEL'
      and Nhom_level_1 = 'BDSD'
  ) / a.sl_line CHIPHI_PHANBO,
  'VN0010001' CN,
  '15911' product_code,
  '68293' PL
from
  t1
  left join (
    select
      receiver_id,
      count(1) sl_line
    from
      t1
    where
      nha_cung_cap = 'VIETTEL'
      and telco = 'VIETTEL'
      and Nhom_level_1 = 'BDSD'
    group by
      receiver_id
  ) a on t1.receiver_id = a.receiver_id
where
  t1.nha_cung_cap = 'VIETTEL'
  and t1.telco = 'VIETTEL'
  and t1.Nhom_level_1 = 'BDSD'
</sql>
