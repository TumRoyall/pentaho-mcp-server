    <connection>ods_dc</connection>
    <sql>select * from smy.sub_acg_line_map_daily
where txn_date = (
SELECT max(calendar_date) FROM
    ods.dates_ref
    where calendar_date &lt;= to_date('${PRD_ID}','YYYYMMDD')
    and WORKING_DATE_IND = 'W'
)</sql>
