  <step>
    <name>ETL.CD_ONLINE_CHIASE_SOCAP (OFF)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--b) Input 2: CDs Online sau chia s?
SELECT a.transaction_date 
    , CI_CONTRACT sotk
	, NULL chg_code
    , NULL makh
    , NULL khoi_kh
    , 'VN0010001' cn 
    , '12912' product_code 
    , 'NHS' KHOI_TRUOCCHIASE 
    , a.REPORT_ITEM_CODE CHITIEU_PLKHOI 
    , a.REPORT_ITEM_NAME CHITIEU_PLKHOI_NAME 
    , 'CD ONLINE' SPSO_TYPE 
    , 'E2E' PRODUCT_TYPE 
    , sum(nvl(lcy_amt,0) * nvl(b.TYLE_CHIASE,1)) AMT_SAUCHIASE
    , b.KHOI_NHANCHIASE KHOI_SAUCHIASE 
    , NULL PHAN_KHUC 
    , NULL CUS_STATUS 
    , NULL APP_BIZ_STATUS 
    , 'VN0010001' TEN_CN 
    , 'VN0010001' CNC1 
    , 'VN0010001' TEN_CNC1 
    , NVL(to_number(b.TYLE_CHIASE), 1) TYLE_CHIASE
    , 'ETL.CD_ONLINE_CHIASE_SOCAP' SOURCE_TABLE
    , GL_LINE LINEGL 
    , NULL PLCATEGORY 
    , FTP_CODE FTP_CODE 
    , NULL DIGITAL_SERVICE_LV1 
    , NULL DIGITAL_SERVICE_LV2 
    , NULL SERVICE_PARTNER 
    , NULL SERVICE_TELECOM
FROM ETL.CD_ONLINE_CHIASE_SOCAP a
LEFT JOIN APPS.REF_SPSO_TYLECHIASE_MAP b ON a.REPORT_ITEM_CODE = b.REPORT_ITEM_CODE AND a.khoi = 
    b.khoi_chiase
WHERE a.khoi &lt;&gt; 'NHS'
GROUP BY a.transaction_date,
	CI_CONTRACT,
    a.REPORT_ITEM_CODE,
    a.REPORT_ITEM_NAME,
	b.KHOI_NHANCHIASE,
    NVL(to_number(b.TYLE_CHIASE), 1),
	GL_LINE,
	FTP_CODE
 </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
