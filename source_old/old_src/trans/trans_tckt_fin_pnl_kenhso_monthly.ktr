  </step>
  <step>
    <name>etl.TMP_F2B_PNL_FX</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--c)	Input 3: FX sau chia sẻ
SELECT a.TRANS_DATE TRANSACTION_DATE,
	a.dealid sotk,
	NULL chg_code,
	to_Char(a.cus_id) makh,
      c.khoi khoi_kh,
	a.co_code cn,
	a.PRODUCT_CODE,
	'TRE' KHOI_TRUOCCHIASE,
	'A3' CHITIEU_PLKHOI,
    'THU KDNT' CHITIEU_PLKHOI_NAME,
    'KDNT' SPSO_TYPE,
    'E2E' product_type,
    sum(CASE
	    WHEN KHOI_TCS = 'INDIV' THEN
	    	CASE
		        WHEN KHOI_SCS = 'INDIV' THEN AMOUNT*0.56
		        WHEN KHOI_SCS = 'NHS' THEN AMOUNT*0.2
		        WHEN KHOI_SCS = 'TRE' THEN AMOUNT*0.24
	        END
        ELSE CASE
        		WHEN KHOI_SCS = 'TRE' THEN AMOUNT*0.3
        		ELSE AMOUNT*0.7
        	END
    END) AMT_SAUCHIASE,
    KHOI_SCS KHOI_SAUCHIASE,
    c.PHAN_KHUC,
    c.CUS_STATUS,
    c.APP_BIZ_STATUS,
    d.BRANCH_NAME_T24 TEN_CN,
    d.PARENT_BRANCH_CODE_T24 CNC1,
    d.PARENT_BRANCH_NAME_T24 TEN_CNC1,
    to_number(CASE
	    WHEN KHOI_TCS = 'INDIV' THEN
	    	CASE
		        WHEN KHOI_SCS = 'INDIV' THEN 0.56
		        WHEN KHOI_SCS = 'NHS' THEN 0.2
		        WHEN KHOI_SCS = 'TRE' THEN 0.24
	        END
        ELSE CASE
        		WHEN KHOI_SCS = 'TRE' THEN 0.3
        		ELSE 0.7
        	END
    END) TYLE_CHIASE,
    'ETL.TMP_F2B_PNL_FX' SOURCE_TABLE
FROM
	(SELECT TRANS_DATE, DEALID, CUS_ID, KHOI KHOI_SCS, KHOI KHOI_TCS, CO_CODE, PRODUCT_CODE, AMOUNT FROM etl.TMP_F2B_PNL_FX
	WHERE PHAN_LOAI = 'KENHSO'
	UNION ALL
	SELECT TRANS_DATE, DEALID, CUS_ID, 'NHS' KHOI_SCS, KHOI KHOI_TCS, CO_CODE, PRODUCT_CODE, AMOUNT FROM etl.TMP_F2B_PNL_FX 
	WHERE khoi = 'INDIV'
	AND PHAN_LOAI = 'KENHSO'
	UNION ALL 
	SELECT TRANS_DATE, DEALID, CUS_ID, 'TRE' KHOI_SCS, KHOI KHOI_TCS, CO_CODE, PRODUCT_CODE, AMOUNT FROM etl.TMP_F2B_PNL_FX 
	WHERE PHAN_LOAI = 'KENHSO') a
left join ETL.ORS_MB_PRODUCT_CODE b
	on a.PRODUCT_CODE = b.PRODUCT_CODE
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY c
	ON a.cus_id = c.MAKH
	AND c.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
LEFT JOIN etl.REF_AICT_BRANCH_M d
	ON a.co_code = d.BRANCH_CODE_T24 AND d.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
GROUP BY a.TRANS_DATE,
	a.dealid,
	a.cus_id,
	a.co_code,
	a.PRODUCT_CODE,
	KHOI_SCS,
    c.khoi,
    c.PHAN_KHUC,
    c.CUS_STATUS,
    c.APP_BIZ_STATUS,
    d.BRANCH_NAME_T24,
    d.PARENT_BRANCH_CODE_T24,
    d.PARENT_BRANCH_NAME_T24,
    to_number(CASE
	    WHEN KHOI_TCS = 'INDIV' THEN
	    	CASE
		        WHEN KHOI_SCS = 'INDIV' THEN 0.56
		        WHEN KHOI_SCS = 'NHS' THEN 0.2
		        WHEN KHOI_SCS = 'TRE' THEN 0.24
	        END
        ELSE CASE
        		WHEN KHOI_SCS = 'TRE' THEN 0.3
        		ELSE 0.7
        	END
    END)
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
