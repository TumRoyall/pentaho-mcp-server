  </step>
  <step>
    <name>Bảo lãnh SPSO lẫn vào line SPTT 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT a.transaction_date,
	a.makh,
	a.ma_cn cn,
	a.PRODUCT_CODE,
	a.KHOI_PLKHOI KHOI_TRUOCCHIASE,
	a.CHITIEU_PLKHOI,
	a.CHITIEU_PLKHOI_NAME,
	'BAO LANH' SPSO_TYPE,
	CASE
		WHEN b.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
		WHEN b.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
	END product_type,
	sum(TIENNO_VND) AMT_SAUCHIASE,
	a.KHOI_PLKHOI KHOI_SAUCHIASE,
	c.PHAN_KHUC,
	c.cus_status,
	c.APP_BIZ_STATUS,
	d.BRANCH_NAME_T24 TEN_CN,
    d.PARENT_BRANCH_CODE_T24 CNC1,
    d.PARENT_BRANCH_NAME_T24 TEN_CNC1,
	1 tyle_chiase,
	a.SCT sotk,
	a.CHG_CODE,
	c.KHOI khoi_kh,
	'DC' source_table,
	a.linegl,
	a.ACCTNBR PLCATEGORY,
   	NULL FTP_CODE,
	e.DIGITAL_SERVICE_LV1,
	e.DIGITAL_SERVICE_LV2,
	e.SERVICE_PARTNER,
	e.SERVICE_TELECOM
FROM etl.TMP_TOI_SOURCE_INPUT a
LEFT JOIN etl.ORS_MB_PRODUCT_CODE b
	ON a.PRODUCT_CODE = b.PRODUCT_CODE
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY c
	ON a.makh = c.makh
	AND c.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
LEFT JOIN etl.REF_AICT_BRANCH_M d
	ON a.MA_CN = d.BRANCH_CODE_T24 AND d.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
LEFT JOIN APPS.REF_DIGITAL_CHG_CODE_MAP e
   ON a.chg_code = e.chg_code
WHERE a.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
	AND a.CHITIEU_PLKHOI_NAME = '1.1. Thu thuan dich vu bao lanh SP thong thuong'
	AND b.SP_DV IN ('SPS1', 'SPSO', 'DVS1', 'DVSO', 'SPS2', 'DVS2')
GROUP BY a.TRANSACTION_DATE,
	a.makh,
	a.ma_cn,
	a.PRODUCT_CODE,
	a.KHOI_PLKHOI,
	a.CHITIEU_PLKHOI,
	a.CHITIEU_PLKHOI_NAME,
	'BAO LANH',
	CASE
		WHEN b.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
		WHEN b.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
	END,
	a.KHOI_PLKHOI,
	c.PHAN_KHUC,
	c.cus_status,
	c.APP_BIZ_STATUS,
	d.BRANCH_NAME_T24,
    d.PARENT_BRANCH_CODE_T24,
    d.PARENT_BRANCH_NAME_T24,
	a.SCT,
	a.CHG_CODE,
	c.KHOI,
	a.LINEGL,
	a.ACCTNBR,
	e.DIGITAL_SERVICE_LV1,
	e.DIGITAL_SERVICE_LV2,
	e.SERVICE_PARTNER,
	e.SERVICE_TELECOM
</sql>
