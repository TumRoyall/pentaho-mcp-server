  </step>
  <step>
    <name>ETL.TMP_PNL_KENHSO_MONTHLY 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--a) Input 1: ETL.TMP_PNL_KENHSO_MONTHLY th?c hi?n chia s? ko g?m CD
SELECT a.TRANSACTION_DATE 
    , CASE 
  WHEN UPPER(a.SPSO_TYPE) NOT IN ('THE','DICH VU','BANCA') THEN a.SOTK
  ELSE NULL
 END sotk
 , a.CHG_CODE
    , a.MAKH
    , a.khoi khoi_kh 
    , a.cn 
    , a.PRODUCT_CODE 
    , a.KHOI_THEOPLKHOI KHOI_TRUOCCHIASE 
    , a.CHITIEU_PLKHOI 
    , a.CHITIEU_PLKHOI_NAME 
    , a.SPSO_TYPE 
    , nvl(c.DIGI_LEVEL_FLAG, a.PRODUCT_TYPE) PRODUCT_TYPE
    , sum(a.LCY_AMT * nvl(b.TYLE_CHIASE,1)) AMT_SAUCHIASE
    , nvl(b.KHOI_NHANCHIASE, a.KHOI_THEOPLKHOI) KHOI_SAUCHIASE 
    , a.PHAN_KHUC 
    , a.CUS_STATUS 
    , a.APP_BIZ_STATUS 
    , a.TEN_CN 
    , a.CNC1 
    , a.TEN_CNC1 
    , NVL(to_number(b.TYLE_CHIASE), 1) TYLE_CHIASE
    , 'ETL.TMP_PNL_KENHSO_MONTHLY' SOURCE_TABLE
    , a.LINEGL 
    , a.PLCATEGORY 
    , a.FTP_CODE 
    , a.DIGITAL_SERVICE_LV1 
    , a.DIGITAL_SERVICE_LV2 
    , a.SERVICE_PARTNER 
    , a.SERVICE_TELECOM
FROM ETL.TMP_PNL_KENHSO_MONTHLY a
LEFT JOIN APPS.REF_SPSO_TYLECHIASE_MAP b ON a.CHITIEU_PLKHOI = b.REPORT_ITEM_CODE AND 
    a.KHOI_THEOPLKHOI = b.KHOI_CHIASE
LEFT JOIN (
    SELECT 
        CASE
            WHEN ARRANGEMENT_NBR LIKE
            'PDLD%' THEN substr(ARRANGEMENT_NBR, 1, 14)
            ELSE ARRANGEMENT_NBR
        END ARRANGEMENT_NBR,
        DIGI_LEVEL_FLAG
    FROM ETL.ODS_LOAN_BAL_MTH
    WHERE txn_date = to_date(${PRD_ID},
    'YYYYMMDD')
    GROUP BY 
        CASE
            WHEN ARRANGEMENT_NBR LIKE
            'PDLD%' THEN substr(ARRANGEMENT_NBR, 1, 14)
            ELSE ARRANGEMENT_NBR
        END,
        DIGI_LEVEL_FLAG
) c
    ON a.SOTK = c.ARRANGEMENT_NBR
where --UPPER(a.SPSO_TYPE) &lt;&gt; 'CD ONLINE'
    --and NVL(a.product_code,'A') &lt;&gt; '12912'
    --and
 UPPER(a.SPSO_TYPE) &lt;&gt; 'CHIA SE KHOI'
    and UPPER(a.CHITIEU_PLKHOI_NAME) &lt;&gt; 'THU KDNT'
GROUP BY a.TRANSACTION_DATE,
 CASE 
  WHEN UPPER(a.SPSO_TYPE) NOT IN ('THE','DICH VU','BANCA') THEN a.SOTK
  ELSE NULL
 END,
 a.CHG_CODE,
    a.MAKH,
    a.khoi,
    a.cn,
    a.PRODUCT_CODE,
    a.KHOI_THEOPLKHOI,
    a.CHITIEU_PLKHOI,
    a.CHITIEU_PLKHOI_NAME,
    a.SPSO_TYPE,
    nvl(c.DIGI_LEVEL_FLAG, a.PRODUCT_TYPE),
    nvl(b.KHOI_NHANCHIASE, a.KHOI_THEOPLKHOI),
    a.PHAN_KHUC,
    a.CUS_STATUS,
    a.APP_BIZ_STATUS,
    a.TEN_CN,
    a.CNC1,
    a.TEN_CNC1,
    nvl(to_number(b.TYLE_CHIASE),1)
    , a.LINEGL 
    , a.PLCATEGORY 
    , a.FTP_CODE 
    , a.DIGITAL_SERVICE_LV1 
    , a.DIGITAL_SERVICE_LV2 
    , a.SERVICE_PARTNER 
    , a.SERVICE_TELECOM</sql>
    <limit>0</limit>
