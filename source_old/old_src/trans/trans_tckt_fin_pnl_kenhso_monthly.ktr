  </step>
  <step>
    <name>FTP cho vay SPSO lẫn vào line SPTT 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT
    a.transaction_date,
    a.makh,
    a.cn,
    a.product_code,

    CASE
        WHEN b.khoi_theoplkhoi = 'COST CENTER' THEN 'NHS'
        WHEN b.khoi_theoplkhoi = 'TREASURY'    THEN 'TREA'
        ELSE b.khoi_theoplkhoi
    END AS khoi_truocchiase,

    NVL(c.report_item_code, e.report_item_code) AS chitieu_plkhoi,
    NVL(c.report_item_name, e.report_item_name) AS chitieu_plkhoi_name,
    'CHO VAY' spso_type,

    CASE
        WHEN i.DIGI_LEVEL_FLAG IS NOT NULL THEN i.DIGI_LEVEL_FLAG
        WHEN d.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
        WHEN d.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
    END product_type,

    SUM(a.amt_lcy * NVL(h.tyle_chiase, 1)) AS amt_sauchiase,

    NVL(
        h.khoi_nhanchiase,
        CASE
            WHEN b.khoi_theoplkhoi = 'COST CENTER' THEN 'NHS'
            WHEN b.khoi_theoplkhoi = 'TREASURY'    THEN 'TREA'
            ELSE b.khoi_theoplkhoi
        END
    ) AS khoi_sauchiase,

    f.phan_khuc,
    f.cus_status,
    f.app_biz_status,

    g.branch_name_t24        AS ten_cn,
    g.parent_branch_code_t24 AS cnc1,
    g.parent_branch_name_t24 AS ten_cnc1,

    NVL(h.tyle_chiase, 1) AS tyle_chiase,
    a.taikhoan             AS sotk,
    NULL                   AS chg_code,
    f.khoi                 AS khoi_kh,
    'DC'                   AS source_table,
    a.line_gl              AS linegl,
    SUBSTR(a.ma_sp_ftp, 3, 5) AS plcategory,
    a.ftp_code

FROM
    (
        SELECT
            a.transaction_date,
            a.taikhoan,
            a.makh,
            a.cn,
            a.product_code,
            a.line_gl,
            a.ma_sp_ftp,
            a.ftp_code,
            a.khoi,
            a.amt_lcy
        FROM apps.tr_ftp_cus a
        WHERE transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')

        UNION ALL

        SELECT
            a.transaction_date,
            a.taikhoan,
            a.makh,
            a.cn,
            a.product_code,
            a.line_gl,
            a.ma_sp_ftp,
            a.ftp_code,
            a.khoi,
            a.amt_lcy
        FROM apps.tr_ftp_cus_dieuchinh a
        WHERE transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
    ) a

LEFT JOIN apps.mb_map_toi_line b
       ON a.line_gl = b.linet24
      AND b.date_tx = TO_DATE('${PRD_ID}', 'YYYYMMDD')

LEFT JOIN apps.REF_SPSO_PLKHOI_MAP c
       ON b.chitieu_plkhoi_name = c.report_item_name

LEFT JOIN etl.ors_mb_product_code d
       ON a.product_code = d.product_code

LEFT JOIN etl.ods_gl_report_defn_ref_full e
       ON b.chitieu_plkhoi_name = e.report_item_name
      AND e.report_defn_code = '60219'

LEFT JOIN apps.fin_smy_customer_monthly f
       ON a.makh = f.makh
      AND f.transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')

LEFT JOIN etl.ref_aict_branch_m g
       ON a.cn = g.branch_code_t24
      AND g.transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')

LEFT JOIN (
            SELECT 'INDIV' khoi_chiase, 'NHS'   khoi_nhanchiase, 0.164 tyle_chiase FROM dual
            UNION ALL
            SELECT 'INDIV' khoi_chiase, 'INDIV' khoi_nhanchiase, 0.836 tyle_chiase FROM dual
          ) h
       ON (
            CASE
                WHEN b.khoi_theoplkhoi = 'COST CENTER' THEN 'NHS'
                WHEN b.khoi_theoplkhoi = 'TREASURY'    THEN 'TREA'
                ELSE b.khoi_theoplkhoi
            END
          ) = h.khoi_chiase

LEFT JOIN (
 SELECT CASE
   WHEN ARRANGEMENT_NBR LIKE 'PDLD%' THEN substr(ARRANGEMENT_NBR, 1, 14)
   ELSE ARRANGEMENT_NBR
  END ARRANGEMENT_NBR,
  DIGI_LEVEL_FLAG
 FROM ETL.ODS_LOAN_BAL_MTH
 WHERE txn_date = to_date(${PRD_ID}, 'YYYYMMDD')
 GROUP BY CASE
   WHEN ARRANGEMENT_NBR LIKE 'PDLD%' THEN substr(ARRANGEMENT_NBR, 1, 14)
   ELSE ARRANGEMENT_NBR
  END,
  DIGI_LEVEL_FLAG
) i
ON a.taikhoan = i.ARRANGEMENT_NBR


WHERE (
    d.sp_dv IN ('SPS1', 'SPSO', 'DVS1', 'DVSO', 'SPS2', 'DVS2')
    or i.DIGI_LEVEL_FLAG IN ('E2E', 'O2O')
    )
    AND c.report_item_name IS NULL
    AND a.ftp_code NOT IN ('HD112', 'TD402', 'TD404', 'TD405')
    AND e.report_item_code LIKE 'A11%'

GROUP BY
    a.transaction_date,
    a.makh,
    a.cn,
    a.product_code,

    CASE
        WHEN b.khoi_theoplkhoi = 'COST CENTER' THEN 'NHS'
        WHEN b.khoi_theoplkhoi = 'TREASURY'    THEN 'TREA'
        ELSE b.khoi_theoplkhoi
    END,

    NVL(c.report_item_code, e.report_item_code),
    NVL(c.report_item_name, e.report_item_name),
    c.type,

    CASE
        WHEN i.DIGI_LEVEL_FLAG IS NOT NULL THEN i.DIGI_LEVEL_FLAG
        WHEN d.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
        WHEN d.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
    END,

    NVL(
        h.khoi_nhanchiase,
        CASE
            WHEN b.khoi_theoplkhoi = 'COST CENTER' THEN 'NHS'
            WHEN b.khoi_theoplkhoi = 'TREASURY'    THEN 'TREA'
            ELSE b.khoi_theoplkhoi
        END
    ),

    f.phan_khuc,
    f.cus_status,
    f.app_biz_status,
    g.branch_name_t24,
    g.parent_branch_code_t24,
    g.parent_branch_name_t24,
    a.taikhoan,
    NVL(h.tyle_chiase, 1),
    f.khoi,
    a.line_gl,
    SUBSTR(a.ma_sp_ftp, 3, 5),
    a.ftp_code</sql>
