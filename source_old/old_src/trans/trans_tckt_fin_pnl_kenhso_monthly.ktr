  </step>
  <step>
    <name>HDV SPSO lẫn vào line SPTT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT a.transaction_date,
	a.makh,
	a.cn,
	a.product_code,
	CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END KHOI_TRUOCCHIASE,
	nvl(c.REPORT_ITEM_CODE, e.REPORT_ITEM_CODE) chitieu_plkhoi,
	nvl(c.REPORT_ITEM_NAME, e.REPORT_ITEM_NAME) chitieu_plkhoi_name,
	'HDV CKH' spso_type,
	'E2E' product_type,
	sum(a.amt_lcy*nvl(h.TYLE_CHIASE, 1)) amt_sauchiase,
	nvl(h.khoi_nhanchiase, CASE
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END) KHOI_SAUCHIASE,
	f.phan_khuc,
	f.CUS_STATUS,
	f.APP_BIZ_STATUS,
	g.BRANCH_NAME_T24 TEN_CN,
    g.PARENT_BRANCH_CODE_T24 CNC1,
    g.PARENT_BRANCH_NAME_T24 TEN_CNC1,
    nvl(h.TYLE_CHIASE, 1) TYLE_CHIASE,
    a.taikhoan sotk,
    NULL chg_code,
    f.khoi khoi_kh,
	'DC_HDV_CKH_SPTT' source_table,
	a.LINE_GL linegl,
	substr(a.ma_sp_ftp, 3, 5) PLCATEGORY,
	a.ftp_code
FROM 
    (SELECT * FROM apps.TR_FTP_CUS WHERE transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')
    UNION ALL
    SELECT * FROM apps.TR_FTP_CUS_DIEUCHINH WHERE transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')) a
left join apps.MB_MAP_TOI_LINE b
    ON a.LINE_GL = b.LINET24
    AND b.date_tx = to_date('${PRD_ID}', 'YYYYMMDD')
left join etl.FILE_SPSO_PLKHOI_MAP c
    ON b.CHITIEU_PLKHOI_NAME = c.REPORT_ITEM_NAME
left join etl.ORS_MB_PRODUCT_CODE d
    on a.product_code = d.product_code
left join etl.ODS_GL_REPORT_DEFN_REF_FULL e
	ON b.CHITIEU_PLKHOI_NAME = e.REPORT_ITEM_NAME
    AND e.REPORT_DEFN_CODE = '60219'
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY f
	ON a.makh = f.MAKH
	AND f.TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
LEFT JOIN etl.REF_AICT_BRANCH_M g
	ON a.cn = g.BRANCH_CODE_T24
    AND g.TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
LEFT JOIN
	(SELECT 'INDIV' KHOI_CHIASE, 'NHS' KHOI_NHANCHIASE, 0.5 TYLE_CHIASE
	FROM dual
	UNION ALL
	SELECT 'INDIV' KHOI_CHIASE, 'INDIV' KHOI_NHANCHIASE, 0.5 TYLE_CHIASE
	FROM dual
	) h
	ON CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END = KHOI_CHIASE
where d.SP_DV IN ('SPS1', 'SPSO', 'DVS1', 'DVSO', 'SPS2', 'DVS2')
	AND c.REPORT_ITEM_NAME IS NULL
	AND a.ftp_code NOT IN ('HD112', 'TD402', 'TD404', 'TD405')
	AND e.REPORT_ITEM_NAME = '- Thu lai FTP ban von huy dong CKH SP thong thuong'
GROUP BY a.transaction_date,
	a.makh,
	a.cn,
	a.product_code,
	CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END,
	nvl(c.REPORT_ITEM_CODE, e.REPORT_ITEM_CODE),
	nvl(c.REPORT_ITEM_NAME, e.REPORT_ITEM_NAME),
	c.TYPE,
	decode(d.SP_DV, 'SPS1', 'E2E', 'SPSO', 'O2O', 'DVS1', 'E2E', 'DVSO', 'O2O', NULL),
    nvl(h.khoi_nhanchiase, CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END),
	f.phan_khuc,
	f.CUS_STATUS,
	f.APP_BIZ_STATUS,
	g.BRANCH_NAME_T24,
    g.PARENT_BRANCH_CODE_T24,
    g.PARENT_BRANCH_NAME_T24,
    a.taikhoan,
    nvl(h.TYLE_CHIASE, 1),
    f.khoi,
	a.LINE_GL,
	substr(a.ma_sp_ftp, 3, 5),
	a.ftp_code</sql>
    <limit>0</limit>
