    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with sum_sms_sanluong as (
    select TRANSACTION_DATE,
        a.receiver_id,
        a.PARTNER,
        a.TELCO,
        'SMS_CSKH' SMS_TYPE_PAY,
        b.AMOUNT_SMS_TYPE,
        b.DON_GIA_KO_VAT,
        b.DON_GIA_GOM_VAT,
        b.UNIT_FEE,
        sum(a.SOLUONG) SOLUONG,
        sum(a.TOTAL_MESS_SHORT) TOTAL_MESS_SHORT,
        sum(case when b.AMOUNT_SMS_TYPE = 'SOLUONG' then a.SOLUONG when b.AMOUNT_SMS_TYPE = 'TOTAL_MESS_SHORT' then a.TOTAL_MESS_SHORT END) SL_SMS_TINHPHI,
        null sl_sdt_tinhphi,
        NVL(b.discount,0) discount,
        b.NHOM_THUE_BAO,
        a.MSG_TYPE,
        a.MSG_TYPE_DESC
    from etl.FILE_KSS_SMS_SANLUONG a
    left join (
        select distinct PARTNER, telco, AMOUNT_SMS_TYPE, DON_GIA_KO_VAT, DON_GIA_GOM_VAT, NHOM_THUE_BAO, unit_fee, discount
        from etl.FILE_KSS_SMS_BIEUPHI
        where SMS_TYPE_PAY = 'SMS_CSKH'
            and unit_fee = 'SMS'
        ) b
        on a.PARTNER = b.PARTNER
        and a.TELCO = b.TELCO
    where transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
    group by TRANSACTION_DATE,
        a.receiver_id,
        a.PARTNER,
        a.TELCO,
        b.AMOUNT_SMS_TYPE,
        b.DON_GIA_KO_VAT,
        b.DON_GIA_GOM_VAT,
        b.UNIT_FEE,
        b.discount,
        b.NHOM_THUE_BAO,
        a.MSG_TYPE,
        a.MSG_TYPE_DESC
),
sum_sms_thuebao as (
    select TRANSACTION_DATE,
        RECEIVER_ID,
        a.partner,
        a.TELCO,
        'SMS_CSKH' SMS_TYPE_PAY,
        b.AMOUNT_SMS_TYPE,
        sum(case when b.AMOUNT_SMS_TYPE = 'SOLUONG' then a.SOLUONG when b.AMOUNT_SMS_TYPE = 'TOTAL_MESS_SHORT' then a.TOTAL_MESS_SHORT END) SL_SMS_TINHPHI
    from etl.FILE_KSS_SMS_THUEBAO a
    left join (
        select distinct PARTNER, telco, AMOUNT_SMS_TYPE
        from etl.FILE_KSS_SMS_BIEUPHI
        where SMS_TYPE_PAY = 'SMS_CSKH'
        ) b
        on a.partner = b.PARTNER
        and a.TELCO = b.TELCO
    where transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
    group by TRANSACTION_DATE,
        RECEIVER_ID,
        a.partner,
        a.TELCO,
        b.AMOUNT_SMS_TYPE
),
phanloai_thuebao as (
    select a.transaction_date,
        a.receiver_id,
        a.partner,
        a.telco,
        b.NHOM_THUE_BAO,
        a.sms_type_pay,
        b.DON_GIA_KO_VAT,
        b.DON_GIA_GOM_VAT,
        b.UNIT_FEE,
        nvl(b.DISCOUNT,0) DISCOUNT,
        a.AMOUNT_SMS_TYPE
    from sum_sms_thuebao a
    left join etl.FILE_KSS_SMS_BIEUPHI b
        on a.partner = b.PARTNER
        and a.telco = b.TELCO
        and a.SMS_TYPE_PAY = b.SMS_TYPE_PAY
        and a.SL_SMS_TINHPHI >= b.FROM_SMS_AMOUNT
        and (a.SL_SMS_TINHPHI &lt;= b.TO_SMS_AMOUNT OR b.TO_SMS_AMOUNT IS NULL)
        and b.VALUE_DATE &lt;= to_date(${PRD_ID}, 'YYYYMMDD')
        and (b.END_DATE >= to_date(${PRD_ID}, 'YYYYMMDD') OR b.END_DATE IS NULL)
),
sum_sms as (
    select a.TRANSACTION_DATE,
        a.RECEIVER_ID,
        a.PARTNER,
        a.TELCO,
        case when b.UNIT_FEE = 'SMS' then a.msg_type end msg_type,
        case when b.UNIT_FEE = 'SMS' then a.msg_type_desc end msg_type_desc,
        sum(a.soluong) soluong,
        sum(a.total_mess_short) total_mess_short,
        b.sms_type_pay,
        b.NHOM_THUE_BAO,
        b.UNIT_FEE,
        b.AMOUNT_SMS_TYPE,
        sum(case
                when b.AMOUNT_SMS_TYPE = 'SOLUONG' then a.SOLUONG
                when b.AMOUNT_SMS_TYPE = 'TOTAL_MESS_SHORT' then a.TOTAL_MESS_SHORT
            END) SL_SMS_TINHPHI,
        1 SL_SDT_TINHPHI,
        b.DON_GIA_KO_VAT,
        b.DON_GIA_GOM_VAT,
        discount,
        'ETL.FILE_KSS_SMS_THUEBAO' source_table
    from etl.FILE_KSS_SMS_THUEBAO a
    left join phanloai_thuebao b
        on a.receiver_id = b.receiver_id
        and a.PARTNER = b.PARTNER
        and a.telco = b.telco
    where a.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
    group by a.TRANSACTION_DATE,
        a.RECEIVER_ID,
        a.PARTNER,
        a.TELCO,
        case when b.UNIT_FEE = 'SMS' then a.msg_type end,
        case when b.UNIT_FEE = 'SMS' then a.msg_type_desc end,
        b.sms_type_pay,
        b.NHOM_THUE_BAO,
        b.UNIT_FEE,
        b.AMOUNT_SMS_TYPE,
        b.DON_GIA_KO_VAT,
        b.DON_GIA_GOM_VAT,
        b.discount
    UNION ALL
    select TRANSACTION_DATE,
        RECEIVER_ID,
        PARTNER,
        TELCO,
        msg_type,
        a.msg_type_desc,
        soluong,
        total_mess_short,
        sms_type_pay,
        NHOM_THUE_BAO,
        UNIT_FEE,
        AMOUNT_SMS_TYPE,
        SL_SMS_TINHPHI,
        SL_SDT_TINHPHI,
        DON_GIA_KO_VAT,
        DON_GIA_GOM_VAT,
        discount,
        'ETL.FILE_KSS_SMS_SANLUONG' source_table
    from sum_sms_sanluong a
)
select transaction_date,
    receiver_id,
    nhom_thue_bao,
    partner nha_cung_cap,
    telco,
    msg_type,
    msg_type_desc,
    sms_type_pay,
    soluong,
    total_mess_short,
    AMOUNT_SMS_TYPE,
    SL_SMS_TINHPHI,
    SL_SDT_TINHPHI,
    UNIT_FEE,
    discount,
    case
        when unit_fee = 'SMS' then SL_SMS_TINHPHI
        when unit_fee = 'RECEIVER_ID' then SL_SDT_TINHPHI
    end SL_TINH_PHI,
    don_gia_ko_vat,
    case
        when unit_fee = 'SMS' then SL_SMS_TINHPHI
        when unit_fee = 'RECEIVER_ID' then SL_SDT_TINHPHI
    end * don_gia_ko_vat * (1-discount) chi_phi_ko_vat,
    don_gia_gom_vat,
    case
        when unit_fee = 'SMS' then SL_SMS_TINHPHI
        when unit_fee = 'RECEIVER_ID' then SL_SDT_TINHPHI
    end * don_gia_gom_vat * (1-discount) chi_phi_gom_vat,
    source_table
from sum_sms</sql>
    <limit>0</limit>
