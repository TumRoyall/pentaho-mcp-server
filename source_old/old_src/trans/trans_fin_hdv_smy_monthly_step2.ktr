  <step>
    <name>TR_KHACHHANG_ACTIVE_M 20250328</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with
mb_nim_lk as
(select 
a.TRANSACTION_DATE,
a.TAIKHOAN,
a.MAKH,
a.NTE,
a.CN,
a.KHOI,
a.MBLD_TYPE,
a.PRODUCT_CODE,
a.PRODUCTGR_CODE,
a.CATEGORY,
a.SUB_PRODUCT,
a.LOC_TERM,
a.LOAIKYHAN,
a.SECTOR,
a.FTP_CODE,
a.D_TYPE,
a.PROJECT_ID,
a.PRODUCT_TYPE,
sum (INTEREST_CONTRACT_NOMINAL_VND) NOMINAL_INTEREST_VND_LK,
sum (INTEREST_CONTRACT_REAL_VND) REAL_INTEREST_VND_LK,
sum (INTEREST_FTP_ACTUAL_VND) INTEREST_FTP_VND_LK,
sum (INTEREST_FTP_REGULAR_VND) INTEREST_FTP_TT_VND_LK
from apps.mb_agg_nim_lk a
where a.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
and a.D_TYPE = 'DEPOSIT'
and not exists 
(select 1 from APPS.FIN_HDV_SMY_MONTHLY b
where b.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD') 
and a.taikhoan = b.sotk
and nvl(a.makh,0) = nvl(b.makh,0)
and nvl(a.khoi,0) = nvl(b.khoi,0)
and nvl(a.CN,0) = nvl(b.CN,0))
group by
a.TRANSACTION_DATE,
a.TAIKHOAN,
a.MAKH,
a.NTE,
a.CN,
a.KHOI,
a.MBLD_TYPE,
a.PRODUCT_CODE,
a.PRODUCTGR_CODE,
a.CATEGORY,
a.SUB_PRODUCT,
a.LOC_TERM,
a.LOAIKYHAN,
a.SECTOR,
a.FTP_CODE,
a.D_TYPE,
a.PROJECT_ID,
a.PRODUCT_TYPE
),
mb_nim_m as(
select 
a.TRANSACTION_DATE,
a.TAIKHOAN,
a.MAKH,
a.NTE,
a.CN,
a.KHOI,
a.MBLD_TYPE,
a.PRODUCT_CODE,
a.PRODUCTGR_CODE,
a.CATEGORY,
a.SUB_PRODUCT,
a.LOC_TERM,
a.LOAIKYHAN,
a.SECTOR,
a.FTP_CODE,
a.D_TYPE,
a.PROJECT_ID,
a.PRODUCT_TYPE,
sum (NOMINAL_INTEREST_VND) NOMINAL_INTEREST_VND,
sum (REAL_INTEREST_VND) REAL_INTEREST_VND,
sum (INTEREST_FTP_VND) INTEREST_FTP_VND,
sum (INTEREST_FTP_TT_VND) INTEREST_FTP_TT_VND
from apps.mb_agg_nim_m a
where a.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
and a.D_TYPE = 'DEPOSIT'
and not exists 
( select 1 from APPS.FIN_HDV_SMY_MONTHLY b
where b.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
and a.taikhoan = b.sotk
and nvl(a.makh,0) = nvl(b.makh,0)
and nvl(a.khoi,0) = nvl(b.khoi,0)
and nvl(a.CN,0) = nvl(b.CN,0))
group by 
a.TRANSACTION_DATE,
a.TAIKHOAN,
a.MAKH,
a.NTE,
a.CN,
a.KHOI,
a.MBLD_TYPE,
a.PRODUCT_CODE,
a.PRODUCTGR_CODE,
a.CATEGORY,
a.SUB_PRODUCT,
a.LOC_TERM,
a.LOAIKYHAN,
a.SECTOR,
a.FTP_CODE,
a.D_TYPE,
a.PROJECT_ID,
a.PRODUCT_TYPE)

select
to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
nvl(a.TAIKHOAN, b.TAIKHOAN) SOTK,
null COA_CODE,
nvl(a.MAKH, b.MAKH) MAKH,
nvl(a.NTE, b.NTE) NTE,
Null VAL_DATE,
Null MAT_DATE,
nvl(a.LOC_TERM, b.LOC_TERM) LOC_TERM,
nvl(a.SECTOR, b.SECTOR) SECTOR,
nvl(a.KHOI, b.KHOI) KHOI,
Null CUS_TYPE,
m.PHAN_KHUC,
Null CUS_STATUS,
null INDUSTRY_CODE,
nvl(a.CN, b.CN) CN,
k.BRANCH_NAME_T24 BRANCH_NAME_T24,
k.PARENT_BRANCH_CODE_T24 PARENT_BRANCH_CODE_T24,
k.PARENT_BRANCH_NAME_T24 PARENT_BRANCH_NAME_T24,
k.TINH_THANH TINH_THANH,
k.VUNG_MIEN VUNG_MIEN,
k.TIEU_VUNG TIEU_VUNG,
nvl(a.CATEGORY, b.CATEGORY) CATEGORY,
nvl(a.SUB_PRODUCT, b.SUB_PRODUCT) SUB_PRODUCT,
nvl(a.PRODUCT_CODE, b.PRODUCT_CODE) PRODUCT_CODE,
Null KENH_GD,
Null LINE_T24,
nvl(a.FTP_CODE, b.FTP_CODE) FTP_CODE ,
Null START_DATE,
Null INT_RATE,
Null source_table,
nvl(a.LOAIKYHAN, b.LOAIKYHAN) LOAIKYHAN,
0 SODU_THOIDIEM_VND,
0 SODU_BINHQUAN_VND,
0 SODU_BINHQUAN_LK_VND,
0 DOANHSO_MO_MOI_VND,
0 DOANHSO_QUAY_VONG_VND,
0 DOANHSO_NOP_THEM_VND,
0 DOANHSO_RUT_MOT_PHAN_VND,
0 DOANHSO_TAT_TOAN_DH_VND,
0 DOANHSO_TAT_TOAN_TH_VND,
nvl (b.NOMINAL_INTEREST_VND, 0) NOMINAL_INTEREST_VND,
nvl (b.REAL_INTEREST_VND, 0) REAL_INTEREST_VND,
nvl (b.INTEREST_FTP_VND, 0) INTEREST_FTP_VND,
nvl (b.INTEREST_FTP_TT_VND, 0) INTEREST_FTP_TT_VND,
nvl (a.NOMINAL_INTEREST_VND_LK, 0) NOMINAL_INTEREST_VND_LK,
nvl (a.REAL_INTEREST_VND_LK, 0) REAL_INTEREST_VND_LK,
nvl (a.INTEREST_FTP_VND_LK, 0) INTEREST_FTP_VND_LK,
nvl (a.INTEREST_FTP_TT_VND_LK, 0) INTEREST_FTP_TT_VND_LK
from mb_nim_lk a
full join mb_nim_m b
on a.TAIKHOAN = b.TAIKHOAN
and a.MAKH = b.MAKH
and a.NTE = b.NTE
and a.CN = b.CN
and a.KHOI = b.KHOI
and a.MBLD_TYPE = b.MBLD_TYPE
and a.PRODUCT_CODE = b.PRODUCT_CODE
and a.PRODUCTGR_CODE = b.PRODUCTGR_CODE
and a.CATEGORY = b.CATEGORY
and a.SUB_PRODUCT = b.SUB_PRODUCT
and a.LOC_TERM = b.LOC_TERM
and a.LOAIKYHAN = b.LOAIKYHAN
and a.SECTOR = b.SECTOR
and a.FTP_CODE = b.FTP_CODE
and a.D_TYPE = b.D_TYPE
and a.PROJECT_ID =b.PROJECT_ID
and a.PRODUCT_TYPE =b.PRODUCT_TYPE
left join ETL.REF_AICT_BRANCH_M k 
on k.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
and coalesce (a.CN,b.CN) = k.BRANCH_CODE_T24
left join APPS.FIN_SMY_CUSTOMER_MONTHLY m
on m.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
and coalesce (a.MAKH,b.MAKH) = m.MAKH</sql>
    <limit>0</limit>
