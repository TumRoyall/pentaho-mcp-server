  <step>
    <name>TR_KHACHHANG_ACTIVE_M 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH mb_nim_lk AS
     (    SELECT a.TRANSACTION_DATE 
               , a.TAIKHOAN 
               , a.MAKH 
               , a.NTE 
               , a.CN 
               , a.KHOI 
               , a.PRODUCT_CODE 
               , a.FTP_CODE 
               , a.CATEGORY 
               , a.LOC_TERM 
               , a.SECTOR 
               , SUM (INTEREST_CONTRACT_NOMINAL_VND) NOMINAL_INTEREST_VND_LK 
               , SUM (INTEREST_CONTRACT_REAL_VND)    REAL_INTEREST_VND_LK 
               , SUM (PENALTY_INTEREST_VND)          PENALTY_INTEREST_VND_LK 
               , SUM (INTEREST_FTP_ACTUAL_VND)       INTEREST_FTP_VND_LK 
               , SUM (INTEREST_FTP_REGULAR_VND)      INTEREST_FTP_TT_VND_LK
          FROM apps.mb_agg_nim_lk                    a
          WHERE a.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
          AND  d_type = 'DEPOSIT'
          AND  NOT EXISTS
               (    SELECT 1 
                    FROM APPS.FIN_HDV_SMY_MONTHLY b
                    WHERE b.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
                    AND  a.taikhoan = b.SOTK
                    AND  NVL(a.makh,0) = NVL(b.makh,0)
                    AND  NVL(a.khoi,0) = NVL(b.khoi,0)
                    AND  NVL(a.CN,0) = NVL(b.CN,0))
          GROUP BY a.TRANSACTION_DATE, a.TAIKHOAN, a.MAKH, a.NTE, a.CN, a.KHOI, a.PRODUCT_CODE,
               a.FTP_CODE, a.CATEGORY, a.LOC_TERM, a.SECTOR 
     ) 
     , mb_nim_m AS 
     (    SELECT a.TRANSACTION_DATE 
               , a.TAIKHOAN 
               , a.MAKH 
               , a.NTE 
               , a.CN 
               , a.KHOI 
               , a.PRODUCT_CODE 
               , a.FTP_CODE 
               , a.CATEGORY 
               , a.LOC_TERM 
               , a.SECTOR 
               , SUM (NOMINAL_INTEREST_VND) NOMINAL_INTEREST_VND 
               , SUM (REAL_INTEREST_VND)    REAL_INTEREST_VND 
               , SUM (PENALTY_INTEREST_VND) PENALTY_INTEREST_VND 
               , SUM (INTEREST_FTP_VND)     INTEREST_FTP_VND 
               , SUM (INTEREST_FTP_TT_VND)  INTEREST_FTP_TT_VND
          FROM apps.mb_agg_nim_m            a
          WHERE a.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
          AND  d_type = 'DEPOSIT'
          AND  NOT EXISTS
               (    SELECT 1 
                    FROM APPS.FIN_HDV_SMY_MONTHLY b
                    WHERE b.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
                    AND  a.taikhoan = b.SOTK
                    AND  NVL(a.makh,0) = NVL(b.makh,0)
                    AND  NVL(a.khoi,0) = NVL(b.khoi,0)
                    AND  NVL(a.CN,0) = NVL(b.CN,0))
          GROUP BY a.TRANSACTION_DATE, a.TAIKHOAN, a.MAKH, a.NTE, a.CN, a.KHOI, a.PRODUCT_CODE,
               a.FTP_CODE, a.CATEGORY, a.LOC_TERM, a.SECTOR 
     )
SELECT to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE 
     , NVL(a.TAIKHOAN, b.TAIKHOAN)       SOTK 
     , NULL                              COA_CODE 
     , NVL(a.MAKH, b.MAKH)               MAKH 
     , NVL(a.NTE, b.NTE)                 NTE 
     , COALESCE ( g.ARRANGEMENT_OPENING_DATE, t.ARRANGEMENT_VALUE_DATE, u.ARRANGEMENT_OPENING_DATE 
     , y.ARRANGEMENT_OPENING_DATE )           VAL_DATE 
     , t.MATURITY_DATE                        MAT_DATE 
     , NVL(a.LOC_TERM, b.LOC_TERM)            LOC_TERM 
     , COALESCE(a.SECTOR, b.SECTOR, n.SECTOR) SECTOR 
     , COALESCE (a.KHOI, b.KHOI, n.khoi)      KHOI 
     , ( CASE WHEN n.creation_date >= TRUNC (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') THEN 'MOI'
          ELSE 'CU' END) CUS_TYPE 
     , CASE WHEN n.khoi = 'CIB' AND  n.sector IN ('3035' 
                                                  ,'3535') THEN 'FDI' WHEN n.khoi = 'SME' THEN NVL 
               (pk.pkkh, 'KXD') WHEN n.khoi IN ('INDIV' 
                                                , 'NHS') AND  n.SECTOR IN ('1688' 
                                                                           ,'1689' 
                                                                           ,'1690' 
                                                                           ,'1691' 
                                                                           ,'1699' 
                                                                           , '1666' 
                                                                           , '1660') THEN
               'PRIVATE' WHEN n.khoi IN ('INDIV' 
                                         , 'NHS') AND  n.SECTOR IN ('1888' 
                                                                    ,'1889' 
                                                                    ,'1890' 
                                                                    ,'1891' 
                                                                    ,'1746' 
                                                                    ,'1747') THEN 'PRIORITY' WHEN 
               n.khoi IN ('INDIV' 
                          , 'NHS') THEN 'MASS' WHEN n.khoi = 'DVC' THEN DECODE(n.SECTOR, '1095', 
               'BHXH
VN', '1096', 'BHXH BQP', '1097', 'KBNN', '1098', 'Du
an ODA', '1099', 
               'Bo ban nganh', 'DVC') ELSE NVL(n.khoi,'KXD') END                       PHAN_KHUC 
     , n.LC_ST_FIN                                                                     CUS_STATUS 
     , NULL                                                                            INDUSTRY_CODE 
     , COALESCE(a.CN, b.CN,g.BRANCH_CODE, t.BRANCH_CODE, u.BRANCH_CODE, y.BRANCH_CODE) CN 
     , k.BRANCH_NAME_T24                                                               BRANCH_NAME_T24 
     , k.PARENT_BRANCH_CODE_T24                                                        PARENT_BRANCH_CODE_T24 
     , k.PARENT_BRANCH_NAME_T24                                                        PARENT_BRANCH_NAME_T24 
     , k.TINH_THANH                                                                    TINH_THANH 
     , k.VUNG_MIEN                                                                     VUNG_MIEN 
     , k.TIEU_VUNG                                                                     TIEU_VUNG 
     , COALESCE(a.CATEGORY, b.CATEGORY,g.CATE_CODE, t.CATE_CODE, u.CATE_CODE, y.CATE_CODE) 
     CATEGORY 
     , COALESCE(g.SUB_PRODUCT_CODE, t.SUB_PRODUCT_CODE, u.SUB_PRODUCT_CODE, y.SUB_PRODUCT_CODE ) 
     SUB_PRODUCT 
     , COALESCE(a.PRODUCT_CODE, b.PRODUCT_CODE, g.PRODUCT_CODE, t.PRODUCT_CODE, u.PRODUCT_CODE,
     y.PRODUCT_CODE ) PRODUCT_CODE 
     , CASE WHEN NVL (l.SP_DV, '0') IN ('SPSO' 
                                        , 'DVSO' 
                                        , 'SPS1' 
                                        , 'DVS1') THEN 'ONLINE' ELSE 'OFFLINE' END     KENH_GD 
     , NULL                                                                            LINE_T24 
     , COALESCE(a.FTP_CODE, b.FTP_CODE,g.FTP_CODE, t.FTP_CODE, u.FTP_CODE, y.FTP_CODE) FTP_CODE 
     , t.ARRANGEMENT_OPENING_DATE                                                      START_DATE 
     , NULL                                                                            INT_RATE 
     , NULL                                                                            source_table 
     , CASE WHEN COALESCE ( a.PRODUCT_CODE, b.PRODUCT_CODE, g.PRODUCT_CODE, t.PRODUCT_CODE,
               u.PRODUCT_CODE, y.PRODUCT_CODE ) = '12111' THEN 'KKH' WHEN SUBSTR( COALESCE 
               ( a.PRODUCT_CODE, b.PRODUCT_CODE, g.PRODUCT_CODE, t.PRODUCT_CODE, u.PRODUCT_CODE,
               y.PRODUCT_CODE ), 1, 2 ) IN ('12' 
                                            , '13') THEN 'CKH' ELSE 'KKH' END LOAIKYHAN 
     , 0                                                                      SODU_THOIDIEM_VND 
     , 0                                                                      SODU_BINHQUAN_VND 
     , 0                                                                      SODU_BINHQUAN_LK_VND 
     , 0                                                                      DOANHSO_MO_MOI_VND 
     , 0                                                                      DOANHSO_QUAY_VONG_VND 
     , 0                                                                      DOANHSO_NOP_THEM_VND 
     , 0                                                                      DOANHSO_RUT_MOT_PHAN_VND 
     , 0                                                                      DOANHSO_TAT_TOAN_DH_VND 
     , 0                                                                      DOANHSO_TAT_TOAN_TH_VND 
     , NVL (b.NOMINAL_INTEREST_VND, 0)                                        NOMINAL_INTEREST_VND 
     , NVL (b.REAL_INTEREST_VND, 0)                                           REAL_INTEREST_VND 
     , NVL (b.INTEREST_FTP_VND, 0)                                            INTEREST_FTP_VND 
     , NVL (b.INTEREST_FTP_TT_VND, 0)                                         INTEREST_FTP_TT_VND 
     , NVL (a.NOMINAL_INTEREST_VND_LK, 0)                                     NOMINAL_INTEREST_VND_LK 
     , NVL (a.REAL_INTEREST_VND_LK, 0)                                        REAL_INTEREST_VND_LK 
     , NVL (a.INTEREST_FTP_VND_LK, 0)                                         INTEREST_FTP_VND_LK 
     , NVL (a.INTEREST_FTP_TT_VND_LK, 0)                                      INTEREST_FTP_TT_VND_LK
FROM mb_nim_lk                                                                a
FULL JOIN mb_nim_m                                                            b ON a.TAIKHOAN = 
     b.TAIKHOAN AND  a.MAKH = b.MAKH AND  a.NTE = b.NTE AND  a.CN = b.CN AND  a.KHOI = b.KHOI AND 
     a.PRODUCT_CODE = b.PRODUCT_CODE AND  a.FTP_CODE= b.FTP_CODE AND  a.CATEGORY = b.CATEGORY AND 
     a.LOC_TERM = b.LOC_TERM AND  a.SECTOR = b.SECTOR
LEFT JOIN ETL.ODS_CASA_CONTRACT     g ON COALESCE (a.TAIKHOAN, b.TAIKHOAN) = g.ARRANGEMENT_NBR
LEFT JOIN ETL.ODS_TD_CONTRACT       t ON COALESCE (a.TAIKHOAN, b.TAIKHOAN) = t.ARRANGEMENT_NBR
LEFT JOIN ETL.ODS_INTERNAL_CONTRACT U ON COALESCE (a.TAIKHOAN, b.TAIKHOAN) = u.ARRANGEMENT_NBR
LEFT JOIN ETL.ODS_OVD_CONTRACT      Y ON COALESCE (a.TAIKHOAN, b.TAIKHOAN) = Y. ARRANGEMENT_NBR
LEFT JOIN ETL.REF_AICT_BRANCH_M     k ON k.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
AND  COALESCE ( a.CN, b.CN, g.BRANCH_CODE, t.BRANCH_CODE, u.BRANCH_CODE, y.BRANCH_CODE ) = 
     k.BRANCH_CODE_T24
LEFT JOIN etl.ORS_MB_PRODUCT_CODE l ON COALESCE ( a.PRODUCT_CODE, g.PRODUCT_CODE, t.PRODUCT_CODE,
     u.PRODUCT_CODE, y.PRODUCT_CODE ) = l.product_code
LEFT JOIN etl.ORS_TR_KHACHHANG_ACTIVE_M n ON n.data_date = to_date ('${PRD_ID}', 'YYYYMMDD') AND 
     COALESCE ( a.MAKH, b.MAKH, g.MAKH, t.makh, u.makh, y.makh ) = n.makh
LEFT JOIN etl.ORS_MB_SME_PKKH_M PK ON pk.TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD') AND 
     PK.pk_type = 'PK_100' AND  PK.dtt_type = 3 AND  COALESCE ( a.MAKH, b.MAKH, g.MAKH, t.makh,
     u.makh, y.makh ) = pk.makh</sql>
