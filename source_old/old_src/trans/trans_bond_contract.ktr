    <connection>ods_dc</connection>
    <sql>SELECT BOND_CONTRACT_ID
,ARRANGEMENT_TYPE_CODE
,SOURCE_TABLE_NAME
,ARRANGEMENT_KEY
,ARRANGEMENT_NBR
,BRANCH_CODE
,CURRENCY_CODE
,PARTY_KEY
,SUBSTR (PARTY_KEY, INSTR (PARTY_KEY,'.',1,2) + 1, LENGTH (PARTY_KEY) - INSTR (PARTY_KEY,'.',1,2)) AS MAKH
,COUNTER_PARTY_KEY
,SUBSTR (COUNTER_PARTY_KEY, INSTR (COUNTER_PARTY_KEY,'.',1,2) + 1, LENGTH (COUNTER_PARTY_KEY) - INSTR (COUNTER_PARTY_KEY,'.',1,2)) AS MAKH_THUCAP
,DLGN_PARTY_KEY
,OPEN_CHANNEL_CODE
,TERMINAL_DEVICE_KEY
,ARRANGEMENT_OPENING_DATE
,ARRANGEMENT_CLOSED_DATE
,ARRANGEMENT_STATUS
,ISSUED_LEGAL_TTL_IND
,TXN_TYPE
,OPERATION_TYPE
,PORTFOLIO_IND
,BOND_KEY
,BOND_QTY
,BOND_PRICE
,FACE_AMT
,DISCOUNT_AMT
,GROSS_AMT
,TOTAL_RVAL
,DAILY_RVAL
,ORIG_DAILY_RVAL
,ACCRUED_INT_AMT
,RESERVED_AMT
,SPEND_BUSINESS_AMT
,TXN_TAX_AMT
,NXT_PAYMENT_INT_AMT
,PERSONAL_TAX_AMT
,TOTAL_QTY
,ORIG_QTY
,ORIG_DISCOUNT
,SETL_AMT
,ARRANGEMENT_REMARKS
,ARRANGEMENT_VALUE_DATE
,ARRANGEMENT_ORIG_VALUE_DATE
,TRADE_DATE
,MATURITY_DATE
,NXT_ACCOUNT_CAP_DATE
,INT_RATE
,REAL_INT_RATE
,NET_INT_RATE
,BOND_INT_RATE
,ORIG_BOND_INT_RATE
,DEFERRED_INT_RATE
,INT_RATE_CHANGE_FRQ
,PNP_LQD_ACCOUNT
,INT_LQD_ACCOUNT
,DLGN_ACCOUNT
,TXN_METHOD
,DLGN_CHG_CODE
,RM_ID
,ACG_STATUS
,ARRANGEMENT_STATUS_CODE
,INPUTTER
,COMMIT_DATE_TIME
,AUTHORISER
,AUTH_DEPT_CODE
,AUTH_DATE_TIME
,CREATED_BY
,CREATION_DATE
,LAST_UPDATED_BY
,LAST_UPDATE_DATE
,PRODUCT_CODE
FROM ODS.BOND_CONTRACT
--where last_update_date &lt;= to_date('${PRD_ID}', 'YYYYMMDD') </sql>
