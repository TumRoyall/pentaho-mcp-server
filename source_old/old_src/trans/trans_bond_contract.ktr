    <name>PD_CONTRACT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT
PD_CONTRACT_ID,
SOURCE_TABLE_NAME,
ARRANGEMENT_KEY,
ARRANGEMENT_NBR,
CURRENCY_CODE,
PARTY_KEY,
substr (PARTY_KEY, instr (PARTY_KEY,'.',1,2) + 1, length (PARTY_KEY) - instr (PARTY_KEY,'.',1,2)) MAKH,
LOAN_INDUSTRY_CODE,
PRODUCT_GROUP_CODE,
LIMIT_CODE,
ORIG_LIMIT_CODE,
LIMIT_AMT,
FUND_SOURCE_CODE,
ARRANGEMENT_TERM,
LEGACY_CONTRACT_ID,
TOTAL_ODUE_AMT,
TOTAL_ODUE_TAX_AMT,
TOTAL_REPAY_AMT,
ARRANGEMENT_REMARKS,
FINAL_MATURITY_DATE,
ORIG_MATURITY_DATE,
INT_CLCN_BASIS,
INT_SPREAD,
PENALTY_INT_RATE,
PENALTY_INT_KEY,
PENALTY_INT_SPREAD,
CONSOL_KEY,
PNP_LQD_ACCOUNT,
RESERVE_FUNDS_ACCOUNT,
LOAN_PURPOSE,
DSBR_PURPOSE,
EXTEND_SCHD_FLAG,
DOUBTFUL_STATUS,
CIC_PURPOSE_TYPE_CODE,
INVOLVED_PARTY_KEY,
ODUE_DAY_NBR,
ODUE_STATUS_CODE,
CREDIT_STATUS,
ARRANGEMENT_STATUS_CODE,
INPUTTER,
COMMIT_DATE_TIME,
AUTHORISER,
AUTH_DEPT_CODE,
AUTH_DATE_TIME,
APPRAISAL_TYPE_CODE,
ODUE_PNP_AMT,
ODUE_INT_AMT,
PENALTY_AMT,
PS,
PAYMENT_AMT,
PNP_ORIG_PAYMENT_AMT,
PNP_OTSND_PAYMENT_AMT,
PNP_OTSND_PAYMENT_TAX_AMT,
PNP_PREPAID_AMT,
PNP_ADJUSTED_AMT,
INT_ORIG_PAYMENT_AMT,
INT_OTSND_PAYMENT_AMT,
INT_OTSND_PAYMENT_TAX_AMT,
INT_PREPAID_AMT,
INT_ADJUSTED_AMT,
PENALTY_ORIG_PAYMENT_AMT,
PENALTY_OTSND_PAYMENT_AMT,
PENALTY_OTSND_PAYMENT_TAX_AMT,
PENALTY_PREPAID_AMT,
PENALTY_ADJUSTED_AMT,
PS_ORIG_PAYMENT_AMT,
PS_OTSND_PAYMENT_AMT,
PS_OTSND_PAYMENT_TAX_AMT,
PS_PREPAID_AMT,
PS_ADJUSTED_AMT,
PD_DATE,
CREATED_BY,
CREATION_DATE,
LAST_UPDATED_BY,
LAST_UPDATE_DATE,
CATE_CODE,
SUB_PRODUCT_CODE,
BRANCH_CODE,
LEGACY_CONTRACT_DATE,
ARRANGEMENT_STATUS,
PENALTY_INT_EFF_DATE_DTL,
PENALTY_INT_RATE_DTL,
ARRANGEMENT_TMP_DEBT_GROUP,
row_number () over (partition by a.ARRANGEMENT_NBR order by a.PD_DATE desc) RANK_NUM,
ftp_code,
product_code
FROM ODS.PD_CONTRACT a 
--where last_update_date &lt;= to_date('${PRD_ID}', 'YYYYMMDD') </sql>
    <limit>0</limit>
