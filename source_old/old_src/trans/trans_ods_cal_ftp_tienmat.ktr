  <step>
    <name>FTP_TIENMAT 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>with MVM_ENTRY_KHOI_CN as  

(select  

DIVISION_CODE, 

BRANCH_CODE, 

CURRENCY_CODE, 

sum(FCY_AMT) FCY_AMT 

From ods.movement_entry 

where txn_date = to_date('${PRD_ID}','YYYYMMDD') 

and substr(COA_CODE,1,2)= '10'  

AND DIVISION_CODE IS NOT NULL 

group by  

DIVISION_CODE, 

BRANCH_CODE, 

CURRENCY_CODE), 

MVM_ENTRY_CN as 

(select  

BRANCH_CODE, 

CURRENCY_CODE, 

sum(FCY_AMT) FCY_AMT 

From MVM_ENTRY_KHOI_CN 

group by  

BRANCH_CODE, 

CURRENCY_CODE), 

MVM_ENTRY_KHOI_TH as 

(select  

DIVISION_CODE, 

CURRENCY_CODE, 

sum(FCY_AMT) FCY_AMT 

From MVM_ENTRY_KHOI_CN 

group by  

DIVISION_CODE, 

CURRENCY_CODE), 

MVM_ENTRY_TH as 

(select  

CURRENCY_CODE, 

sum(FCY_AMT) FCY_AMT 

From MVM_ENTRY_KHOI_CN 

group by 

CURRENCY_CODE), 

CRB_BAL_CN as 

(select 

BRANCH_CODE, 

CURRENCY_CODE, 

sum(FCY_BAL) FCY_BAL 

from ods.crb_bal 

where txn_date  = to_date('${PRD_ID}','YYYYMMDD') 

and substr(COA_CODE,1,2)= '10'  

group by  

BRANCH_CODE, 

CURRENCY_CODE) 

SELECT  

to_date('${PRD_ID}','YYYYMMDD') TRANSACTION_DATE, 

nvl(E.DIVISION_CODE,F.DIVISION_CODE) DIVISION_CODE, 

case when nvl(E.DIVISION_CODE,F.DIVISION_CODE) ='NHS' then '1910' 

     when nvl(E.DIVISION_CODE,F.DIVISION_CODE) ='INDIV' then '1700' 

     when nvl(E.DIVISION_CODE,F.DIVISION_CODE) ='SME' then '1000' 

     when nvl(E.DIVISION_CODE,F.DIVISION_CODE) ='CIB' then '3000' 

     when nvl(E.DIVISION_CODE,F.DIVISION_CODE) ='DVC' then '1100' 

     when nvl(E.DIVISION_CODE,F.DIVISION_CODE) ='FI' then '8000' 

END MAKH, 

nvl(E.BRANCH_CODE, F.BRANCH_CODE) BRANCH_CODE, 

nvl(E.CURRENCY_CODE, F.CURRENCY_CODE) CURRENCY_CODE, 

nvl(E.FCY_AMT,0) FCY_AMT, 

nvl(E.FCY_TOTAL_AMT,0) FCY_TOTAL_AMT, 

nvl(E.FCY_TOTAL_BAL,0) FCY_TOTAL_BAL, 

CASE WHEN (nvl(E.FCY_TOTAL_AMT,0) &lt;&gt; 0) THEN Round(nvl(E.FCY_AMT,0)/nvl(E.FCY_TOTAL_AMT,0),2) 

ELSE F.RATE END RATE, 

CASE WHEN (nvl(E.FCY_TOTAL_AMT,0) &lt;&gt; 0) THEN Round(nvl(E.FCY_AMT,0)/nvl(E.FCY_TOTAL_AMT,0),2) 

ELSE F.RATE END * nvl(E.FCY_TOTAL_BAL,0) FCY_FTP_BAL 

FROM  

(SELECT 

b.DIVISION_CODE,  

a.BRANCH_CODE, 

a.CURRENCY_CODE, 

nvl(a.FCY_BAL,0) FCY_TOTAL_BAL, 

nvl(b.FCY_AMT,0) FCY_AMT, 

nvl(c.FCY_AMT,0) FCY_TOTAL_AMT 

FROM CRB_BAL_CN a 

LEFT JOIN  MVM_ENTRY_KHOI_CN  b 

ON a.BRANCH_CODE = b.BRANCH_CODE 

and a.CURRENCY_CODE = b.CURRENCY_CODE 

LEFT JOIN MVM_ENTRY_CN c 

on nvl(a.BRANCH_CODE,b.BRANCH_CODE)= c.BRANCH_CODE 

and nvl(a.CURRENCY_CODE,b.CURRENCY_CODE)= c.CURRENCY_CODE) E 

LEFT JOIN  

(SELECT  

nvl(b.DIVISION_CODE,d.DIVISION_CODE) DIVISION_CODE, 

a.BRANCH_CODE, 

a.CURRENCY_CODE, 

ROUND(nvl(b.FCY_AMT/c.FCY_AMT,d.FCY_AMT/e.FCY_AMT),2) RATE 

FROM CRB_BAL_CN a 

LEFT JOIN MVM_ENTRY_KHOI_TH b 

ON a.CURRENCY_CODE = b.CURRENCY_CODE 

LEFT JOIN MVM_ENTRY_TH c 

ON nvl(a.CURRENCY_CODE,b.CURRENCY_CODE) = c.CURRENCY_CODE 

LEFT JOIN MVM_ENTRY_KHOI_TH d 

ON  d.CURRENCY_CODE ='VND' 

AND b.DIVISION_CODE IS NULL 

LEFT JOIN MVM_ENTRY_TH e 

ON  e.CURRENCY_CODE ='VND' 

AND b.DIVISION_CODE IS null) F 

ON F.RATE > 0 

AND E.BRANCH_CODE =F.BRANCH_CODE 

AND E.CURRENCY_CODE = F.CURRENCY_CODE  

where nvl(CASE WHEN (nvl(E.FCY_TOTAL_AMT,0) &lt;&gt; 0) THEN Round(nvl(E.FCY_AMT,0)/nvl(E.FCY_TOTAL_AMT,0),2) 

ELSE F.RATE END,0) &lt;&gt; 0 </sql>
    <limit>0</limit>
