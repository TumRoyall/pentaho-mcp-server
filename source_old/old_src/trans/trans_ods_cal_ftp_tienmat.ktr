  <step>
    <name>FTP_TIENMAT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>with MVM_ENTRY_KHOI as 
(select 
  DIVISION_CODE,
  BRANCH_CODE,
  CURRENCY_CODE,
  sum(FCY_AMT) FCY_AMT
From ods.movement_entry
where txn_date = to_date('${PRD_ID}','YYYYMMDD') and substr(COA_CODE,1,2)= '10'  AND DIVISION_CODE IS NOT NULL
group by DIVISION_CODE, BRANCH_CODE, CURRENCY_CODE),

MVM_ENTRY_CN as
(select 
  BRANCH_CODE,
  CURRENCY_CODE,
  sum(FCY_AMT) FCY_AMT
From MVM_ENTRY_KHOI
group by  BRANCH_CODE, CURRENCY_CODE),

CRB_BAL_CN as
(select
  BRANCH_CODE,
  CURRENCY_CODE,
  sum(FCY_BAL) FCY_BAL
from ods.crb_bal
where txn_date  = to_date('${PRD_ID}','YYYYMMDD') and substr(COA_CODE,1,2)= '10' 
group by BRANCH_CODE, CURRENCY_CODE)

select
  to_date('${PRD_ID}','YYYYMMDD') transaction_date,
  a.DIVISION_CODE DIVISION_CODE,
  case when DIVISION_CODE ='NHS' then '1910'
     when DIVISION_CODE ='INDIV' then '1700'
     when DIVISION_CODE ='SME' then '1000'
     when DIVISION_CODE ='CIB' then '3000'
     when DIVISION_CODE ='DVC' then '1100'
     when DIVISION_CODE ='FI' then '8000'
  end makh,
  coalesce (a.BRANCH_CODE, b.BRANCH_CODE, c.BRANCH_CODE) BRANCH_CODE,
  coalesce (a.CURRENCY_CODE, b.CURRENCY_CODE, c.CURRENCY_CODE) CURRENCY_CODE,
  nvl(a.FCY_AMT,0) FCY_AMT,
  nvl(b.FCY_AMT,0) FCY_TOTAL_AMT,
  nvl(c.FCY_BAL,0) FCY_TOTAL_BAL,
  nvl(a.FCY_AMT,0) / nvl(b.FCY_AMT,0) RATE,
  nvl(c.FCY_BAL,0)*(nvl(a.FCY_AMT,0) / nvl(b.FCY_AMT,0)) FCY_FTP_BAL
from MVM_ENTRY_KHOI  a
left join MVM_ENTRY_CN b on a.BRANCH_CODE = b.BRANCH_CODE and a.CURRENCY_CODE = b.CURRENCY_CODE
left join CRB_BAL_CN c on nvl(a.BRANCH_CODE, b.BRANCH_CODE) = c.BRANCH_CODE and nvl(a.CURRENCY_CODE, b.CURRENCY_CODE) = c.CURRENCY_CODE
where b.FCY_AMT &lt;&gt; 0
</sql>
