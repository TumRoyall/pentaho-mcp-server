  </step>
  <step>
    <name>ETL.temp_ftp_term_deposit</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select 
TRANSACTION_DATE,
SOTK,
CCY,
T24_LINE,
COA_CODE,
INT_RATE_TYPE,
TERM_HD,
TERM_FTP,
MAKH,
ARRANGEMENT_INT_RATE,
CNC2,
VUNG_MIEN,
PRODUCT_CODE,
FTP_CODE,
FTP_TYPE,
VALUE_DATE,
MATURITY_DATE,
KHOI,
NGAY_TDLS,
SECTOR,
RM_CODE,
TYGIA,
FCY_AMT,
LCY_AMT,
SOURCE_TABLE,
FTP_GROUP,
FTP_CATEGORY,
FTP_LINE,
GL_LINE,
Nvl(INT_FIX,0) INT_FIX,
Nvl(INT_BHTG,0) INT_BHTG,
Nvl(INT_DTBB,0) INT_DTBB,
Nvl(INT_TK,0) INT_TK, 
Nvl(INT_PHUTROI,0) INT_PHUTROI,
Nvl(INT_DC_ALCO,0) INT_DC_ALCO,
Nvl(INT_BASE,0) INT_BASE,
Nvl(INT_NIM_HD,0) INT_NIM_HD,
Nvl(INT_PHANRA,0) INT_PHANRA,
Nvl(INT_VAYDH,0) INT_VAYDH,
Nvl(INT_HDVLSC,0) INT_HDVLSC,
nvl(INT_BASE_MARGIN,0) INT_BASE_MARGIN,
Nvl(INT_LS_HD,0) INT_LS_HD,
CASE  
WHEN Nvl(INT_FIX,0) &lt;&gt; 0 then 0
WHEN Nvl(INT_LS_HD,0) &lt;&gt; 0 THEN 0
WHEN nvl(INT_NIM_MARGIN,0) = 0 THEN 0
WHEN (nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_MARGIN,0)) > (nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)) 
THEN ((nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_MARGIN,0)) - (nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)))
ELSE 0  
END INT_NIM_MARGIN,
------- thêm logic chặn trần -----
CASE 
WHEN Nvl(INT_FIX,0) &lt;&gt; 0 THEN Nvl(INT_FIX,0)
WHEN Nvl(INT_LS_HD,0) &lt;&gt; 0 THEN Nvl(INT_LS_HD,0) + nvl(INT_DC_ALCO,0)
WHEN nvl(INT_NIM_MARGIN,0) = 0 THEN nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)
WHEN CCY ='VND' AND VALUE_DATE >= '01JAN2024'  AND nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0) >= nvl(ARRANGEMENT_INT_RATE,0)   
THEN nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_HD,0)  
ELSE 
GREATEST ((nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_MARGIN,0)),(nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)))
END FTP_RATE_HT,
----
(nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)) FTP_RATE_TT,
------- thêm logic chặn trần -----
round((CASE 
WHEN Nvl(INT_FIX,0) &lt;&gt; 0 THEN Nvl(INT_FIX,0)
WHEN Nvl(INT_LS_HD,0) &lt;&gt; 0 THEN Nvl(INT_LS_HD,0) + nvl(INT_DC_ALCO,0)
WHEN nvl(INT_NIM_MARGIN,0) = 0 THEN nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)
WHEN CCY ='VND' AND VALUE_DATE >= '01JAN2024' AND nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0) >= nvl(ARRANGEMENT_INT_RATE,0)   
THEN nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_HD,0) 
ELSE 
GREATEST ((nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_MARGIN,0)),(nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)))
END)* FCY_AMT/36500, 2) FTP_HT_FCY,
round((CASE 
WHEN Nvl(INT_FIX,0) &lt;&gt; 0 THEN Nvl(INT_FIX,0)
WHEN Nvl(INT_LS_HD,0) &lt;&gt; 0 THEN Nvl(INT_LS_HD,0) + nvl(INT_DC_ALCO,0)
WHEN nvl(INT_NIM_MARGIN,0) = 0 THEN nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)
WHEN CCY ='VND' AND VALUE_DATE >= '01JAN2024' AND nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0) >= nvl(ARRANGEMENT_INT_RATE,0)   
THEN nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_HD,0) 
ELSE 
GREATEST ((nvl(ARRANGEMENT_INT_RATE,0) + nvl(INT_NIM_MARGIN,0)),(nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_DC_ALCO,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0)))
END)* LCY_AMT/36500, 2) FTP_HT_LCY,
----
round((nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0))* FCY_AMT/36500,2) FTP_TT_FCY,
round((nvl(INT_BHTG,0) + nvl(INT_DTBB,0) + nvl(INT_TK,0) + nvl(INT_PHUTROI,0) + nvl(INT_BASE,0) + nvl(INT_NIM_HD,0) + nvl(INT_PHANRA,0) + nvl(INT_VAYDH,0) + nvl(INT_HDVLSC,0) + nvl(INT_BASE_MARGIN,0))* LCY_AMT/36500, 2) FTP_TT_LCY
from ETL.temp_ftp_term_deposit a</sql>
