    <connection>ods_dc</connection>
    <sql>WITH LICHTRAGOC as
(SELECT
ARRANGEMENT_NBR,
SCHD_DATE,
T24_CUST_ID,
sum(FCY_SCHD_AMT) FCY_SCHD_AMT,
sum(LCY_SCHD_AMT) LCY_SCHD_AMT
FROM smy.PAYMENT_SCHD_STMT pss
WHERE TXN_DATE = (SELECT
MAX(CALENDAR_DATE) AS
LAST_WORKING_DATE
FROM ODS.DATES_REF
WHERE CALENDAR_DATE &lt;=
TO_DATE('${PRD_ID}', 'YYYYMMDD') - 1
AND WORKING_DATE_IND = 'W')
AND SCHD_TYPE like '%P%'
AND SCHD_DATE =to_date ('${PRD_ID}',
'YYYYMMDD')
GROUP BY
ARRANGEMENT_NBR,
SCHD_DATE,
T24_CUST_ID)
select
a.TXN_DATE TRANSACTION_DATE,
CASE WHEN substr (a.ARRANGEMENT_NBR,1,2) =
'PD' THEN substr(a.ARRANGEMENT_NBR,1,14)
ELSE a.ARRANGEMENT_NBR END LD_ID,
a.BRANCH_CODE CN,
a.CURRENCY_CODE CCY,
a.T24_CUST_ID MAKH,
a.SECTOR_CODE SECTOR,
a.TERM LOC_TERM,
a.LEGACY_CONTRACT_ID LEGACY_ID,
a.ARRANGEMENT_CREDIT_RATING
CREDIT_STATUS,
a.CATE_CODE CATEG,
a.SUB_PRODUCT_CODE SUB_PRODUCT,
a.VALUE_DATE VAL_DATE,
a.MATURITY_DATE MAT_DATE,
a.INDUSTRY_CODE UOL,
a.DIVISION_CODE KHOI,
a.CAMPAIGN_CODE MBLD_TYPE,
a.COA_CODE GL,
a.CUST_CREDIT_RATING NHOM_NO_XHTD,
a.ARRANGEMENT_INT_RATE/100 LS,
a.INT_KEY INTEREST_KEY,
a.FUND_SOURCE_CODE SOURCE_OF_FUND,
a.PRODUCT_CODE,
a.INT_RATE_TYPE INTEREST_TYPE,
a.FIX_INT_RATE INTEREST_FIX,
a.INT_SPREAD BIENDOLS,
a.ARRANGEMENT_RM_CODE RM_HOPDONG,
a.ARRANGEMENT_CROSS_SELL_RM_CODE
RM_BANCHEO,
a.CIC_PURPOSE_CODE CIC_PURPOSE,
NULL CONTRACT_TYPE,
a.PRODUCT_GROUP_CODE PRODUCTGR_CODE,
a.PRODUCT_TYPE PRODUCT_TYPE,
a.DOUBTFUL_STATUS DOUBTFUL_STA,
a.INT_RATE_SUPPORT_FLAG HOTRO_LS,
a.PROJECT_CODE PROJECT_ID,
sum(-LCY_DEBIT_AMT)
DOANHSO_GIAINGAN_VND,
sum(LCY_CREDIT_AMT) DOANHSO_THUNO_VND,
sum(case
when substr (a.ARRANGEMENT_NBR,1,2) = 'PD' and
nvl (LCY_CREDIT_AMT,0) &lt; 0 then nvl
(LCY_CREDIT_AMT,0)
when substr (a.ARRANGEMENT_NBR,1,2) = 'PD' and
nvl (LCY_CREDIT_AMT,0) > 0 then 0
when nvl (CUST_CREDIT_RATING,'1') &lt;&gt; '1' and nvl
(LCY_CREDIT_AMT,0) &lt; 0 then nvl
(LCY_CREDIT_AMT,0)
when nvl (CUST_CREDIT_RATING,'1') &lt;&gt; '1' and nvl
(LCY_CREDIT_AMT,0) > 0 then 0
when nvl (CATE_CODE, 0) &lt; 10000 then nvl
(LCY_CREDIT_AMT,0)
else least (nvl (LCY_CREDIT_AMT,0), nvl
(b.FCY_SCHD_AMT,0)) END)
DOANHSO_THUNO_DUNGHAN,
sum(case
when substr (a.ARRANGEMENT_NBR,1,2) = 'PD' then
0
when nvl (CUST_CREDIT_RATING,'1') &lt;&gt; '1' then 0
when nvl (CATE_CODE, 0) &lt; 10000 then 0
when nvl (b.FCY_SCHD_AMT,0) = 0 then nvl
(LCY_CREDIT_AMT,0)
else greatest ((nvl (LCY_CREDIT_AMT,0) - nvl
(b.FCY_SCHD_AMT,0)),0)
END) DOANHSO_THUNO_TRUOCHAN,
sum(case
when substr (a.ARRANGEMENT_NBR,1,2) = 'PD' and
nvl (LCY_CREDIT_AMT,0) > 0 then nvl
(LCY_CREDIT_AMT,0)
when nvl (CUST_CREDIT_RATING,'1') &lt;&gt; '1' and nvl
(LCY_CREDIT_AMT,0) > 0 then nvl
(LCY_CREDIT_AMT,0)
else 0 END) DOANHSO_THUNO_QUAHAN
from SMY.LOAN_TXN_DAILY a
left join LICHTRAGOC b
on a.ARRANGEMENT_NBR=
b.ARRANGEMENT_NBR
WHERE a.TXN_DATE = to_date ('${PRD_ID}','YYYYMMDD')
and substr (a.COA_CODE,1,1) = '2'
and substr (a.COA_CODE,1,2) &lt;&gt; '20'
and substr (nvl (a.CATE_CODE, '00000'),1,4) &lt;&gt; '1700'
GROUP BY
a.TXN_DATE ,
CASE WHEN substr (a.ARRANGEMENT_NBR,1,2) =
'PD' THEN substr(a.ARRANGEMENT_NBR,1,14)
ELSE a.ARRANGEMENT_NBR END ,
a.BRANCH_CODE ,
a.CURRENCY_CODE ,
a.T24_CUST_ID ,
a.SECTOR_CODE ,
a.TERM ,
a.LEGACY_CONTRACT_ID ,
a.ARRANGEMENT_CREDIT_RATING ,
a.CATE_CODE ,
a.SUB_PRODUCT_CODE ,
a.VALUE_DATE ,
a.MATURITY_DATE ,
a.INDUSTRY_CODE ,
a.DIVISION_CODE ,
a.CAMPAIGN_CODE ,
a.COA_CODE ,
a.CUST_CREDIT_RATING ,
a.ARRANGEMENT_INT_RATE/100 ,
a.INT_KEY ,
a.FUND_SOURCE_CODE ,
a.PRODUCT_CODE,
a.INT_RATE_TYPE ,
a.FIX_INT_RATE ,
a.INT_SPREAD ,
a.ARRANGEMENT_RM_CODE ,
a.ARRANGEMENT_CROSS_SELL_RM_CODE ,
a.CIC_PURPOSE_CODE ,
a.PRODUCT_GROUP_CODE ,
a.PRODUCT_TYPE ,
a.DOUBTFUL_STATUS ,
a.INT_RATE_SUPPORT_FLAG ,
a.PROJECT_CODE
HAVING sum(-LCY_DEBIT_AMT) +
sum(LCY_CREDIT_AMT) &lt;&gt; 0
/*
-- Logic cu truoc golive change https://hotrocntt.mbbank.com.vn/ChangeDetails.do?CHANGEID=29073&amp;fromListView=true
with tmp_lichtrano as (
    select
        a.LD_ID,
        a.NGAYTHUGOC,
        a.curr,
        sum (a.SO_TIEN) SOTIEN_THUGOC,
        sum (a.SO_TIEN * nvl (b.conversion_rate, 1)) SOTIEN_THUGOC_VND
    from
        etl.ORS_MB_VN_LICHTRAGOC a
        left join etl.ors_gl_daily_rates b on a.NGAYTHUGOC = b.conversion_date
        and b.to_currency = 'VND'
        and a.curr = b.from_currency
    where
        a.NGAYTHUGOC = to_date ('${PRD_ID}', 'YYYYMMDD')
    group by
        a.LD_ID,
        a.NGAYTHUGOC,
        a.curr
)
select
    a.*,
    case
        when substr (a.ld_id, 1, 2) = 'PD'
        and nvl (DOANHSO_THUNO_VND, 0) &lt; 0 then nvl (DOANHSO_THUNO_VND, 0)
        when nvl (NHOM_NO_XHTD, '1') &lt;&gt; '1'
        and nvl (DOANHSO_THUNO_VND, 0) &lt; 0 then nvl (DOANHSO_THUNO_VND, 0)
        when nvl (categ, 0) &lt; 10000 then nvl (DOANHSO_THUNO_VND, 0)
        else least (
            nvl (DOANHSO_THUNO_VND, 0),
            nvl (b.SOTIEN_THUGOC_VND, 0)
        )
    end DOANHSO_THUNO_DUNGHAN,
    case
        when substr (a.ld_id, 1, 2) = 'PD' then 0
        when nvl (NHOM_NO_XHTD, '1') &lt;&gt; '1' then 0
        when nvl (categ, 0) &lt; 10000 then 0
        when nvl (b.SOTIEN_THUGOC_VND, 0) = 0 then nvl (DOANHSO_THUNO_VND, 0)
        else greatest (
            (
                nvl (DOANHSO_THUNO_VND, 0) - nvl (b.SOTIEN_THUGOC_VND, 0)
            ),
            0
        )
    end DOANHSO_THUNO_TRUOCHAN,
    case
        when substr (a.ld_id, 1, 2) = 'PD'
        and nvl (DOANHSO_THUNO_VND, 0) > 0 then nvl (DOANHSO_THUNO_VND, 0)
        when nvl (NHOM_NO_XHTD, '1') &lt;&gt; '1'
        and nvl (DOANHSO_THUNO_VND, 0) > 0 then nvl (DOANHSO_THUNO_VND, 0)
        else 0
    end DOANHSO_THUNO_QUAHAN
from
    ETL.ORS_CAL_REP_DOANHSO_TD a
    left join tmp_lichtrano b on a.LD_ID = b.ld_id
*/
/*
with tmp_lichtrano as
 (select a.ld_id,
         a.ngaythugoc,
         a.curr,
         sum(a.so_tien) sotien_thugoc,
         sum(a.so_tien * nvl(b.conversion_rate, 1)) sotien_thugoc_vnd
    from etl.ors_mb_vn_lichtragoc a
    left join etl.ors_gl_daily_rates b
      on a.ngaythugoc = b.conversion_date
     and b.to_currency = 'VND'
     and a.curr = b.from_currency
   where a.ngaythugoc = to_date('${PRD_ID}', 'YYYYMMDD')
   group by a.ld_id, a.ngaythugoc, a.curr)
select a.*,
       case
         when substr(a.ld_id, 1, 2) = 'PD' and nvl(doanhso_thuno_vnd, 0) &lt; 0 then
          nvl(doanhso_thuno_vnd, 0)
         when substr(a.ld_id, 1, 2) = 'PD' and nvl(doanhso_thuno_vnd, 0) > 0 then
          0
         when nvl(nhom_no_xhtd, '1') &lt;&gt; '1' and
              nvl(doanhso_thuno_vnd, 0) &lt; 0 then
          nvl(doanhso_thuno_vnd, 0)
         when nvl(nhom_no_xhtd, '1') &lt;&gt; '1' and
              nvl(doanhso_thuno_vnd, 0) > 0 then
          0
         when nvl(categ, 0) &lt; 10000 then
          nvl(doanhso_thuno_vnd, 0)
         else
          least(nvl(doanhso_thuno_vnd, 0), nvl(b.sotien_thugoc, 0))
       end doanhso_thuno_dunghan,
       case
         when substr(a.ld_id, 1, 2) = 'PD' then
          0
         when nvl(nhom_no_xhtd, '1') &lt;&gt; '1' then
          0
         when nvl(categ, 0) &lt; 10000 then
          0
         when nvl(b.sotien_thugoc, 0) = 0 then
          nvl(doanhso_thuno_vnd, 0)
         else
          greatest((nvl(doanhso_thuno_vnd, 0) - nvl(b.sotien_thugoc, 0)), 0)
       end doanhso_thuno_truochan,
       case
         when substr(a.ld_id, 1, 2) = 'PD' and nvl(doanhso_thuno_vnd, 0) > 0 then
          nvl(doanhso_thuno_vnd, 0)
         when nvl(nhom_no_xhtd, '1') &lt;&gt; '1' and
              nvl(doanhso_thuno_vnd, 0) > 0 then
          nvl(doanhso_thuno_vnd, 0)
         else
          0
       end doanhso_thuno_quahan
  from etl.ors_cal_rep_doanhso_td a
  left join tmp_lichtrano b
    on a.ld_id = b.ld_id
*/</sql>
