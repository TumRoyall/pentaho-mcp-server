  <step>
    <name>way4_prepaid_card</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with v_card_data as (
select t1.*, t2.ftp_prod, t2.khoi, t2.name, t2.product_code
from etl.tmp_ftp_preaid_card_amount t1
left join apps.ftp_preaidcard_map_bin t2
on t1.bin = t2.bin
where transaction_date = to_date('${PRD_ID}','yyyyMMdd') and t1.bin &lt;&gt;'97042292'
)
select
a.Transaction_Date date_report,
a.name,
a.bin,
a.amount,
a.KHOI,
a.product_code,
nvl(a.currency,'VND') currency,
b.amount ftp_ls_kkh,
abs(a.amount)* b.amount/36500 FTP_AMOUNT,
a.ftp_prod FTP_CODE,
c.vung_mien,
D.AMOUNT FTP_DIEUCHINH_ALCO,
       D.BIENDO_KHOI,
       D.BIENDO_SANPHAM,
       D.BIENDO_VUNGMIEN,
       CASE
         WHEN nvl(a.currency,'VND') = 'VND' THEN
          round(abs(a.AMOUNT) * (nvl(b.AMOUNT, 0) + nvl(d.amount, 0)) /
                36500)
         WHEN nvl(a.currency,'VND') IN ('USD', 'EUR') THEN
          round(abs(a.AMOUNT) * (nvl(b.AMOUNT, 0) + nvl(d.amount, 0)) /
                36500,
                2)
       END FTP_AMT_WITH_ALCO,
       
       CASE
         WHEN nvl(a.currency,'VND') = 'VND' THEN
          round(abs(a.AMOUNT) * (nvl(b.AMOUNT, 0) + nvl(d.BIENDO_KHOI, 0)) /
                36500)
         WHEN nvl(a.currency,'VND') IN ('USD', 'EUR') THEN
          round(abs(a.AMOUNT) * (nvl(b.AMOUNT, 0) + nvl(d.BIENDO_KHOI, 0)) /
                36500,
                2)
       END FTP_AMT_WITH_BIENDO_KHOI,
       
       CASE
         WHEN nvl(a.currency,'VND') = 'VND' THEN
          round(abs(a.AMOUNT) *
                (nvl(b.AMOUNT, 0) + nvl(d.BIENDO_SANPHAM, 0)) / 36500)
         WHEN nvl(a.currency,'VND') IN ('USD', 'EUR') THEN
          round(abs(a.AMOUNT) *
                (nvl(b.AMOUNT, 0) + nvl(d.BIENDO_SANPHAM, 0)) / 36500,
                2)
       END FTP_AMT_WITH_BIENDO_SANPHAM,
       
       CASE
         WHEN nvl(a.currency,'VND') = 'VND' THEN
          round(abs(a.AMOUNT) *
                (nvl(b.AMOUNT, 0) + nvl(d.BIENDO_VUNGMIEN, 0)) / 36500)
         WHEN nvl(a.currency,'VND') IN ('USD', 'EUR') THEN
          round(abs(a.AMOUNT) *
                (nvl(b.AMOUNT, 0) + nvl(d.BIENDO_VUNGMIEN, 0)) / 36500,
                2)
       END FTP_AMT_WITH_BIENDO_VUNGMIEN,
       m.ftp_line,
       m.ftp_category ,
		'ACNT_CONTRACT_SODU' source_table      
from v_card_data a
left join apps.ftp_dic_ls_kkh b on 
A.Transaction_Date = b.date_apply and b.khoi = 'INDIV'
and b.currency = nvl(a.currency,'VND')
LEFT JOIN apps.ftp_dic_vungmien_khuvuc c
    on c.cn_cap_2 = 'VN0010001'
left join (SELECT *
               FROM apps.FTP_DIC_DIEUCHINH_ALCO A
              WHERE A.DATE_APPLY =
                    (SELECT MAX(DATE_APPLY)
                       FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                      WHERE B.FTP_PRODUCT = A.FTP_PRODUCT
                        AND B.KHOI = A.KHOI
                        AND B.VUNG_MIEN = A.VUNG_MIEN
                        AND B.CURRENCY = A.CURRENCY
                        AND B.TERM = A.TERM
                        AND B.DATE_APPLY &lt;= to_date('${PRD_ID}', 'yyyyMMdd')
                        AND B.TERM = 'KKH'
                        AND B.FTP_PRODUCT = 'HD001'
and b.vung_mien= 'HANOI')
and a.vung_mien= 'HANOI') D
    ON D.KHOI = 'INDIV'
   AND nvl(a.currency,'VND') = D.CURRENCY
--   AND c.vung_mien = D.VUNG_MIEN   
left join apps.ftp_mapping_toi m
on a.ftp_prod= m.ftp_prod
and  a.khoi = m.khoi        
where a.Transaction_Date =to_date('${PRD_ID}','yyyyMMdd')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
