        <jsScript_script>// ======================
// NUMBER CONVERSION
// ======================

// Convert string → number
var AMOUNT = AMOUNT != null &amp;&amp; AMOUNT != "" ? parseFloat(AMOUNT) : null;
var FIXEDRATE   = FIXEDRATE != null &amp;&amp; FIXEDRATE != "" ? parseFloat(FIXEDRATE) : null;

var TRADEDATE = TRADEDATE != null &amp;&amp; TRADEDATE != "" ? new Date(parseInt(TRADEDATE)) : null;
var VALUEDATE = VALUEDATE != null &amp;&amp; VALUEDATE != "" ? new Date(parseInt(VALUEDATE)) : null;
var MATURITYDATE = MATURITYDATE != null &amp;&amp; MATURITYDATE != "" ? new Date(parseInt(MATURITYDATE)) : null;
var CAPTUREDATE = CAPTUREDATE != null &amp;&amp; CAPTUREDATE != "" ? new Date(parseInt(CAPTUREDATE)) : null;
</jsScript_script>
