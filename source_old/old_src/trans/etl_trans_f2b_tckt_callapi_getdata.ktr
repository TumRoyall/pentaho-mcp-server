        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var json = JSON.parse(result);
var results = json.data;

var isEmptyResult = false;
if (results == null || results == "" || results == "[]" || results.length == 0) {
    isEmptyResult = true;
} else {
    isEmptyResult;
}
</jsScript_script>
