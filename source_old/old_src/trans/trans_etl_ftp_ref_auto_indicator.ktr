    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT  
LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) TRANSACTION_DATE, 
'CPVON_TD' MA_CT , 	 
'Chi phí vốn term Deposit' TEN_CT, 
CURRENCY_CODE ,  sum(INT_RATE/36500 * FCY_AMT) VALUE 
FROM SMY.TD_BAL a 
FULL JOIN ODS.DATES_REF b 
ON a.TXN_DATE = b.LAST_WORKING_DATE  WHERE b.CALENDAR_DATE BETWEEN 
trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH')+1 AND 
to_date('${PRD_ID}','YYYYMMDD')+1 
AND((substr(COA_CODE,1,2) in('42','43') 
AND Substr(PRODUCT_CODE,1,2) IN ('11','12','13')) 
OR (substr(COA_CODE,1,2) in('41') AND SECTOR_CODE 
BETWEEN 5000 AND 6999)) 
AND FTP_CODE not in ('HD106', 'HD104') 
GROUP BY CURRENCY_CODE 
</sql>
