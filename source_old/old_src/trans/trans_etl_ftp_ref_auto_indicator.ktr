'SDBQ_MUANO' MA_CT ,  
'Số dư bình quân mua nợ' TEN_CT, a.CURRENCY_CODE , sum(a.FCY_AMT) VALUE FROM SMY.LOAN_BAL_MTH a  
WHERE TXN_DATE = 
TRUNC(to_date('${PRD_ID}','YYYYMMDD'),'MONTH')- 1 
AND substr(COA_CODE ,1,2) ='37' 
