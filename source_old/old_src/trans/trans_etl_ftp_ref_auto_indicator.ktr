  <step>
    <name>1.SMY.ACG_BAL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT  
LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) 
TRANSACTION_DATE, 
CASE    
WHEN GL_LINE='783000' THEN 'CP_BHTG' 
WHEN substr(COA_CODE,1,1)='2' AND substr(COA_CODE,1,2) &lt;&gt; '20' 
AND substr(COA_CODE,3,1) NOT IN '9' THEN 'SDBQ_LOAN' 
WHEN COA_CODE IN ('1530', '1630') THEN 'SDBQ_TP_TCKT'  
WHEN COA_CODE like '10%' THEN 'SDBQ_TIENMAT'  
WHEN COA_CODE like '11%' THEN 'SDBQ_TG_NHNN'  
WHEN COA_CODE in ('1311','1321','1331') THEN 'SDBQ_TCTD_KKH'  END  
MA_CT ,  
CASE  
WHEN GL_LINE='783000' THEN 'Chi phí bảo hiểm tiền gửi'  
WHEN substr(COA_CODE,1,1)='2' AND substr(COA_CODE,1,2) &lt;&gt; '20' 
AND substr(COA_CODE,3,1) NOT IN '9' THEN 'Số dư bình quân Cho vay'   
WHEN COA_CODE IN ('1530', '1630') THEN 'Số dư bình quân trái phiếu' 
WHEN COA_CODE like '10%' THEN 'Số dư bình quân tiền mặt'  
WHEN COA_CODE like '11%' THEN 'Số dư bình quân tiền gửi NHNN'  WHEN COA_CODE in ('1311','1321','1331') THEN 'Số dư bình quân tiền gửi KKH tại TCTD'  
END   as TEN_CT, 
CURRENCY_CODE, 
(-1)*sum(CASE 
WHEN  GL_LINE='783000' THEN (FCY_CREDIT_AMT-FCY_DEBIT_AMT) 
ELSE (FCY_CREDIT_AMT-FCY_DEBIT_AMT)/27 
END) VALUE 
FROM SMY.ACG_BAL 
WHERE TXN_DATE BETWEEN 
trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH') AND to_date('${PRD_ID}','YYYYMMDD') 
AND REPORT_CODE='V6_01' 
AND (CASE    
WHEN GL_LINE='783000' THEN 'CP_BHTG' 
WHEN substr(COA_CODE,1,1)='2' AND substr(COA_CODE,1,2) &lt;&gt; '20' 
AND substr(COA_CODE,3,1) NOT IN '9' THEN 'SDBQ_LOAN' 
WHEN COA_CODE IN ('1530', '1630') THEN 'SDBQ_TP_TCKT'  
WHEN COA_CODE like '10%' THEN 'SDBQ_TIENMAT'  
WHEN COA_CODE like '11%' THEN 'SDBQ_TG_NHNN'  
WHEN COA_CODE in ('1311','1321','1331') THEN 'SDBQ_TCTD_KKH'  
END) IS NOT NULL  
GROUP BY CURRENCY_CODE, 
CASE    
WHEN GL_LINE='783000' THEN 'CP_BHTG' 
WHEN substr(COA_CODE,1,1)='2' AND substr(COA_CODE,1,2) &lt;&gt; '20' 
AND substr(COA_CODE,3,1) NOT IN '9' THEN 'SDBQ_LOAN' 
WHEN COA_CODE IN ('1530', '1630') THEN 'SDBQ_TP_TCKT'  
WHEN COA_CODE like '10%' THEN 'SDBQ_TIENMAT'  
WHEN COA_CODE like '11%' THEN 'SDBQ_TG_NHNN'  
WHEN COA_CODE in ('1311','1321','1331') THEN 'SDBQ_TCTD_KKH'  
END ,    
CASE  
WHEN GL_LINE='783000' THEN 'Chi phí bảo hiểm tiền gửi'  
WHEN substr(COA_CODE,1,1)='2' AND substr(COA_CODE,1,2) &lt;&gt; '20' 
AND substr(COA_CODE,3,1) NOT IN '9' THEN 'Số dư bình quân Cho vay'   
WHEN COA_CODE IN ('1530', '1630') THEN 'Số dư bình quân trái phiếu'  
WHEN COA_CODE like '10%' THEN 'Số dư bình quân tiền mặt'  
WHEN COA_CODE like '11%' THEN 'Số dư bình quân tiền gửi NHNN'  WHEN COA_CODE in ('1311','1321','1331') THEN 'Số dư bình quân tiền gửi KKH tại TCTD'  
END 
</sql>
    <limit>0</limit>
