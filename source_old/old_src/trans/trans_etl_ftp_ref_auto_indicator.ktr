  <step>
    <name>8.TN_TCTD_KKH</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT  
LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) TRANSACTION_DATE, 
'TN_TCTD_KKH' MA_CT ,  
'Thu lãi TCTD không kì hạn' TEN_CT, 
CASE WHEN CR_ACT = 'PL67001' THEN  DR_CCY  
 	WHEN DR_ACT = 'PL67001' THEN CR_CCY  
 	END CURRENCY_CODE, 
sum(CASE WHEN CR_ACT = 'PL67001' THEN  DR_AMT 
 	WHEN DR_ACT = 'PL67001' THEN CR_AMT*(-1) 
 	END) VALUE 
 	FROM smy.FT_ENTRY a  
WHERE PARTITION_DATE BETWEEN  
trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH') AND 
to_date('${PRD_ID}','YYYYMMDD') 
AND EXISTS  
(SELECT 1 FROM smy.PL_TXN_DAILY b  WHERE b.TXN_DATE BETWEEN  
trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH') AND 
to_date('${PRD_ID}','YYYYMMDD') 
AND b.PL_CATE_CODE  ='67001' 
AND a.FT_ID = b.RELATION_TXN_NBR) 
GROUP BY  
CASE WHEN CR_ACT = 'PL67001' THEN  DR_CCY   	WHEN DR_ACT = 'PL67001' THEN CR_CCY  
 	END </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
