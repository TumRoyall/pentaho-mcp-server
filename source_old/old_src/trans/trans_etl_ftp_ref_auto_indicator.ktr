    <connection>ods_dc</connection>
    <sql>SELECT
LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) as TRANSACTION_DATE,
'SDBQ_CASA' MA_CT ,
'Số dư bình quân KKH' TEN_CT,
CURRENCY_CODE ,
sum(FCY_AMT)/27 VALUE
FROM SMY.CASA_BAL a
FULL JOIN ODS.DATES_REF b
ON a.TXN_DATE = b.LAST_WORKING_DATE
WHERE b.CALENDAR_DATE BETWEEN
trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH')+1 AND
to_date('${PRD_ID}','YYYYMMDD')+1
AND substr(COA_CODE,1,2) in('42','43')
AND Substr(PRODUCT_CODE,1,2) IN ('11','12','13')
GROUP BY CURRENCY_CODE</sql>
