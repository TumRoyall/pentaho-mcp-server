  <step>
    <name>7.SDBQ_TPCP_AFS</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT  
LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) 
TRANSACTION_DATE, 
'SDBQ_TPCP_AFS' MA_CT , 	 
'Số dư bình quân Giấy tờ có giá - TPCP - AFS' TEN_CT, 
CURRENCY, 
(-1)*Sum(ACCOUNTING_AMOUNT)/27 
FROM SMY.SM_BOND_PAPER_BAL a 
FULL JOIN ODS.DATES_REF b 
ON a.TXN_DATE = b.LAST_WORKING_DATE  WHERE b.CALENDAR_DATE BETWEEN 
trunc(to_date('${PRD_ID}','YYYYMMDD'),'MONTH')+1 AND 
to_date('${PRD_ID}','YYYYMMDD')+1 
AND substr(a.COA_CODE,1,3) = '151' 
AND substr(a.IMT_SHORTNAME,1,3) in ('BAFIAFS','TRFIAFS') GROUP BY CURRENCY 
</sql>
