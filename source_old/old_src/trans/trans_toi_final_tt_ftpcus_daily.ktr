    <sql>select 'TIENVAY' ftp_source,a.makh, b.hoten tenkh, b.sector, a.soku hopdong, 
'CKH' term, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end) plcateg, a.cn company,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end) linegl, a.nte loaitien, 
sum (-(a.ftp_hddb + a.ftp_sdc)) amt_fcy,
sum (-(a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_lcy,  
a.transaction_date, a.khoi, 
a.product_code, 
sum (-(a.ftp_tdc + (a.sodu_ftp * a.biendo_khoi/36000) + (a.sodu_ftp * a.biendo_vungmien/36000))) amt_fcy_tt,
sum (-(a.ftp_tdc + (a.sodu_ftp * a.biendo_khoi/36000) + (a.sodu_ftp * a.biendo_vungmien/36000)) * c.conversion_rate) amt_lcy_tt
from apps.ftp_cal_bv_tienvay a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where transaction_date = to_date(${PRD_ID},'yyyyMMdd') and a.khoi is not null
and case when ftp_hddb &lt;&gt; 0 then ftp_hddb else ftp_sdc end>0
group by a.makh, b.hoten, b.sector, a.soku, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end), a.cn,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end), a.nte, a.transaction_date, a.khoi, a.product_code
union all
select 'THAUCHI' ftp_source,a.makh, b.hoten tenkh, b.sector, a.soku hopdong, 
'KKH' term, (case when a.khoi = 'FI' then 'PL68091'
when a.khoi = 'CIB' then 'PL68093'
when a.khoi = 'SME' then 'PL68095'
when a.khoi = 'INDIV' then 'PL68097' end) plcateg, a.cn company,
(case when a.khoi = 'FI' then '666302'
when a.khoi = 'CIB' then '666500'
when a.khoi = 'SME' then '666700'
when a.khoi = 'INDIV' then '666902' end)  linegl, a.nte loaitien, 
sum (-a.ftp_sdc) amt_fcy, 
sum (-a.ftp_sdc * c.conversion_rate) amt_lcy, 
a.transaction_date, a.khoi, 
a.product_code, 
sum (-(a.ftp_trdc + a.sodu_goc * a.biendo_khoi/36000 + a.sodu_goc * a.biendo_vungmien/36000)) amt_fcy_tt,
sum (-(a.ftp_trdc + a.sodu_goc * a.biendo_khoi/36000 + a.sodu_goc * a.biendo_vungmien/36000) * c.conversion_rate) amt_lcy_tt
from apps.ftp_cal_mv_thauchi a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where  transaction_date = to_date(${PRD_ID},'yyyyMMdd') and a.khoi is not null
group by a.makh, b.hoten, b.sector, a.soku, (case when a.khoi = 'FI' then 'PL68091'
when a.khoi = 'CIB' then 'PL68093'
when a.khoi = 'SME' then 'PL68095'
when a.khoi = 'INDIV' then 'PL68097' end), a.cn,
(case when a.khoi = 'FI' then '666302'
when a.khoi = 'CIB' then '666500'
when a.khoi = 'SME' then '666700'
when a.khoi = 'INDIV' then '666902' end) , a.nte, a.transaction_date, a.khoi, a.product_code
union all
select 'THE' ftp_source,a.makh, b.hoten tenkh, b.sector, a.contract_number hopdong, 
'KKH' term, (case when a.khoi = 'FI' then 'PL68091'
when a.khoi = 'CIB' then 'PL68093'
when a.khoi = 'SME' then 'PL68095'
when a.khoi = 'INDIV' then 'PL68097' end) plcateg, a.co_code company,
(case when a.khoi = 'FI' then '666302'
when a.khoi = 'CIB' then '666500'
when a.khoi = 'SME' then '666700'
when a.khoi = 'INDIV' then '666902' end)  linegl, a.ccy loaitien, 
sum (-a.sodu_ftp_sdc) amt_fcy, 
sum (-a.sodu_ftp_sdc * c.conversion_rate) amt_lcy, 
a.date_tx transaction_date, a.khoi, 
'26111' product_code, 
sum (-a.sodu_ftp_cdc) amt_fcy_tt,
sum (-a.sodu_ftp_cdc * c.conversion_rate) amt_lcy_tt
from apps.ftp_tr_saoke_the a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.date_tx
and to_currency = 'VND' 
and a.ccy = c.from_currency
where date_tx = to_date(${PRD_ID},'yyyyMMdd')
group by a.makh, b.hoten, b.sector, a.contract_number , (case when a.khoi = 'FI' then 'PL68091'
when a.khoi = 'CIB' then 'PL68093'
when a.khoi = 'SME' then 'PL68095'
when a.khoi = 'INDIV' then 'PL68097' end), a.co_code,
(case when a.khoi = 'FI' then '666302'
when a.khoi = 'CIB' then '666500'
when a.khoi = 'SME' then '666700'
when a.khoi = 'INDIV' then '666902' end) , a.ccy, a.date_tx, a.khoi
union all
select 'NO_QH' ftp_source,a.makh, b.hoten tenkh, b.sector, a.soku hopdong, 
'CKH' term, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end) plcateg, a.cn company,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end) linegl, a.nte loaitien, 
sum (-a.ftp_amt_with_alco) amt_fcy, 
sum (-a.ftp_amt_with_alco * c.conversion_rate) amt_lcy, 
a.transaction_date, a.khoi, 
a.product_code, 
sum (-(a.ftp_amount + a.sodu_ftp * a.biendo_khoi/36000 + a.sodu_ftp * biendo_vungmien/36000)) amt_fcy_tt,
sum (-(a.ftp_amount + a.sodu_ftp * a.biendo_khoi/36000 + a.sodu_ftp * biendo_vungmien/36000) * c.conversion_rate) amt_lcy_tt
from apps.ftp_tr_no_quahan a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where transaction_date = to_date(${PRD_ID},'yyyyMMdd') and a.khoi is not null
group by a.makh, b.hoten, b.sector, a.soku, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end), a.cn,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end), a.nte, a.transaction_date, a.khoi, a.product_code
union all
select 'TG_CKH' ftp_source,a.makh, b.hoten tenkh, b.sector, a.soso hopdong, 
'CKH' term, (case when a.khoi = 'FI' then 'PL67092'
when a.khoi = 'CIB' then 'PL67094'
when a.khoi = 'SME' then 'PL67096'
when a.khoi = 'INDIV' then 'PL67098'
when a.khoi = 'DVC' then 'PL67087' end) plcateg, a.cn company,
(case when a.khoi = 'FI' then '603202'
when a.khoi = 'CIB' then '603401'
when a.khoi = 'SME' then '603601'
when a.khoi = 'INDIV' then '603801'
when a.khoi = 'DVC' then '603606'
 end) linegl, a.nte loaitien, 
sum ((a.ftp_hddb + a.ftp_sdc)) amt_fcy, 
sum ((a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_lcy,
a.transaction_date, a.khoi, 
a.product_code, 
sum ((a.ftp_hddb + a.ftp_sdc)) amt_lcy_tt,
sum ((a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_fcy_tt
from apps.ftp_cal_mv_tg_ckh a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and a.khoi is not null
and ftp_prod  is not null
and ngayms &lt;= transaction_date
and ngaydh >= transaction_date
group by a.makh, b.hoten, b.sector, a.soso, (case when a.khoi = 'FI' then 'PL67092'
when a.khoi = 'CIB' then 'PL67094'
when a.khoi = 'SME' then 'PL67096'
when a.khoi = 'INDIV' then 'PL67098'
when a.khoi = 'DVC' then 'PL67087' end), a.cn,
(case when a.khoi = 'FI' then '603202'
when a.khoi = 'CIB' then '603401'
when a.khoi = 'SME' then '603601'
when a.khoi = 'INDIV' then '603801'
when a.khoi = 'DVC' then '603606'
 end), a.nte, a.transaction_date, a.khoi, a.product_code
union all
select 'TG_KKH' ftp_source,a.makh, b.hoten tenkh, b.sector, a.sotk hopdong, 
'KKH' term, (case when y_khoi = 'FI' then 'PL67091'
when y_khoi = 'CIB' then 'PL67093'
when y_khoi = 'SME' then 'PL67095'
when y_khoi = 'INDIV' then 'PL67097'
when y_khoi = 'DVC' then 'PL67087' end) plcateg, a.cn company,
(case when y_khoi = 'FI' then '603100'
when y_khoi = 'CIB' then '603300'
when y_khoi = 'SME' then '603500'
when y_khoi = 'INDIV' then '603700'
when y_khoi = 'DVC' then '603501' end)linegl, a.nte loaitien, 
sum (ftp_amt_with_alco ) amt_fcy, 
sum (ftp_amt_with_alco * c.conversion_rate) amt_lcy, 
a.transaction_date, a.y_khoi khoi, 
a.product_code, 
sum (a.ftp_amount) amt_fcy_tt,
sum (a.ftp_amount * c.conversion_rate) amt_lcy_tt
from apps.ftp_tr_tg a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where transaction_date = to_date(${PRD_ID},'yyyyMMdd') and y_khoi is not null
group by a.makh, b.hoten, b.sector, a.sotk, a.sodu,(case when y_khoi = 'FI' then 'PL67091'
when y_khoi = 'CIB' then 'PL67093'
when y_khoi = 'SME' then 'PL67095'
when y_khoi = 'INDIV' then 'PL67097'
when y_khoi = 'DVC' then 'PL67087' end), a.cn,
(case when y_khoi = 'FI' then '603100'
when y_khoi = 'CIB' then '603300'
when y_khoi = 'SME' then '603500'
when y_khoi = 'INDIV' then '603700'
when y_khoi = 'DVC' then '603501' end), a.nte, a.transaction_date, a.y_khoi, a.product_code
union all
select 'GD2_SK_SC' ftp_source,a.makh, b.hoten tenkh, b.sector, a.sotk hopdong, 
'CKH' term, (case when FTP_CODE = 'TD555' then 'PL69907'
when FTP_CODE in ('TD556','TD559') then 'PL68886'  end)  plcateg, a.y_co_code company,
(case when FTP_CODE in ('TD556','TD559') then '666601'
when a.khoi = 'CIB' and FTP_CODE = 'TD555' then '666609'
when a.khoi = 'SME' and FTP_CODE = 'TD555' then '666809'
when a.khoi = 'INDIV' and FTP_CODE = 'TD555'  then '667009' end) linegl, a.ccy loaitien, 
sum (-1*FTP_AMOUNT_WITH_ALCO) amt_fcy,
sum (-1*FTP_AMOUNT_WITH_ALCO * c.conversion_rate) amt_lcy, 
a.transaction_date, a.khoi, 
''product_code, 
sum (-1*FTP_AMOUNT_WITH_ALCO) amt_fcy_tt,
sum (-1*FTP_AMOUNT_WITH_ALCO * c.conversion_rate) amt_lcy_tt
from apps.ftp_tr_saoke_sc a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.ccy = c.from_currency
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
group by a.makh, b.hoten, b.sector, a.sotk, a.sodu,(case when FTP_CODE = 'TD555' then 'PL69907'
when FTP_CODE in ('TD556','TD559') then 'PL68886'  end) , a.y_co_code,
(case when FTP_CODE in ('TD556','TD559') then '666601'
when a.khoi = 'CIB' and FTP_CODE = 'TD555' then '666609'
when a.khoi = 'SME' and FTP_CODE = 'TD555' then '666809'
when a.khoi = 'INDIV' and FTP_CODE = 'TD555'  then '667009' end), a.ccy, a.transaction_date, a.khoi
union all
select 'DBB'ftp_source,a.makh, b.hoten tenkh, b.sector, a.soku hopdong, 
'CKH' term, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end) plcateg, a.cn company,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end) linegl, a.nte loaitien, 
sum (-(a.ftp_hddb + a.ftp_sdc)) amt_fcy,
sum (-(a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_lcy,  
a.transaction_date, a.khoi, 
a.product_code, 
sum (-(a.ftp_tdc + (a.sodu_ftp * a.biendo_khoi/36000) + (a.sodu_ftp * a.biendo_vungmien/36000))) amt_fcy_tt,
sum (-(a.ftp_tdc + (a.sodu_ftp * a.biendo_khoi/36000) + (a.sodu_ftp * a.biendo_vungmien/36000)) * c.conversion_rate) amt_lcy_tt
from apps.ftp_cal_bv_dbb a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where a.khoi is not null
and case when ftp_hddb &lt;&gt; 0 then ftp_hddb else ftp_sdc end>0
and transaction_date = to_date(${PRD_ID},'yyyyMMdd')
group by a.makh, b.hoten, b.sector, a.soku, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end), a.cn,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end), a.nte, a.transaction_date, a.khoi, a.product_code
union all
select 'W4PRE' ftP_source,'' makh, a.name tenkh, ''sector, a.bin hopdong, 
'KKH' term, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end) plcateg,  ''  company,
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end) linegl, a.currency loaitien, 
sum (ftp_amt_with_alco ) amt_fcy, 
sum (ftp_amt_with_alco * c.conversion_rate) amt_lcy, 
a.date_report transaction_date, a.khoi, 
'' product_code, 
sum (a.ftp_amount) amt_fcy_tt,
sum (a.ftp_amount * c.conversion_rate) amt_lcy_tt
from apps.FTP_WAY4_PREPAID_CARD_AMOUNT a
left join gl_daily_rates c
on c.conversion_date = a.date_report
and to_currency = 'VND' 
and a.currency = c.from_currency
where date_report = to_date(${PRD_ID},'yyyyMMdd')
group by a.name, a.bin, (case when a.khoi = 'FI' then 'PL68092'
when a.khoi = 'CIB' then 'PL68094'
when a.khoi = 'SME' then 'PL68096'
when a.khoi = 'INDIV' then 'PL68098' end),
(case when a.khoi = 'FI' then '666401'
when a.khoi = 'CIB' then '666602'
when a.khoi = 'SME' then '666801'
when a.khoi = 'INDIV' then '667001' end), a.currency, a.date_report, a.khoi
union all
select 'GD2_LB' ftp_source,'' makh, '' tenkh, '' sector, a.line hopdong, 
'KKH' term, (case when khoi = 'FI' then 'PL67091'
when khoi = 'CIB' then 'PL67093'
when khoi = 'SME' then 'PL67095'
when khoi = 'INDIV' then 'PL67097'
when khoi = 'DVC' then 'PL67087' end) plcateg, a.company,
(case when khoi = 'FI' then '603100'
when khoi = 'CIB' then '603300'
when khoi = 'SME' then '603500'
when khoi = 'INDIV' then '603700'
when khoi = 'DVC' then '603501' end)linegl, a.curr loaitien, 
sum (ftp_amt_with_alco ) amt_fcy, 
sum (ftp_amt_with_alco * c.conversion_rate) amt_lcy, 
a.date_Tx transaction_date, a.khoi, 
a.product_code, 
sum (a.ftp_amount) amt_fcy_tt,
sum (a.ftp_amount * c.conversion_rate) amt_lcy_tt
from apps.FTP_TR_LINE_BAL a
left join gl_daily_rates c
on c.conversion_date = a.date_Tx
and to_currency = 'VND' 
and a.curr = c.from_currency
where date_Tx = to_date(${PRD_ID},'yyyyMMdd')
group by a.line,(case when khoi = 'FI' then 'PL67091'
when khoi = 'CIB' then 'PL67093'
when khoi = 'SME' then 'PL67095'
when khoi = 'INDIV' then 'PL67097'
when khoi = 'DVC' then 'PL67087' end), a.company,
(case when khoi = 'FI' then '603100'
when khoi = 'CIB' then '603300'
when khoi = 'SME' then '603500'
when khoi = 'INDIV' then '603700'
when khoi = 'DVC' then '603501' end), a.curr, a.date_Tx, a.khoi, a.product_code
union all
select 'GD2_LB_M' ftp_source,'' makh, '' tenkh, '' sector, a.line hopdong, 
'KKH' term,''plcateg, a.company,
'' linegl, a.curr loaitien, 
sum (ftp_amt_with_alco ) amt_fcy, 
sum (ftp_amt_with_alco * c.conversion_rate) amt_lcy, 
a.trans_date transaction_date, ''khoi, 
'' product_code, 
sum (a.ftp_amount) amt_fcy_tt,
sum (a.ftp_amount * c.conversion_rate) amt_lcy_tt
from apps.FTP_TR_LINE_BAL_AVG_PENALTY a
left join gl_daily_rates c
on c.conversion_date = a.trans_date
and to_currency = 'VND' 
and a.curr = c.from_currency
where trans_date = to_date(${PRD_ID},'yyyyMMdd')
group by a.line, a.company,a.curr, a.trans_date
union all
select 'DUPHONG' ftp_source,a.makh, b.hoten tenkh, b.sector, a.soku hopdong, 
'KKH' term, (case when a.khoi = 'FI' then 'PL67091'
when a.khoi = 'CIB' then 'PL67093'
when a.khoi = 'SME' then 'PL67095'
when a.khoi = 'INDIV' then 'PL67097'
when a.khoi = 'DVC' then 'PL67087' end) plcateg, a.cn company,
(case when a.khoi = 'FI' then '603100'
when a.khoi = 'CIB' then '603300'
when a.khoi = 'SME' then '603500'
when a.khoi = 'INDIV' then '603700'
when a.khoi = 'DVC' then '603501' end)linegl, a.nte loaitien, 
sum (ftp_amt_with_alco ) amt_fcy, 
sum (ftp_amt_with_alco * c.conversion_rate) amt_lcy, 
a.transaction_date, a.khoi, 
''product_code, 
sum (a.ftp_amount) amt_fcy_tt,
sum (a.ftp_amount * c.conversion_rate) amt_lcy_tt
from apps.ftp_tr_ku_dp a
left join tr_khachhang b
on a.makh = b.makh
left join gl_daily_rates c
on c.conversion_date = a.transaction_Date
and to_currency = 'VND' 
and a.nte = c.from_currency
where transaction_date = to_date(${PRD_ID},'yyyyMMdd') and a.khoi is not null
group by a.makh, b.hoten, b.sector, a.soku,(case when a.khoi = 'FI' then 'PL67091'
when a.khoi = 'CIB' then 'PL67093'
when a.khoi = 'SME' then 'PL67095'
when a.khoi = 'INDIV' then 'PL67097'
when a.khoi = 'DVC' then 'PL67087' end), a.cn,
(case when a.khoi = 'FI' then '603100'
when a.khoi = 'CIB' then '603300'
when a.khoi = 'SME' then '603500'
when a.khoi = 'INDIV' then '603700'
when a.khoi = 'DVC' then '603501' end), a.nte, a.transaction_date, a.khoi</sql>
