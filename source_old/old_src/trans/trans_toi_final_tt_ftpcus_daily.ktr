    <sql>select a.makh,b.hoten tenkh, b.sector,  hopdong, term,to_char(plcateg) plcateg, company, linegl, loaitien, round (sum (amt_fcy),2) amt_fcy, round (sum (amt_lcy),2) amt_lcy,
transaction_date, a.khoi, product_code, round (sum (amt_fcy_tt),2) amt_fcy_tt, round (sum (amt_lcy_tt),2) amt_lcy_tt
from etl.etl_tmp_ftp_cus_daily a
