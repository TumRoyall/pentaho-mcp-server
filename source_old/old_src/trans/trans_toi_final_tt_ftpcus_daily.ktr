    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select makh, tenkh, sector, hopdong, term, sodu, plcateg, company, linegl, loaitien, round (sum (amt_fcy),2) amt_fcy, round (sum (amt_lcy),2) amt_lcy,
date1, transaction_date, khoi, product_code, round (sum (amt_fcy_tt),2) amt_fcy_tt, round (sum (amt_lcy_tt),2) amt_lcy_tt,to_date(transaction_date,'yyyyMMdd') trans_date
from
((select a.makh, b.hoten tenkh, b.sector, a.soku hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum (-(a.ftp_hddb + a.ftp_sdc)) amt_fcy,
sum (-(a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_lcy,  
null date1, a.report_date transaction_date, a.khoi, 
a.product_code, 
sum (-(a.ftp_tdc + (a.sodu_ftp * a.biendo_khoi/36000) + (a.sodu_ftp * a.biendo_vungmien/36000))) amt_fcy_tt,
sum (-(a.ftp_tdc + (a.sodu_ftp * a.biendo_khoi/36000) + (a.sodu_ftp * a.biendo_vungmien/36000)) * c.conversion_rate) amt_lcy_tt
from
((select makh, soku, 'CKH' kyhan, '0' sodu, 
(case when khoi = 'FI' then 'PL68092'
when khoi = 'CIB' then 'PL68094'
when khoi = 'SME' then 'PL68096'
when khoi = 'INDIV' then 'PL68098' end) plcateg,
cn,
(case when khoi = 'FI' then '666401'
when khoi = 'CIB' then '666602'
when khoi = 'SME' then '666801'
when khoi = 'INDIV' then '667001' end) linegl,
nte, ftp_tdc, ftp_sdc, khoi, product_code, transaction_date,
'20161130' report_date,ftp_hddb, sodu_ftp, biendo_khoi, biendo_vungmien
from 
(select * from apps.ftp_cal_bv_tienvay
where transaction_date between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.soku, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi, a.product_code)
union all
--sc
(select a.makh, b.hoten tenkh, b.sector, a.sotk hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum (-1*FTP_AMOUNT_WITH_ALCO) amt_fcy,
sum (-1*FTP_AMOUNT_WITH_ALCO * c.conversion_rate) amt_lcy,  
null date1, a.report_date transaction_date, a.khoi, 
null product_code, 
sum (-1*FTP_AMOUNT_WITH_ALCO) amt_fcy_tt,
sum (-1*FTP_AMOUNT_WITH_ALCO * c.conversion_rate) amt_lcy_tt
from
((
select ISSUER makh,sotk, 'CKH' kyhan, '0' sodu, 
(case when FTP_CODE = 'TD555' then 'PL69907'
when FTP_CODE in ('TD556','TD559') then 'PL68886'  end) plcateg,
cn,
(case when FTP_CODE in ('TD556','TD559') then '666601'
when khoi = 'CIB' and FTP_CODE = 'TD555' then '666609'
when khoi = 'SME' and FTP_CODE = 'TD555' then '666809'
when khoi = 'INDIV' and FTP_CODE = 'TD555'  then '667009' end) linegl,
ccy nte, 
'20161130' report_date,FTP_AMOUNT_WITH_ALCO,khoi--,b.hoten, b.sector
from 
(select * from apps.ftp_tr_saoke_sc
where transaction_date between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.sotk, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi)
--sc
union all
(select a.makh, b.hoten tenkh, b.sector, a.soku hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum (-a.ftp_sdc) amt_fcy, 
sum (-a.ftp_sdc * c.conversion_rate) amt_lcy, 
a.report_date date1, a.report_date transaction_date, a.khoi,  
a.product_code, 
sum (-(a.ftp_trdc + a.sodu_goc * a.biendo_khoi/36000 + a.sodu_goc * a.biendo_vungmien/36000)) amt_fcy_tt,
sum (-(a.ftp_trdc + a.sodu_goc * a.biendo_khoi/36000 + a.sodu_goc * a.biendo_vungmien/36000) * c.conversion_rate) amt_lcy_tt
from
((select makh, soku, 'KKH' kyhan, '0' sodu, 
(case when khoi = 'FI' then 'PL68091'
when khoi = 'CIB' then 'PL68093'
when khoi = 'SME' then 'PL68095'
when khoi = 'INDIV' then 'PL68097' end) plcateg,
cn,
(case when khoi = 'FI' then '666302'
when khoi = 'CIB' then '666500'
when khoi = 'SME' then '666700'
when khoi = 'INDIV' then '666902' end) linegl,
nte, ftp_trdc, ftp_sdc, khoi, product_code, transaction_date,
'20161130' report_date,((-1)*sodu_goc - sodu_dp)  sodu_goc, biendo_khoi, biendo_vungmien
from 
(select * from apps.ftp_cal_mv_thauchi
where transaction_date between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.soku, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi, a.product_code)
union all
(select a.makh, b.hoten tenkh, b.sector, a.soku hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum (-a.sodu_ftp_sdc) amt_fcy, 
sum (-a.sodu_ftp_sdc * c.conversion_rate) amt_lcy, 
a.report_date date1, a.report_date transaction_date, a.khoi, 
a.product_code, 
sum (-a.sodu_ftp_cdc) amt_fcy_tt,
sum (-a.sodu_ftp_cdc * c.conversion_rate) amt_lcy_tt
from
((select makh, contract_number soku, 'KKH' kyhan, '0' sodu, 
(case when khoi = 'FI' then 'PL68091'
when khoi = 'CIB' then 'PL68093'
when khoi = 'SME' then 'PL68095'
when khoi = 'INDIV' then 'PL68097' end) plcateg,
co_code cn,
(case when khoi = 'FI' then '666302'
when khoi = 'CIB' then '666500'
when khoi = 'SME' then '666700'
when khoi = 'INDIV' then '666902' end) linegl,
ccy nte, sodu_ftp_cdc, sodu_ftp_sdc, khoi, '26111' product_code, date_tx transaction_date,
'20161130' report_date
from 
(select * from apps.ftp_tr_saoke_the
where date_tx between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.soku, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi, a.product_code)
union all
(select a.makh, b.hoten tenkh, b.sector, a.soku hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum (-a.ftp_sdc) amt_fcy, 
sum (-a.ftp_sdc * c.conversion_rate) amt_lcy, 
null date1, a.report_date transaction_date, a.khoi, 
a.product_code, 
sum (-(a.ftp_tdc + a.sodu_ftp * a.biendo_khoi/36000 + a.sodu_ftp * biendo_vungmien/36000)) amt_fcy_tt,
sum (-(a.ftp_tdc + a.sodu_ftp * a.biendo_khoi/36000 + a.sodu_ftp * biendo_vungmien/36000) * c.conversion_rate) amt_lcy_tt
from
((select makh, soku, 'CKH' kyhan, '0' sodu, 
(case when khoi = 'FI' then 'PL68092'
when khoi = 'CIB' then 'PL68094'
when khoi = 'SME' then 'PL68096'
when khoi = 'INDIV' then 'PL68098' end) plcateg,
cn,
(case when khoi = 'FI' then '666401'
when khoi = 'CIB' then '666602'
when khoi = 'SME' then '666801'
when khoi = 'INDIV' then '667001' end) linegl,
nte, ftp_amount ftp_tdc, ftp_amt_with_alco ftp_sdc, khoi, product_code, transaction_date,
biendo_khoi, biendo_vungmien, sodu_ftp,
'20161130' report_date
from 
(select * from apps.ftp_tr_no_quahan
where transaction_date between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.soku, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi, a.product_code)
union all
(select a.makh, b.hoten tenkh, b.sector, a.sotk hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum (ftp_sdc ) amt_fcy, 
sum (ftp_sdc * c.conversion_rate) amt_lcy, 
null date1, a.report_date transaction_date, a.khoi, 
a.product_code, 
sum (a.ftp_tdc) amt_fcy_tt,
sum (a.ftp_tdc * c.conversion_rate) amt_lcy_tt
from
((select makh, sotk, 'KKH' kyhan, '0' sodu, 
(case when y_khoi = 'FI' then 'PL67091'
when y_khoi = 'CIB' then 'PL67093'
when y_khoi = 'SME' then 'PL67095'
when y_khoi = 'INDIV' then 'PL67097'
when y_khoi = 'DVC' then 'PL67087' end) plcateg,
cn,
(case when y_khoi = 'FI' then '603100'
when y_khoi = 'CIB' then '603300'
when y_khoi = 'SME' then '603500'
when y_khoi = 'INDIV' then '603700'
when y_khoi = 'DVC' then '603501' end) linegl,
nte, ftp_amount ftp_tdc, ftp_amt_with_alco ftp_sdc, y_khoi khoi, product_code, transaction_date,
'20161130' report_date
from 
(select * from apps.ftp_tr_tg
where transaction_date between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
and substr (gl,1,2) in ('42', '43')
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.sotk, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi, a.product_code)
union all
(select a.makh, b.hoten tenkh, b.sector, a.soso hopdong, a.kyhan term, a.sodu, a.plcateg, a.cn company,
a.linegl, a.nte loaitien, 
sum ((a.ftp_hddb + a.ftp_sdc)) amt_fcy, 
sum ((a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_lcy,
null date1, a.report_date transaction_date, a.khoi, 
a.product_code,
sum ((a.ftp_hddb + a.ftp_sdc)) amt_lcy_tt,
sum ((a.ftp_hddb + a.ftp_sdc) * c.conversion_rate) amt_fcy_tt
from
((select makh, soso, 'CKH' kyhan, '0' sodu, 
(case when khoi = 'FI' then 'PL67092'
when khoi = 'CIB' then 'PL67094'
when khoi = 'SME' then 'PL67096'
when khoi = 'INDIV' then 'PL67098'
when khoi = 'DVC' then 'PL67087' end) plcateg,
cn,
(case when khoi = 'FI' then '603202'
when khoi = 'CIB' then '603401'
when khoi = 'SME' then '603601'
when khoi = 'INDIV' then '603801'
when khoi = 'DVC' then '603606'
 end) linegl,
nte, ftp_trdc ftp_tdc, ftp_sdc, khoi, product_code, transaction_date,
'20161130' report_date,ftp_hddb
from 
(select * from  apps.ftp_cal_mv_tg_ckh
where transaction_date between trunc(to_date('20161130','yyyyMMdd'),'MONTH') and to_date('20161130','yyyyMMdd')
and ftp_prod is not null
)) a
left join
(select makh, hoten, sector from tr_khachhang) b
on a.makh = b.makh
left join
(select conversion_date, from_currency, conversion_rate
from gl_daily_rates
where conversion_date = to_date('20161130','yyyyMMdd')
and to_currency = 'VND') c
on a.nte = c.from_currency)
group by a.makh, b.hoten, b.sector, a.soso, a.kyhan, a.sodu, a.plcateg, a.cn,
a.linegl, a.nte, a.report_date, a.khoi, a.product_code))
group by makh, tenkh, sector, hopdong, term, sodu, plcateg, company, linegl, loaitien,
date1, transaction_date, khoi, product_code</sql>
