    <connection>tckt_dc</connection>
    <sql>SELECT a.transaction_date,
    a.KHOI,
    b.PHAN_KHUC pkkh,
    a.PRODUCT_CODE,
    'RWA_CR_TT1' type,
    sum(RWA) / 1e9 rwa
FROM etl.ORS_MB_CAR_RRTD_KHOANPHAIDOI a
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY b
    ON a.CUSTOMER_ID = b.MAKH
    AND b.TRANSACTION_DATE = a.TRANSACTION_DATE
WHERE a.TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
    AND a.khoi IN ('CIB', 'SME', 'INDIV', 'NHS')
GROUP BY a.transaction_date,
    a.KHOI,
    b.PHAN_KHUC,
    a.PRODUCT_CODE
</sql>
