  <step>
    <name>RWA_OR</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH DT_KHOI AS
 (SELECT A.TRANSACTION_DATE, A.KHOI, NVL(A.DTTTRR, 0) + NVL(B.DTTTRR, 0) DTTTRR
    FROM (SELECT TRANSACTION_DATE, KHOI, SUM(AMOUNT) / 1E9 DTTTRR
            FROM (SELECT TRANSACTION_DATE, KHOI, IDX, AMOUNT
                    FROM APPS.MB_TR_PL_KHOI UNPIVOT(AMOUNT FOR KHOI IN(TREASURY AS
                                                                       'TRE',
                                                                       INDIV AS
                                                                       'INDIV',
                                                                       CIB AS
                                                                       'CIB',
                                                                       SMES AS
                                                                       'SME',
                                                                       NHS AS
                                                                       'NHS',
                                                                       FI AS
                                                                       'TRE'))
                   WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
                     AND IDX = 'A')
           GROUP BY TRANSACTION_DATE, KHOI) A
    LEFT JOIN ETL.FILE_RAROC_DC_CHITIEU B
      ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
     AND A.KHOI = B.KHOI
     AND B.PKKH IS NULL),
DT_PKKH AS
 (SELECT TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
         B.KHOI,
         CASE
           WHEN A.MAKH IN ('3000',
                           '8000',
                           '1000',
                           '1100',
                           '1910',
                           '100',
                           '999999',
                           '1700') THEN
            'KXD'
           ELSE
            NVL(B.PHAN_KHUC, 'KXD')
         END PKKH,
         NVL(A.PRODUCT_CODE, 'KXD') PRODUCT_CODE,
         SUM(NVL(A.DTTTRR_I, 0)) DTTTRR
    FROM APPS.REP_TOI_FINAL_MONTH_LK A
    LEFT JOIN APPS.FIN_SMY_CUSTOMER_MONTHLY B
      ON A.MAKH = B.MAKH
     AND A.TRANSACTION_DATE = B.TRANSACTION_DATE
   WHERE A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
     AND B.KHOI IN ('NHS', 'INDIV', 'CIB', 'SME')
   GROUP BY B.KHOI,
            CASE
              WHEN A.MAKH IN ('3000',
                              '8000',
                              '1000',
                              '1100',
                              '1910',
                              '100',
                              '999999',
                              '1700') THEN
               'KXD'
              ELSE
               NVL(B.PHAN_KHUC, 'KXD')
            END,
            NVL(A.PRODUCT_CODE, 'KXD')),
RWA_OR_KHOI AS
 (SELECT A.TRANSACTION_DATE,
         B.KHOI,
         A.TYPE,
         A.RWA * B.DTTTRR / (SELECT SUM(DTTTRR) FROM DT_KHOI) AS RWA
    FROM ETL.FILE_RWA_BS A
    JOIN DT_KHOI B
      ON 1 = 1
   WHERE A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
     AND A.TYPE = 'RWA_OR')
SELECT A.TRANSACTION_DATE,
       A.KHOI,
       B.PKKH,
       B.PRODUCT_CODE,
       A.TYPE,
       A.RWA * NVL(B.DTTTRR, 1) / NVL(C.DTTTRR, 1) AS RWA
  FROM RWA_OR_KHOI A
  LEFT JOIN DT_PKKH B
    ON A.KHOI = B.KHOI
  LEFT JOIN (SELECT KHOI, SUM(DTTTRR) AS DTTTRR FROM DT_PKKH GROUP BY KHOI) C
    ON B.KHOI = C.KHOI</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
