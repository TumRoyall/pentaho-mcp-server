  <step>
    <name>MPA_MPA01</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mpa_dc</connection>
    <sql>SELECT transaction_date,
	khoi,
	(value * (-1)) cphd_SCS
FROM (SELECT 
		to_date('${PRD_ID}', 'YYYYMMDD') transaction_date, 
		sum(CIB) CIB,
		sum(SME) SME,
		sum(KHCN) KHCN,
		sum(KHCL) KHCL,
		sum(NHS) NHS,
		sum(TRE) TRE,
		sum(DAU_TU) DAU_TU,
		sum(BB) BB,
		sum(TONG) TOANHANG
		FROM mpa.MPA_MPA01
	WHERE to_date(period, 'YYYYMM') BETWEEN TRUNC(to_date('${PRD_ID}', 'YYYYMMDD'), 'YEAR') AND to_date('${PRD_ID}', 'YYYYMMDD')
	AND MA_CHI_TIEU = '4')
unpivot
	(value FOR khoi IN 
		(CIB, 
		SME,
		KHCN AS 'INDIV',
		KHCL AS 'DVC',
		NHS,
		TRE,
		DAU_TU AS 'INVEST',
		BB,
		TOANHANG AS 'TOAN HANG'))
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
      <value-meta>
        <type>Timestamp</type>
        <storagetype>normal</storagetype>
        <name>TRANSACTION_DATE</name>
        <length>0</length>
        <precision>-1</precision>
        <origin>MPA_MPA01</origin>
        <comments>TRANSACTION_DATE</comments>
        <conversion_Mask/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol>,</grouping_symbol>
        <currency_symbol/>
        <trim_type>none</trim_type>
        <case_insensitive>N</case_insensitive>
        <collator_disabled>Y</collator_disabled>
        <collator_strength>0</collator_strength>
        <sort_descending>N</sort_descending>
