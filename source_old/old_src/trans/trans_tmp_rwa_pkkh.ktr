  <step>
    <name>RWA_CR_TSK</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with rwa_cr AS (
    SELECT a.transaction_date,
        a.KHOI,
        b.PHAN_KHUC,
        a.PRODUCT_CODE,
        sum(nvl(RWA, 0)) rwa
    FROM etl.ORS_MB_CAR_RRTD_KHOANPHAIDOI a
    LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY b
        ON a.CUSTOMER_ID = b.MAKH
        AND b.TRANSACTION_DATE = a.TRANSACTION_DATE
    WHERE a.TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
    AND a.khoi IN ('CIB', 'SME', 'INDIV', 'NHS') 
    GROUP BY a.transaction_date,
        a.KHOI,
        b.PHAN_KHUC,
        a.PRODUCT_CODE)
SELECT a.transaction_date,
    a.khoi,
    b.PHAN_KHUC,
    b.product_code,
    a.TYPE,
    a.RWA * nvl(b.RWA, 1) / nvl(c.RWA, 1) AS RWA
FROM ETL.FILE_RWA_BS a
LEFT JOIN rwa_cr b
    ON a.KHOI = b.KHOI
    AND b.khoi in ('CIB', 'SME', 'INDIV', 'NHS')
LEFT JOIN (SELECT KHOI, SUM(RWA) AS RWA FROM rwa_cr GROUP BY KHOI) c
    ON b.KHOI = c.KHOI
where a.TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
and a.TYPE = 'RWA_CR_TSK' and a.khoi &lt;&gt; 'TOAN HANG'
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
      <value-meta>
        <type>Timestamp</type>
        <storagetype>normal</storagetype>
        <name>TRANSACTION_DATE</name>
        <length>0</length>
        <precision>-1</precision>
        <origin>RWA_CR_TSK</origin>
        <comments>TRANSACTION_DATE</comments>
        <conversion_Mask/>
