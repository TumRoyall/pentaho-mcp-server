  <step>
    <name>MPA_MPA03_05 (NEW)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mpa_dc</connection>
    <sql>WITH mpa_0305 as (
    SELECT
	    decode(a.KHOI, 'KHCN', 'INDIV', 'KHCL', 'DVC', a.khoi) khoi,
	    decode(a.khoi, 'TRE', 'TRE', a.pkkh) pkkh,
	    SP_CAP_4 product_code,
	    LOAI_CHIA_SE,
	    - sum(AMOUNT) AMOUNT
	FROM mpa.MPA_MPA03_05 a
	WHERE to_date(PERIOD, 'YYYYMM') BETWEEN trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'YEAR') AND to_date('${PRD_ID}', 'YYYYMMDD')
	    AND MA_CHI_TIEU LIKE '4%'
	GROUP BY a.KHOI,
	    a.PKKH,
	    SP_CAP_4,
	    LOAI_CHIA_SE
),
mpa_0305_fix_pk AS (
    SELECT a.KHOI,
        CASE
        	WHEN trim('_' FROM a.pkkh) IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
        	ELSE nvl(b.PKKH2, a.PKKH)
        END pkkh,
        product_code,
        LOAI_CHIA_SE,
        sum(AMOUNT) AMOUNT
    FROM mpa_0305 a
        LEFT JOIN (
            SELECT pkkh2,
                pkkh4
            FROM mpa.ORS_MAP_SECTOR_PKKH
            WHERE TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
            GROUP BY pkkh2,
                pkkh4
        ) b ON trim(
            '_'
            FROM a.pkkh
        ) = b.pkkh4
    GROUP BY a.KHOI,
        CASE
        	WHEN trim('_' FROM a.pkkh) IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
        	ELSE nvl(b.PKKH2, a.PKKH)
        END,
        product_code,
        LOAI_CHIA_SE
),
t as
(SELECT *
FROM mpa_0305_fix_pk PIVOT (
        sum(AMOUNT) FOR LOAI_CHIA_SE IN (
            'Trước chia sẻ' AS Value_TCS,
            'Sau chia sẻ' AS Value_SCS,
            'Chia sẻ NHS' AS Value_chia_se_NHS,
            'Chia sẻ Tre' AS Value_chia_se_TRE
        )
    ))
SELECT to_date('${PRD_ID}', 'YYYYMMDD') transaction_date,
	khoi,
	CASE
		WHEN REGEXP_LIKE(pkkh, '_') THEN 'KXD'
		ELSE pkkh
	END pkkh,
	product_code,
	sum(nvl(value_tcs,0)) value_tcs,
	sum(nvl(value_scs,0)) value_scs,
	sum(nvl(Value_chia_se_NHS,0)) Value_chia_se_NHS,
	sum(nvl(Value_chia_se_TRE,0)) Value_chia_se_TRE
FROM t
GROUP BY khoi,
	CASE
		WHEN REGEXP_LIKE(pkkh, '_') THEN 'KXD'
		ELSE pkkh
	END,
	product_code
</sql>
