  <step>
    <name>step1</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH
    TMP_MAKH_YEAR AS
    (   SELECT 
            MAKH
        FROM 
            apps.fin_loan_smy_monthly
        WHERE 
            TRANSACTION_DATE BETWEEN ADD_MONTHS(to_date('${PRD_ID}', 'YYYYMMDD'), -12) AND 
            ADD_MONTHS(to_date('${PRD_ID}', 'YYYYMMDD'), -1)
        AND MAKH IS NOT NULL
        GROUP BY 
            MAKH 
    ) 
    ,
    tmp_ku AS 
    (   SELECT
            to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
            SUBSTR(a.ARRANGEMENT_NBR,1,14)    LD_ID,
            a.COA_CODE                        GL,
            a.T24_CUST_ID                     MAKH,
            a.CURRENCY_CODE                   NTE,
            NULL                              RATE,
            a.VALUE_DATE                      NGAYVAY,
            a.MATURITY_DATE                   NGAYDH,
            a.INT_RATE_TYPE                   KIEULS,
            a.INT_KEY                         KEY,
            a.CIC_PURPOSE_CODE                CIC_PURPOSE,
            a.TERM                            KYHAN,
            a.TERM_TYPE                       HANVAY,
            a.CUST_CREDIT_RATING              nhomno_xhtd,
            NULL                              nhomno_liendoi,
            a.ARRANGEMENT_CREDIT_RATING       credit_status,
            a.ORIG_VALUE_DATE                 NGAYGH,
            NULL                              LICHGH,
            a.FUND_SOURCE_CODE                SOURCE_OF_FUND,
            a.SECTOR_CODE                     SECTOR,
            a.DIVISION_CODE                   KHOI,
            a.LOAN_INDUSTRY_CODE              INDUSTRY_CODE,
            a.BRANCH_CODE                     CN,
            NULL                              TENCN,
            NULL                              CN_CAP1,
            NULL                              TENCN_CAP1,
            a.CATE_CODE                       category,
            a.SUB_PRODUCT_CODE                sub_product,
            a.LOAN_INDUSTRY_CODE              UOL,
            a.ARRANGEMENT_CROSS_SELL_RM_CODE  RM_CODE,
            a.PRODUCT_CODE,
            a.LEGACY_CONTRACT_ID         LEGACY_ID,
            a.CAMPAIGN_CODE              MBLD_TYPE,
            a.LIMIT_CODE                 LIMIT_REF,
            a.PRODUCT_GROUP_CODE         PRODUCTGR_CODE,
            a.PROGRAM_CODE               PRODUCT_TYPE,
            a.DOUBTFUL_STATUS            DOUBTFUL_STA,
            a.INT_RATE_SUPPORT_FLAG      HOTRO_LS,
            a.SUPPORT_PURPOSE_CODE       LINHVUC_HT,
            a.PROJECT_CODE               PROJECT_ID,
            NULL                         LD_12,
            a.DLGN_LOAN_TYPE             LOAN_TYPE,
            a.DLGN_T24_CUST_ID           PARTIC_ID,
            a.DLGN_PARTY_NAME            PARTIC_NAME,
            a.DLGN_PCT                   PARTICI_PERC,
            a.DLGN_CONTRACT_NBR          HD_DTT_UT,
            a.DLGN_CHG_PCT               TYLE_PHI,
            a.DLGN_ACTUAL_PCT            TYLE_TCTD,
            a.DLGN_RECEIVING_ACCOUNT_NBR TK_NHANVON,
            a.DLGN_SENDING_ACCOUNT_NBR   TK_CHUYENVON,
            a.KY_CDLS, ---- them moi
            a.ARRANGEMENT_TYPE, --- them moi
            a.ORG_INT_RATE_CHANGE_DATE, --- them moi
            ROUND ( SUM ( COALESCE (a.FIX_INT_RATE, 0) * a.LCY_AMT / COALESCE (b.duno_thoidiem, 1)
            ), 4 ) INTEREST_FIX,
            ROUND ( SUM ( COALESCE (a.INT_SPREAD, 0) * a.LCY_AMT / COALESCE (b.duno_thoidiem, 1) ) 
            , 4 ) BIENDOLS,
            ROUND ( SUM ( COALESCE (a.ARRANGEMENT_INT_RATE, 0) * a.LCY_AMT / COALESCE 
            (b.duno_thoidiem, 1) ), 4 ) LS,
            SUM (NVL(LCY_AMT, 0))       duno_thoidiem
        FROM
            ETL.ODS_LOAN_BAL_MTH a
        LEFT JOIN 
            (   SELECT
                    SUBSTR(ARRANGEMENT_NBR,1,14) SOKU,
                    SUM (NVL(LCY_AMT, 0))        duno_thoidiem
                FROM
                    ETL.ODS_LOAN_BAL_MTH
                WHERE
                    TXN_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                AND SUBSTR (COA_CODE, 1, 1) = '2'
                AND SUBSTR (COA_CODE, 1, 2) &lt;&gt; '20'
                GROUP BY
                    SUBSTR(ARRANGEMENT_NBR,1,14) ) b 
        ON 
            SUBSTR(a.ARRANGEMENT_NBR,1,14) = b.SOKU
        WHERE
            TXN_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
        AND SUBSTR (COA_CODE, 1, 1) = '2'
        AND SUBSTR (COA_CODE, 1, 2) &lt;&gt; '20'
        GROUP BY
            SUBSTR(a.ARRANGEMENT_NBR,1,14),
            a.COA_CODE ,
            a.T24_CUST_ID ,
            a.CURRENCY_CODE ,
            a.VALUE_DATE ,
            a.MATURITY_DATE ,
            a.INT_RATE_TYPE ,
            a.INT_KEY ,
            a.CIC_PURPOSE_CODE ,
            a.TERM ,
            a.TERM_TYPE ,
            a.CUST_CREDIT_RATING ,
            a.ARRANGEMENT_CREDIT_RATING ,
            a.ORIG_VALUE_DATE ,
            a.FUND_SOURCE_CODE ,
            a.SECTOR_CODE ,
            a.DIVISION_CODE ,
            a.ARRANGEMENT_CROSS_SELL_RM_CODE,
            a.LOAN_INDUSTRY_CODE ,
            a.BRANCH_CODE ,
            a.CATE_CODE ,
            a.SUB_PRODUCT_CODE ,
            a.LOAN_INDUSTRY_CODE ,
            a.PRODUCT_CODE,
            a.LEGACY_CONTRACT_ID ,
            a.CAMPAIGN_CODE ,
            a.LIMIT_CODE,
            a.PRODUCT_GROUP_CODE ,
            a.PROGRAM_CODE ,
            a.DOUBTFUL_STATUS ,
            a.INT_RATE_SUPPORT_FLAG ,
            a.SUPPORT_PURPOSE_CODE ,
            a.PROJECT_CODE ,
            a.DLGN_LOAN_TYPE ,
            a.DLGN_T24_CUST_ID ,
            a.DLGN_PARTY_NAME ,
            a.DLGN_PCT ,
            a.DLGN_CONTRACT_NBR ,
            a.DLGN_CHG_PCT ,
            a.DLGN_ACTUAL_PCT ,
            a.DLGN_RECEIVING_ACCOUNT_NBR,
            a.DLGN_SENDING_ACCOUNT_NBR ,
            a.KY_CDLS,
            a.ARRANGEMENT_TYPE,
            a.ORG_INT_RATE_CHANGE_DATE
    )
SELECT
    to_date ('${PRD_ID}', 'YYYYMMDD')                                 transaction_date,
    COALESCE ( a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id )                   LD_ID,
    a.GL                                                                                COA_CODE,
    COALESCE ( a.MAKH, b.MAKH, c.MAKH, d.MAKH, e.MAKH, f.MAKH, g.makh, t.makh, u.makh ) MAKH,
    COALESCE ( a.NTE, g.CURRENCY_CODE, t.CURRENCY_CODE, u.CURRENCY_CODE )               NTE,
    COALESCE ( a.NGAYVAY, g.ARRANGEMENT_VALUE_DATE, u.ARRANGEMENT_OPENING_DATE )        VAL_DATE,
    COALESCE ( a.NGAYDH, g.FINAL_MATURITY_DATE, t.FINAL_MATURITY_DATE )                 MAT_DATE,
    COALESCE (a.KIEULS, g.INT_RATE_TYPE)                                                INT_RATE_TYPE 
    ,
    COALESCE (a.KEY, g.BI_KEY)                                 INTEREST_KEY,
    COALESCE (a.CIC_PURPOSE, g.CIC_PURPOSE_TYPE_CODE)          CIC_PURPOSE,
    COALESCE (a.KYHAN, g.ARRANGEMENT_TERM, t.ARRANGEMENT_TERM) LOC_TERM,
    COALESCE ( a.HANVAY,
    CASE
        WHEN COALESCE ( g.ARRANGEMENT_TERM, regexp_replace 
            (t.ARRANGEMENT_TERM, 
                '[azA-Z]+$', 
                '') ) &lt;= 12 
        THEN '1'
        WHEN COALESCE ( g.ARRANGEMENT_TERM, regexp_replace 
            (t.ARRANGEMENT_TERM, 
                '[azA-Z]+$', 
                '') ) &lt;= 60 
        THEN '2'
        ELSE '3'
    END ) NHOM_KYHAN,
    a.NHOMNO_XHTD,
    a.NHOMNO_LIENDOI,
    COALESCE ( a.CREDIT_STATUS, g.CREDIT_STATUS, t.CREDIT_STATUS, u.CREDIT_STATUS ) CREDIT_STATUS,
    COALESCE ( a.SOURCE_OF_FUND, g.FUND_SOURCE_CODE, t.FUND_SOURCE_CODE, u.FUND_SOURCE_CODE ) 
                                                       SOURCE_OF_FUND,
    COALESCE (a.SECTOR, n.sector)                         SECTOR,
    COALESCE (a.KHOI,b.khoi,c.khoi,d.khoi,e.khoi, n.khoi) KHOI,
    ( 
    CASE
        WHEN q.MAKH IS NOT NULL
        THEN 'CU' 
        ELSE 'MOI' 
    END ) CUS_TYPE,
    CASE 
        WHEN n.khoi = 'CIB' 
        AND n.sector IN ('3035', 
                         '3535') 
        THEN 'FDI' 
        WHEN n.khoi = 'SME' 
        THEN NVL(pk.pkkh, 'KXD')
        WHEN n.khoi IN ('INDIV', 
                        'NHS') 
        AND n.SECTOR IN ('1688', 
                         '1689', 
                         '1690', 
                         '1691', 
                         '1699', 
                         '1666', 
                         '1660') 
        THEN 'PRIVATE'
        WHEN n.khoi IN ('INDIV', 
                        'NHS') 
        AND n.SECTOR IN ('1888', 
                         '1889', 
                         '1890', 
                         '1891', 
                         '1746', 
                         '1747') 
        THEN 'PRIORITY'
        WHEN n.khoi IN ('INDIV', 
                        'NHS') 
        THEN 'MASS' 
        WHEN n.khoi = 'DVC' 
        THEN DECODE(n.SECTOR, '1095', 'BHXH VN', '1096', 'BHXH BQP', '1097', 'KBNN', '1098', 
            'Du an ODA', '1099', 'Bo ban nganh', 'DVC')
        ELSE NVL(n.khoi,'KXD') 
    END      PHAN_KHUC,
    n.APP_ST CUS_STATUS,
    COALESCE (a.INDUSTRY_CODE, g.LOAN_INDUSTRY_CODE, t.LOAN_INDUSTRY_CODE, u.LOAN_INDUSTRY_CODE) 
                                                                   INDUSTRY_CODE,
    COALESCE ( a.CN, g.BRANCH_CODE, t.BRANCH_CODE, u.BRANCH_CODE ) CN,
    COALESCE (a.TENCN, k.BRANCH_NAME_T24)                          BRANCH_NAME_T24,
    COALESCE (a.CN_CAP1, k.PARENT_BRANCH_CODE_T24)                 PARENT_BRANCH_CODE_T24,
    COALESCE (a.TENCN_CAP1, k.PARENT_BRANCH_NAME_T24)              PARENT_BRANCH_NAME_T24,
    k.TINH_THANH,
    k.VUNG_MIEN,
    k.TIEU_VUNG,
    COALESCE ( a.CATEGORY, g.CATE_CODE, t.CATE_CODE, u.CATE_CODE ) CATEGORY,
    COALESCE ( a.SUB_PRODUCT, g.SUB_PRODUCT_CODE, t.SUB_PRODUCT_CODE, u.SUB_PRODUCT_CODE ) 
                                                                                        SUB_PRODUCT,
    COALESCE ( a.UOL, g.LOAN_INDUSTRY_CODE, t.LOAN_INDUSTRY_CODE, u.LOAN_INDUSTRY_CODE ) UOL,
    COALESCE (a.PRODUCT_CODE, g.PRODUCT_CODE, u.PRODUCT_CODE)                            PRODUCT_CODE 
    ,
    CASE
        WHEN COALESCE (l.SP_DV, '0') IN ('SPSO', 
                                         'DVSO',
                                         'SPS1', 
                                         'DVS1') 
        THEN 'ONLINE'
        ELSE 'OFFLINE'
    END KENH_GD,
    COALESCE ( a.LEGACY_ID, g.LEGACY_CONTRACT_ID, t.LEGACY_CONTRACT_ID, u.LEGACY_CONTRACT_ID ) 
                                                             LEGACY_ID,
    COALESCE (a.MBLD_TYPE, g.CAMPAIGN_CODE, u.CAMPAIGN_CODE)           MBLD_TYPE,
    COALESCE ( a.LIMIT_REF, g.LIMIT_CODE, t.LIMIT_CODE, u.LIMIT_CODE ) LIMIT_REF,
    COALESCE ( a.PRODUCTGR_CODE, g.PRODUCT_GROUP_CODE, t.PRODUCT_GROUP_CODE, u.PRODUCT_GROUP_CODE
    )                                         PRODUCTGR_CODE,
    COALESCE (a.PRODUCT_TYPE, g.PROGRAM_CODE)                         PRODUCT_TYPE,
    COALESCE ( a.DOUBTFUL_STA, g.DOUBTFUL_STATUS, t.DOUBTFUL_STATUS ) DOUBTFUL_STATUS,
    COALESCE (a.PROJECT_ID, g.PROJECT_ID)                             PROJECT_ID,
    a.LOAN_TYPE,
    a.PARTIC_ID,
    a.PARTIC_NAME,
    a.PARTICI_PERC,
    a.HD_DTT_UT,
    a.TYLE_PHI,
    a.TYLE_TCTD,
    a.TK_NHANVON,
    a.TK_CHUYENVON,
    g.FTP_CODE,
    COALESCE (a.INTEREST_FIX, g.FIX_INT_RATE)         FIX_INT_RATE,
    COALESCE (a.BIENDOLS, g.INT_SPREAD, t.INT_SPREAD) INT_SPREAD,
    COALESCE (a.LS, g.INT_RATE, t.PENALTY_INT_RATE)   INT_RATE,
    COALESCE (a.DUNO_THOIDIEM, 0)                     DUNO_THOIDIEM_VND,
    COALESCE (b.DUNO_BINHQUAN, 0)                     DUNO_BINHQUAN_VND,
    COALESCE (c.DOANHSO_GIAINGAN_VND, 0)              DOANHSO_GIAINGAN_VND,
    COALESCE (c.DOANHSO_THUNO_VND, 0)                 DOANHSO_THUNO_VND,
    COALESCE (c.DOANHSO_THUNO_DUNGHAN, 0)             DOANHSO_THUNO_DUNGHAN_VND,
    COALESCE (c.DOANHSO_THUNO_TRUOCHAN, 0)            DOANHSO_THUNO_TRUOCHAN_VND,
    COALESCE (c.DOANHSO_THUNO_QUAHAN, 0)              DOANHSO_THUNO_QUAHAN_VND,
    COALESCE (d.NOMINAL_INTEREST_VND, 0)              NOMINAL_INTEREST_VND,
    COALESCE (d.REAL_INTEREST_VND, 0)                 REAL_INTEREST_VND,
    COALESCE (d.PENALTY_INTEREST_VND, 0)              PENALTY_INTEREST_VND,
    COALESCE (d.INTEREST_FTP_VND, 0)                  INTEREST_FTP_VND,
    COALESCE (d.INTEREST_FTP_TT_VND, 0)               INTEREST_FTP_TT_VND,
    COALESCE (e.NOMINAL_INTEREST_VND_LK, 0)           NOMINAL_INTEREST_VND_LK,
    COALESCE (e.REAL_INTEREST_VND_LK, 0)              REAL_INTEREST_VND_LK,
    COALESCE (e.PENALTY_INTEREST_VND_LK, 0)           PENALTY_INTEREST_VND_LK,
    COALESCE (e.INTEREST_FTP_VND_LK, 0)               INTEREST_FTP_VND_LK,
    COALESCE (e.INTEREST_FTP_TT_VND_LK, 0)            INTEREST_FTP_TT_VND_LK,
    COALESCE (f.RWA_CHOVAY, 0)                        RWA_CHOVAY_VND,
    a.KY_CDLS,
    a.ARRANGEMENT_TYPE,
    a.ORG_INT_RATE_CHANGE_DATE,
    null DUNO_BINHQUAN_LK_VND
FROM
    tmp_ku a 
FULL JOIN 
    (   SELECT
            ARRANGEMENT_NBR LD_ID,
            SUBSTR (a.PARTY_KEY, instr (a.PARTY_KEY,'.',1,2) + 1, LENGTH (a.PARTY_KEY) - instr 
            (a.PARTY_KEY,'.',1,2)) MAKH,
            DIVISION_CODE          KHOI,
            BRANCH_CODE            CN,
            SUM(LCY_AMT)           DUNO_BINHQUAN
        FROM 
            ETL.ODS_LOAN_BAL_AVG_MTH a
        WHERE 
            TXN_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
        GROUP BY
            ARRANGEMENT_NBR ,
            SUBSTR (a.PARTY_KEY, instr (a.PARTY_KEY,'.',1,2) + 1, LENGTH (a.PARTY_KEY) - instr 
            (a.PARTY_KEY,'.',1,2)) ,
            DIVISION_CODE ,
            BRANCH_CODE ) b
ON 
    a.ld_id = b.LD_ID
AND NVL(a.makh,0) = NVL(b.makh,0)
AND NVL(a.khoi,0) =NVL(b.khoi,0)
AND NVL(a.CN,0) =NVL(b.CN,0)
FULL JOIN 
    (   SELECT
            LD_ID,
            MAKH,
            khoi,
            CN,
            SUM (DOANHSO_GIAINGAN_VND)   DOANHSO_GIAINGAN_VND,
            SUM (DOANHSO_THUNO_VND)      DOANHSO_THUNO_VND,
            SUM (DOANHSO_THUNO_DUNGHAN)  DOANHSO_THUNO_DUNGHAN,
            SUM (DOANHSO_THUNO_TRUOCHAN) DOANHSO_THUNO_TRUOCHAN,
            SUM (DOANHSO_THUNO_QUAHAN)   DOANHSO_THUNO_QUAHAN
        FROM
            apps.FIN_LOAN_TRANS_DAILY
        WHERE
            TRANSACTION_DATE BETWEEN TRUNC (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') AND 
            to_date ('${PRD_ID}', 'YYYYMMDD')
        GROUP BY
            LD_ID,
            MAKH,
            KHOI,
            CN ) c 
ON 
    COALESCE (a.ld_id, b.ld_id) = c.ld_id
AND NVL(COALESCE (a.makh, b.makh),0) = NVL(c.makh,0)
AND NVL(COALESCE (a.khoi, b.khoi),0) = NVL(c.khoi,0)
AND NVL(COALESCE (a.CN, b.CN),0) = NVL(c.CN,0)
LEFT JOIN 
    (   SELECT
            taikhoan LD_ID,
            MAKH,
            KHOI,
            CN,
            COALESCE (SUM (NOMINAL_INTEREST_VND), 0) NOMINAL_INTEREST_VND,
            COALESCE (SUM (REAL_INTEREST_VND), 0)    REAL_INTEREST_VND,
            COALESCE (SUM (PENALTY_INTEREST_VND), 0) PENALTY_INTEREST_VND,
            COALESCE (SUM (INTEREST_FTP_VND), 0)     INTEREST_FTP_VND,
            COALESCE (SUM (INTEREST_FTP_TT_VND), 0)  INTEREST_FTP_TT_VND
        FROM
            apps.mb_agg_nim_m
        WHERE
            TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
        AND d_type = 'LOAN'
        GROUP BY
            TAIKHOAN,
            MAKH,
            KHOI,
            CN ) d 
ON 
    COALESCE (a.ld_id, b.ld_id, c.ld_id) = d.ld_id
AND NVL(COALESCE (a.MAKH, b.MAKH, c.MAKH),0) = NVL(d.MAKH,0)
AND NVL(COALESCE (a.KHOI, b.KHOI, c.KHOI),0) = NVL(d.KHOI,0)
AND NVL(COALESCE (a.CN, b.CN, c.CN),0) = NVL(d.CN,0)
LEFT JOIN 
    (   SELECT
            taikhoan LD_ID,
            MAKH,
            KHOI,
            CN,
            COALESCE (SUM (INTEREST_CONTRACT_NOMINAL_VND), 0) NOMINAL_INTEREST_VND_LK,
            COALESCE (SUM (INTEREST_CONTRACT_REAL_VND), 0)    REAL_INTEREST_VND_LK,
            COALESCE (SUM (PENALTY_INTEREST_VND), 0)          PENALTY_INTEREST_VND_LK,
            COALESCE (SUM(INTEREST_FTP_ACTUAL_VND), 0)        INTEREST_FTP_VND_LK,
            COALESCE (SUM (INTEREST_FTP_REGULAR_VND), 0)      INTEREST_FTP_TT_VND_LK
        FROM
            apps.mb_agg_nim_lk
        WHERE
            TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
        AND d_type = 'LOAN'
        GROUP BY
            TAIKHOAN,
            MAKH,
            KHOI,
            CN ) e 
ON 
    COALESCE (a.ld_id, b.ld_id, c.ld_id,d.ld_id) = e.ld_id
AND NVL(COALESCE (a.MAKH, b.MAKH, c.MAKH, d.MAKH),0) = NVL(e.MAKH,0)
AND NVL(COALESCE (a.KHOI, b.KHOI, c.KHOI, d.KHOI),0) = NVL(e.KHOI,0)
AND NVL(COALESCE (a.CN, b.CN, c.CN,d.CN),0) = NVL(e.CN,0)
LEFT JOIN 
    (   SELECT
            CONTRACT_ID ld_id,
            CUSTOMER_ID makh,
            KHOI,
            CN,
            SUM (RWA) RWA_CHOVAY
        FROM
            etl.ORS_MB_CAR_RRTD_KHOANPHAIDOI
        WHERE
            TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
        AND CREDIT_TYPE = 'CHO_VAY'
        GROUP BY
            CONTRACT_ID,
            CUSTOMER_ID,
            KHOI,
            CN ) f 
ON 
    COALESCE (a.ld_id, b.ld_id, c.ld_id, d.ld_id,e.ld_id) = f.ld_id
AND NVL(COALESCE (a.MAKH, b.MAKH, c.MAKH, d.MAKH, e.MAKH),0) = NVL(f.MAKH,0)
AND NVL(COALESCE (a.KHOI, b.KHOI, c.KHOI, d.KHOI, e.KHOI),0) = NVL(f.KHOI,0)
AND NVL(COALESCE (a.CN, b.CN, c.CN, d.CN, e.CN),0) = NVL(f.CN,0)
LEFT JOIN 
    ETL.ODS_LOAN_CONTRACT g 
ON 
    COALESCE ( a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id ) = g.ARRANGEMENT_NBR
LEFT JOIN 
    etl.ODS_PD_CONTRACT t 
ON 
    t.rank_num = 1
AND COALESCE ( a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id ) = t.ARRANGEMENT_NBR
LEFT JOIN 
    etl.ODS_OVD_CONTRACT u 
ON 
    COALESCE ( a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id ) = u.ARRANGEMENT_NBR
LEFT JOIN 
    ETL.REF_AICT_BRANCH_M k 
ON
    k.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
AND COALESCE ( a.CN, g.BRANCH_CODE, t.BRANCH_CODE, u.BRANCH_CODE ) = k.BRANCH_CODE_T24
LEFT JOIN 
    etl.ORS_MB_PRODUCT_CODE l 
ON 
    COALESCE (a.PRODUCT_CODE, g.PRODUCT_CODE, u.PRODUCT_CODE) = l.product_code
LEFT JOIN 
    etl.ORS_TR_KHACHHANG_ACTIVE_M n 
ON
    n.data_date = to_date ('${PRD_ID}', 'YYYYMMDD')
AND COALESCE ( a.MAKH, b.MAKH, c.MAKH, d.makh, e.MAKH, f.MAKH, g.makh, t.makh, u.makh ) = n.makh
LEFT JOIN 
    etl.ORS_MB_SME_PKKH_M PK
ON 
    pk.TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
AND PK.pk_type = 'PK_100'
AND PK.dtt_type = 3
AND COALESCE ( a.MAKH, b.MAKH, c.MAKH, d.makh, e.MAKH, f.MAKH, g.makh, t.makh, u.makh, n.makh ) = 
    pk.makh
LEFT JOIN 
    TMP_MAKH_YEAR q
ON 
    COALESCE (a.MAKH, b.MAKH, c.MAKH, d.MAKH,e.MAKH,f.MAKH, g.makh, t.makh, u.makh) = q.makh
/*
with TMP_MAKH_YEAR as
 (select distinct MAKH
    from apps.fin_loan_smy_monthly
   where TRANSACTION_DATE between
         ADD_MONTHS(TO_DATE('${PRD_ID}', 'YYYYMMDD'), -12) and
         ADD_MONTHS(TO_DATE('${PRD_ID}', 'YYYYMMDD'), -1)
     and MAKH is not null),
tmp_ku as
 (select TO_DATE('${PRD_ID}', 'YYYYMMDD') transaction_date,
         a.SOKU LD_ID,
         a.GL,
         a.MAKH,
         a.NTE,
         a.RATE,
         a.NGAYVAY,
         a.NGAYDH,
         a.KIEULS,
         a.KEY,
         a.CIC_PURPOSE,
         a.KYHAN,
         a.HANVAY,
         a.NHOMNO2 nhomno_xhtd,
         a.NHOMNO nhomno_liendoi,
         a.NHOMNO_KHACHHANG credit_status,
         a.NGAYGH,
         a.LICHGH,
         a.SOURCE_OF_FUND,
         a.SECTOR,
         a.KHOI,
         a.INDUSTRY_CODE,
         a.CN,
         a.TENCN,
         a.CN_CAP1,
         a.TENCN_CAP1,
         a.MJACCTCD category,
         a.MIACCTCD sub_product,
         a.MDV UOL,
         a.MANVQLTD RM_CODE,
         a.PRODUCT_CODE,
         a.LEGACY_ID,
         a.MBLD_TYPE,
         a.LIMIT_REF,
         a.PRODUCTGR_CODE,
         a.PRODUCT_TYPE,
         a.DOUBTFUL_STA,
         a.HOTRO_LS,
         a.LINHVUC_HT,
         a.PROJECT_ID,
         a.LD_12,
         a.LOAN_TYPE,
         a.PARTIC_ID,
         a.PARTIC_NAME,
         a.PARTICI_PERC,
         a.HD_DTT_UT,
         a.TYLE_PHI,
         a.TYLE_TCTD,
         a.TK_NHANVON,
         a.TK_CHUYENVON,
         round(sum(coalesce(a.INTEREST_FIX, 0) * a.DUCUOI_VND /
                   coalesce(b.duno_thoidiem, 1)),
               4) INTEREST_FIX,
         round(sum(coalesce(a.BIENDOLS, 0) * a.DUCUOI_VND /
                   coalesce(b.duno_thoidiem, 1)),
               4) BIENDOLS,
         round(sum(coalesce(a.LS, 0) * a.DUCUOI_VND /
                   coalesce(b.duno_thoidiem, 1)),
               4) LS,
         sum(nvl(DUCUOI_VND, 0)) duno_thoidiem
    from etl.ORS_TR_KU_M a
    left join (select SOKU, sum(nvl(DUCUOI_VND, 0)) duno_thoidiem
                from etl.ORS_TR_KU_M
               where TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
                 and substr(GL, 1, 1) = '2'
                 and substr(GL, 1, 2) &lt;&gt; '20'
               group by SOKU) b
      on a.SOKU = b.SOKU
   where TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
     and substr(GL, 1, 1) = '2'
     and substr(GL, 1, 2) &lt;&gt; '20'
   group by a.SOKU,
            a.GL,
            a.MAKH,
            a.NTE,
            a.RATE,
            a.NGAYVAY,
            a.NGAYDH,
            a.KIEULS,
            a.KEY,
            a.CIC_PURPOSE,
            a.KYHAN,
            a.HANVAY,
            a.NHOMNO2,
            a.NHOMNO,
            a.NHOMNO_KHACHHANG,
            a.NGAYGH,
            a.LICHGH,
            a.SOURCE_OF_FUND,
            a.SECTOR,
            a.KHOI,
            a.INDUSTRY_CODE,
            a.CN,
            a.TENCN,
            a.CN_CAP1,
            a.TENCN_CAP1,
            a.MJACCTCD,
            a.MIACCTCD,
            a.MDV,
            a.MANVQLTD,
            a.PRODUCT_CODE,
            a.LEGACY_ID,
            a.MBLD_TYPE,
            a.LIMIT_REF,
            a.PRODUCTGR_CODE,
            a.PRODUCT_TYPE,
            a.DOUBTFUL_STA,
            a.HOTRO_LS,
            a.LINHVUC_HT,
            a.PROJECT_ID,
            a.LD_12,
            a.LOAN_TYPE,
            a.PARTIC_ID,
            a.PARTIC_NAME,
            a.PARTICI_PERC,
            a.HD_DTT_UT,
            a.TYLE_PHI,
            a.TYLE_TCTD,
            a.TK_NHANVON,
            a.TK_CHUYENVON)
select TO_DATE('${PRD_ID}', 'YYYYMMDD') transaction_date,
       coalesce(a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id) LD_ID,
       a.GL COA_CODE,
       coalesce(a.MAKH,
                b.MAKH,
                c.MAKH,
                d.MAKH,
                e.MAKH,
                f.MAKH,
                g.makh,
                t.makh,
                u.makh) MAKH,
       coalesce(a.NTE, g.CURRENCY_CODE, t.CURRENCY_CODE, u.CURRENCY_CODE) NTE,
       coalesce(a.NGAYVAY,
                g.ARRANGEMENT_VALUE_DATE,
                u.ARRANGEMENT_OPENING_DATE) VAL_DATE,
       coalesce(a.NGAYDH, g.FINAL_MATURITY_DATE, t.FINAL_MATURITY_DATE) MAT_DATE,
       coalesce(a.KIEULS, g.INT_RATE_TYPE) INT_RATE_TYPE,
       coalesce(a.KEY, g.BI_KEY) INTEREST_KEY,
       coalesce(a.CIC_PURPOSE, g.CIC_PURPOSE_TYPE_CODE) CIC_PURPOSE,
       coalesce(a.KYHAN, g.ARRANGEMENT_TERM, t.ARRANGEMENT_TERM) LOC_TERM,
       coalesce(a.HANVAY,
                case
                  when coalesce(g.ARRANGEMENT_TERM,
                                regexp_replace(t.ARRANGEMENT_TERM, '[a-zA-Z]+$', '')) &lt;= 12 then
                   '1'
                  when coalesce(g.ARRANGEMENT_TERM,
                                regexp_replace(t.ARRANGEMENT_TERM, '[a-zA-Z]+$', '')) &lt;= 60 then
                   '2'
                  else
                   '3'
                end) NHOM_KYHAN,
       a.NHOMNO_XHTD,
       a.NHOMNO_LIENDOI,
       coalesce(a.CREDIT_STATUS,
                g.CREDIT_STATUS,
                t.CREDIT_STATUS,
                u.CREDIT_STATUS) CREDIT_STATUS,
       coalesce(a.SOURCE_OF_FUND,
                g.FUND_SOURCE_CODE,
                t.FUND_SOURCE_CODE,
                u.FUND_SOURCE_CODE) SOURCE_OF_FUND,
       coalesce(a.SECTOR, h.sector) SECTOR,
       coalesce(a.KHOI, b.khoi, c.khoi, d.khoi, e.khoi, f.khoi, h.khoi) KHOI,
       (case
         when q.MAKH is not null THEN
          'CU'
         else
          'MOI'
       end) CUS_TYPE,
       m.PHAN_KHUC,
       n.LC_ST_FIN CUS_STATUS,
       coalesce(a.INDUSTRY_CODE, h.INDUSTRY_CODE) INDUSTRY_CODE,
       coalesce(a.CN, b.cn, c.cn, d.cn, e.cn, f.cn, g.BRANCH_CODE, t.BRANCH_CODE, u.BRANCH_CODE) CN,
       coalesce(a.TENCN, k.BRANCH_NAME_T24) BRANCH_NAME_T24,
       coalesce(a.CN_CAP1, k.PARENT_BRANCH_CODE_T24) PARENT_BRANCH_CODE_T24,
       coalesce(a.TENCN_CAP1, k.PARENT_BRANCH_NAME_T24) PARENT_BRANCH_NAME_T24,
       k.TINH_THANH,
       k.VUNG_MIEN,
       k.TIEU_VUNG,
       coalesce(a.CATEGORY, g.CATE_CODE, t.CATE_CODE, u.CATE_CODE) CATEGORY,
       coalesce(a.SUB_PRODUCT,
                g.SUB_PRODUCT_CODE,
                t.SUB_PRODUCT_CODE,
                u.SUB_PRODUCT_CODE) SUB_PRODUCT,
       coalesce(a.UOL,
                g.LOAN_INDUSTRY_CODE,
                t.LOAN_INDUSTRY_CODE,
                u.LOAN_INDUSTRY_CODE) UOL,
       coalesce(a.PRODUCT_CODE, g.PRODUCT_CODE, u.PRODUCT_CODE) PRODUCT_CODE,
       case
         when coalesce(l.SP_DV, '0') in ('SPSO', 'DVSO', 'SPS1', 'DVS1') then
          'ONLINE'
         else
          'OFFLINE'
       end KENH_GD,
       coalesce(a.LEGACY_ID,
                g.LEGACY_CONTRACT_ID,
                t.LEGACY_CONTRACT_ID,
                u.LEGACY_CONTRACT_ID) LEGACY_ID,
       coalesce(a.MBLD_TYPE, g.CAMPAIGN_CODE, u.CAMPAIGN_CODE) MBLD_TYPE,
       coalesce(a.LIMIT_REF, g.LIMIT_CODE, t.LIMIT_CODE, u.LIMIT_CODE) LIMIT_REF,
       coalesce(a.PRODUCTGR_CODE,
                g.PRODUCT_GROUP_CODE,
                t.PRODUCT_GROUP_CODE,
                u.PRODUCT_GROUP_CODE) PRODUCTGR_CODE,
       coalesce(a.PRODUCT_TYPE, g.PROGRAM_CODE) PRODUCT_TYPE,
       coalesce(a.DOUBTFUL_STA, g.DOUBTFUL_STATUS, t.DOUBTFUL_STATUS) DOUBTFUL_STATUS,
       coalesce(a.PROJECT_ID, g.PROJECT_ID) PROJECT_ID,
       a.LOAN_TYPE,
       a.PARTIC_ID,
       a.PARTIC_NAME,
       a.PARTICI_PERC,
       a.HD_DTT_UT,
       a.TYLE_PHI,
       a.TYLE_TCTD,
       a.TK_NHANVON,
       a.TK_CHUYENVON,
       null FTP_CODE,
       coalesce(a.INTEREST_FIX, g.FIX_INT_RATE) FIX_INT_RATE,
       coalesce(a.BIENDOLS, g.INT_SPREAD, t.INT_SPREAD) INT_SPREAD,
       coalesce(a.LS, g.INT_RATE, t.PENALTY_INT_RATE) INT_RATE,
       coalesce(a.DUNO_THOIDIEM, 0) DUNO_THOIDIEM_VND,
       coalesce(b.DUNO_BINHQUAN, 0) DUNO_BINHQUAN_VND,
       coalesce(c.DOANHSO_GIAINGAN_VND, 0) DOANHSO_GIAINGAN_VND,
       coalesce(c.DOANHSO_THUNO_VND, 0) DOANHSO_THUNO_VND,
       coalesce(c.DOANHSO_THUNO_DUNGHAN, 0) DOANHSO_THUNO_DUNGHAN_VND,
       coalesce(c.DOANHSO_THUNO_TRUOCHAN, 0) DOANHSO_THUNO_TRUOCHAN_VND,
       coalesce(c.DOANHSO_THUNO_QUAHAN, 0) DOANHSO_THUNO_QUAHAN_VND,
       coalesce(d.NOMINAL_INTEREST_VND, 0) NOMINAL_INTEREST_VND,
       coalesce(d.REAL_INTEREST_VND, 0) REAL_INTEREST_VND,
       coalesce(d.PENALTY_INTEREST_VND, 0) PENALTY_INTEREST_VND,
       coalesce(d.INTEREST_FTP_VND, 0) INTEREST_FTP_VND,
       coalesce(d.INTEREST_FTP_TT_VND, 0) INTEREST_FTP_TT_VND,
       coalesce(e.NOMINAL_INTEREST_VND_LK, 0) NOMINAL_INTEREST_VND_LK,
       coalesce(e.REAL_INTEREST_VND_LK, 0) REAL_INTEREST_VND_LK,
       coalesce(e.PENALTY_INTEREST_VND_LK, 0) PENALTY_INTEREST_VND_LK,
       coalesce(e.INTEREST_FTP_VND_LK, 0) INTEREST_FTP_VND_LK,
       coalesce(e.INTEREST_FTP_TT_VND_LK, 0) INTEREST_FTP_TT_VND_LK,
       coalesce(f.RWA_CHOVAY, 0) RWA_CHOVAY_VND,
       0 duno_binhquan_lk_vnd
  from tmp_ku a
  full join (select SOTK LD_ID,
                    makh,
                    KHOI,
                    CN,
                    sum(nvl(SODU_VND, 0)) DUNO_BINHQUAN
               from etl.ORS_TR_CHOVAY_BQ
              where TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
              group by SOTK, makh, KHOI, CN) b
    on a.ld_id = b.LD_ID
   and nvl(a.makh, 0) = nvl(b.makh, 0)
   and nvl(a.khoi, 0) = nvl(b.khoi, 0)
   and nvl(a.CN, 0) = nvl(b.CN, 0)
  full join (select LD_ID,
                    MAKH,
                    khoi,
                    CN,
                    sum(DOANHSO_GIAINGAN_VND) DOANHSO_GIAINGAN_VND,
                    sum(DOANHSO_THUNO_VND) DOANHSO_THUNO_VND,
                    sum(DOANHSO_THUNO_DUNGHAN) DOANHSO_THUNO_DUNGHAN,
                    sum(DOANHSO_THUNO_TRUOCHAN) DOANHSO_THUNO_TRUOCHAN,
                    sum(DOANHSO_THUNO_QUAHAN) DOANHSO_THUNO_QUAHAN
               from apps.FIN_LOAN_TRANS_DAILY
              where TRANSACTION_DATE between
                    trunc(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MONTH') and
                    TO_DATE('${PRD_ID}', 'YYYYMMDD')
              group by LD_ID, MAKH, KHOI, CN) c
    on coalesce(a.ld_id, b.ld_id) = c.ld_id
   and nvl(coalesce(a.makh, b.makh), 0) = nvl(c.makh, 0)
   and nvl(coalesce(a.khoi, b.khoi), 0) = nvl(c.khoi, 0)
   and nvl(coalesce(a.CN, b.CN), 0) = nvl(c.CN, 0)
  left join (select taikhoan LD_ID,
                    MAKH,
                    KHOI,
                    CN,
                    coalesce(sum(NOMINAL_INTEREST_VND), 0) NOMINAL_INTEREST_VND,
                    coalesce(sum(REAL_INTEREST_VND), 0) REAL_INTEREST_VND,
                    coalesce(sum(PENALTY_INTEREST_VND), 0) PENALTY_INTEREST_VND,
                    coalesce(sum(INTEREST_FTP_VND), 0) INTEREST_FTP_VND,
                    coalesce(sum(INTEREST_FTP_TT_VND), 0) INTEREST_FTP_TT_VND
               from apps.mb_agg_nim_m
              where TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
                and d_type = 'LOAN'
                and TAIKHOAN not like '%F2B%'
              group by TAIKHOAN, MAKH, KHOI, CN) d
    on coalesce(a.ld_id, b.ld_id, c.ld_id) = d.ld_id
   and nvl(coalesce(a.MAKH, b.MAKH, c.MAKH), 0) = nvl(d.MAKH, 0)
   and nvl(coalesce(a.KHOI, b.KHOI, c.KHOI), 0) = nvl(d.KHOI, 0)
   and nvl(coalesce(a.CN, b.CN, c.CN), 0) = nvl(d.CN, 0)
  left join (select taikhoan LD_ID,
                    MAKH,
                    KHOI,
                    CN,
                    coalesce(sum(INTEREST_CONTRACT_NOMINAL_VND), 0) NOMINAL_INTEREST_VND_LK,
                    coalesce(sum(INTEREST_CONTRACT_REAL_VND), 0) REAL_INTEREST_VND_LK,
                    coalesce(sum(PENALTY_INTEREST_VND), 0) PENALTY_INTEREST_VND_LK,
                    coalesce(sum(INTEREST_FTP_ACTUAL_VND), 0) INTEREST_FTP_VND_LK,
                    coalesce(sum(INTEREST_FTP_REGULAR_VND), 0) INTEREST_FTP_TT_VND_LK
               from apps.mb_agg_nim_lk
              where TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
                and d_type = 'LOAN'
                and TAIKHOAN not like '%F2B%'
              group by TAIKHOAN, MAKH, KHOI, CN) e
    on coalesce(a.ld_id, b.ld_id, c.ld_id, d.ld_id) = e.ld_id
   and nvl(coalesce(a.MAKH, b.MAKH, c.MAKH, d.MAKH), 0) = nvl(e.MAKH, 0)
   and nvl(coalesce(a.KHOI, b.KHOI, c.KHOI, d.KHOI), 0) = nvl(e.KHOI, 0)
   and nvl(coalesce(a.CN, b.CN, c.CN, d.CN), 0) = nvl(e.CN, 0)
  left join (select CONTRACT_ID ld_id,
                    CUSTOMER_ID makh,
                    KHOI,
                    CN,
                    sum(RWA) RWA_CHOVAY
               from etl.ORS_MB_CAR_RRTD_KHOANPHAIDOI
              where TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
                and CREDIT_TYPE = 'CHO_VAY'
              group by CONTRACT_ID, CUSTOMER_ID, KHOI, CN) f
    on coalesce(a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id) = f.ld_id
   and nvl(coalesce(a.MAKH, b.MAKH, c.MAKH, d.MAKH, e.MAKH), 0) =
       nvl(f.MAKH, 0)
   and nvl(coalesce(a.KHOI, b.KHOI, c.KHOI, d.KHOI, e.KHOI), 0) =
       nvl(f.KHOI, 0)
   and nvl(coalesce(a.CN, b.CN, c.CN, d.CN, e.CN), 0) = nvl(f.CN, 0)
  left join ETL.ODS_LOAN_CONTRACT g
    on coalesce(a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id) =
       g.ARRANGEMENT_NBR
  left join etl.ODS_PD_CONTRACT t
    on t.rank_num = 1
   and coalesce(a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id) =
       t.ARRANGEMENT_NBR
  left join etl.ODS_OVD_CONTRACT u
    on coalesce(a.ld_id, b.ld_id, c.ld_id, d.ld_id, e.ld_id, f.ld_id) =
       u.ARRANGEMENT_NBR
  left join etl.ORS_TR_KHACHHANG h
    on coalesce(a.MAKH,
                b.MAKH,
                c.MAKH,
                d.makh,
                e.MAKH,
                f.MAKH,
                g.makh,
                t.makh,
                u.makh) = h.makh
  left join ETL.REF_AICT_BRANCH_M k
    on k.transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   and coalesce(a.CN, g.BRANCH_CODE, t.BRANCH_CODE, u.BRANCH_CODE) =
       k.BRANCH_CODE_T24
  left join etl.ORS_MB_PRODUCT_CODE l
    on coalesce(a.PRODUCT_CODE, g.PRODUCT_CODE, u.PRODUCT_CODE) =
       l.product_code
  left join APPS.FIN_SMY_CUSTOMER_MONTHLY m
    on m.transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   and coalesce(a.MAKH,
                b.MAKH,
                c.MAKH,
                d.makh,
                e.MAKH,
                f.MAKH,
                g.makh,
                t.makh,
                u.makh) = m.makh
  left join etl.ORS_TR_KHACHHANG_ACTIVE_M n
    on n.data_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   and coalesce(a.MAKH,
                b.MAKH,
                d.makh,
                e.MAKH,
                c.MAKH,
                f.MAKH,
                g.makh,
                t.makh,
                u.makh) = n.makh
  left join TMP_MAKH_YEAR q
    on coalesce(a.MAKH,
                b.MAKH,
                c.MAKH,
                d.MAKH,
                e.MAKH,
                f.MAKH,
                g.makh,
                t.makh,
                u.makh) = q.makh
*/
</sql>
