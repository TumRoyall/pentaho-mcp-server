  <step>
    <name>MB_TR_SK_TPDN_BQ_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select
to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
BONDS_DEALS,
BONDS,
SHORT_NAME,
OPERATION,
TYPE,
BONDS_DEALS_SECOND,
PORTFOLIOS,
VALUE_DATE,
ISSUE_DATE,
MATURITY_DATE,
CURRENCY,
RATE,
FREQ,
COMPANY_BUY,
COMPANY,
CUSTOMER_MIS,
ISSUER,
ISSUER_NAME,
ISSUER_KHOI,
ISSUER_SECTOR,
COA,
PRODUCT_CODE,
CUSTOMER_MIS_NAME,
KYHANFTP,
BONDS_TYPE,
sum ((nvl (FACE_AMOUNT,0) + nvl (CKPT_CONLAI,0)) * to_char (TRANS_DATE, 'DD')/ to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')) TPDN_BQ_VND_LK
from apps.MB_TR_SK_TPDN_BQ_DAILY
where TRANS_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') and to_date ('${PRD_ID}', 'YYYYMMDD')
and TRANS_DATE = last_day (TRANS_DATE)
GROUP BY 
BONDS_DEALS,
BONDS,
SHORT_NAME,
OPERATION,
TYPE,
BONDS_DEALS_SECOND,
PORTFOLIOS,
VALUE_DATE,
ISSUE_DATE,
MATURITY_DATE,
CURRENCY,
RATE,
FREQ,
COMPANY_BUY,
COMPANY,
CUSTOMER_MIS,
ISSUER,
ISSUER_NAME,
ISSUER_KHOI,
ISSUER_SECTOR,
COA,
PRODUCT_CODE,
CUSTOMER_MIS_NAME,
KYHANFTP,
BONDS_TYPE

</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
