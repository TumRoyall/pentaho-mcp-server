    <connection>ors_dc</connection>
    <sql>select
MD_ID,
CATEGORY,
MAKH,
TENKH,
SECTOR,
INDUSTRY_CODE,
NTE,
sum (SODUBQ * to_number (to_char (TRANSACTION_DATE, 'DD'))/to_number (to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD'))) SODUBQ_LK,
DEAL_DATE,
VALUE_DATE,
MAT_DATE,
RATE,
PER,
PROV,
CN,
to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
KHOI,
sum (SODUBQ_VND * to_number (to_char (TRANSACTION_DATE, 'DD'))/to_number (to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD'))) SODUBQ_VND_LK,
MBLD_TYPE,
RM_HOPDONG,
PRODUCT_CODE,
RM_BANCHEO,
SUB_PRO,
CUS_STATUS,
PRODUCT_TYPE,
PRODUCT_GR
from apps.tr_sdbq_baolanh
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') and to_date ('${PRD_ID}', 'YYYYMMDD')
group by
MD_ID,
CATEGORY,
MAKH,
TENKH,
SECTOR,
INDUSTRY_CODE,
NTE,
DEAL_DATE,
VALUE_DATE,
MAT_DATE,
RATE,
PER,
PROV,
CN,
KHOI,
MBLD_TYPE,
