      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select a.txn_date,
       a.SOURCE_TABLE_NAME,
       a.ENTRY_ID,
       a.RELATION_TXN_NBR,
       a.CURRENCY_CODE,
       a.FCY_AMT,
       a.lcy_amt,
       a.BRANCH_CODE,
       a.PARTY_KEY,
       a.T24_CUST_ID,
       a.PARTY_FULL_NAME,
       a.COA_CODE,
       a.T24_LINE,
       a.GL_LINE,
       a.PL_CATE_CODE,
       a.GL_CMB_CODE,
       a.GL_SEGMENT_VALUE_CMB,
       a.GL_DEPT_CODE,
       a.RECEIVE_CHG_CODE,
       a.PAYMENT_CHG_CODE,
       a.CHG_PRODUCT_CODE,
       a.ARRANGEMENT_PRODUCT_CODE,
       a.TXN_CHANNEL_CODE,
       a.PARTY_SECTOR_CODE,
       a.PARTY_DIVISION_CODE,
       a.REPORT_DIVISION_CODE,
       a.LEVEL1_REPORT_ITEM_CODE,
       A.REPORT_ITEM_CODE,
       A.REPORT_ITEM_NAME,
       A.EB_REPORT_ITEM_IND,
       A.RM_CODE,
       A.CREATED_BY,
       A.CREATION_DATE,
       A.LAST_UPDATED_BY,
       A.LAST_UPDATE_DATE,
       A.CHG_TYPE,
       A.CHG_CODE,
       A.NARRATIVE,
       A.ARRANGEMENT_NBR,
       A.PL_TOTAL_PARENT_ITEM_NAME,
       A.PL_TOTAL_PARENT_ITEM_CODE,
       A.TXN_CODE,
       A.F2b_Fo_Deal,
       A.F2B_DEAL_TYPE,
       A.F2b_Txn_Type,
       'ODS.SM_DRVT_SWAP_CONTRACT_DTL' AS F2B_CONTRACT_TABLES,
       b.FOLDER_CODE as F2B_FOLDER_CODE,
       c.FOLDER_SHORT_NAME F2B_FOLDER_SHORTNAME,
       b.IMT_CODE F2B_IMT_CODE,
       d.IMT_SHORT_NAME F2B_IMT_NAME,
       b.CNTPR_CODE F2B_CNTPR_CODE
from etl.TMP_SM_PL_TXN_DAILY a
left join(
     select REGEXP_SUBSTR(ARRANGEMENT_KEY,'[^-\.]+',1,3) as ARRANGEMENT_NBR,
            ARRANGEMENT_KEY,
            FOLDER_CODE,
            CNTPR_CODE,
            IMT_CODE,
            case when REGEXP_SUBSTR(ARRANGEMENT_KEY,'[^-\.]+',1,4) = 'L' then '7480'
                 when REGEXP_SUBSTR(ARRANGEMENT_KEY,'[^-\.]+',1,4) = 'D' then '8480' end coa_code
     from ETL.ODS_SM_DRVT_SWAP_CONTRACT_DTL) b on a.f2b_fo_deal = b.ARRANGEMENT_NBR and a.coa_code = b.coa_code
left join ETL.ODS_FOLDER_REF C ON B.FOLDER_CODE = C.FOLDER_CODE
LEFT JOIN ETL.ODS_IMT_REF D ON B.IMT_CODE = D.IMT_CODE
WHERE A.F2B_DEAL_TYPE = 'SWAP_DEALS' 

UNION ALL

----------------------  deal_type FX_SWAP_DEALS   --------------------------

select a.txn_date,
       a.SOURCE_TABLE_NAME,
       a.ENTRY_ID,
       a.RELATION_TXN_NBR,
       a.CURRENCY_CODE,
       a.FCY_AMT,
       a.lcy_amt,
       a.BRANCH_CODE,
       a.PARTY_KEY,
       a.T24_CUST_ID,
       a.PARTY_FULL_NAME,
       a.COA_CODE,
       a.T24_LINE,
       a.GL_LINE,
       a.PL_CATE_CODE,
       a.GL_CMB_CODE,
       a.GL_SEGMENT_VALUE_CMB,
       a.GL_DEPT_CODE,
       a.RECEIVE_CHG_CODE,
       a.PAYMENT_CHG_CODE,
       a.CHG_PRODUCT_CODE,
       a.ARRANGEMENT_PRODUCT_CODE,
       a.TXN_CHANNEL_CODE,
       a.PARTY_SECTOR_CODE,
       a.PARTY_DIVISION_CODE,
       a.REPORT_DIVISION_CODE,
       a.LEVEL1_REPORT_ITEM_CODE,
       A.REPORT_ITEM_CODE,
       A.REPORT_ITEM_NAME,
       A.EB_REPORT_ITEM_IND,
       A.RM_CODE,
       A.CREATED_BY,
       A.CREATION_DATE,
       A.LAST_UPDATED_BY,
       A.LAST_UPDATE_DATE,
       A.CHG_TYPE,
       A.CHG_CODE,
       A.NARRATIVE,
       A.ARRANGEMENT_NBR,
       A.PL_TOTAL_PARENT_ITEM_NAME,
       A.PL_TOTAL_PARENT_ITEM_CODE,
       A.TXN_CODE,
       A.F2b_Fo_Deal,
       A.F2B_DEAL_TYPE,
       A.F2b_Txn_Type,
       'ODS.SM_FX_SWAP_CONTRACT' as F2B_CONTRACT_TABLES,
	   b.FOLDER_CODE as F2B_FOLDER_CODE,
	   c.FOLDER_SHORT_NAME as F2B_FOLDER_SHORTNAME,
	   b.IMT_CODE as F2B_IMT_CODE,
	   d.IMT_SHORT_NAME as F2B_IMT_NAME,
	   b.CNTPR_CODE as F2B_CNTPR_CODE
from etl.TMP_SM_PL_TXN_DAILY a
left join etl.ODS_SM_FX_SWAP_CONTRACT b on a.f2b_fo_deal = b.ARRANGEMENT_NBR
left join ETL.ODS_FOLDER_REF C ON B.FOLDER_CODE = C.FOLDER_CODE
LEFT JOIN ETL.ODS_IMT_REF D ON B.IMT_CODE = D.IMT_CODE
WHERE A.F2B_DEAL_TYPE = 'FX_SWAP_DEALS'

union all

