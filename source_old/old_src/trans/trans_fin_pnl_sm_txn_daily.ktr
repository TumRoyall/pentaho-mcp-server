       A.F2b_Fo_Deal,
       A.F2B_DEAL_TYPE,
       A.F2b_Txn_Type,
       'ODS.SM_LOAN_DEP_CONTRACT' as F2B_CONTRACT_TABLES,
	   b.FOLDER_CODE as F2B_FOLDER_CODE,
	   c.FOLDER_SHORT_NAME as F2B_FOLDER_SHORTNAME,
	   b.IMT_CODE as F2B_IMT_CODE,
	   d.IMT_SHORT_NAME as F2B_IMT_NAME,
	   b.CNTPR_CODE as F2B_CNTPR_CODE
from etl.TMP_SM_PL_TXN_DAILY a
left join etl.ODS_SM_LOAN_DEP_CONTRACT b on a.f2b_fo_deal = b.ARRANGEMENT_NBR
left join ETL.ODS_FOLDER_REF C ON B.FOLDER_CODE = C.FOLDER_CODE
LEFT JOIN ETL.ODS_IMT_REF D ON B.IMT_CODE = D.IMT_CODE
WHERE A.F2B_DEAL_TYPE = 'LOANS_DEPOSIT_DEALS'

union all

