-------------------- DEAL TYPE KHAC

select a.txn_date,
       a.SOURCE_TABLE_NAME,
       a.ENTRY_ID,
       a.RELATION_TXN_NBR,
       a.CURRENCY_CODE,
       a.FCY_AMT,
       a.lcy_amt,
       a.BRANCH_CODE,
       a.PARTY_KEY,
       a.T24_CUST_ID,
       a.PARTY_FULL_NAME,
       a.COA_CODE,
       a.T24_LINE,
       a.GL_LINE,
       a.PL_CATE_CODE,
       a.GL_CMB_CODE,
       a.GL_SEGMENT_VALUE_CMB,
       a.GL_DEPT_CODE,
       a.RECEIVE_CHG_CODE,
