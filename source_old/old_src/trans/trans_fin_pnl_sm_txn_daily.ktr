       a.ARRANGEMENT_PRODUCT_CODE,
       a.TXN_CHANNEL_CODE,
       a.PARTY_SECTOR_CODE,
       a.PARTY_DIVISION_CODE,
       a.REPORT_DIVISION_CODE,
       a.LEVEL1_REPORT_ITEM_CODE,
       A.REPORT_ITEM_CODE,
       A.REPORT_ITEM_NAME,
       A.EB_REPORT_ITEM_IND,
       A.RM_CODE,
       A.CREATED_BY,
       A.CREATION_DATE,
       A.LAST_UPDATED_BY,
       A.LAST_UPDATE_DATE,
       A.CHG_TYPE,
       A.CHG_CODE,
       A.NARRATIVE,
       A.ARRANGEMENT_NBR,
       A.PL_TOTAL_PARENT_ITEM_NAME,
       A.PL_TOTAL_PARENT_ITEM_CODE,
