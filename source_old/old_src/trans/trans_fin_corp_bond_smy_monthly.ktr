  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select
to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
coalesce (a.BONDS_DEALS, b.BONDS_DEALS, c.BONDS_DEALS, d.BONDS_DEALS) BONDS_DEALS,
coalesce (A.ISSUER, b.MAKH, c.MAKH, d.MAKH) MAKH,
A.COA AS COA_CODE,
coalesce (A.BONDS, g.BOND_KEY) BONDS,
coalesce (A.OPERATION,g.OPERATION_TYPE) OPERATION_TYPE,
A.TYPE,
A.BONDS_DEALS_SECOND,
coalesce (A.PORTFOLIOS, g.PORTFOLIO_IND) PORTFOLIOS,
coalesce (A.VALUE_DATE, g.ARRANGEMENT_VALUE_DATE) VALUE_DATE,
A.ISSUE_DATE,
coalesce (A.MATURITY_DATE, g.MATURITY_DATE) MATURITY_DATE,
coalesce (A.CURRENCY, g.CURRENCY_CODE) NTE,
A.COMPANY CN,
k.BRANCH_NAME_T24 AS BRANCH_NAME_T24,
k.PARENT_BRANCH_CODE_T24 AS PARENT_BRANCH_CODE_T24,
k.PARENT_BRANCH_NAME_T24 AS PARENT_BRANCH_NAME_T24,
k.TINH_THANH,
k.VUNG_MIEN,
k.TIEU_VUNG,
nvl (A.ISSUER_KHOI, h.khoi)  KHOI,
nvl (A.ISSUER_SECTOR,h.sector)  SECTOR,
/*nvl (A.INTEREST, g.INT_RATE) LS_TCPH,
https://dichvunoibo.mbbank.com.vn/WorkOrder.do?woMode=viewWO&amp;woID=77386*/
nvl (A.RATE, g.BOND_INT_RATE) LS_TCPH,
A.FREQ,
nvl (A.CUSTOMER_MIS, g.MAKH_THUCAP) MAKH_THUCAP,
A.OC_ID,
case 
    when h.creation_date >= trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') THEN 'MOI' 
    else 'CU' 
end AS CUS_TYPE,
case
    when nvl (A.ISSUER_KHOI, h.khoi) = 'CIB' and nvl (A.ISSUER_SECTOR,h.sector) = '3035' then 'FDI'
    when nvl (A.ISSUER_KHOI, h.khoi) = 'CIB' then 'CIB_CONLAI'
    when nvl (A.ISSUER_KHOI, h.khoi) = 'SME' then m.PKKH
    when nvl (A.ISSUER_SECTOR,h.sector) in ('1688','1689','1690','1691','1699', '1666', '1660') then 'INDIV_PRIVATE'
    when nvl (A.ISSUER_SECTOR,h.sector) in ('1888','1889','1890','1891','1746','1747') then 'INDIV_PRIORITY'
    when nvl (A.ISSUER_KHOI, h.khoi) = 'INDIV' then 'INDIV_MASS'
    else nvl (A.ISSUER_KHOI, h.khoi) 
end as PHAN_KHUC,
n.LC_ST_FIN CUS_STATUS,
nvl (A.GROSS_AMOUNT,0) GROSS_AMOUNT,
nvl (A.FACE_AMOUNT,0) FACE_AMOUNT,
nvl (A.CKPT_CONLAI, 0) CKPT_CONLAI,
nvl (A.FACE_AMOUNT,0) + nvl (A.CKPT_CONLAI, 0) SODU_THOIDIEM_VND,
nvl (b.SODU_BINHQUAN,0) SODU_BINHQUAN_VND,
nvl (c.SODU_BINHQUAN_LK,0) SODU_BINHQUAN_LK_VND,
nvl (d.RWA,0) RWA_TRAIPHIEU_VND
from ETL.ORS_MB_TR_SK_TPDN a
full join (select BONDS_DEALS, ISSUER MAKH, sum (TPDN_BQ_VND) SODU_BINHQUAN 
    from etl.ORS_CAL_MB_TR_SK_TPDN_BQ
    where TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    group by BONDS_DEALS, ISSUER) b on a.BONDS_DEALS = b.BONDS_DEALS
full join (select BONDS_DEALS, ISSUER MAKH, sum (TPDN_BQ_VND_LK) SODU_BINHQUAN_LK 
    from etl.ORS_CAL_MB_TR_SK_TPDN_BQ_LK
    where TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    group by BONDS_DEALS, ISSUER) c on coalesce (a.BONDS_DEALS, b.BONDS_DEALS) = c.BONDS_DEALS
full join (select CONTRACT_ID BONDS_DEALS, CUSTOMER_ID MAKH, sum (RWA) RWA
    from etl.ORS_MB_CAR_RRTD_KHOANPHAIDOI
    where TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    and CREDIT_TYPE = 'TRAI_PHIEU'
    and CUS_TYPE = 'DOANH_NGHIEP'
    group by CONTRACT_ID, CUSTOMER_ID) d on coalesce (a.BONDS_DEALS, b.BONDS_DEALS, c.BONDS_DEALS) = d.BONDS_DEALS
left join ETL.ODS_BOND_CONTRACT g on coalesce (a.BONDS_DEALS, b.BONDS_DEALS, c.BONDS_DEALS, d.BONDS_DEALS) = g.ARRANGEMENT_NBR
left join ETL.ORS_TR_KHACHHANG h on coalesce (a.issuer, b.MAKH, c.MAKH, d.MAKH) = h.makh
left join ETL.REF_AICT_BRANCH_M k on k.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD') 
    and a.COMPANY = k.BRANCH_CODE_T24
left join etl.ORS_MB_SME_PKKH_M m on m.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
    and m.PK_TYPE = 'PK_100'
    and m.DTT_TYPE = '3'
    and coalesce (a.issuer, b.MAKH, c.MAKH, d.MAKH) = m.makh
left join etl.ORS_TR_KHACHHANG_ACTIVE_M n on n.data_date = to_date ('${PRD_ID}', 'YYYYMMDD')
    and coalesce (a.issuer, b.MAKH, c.MAKH, d.MAKH) = n.makh</sql>
