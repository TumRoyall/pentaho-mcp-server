    <connection>tckt_dc</connection>
    <sql>SELECT
 a.transaction_date,
 a.ma_cn,
 b.PARENT_BRANCH_CODE_T24,
 a.makh,
 a.khoi,
 a.product_code,
 a.KENH,
 a.CUS_STATUS,
 SUM(a.dttsrr_i) AS dttsrr,
 sum(a.dtttrr_i) AS dtttrr,
    SUM(NVL(a.thulai_kh_a, 0) + NVL(a.chilai_ftp_b, 0)) AS tt_tindung,
    SUM(NVL(a.chilai_kh_c, 0) + NVL(a.thulai_ftp_d, 0)) AS tt_huydong,
    SUM(a.thu_ngoai_lai_e) AS thu_ngoai_lai,
    SUM(NVL(a.bt_khac_e17, 0) + NVL(a.bt_xln_e18, 0)) AS thu_bat_thuong,
    SUM(a.chi_dp_f) AS du_phong,
    SUM(a.dv_utbhck_e5) AS thu_bancase,
    SUM(a.dv_kieuhoi_e9) AS thu_kh,
    SUM(a.dv_ttqt_e2) AS thu_ttqt,
    SUM(a.fx_nte_e14) AS thu_ngoai_hoi_ps,
    SUM(a.dv_baolanh_e1) AS thu_bl,
    SUM(a.dv_tttn_e3) AS tt_dv_tt_noidia,
    SUM(a.dtttrr_i) AS dtttrr_i,
    SUM(a.thu_lai_thuan) AS thu_lai_thuan,
    SUM(a.thulai_kh_a) AS thulai_kh_a,
    SUM(a.chilai_ftp_b) AS chilai_ftp_b,
    SUM(a.chilai_kh_c) AS chilai_kh_c,
    SUM(a.thulai_ftp_d) AS thulai_ftp_d,
    SUM(a.thu_ngoai_lai_e) AS thu_ngoai_lai_e,
    SUM(a.chi_dp_f) AS chi_dp_f,
    SUM(a.thulai_tindung_a1) AS thulai_tindung_a1,
    SUM(a.thu_lai_khac_a2) AS thu_lai_khac_a2,
    SUM(a.thulai_traiphieu_a3) AS thulai_traiphieu_a3,
    SUM(a.chiftp_tindung_b1) AS chiftp_tindung_b1,
    SUM(a.chiftp_khac_b2) AS chiftp_khac_b2,
    SUM(a.chiftp_traiphieu_b3) AS chiftp_traiphieu_b3,
    SUM(a.thuftp_duphongtd_b4) AS thuftp_duphongtd_b4,
    SUM(a.thuftp_duphongkhac_b3) AS thuftp_duphongkhac_b3,
    SUM(a.thuftp_duphongtp_b4) AS thuftp_duphongtp_b4,
    SUM(a.chilai_huydong_c1) AS chilai_huydong_c1,
    SUM(a.chilai_khac_c2) AS chilai_khac_c2,
    SUM(a.chilai_traiphieu_c3) AS chilai_traiphieu_c3,
    SUM(a.thuftp_huydong_d1) AS thuftp_huydong_d1,
    SUM(a.thuftp_khac_d2) AS thuftp_khac_d2,
    SUM(a.dv_baolanh_e1) AS dv_baolanh_e1,
    SUM(a.dv_ttqt_e2) AS dv_ttqt_e2,
    SUM(a.dv_tttn_e3) AS dv_tttn_e3,
    SUM(a.dv_the_e4) AS dv_the_e4,
    SUM(a.dv_utbhck_e5) AS dv_utbhck_e5,
    SUM(a.dv_tuvan_e6) AS dv_tuvan_e6,
    SUM(a.dv_nganquy_e7) AS dv_nganquy_e7,
    SUM(a.dv_giuho_e8) AS dv_giuho_e8,
    SUM(a.dv_kieuhoi_e9) AS dv_kieuhoi_e9,
    SUM(a.dv_nhdt_e10) AS dv_nhdt_e10,
    SUM(a.dv_commo_e13) AS dv_commo_e13,
    SUM(a.dv_khac_e13) AS dv_khac_e13,
    SUM(a.fx_nte_e14) AS fx_nte_e14,
    SUM(a.dtk_thu_e15) AS dtk_thu_e15,
    SUM(a.dtk_chiftp_e16) AS dtk_chiftp_e16,
    SUM(a.bt_khac_e17) AS bt_khac_e17,
    SUM(a.bt_xln_e18) AS bt_xln_e18,
    SUM(a.dp_dautu_f1) AS dp_dautu_f1,
    SUM(a.dp_lc_f2) AS dp_lc_f2,
    SUM(a.dp_bl_f3) AS dp_bl_f3,
    SUM(a.dp_td_f4) AS dp_td_f4,
    SUM(a.dp_k) AS dp_k,
    SUM(a.thulaithuan_n) AS thulaithuan_n,
    SUM(a.thulai_kh_j) AS thulai_kh_j,
    SUM(a.chilai_ftp_k) AS chilai_ftp_k,
    SUM(a.chilai_kh_l) AS chilai_kh_l,
    SUM(a.thulai_ftp_m) AS thulai_ftp_m,
    SUM(a.thu_ngoai_lai_o) AS thu_ngoai_lai_o,
    SUM(a.dtttrr_p) AS dtttrr_p,
    SUM(a.chilai_ftp_tindung_k1) AS chilai_ftp_tindung_k1,
    SUM(a.chiftp_khac_k2) AS chiftp_khac_k2,
    SUM(a.chiftp_traiphieu_k3) AS chiftp_traiphieu_k3,
    SUM(a.thulai_ftp_m1) AS thulai_ftp_m1,
    SUM(a.thuftp_khac_m2) AS thuftp_khac_m2,
    SUM(a.fx_nte_e14a) AS fx_nte_e14a,
    SUM(a.dttsrr_i) AS dttsrr_i,
    SUM(a.dttsrr_p) AS dttsrr_p
FROM etl.PNL_KENHSO_MONTHLY_tmp_step3 a
LEFT JOIN etl.REF_AICT_BRANCH_M b
 ON a.MA_CN = b.BRANCH_CODE_T24
 and a.transaction_date = b.transaction_date
--where a.transaction_date = to_date({PRD_ID}, 'YYYYMMDD')
group by a.transaction_date,
 a.ma_cn,
 b.PARENT_BRANCH_CODE_T24,
 a.makh,
 a.khoi,
 a.product_code,
 a.KENH,
 a.CUS_STATUS</sql>
    <limit>0</limit>
