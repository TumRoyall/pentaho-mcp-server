    <connection>tckt_dc</connection>
    <sql>select a.transaction_date,
    a.MA_CN,
    b.PARENT_BRANCH_CODE_T24,
    makh,
    khoi,
    PRODUCT_CODE,
    KENH,
    cus_status,
    SUM(nvl(a.dtttrr_i,0)) dtttrr,
    SUM(nvl(a.dttsrr_i,0)) dttsrr,
    SUM(nvl(a.thulai_kh_a, 0) + nvl(a.chilai_ftp_b, 0)) tt_tindung,
    SUM(nvl(a.chilai_kh_c, 0) + nvl(a.thulai_ftp_d, 0)) tt_huydong,
    SUM(nvl(a.thu_ngoai_lai_e, 0)) thu_ngoai_lai,
    SUM(nvl(a.bt_khac_e17, 0) + nvl(bt_xln_e18, 0)) thu_bat_thuong,
    SUM(nvl(a.chi_dp_f, 0)) du_phong,
    SUM(nvl(a.dv_utbhck_e5, 0)) thu_bancase,
    SUM(nvl(a.dv_kieuhoi_e9, 0)) thu_kh,
    SUM(nvl(a.dv_ttqt_e2, 0)) thu_ttqt,
    SUM(nvl(a.fx_nte_e14, 0)) thu_ngoai_hoi_ps,
    SUM(nvl(a.dv_baolanh_e1, 0)) thu_bl,
    SUM(nvl(a.dv_tttn_e3, 0)) tt_dv_tt_noidia,
    SUM(nvl(a.dtttrr_i, 0)) dtttrr_i,
    SUM(nvl(a.thu_lai_thuan, 0)) thu_lai_thuan,
    SUM(nvl(a.thulai_kh_a, 0)) thulai_kh_a,
    SUM(nvl(a.chilai_ftp_b, 0)) chilai_ftp_b,
    SUM(nvl(a.chilai_kh_c, 0)) chilai_kh_c,
    SUM(nvl(a.thulai_ftp_d, 0)) thulai_ftp_d,
    SUM(nvl(a.thu_ngoai_lai_e, 0)) thu_ngoai_lai_e,
    SUM(nvl(a.chi_dp_f, 0)) chi_dp_f,
    SUM(nvl(a.thulai_tindung_a1, 0)) thulai_tindung_a1,
    SUM(nvl(a.thu_lai_khac_a2, 0)) thu_lai_khac_a2,
    SUM(nvl(a.thulai_traiphieu_a3, 0)) thulai_traiphieu_a3,
    SUM(nvl(a.chiftp_tindung_b1, 0)) chiftp_tindung_b1,
    SUM(nvl(a.chiftp_khac_b2, 0)) chiftp_khac_b2,
    SUM(nvl(a.chiftp_traiphieu_b3, 0)) chiftp_traiphieu_b3,
    SUM(nvl(a.thuftp_duphongtd_b4, 0)) thuftp_duphongtd_b4,
    SUM(nvl(a.thuftp_duphongkhac_b3, 0)) thuftp_duphongkhac_b3,
    SUM(nvl(a.thuftp_duphongtp_b4, 0)) thuftp_duphongtp_b4,
    SUM(nvl(a.chilai_huydong_c1, 0)) chilai_huydong_c1,
    SUM(nvl(a.chilai_khac_c2, 0)) chilai_khac_c2,
    SUM(nvl(a.chilai_traiphieu_c3, 0)) chilai_traiphieu_c3,
    SUM(nvl(a.thuftp_huydong_d1, 0)) thuftp_huydong_d1,
    SUM(nvl(a.thuftp_khac_d2, 0)) thuftp_khac_d2,
    SUM(nvl(a.dv_baolanh_e1, 0)) dv_baolanh_e1,
    SUM(nvl(a.dv_ttqt_e2, 0)) dv_ttqt_e2,
    SUM(nvl(a.dv_tttn_e3, 0)) dv_tttn_e3,
    SUM(nvl(a.dv_the_e4, 0)) dv_the_e4,
    SUM(nvl(a.dv_utbhck_e5, 0)) dv_utbhck_e5,
    SUM(nvl(a.dv_tuvan_e6, 0)) dv_tuvan_e6,
    SUM(nvl(a.dv_nganquy_e7, 0)) dv_nganquy_e7,
    SUM(nvl(a.dv_giuho_e8, 0)) dv_giuho_e8,
    SUM(nvl(a.dv_kieuhoi_e9, 0)) dv_kieuhoi_e9,
    SUM(nvl(a.dv_nhdt_e10, 0)) dv_nhdt_e10,
    SUM(nvl(a.dv_commo_e13, 0)) dv_commo_e13,
    SUM(nvl(a.dv_khac_e13, 0)) dv_khac_e13,
    SUM(nvl(a.fx_nte_e14, 0)) fx_nte_e14,
    SUM(nvl(a.dtk_thu_e15, 0)) dtk_thu_e15,
    SUM(nvl(a.dtk_chiftp_e16, 0)) dtk_chiftp_e16,
    SUM(nvl(a.bt_khac_e17, 0)) bt_khac_e17,
    SUM(nvl(a.bt_xln_e18, 0)) bt_xln_e18,
    SUM(nvl(a.dp_dautu_f1, 0)) dp_dautu_f1,
    SUM(nvl(a.dp_lc_f2, 0)) dp_lc_f2,
    SUM(nvl(a.dp_bl_f3, 0)) dp_bl_f3,
    SUM(nvl(a.dp_td_f4, 0)) dp_td_f4,
    SUM(nvl(a.dp_k, 0)) dp_k,
    SUM(nvl(a.thulaithuan_n, 0)) thulaithuan_n,
    SUM(nvl(a.thulai_kh_j, 0)) thulai_kh_j,
    SUM(nvl(a.chilai_ftp_k, 0)) chilai_ftp_k,
    SUM(nvl(a.chilai_kh_l, 0)) chilai_kh_l,
    SUM(nvl(a.thulai_ftp_m, 0)) thulai_ftp_m,
    SUM(nvl(a.thu_ngoai_lai_o, 0)) thu_ngoai_lai_o,
    SUM(nvl(a.dtttrr_p, 0)) dtttrr_p,
    SUM(nvl(a.chilai_ftp_tindung_k1, 0)) chilai_ftp_tindung_k1,
    SUM(nvl(a.chiftp_khac_k2, 0)) chiftp_khac_k2,
    SUM(nvl(a.chiftp_traiphieu_k3, 0)) chiftp_traiphieu_k3,
    SUM(nvl(a.thulai_ftp_m1, 0)) thulai_ftp_m1,
    SUM(nvl(a.thuftp_khac_m2, 0)) thuftp_khac_m2,
    SUM(nvl(a.fx_nte_e14a, 0)) fx_nte_e14a,
    SUM(nvl(a.dttsrr_i, 0)) dttsrr_i,
    SUM(nvl(a.dttsrr_p, 0)) dttsrr_p
from etl.TMP_TOI_KENHSO_MONTHLY a
left join etl.REF_AICT_BRANCH_M b
    on a.MA_CN = b.BRANCH_CODE_T24
    and b.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
where a.transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
GROUP BY a.transaction_date,
    a.MA_CN,
    b.PARENT_BRANCH_CODE_T24,
    makh,
    khoi,
    PRODUCT_CODE,
    KENH,
    cus_status
</sql>
