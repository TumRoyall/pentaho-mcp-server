  <step>
    <name>TD555_TD556_TD559</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection/>
    <sql>SELECT a.*,
       (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0) - NVL(A.Y_ST_THUNO, 0)) *
       (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
       nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0)) / 36000 FTP_AMOUNT,
       (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0) - NVL(A.Y_ST_THUNO, 0)) *
       (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
       nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0) +
       nvl(FTP_DIEUCHINH_ALCO, 0)) / 36000 FTP_AMOUNT_WITH_ALCO
  FROM (
        
        select a.GL,
                a.SOTK,
                a.MA_TP,
                a.MAKH,
                a.TENKH,
                a.SODU,
                a.SODU_VND,
                a.KHOI,
                a.CN,
                a.CCY,
                a.ISSUER,
                a.INT_RATE,
                a.KY_HAN,
                a.VAL_DATE,
                a.MAT_DATE,
                a.MUCDICH,
                a.CHUYENDOI,
                a.NIEMYET,
                a.TSDB,
                a.TRANSACTION_DATE,
                a.Y_ISSUER_SECTOR,
                a.Y_ISSUER_SECTOR_NAME,
                a.Y_ISSUER_INDUSTRY,
                a.Y_ISSUER_INDUSTRY_NAME,
                a.LOAI_TP,
                a.GIATRI_TSDB,
                a.Y_AMOUNT_CUR,
                a.Y_AMOUNT_LCY,
                a.Y_MATURITY_DATE,
                a.FTP_CODE,
                a.Y_KY_TAILAISUAT,
                a.Y_NGAY_TDLS_DAQUA,
                a.Y_NGAY_TDLS_TUONGLAI,
                A.ISSUE_DATE,
                A.Y_ST_THUNO,
                A.Y_CO_CODE,
                A.Y_SC_CUSTOMER, -- 23/03
                A.KYHAN_TDG,
                VM.VUNG_MIEN,
                DP.SODU_DP,
                C.AMOUNT                 FTP_LS_BASE,
                H.tile_bhtg,
                G.cp_dtbb,
                F.AMOUNT                 FTP_CHIPHI_TK,
                E.AMOUNT                 FTP_PHUTROI_TK,
                D.AMOUNT                 FTP_DIEUCHINH_ALCO,
                D.BIENDO_KHOI,
                D.BIENDO_SANPHAM,
                D.BIENDO_VUNGMIEN
          FROM (select A.*,
                        --Ky han uoc tinh thu hoi no
                        (SELECT KYHAN_TDG
                           FROM apps.FTP_TR_SAOKE_OTHER KHTDG
                          WHERE DATE_TX =
                                (SELECT MAX(DATE_TX)
                                   FROM apps.FTP_TR_SAOKE_OTHER B
                                  WHERE B.curr = KHTDG.curr
                                    AND B.DATE_TX &lt;= (case
                                          when A.Y_NGAY_TDLS_DAQUA &lt;
                                               to_date('20160923', 'yyyyMMdd') then
                                           to_date('20160923', 'yyyyMMdd')
                                          else
                                           A.Y_NGAY_TDLS_DAQUA
                                        end)
                                    AND B.curr = A.CCY)) KYHAN_TDG
                   from apps.mb_tr_saoke_sc a
                  where transaction_date = to_date(${PRD_ID}, 'yyyyMMdd')
                       --tinh cho TP VAMC TD555
                    AND a.ftp_code = 'TD555') A
        
          LEFT JOIN apps.ftp_dic_vungmien_khuvuc VM
            on nvl(a.Y_CO_CODE, A.CN) = VM.cn_cap_2
        --so du du phong
          LEFT JOIN (select MA_TP, SODU_DP
                       from apps.mb_tr_duphong_kh
                      where transaction_date =
                            trunc(trunc(to_date(${PRD_ID}, 'yyyyMMdd'),
                                        'MONTH') - 1,
                                  'MONTH') - 1
                        --and loai_dp = 'DP_TPVAMC'
) DP --DPCT_TPDN
            ON A.MA_TP = DP.MA_TP
        --L?Y LS BASE
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_FTP_BASE A
                      WHERE A.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_FTP_BASE B
                              WHERE B.CURRENCY = A.CURRENCY
                                AND B.TERM = A.TERM
                                AND B.DATE_APPLY &lt;=
                                    to_date(${PRD_ID}, 'yyyyMMdd'))) C
            ON A.CCY = C.CURRENCY
           AND A.KYHAN_TDG = C.TERM
        
        --LAY CHI PHI BHTG      
          LEFT JOIN (SELECT *
                       FROM apps.ftp_dic_chiphi_bhtg A
                      WHERE A.DATE_TX =
                            (SELECT MAX(DATE_TX)
                               FROM apps.ftp_dic_chiphi_bhtg B
                              WHERE B.CCY = A.CCY
                                AND B.DATE_TX &lt;= to_date(${PRD_ID}, 'yyyyMMdd'))) H
            ON A.CCY = H.CCY
        --LAY CHI PHI DTBB
          LEFT JOIN (SELECT *
                       FROM apps.ftp_dic_chiphi_dtbb A
                      WHERE A.DATE_TX =
                            (SELECT MAX(DATE_TX)
                               FROM apps.ftp_dic_chiphi_dtbb B
                              WHERE B.CCY = A.CCY
                                AND B.DATE_TX &lt;= to_date(${PRD_ID}, 'yyyyMMdd'))) G
            ON A.CCY = G.CCY
        
        -- lay chi phi thanh khoan
        
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_CHIPHI_TK A
                      WHERE A.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_CHIPHI_TK B
                              WHERE B.CURRENCY = A.CURRENCY
                                AND B.DATE_APPLY &lt;=
                                    trunc(to_date(${PRD_ID}, 'yyyyMMdd'),
                                          'MONTH') - 1)) F
            ON A.CCY = F.CURRENCY
        
        --LAY PHU TROI TK
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_PHUTROI PHUTROI
                      WHERE PHUTROI.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_PHUTROI B
                              WHERE B.CURRENCY = PHUTROI.CURRENCY
                                AND B.TERM = PHUTROI.TERM
                                AND B.DATE_APPLY &lt;=
                                    to_date(${PRD_ID}, 'yyyyMMdd')
                             
                             )) E
            ON A.CCY = E.CURRENCY
           AND A.KYHAN_TDG = E.TERM
        
        --L?Y ?I?U CH?NH ALCO
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_DIEUCHINH_ALCO A
                      WHERE A.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                              WHERE B.FTP_PRODUCT = A.FTP_PRODUCT
                                AND B.KHOI = A.KHOI
                                AND B.VUNG_MIEN = A.VUNG_MIEN
                                AND B.CURRENCY = A.CURRENCY
                                AND B.TERM = A.TERM
                                AND B.DATE_APPLY &lt;=
                                    to_date(${PRD_ID}, 'yyyyMMdd'))) D
            ON A.FTP_CODE = D.FTP_PRODUCT
           AND A.KHOI = D.KHOI
           AND VM.Vung_Mien = D.VUNG_MIEN
           AND A.KYHAN_TDG = D.TERM
           AND A.CCY = D.CURRENCY) A

union all
--TD556, TD559 and...           
SELECT a.*,
       CASE
         WHEN A.FTP_CODE IN ('TD556', 'TD559') THEN
          (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0)) *
          (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
          nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0)) / 36000
         ELSE
          NULL
       END FTP_AMOUNT,
       CASE
         WHEN A.FTP_CODE IN ('TD556', 'TD559') THEN
          (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0)) *
          (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
          nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0) +
          nvl(FTP_DIEUCHINH_ALCO, 0)) / 36000
         ELSE
          NULL
       END FTP_AMOUNT_WITH_ALCO
  FROM (select a.GL,
               a.SOTK,
               a.MA_TP,
               a.MAKH,
               a.TENKH,
               a.SODU,
               a.SODU_VND,
               a.KHOI,
               a.CN,
               a.CCY,
               a.ISSUER,
               a.INT_RATE,
               a.KY_HAN,
               a.VAL_DATE,
               a.MAT_DATE,
               a.MUCDICH,
               a.CHUYENDOI,
               a.NIEMYET,
               a.TSDB,
               a.TRANSACTION_DATE,
               a.Y_ISSUER_SECTOR,
               a.Y_ISSUER_SECTOR_NAME,
               a.Y_ISSUER_INDUSTRY,
               a.Y_ISSUER_INDUSTRY_NAME,
               a.LOAI_TP,
               a.GIATRI_TSDB,
               a.Y_AMOUNT_CUR,
               a.Y_AMOUNT_LCY,
               a.Y_MATURITY_DATE,
               a.FTP_CODE,
               a.Y_KY_TAILAISUAT,
               a.Y_NGAY_TDLS_DAQUA,
               a.Y_NGAY_TDLS_TUONGLAI,
               A.ISSUE_DATE,
               A.Y_ST_THUNO,
               A.Y_CO_CODE,
               A.Y_SC_CUSTOMER, -- 23/03
               (CASE
                 WHEN to_date(a.MAT_DATE, 'yyyyMMdd') &lt;
                      to_date(${PRD_ID}, 'yyyyMMdd') then
                 --Ky han uoc tinh thu hoi no
                  (SELECT KYHAN_TDG
                     FROM apps.FTP_TR_SAOKE_OTHER KHTDG
                    WHERE DATE_TX =
                          (SELECT MAX(DATE_TX)
                             FROM apps.FTP_TR_SAOKE_OTHER B
                            WHERE B.curr = KHTDG.curr
                              AND B.DATE_TX &lt;= (case
                                    when A.Y_NGAY_TDLS_DAQUA &lt;
                                         to_date('20160923', 'yyyyMMdd') then
                                     to_date('20160923', 'yyyyMMdd')
                                    else
                                     A.Y_NGAY_TDLS_DAQUA
                                  end)
                              AND B.curr = A.CCY))
                 else
                  (select TERM_ID
                     from apps.ftp_dic_map_term
                    where CURR_ID = A.CCY
                      AND from_day &lt;=
                          (to_date(a.MAT_DATE, 'yyyyMMdd') - a.issue_date + 1)
                      and to_day >=
                          (to_date(a.MAT_DATE, 'yyyyMMdd') - a.issue_date + 1))
               end) KYHAN_TDG,
               VM.VUNG_MIEN,
               DP.SODU_DP,
               --LS BASE       
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_FTP_BASE ftp_base
                 WHERE ftp_base.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_FTP_BASE B
                         WHERE B.CURRENCY = ftp_base.CURRENCY
                           AND B.TERM = ftp_base.TERM
                           AND B.DATE_APPLY &lt;= (case
                                 when A.Y_NGAY_TDLS_DAQUA &lt;
                                      to_date('20160923', 'yyyyMMdd') then
                                  to_date('20160923', 'yyyyMMdd')
                                 else
                                  A.Y_NGAY_TDLS_DAQUA
                               end)
                           AND B.Currency = a.CCY
                           AND B.Term = A.Y_KY_TAILAISUAT)) FTP_LS_BASE,
               --CHI PHI BHTG
               (SELECT tile_bhtg
                  FROM apps.ftp_dic_chiphi_bhtg bhtg
                 WHERE bhtg.DATE_TX =
                       (SELECT MAX(DATE_TX)
                          FROM apps.ftp_dic_chiphi_bhtg B
                         WHERE B.CCY = bhtg.CCY
                           AND B.DATE_TX &lt;= (case
                                 when A.Y_NGAY_TDLS_DAQUA &lt;
                                      to_date('20160923', 'yyyyMMdd') then
                                  to_date('20160923', 'yyyyMMdd')
                                 else
                                  A.Y_NGAY_TDLS_DAQUA
                               end)
                           AND B.CCY = A.CCY)) tile_bhtg,
               
               --chi phu dtbb
               (SELECT cp_dtbb
                  FROM apps.ftp_dic_chiphi_dtbb dtbb
                 WHERE dtbb.DATE_TX =
                       (SELECT MAX(DATE_TX)
                          FROM apps.ftp_dic_chiphi_dtbb B
                         WHERE B.CCY = dtbb.CCY
                           AND B.DATE_TX &lt;= (case
                                 when A.Y_NGAY_TDLS_DAQUA &lt;
                                      to_date('20160923', 'yyyyMMdd') then
                                  to_date('20160923', 'yyyyMMdd')
                                 else
                                  A.Y_NGAY_TDLS_DAQUA
                               end)
                           AND B.CCY = A.CCY)) cp_dtbb,
               
               --chi phi thanh khoan
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_CHIPHI_TK TK
                 WHERE TK.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_CHIPHI_TK B
                         WHERE B.CURRENCY = TK.CURRENCY
                           AND B.DATE_APPLY &lt;= (case
                                 when A.Y_NGAY_TDLS_DAQUA &lt;
                                      to_date('20160923', 'yyyyMMdd') then
                                  to_date('20160923', 'yyyyMMdd')
                                 else
                                  A.Y_NGAY_TDLS_DAQUA
                               end)
                           AND B.Currency = A.CCY)) FTP_CHIPHI_TK,
               
               --LAY PHU TROI TK
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_PHUTROI PHUTROI
                 WHERE PHUTROI.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_PHUTROI B
                         WHERE B.CURRENCY = PHUTROI.CURRENCY
                           AND B.TERM = PHUTROI.TERM
                           AND B.DATE_APPLY &lt;= a.issue_date
                           AND B.CURRENCY = A.CCY
                           AND B.TERM = (CASE
                                 WHEN to_date(a.MAT_DATE, 'yyyyMMdd') &lt;
                                      to_date(${PRD_ID}, 'yyyyMMdd') then
                                 --Ky han uoc tinh thu hoi no
                                  (SELECT KYHAN_TDG
                                     FROM apps.FTP_TR_SAOKE_OTHER KHTDG
                                    WHERE DATE_TX =
                                          (SELECT MAX(DATE_TX)
                                             FROM apps.FTP_TR_SAOKE_OTHER B
                                            WHERE B.curr = KHTDG.curr
                                              AND B.DATE_TX &lt;= (case
                                                    when A.Y_NGAY_TDLS_DAQUA &lt;
                                                         to_date('20160923',
                                                                 'yyyyMMdd') then
                                                     to_date('20160923',
                                                             'yyyyMMdd')
                                                    else
                                                     A.Y_NGAY_TDLS_DAQUA
                                                  end)
                                              AND B.curr = A.CCY))
                                 else
                                  (select TERM_ID
                                     from apps.ftp_dic_map_term
                                    where CURR_ID = A.CCY
                                      AND from_day &lt;=
                                          (to_date(a.MAT_DATE, 'yyyyMMdd') -
                                          a.issue_date + 1)
                                      and to_day >=
                                          (to_date(a.MAT_DATE, 'yyyyMMdd') -
                                          a.issue_date + 1))
                               end)
                        
                        )) FTP_PHUTROI_TK,
               
               --L?Y ?I?U CH?NH ALCO
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_DIEUCHINH_ALCO ALCO
                 WHERE ALCO.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                         WHERE B.FTP_PRODUCT = ALCO.FTP_PRODUCT
                           AND B.KHOI = ALCO.KHOI
                           AND B.VUNG_MIEN = ALCO.VUNG_MIEN
                           AND B.CURRENCY = ALCO.CURRENCY
                           AND B.TERM = ALCO.TERM
                           AND B.DATE_APPLY &lt;= (case
                                 when A.Y_NGAY_TDLS_DAQUA &lt;
                                      to_date('20160923', 'yyyyMMdd') then
                                  to_date('20160923', 'yyyyMMdd')
                                 else
                                  A.Y_NGAY_TDLS_DAQUA
                               end)
                              
                           AND B.FTP_PRODUCT = A.FTP_CODE
                           AND B.KHOI = A.KHOI
                           AND B.VUNG_MIEN = VM.VUNG_MIEN
                           AND B.CURRENCY = A.CCY
                           AND B.TERM = a.y_Ky_Tailaisuat)) FTP_DIEUCHINH_ALCO,
               
               null BIENDO_KHOI,
               null BIENDO_SANPHAM,
               null BIENDO_VUNGMIEN
        
          from apps.mb_tr_saoke_sc a
          LEFT JOIN apps.ftp_dic_vungmien_khuvuc VM
            on nvl(a.Y_CO_CODE, A.CN) = VM.cn_cap_2
        --so du du phong
          LEFT JOIN (select MA_TP, SUM(SODU_DP) SODU_DP
                      from apps.mb_tr_duphong_kh
                     where transaction_date =
                           trunc(trunc(to_date(${PRD_ID}, 'yyyyMMdd'),
                                       'MONTH') - 1,
                                 'MONTH') - 1
                       --and loai_dp = 'DPCT_TPDN'
          group by MA_TP
) DP --DPCT_TPDN
            ON A.SOTK = DP.MA_TP
         where transaction_date = to_date(${PRD_ID}, 'yyyyMMdd')
           and (a.ftp_code != 'TD555' OR a.ftp_code is null)) A

/* cu

SELECT a.*,
       (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0) - NVL(A.Y_ST_THUNO, 0)) *
       (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
       nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0)) / 36000 FTP_AMOUNT,
(nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0) - NVL(A.Y_ST_THUNO, 0)) *
       (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
       nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0) +
       nvl(FTP_DIEUCHINH_ALCO, 0)) / 36000 FTP_AMOUNT_WITH_ALCO
  FROM (
        
        select a.GL,
                a.SOTK,
                a.MA_TP,
                a.MAKH,
                a.TENKH,
                a.SODU,
                a.SODU_VND,
                a.KHOI,
                a.CN,
                a.CCY,
                a.ISSUER,
                a.INT_RATE,
                a.KY_HAN,
                a.VAL_DATE,
                a.MAT_DATE,
                a.MUCDICH,
                a.CHUYENDOI,
                a.NIEMYET,
                a.TSDB,
                a.TRANSACTION_DATE,
                a.Y_ISSUER_SECTOR,
                a.Y_ISSUER_SECTOR_NAME,
                a.Y_ISSUER_INDUSTRY,
                a.Y_ISSUER_INDUSTRY_NAME,
                a.LOAI_TP,
                a.GIATRI_TSDB,
                a.Y_AMOUNT_CUR,
                a.Y_AMOUNT_LCY,
                a.Y_MATURITY_DATE,
                a.FTP_CODE,
                a.Y_KY_TAILAISUAT,
                a.Y_NGAY_TDLS_DAQUA,
                a.Y_NGAY_TDLS_TUONGLAI,
                A.ISSUE_DATE,
                A.Y_ST_THUNO,
                A.Y_CO_CODE,
                A.KYHAN_TDG,
                VM.VUNG_MIEN,
                DP.SODU_DP,
                C.AMOUNT                 FTP_LS_BASE,
                H.tile_bhtg,
                G.cp_dtbb,
                F.AMOUNT                 FTP_CHIPHI_TK,
                E.AMOUNT                 FTP_PHUTROI_TK,
                D.AMOUNT                 FTP_DIEUCHINH_ALCO,
                D.BIENDO_KHOI,
                D.BIENDO_SANPHAM,
                D.BIENDO_VUNGMIEN
          FROM (select A.*,
                        --Ky han uoc tinh thu hoi no
                        (SELECT KYHAN_TDG
                           FROM apps.FTP_TR_SAOKE_OTHER KHTDG
                          WHERE DATE_TX =
                                (SELECT MAX(DATE_TX)
                                   FROM apps.FTP_TR_SAOKE_OTHER B
                                  WHERE B.curr = KHTDG.curr
                                    AND B.DATE_TX &lt;= A.Y_NGAY_TDLS_DAQUA
                                    AND B.curr = A.CCY)) KYHAN_TDG
                   from apps.mb_tr_saoke_sc a
                  where transaction_date = to_date(${PRD_ID}, 'yyyyMMdd')
                       --tinh cho TP VAMC TD555
                    AND a.ftp_code = 'TD555') A
        
          LEFT JOIN apps.ftp_dic_vungmien_khuvuc VM
            on nvl(a.Y_CO_CODE,A.CN) = VM.cn_cap_2
        --so du du phong
          LEFT JOIN (select MA_TP, SODU_DP
                       from apps.mb_tr_duphong_kh
                      where transaction_date =
                            trunc(trunc(to_date(${PRD_ID}, 'yyyyMMdd'), 'MONTH') - 1,
                                  'MONTH') - 1
                        and loai_dp = 'DP_TPVAMC') DP --DPCT_TPDN
            ON A.MA_TP = DP.MA_TP
        --L?Y LS BASE
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_FTP_BASE A
                      WHERE A.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_FTP_BASE B
                              WHERE B.CURRENCY = A.CURRENCY
                                AND B.TERM = A.TERM
                                AND B.DATE_APPLY &lt;=
                                    to_date(${PRD_ID}, 'yyyyMMdd'))) C
            ON A.CCY = C.CURRENCY
           AND A.KYHAN_TDG = C.TERM
        
        --LAY CHI PHI BHTG      
          LEFT JOIN (SELECT *
                       FROM apps.ftp_dic_chiphi_bhtg A
                      WHERE A.DATE_TX =
                            (SELECT MAX(DATE_TX)
                               FROM apps.ftp_dic_chiphi_bhtg B
                              WHERE B.CCY = A.CCY
                                AND B.DATE_TX &lt;= to_date(${PRD_ID}, 'yyyyMMdd'))) H
            ON A.CCY = H.CCY
        --LAY CHI PHI DTBB
          LEFT JOIN (SELECT *
                       FROM apps.ftp_dic_chiphi_dtbb A
                      WHERE A.DATE_TX =
                            (SELECT MAX(DATE_TX)
                               FROM apps.ftp_dic_chiphi_dtbb B
                              WHERE B.CCY = A.CCY
                                AND B.DATE_TX &lt;= to_date(${PRD_ID}, 'yyyyMMdd'))) G
            ON A.CCY = G.CCY
        
        -- lay chi phi thanh khoan
        
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_CHIPHI_TK A
                      WHERE A.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_CHIPHI_TK B
                              WHERE B.CURRENCY = A.CURRENCY
                                AND B.DATE_APPLY &lt;=
                                    trunc(to_date(${PRD_ID}, 'yyyyMMdd'), 'MONTH') - 1)) F
            ON A.CCY = F.CURRENCY
        
        --LAY PHU TROI TK
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_PHUTROI PHUTROI
                      WHERE PHUTROI.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_PHUTROI B
                              WHERE B.CURRENCY = PHUTROI.CURRENCY
                                AND B.TERM = PHUTROI.TERM
                                AND B.DATE_APPLY &lt;=
                                    to_date(${PRD_ID}, 'yyyyMMdd')
                             
                             )) E
            ON A.CCY = E.CURRENCY
           AND A.KYHAN_TDG = E.TERM
        
        --L?Y ?I?U CH?NH ALCO
          LEFT JOIN (SELECT *
                       FROM apps.FTP_DIC_DIEUCHINH_ALCO A
                      WHERE A.DATE_APPLY =
                            (SELECT MAX(DATE_APPLY)
                               FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                              WHERE B.FTP_PRODUCT = A.FTP_PRODUCT
                                AND B.KHOI = A.KHOI
                                AND B.VUNG_MIEN = A.VUNG_MIEN
                                AND B.CURRENCY = A.CURRENCY
                                AND B.TERM = A.TERM
                                AND B.DATE_APPLY &lt;=
                                    to_date(${PRD_ID}, 'yyyyMMdd'))) D
            ON A.FTP_CODE = D.FTP_PRODUCT
           AND A.KHOI = D.KHOI
           AND VM.Vung_Mien = D.VUNG_MIEN
           AND A.KYHAN_TDG = D.TERM
           AND A.CCY = D.CURRENCY) A

union all
--TD556, TD559 and...           
SELECT a.*,
       CASE
         WHEN A.FTP_CODE IN ('TD556', 'TD559') THEN
          (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0)) *
          (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
          nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0)) / 36000
         ELSE
          NULL
       END FTP_AMOUNT,
       CASE
         WHEN A.FTP_CODE IN ('TD556', 'TD559') THEN
          (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0)) *
          (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
          nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0) +
          nvl(FTP_DIEUCHINH_ALCO, 0)) / 36000
         ELSE
          NULL
       END FTP_AMOUNT_WITH_ALCO
  FROM (select a.GL,
               a.SOTK,
               a.MA_TP,
               a.MAKH,
               a.TENKH,
               a.SODU,
               a.SODU_VND,
               a.KHOI,
               a.CN,
               a.CCY,
               a.ISSUER,
               a.INT_RATE,
               a.KY_HAN,
               a.VAL_DATE,
               a.MAT_DATE,
               a.MUCDICH,
               a.CHUYENDOI,
               a.NIEMYET,
               a.TSDB,
               a.TRANSACTION_DATE,
               a.Y_ISSUER_SECTOR,
               a.Y_ISSUER_SECTOR_NAME,
               a.Y_ISSUER_INDUSTRY,
               a.Y_ISSUER_INDUSTRY_NAME,
               a.LOAI_TP,
               a.GIATRI_TSDB,
               a.Y_AMOUNT_CUR,
               a.Y_AMOUNT_LCY,
               a.Y_MATURITY_DATE,
               a.FTP_CODE,
               a.Y_KY_TAILAISUAT,
               a.Y_NGAY_TDLS_DAQUA,
               a.Y_NGAY_TDLS_TUONGLAI,
               A.ISSUE_DATE,
               A.Y_ST_THUNO,
               A.Y_CO_CODE,
               (select TERM_ID
                                  from apps.ftp_dic_map_term
                                 where CURR_ID = A.CCY
                                   AND from_day &lt;=
                                       (to_date(a.MAT_DATE, 'yyyyMMdd') -
                                       a.issue_date + 1)
                                   and to_day >=
                                       (to_date(a.MAT_DATE, 'yyyyMMdd') -
                                       a.issue_date + 1)) KYHAN_TDG,
               VM.VUNG_MIEN,
               DP.SODU_DP,
               --LS BASE       
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_FTP_BASE ftp_base
                 WHERE ftp_base.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_FTP_BASE B
                         WHERE B.CURRENCY = ftp_base.CURRENCY
                           AND B.TERM = ftp_base.TERM
                           AND B.DATE_APPLY &lt;= A.Y_NGAY_TDLS_DAQUA
                           AND B.Currency = a.CCY
                           AND B.Term = A.Y_KY_TAILAISUAT
        )) FTP_LS_BASE,
               --CHI PHI BHTG
               (SELECT tile_bhtg
                  FROM apps.ftp_dic_chiphi_bhtg bhtg
                 WHERE bhtg.DATE_TX = (SELECT MAX(DATE_TX)
                                         FROM apps.ftp_dic_chiphi_bhtg B
                                        WHERE B.CCY = bhtg.CCY
                                          AND B.DATE_TX &lt;= A.Y_NGAY_TDLS_DAQUA
                                          AND B.CCY = A.CCY)) tile_bhtg,
               
               --chi phu dtbb
               (SELECT cp_dtbb
                  FROM apps.ftp_dic_chiphi_dtbb dtbb
                 WHERE dtbb.DATE_TX = (SELECT MAX(DATE_TX)
                                         FROM apps.ftp_dic_chiphi_dtbb B
                                        WHERE B.CCY = dtbb.CCY
                                          AND B.DATE_TX &lt;= A.Y_NGAY_TDLS_DAQUA
                                          AND B.CCY = A.CCY)) cp_dtbb,
               
               --chi phi thanh khoan
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_CHIPHI_TK TK
                 WHERE TK.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_CHIPHI_TK B
                         WHERE B.CURRENCY = TK.CURRENCY
                           AND B.DATE_APPLY &lt;= A.Y_NGAY_TDLS_DAQUA
                           AND B.Currency = A.CCY)) FTP_CHIPHI_TK,
               
               --LAY PHU TROI TK
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_PHUTROI PHUTROI
                 WHERE PHUTROI.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_PHUTROI B
                         WHERE B.CURRENCY = PHUTROI.CURRENCY
                           AND B.TERM = PHUTROI.TERM
                           AND B.DATE_APPLY &lt;= a.issue_date
                           AND B.CURRENCY = A.CCY
                           AND B.TERM =
                               (select TERM_ID
                                  from apps.ftp_dic_map_term
                                 where CURR_ID = A.CCY
                                   AND from_day &lt;=
                                       (to_date(a.MAT_DATE, 'yyyyMMdd') -
                                       a.issue_date + 1)
                                   and to_day >=
                                       (to_date(a.MAT_DATE, 'yyyyMMdd') -
                                       a.issue_date + 1))
                        
                        )) FTP_PHUTROI_TK,
               
               --L?Y ?I?U CH?NH ALCO
               (SELECT AMOUNT
                  FROM apps.FTP_DIC_DIEUCHINH_ALCO ALCO
                 WHERE ALCO.DATE_APPLY =
                       (SELECT MAX(DATE_APPLY)
                          FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                         WHERE B.FTP_PRODUCT = ALCO.FTP_PRODUCT
                           AND B.KHOI = ALCO.KHOI
                           AND B.VUNG_MIEN = ALCO.VUNG_MIEN
                           AND B.CURRENCY = ALCO.CURRENCY
                           AND B.TERM = ALCO.TERM
                           AND B.DATE_APPLY &lt;= A.Y_NGAY_TDLS_DAQUA
                              
                           AND B.FTP_PRODUCT = A.FTP_CODE
                           AND B.KHOI = A.KHOI
                           AND B.VUNG_MIEN = VM.VUNG_MIEN
                           AND B.CURRENCY = A.CCY
                           AND B.TERM = a.y_Ky_Tailaisuat)) FTP_DIEUCHINH_ALCO,
               
               null BIENDO_KHOI,
               null BIENDO_SANPHAM,
               null BIENDO_VUNGMIEN
        
          from apps.mb_tr_saoke_sc a
          LEFT JOIN apps.ftp_dic_vungmien_khuvuc VM
            on nvl(a.Y_CO_CODE,A.CN) = VM.cn_cap_2
        --so du du phong
          LEFT JOIN (select MA_TP, SODU_DP
                      from apps.mb_tr_duphong_kh
                     where transaction_date =
                           trunc(trunc(to_date(${PRD_ID}, 'yyyyMMdd'), 'MONTH') - 1,
                                 'MONTH') - 1
                       and loai_dp = 'DPCT_TPDN') DP --DPCT_TPDN
            ON A.SOTK = DP.MA_TP
         where transaction_date = to_date(${PRD_ID}, 'yyyyMMdd')
           and (a.ftp_code != 'TD555' OR a.ftp_code is null)) A

*/
</sql>
