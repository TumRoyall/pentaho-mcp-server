  <step>
    <name>FIN_PNL_EXPN_SMY_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT LAST_DAY(A.TXN_DATE) TRANSACTION_DATE,
       A.BRANCH_CODE CN,
       A.SEG2 MA_SEG_KHOI_CP,
       A.OPEX_CODE_L1,
       A.OPEX_CODE_L2,
       A.OPEX_NAME_L1,
       A.OPEX_NAME_L2,
       A.DONVI_DAUMOI,
       'CHI_PHI' NS_TH_TYPE,
       SUM(CASE
               WHEN A.OPEX_CODE_L1 = '1.' THEN
                A.LCY_TXN_AMT
           END) CPHD,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.1.' THEN
                A.LCY_TXN_AMT
           END) CP_LUONG,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.2.' THEN
                A.LCY_TXN_AMT
           END) CP_TS,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.3.' THEN
                A.LCY_TXN_AMT
           END) CP_MARKETING,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.4.' THEN
                A.LCY_TXN_AMT
           END) CP_TRUYENTHONG,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.5.' THEN
                A.LCY_TXN_AMT
           END) CP_DAOTAO,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.6.' THEN
                A.LCY_TXN_AMT
           END) CP_TUVAN,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.7.' THEN
                A.LCY_TXN_AMT
           END) CP_TUYENDUNG,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.8.' THEN
                A.LCY_TXN_AMT
           END) CP_QLCV,
       NULL TEN_SEG_KHOI_CP,
       B.BRANCH_NAME_T24,
       B.PARENT_BRANCH_CODE_T24,
       B.PARENT_BRANCH_NAME_T24,
       B.TINH_THANH,
       B.VUNG_MIEN,
       B.TIEU_VUNG
  FROM APPS.FIN_PNL_EXPN_SMY_MONTHLY A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON A.BRANCH_CODE = B.BRANCH_CODE_T24
   AND LAST_DAY(A.TXN_DATE) = B.TRANSACTION_DATE
 WHERE A.TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'), 'mm') AND
       LAST_DAY(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
   AND A.OPEX_CODE_L1 = '1.'
 GROUP BY LAST_DAY(A.TXN_DATE),
          A.BRANCH_CODE,
          A.SEG1,
          A.SEG2,
          A.OPEX_CODE_L1,
          A.OPEX_CODE_L2,
          A.OPEX_NAME_L1,
          A.OPEX_NAME_L2,
          A.DONVI_DAUMOI,
          B.BRANCH_NAME_T24,
          B.PARENT_BRANCH_CODE_T24,
          B.PARENT_BRANCH_NAME_T24,
          B.TINH_THANH,
          B.VUNG_MIEN,
          B.TIEU_VUNG</sql>
    <limit>0</limit>
