  <step>
    <name>FILE_EXPN_PLAN</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT TO_DATE('${PRD_ID}', 'yyyyMMdd') TRANSACTION_DATE,
       B.BRANCH_CODE_T24 CN,
       A.MAKHOI MA_SEG_KHOI_CP,
       A.OPEX_CODE_L1,
       A.OPEX_CODE_L2,
       A.OPEX_NAME_L1,
       A.OPEX_NAME_L2,
       A.KEHOACH_HODAUMOI DONVI_DAUMOI,
       'KE_HOACH_GOC' NS_TH_TYPE,
       SUM(CASE
               WHEN A.OPEX_CODE_L1 = '1.' THEN
                A.TONG_KEHOACH
           END) CPHD,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.1.' THEN
                A.TONG_KEHOACH
           END) CP_LUONG,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.2.' THEN
                A.TONG_KEHOACH
           END) CP_TS,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.3.' THEN
                A.TONG_KEHOACH
           END) CP_MARKETING,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.4.' THEN
                A.TONG_KEHOACH
           END) CP_TRUYENTHONG,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.5.' THEN
                A.TONG_KEHOACH
           END) CP_DAOTAO,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.6.' THEN
                A.TONG_KEHOACH
           END) CP_TUVAN,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.7.' THEN
                A.TONG_KEHOACH
           END) CP_TUYENDUNG,
       SUM(CASE
               WHEN A.OPEX_CODE_L2 = '1.8.' THEN
                A.TONG_KEHOACH
           END) CP_QLCV,
       NULL TEN_SEG_KHOI_CP,
       B.BRANCH_NAME_T24,
       B.PARENT_BRANCH_CODE_T24,
       B.PARENT_BRANCH_NAME_T24,
       B.TINH_THANH,
       B.VUNG_MIEN,
       B.TIEU_VUNG
  FROM APPS.FILE_EXPN_PLAN A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON B.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
   AND A.MA_CNC2 = B.BRANCH_CODE_T24
 WHERE A.NAM_NGANSACH = EXTRACT(YEAR FROM TO_DATE('${PRD_ID}', 'yyyyMMdd'))
 GROUP BY A.TRANSACTION_DATE,
          B.BRANCH_CODE_T24,
          A.MAKHOI,
          A.OPEX_CODE_L1,
          A.OPEX_CODE_L2,
          A.OPEX_NAME_L1,
          A.OPEX_NAME_L2,
          A.KEHOACH_HODAUMOI,
          B.BRANCH_NAME_T24,
          B.PARENT_BRANCH_CODE_T24,
          B.PARENT_BRANCH_NAME_T24,
          B.TINH_THANH,
          B.VUNG_MIEN,
          B.TIEU_VUNG</sql>
    <limit>0</limit>
