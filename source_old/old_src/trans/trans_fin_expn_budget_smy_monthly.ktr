  </step>
  <step>
    <name>FIN_GL_FA_DEPRICIATION_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT A.TRANSACTION_DATE,
       B.BRANCH_CODE_T24 CN,
       A. MA_SEG_KHOI_CP,
       E.OPEX_CODE_L1,
       E.OPEX_CODE_L2,
       E.OPEX_NAME_L1,
       E.OPEX_NAME_L2,
       E.DONVI_DAUMOI,
       'KHAU_HAO' NS_TH_TYPE,
       SUM(CASE
               WHEN E.OPEX_CODE_L1 = '1.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CPHD,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.1.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_LUONG,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.2.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_TS,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.3.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_MARKETING,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.4.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_TRUYENTHONG,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.5.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_DAOTAO,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.6.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_TUVAN,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.7.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_TUYENDUNG,
       SUM(CASE
               WHEN E.OPEX_CODE_L2 = '1.8.' THEN
                -A.KHAUHAO_THANG_CHUATH
           END) CP_QLCV,
       NULL TEN_SEG_KHOI_CP,
       B.BRANCH_NAME_T24,
       B.PARENT_BRANCH_CODE_T24,
       B.PARENT_BRANCH_NAME_T24,
       B.TINH_THANH,
       B.VUNG_MIEN,
       B.TIEU_VUNG
  FROM APPS.FIN_GL_FA_DEPRICIATION_MONTHLY A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
   AND 'VN0010' || A.MA_SEG_CN_CP = B.BRANCH_CODE_T24
  LEFT JOIN APPS. FILE_EXPN_CODE_MAP E
    ON A.GL_LINE_CP = E.GL_LINE
 WHERE A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
 GROUP BY A.TRANSACTION_DATE,
          B.BRANCH_CODE_T24,
          A. MA_SEG_KHOI_CP,
          E.OPEX_CODE_L1,
          E.OPEX_CODE_L2,
          E.OPEX_NAME_L1,
          E.OPEX_NAME_L2,
          E.DONVI_DAUMOI,
          B.BRANCH_NAME_T24,
          B.PARENT_BRANCH_CODE_T24,
          B.PARENT_BRANCH_NAME_T24,
          B.TINH_THANH,
          B.VUNG_MIEN,
          B.TIEU_VUNG</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
