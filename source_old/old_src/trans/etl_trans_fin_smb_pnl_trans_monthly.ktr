  <step>
    <name>ORS_CAL_FTP_CHUNGCHI_TG_ONLINE_THUCAP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH rm_id AS
(SELECT ma_cn,smb FROM ETL.SMB_RM_ID
GROUP BY ma_cn,smb)
SELECT 
onl.transaction_date,
onl.KEY SOTK,
td.BRANCH_CODE ma_cnc2,
onl.ASSIGNER makh,
fin.khoi,
td.PRODUCT_CODE,
'ETL.ORS_CAL_FTP_CHUNGCHI_TG_ONLINE_THUCAP' SOURCE_TABLE,
co_id.rm_code,
'' CHG_CODE,
'' LINE_GL,
''MACHITIEU,
''CHITIEU,
co_id.tk_type,
SUM(nvl(onl.LAI_SOCAP,0) + nvl(onl.FTP_SOCAP,0)) AMT_LCY,
rm_id.smb SMB_NAME
FROM ETL.ORS_CAL_FTP_CHUNGCHI_TG_ONLINE_THUCAP onl
LEFT JOIN etl.ODS_SECOND_TD_CONTRACT td
ON onl.KEY = td.ARRANGEMENT_NBR 
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY fin
ON fin.TRANSACTION_DATE =TO_DATE(${PRD_ID}, 'YYYYMMDD')  
AND fin.makh = onl.ASSIGNER 
LEFT JOIN etl.smb_contract_id co_id 
ON co_id.transaction_date =TO_DATE(${PRD_ID}, 'YYYYMMDD')
AND co_id.sotk = onl.KEY 
LEFT JOIN rm_id ON TD.BRANCH_CODE =rm_id.ma_cn
WHERE TD.BRANCH_CODE  IN (SELECT ma_cn FROM rm_id)
AND ONL.KEY IN (SELECT SOTK FROM apps.smb_contract_id WHERE transaction_date =TO_DATE(${PRD_ID}, 'YYYYMMDD'))
and co_id.rm_code is not null
GROUP BY 
onl.transaction_date,
onl.KEY,
td.BRANCH_CODE,
onl.ASSIGNER,
fin.khoi,
td.PRODUCT_CODE,
co_id.rm_code,
co_id.tk_type,
rm_id.smb</sql>
