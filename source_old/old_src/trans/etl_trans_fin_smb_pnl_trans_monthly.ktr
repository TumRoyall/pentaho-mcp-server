    <connection>tckt_dc</connection>
    <sql>WITH rm_id AS
(SELECT ma_cn,smb FROM ETL.SMB_RM_ID
GROUP BY ma_cn,smb)
SELECT 
so.TRANSACTION_DATE,
so.sct SOTK,
so.MA_CN MA_CNC2,
so.makh,
so.khoi,
so.PRODUCT_CODE,
'ETL.TMP_TOI_SOURCE_INPUT' SOURCE_TABLE,
co_id.RM_code,
so.CHG_CODE,
SO.LINEGL LINE_GL,
SO.MACHITIEU,
SO.CHITIEU,
co_id.tk_type,
so.TIENNO_VND AMT_LCY,
rm_id.smb SMB_NAME
FROM ETL.TMP_TOI_SOURCE_INPUT so
JOIN apps.SMB_CONTRACT_ID  co_id
ON  co_id.TRANSACTION_DATE  = TO_DATE(${PRD_ID}, 'YYYYMMDD')  
And so.sct = co_id.sotk
LEFT JOIN rm_id 
ON so.ma_cn =rm_id.ma_cn
WHERE so.machitieu IN (SELECT machitieu FROM ETL.SMB_MAP_PNL_ITEM WHERE TYPE='KHAC')AND so.ma_cn IN (SELECT ma_cn FROM etl.smb_rm_id) -- nguon 1.3
and co_id.RM_code is not null</sql>
