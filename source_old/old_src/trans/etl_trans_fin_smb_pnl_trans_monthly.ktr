    <name>FIN_BANCAS_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH rm_id AS
(SELECT ma_cn,smb FROM ETL.SMB_RM_ID
GROUP BY ma_cn,smb)
SELECT *
FROM 
(
SELECT 
	  ba.TRANSACTION_DATE,
	  ba.POLICY_NUMBER SOTK,
	  ba.MA_CN MA_CNC2,
	  ba.makh,
	  CASE WHEN ba.khoi_KH IN ('SME','KHDN') THEN 'SME'
	  		WHEN ba.khoi_KH IN ('INDIV','KHCN','VH') THEN 'INDIV'
	  		ELSE ba.KHOI_KH END KHOI,
	  ba.BANCA_PRD_NAME PRODUCT_CODE,
	  'APPS.FIN_BANCAS_MONTHLY' SOURCE_TABLE,
	  rm.RM RM_code,
	  '' CHG_CODE,
	  '' LINE_GL,
	  'E5' MACHITIEU,
	  'dv_utbhck_e5' CHITIEU,
	  'BANCA' TK_TYPE,
	  sum(nvl(ba.COMMISSION_FINAL,0) + nvl(ba.REF_BONUS_FINAL,0) + nvl(ba.PHI_KHAC,0)) AMT_LCY,
	  rm_id.smb SMB_NAME
FROM APPS.FIN_BANCAS_MONTHLY ba
LEFT JOIN etl.SMB_RM_ID rm
ON ba.MA_NHAN_VIEN_MB =rm.MA_NHAN_VIEN 
LEFT JOIN rm_id ON ba.MA_CN =rm_id.ma_cn
WHERE ba.TRANSACTION_DATE  = TO_DATE(${PRD_ID}, 'YYYYMMDD')  
AND ba.ma_cn IN (SELECT ma_cn FROM rm_id)
GROUP BY 
 	  ba.TRANSACTION_DATE,
	  ba.POLICY_NUMBER,
	  ba.MA_CN,
	  ba.makh,
	  ba.KHOI_KH,
	  ba.BANCA_PRD_NAME,
	  rm.RM,
	  rm_id.smb	  
	  	  ) 
	  WHERE RM_code IS NOT NULL</sql>
