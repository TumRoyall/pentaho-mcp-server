  <step>
    <name>SMB_EXPENSE_MAP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
TO_DATE(${PRD_ID}, 'YYYYMMDD') TRANSACTION_DATE,
'' sotk,
ex.CN MA_CNC2,
'' MAKH,
'' KHOI,
'' PRODUCT_CODE,
'APPS.SMB_EXPENSE_MAP' SOURCE_TABLE,
'' RM_CODE,
'' CHG_CODE,
'' line_gl,
ex.id MACHITIEU,
ex.description CHITIEU,
ex.type TK_TYPE,
to_number(amt) AMT_LCY,
ex.smb SMB_NAME
FROM APPS.SMB_EXPENSE_MAP ex 
WHERE ex.TRANSACTION_DATE = (select max(TRANSACTION_DATE) from  APPS.SMB_EXPENSE_MAP ex 
WHERE ex.TYPE IN ('LUONG','DINH_MUC'))
AND ex.TYPE IN ('LUONG','DINH_MUC')


</sql>
