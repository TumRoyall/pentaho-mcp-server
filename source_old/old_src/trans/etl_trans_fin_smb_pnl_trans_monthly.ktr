  <step>
    <name>TMP_TOI_SOURCE_INPUT</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH rm_id AS 

(SELECT ma_cn,smb FROM ETL.SMB_RM_ID 

GROUP BY ma_cn,smb) 

SELECT * FROM  

( 

SELECT  

so.TRANSACTION_DATE, 

so.sct SOTK, 

so.MA_CN MA_CNC2, 

so.makh, 

so.khoi, 

so.PRODUCT_CODE, 

'ETL.TMP_TOI_SOURCE_INPUT' SOURCE_TABLE, 

co_id.RM_code, 

so.CHG_CODE, 

SO.LINEGL, 

SO.MACHITIEU, 

SO.CHITIEU, 

CASE WHEN it.TYPE ='CONTRACT_DP' THEN 'DU_PHONG' ELSE co_id.tk_type END TK_TYPE, 

so.TIENNO_VND AMT_LCY, 

rm_id.smb SMB_NAME 

FROM ETL.TMP_TOI_SOURCE_INPUT so 

LEFT JOIN apps.SMB_CONTRACT_ID  co_id 

ON  co_id.TRANSACTION_DATE  = TO_DATE(${PRD_ID}, 'YYYYMMDD')   

And so.sct = co_id.sotk  

AND co_id.MA_CNC2 =SO.MA_CN   

LEFT JOIN rm_id  

ON so.ma_cn =rm_id.ma_cn 

LEFT JOIN etl.SMB_MAP_PNL_ITEM it 

ON so.machitieu =it.machitieu 

WHERE so.machitieu IN (SELECT machitieu FROM ETL.SMB_MAP_PNL_ITEM WHERE TYPE IN ('CONTRACT','CONTRACT_DP')) 

AND so.ma_cn IN (SELECT ma_cn FROM rm_id) 

)  

WHERE rm_code IS NOT null </sql>
