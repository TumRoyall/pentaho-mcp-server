  <step>
    <name>FIN_PNL_EXPN_SMY_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH rm_id AS
(SELECT ma_cn,smb FROM ETL.SMB_RM_ID
GROUP BY ma_cn,smb)
, ex AS 
(SELECT * FROM apps.SMB_EXPENSE_MAP where transaction_date IN (SELECT max(transaction_date) FROM apps.smb_expense_map) 
AND type ='CHUONG_TRINH')
SELECT 
last_day(pnl.TXN_DATE) TRANSACTION_DATE,
pnl.RELATION_TXN_NBR SOTK,
pnl.BRANCH_CODE MA_CNC2,
'' MAKH,
pnl.seg2 KHOI,
pnl.seg7 PRODUCT_CODE,
'APPS.FIN_PNL_EXPN_SMY_MONTHLY' source_table,
'' RM_CODE,
'' CHG_CODE,
pnl.GL_LINE line_gl,
pnl.OPEX_CODE_L3 MACHITIEU,
pnl.OPEX_NAME_L3 CHITIEU,
'OPEX' TK_TYPE,
NVl(pnl.LCY_TXN_AMT,0) amt_lcy,
ex.smb SMB_NAME
FROM apps.FIN_PNL_EXPN_SMY_MONTHLY pnl
LEFT JOIN rm_id ON pnl.BRANCH_CODE =rm_id.ma_cn
LEFT JOIN EX ON pnl.seg7 =ex.id AND pnl.BRANCH_CODE =ex.cn
WHERE pnl.TXN_DATE between trunc(TO_DATE(${PRD_ID}, 'YYYYMMDD'),'MM') and TO_DATE(${PRD_ID}, 'YYYYMMDD')
AND pnl.OPEX_CODE_L3 IN (SELECT machitieu FROM ETL.SMB_MAP_PNL_ITEM WHERE TYPE ='OPEX')
AND pnl.seg7 IN (SELECT id FROM ex) 
AND pnl.BRANCH_CODE IN (SELECT cn FROM ex)</sql>
