  <step>
    <name>FIN_GL_FA_DEPRICIATION_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH ex AS 
(SELECT * FROM APPS.SMB_EXPENSE_MAP where transaction_date IN (SELECT max(transaction_date) FROM APPS.smb_expense_map) 
AND type ='TAI_SAN')
SELECT 
de.TRANSACTION_DATE,
de.MA_TSGL sotk,
'VN0010'||de.MA_CN_TS MA_CNC2,
'' MAKH,
de.MA_KHOI_TS KHOI,
de.MA_SEG_CT_CP PRODUCT_CODE,
'APPS.FIN_GL_FA_DEPRICIATION_MONTHLY' SOURCE_TABLE,
'' RM_CODE,
'' CHG_CODE,
de.GL_LINE_CP line_gl,
fi.OPEX_CODE_L3 MACHITIEU,
fi.OPEX_NAME_L3 CHITIEU,
'TAI_SAN' TK_TYPE,
SUM(NVL(KHAUHAO_THANG,0)) AMT_LCY,
ex.smb SMB_NAME
FROM APPS.FIN_GL_FA_DEPRICIATION_MONTHLY de
LEFT JOIN APPS.FILE_EXPN_CODE_MAP fi 
ON de.gl_line_cp =fi.gl_line 
LEFT JOIN APPS.SMB_EXPENSE_MAP ex 
ON de.MA_TSGL=ex.id AND 'VN0010'||de.MA_CN_TS=ex.cn
WHERE de.TRANSACTION_DATE =TO_DATE(${PRD_ID}, 'YYYYMMDD')
AND de.MA_TSGL IN (SELECT ID FROM EX)
AND 'VN0010'||de.MA_CN_TS IN (SELECT cn FROM ex)
Group by 
de.TRANSACTION_DATE,
de.MA_TSGL,
de.MA_CN_TS,
de.MA_KHOI_TS,
de.MA_SEG_CT_CP,
de.GL_LINE_CP,
fi.OPEX_CODE_L3,
fi.OPEX_NAME_L3,
ex.smb</sql>
