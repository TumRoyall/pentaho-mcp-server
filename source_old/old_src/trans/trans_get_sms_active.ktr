    <sql>
select --r.id, 
r.acc_no, r.primary_phone, r.status, r.updated_date, r.created_date, r.t24_fee_code, r.sms_package_code, r.cus_id--, r.sub_list_phone
, CASE
WHEN mnp.mobile is not null THEN mnp.provider
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8486', '8496', '8497', '8498', '8432', '8433', '8434', '8435', '8436', '8437', '8438', '8439') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8489', '8490', '8493', '8470', '8479', '8477', '8476', '8478') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8488', '8491', '8494', '8483', '8484', '8485', '8481', '8482') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8455') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8487') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8452', '8456', '8458', '8492') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(r.primary_phone,1,4) in ('8499','8459') THEN 'BELINE'
ELSE 'OTHER'
END TELCO
, t.step_register, t.updated_date step_updated_date
from etl.mb_pm_bdsd_sms_register r
join etl.mb_pm_bdsd_sms_register_step t on r.id = t.bdsd_sms_register_id and t.updated_date >= (to_date('${PRD_ID}', 'yyyyMMdd') + 1)
left join etl.Tb_Mnp mnp on r.primary_phone = mnp.mobile
where  r.created_date &lt; (to_date('${PRD_ID}', 'yyyyMMdd') + 1)
and r.status = 0

--and r.telco = 'VIETTEL'</sql>
