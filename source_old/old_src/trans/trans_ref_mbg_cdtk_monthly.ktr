    <connection>tckt_dc</connection>
    <sql>select 
a.sub_name,
a.acct_no,
a.acct_name,
a.dky_no,
a.dky_co,
a.ps_no,
a.ps_co,
a.cky_no,
a.cky_co,
a.txn_date,
b.coa_code_cttv,
b.coa_code_mb,
b.type,
b.coa_code_cttv id,
b.coa_name
from ETL.file_MBG_CDTK_MONTHLY a
left join ETL.FILE_MBG_COA_CODE b
on a.acct_no  = b.acct_no and  a.sub_name = b.sub_name
where txn_date = to_date (${PRD_ID},'yyyyMMdd')</sql>
