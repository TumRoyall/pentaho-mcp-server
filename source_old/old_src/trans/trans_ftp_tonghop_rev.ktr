  </step>
  <step>
    <name>FTP_CHOVAY_NOQUAHAN_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select 
  A.TRANSACTION_DATE as TRANSACTION_DATE,
  A.CNC2 as CN,
  A.FTP_CODE as FTP_PROD,
  A.KHOI as KHOI,
  A.CCY as NTE,
  SUM(A.FTP_HT_FCY) as FTP_SDC,
  A.FTP_GROUP as FTP_SOURCE,
  SUM(A.FTP_TT_FCY) as FTP_TDC,
  A.TERM_FTP as TERM_FTP,
  A.TERM_HD as TERM_GOC,
  SUM(A.FCY_AMT) as SODU_TINH_FTP,
  B.REV_KHOI_DEBIT as KHOI_DEBIT,
  B.REV_CUS_DEBIT as CUS_DEBIT,
  B.REV_PL_DEBIT as PL_DEBIT,
  B.REV_GL_DEBIT as GL_DEBIT,
  B.REV_KHOI_CREDIT as KHOI_CREDIT,
  B.REV_CUS_CREDIT as CUS_CREDIT,
  B.REV_PL_CREDIT as PL_CREDIT,
  B.REV_GL_CREDIT as GL_CREDIT
FROM APPS.FTP_CHOVAY_NOQUAHAN_DAILY A 
LEFT JOIN ETL.FTP_MAP_HTOAN_REV B 
ON A.FTP_CODE = B.FTP_CODE
AND A.KHOI = B.KHOI
WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}','YYYYMMDD')
AND FTP_HT_FCY &lt; 0
GROUP BY 
  A.TRANSACTION_DATE, 
  A.CNC2 , 
  A.FTP_CODE , 
  A.KHOI, 
  A.CCY , 
  A.FTP_GROUP, 
  A.TERM_FTP, 
  A.TERM_HD,
  B.REV_KHOI_DEBIT ,
  B.REV_CUS_DEBIT ,
  B.REV_PL_DEBIT ,
  B.REV_GL_DEBIT ,
  B.REV_KHOI_CREDIT,
  B.REV_CUS_CREDIT ,
  B.REV_PL_CREDIT ,
  B.REV_GL_CREDIT 
</sql>
