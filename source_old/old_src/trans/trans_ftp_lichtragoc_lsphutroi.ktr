  <step>
    <name>ETL.ODS_LOAN_BAL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>
WITH TR_KU_LICHTRAGOC AS 
(
SELECT 
a.TXN_DATE,
A.ARRANGEMENT_NBR SOKU,
a.CURRENCY_CODE NTE,
NVL(to_date(B.NGAY_THU_GOC,'YYYYMMDD') - B.TRANS_DATE,(A.MATURITY_DATE - A.VALUE_DATE)) SO_NGAY,
NVL(B.SO_TIEN,A.LCY_AMT) SO_DU_GOC_VND,
B.TRANS_DATE,
B.NGAY_THU_GOC
FROM ETL.ODS_LOAN_BAL_LSPHUTROI A
LEFT JOIN ETL.TEMP_LICHTRAGOC B
ON A.ARRANGEMENT_NBR =B.LD_ID
WHERE  substr(a.COA_CODE,1,1) = '2' 
and substr(a.COA_CODE,1,2) &lt;&gt; '20' 
and 
substr(a.ARRANGEMENT_NBR,1,2) = 'LD'
AND FTP_CODE not in ('TD452','TD103')
AND A.TXN_DATE = A.VALUE_DATE
)
SELECT 
A.SOKU,
A.TXN_DATE,
A.TRANS_DATE,
sum(A.SO_DU_GOC_VND*C.AMOUNT)/ sum(A.SO_DU_GOC_VND) PTTK
FROM TR_KU_LICHTRAGOC A
LEFT JOIN APPS.FTP_MAP_TERM B
--ON A.NTE = B.CCY
ON A.SO_NGAY >= B.FROM_DAY
AND A.so_NGAY &lt;= B.TO_DAY
LEFT JOIN APPS.FTP_REF_PHUTROI C 
ON C.TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD') 
AND A.NTE = C.CCY
AND B.TERM_ID = C.TERM_HD
group by A.SOKU, A.TXN_DATE, A.TRANS_DATE
</sql>
