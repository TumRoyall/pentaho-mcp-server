  <step>
    <name>SMY.PL_TXN_DAIL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT A.BRANCH_CODE MACN,
       A.T24_CUST_ID MAKH,
       A.PARTY_DIVISION_CODE KHOI,
       A.T24_LINE LINE_T24,
       A.PL_CATE_CODE ACCTNBR,
       SUM(A.FCY_AMT) TIENNO,
       A.TXN_DATE POSTDATE,
       A.SOURCE_TABLE_NAME SOURCE_IMPORT,
       /*CASE 
       WHEN A.ARRANGEMENT_NBR IS NOT NULL THEN A.ARRANGEMENT_PRODUCT_CODE 
       ELSE A.CHG_PRODUCT_CODE END PRODUCT_CODE,
*/
       CASE 
       WHEN A.ARRANGEMENT_NBR IS NOT NULL THEN A.ARRANGEMENT_PRODUCT_CODE 
       ELSE nvl(A.CHG_PRODUCT_CODE,a.ARRANGEMENT_PRODUCT_CODE) END PRODUCT_CODE,

       LAST_DAY(A.TXN_DATE) PARTITION_DATE,
       A.RELATION_TXN_NBR SCT,
       A.GL_LINE LINEGL,
       SUM(A.LCY_AMT) TIENNO_VND,
       A.NARRATIVE NARR,
       A.PARTY_SECTOR_CODE  SECTOR,
       A.COA_CODE GL,
       A.CURRENCY_CODE CCY,
       A.REPORT_DIVISION_CODE KHOI_THEOPLKHOI,
       A.REPORT_ITEM_CODE CHITIEU_PLKHOI,
       A.REPORT_ITEM_NAME CHITIEU_PLKHOI_NAME,
       A.EB_REPORT_ITEM_IND KENHSO,
       A.CHG_TYPE CHG_TYPE,
       A.CHG_CODE CHG_CODE,
       A.ARRANGEMENT_NBR SOTK,
       A.TXN_CHANNEL_CODE,
       A.SOURCE_TABLE_NAME 
FROM SMY.PL_TXN_DAILY A
WHERE TXN_DATE BETWEEN TRUNC (TO_DATE ('${PRD_ID}','YYYYMMDD'), 'MONTH') AND TO_DATE ('${PRD_ID}','YYYYMMDD')
AND SUBSTR (REPORT_ITEM_CODE,1,1) IN ('A', 'B')
AND NVL (A.PL_CATE_CODE, '00000') &lt;&gt; '67010'
--and rownum &lt; 100
GROUP BY 
A.BRANCH_CODE,
       A.T24_CUST_ID,
       A.PARTY_DIVISION_CODE,
       A.T24_LINE,
       A.PL_CATE_CODE,
       A.TXN_DATE,
       A.SOURCE_TABLE_NAME ,
       /*CASE 
       WHEN A.ARRANGEMENT_NBR IS NOT NULL THEN A.ARRANGEMENT_PRODUCT_CODE 
       ELSE A.CHG_PRODUCT_CODE END,*/
       CASE 
       WHEN A.ARRANGEMENT_NBR IS NOT NULL THEN A.ARRANGEMENT_PRODUCT_CODE 
       ELSE nvl(A.CHG_PRODUCT_CODE,a.ARRANGEMENT_PRODUCT_CODE) END,
       LAST_DAY(A.TXN_DATE),
       A.RELATION_TXN_NBR,
       A.GL_LINE,
       A.NARRATIVE,
       A.PARTY_SECTOR_CODE,
       A.COA_CODE,
       A.CURRENCY_CODE,
       A.REPORT_DIVISION_CODE,
       A.REPORT_ITEM_CODE,
       A.REPORT_ITEM_NAME,
       A.EB_REPORT_ITEM_IND,
       A.CHG_TYPE,
       A.CHG_CODE,
       A.ARRANGEMENT_NBR,
       A.TXN_CHANNEL_CODE,
       A.SOURCE_TABLE_NAME</sql>
