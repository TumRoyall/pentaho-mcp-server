  <step>
    <name>input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT a.transaction_date,
a.cn,
a.ld_id,
a.makh,
e.HOTEN, 
e.khoi,
a.nte,
a.LOAI_DIEUCHINH LOAI,
COALESCE(b.PRODUCT_CODE, c.PRODUCT_CODE, d.PRODUCT_CODE) product_code,
a.DOANHSO_THOAITHU_VND
FROM etl.ods_adj_accrued_int_bal a
LEFT JOIN etl.ODS_LOAN_CONTRACT b
on a.ld_id = b.ARRANGEMENT_NBR
left join etl.ODS_PD_CONTRACT c
on c.rank_num = 1
and a.ld_id = c.ARRANGEMENT_NBR
left join etl.ODS_OVD_CONTRACT d
on a.ld_id = d.ARRANGEMENT_NBR
LEFT JOIN etl.ORS_TR_KHACHHANG E 
ON a.makh = e.makh
WHERE a.transaction_date = to_date(${PRD_ID},'YYYYMMDD')
</sql>
    <limit>0</limit>
    <lookup/>
