  <step>
    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>with numbers AS (
    SELECT LEVEL AS num
    FROM dual
    CONNECT BY LEVEL &lt;= 10  
)
select * from 
(
SELECT trim(REGEXP_SUBSTR(a.CMV_ASSET_CODE, '[^#]+', 1, n.num)) AS item, trunc(a.ASSET_VALT_DATE)  ASSET_VALT_DATE,
A.ARRANGEMENT_NBR, a.DEAL_INPUT_DATE,
row_number () over (partition by trim(REGEXP_SUBSTR(a.CMV_ASSET_CODE, '[^#]+', 1, n.num)) order by a.ASSET_VALT_DATE desc) rn
FROM smy.CLT_STMT_MTH a
JOIN numbers n ON n.num &lt;= LENGTH(a.CMV_ASSET_CODE) - LENGTH(REPLACE(a.CMV_ASSET_CODE, '#', '')) + 1
where (txn_date) between  add_months(to_date('${PRD_ID}','yyyymmdd'),-5) and  to_date('${PRD_ID}','yyyymmdd') -- lay sao ke tu thoi diem thang tinh toan + 6 thang 
ORDER BY a.CMV_ASSET_CODE
)
where rn =1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
