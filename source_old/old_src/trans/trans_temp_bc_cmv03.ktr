  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>select 
        trunc(bc.created_date) AS ngay_de_nghi,
        trunc(tttd.thoi_diem_tham_dinh) AS ngay_phe_duyet,
        trunc(tttd.thoi_diem_tham_dinh_gan_nhat) AS thoi_diem_gan_nhat,
        bc.ma_pdn AS ma_de_nghi,
        ts.ma_tai_san,
        bc.ma_chung_thu AS so_bc,
        COALESCE(br.branch_code, dvdn1.branch_code, dvdn2.branch_code) AS ma_chi_nhanh, 
    COALESCE(pgd.branch_code, dvdn.branch_code, dvdn2.branch_code) AS ma_phong_giao_dich,
        COALESCE(br.branch_name, dvdn1.branch_name, dvdn2.branch_name) AS chi_nhanh, 
    COALESCE(pgd.branch_name, dvdn.branch_name, dvdn2.branch_name) AS phong_giao_dich,
    DECODE(pdnts.is_chinh_sua_bcdg, 1, 'Co', 0, 'Khong') is_chinh_sua_bcdg,
    CASE WHEN pdnts.is_chinh_sua_bcdg= 1 THEN pdnts.so_bcdg_chinh_sua END so_bcdg_chinh_sua,
    CASE WHEN pdnts.is_chinh_sua_bcdg= 1 THEN DECODE(pdnts.ly_do_chinh_sua_bcdg, 1, 'MBAMC', 0, 'ĐVKD') END ly_do_chinh_sua_bcdg,
      su8.fullname AS can_bo_de_nghi,
        lkh.text AS loai_khach_hang,
        bc.ten_khach_hang,
        tsc1.text AS loai_ts,
        DECODE(tttd.lan_tham_dinh,1,'Lần đầu',NULL,'','Tái thẩm') AS lan_tham_dinh,
        tsc2.text AS loai_ts_c2,
    tsc3.text AS loai_ts_c3,
        ts.gia_tri_dinh_gia gia_tri_dinh_gia,
        hd.phi_dinh_gia phi_dinh_gia,
         s4.name AS dvi_dinh_gia,
          su2.fullname user_amc_khao_sat,
        su3.fullname user_amc_pt,
        su4.fullname user_amc_kiem_soat_pt,
        CASE
            WHEN
                su7.fullname IS NOT NULL
            AND
                su6.fullname IS NOT NULL
            AND
                su5.fullname IS NOT NULL
            THEN su7.fullname
             || ','
             || su6.fullname
             || ','
             || su5.fullname
            ELSE su5.fullname
        END
        AS user_phe_duyet,
        st.text AS trang_thai_hs,
        tttt.text AS trang_thai_tt, 
        tsc4.text khoi_kdql, bc.code_t24
FROM
        cmv_new.cmv_cs_dg_tai_san ts
        INNER JOIN cmv_new.cmv_cs_bcdg bc ON bc.id = ts.ref_bcdg
        LEFT JOIN cmv_new.cmv_cs_amc_hop_dong hd ON
            bc.id = hd.ref_bcdg
        AND
            hd.is_deleted = '0'
        LEFT JOIN cmv_new.cmv_cs_dg_thong_tin_tham_dinh tttd ON ts.id = tttd.ref_dg_tai_san 
        LEFT JOIN cmv_new.cmv_cs_pdn_dinh_gia pdn on pdn.ma_de_nghi = bc.ma_pdn 
        LEFT JOIN cmv_new.cmv_ls_category tsc1 ON
            tsc1.value = bc.tai_san_cap1_id
        AND
            tsc1.field_name = 'TAI_SAN_CAP1_ID'
        AND
            tsc1.table_name = 'COMMON'
        LEFT JOIN cmv_new.cmv_ls_category tsc2 ON
            tsc2.value = bc.tai_san_cap2_id
        AND
            tsc2.field_name = 'TAI_SAN_CAP2_ID'
        AND
            tsc2.table_name = 'COMMON'
        LEFT JOIN cmv_new.cmv_ls_category tsc3 ON
            tsc3.value = ts.tai_san_cap3_id
        AND
            tsc3.field_name = 'TAI_SAN_CAP3_ID'
        AND
            tsc3.table_name = 'COMMON'
        LEFT JOIN cmv_new.cmv_ls_category lkh ON
            lkh.value = bc.loai_khach_hang_id
        AND
            lkh.field_name = 'LOAI_KHACH_HANG_ID'
        AND
            lkh.table_name = 'CMV_CS_BCDG'
        LEFT JOIN cmv_new.cmv_ls_category tttt ON
            tttt.value = hd.trang_thai_thanh_toan_id
        AND
            tttt.field_name = 'TRANG_THAI_THANH_TOAN_ID'
        AND
            tttt.table_name = 'CMV_CS_AMC_HOP_DONG'
        LEFT JOIN cmv_new.cmv_ls_category st ON
            st.value = bc.trang_thai_id 
        AND
            st.field_name = 'STATUS'
        AND
            st.table_name = 'CMV_FLOW'
        
        LEFT JOIN cmv_new.cmv_ls_category tsc4 ON
            tsc4.value = pdn.khoi_kinh_doanh_quan_ly 
        AND
            tsc4.field_name = 'KHOI_KINH_DOANH_QUAN_LY'
        AND
            tsc4.table_name = 'CMV_CS_PDN_DINH_GIA'  
                LEFT JOIN cmv_new.sys_user su2 ON su2.username = bc.user_amc_khao_sat
        LEFT JOIN cmv_new.sys_user su3 ON su3.username = bc.user_amc_pt
        LEFT JOIN cmv_new.sys_user su4 ON su4.username = bc.user_amc_kiem_soat_pt
        LEFT JOIN cmv_new.sys_user su5 ON su5.username = bc.user_phe_duyet
        LEFT JOIN cmv_new.sys_user su6 ON su6.username = bc.user_phe_duyet2
        LEFT JOIN cmv_new.sys_user su7 ON su7.username = bc.user_phe_duyet3
        LEFT JOIN cmv_new.sys_user su8 ON su8.username = bc.user_mb_khoi_tao
    LEFT JOIN ods.branch_ref br ON  br.branch_code = bc.branch_code AND br.current_flag ='Y'
        LEFT JOIN ods.branch_ref pgd ON  pgd.branch_code = bc.department_code AND pgd.current_flag ='Y'
    LEFT JOIN cmv_new.sys_group_detail gd ON gd.group_id = bc.department_id
    LEFT JOIN cmv_new.sys_group_detail gd1 ON gd1.group_id = bc.branch_id
    LEFT JOIN cmv_new.sys_group_detail gd2 ON gd2.group_id = bc.dv_de_nghi_id
    LEFT JOIN ods.branch_ref dvdn ON dvdn.branch_code = gd.branch_code AND dvdn.current_flag ='Y'
        LEFT JOIN ods.branch_ref dvdn1 ON dvdn1.branch_code = gd1.branch_code AND dvdn1.current_flag ='Y'
        LEFT JOIN ods.branch_ref dvdn2 ON dvdn2.branch_code = gd2.branch_code  AND dvdn2.current_flag ='Y'
        LEFT JOIN cmv_new.sys_group_full s4 ON s4.ID = bc.dv_dinh_gia_id
    LEFT JOIN cmv_new.cmv_cs_pdn_dinh_gia pdn ON pdn.ma_de_nghi = bc.ma_pdn 
    LEFT JOIN cmv_new.cmv_ls_category tsc4
    ON tsc4.VALUE =pdn.khoi_kinh_doanh_quan_ly AND tsc4.field_name ='KHOI_KINH_DOANH_QUAN_LY' AND tsc4.table_name ='CMV_CS_PDN_DINH_GIA'
    LEFT JOIN cmv_new.cmv_cs_ts_hh tshh ON tshh.ref_dg_tai_san = ts.ID
    LEFT JOIN cmv_new.cmv_ls_category tsc5 ON tsc5.VALUE = tshh.loai_hinh_hang_hoa AND tsc5.field_name = 'LOAI_HINH_HANG_HOA' AND tsc5.table_name = 'CMV_CS_TS_HH'
    LEFT JOIN cmv_new.cmv_cs_pdn_dinh_gia_tai_san pdnts ON ts.ma_tai_san  = pdnts.ma_tai_san AND pdnts.ref_pdn_dinh_gia = pdn.ID
    AND pdnts.ma_chung_thu = bc.ma_chung_thu
     WHERE
            bc.id IS NOT NULL 
        AND
            bc.trang_thai_id IN (
                '9','10'
            )
        AND
            bc.migrate_id IS NULL
        AND
            bc.bcdg_hop_thua_id IS NULL
        AND
            bc.luong_phuong_an_id = '1'
        --and trunc(tttd.thoi_diem_tham_dinh) between add_months(trunc(to_date('${PRD_ID}','yyyymmdd'),'month'),-4) and add_months(to_date('${PRD_ID}','yyyymmdd'),-4)
		and trunc(tttd.thoi_diem_tham_dinh) between add_months(trunc(to_date('${PRD_ID}','yyyymmdd'),'month'),-5) and add_months(to_date('${PRD_ID}','yyyymmdd'),-4)</sql>
