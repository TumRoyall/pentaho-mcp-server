  <step>
    <name>2.FTP_CHIPHI_BHTG</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT  
A.TRANSACTION_DATE, 
'FTP_CHIPHI_BHTG' MA_CT ,    
'Chi phí bảo hiểm tiền gửi' TEN_CT, 
A.CURRENCY_CODE, 
case when A.SDBQ_LOAN + A.SDBQ_TP_TCKT + A.SDBQ_MUANO = 0 then 0 else A.CP_BHTG/(A.SDBQ_LOAN + A.SDBQ_TP_TCKT + A.SDBQ_MUANO) end  VALUE 
FROM ETL.FTP_REF_AUTO_INDICATOR_PIVOT A 
WHERE a.TRANSACTION_DATE  =  LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) </sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
      <value-meta>
        <type>Timestamp</type>
        <storagetype>normal</storagetype>
        <name>TRANSACTION_DATE</name>
        <length>0</length>
        <precision>-1</precision>
