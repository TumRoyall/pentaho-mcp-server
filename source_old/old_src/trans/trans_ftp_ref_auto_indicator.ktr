  <step>
    <name>1.FTP_CHIPHI_DTBB</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT  
A.TRANSACTION_DATE, 
'FTP_CHIPHI_DTBB' MA_CT , 	 
'Chi phí dự trữ bắt buộc' TEN_CT, 
A.CURRENCY_CODE, 
(CASE WHEN a.CURRENCY_CODE = 'VND' THEN 
SDBQ_DTBB_VND_12M*0.03 + SDBQ_DTBB_VND_A12M*0.01  
 	     WHEN a.CURRENCY_CODE = 'USD' THEN 
SDBQ_DTBB_USD_12M*0.08 + SDBQ_DTBB_USD_A12M*0.06 
 	 END) * 
((CASE WHEN a.CURRENCY_CODE = 'VND' THEN 
((a.CPVON_CASA+ a.CPVON_TD+ 
a.CPVON_CCTGOL)/(a.SDBQ_CASA+ a.SDBQ_TERM_DEPOSIT+ 
a.SDBQ_CCTGOL))*365/27  
 	 ELSE b.AMOUNT 
 	 END) - C.AMOUNT)/(A.SDBQ_LOAN + 
A.SDBQ_TP_TCKT + A.SDBQ_MUANO) 
VALUE 
FROM ETL.FTP_REF_AUTO_INDICATOR_PIVOT A 
LEFT JOIN APPS.FTP_REF_MANUAL_INDICATOR B  
ON b.TYPE_CT = 'CPVON_NTE' 
AND a.TRANSACTION_DATE= b.TRANSACTION_DATE 
AND a.CURRENCY_CODE = b.CCY 
LEFT JOIN APPS.FTP_REF_MANUAL_INDICATOR C  
ON C.TYPE_CT = 'LS_DTBB' 
AND a.TRANSACTION_DATE= C.TRANSACTION_DATE 
AND a.CURRENCY_CODE = C.CCY 
WHERE a.TRANSACTION_DATE  =  
LAST_DAY(to_date('${PRD_ID}','YYYYMMDD')) 

</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
