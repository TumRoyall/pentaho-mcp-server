    <connection>tckt_dc</connection>
    <sql>SELECT '${PATH}\${PRD_ID}\'||'VN0010001.'||'${PRD_ID}'|| '.FTPDC.'|| id  filename,
DEBIT_ACCT_NO,
DEBIT_CURRENCY,
DEBIT_AMOUNT,
TO_CHAR(CREDIT_VALUE_DATE, 'YYYYMMDD') CREDIT_VALUE_DATE,
CREDIT_ACCT_NO,
PAYMENT_DETAILS_1,
PAYMENT_DETAILS_2,
PAYMENT_DETAILS_3,
PAYMENT_DETAILS_4,
CREDIT_CURRENCY,
COMMISSION_CODE,
CHARGE_CODE,
COMMISSION_TYPE,
CHARGES_ACCT_NO,
PROFIT_CENTRE_DEPT,
TXN_PURPOSE,
MB_PAY_METHOD,
ORDERING_BANK,
CO_CODE,
PROFIT_CENTRE_CUST
FROM APPS.FTP_HACHTOAN_DIEUCHINH
where CREDIT_VALUE_DATE = to_date ('${PRD_ID}','yyyyMMdd')
and status =0
--and DEBIT_ACCT_NO is not null and CREDIT_ACCT_NO is not null
--FETCH FIRST 1 ROW ONLY</sql>
