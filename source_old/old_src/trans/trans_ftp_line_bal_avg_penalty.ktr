  <step>
    <name>Line_Bal_Penalty</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--Tinh FTP Penalty
SELECT A.COMPANY,
       A.LINE,
       A.CURR,
       A.AVG_AMOUNT,
       LAST_DAY(A.TRANS_DATE) TRANS_DATE,
       B.AMOUNT AMOUNT_LIM,
       C.AMOUNT FTP_KKH,
       CASE
         WHEN (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) > 0 then
         
          case
            when A.CURR = 'VND' then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) * C.AMOUNT *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500)
            when A.CURR IN ('USD', 'EUR') then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) * C.AMOUNT *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500,
                   2)
          end
         else
          0
       end FTP_AMOUNT,
       'KKH' Term,
       d.vung_mien,
       e.AMOUNT FTP_DIEUCHINH_ALCO,
       e.BIENDO_KHOI,
       e.BIENDO_SANPHAM,
       e.BIENDO_VUNGMIEN,
       CASE
         WHEN (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) > 0 then
         
          case
            when A.CURR = 'VND' then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.AMOUNT, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500)
            when A.CURR IN ('USD', 'EUR') then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.AMOUNT, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500,
                   2)
          end
         else
          0
       end FTP_AMT_WITH_ALCO,
       
       CASE
         WHEN (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) > 0 then
         
          case
            when A.CURR = 'VND' then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.BIENDO_KHOI, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500)
            when A.CURR IN ('USD', 'EUR') then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.BIENDO_KHOI, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500,
                   2)
          end
         else
          0
       end FTP_AMT_WITH_BIENDO_KHOI,
       
       CASE
         WHEN (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) > 0 then
         
          case
            when A.CURR = 'VND' then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.BIENDO_SANPHAM, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500)
            when A.CURR IN ('USD', 'EUR') then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.BIENDO_SANPHAM, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500,
                   2)
          end
         else
          0
       end FTP_AMT_WITH_BIENDO_SANPHAM,
       
       CASE
         WHEN (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) > 0 then
         
          case
            when A.CURR = 'VND' then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.BIENDO_VUNGMIEN, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500)
            when A.CURR IN ('USD', 'EUR') then
             round(((100 - 100) / 100) *
                   (nvl(abs(A.AVG_AMOUNT), 0) - nvl(B.AMOUNT, 0)) *
                   (nvl(C.AMOUNT, 0) + nvl(e.BIENDO_VUNGMIEN, 0)) *
                   (to_date(${PRD_ID}, 'yyyyMMdd') -
                   add_months(to_date(${PRD_ID}, 'yyyyMMdd'), -1)) / 36500,
                   2)
          end
         else
          0
       end FTP_AMT_WITH_BIENDO_VUNGMIEN,
       CASE
         WHEN a.LINE = '0016' THEN
          'TD560'
         ELSE
          'TD554'
       END FTP_CODE, m.ftp_line,m.ftp_category

  FROM apps.FTP_TR_LINE_BAL_AVG A
--H?N M?C T�N QU? G�N TH�NG T�NH NH?T

left join apps.ftp_mapping_toi m
on CASE
         WHEN a.LINE = '0016' THEN
          'TD560'
         ELSE
          'TD554'
       END = m.ftp_prod
--and nvl(a.khoi,'ALM') = m.khoi

  LEFT JOIN (select A.*
               FROM apps.ftp_dic_tonquy_tienmat A
              WHERE A.date_apply =
                    (select max(t.date_apply)
                       from apps.ftp_dic_tonquy_tienmat t
                      where A.CO_CODE = T.CO_CODE
                        AND A.LINE = T.LINE
                        AND A.CCY = T.CCY
                        and t.date_apply &lt;= to_date(${PRD_ID}, 'yyyyMMdd'))) B
    ON A.LINE = B.LINE
   AND A.COMPANY = B.CO_CODE
   AND A.CURR = B.CCY

  left join apps.ftp_dic_ls_kkh c
    on a.curr = c.currency
   and a.trans_date = c.date_apply
   and c.khoi = 'INDIV'

  LEFT JOIN apps.ftp_dic_vungmien_khuvuc d
    on a.COMPANY = d.cn_cap_2

  left join (SELECT *
               FROM apps.FTP_DIC_DIEUCHINH_ALCO A
              WHERE A.DATE_APPLY =
                    (SELECT MAX(DATE_APPLY)
                       FROM apps.FTP_DIC_DIEUCHINH_ALCO B
                      WHERE B.FTP_PRODUCT = A.FTP_PRODUCT
                        AND B.KHOI = A.KHOI
                        AND B.VUNG_MIEN = A.VUNG_MIEN
                        AND B.CURRENCY = A.CURRENCY
                        AND B.TERM = A.TERM
                        AND B.DATE_APPLY &lt;= to_date(${PRD_ID}, 'yyyyMMdd')
                        AND B.TERM = 'KKH'
                        AND B.FTP_PRODUCT = 'HD001')) E
    ON E.KHOI = 'INDIV'
   AND A.CURR = E.CURRENCY
   AND d.vung_mien = e.VUNG_MIEN
 WHERE A.TRANS_DATE = to_date(${PRD_ID}, 'yyyyMMdd')
</sql>
