  <step>
    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT TXN_DATE AS transaction_date, 
       a.ATMID, 
       b.ATM_NAME, 
       'VN0010'||b.OPR_BRANCH_CODE OPERATION_BRANCH_CODE, 
       B.OPR_BRANCH_NAME OPERATION_BRANCH_NAME, 
       B.ATM_ACCOUNT_NUMBER, 
       CASE WHEN a.IS_FINANCIAL = 'Y' THEN 'GD_TAICHINH'
            WHEN a.IS_FINANCIAL = 'N' THEN 'GD_PHITAICHINH' ELSE NULL END GD_TAICHINH_PHITAICHINH, 
       a.TRANS_NAME, 
       A.AUTH_METHOD, 
       a.RETURN_CODE_GROUP FINAL_TRANS_STATUS,
       CASE WHEN A.IS_MBCARD = 'Y' THEN 'MB'
            WHEN A.IS_MBCARD IS NULL AND A.CLIENT_NUMBER IS NOT NULL THEN 'MB' ELSE 'NGOAI_MB' END PHAN_LOAI,
       a.CLIENT_NUMBER MAKH,
       CASE WHEN AUTH_METHOD = 'CARD' then to_char(a.CARD_ID)
            WHEN AUTH_METHOD = 'CARDLESS' THEN a.CARDNUMBER END CARD_ACCOUNT,
       COUNT(1) AS SOLUONG_GIAODICH, 
       sum(nvl(T24_TRANS_AMOUNT_VND,0)) GIATRI_GIAODICH
FROM ETL.cds_ATM_CRM_TRANS_ALL A
LEFT JOIN ETL.cds_ATM_CRM_LIST_ALL B ON TRUNC(A.PARTITION_DATE) = B.TRANSACTION_DATE AND A.ATMID = B.ATM_ID
GROUP BY TXN_DATE, 
       a.ATMID, 
       b.ATM_NAME, 
       'VN0010'||b.OPR_BRANCH_CODE, 
       B.OPR_BRANCH_NAME, 
       B.ATM_ACCOUNT_NUMBER, 
       CASE WHEN a.IS_FINANCIAL = 'Y' THEN 'GD_TAICHINH'
            WHEN a.IS_FINANCIAL = 'N' THEN 'GD_PHITAICHINH' ELSE NULL END, 
       a.TRANS_NAME, 
       A.AUTH_METHOD, 
       a.RETURN_CODE_GROUP,
       CASE WHEN A.IS_MBCARD = 'Y' THEN 'MB'
            WHEN A.IS_MBCARD IS NULL AND A.CLIENT_NUMBER IS NOT NULL THEN 'MB' ELSE 'NGOAI_MB' END,
       a.CLIENT_NUMBER,
       CASE WHEN AUTH_METHOD = 'CARD' then to_char(a.CARD_ID)
            WHEN AUTH_METHOD = 'CARDLESS' THEN a.CARDNUMBER END
</sql>
    <limit>0</limit>
