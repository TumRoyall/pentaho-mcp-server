  <step>
    <name>step2</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH
    mb_nim_lk AS
    (   SELECT
            a.TRANSACTION_DATE,
            a.TAIKHOAN,
            a.MAKH,
            a.NTE,
            a.CN,
            a.KHOI,
            a.PRODUCT_CODE,
            a.FTP_CODE,
            a.CATEGORY,
            a.LOC_TERM,
            a.SECTOR,
            SUM (INTEREST_CONTRACT_NOMINAL_VND) NOMINAL_INTEREST_VND_LK,
            SUM (INTEREST_CONTRACT_REAL_VND)    REAL_INTEREST_VND_LK,
            SUM (PENALTY_INTEREST_VND)          PENALTY_INTEREST_VND_LK,
            SUM (INTEREST_FTP_ACTUAL_VND)       INTEREST_FTP_VND_LK,
            SUM (INTEREST_FTP_REGULAR_VND)      INTEREST_FTP_TT_VND_LK
        FROM 
            apps.mb_agg_nim_lk a
        WHERE 
            a.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
        AND d_type = 'LOAN'
        AND NOT EXISTS
            (   SELECT 
                    1 
                FROM 
                    APPS.FIN_LOAN_SMY_MONTHLY b
                WHERE 
                    b.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
                AND a.taikhoan = b.LD_ID
                AND NVL(a.makh,0) = NVL(b.makh,0)
                AND NVL(a.khoi,0) = NVL(b.khoi,0)
                AND NVL(a.CN,0) = NVL(b.CN,0))
        GROUP BY
            a.TRANSACTION_DATE,
            a.TAIKHOAN,
            a.MAKH,
            a.NTE,
            a.CN,
            a.KHOI,
            a.PRODUCT_CODE,
            a.FTP_CODE,
            a.CATEGORY,
            a.LOC_TERM,
            a.SECTOR 
    ) 
    ,
    mb_nim_m AS 
    (   SELECT
            a.TRANSACTION_DATE,
            a.TAIKHOAN,
            a.MAKH,
            a.NTE,
            a.CN,
            a.KHOI,
            a.PRODUCT_CODE,
            a.FTP_CODE,
            a.CATEGORY,
            a.LOC_TERM,
            a.SECTOR,
            SUM (NOMINAL_INTEREST_VND) NOMINAL_INTEREST_VND,
            SUM (REAL_INTEREST_VND)    REAL_INTEREST_VND,
            SUM (PENALTY_INTEREST_VND) PENALTY_INTEREST_VND,
            SUM (INTEREST_FTP_VND)     INTEREST_FTP_VND,
            SUM (INTEREST_FTP_TT_VND)  INTEREST_FTP_TT_VND
        FROM 
            apps.mb_agg_nim_m a
        WHERE 
            a.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
        AND d_type = 'LOAN'
        AND TAIKHOAN NOT LIKE '%F2B%'
        AND NOT EXISTS
            (   SELECT 
                    1 
                FROM 
                    APPS.FIN_LOAN_SMY_MONTHLY b
                WHERE 
                    b.TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
                AND a.taikhoan = b.LD_ID
                AND NVL(a.makh,0) = NVL(b.makh,0)
                AND NVL(a.khoi,0) = NVL(b.khoi,0)
                AND NVL(a.CN,0) = NVL(b.CN,0))
        GROUP BY
            a.TRANSACTION_DATE,
            a.TAIKHOAN,
            a.MAKH,
            a.NTE,
            a.CN,
            a.KHOI,
            a.PRODUCT_CODE,
            a.FTP_CODE,
            a.CATEGORY,
            a.LOC_TERM,
            a.SECTOR 
    )
SELECT
    to_date('${PRD_ID}','YYYYMMDD')                                   TRANSACTION_DATE,
    NVL(a.TAIKHOAN,b.TAIKHOAN)                                        LD_ID,
    NULL                                                              COA_CODE,
    NVL(a.MAKH,b.MAKH)                                                MAKH,
    NVL(a.NTE,b.NTE)                                                  NTE,
    COALESCE ( g.ARRANGEMENT_VALUE_DATE, u.ARRANGEMENT_OPENING_DATE ) VAL_DATE,
    COALESCE ( g.FINAL_MATURITY_DATE, t.FINAL_MATURITY_DATE )         MAT_DATE,
    g.INT_RATE_TYPE                                                   INT_RATE_TYPE,
    g.BI_KEY                                                          INTEREST_KEY,
    g.CIC_PURPOSE_TYPE_CODE                                           CIC_PURPOSE,
    COALESCE (a.LOC_TERM , b.LOC_TERM )                               LOC_TERM ,
    CASE
        WHEN COALESCE ( g.ARRANGEMENT_TERM, regexp_replace 
            (t.ARRANGEMENT_TERM, 
                '[a-zA-Z]+$', 
                '') ) &lt;= 12 
        THEN '1'
        WHEN COALESCE ( g.ARRANGEMENT_TERM, regexp_replace 
            (t.ARRANGEMENT_TERM, 
                '[a-zA-Z]+$', 
                '') ) &lt;= 60 
        THEN '2'
        ELSE '3'
    END                                                            NHOM_KYHAN,
    NULL                                                           NHOMNO_XHTD,
    NULL                                                           NHOMNO_LIENDOI,
    COALESCE ( g.CREDIT_STATUS, t.CREDIT_STATUS, u.CREDIT_STATUS )          CREDIT_STATUS,
    COALESCE ( g.FUND_SOURCE_CODE, t.FUND_SOURCE_CODE, u.FUND_SOURCE_CODE ) SOURCE_OF_FUND,
    COALESCE(a.SECTOR , b.SECTOR,n.SECTOR)                                  SECTOR,
    NVL(a.KHOI,b.KHOI)                                                      KHOI,
    NULL                                                                    CUS_TYPE ,
    CASE 
        WHEN COALESCE(a.khoi,b.khoi,n.khoi) = 'CIB' 
        AND COALESCE(a.sector,b.sector,n.sector) IN ('3035', 
                                                     '3535') 
        THEN 'FDI' 
        WHEN COALESCE(a.khoi,b.khoi,n.khoi) = 'SME' 
        THEN NVL(pk.pkkh, 'KXD')
        WHEN COALESCE(a.khoi,b.khoi,n.khoi) IN ('INDIV', 
                                                'NHS') 
        AND COALESCE(a.sector,b.sector,n.sector) IN ('1688', 
                                                     '1689', 
                                                     '1690', 
                                                     '1691', 
                                                     '1699', 
                                                     '1666', 
                                                     '1660') 
        THEN 'PRIVATE'
        WHEN COALESCE(a.khoi,b.khoi,n.khoi) IN ('INDIV', 
                                                'NHS') 
        AND COALESCE(a.sector,b.sector,n.sector) IN ('1888', 
                                                     '1889', 
                                                     '1890', 
                                                     '1891', 
                                                     '1746', 
                                                     '1747') 
        THEN 'PRIORITY'
        WHEN COALESCE(a.khoi,b.khoi,n.khoi) IN ('INDIV', 
                                                'NHS') 
        THEN 'MASS'
        WHEN COALESCE(a.khoi,b.khoi,n.khoi) = 'DVC' 
        THEN DECODE(COALESCE(a.sector,b.sector,n.sector), '1095', 'BHXH VN', '1096', 'BHXH BQP', 
            '1097', 'KBNN', '1098', 'Du an ODA', '1099', 'Bo ban
nganh', 'DVC')
        ELSE COALESCE(a.khoi,b.khoi,n.khoi, 'KXD') 
    END                                                                          PHAN_KHUC,
    n.APP_ST                                                                     CUS_STATUS,
    COALESCE ( g.LOAN_INDUSTRY_CODE, t.LOAN_INDUSTRY_CODE, u.LOAN_INDUSTRY_CODE) INDUSTRY_CODE,
    NVL(a.CN,b.CN)                                                               CN,
    k.BRANCH_NAME_T24,
    k.PARENT_BRANCH_CODE_T24,
    k.PARENT_BRANCH_NAME_T24,
    k.TINH_THANH,
    k.VUNG_MIEN,
    k.TIEU_VUNG,
    COALESCE ( a.CATEGORY,b.CATEGORY, g.CATE_CODE, t.CATE_CODE, u.CATE_CODE )     CATEGORY,
    COALESCE ( g.SUB_PRODUCT_CODE, t.SUB_PRODUCT_CODE, u.SUB_PRODUCT_CODE )       SUB_PRODUCT,
    COALESCE ( g.LOAN_INDUSTRY_CODE, t.LOAN_INDUSTRY_CODE, u.LOAN_INDUSTRY_CODE ) UOL,
    COALESCE(a.PRODUCT_CODE,b.PRODUCT_CODE,g.PRODUCT_CODE, u.PRODUCT_CODE)        PRODUCT_CODE,
    CASE
        WHEN COALESCE (l.SP_DV, '0') IN ('SPSO', 
                                         'DVSO', 
                                         '', 
                                         'DVS1') 
        THEN 'ONLINE'
        ELSE 'OFFLINE'
    END                                                                           KENH_GD,
    COALESCE ( g.LEGACY_CONTRACT_ID, t.LEGACY_CONTRACT_ID, u.LEGACY_CONTRACT_ID ) LEGACY_ID,
    COALESCE ( g.CAMPAIGN_CODE, u.CAMPAIGN_CODE)                                  MBLD_TYPE,
    COALESCE ( g.LIMIT_CODE, t.LIMIT_CODE, u.LIMIT_CODE )                         LIMIT_REF,
    COALESCE ( g.PRODUCT_GROUP_CODE, t.PRODUCT_GROUP_CODE, u.PRODUCT_GROUP_CODE ) PRODUCTGR_CODE,
    g.PROGRAM_CODE                                                                PRODUCT_TYPE,
    COALESCE ( g.PRODUCT_GROUP_CODE, t.PRODUCT_GROUP_CODE, u.PRODUCT_GROUP_CODE ) PRODUCTGR_CODE,
    g.PROJECT_ID                                                                  PROJECT_ID,
    NULL                                                                          LOAN_TYPE,
    NULL                                                                          PARTIC_ID,
    NULL                                                                          PARTIC_NAME,
    NULL                                                                          PARTICI_PERC,
    NULL                                                                          HD_DTT_UT,
    NULL                                                                          TYLE_PHI,
    NULL                                                                          TYLE_TCTD,
    NULL                                                                          TK_NHANVON,
    NULL                                                                          TK_CHUYENVON,
    COALESCE(a.FTP_CODE,b.FTP_CODE,g.FTP_CODE)                                    FTP_CODE,
    g.FIX_INT_RATE                                                                FIX_INT_RATE,
    COALESCE (g.INT_SPREAD, t.INT_SPREAD)                                         INT_SPREAD,
    COALESCE (g.INT_RATE, t.PENALTY_INT_RATE)                                     INT_RATE,
    0                                                                             DUNO_THOIDIEM_VND 
    ,
    0                                  DUNO_BINHQUAN_VND,
    0                                  DOANHSO_GIAINGAN_VND,
    0                                  DOANHSO_THUNO_VND,
    0                                  DOANHSO_THUNO_DUNGHAN_VND,
    0                                  DOANHSO_THUNO_TRUOCHAN_VND,
    0                                  DOANHSO_THUNO_QUAHAN_VND,
    NVL (b.NOMINAL_INTEREST_VND, 0)    NOMINAL_INTEREST_VND,
    NVL (b.REAL_INTEREST_VND, 0)       REAL_INTEREST_VND,
    NVL (b.PENALTY_INTEREST_VND,0)     PENALTY_INTEREST_VND,
    NVL (b.INTEREST_FTP_VND, 0)        INTEREST_FTP_VND,
    NVL (b.INTEREST_FTP_TT_VND, 0)     INTEREST_FTP_TT_VND,
    NVL (a.NOMINAL_INTEREST_VND_LK, 0) NOMINAL_INTEREST_VND_LK,
    NVL (a.REAL_INTEREST_VND_LK, 0)    REAL_INTEREST_VND_LK,
    NVL (a.PENALTY_INTEREST_VND_LK,0)  PENALTY_INTEREST_VND_LK,
    NVL (a.INTEREST_FTP_VND_LK, 0)     INTEREST_FTP_VND_LK,
    NVL (a.INTEREST_FTP_TT_VND_LK, 0)  INTEREST_FTP_TT_VND_LK,
    0                                  RWA_CHOVAY_VND,
    NULL                               KY_CDLS,
    NULL                               ARRANGEMENT_TYPE,
    NULL                               ORG_INT_RATE_CHANGE_DATE,
    NULL                               DOUBTFUL_STATUS,
    NULL                               DUNO_BINHQUAN_LK_VND
FROM 
    mb_nim_lk a
FULL JOIN 
    mb_nim_m b
ON 
    a.TAIKHOAN = b.TAIKHOAN
AND a.MAKH = b.MAKH
AND a.NTE = b.NTE
AND a.CN = b.CN
AND a.KHOI = b.KHOI
AND a.PRODUCT_CODE = b.PRODUCT_CODE
AND a.FTP_CODE= b.FTP_CODE
AND a.CATEGORY = b.CATEGORY
AND a.LOC_TERM = b.LOC_TERM
AND a.SECTOR = b.SECTOR
LEFT JOIN 
    ETL.REF_AICT_BRANCH_M k
ON 
    k.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
AND COALESCE (a.CN,b.CN) = k.BRANCH_CODE_T24
LEFT JOIN 
    ETL.ORS_TR_KHACHHANG_ACTIVE_M n
ON 
    n.DATA_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
AND COALESCE (a.MAKH,b.MAKH) = n.MAKH
LEFT JOIN 
    ETL.ORS_MB_SME_PKKH_M PK
ON 
    pk.TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
AND PK.pk_type = 'PK_100'
AND PK.dtt_type = 3
AND COALESCE (a.MAKH,b.MAKH, n.MAKH) = PK.MAKH
LEFT JOIN 
    ETL.ODS_LOAN_CONTRACT g 
ON 
    COALESCE ( a.TAIKHOAN, b.TAIKHOAN ) = g.ARRANGEMENT_NBR
LEFT JOIN 
    etl.ODS_PD_CONTRACT t 
ON 
    t.rank_num = 1
AND COALESCE ( a.TAIKHOAN, b.TAIKHOAN ) = t.ARRANGEMENT_NBR
LEFT JOIN 
    etl.ODS_OVD_CONTRACT u 
ON 
    COALESCE ( a.TAIKHOAN, b.TAIKHOAN ) = u.ARRANGEMENT_NBR
LEFT JOIN 
    etl.ORS_MB_PRODUCT_CODE l 
ON 
    COALESCE(a.PRODUCT_CODE,b.PRODUCT_CODE, g.PRODUCT_CODE, u.PRODUCT_CODE) = l.product_code
/*
with mb_nim_lk as
 (select a.TRANSACTION_DATE,
         a.TAIKHOAN,
         a.MAKH,
         a.NTE,
         a.CN,
         a.KHOI,
         a.MBLD_TYPE,
         a.PRODUCT_CODE,
         a.PRODUCTGR_CODE,
         a.CATEGORY,
         a.SUB_PRODUCT,
         a.LOC_TERM,
         a.LOAIKYHAN,
         a.SECTOR,
         a.FTP_CODE,
         a.D_TYPE,
         a.PROJECT_ID,
         a.PRODUCT_TYPE,
         sum(INTEREST_CONTRACT_NOMINAL_VND) NOMINAL_INTEREST_VND_LK,
         sum(INTEREST_CONTRACT_REAL_VND) REAL_INTEREST_VND_LK,
         sum(PENALTY_INTEREST_VND) PENALTY_INTEREST_VND_LK,
         sum(INTEREST_FTP_ACTUAL_VND) INTEREST_FTP_VND_LK,
         sum(INTEREST_FTP_REGULAR_VND) INTEREST_FTP_TT_VND_LK
    from apps.mb_agg_nim_lk a
   where a.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
     and d_type = 'LOAN'
     and TAIKHOAN not like '%F2B%'
     and not exists
   (select 1
            from APPS.FIN_LOAN_SMY_MONTHLY b
           where b.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
             and a.taikhoan = b.LD_ID
             and nvl(a.makh, 0) = nvl(b.makh, 0)
             and nvl(a.khoi, 0) = nvl(b.khoi, 0)
             and nvl(a.CN, 0) = nvl(b.CN, 0))
   group by a.TRANSACTION_DATE,
            a.TAIKHOAN,
            a.MAKH,
            a.NTE,
            a.CN,
            a.KHOI,
            a.MBLD_TYPE,
            a.PRODUCT_CODE,
            a.PRODUCTGR_CODE,
            a.CATEGORY,
            a.SUB_PRODUCT,
            a.LOC_TERM,
            a.LOAIKYHAN,
            a.SECTOR,
            a.FTP_CODE,
            a.D_TYPE,
            a.PROJECT_ID,
            a.PRODUCT_TYPE),
mb_nim_m as
 (select a.TRANSACTION_DATE,
         a.TAIKHOAN,
         a.MAKH,
         a.NTE,
         a.CN,
         a.KHOI,
         a.MBLD_TYPE,
         a.PRODUCT_CODE,
         a.PRODUCTGR_CODE,
         a.CATEGORY,
         a.SUB_PRODUCT,
         a.LOC_TERM,
         a.LOAIKYHAN,
         a.SECTOR,
         a.FTP_CODE,
         a.D_TYPE,
         a.PROJECT_ID,
         a.PRODUCT_TYPE,
         sum(NOMINAL_INTEREST_VND) NOMINAL_INTEREST_VND,
         sum(REAL_INTEREST_VND) REAL_INTEREST_VND,
         sum(PENALTY_INTEREST_VND) PENALTY_INTEREST_VND,
         sum(INTEREST_FTP_VND) INTEREST_FTP_VND,
         sum(INTEREST_FTP_TT_VND) INTEREST_FTP_TT_VND
    from apps.mb_agg_nim_m a
   where a.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
     and d_type = 'LOAN'
     and TAIKHOAN not like '%F2B%'
     and not exists
   (select 1
            from APPS.FIN_LOAN_SMY_MONTHLY b
           where b.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
             and a.taikhoan = b.LD_ID
             and nvl(a.makh, 0) = nvl(b.makh, 0)
             and nvl(a.khoi, 0) = nvl(b.khoi, 0)
             and nvl(a.CN, 0) = nvl(b.CN, 0))
   group by a.TRANSACTION_DATE,
            a.TAIKHOAN,
            a.MAKH,
            a.NTE,
            a.CN,
            a.KHOI,
            a.MBLD_TYPE,
            a.PRODUCT_CODE,
            a.PRODUCTGR_CODE,
            a.CATEGORY,
            a.SUB_PRODUCT,
            a.LOC_TERM,
            a.LOAIKYHAN,
            a.SECTOR,
            a.FTP_CODE,
            a.D_TYPE,
            a.PROJECT_ID,
            a.PRODUCT_TYPE)
select TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
       nvl(a.TAIKHOAN, b.TAIKHOAN) LD_ID,
       null COA_CODE,
       nvl(a.MAKH, b.MAKH) MAKH,
       nvl(a.NTE, b.NTE) NTE,
       null VAL_DATE,
       null MAT_DATE,
       null INT_RATE_TYPE,
       null INTEREST_KEY,
       null CIC_PURPOSE,
       nvl(a.LOC_TERM, b.LOC_TERM) LOC_TERM,
       null NHOM_KYHAN,
       null NHOMNO_XHTD,
       null NHOMNO_LIENDOI,
       null CREDIT_STATUS,
       null SOURCE_OF_FUND,
       nvl(a.SECTOR, b.SECTOR) SECTOR,
       nvl(a.KHOI, b.KHOI) KHOI,
       null CUS_TYPE,
       m.PHAN_KHUC,
       null CUS_STATUS,
       null INDUSTRY_CODE,
       nvl(a.CN, b.CN) CN,
       k.BRANCH_NAME_T24,
       k.PARENT_BRANCH_CODE_T24,
       k.PARENT_BRANCH_NAME_T24,
       k.TINH_THANH,
       k.VUNG_MIEN,
       k.TIEU_VUNG,
       nvl(a.CATEGORY, b.CATEGORY) CATEGORY,
       nvl(a.SUB_PRODUCT, b.SUB_PRODUCT) SUB_PRODUCT,
       null UOL,
       nvl(a.PRODUCT_CODE, b.PRODUCT_CODE) PRODUCT_CODE,
       null KENH_GD,
       null LEGACY_ID,
       nvl(a.MBLD_TYPE, b.MBLD_TYPE) MBLD_TYPE,
       null LIMIT_REF,
       nvl(a.PRODUCTGR_CODE, b.PRODUCTGR_CODE) PRODUCTGR_CODE,
       nvl(a.PRODUCT_TYPE, b.PRODUCT_TYPE) PRODUCT_TYPE,
       null DOUBTFUL_STATUS,
       nvl(a.PROJECT_ID, b.PROJECT_ID) PROJECT_ID,
       null LOAN_TYPE,
       null PARTIC_ID,
       null PARTIC_NAME,
       null PARTICI_PERC,
       null HD_DTT_UT,
       null TYLE_PHI,
       null TYLE_TCTD,
       null TK_NHANVON,
       null TK_CHUYENVON,
       nvl(a.FTP_CODE, b.FTP_CODE) FTP_CODE,
       null FIX_INT_RATE,
       null INT_SPREAD,
       null INT_RATE,
       0 DUNO_THOIDIEM_VND,
       0 DUNO_BINHQUAN_VND,
       0 DOANHSO_GIAINGAN_VND,
       0 DOANHSO_THUNO_VND,
       0 DOANHSO_THUNO_DUNGHAN_VND,
       0 DOANHSO_THUNO_TRUOCHAN_VND,
       0 DOANHSO_THUNO_QUAHAN_VND,
       nvl(b.NOMINAL_INTEREST_VND, 0) NOMINAL_INTEREST_VND,
       nvl(b.REAL_INTEREST_VND, 0) REAL_INTEREST_VND,
       nvl(b.PENALTY_INTEREST_VND, 0) PENALTY_INTEREST_VND,
       nvl(b.INTEREST_FTP_VND, 0) INTEREST_FTP_VND,
       nvl(b.INTEREST_FTP_TT_VND, 0) INTEREST_FTP_TT_VND,
       nvl(a.NOMINAL_INTEREST_VND_LK, 0) NOMINAL_INTEREST_VND_LK,
       nvl(a.REAL_INTEREST_VND_LK, 0) REAL_INTEREST_VND_LK,
       nvl(PENALTY_INTEREST_VND_LK, 0) PENALTY_INTEREST_VND_LK,
       nvl(a.INTEREST_FTP_VND_LK, 0) INTEREST_FTP_VND_LK,
       nvl(a.INTEREST_FTP_TT_VND_LK, 0) INTEREST_FTP_TT_VND_LK,
       0 RWA_CHOVAY_VND,
       0 duno_binhquan_lk_vnd
  from mb_nim_lk a
  full join mb_nim_m b
    on a.TAIKHOAN = b.TAIKHOAN
   and a.MAKH = b.MAKH
   and a.NTE = b.NTE
   and a.CN = b.CN
   and a.KHOI = b.KHOI
   and a.MBLD_TYPE = b.MBLD_TYPE
   and a.PRODUCT_CODE = b.PRODUCT_CODE
   and a.PRODUCTGR_CODE = b.PRODUCTGR_CODE
   and a.CATEGORY = b.CATEGORY
   and a.SUB_PRODUCT = b.SUB_PRODUCT
   and a.LOC_TERM = b.LOC_TERM
   and a.LOAIKYHAN = b.LOAIKYHAN
   and a.SECTOR = b.SECTOR
   and a.FTP_CODE = b.FTP_CODE
   and a.D_TYPE = b.D_TYPE
   and a.PROJECT_ID = b.PROJECT_ID
   and a.PRODUCT_TYPE = b.PRODUCT_TYPE
  left join ETL.REF_AICT_BRANCH_M k
    on k.transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   and coalesce(a.CN, b.CN) = k.BRANCH_CODE_T24
  left join APPS.FIN_SMY_CUSTOMER_MONTHLY m
    on m.transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   and coalesce(a.MAKH, b.MAKH) = m.MAKH
*/</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
