  <step>
    <name>tr_tk_m</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>
select
    TRANSACTION_DATE,
    SOSO SOTK,
    NTE,
    NHOMSP CATEGORY,
    MASP SUB_PRODUCT,
    NGAYMS,
    NGAYDH,
    START_DATE,
    MAKH,
    CUSTOMER_NAME TENKH,
    SECTOR,
    KHOI,
    GLSCB_ID LINE_T24,
    GL,
    case
        when KYHAN_TXT like '%M' then to_number (replace (KYHAN_TXT, 'M'))
        when KYHAN_TXT like '%D' then case
            when to_number (replace (KYHAN_TXT, 'D')) between 0
            and 27 then 0
            when to_number (replace (KYHAN_TXT, 'D')) between 28
            and 59 then 1
            when to_number (replace (KYHAN_TXT, 'D')) between 60
            and 89 then 2
            when to_number (replace (KYHAN_TXT, 'D')) between 90
            and 119 then 3
            when to_number (replace (KYHAN_TXT, 'D')) between 120
            and 149 then 4
            when to_number (replace (KYHAN_TXT, 'D')) between 150
            and 179 then 5
            when to_number (replace (KYHAN_TXT, 'D')) between 180
            and 209 then 6
            when to_number (replace (KYHAN_TXT, 'D')) between 210
            and 239 then 7
            when to_number (replace (KYHAN_TXT, 'D')) between 240
            and 269 then 8
            when to_number (replace (KYHAN_TXT, 'D')) between 270
            and 299 then 9
            when to_number (replace (KYHAN_TXT, 'D')) between 300
            and 329 then 10
            when to_number (replace (KYHAN_TXT, 'D')) between 330
            and 364 then 11
            when to_number (replace (KYHAN_TXT, 'D')) between 365
            and 389 then 12
            when to_number (replace (KYHAN_TXT, 'D')) between 390
            and 449 then 13
            when to_number (replace (KYHAN_TXT, 'D')) between 450
            and 539 then 15
            when to_number (replace (KYHAN_TXT, 'D')) between 540
            and 729 then 18
            when to_number (replace (KYHAN_TXT, 'D')) between 730
            and 1094 then 24
            when to_number (replace (KYHAN_TXT, 'D')) between 1095
            and 1459 then 36
            when to_number (replace (KYHAN_TXT, 'D')) between 1460
            and 1824 then 48
            when to_number (replace (KYHAN_TXT, 'D')) between 1825
            and 2554 then 60
            when to_number (replace (KYHAN_TXT, 'D')) between 2555
            and 3649 then 84
            when to_number (replace (KYHAN_TXT, 'D')) >= 3650 then 120
        end
        when KYHAN_TXT like '%W' then case
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 0
            and 27 then 0
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 28
            and 59 then 1
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 60
            and 89 then 2
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 90
            and 119 then 3
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 120
            and 149 then 4
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 150
            and 179 then 5
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 180
            and 209 then 6
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 210
            and 239 then 7
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 240
            and 269 then 8
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 270
            and 299 then 9
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 300
            and 329 then 10
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 330
            and 364 then 11
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 365
            and 389 then 12
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 390
            and 449 then 13
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 450
            and 539 then 15
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 540
            and 729 then 18
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 730
            and 1094 then 24
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 1095
            and 1459 then 36
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 1460
            and 1824 then 48
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 1825
            and 2554 then 60
            when to_number (replace (KYHAN_TXT, 'W')) * 7 between 2555
            and 3649 then 84
            when to_number (replace (KYHAN_TXT, 'W')) * 7 >= 3650 then 120
        end
        else 0
    end KYHAN_THANG,
    PRODUCT_CODE,
    FTP_CODE,
    CN,
    LS,
    'TR_TK' SOURCE_TABLE,
    SODU,
    DUCUOI_VND
from
    apps.tr_tk_m
where
    TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
    and substr (GL, 1, 2) in ('42', '43')
    and substr (PRODUCT_CODE, 1, 2) in ('11', '12', '13')
    and nvl (PRODUCT_CODE, '00000') &lt;&gt; '12919'  --Logic cu truoc 20240223
	--and nvl (PRODUCT_CODE, '00000') &lt;&gt; '12912'
</sql>
