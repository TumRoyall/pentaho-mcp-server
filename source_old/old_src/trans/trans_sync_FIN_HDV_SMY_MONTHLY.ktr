  <step>
    <name>MB_QTRR_HD33</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select
    to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
    KEY SOTK,
    CURRENCY NTE,
    '18510' CATEGORY,
    null as SUB_PRODUCT,
    ISSUE_DATE NGAYMS,
    MATURITY_DATE NGAYDH,
    ISSUE_DATE START_DATE,
    CUSTOMER_ID MAKH,
    ASSIGNER_NAME TENKH,
    SECTOR,
    KHOI,
    'GLSCB.3454' LINE_T24,
    GL,
    case
        when to_number (TERM) between 0
        and 27 then 0
        when to_number (TERM) between 28
        and 59 then 1
        when to_number (TERM) between 60
        and 89 then 2
        when to_number (TERM) between 90
        and 119 then 3
        when to_number (TERM) between 120
        and 149 then 4
        when to_number (TERM) between 150
        and 179 then 5
        when to_number (TERM) between 180
        and 209 then 6
        when to_number (TERM) between 210
        and 239 then 7
        when to_number (TERM) between 240
        and 269 then 8
        when to_number (TERM) between 270
        and 299 then 9
        when to_number (TERM) between 300
        and 329 then 10
        when to_number (TERM) between 330
        and 364 then 11
        when to_number (TERM) between 365
        and 389 then 12
        when to_number (TERM) between 390
        and 449 then 13
        when to_number (TERM) between 450
        and 539 then 15
        when to_number (TERM) between 540
        and 729 then 18
        when to_number (TERM) between 730
        and 1094 then 24
        when to_number (TERM) between 1095
        and 1459 then 36
        when to_number (TERM) between 1460
        and 1824 then 48
        when to_number (TERM) between 1825
        and 2554 then 60
        when to_number (TERM) between 2555
        and 3649 then 84
        when to_number (TERM) >= 3650 then 120
        else 0
    end KYHAN_THANG,
    PRODUCT PRODUCT_CODE,
    null as FTP_CODE,
    CN,
    INTEREST_RATE LS,
    'CD_SOCAP' SOURCE_TABLE,
    FACE_AMOUNT SODU,
    FACE_AMOUNT DUCUOI_VND
from
    apps.MB_QTRR_HD33
where
    TRANSACTION_DATE = (
        select
            max (dayid)
        from
            apps.mb_dim_time
        where
            DAYID &lt;= to_date ('${PRD_ID}', 'YYYYMMDD')
            and IS_WORKING_DAY = 1
    )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta/>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>208</xloc>
      <yloc>608</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
