    PARTY_KEY AS PARTY_KEY,
    regexp_substr(party_key, '\d+$') AS MAKH,
    REFERRAL_PARTY_KEY AS REFERRAL_PARTY_KEY,
    OPEN_CHANNEL_CODE AS OPEN_CHANNEL_CODE,
