    <connection>tckt_dc</connection>
    <sql>select 
/*+parallel(16)*/
to_date(${PRD_ID},'yyyyMMdd') transaction_date,
substr(${PRD_ID},1,6)||'CSTD' rep_type,
ma_cn                 ,
ten_cn                ,
makh                  ,
tenkh                 ,
khoi                  ,
cus_status            ,
product_code          ,
/*(case when (sum(nvl(sodu_vnd_h,0))+sum(nvl(SODU_VND_H_TP,0))) &lt;&gt;0 
then SUM(DTTTRR_I)/
(
sum(sodu_vnd_h*to_char(transaction_date,'dd')/ (to_date(${PRD_ID},'yyyyMMdd') - trunc(to_date(${PRD_ID},'yyyyMMdd'),'YEAR')+1))
+
-- add so du vnd tp
sum(nvl(SODU_VND_H_TP,0)*to_char(transaction_date,'dd')/ (to_date(${PRD_ID},'yyyyMMdd') - trunc(to_date(${PRD_ID},'yyyyMMdd'),'YEAR')+1))
)
end) TOI,*/
0 as TOI,
sum(sodu_vnd_h*to_char(transaction_date,'dd')/ (to_date(${PRD_ID},'yyyyMMdd') - trunc(to_date(${PRD_ID},'yyyyMMdd'),'YEAR')+1)) SODU_VND_H,
SUM(dtttrr_i              )dtttrr_i              ,
SUM(thu_lai_thuan         )thu_lai_thuan         ,
SUM(thulai_kh_a           )thulai_kh_a           ,
SUM(chilai_ftp_b          )chilai_ftp_b          ,
SUM(chilai_kh_c           )chilai_kh_c           ,
SUM(thulai_ftp_d          )thulai_ftp_d          ,
SUM(thu_ngoai_lai_e       )thu_ngoai_lai_e       ,
SUM(chi_dp_f              )chi_dp_f              ,
SUM(chihd_g               )chihd_g               ,
SUM(thulai_tindung_a1     )thulai_tindung_a1     ,
SUM(thu_lai_khac_a2       )thu_lai_khac_a2       ,
SUM(thulai_traiphieu_a3   )thulai_traiphieu_a3   ,
SUM(chiftp_tindung_b1     )chiftp_tindung_b1     ,
SUM(chiftp_khac_b2        )chiftp_khac_b2        ,
SUM(chiftp_traiphieu_b3   )chiftp_traiphieu_b3   ,
SUM(thuftp_duphongtd_b4   )thuftp_duphongtd_b4   ,
SUM(thuftp_duphongkhac_b3 )thuftp_duphongkhac_b3 ,
SUM(thuftp_duphongtp_b4   )thuftp_duphongtp_b4   ,
SUM(chilai_huydong_c1     )chilai_huydong_c1     ,
SUM(chilai_khac_c2        )chilai_khac_c2        ,
SUM(chilai_traiphieu_c3   )chilai_traiphieu_c3   ,
SUM(thuftp_huydong_d1     )thuftp_huydong_d1     ,
SUM(thuftp_khac_d2        )thuftp_khac_d2        ,
SUM(dv_baolanh_e1         )dv_baolanh_e1         ,
SUM(dv_ttqt_e2            )dv_ttqt_e2            ,
SUM(dv_tttn_e3            )dv_tttn_e3            ,
SUM(dv_the_e4             )dv_the_e4             ,
SUM(dv_utbhck_e5          )dv_utbhck_e5          ,
SUM(dv_tuvan_e6           )dv_tuvan_e6           ,
SUM(dv_nganquy_e7         )dv_nganquy_e7         ,
SUM(dv_giuho_e8           )dv_giuho_e8           ,
SUM(dv_kieuhoi_e9         )dv_kieuhoi_e9         ,
SUM(dv_nhdt_e10           )dv_nhdt_e10           ,
SUM(dv_commo_e13          )dv_commo_e13          ,
SUM(dv_khac_e13           )dv_khac_e13           ,
SUM(fx_nte_e14            )fx_nte_e14            ,
SUM(dtk_thu_e15           )dtk_thu_e15           ,
SUM(dtk_chiftp_e16        )dtk_chiftp_e16        ,
SUM(bt_khac_e17           )bt_khac_e17           ,
SUM(bt_xln_e18            )bt_xln_e18            ,
SUM(dp_dautu_f1           )dp_dautu_f1           ,
SUM(dp_lc_f2              )dp_lc_f2              ,
SUM(dp_bl_f3              )dp_bl_f3              ,
SUM(dp_td_f4              )dp_td_f4              ,
SUM(dp_k                  )dp_k                  ,
SUM(chihoatdong           )chihoatdong           ,
SUM(thuhoatdong           )thuhoatdong           ,
--(case when sum(nvl(sodu_vnd_h,0)) &lt;&gt;0 then 
--SUM( dtttrr_p)/
--SUM( SODU_VND_H/to_number(substr('20161231',5,2))) 
/*sum(sodu_vnd_h*to_char(transaction_date,'dd')/ (to_date(${PRD_ID},'yyyyMMdd') - trunc(to_date(${PRD_ID},'yyyyMMdd'),'YEAR')+1))
end) toi_cstd,
*/
0 as toi_cstd,
SUM(dtttrr_p              )dtttrr_p              ,
SUM(thu_ngoai_lai_o       )thu_ngoai_lai_o       ,
SUM(thulai_ftp_m          )thulai_ftp_m          ,
SUM(chilai_kh_l           )chilai_kh_l           ,
SUM(chilai_ftp_k          )chilai_ftp_k          ,
SUM(thulai_kh_j           )thulai_kh_j           ,
SUM(thulaithuan_n         )thulaithuan_n         ,
SUM(chilai_ftp_tindung_k1 )chilai_ftp_tindung_k1 ,
SUM(chiftp_khac_k2        )chiftp_khac_k2        ,
SUM(chiftp_traiphieu_k3   )chiftp_traiphieu_k3   ,
SUM(thulai_ftp_m1         )thulai_ftp_m1         ,
SUM(thuftp_khac_m2        )thuftp_khac_m2        ,
SUM(fx_nte_e14a           )fx_nte_e14a           ,
SUM(dttsrr_i              )dttsrr_i              ,
SUM(dttsrr_p              )dttsrr_p           ,
-- add so du VND TP
sum(nvl(SODU_VND_H_TP,0)*to_char(transaction_date,'dd')/ (to_date(${PRD_ID},'yyyyMMdd') - trunc(to_date(${PRD_ID},'yyyyMMdd'),'YEAR')+1)) SODU_VND_H_TP,
sum(THUFTP_DUPHONGTD_K4) as THUFTP_DUPHONGTD_K4,
sum(CHIFTP_BANNO) as CHIFTP_BANNO,
sum(THULAI_BANNO) as THULAI_BANNO
 from apps.rep_toi_final_tt_kh a
where transaction_Date >= trunc(to_date(${PRD_ID},'yyyyMMdd'),'YEAR')
and transaction_date &lt;=to_date(${PRD_ID},'yyyyMMdd')
--and note in ('ORIGINAL','DC')
--and substr(note,1,4) not in ('DCDP','DCEB')
--and note &lt;&gt; 'DCDP20180430'
group by ma_cn                 ,
ten_cn                ,
makh                  ,
tenkh                 ,
khoi                  ,
cus_status            ,
product_code          </sql>
