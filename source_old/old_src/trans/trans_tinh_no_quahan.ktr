  <step>
    <name>hoangtl</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with v_ls_base as (
  SELECT /*+ materialize */ *
  FROM apps.FTP_DIC_FTP_BASE A
  WHERE A.DATE_APPLY =
       (SELECT MAX(DATE_APPLY)
          FROM apps.FTP_DIC_FTP_BASE B
         WHERE B.CURRENCY = A.CURRENCY
           AND B.TERM = A.TERM
           AND B.DATE_APPLY &lt;=
               to_date('${PRD_ID}', 'yyyyMMdd'))
),
v_pttk as (
  SELECT /*+ materialize */  *
  FROM apps.FTP_DIC_PHUTROI A
  WHERE A.DATE_APPLY =
  (
        SELECT MAX(DATE_APPLY)
        FROM apps.FTP_DIC_PHUTROI B
        WHERE B.CURRENCY = A.CURRENCY
        AND B.TERM = A.TERM
        AND B.DATE_APPLY &lt;=
        to_date('${PRD_ID}', 'yyyyMMdd')
  )
),
v_cptk as (
  SELECT /*+ materialize */  *
  FROM apps.FTP_DIC_CHIPHI_TK A
  WHERE A.DATE_APPLY =
  (
    SELECT MAX(DATE_APPLY)
    FROM apps.FTP_DIC_CHIPHI_TK B
    WHERE B.CURRENCY = A.CURRENCY
    AND B.DATE_APPLY &lt;=trunc(to_date('${PRD_ID}', 'yyyyMMdd'),'MONTH') - 1
  )
),
v_dtbb as (
  SELECT /*+ materialize */  *
  FROM apps.ftp_dic_chiphi_dtbb A
  WHERE A.DATE_TX =
  (
    SELECT MAX(DATE_TX)
    FROM apps.ftp_dic_chiphi_dtbb B
    WHERE B.CCY = A.CCY
    AND B.DATE_TX &lt;=
    to_date('${PRD_ID}', 'yyyyMMdd')
  )
),
v_bhtg as (
  SELECT /*+ materialize */  *
  FROM apps.ftp_dic_chiphi_bhtg A
  WHERE A.DATE_TX =
  (
    SELECT MAX(DATE_TX)
    FROM apps.ftp_dic_chiphi_bhtg B
    WHERE B.CCY = A.CCY
    AND B.DATE_TX &lt;=
    to_date('${PRD_ID}', 'yyyyMMdd')
  )
),
v_ku as (
    select 
    t.*,
    (
      case 
        when sub_product in ('189', '192') and y_category like '1700%' then 'SME' 
        when sub_product in ('190', '191', '198') and Y_category like '1700%' then 'NHS' 
        when sub_product = '193' and Y_category like '1700%' then 'CIB' 
        when sub_product = '194' and Y_category like '1700%' then 'FI' 
        when y_category like '1700%' then 'INDIV'  
        when t.sector >= 1910 and t.sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)  
        then 'NHS'  
        when t.sector >= 1910 and t.sector &lt;= 1969 then 'INDIV'  
        when t.sector >= 1970 and t.sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)  
        then 'NHS'  
        when t.sector >= 1970 and t.sector &lt;= 1979 then 'CIB'  
        when t.sector >= 1980 and t.sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)  
        then 'NHS'  
        when t.sector >= 1980 and t.sector &lt;= 1999 then 'SME'
        else t.y_khoi 
      end
     ) khoi
    from etl.ftp_int_tienvay t
    where SOKU like 'PD%'
    AND GL LIKE '2%'
    and transaction_date = to_date('${PRD_ID}', 'yyyyMMdd') 
)
,
v_data as (
  SELECT 
    A.CN,
    A.MAKH,
    A.SOKU,
    A.NTE,
    null as SP_CAP1,
    null as SP_CAP2,
    null as SP_CAP3,
    A.NGAYVAY,
    A.NGAYDH,
    A.NGAYGH,
    A.HANVAY,
    A.NHOMNO,
    A.NHOMNO2,
    A.NGAYCNN,
    A.SODU,
    A.TRANSACTION_DATE,
    A.SECTOR,
    A.GL,
    A.SOURCE_OF_FUND,
    DECODE(NVL(A.Y_TS_TDLS, '6M'), 'M','1M',NVL(A.Y_TS_TDLS, '6M')) Y_TS_TDLS,
    A.FTP_PROD,
    A.PRODUCT_CODE,
    A.MB_PER,
    A.Y_PTTK,
    A.KHOI,
    (
      CASE
       WHEN SOURCE_OF_FUND IN ('7', '8', '9') THEN
        A.SODU * DECODE(NVL(A.MB_PER, 1), 1, 100, A.MB_PER) / 100
       ELSE
        A.SODU
      END
    ) * (-1) AS SODU_FTP,
    B.VUNG_MIEN,
    F.DP_CUTHE_FTP,
    D.AMOUNT FTP_DIEUCHINH_ALCO,
    D.BIENDO_KHOI,
    D.BIENDO_SANPHAM,
    D.BIENDO_VUNGMIEN,
    C.AMOUNT FTP_LS_BASE,
    E.AMOUNT FTP_PHUTROI_TK,
    Fa.AMOUNT FTP_CHIPHI_TK,
    G.cp_dtbb,
    H.tile_bhtg,
    A.LS LS_HD,
    x.hoten CUS_NAME  
  FROM v_ku A
 LEFT JOIN etl.tmp_toi_khachhang X
--LEFT JOIN apps.TR_KHACHHANG X 
ON A.MAKH = X.MAKH
  LEFT JOIN apps.MB_TR_KU_DP F
  ON A.SOKU = F.SOKU
  AND A.TRANSACTION_DATE = F.TRANSACTION_DATE
  LEFT JOIN apps.ftp_dic_vungmien_khuvuc b
  on a.cn = b.cn_cap_2
  --L?Y LS BASE
  LEFT JOIN v_ls_base C
  ON A.NTE = C.CURRENCY
  AND DECODE(NVL(A.Y_TS_TDLS, '6M'),'M','1M',NVL(A.Y_TS_TDLS, '6M')) = C.TERM    --lynt6: chinh sua tu 12M ve 6M          
  --L?Y ?I?U CH?NH ALCO
  --15-1-2019: lay cau hinh dieu chinh alco tu bang tmp
  LEFT JOIN etl.tmp_FTP_DIC_DIEUCHINH_ALCO D
  ON A.FTP_PROD = D.FTP_PRODUCT
  AND A.KHOI = D.KHOI
  --AND B.Vung_Mien = D.VUNG_MIEN
  AND D.VUNG_MIEN = 'HANOI'
  AND DECODE(NVL(A.Y_TS_TDLS, '6M'),'M','1M',NVL(A.Y_TS_TDLS, '6M')) = D.TERM	--lynt6: chinh sua tu 12M ve 6M  
  AND A.NTE = D.CURRENCY
  --LAY PHU TROI TK
  LEFT JOIN v_pttk E
  ON A.NTE = E.CURRENCY
  AND DECODE(NVL(A.Y_TS_TDLS, '6M'),'M','1M',NVL(A.Y_TS_TDLS, '6M')) = E.TERM 	--lynt6: chinh sua tu 12M ve 6M  
  -- lay chi phi thanh khoan        
  LEFT JOIN v_cptk Fa
  ON A.NTE = Fa.CURRENCY          
  --LAY CHI PHI DTBB
  LEFT JOIN v_dtbb G
  ON A.NTE = G.CCY
  --LAY CHI PHI BHTG      
  LEFT JOIN v_bhtg H
  ON A.NTE = H.CCY   
)
SELECT 
  A.CN,
    A.MAKH,
    A.SOKU,
    A.NTE,
    A.SP_CAP1,
    A.SP_CAP2,
    A.SP_CAP3,
    A.NGAYVAY,
    A.NGAYDH,
    A.NGAYGH,
    A.HANVAY,
    A.NHOMNO,
    A.NHOMNO2,
    A.NGAYCNN,
    A.SODU,
    A.TRANSACTION_DATE,
    A.SECTOR,
    A.GL,
    A.SOURCE_OF_FUND,
    A.Y_TS_TDLS,
    A.FTP_PROD,
    A.PRODUCT_CODE,
    A.MB_PER,
    A.Y_PTTK,
    A.KHOI,
    A.SODU_FTP - NVL(A.DP_CUTHE_FTP, 0) AS SODU_FTP, --hoangtl: chinh sua logic, them - NVL(F.DP_CUTHE_FTP, 0)
    A.VUNG_MIEN,
    A.DP_CUTHE_FTP,
    A.FTP_DIEUCHINH_ALCO,
    A.BIENDO_KHOI,
    A.BIENDO_SANPHAM,
    A.BIENDO_VUNGMIEN,
    A.FTP_LS_BASE,
    A.FTP_PHUTROI_TK,
    A.FTP_CHIPHI_TK,
    A.cp_dtbb,
    A.tile_bhtg,
    A.LS_HD,
    A.CUS_NAME,
  g.ftp_line,
  g.ftp_category,
   CASE
   WHEN NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0) &lt;= 0 THEN
    0
   ELSE
    CASE
      WHEN A.NTE = 'VND' THEN
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) + NVL(FTP_CHIPHI_TK, 0)) /
             (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             0)
      ELSE
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) + NVL(FTP_CHIPHI_TK, 0)) /
             (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             2)
    END
  END FTP_AMOUNT,
  CASE
   WHEN NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0) &lt;= 0 THEN
    0
   ELSE
    CASE
      WHEN A.NTE = 'VND' THEN
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.FTP_DIEUCHINH_ALCO, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             0)
      ELSE
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.FTP_DIEUCHINH_ALCO, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             2)
    END
  END FTP_AMT_WITH_ALCO,
         
  CASE
   WHEN NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0) &lt;= 0 THEN
    0
   ELSE
    CASE
      WHEN A.NTE = 'VND' THEN
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.BIENDO_KHOI, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             0)
      ELSE
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.BIENDO_KHOI, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             2)
    END
  END FTP_AMT_WITH_BIENDO_KHOI,
         
  CASE
   WHEN NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0) &lt;= 0 THEN
    0
   ELSE
    CASE
      WHEN A.NTE = 'VND' THEN
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.BIENDO_SANPHAM, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             0)
      ELSE
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.BIENDO_SANPHAM, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             2)
    END
  END FTP_AMT_WITH_BIENDO_SANPHAM,
         
  CASE
   WHEN NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0) &lt;= 0 THEN
    0
   ELSE
    CASE
      WHEN A.NTE = 'VND' THEN
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.BIENDO_VUNGMIEN, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             0)
      ELSE
       ROUND((NVL(A.SODU_FTP, 0) - NVL(A.DP_CUTHE_FTP, 0)) *
             (NVL(A.FTP_LS_BASE, 0) + NVL(A.FTP_PHUTROI_TK, 0) +
             +NVL(tile_bhtg, 0) + NVL(cp_dtbb, 0) +
             NVL(FTP_CHIPHI_TK, 0) + NVL(A.BIENDO_VUNGMIEN, 0)) / (case when a.transaction_date>='1-jan-2018' then 36500 else 36000 end),
             2)
    END
  END FTP_AMT_WITH_BIENDO_VUNGMIEN
FROM v_data A
--left join apps.ftp_dic_line_mapping g
left join apps.ftp_mapping_toi g
on a.ftp_prod = g.ftp_prod
and a.khoi =g.khoi</sql>
