    </partitioning>
    <connection>ods_dc</connection>
    <sql>select 
pl_txn_daily_id,
txn_date,
source_table_name,
entry_id,
relation_txn_nbr,
currency_code,
fcy_amt,
lcy_amt,
branch_code,
party_key,
t24_cust_id,
party_full_name,
coa_code,
t24_line,
gl_line,
pl_cate_code,
gl_cmb_code,
gl_segment_value_cmb,
gl_dept_code,
receive_chg_code,
payment_chg_code,
chg_product_code,
arrangement_product_code,
txn_channel_code,
level2_service_code,
level3_service_code,
party_sector_code,
party_division_code,
report_division_code,
level1_report_item_code,
report_item_code,
report_item_name,
eb_report_item_ind,
rm_code  ,
CREATED_BY,
CREATION_DATE,
LAST_UPDATED_BY,
LAST_UPDATE_DATE,
CHG_TYPE,
CHG_CODE,
NARRATIVE
from smy.pl_txn_daily a
where a.TXN_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
and  (a.REPORT_ITEM_CODE like ('A205%')
or  a.PL_CATE_CODE in ('52796','67026','52795','52294'))</sql>
