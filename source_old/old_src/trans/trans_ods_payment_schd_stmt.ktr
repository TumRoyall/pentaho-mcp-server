  <step>
    <name>ETL.ODS_LOAN_BAL</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH TR_KU_LICHTRAGOC AS 
(SELECT
A.TXN_DATE, 
A.ARRANGEMENT_NBR SOKU,
a.CURRENCY_CODE NTE,
NVL(B.SCHD_DATE - B.TXN_DATE,A.MATURITY_DATE - A.VALUE_DATE) SO_NGAY,
NVL(B.LCY_SCHD_AMT, A.LCY_AMT) SO_DU_GOC_VND
FROM ETL.ODS_LOAN_BAL A
LEFT JOIN ETL.ODS_PAYMENT_SCHD_STMT B
ON B.SCHD_TYPE ='P'
AND A.ARRANGEMENT_NBR = B.ARRANGEMENT_NBR
WHERE substr(a.COA_CODE,1,1) = 2 
and substr(a.COA_CODE,1,2) &lt;&gt; '20' 
and substr(a.ARRANGEMENT_NBR,1,2) = 'LD'
AND A.FTP_CODE NOT IN ('TD452','TD103')
AND A.TXN_DATE = A.VALUE_DATE)
SELECT 
A.TXN_DATE,
A.SOKU,
ROUND(sum(A.SO_DU_GOC_VND*C.AMOUNT) / sum(A.SO_DU_GOC_VND),2) PTTK
FROM TR_KU_LICHTRAGOC A
LEFT JOIN APPS.FTP_MAP_TERM B
ON A.SO_NGAY >= B.FROM_DAY
AND A.so_NGAY &lt;= B.TO_DAY
LEFT JOIN APPS.FTP_REF_PHUTROI C 
ON TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD') 
AND A.NTE = C.CCY
AND B.TERM_ID = C.TERM_HD
group by A.SOKU,A.TXN_DATE</sql>
    <limit>0</limit>
