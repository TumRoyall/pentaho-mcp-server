    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT A.TXN_DATE,
       A.ENTRY_ID,
       A.GL_CMB_CODE,
       A.GL_SEGMENT_VALUE_CMB,
       A.BRANCH_CODE,
       A.GL_DEPT_CODE,
       A.COA_CODE,
       A.GL_LINE,
       A.CURRENCY_CODE,
       A.SOURCE_SYSTEM_CODE,
       A.JRNL_SOURCE_CODE,
       A.JRNL_NAME,
       A.RELATION_TXN_TYPE_NAME,
       A.RELATION_TXN_NBR,
       A.VALUE_DATE,
       A.EXCHANGE_RATE,
       A.FCY_CREDIT_AMT - A.FCY_DEBIT_AMT FCY_TXN_AMT,
       A.LCY_CREDIT_AMT - A.LCY_DEBIT_AMT LCY_TXN_AMT,
       A.NARRATIVE,
       A.CREATION_USER_CODE,
       A.APRV_USER_CODE,
       DECODE(A.SOURCE_SYSTEM_CODE,
              'T24',
              A.BRANCH_CODE,
              'GL',
              REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 1),
              NULL) SEG1,
       DECODE(A.SOURCE_SYSTEM_CODE,
              'T24',
              REGEXP_SUBSTR(A.GL_DEPT_CODE, '[^-]+', 1, 1),
              'GL',
              REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 2),
              NULL) SEG2,
       DECODE(A.SOURCE_SYSTEM_CODE,
              'T24',
              REGEXP_SUBSTR(A.GL_DEPT_CODE, '[^-]+', 1, 2),
              'GL',
              REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 3),
              NULL) SEG3,
       DECODE(A.SOURCE_SYSTEM_CODE,
              'T24',
              REGEXP_SUBSTR(A.GL_DEPT_CODE, '[^-]+', 1, 3),
              'GL',
              REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 4),
              NULL) SEG4,
       DECODE(A.SOURCE_SYSTEM_CODE,
              'T24',
              REGEXP_SUBSTR(A.GL_DEPT_CODE, '[^-]+', 1, 4),
              'GL',
              REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 5),
              NULL) SEG5,
       REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 6) SEG6,
       REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 7) SEG7,
       REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 8) SEG8,
       REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 9) SEG9,
       REGEXP_SUBSTR(A.GL_SEGMENT_VALUE_CMB, '[^.]+', 1, 10) SEG10,
       NULL MA_TAISAN,
       NULL MA_HETHONG,
       A.BPM_PROCESS_CODE MA_PAM,
       B.PARENT_BRANCH_CODE_T24 BRANCH_CNC1,
       C.OPEX_CODE_L1,
       C.OPEX_CODE_L2,
       C.OPEX_CODE_L3,
       C.OPEX_CODE_L4,
       C.OPEX_CODE_L5,
       C.OPEX_NAME_L1,
       C.OPEX_NAME_L2,
       C.OPEX_NAME_L3,
       C.OPEX_NAME_L4,
       C.OPEX_NAME_L5,
       C.DONVI_DAUMOI,
       C.LOAITRU_THUETNDN,
       C.CHUCDANH,
       C.NOIBO_BENNGOAI,
       C.CANHAN_CONGTY,
       'DU_LIEU_BACKDATE' NGUON
  FROM ETL.ODS_ACG_LINE_TRANS_DAILY_BACKDATE A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON A.BRANCH_CODE = B.BRANCH_CODE_T24
   AND EXTRACT(MONTH FROM A.TXN_DATE) =
       EXTRACT(MONTH FROM B.TRANSACTION_DATE)
   AND EXTRACT(YEAR FROM A.TXN_DATE) =
       EXTRACT(YEAR FROM B.TRANSACTION_DATE)
  LEFT JOIN APPS.FILE_EXPN_CODE_MAP C
    ON A.GL_LINE = C.GL_LINE</sql>
    <limit>0</limit>
