    <sql>DELETE FROM APPS.FIN_PNL_EXPN_SMY_MONTHLY
WHERE NGUON = 'DU_LIEU_BACKDATE'
  AND TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MM') 
    AND LAST_DAY(TO_DATE('${PRD_ID}', 'YYYYMMDD'))</sql>
