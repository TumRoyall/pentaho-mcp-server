  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT *
FROM (
    SELECT
        t.*,
        ROW_NUMBER() OVER (
            PARTITION BY t.CF_BS_ITEM_CODE
            ORDER BY t.TXN_DATE DESC
        ) AS rn
    FROM (
        ----------------------------------------------------------------
        -- PROFIT &amp; LOSS (PL)
        ----------------------------------------------------------------
        SELECT
            (CASE
                WHEN A.COMPANY_CODE = 'MBCAP'   THEN 'MBC'
                WHEN A.COMPANY_CODE = 'MBAMC'   THEN 'AMC'
                WHEN A.COMPANY_CODE = 'MCREDIT' THEN 'MC'
                WHEN A.COMPANY_CODE = 'MBCAM'   THEN 'CAM'
                ELSE A.COMPANY_CODE
            END) || '.PL.' || A.KPI_CODE        AS CF_BS_ITEM_CODE,
            'PL'                               AS RPT_TYPE,
            A.KPI_NAME                         AS CHITIEU_NAME,
            A.CURR_YTD_AMOUNT                  AS AMT_LCY,
            (CASE
                WHEN A.COMPANY_CODE = 'MBCAP'   THEN 'MBC'
                WHEN A.COMPANY_CODE = 'MBAMC'   THEN 'AMC'
                WHEN A.COMPANY_CODE = 'MCREDIT' THEN 'MC'
                WHEN A.COMPANY_CODE = 'MBCAM'   THEN 'CAM'
                ELSE A.COMPANY_CODE
            END)                               AS SUB_NAME,
            A.KPI_CODE                         AS CHITIEU_CODE,
            LAST_DAY(TO_DATE(A.PERIOD_CODE, 'YYYYMM')) AS TXN_DATE
        FROM ETL.MBG_PROFIT_LOSS A
        WHERE (
                (A.COMPANY_CODE = 'MIC'  AND A.DATA_TYPE = 'HN')
             OR (A.COMPANY_CODE &lt;&gt; 'MIC' AND A.DATA_TYPE = 'RL')
              )
          AND A.PERIOD_TYPE = 'MTH'

        ----------------------------------------------------------------
        -- BALANCE SHEET (BS)
        ----------------------------------------------------------------
        UNION ALL

        SELECT
            (CASE
                WHEN B.COMPANY_CODE = 'MBCAP'   THEN 'MBC'
                WHEN B.COMPANY_CODE = 'MBAMC'   THEN 'AMC'
                WHEN B.COMPANY_CODE = 'MCREDIT' THEN 'MC'
                WHEN B.COMPANY_CODE = 'MBCAM'   THEN 'CAM'
                ELSE B.COMPANY_CODE
            END) || '.BS.' || B.KPI_CODE        AS CF_BS_ITEM_CODE,
            'BS'                               AS RPT_TYPE,
            B.KPI_NAME                         AS CHITIEU_NAME,
            B.CURR_AMOUNT                      AS AMT_LCY,
            (CASE
                WHEN B.COMPANY_CODE = 'MBCAP'   THEN 'MBC'
                WHEN B.COMPANY_CODE = 'MBAMC'   THEN 'AMC'
                WHEN B.COMPANY_CODE = 'MCREDIT' THEN 'MC'
                WHEN B.COMPANY_CODE = 'MBCAM'   THEN 'CAM'
                ELSE B.COMPANY_CODE
            END)                               AS SUB_NAME,
            B.KPI_CODE                         AS CHITIEU_CODE,
            LAST_DAY(TO_DATE(B.PERIOD_CODE, 'YYYYMM')) AS TXN_DATE
        FROM ETL.MBG_BALANCE_SHEET B
        WHERE (
                (B.COMPANY_CODE = 'MIC'  AND B.DATA_TYPE = 'HN')
             OR (B.COMPANY_CODE &lt;&gt; 'MIC' AND B.DATA_TYPE = 'RL')
              )
          AND B.PERIOD_TYPE = 'MTH'

        ----------------------------------------------------------------
        -- PROFIT &amp; LOSS QT (PLQT)
        ----------------------------------------------------------------
        UNION ALL

        SELECT
            (CASE
                WHEN C.COMPANY_CODE = 'MBCAP'   THEN 'MBC'
                WHEN C.COMPANY_CODE = 'MBAMC'   THEN 'AMC'
                WHEN C.COMPANY_CODE = 'MCREDIT' THEN 'MC'
                WHEN C.COMPANY_CODE = 'MBCAM'   THEN 'CAM'
                ELSE C.COMPANY_CODE
            END) || '.PLQT.' || C.KPI_CODE      AS CF_BS_ITEM_CODE,
            'PLQT'                             AS RPT_TYPE,
            C.KPI_NAME                         AS CHITIEU_NAME,
            C.CURR_YTD_AMOUNT                  AS AMT_LCY,
            (CASE
                WHEN C.COMPANY_CODE = 'MBCAP'   THEN 'MBC'
                WHEN C.COMPANY_CODE = 'MBAMC'   THEN 'AMC'
                WHEN C.COMPANY_CODE = 'MCREDIT' THEN 'MC'
                WHEN C.COMPANY_CODE = 'MBCAM'   THEN 'CAM'
                ELSE C.COMPANY_CODE
            END)                               AS SUB_NAME,
            C.KPI_CODE                         AS CHITIEU_CODE,
            LAST_DAY(TO_DATE(C.PERIOD_CODE, 'YYYYMM')) AS TXN_DATE
        FROM ETL.MBG_BI_COMP_PROFIT_LOSS C
        WHERE (
                (C.COMPANY_CODE = 'MIC'  AND C.DATA_TYPE = 'HN')
             OR (C.COMPANY_CODE &lt;&gt; 'MIC' AND C.DATA_TYPE = 'RL')
              )
          AND C.PERIOD_TYPE = 'MTH'
        ----------------------------------------------------------------
		-- ETL.FILE_MBG_THAMSO_FIX
        ----------------------------------------------------------------
        UNION ALL
		
		SELECT 
			D.*,
			LAST_DAY(TO_DATE('${PRD_M}', 'YYYYMM')) AS TXN_DATE
		FROM ETL.FILE_MBG_THAMSO_FIX D
        ----------------------------------------------------------------
    ) t
)
WHERE rn = 1
</sql>
    <limit>0</limit>
