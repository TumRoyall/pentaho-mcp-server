    <connection>tckt_dc</connection>
    <sql>SELECT 
a.transaction_date,
a.ma_cnc2,
a.makh,
a.khoi,
a.product_code,
a.rm_code,
a.smb_name,
SUM(CASE WHEN a.tk_type ='CHO_VAY' THEN nvl(a.amt_lcy,0) ELSE 0 END) CHOVAY,
sum(CASE WHEN a.tk_type ='HD_CKH' THEN nvl(a.amt_lcy,0) ELSE 0 END) HD_CKH,
sum(CASE WHEN a.tk_type ='HD_KKH' THEN nvl(a.amt_lcy,0) ELSE 0 END) HD_KKH,
sum(CASE WHEN a.tk_type ='CD_ONLINE' THEN nvl(a.amt_lcy,0) ELSE 0 END) CD_ONLINE,
sum(CASE WHEN a.tk_type ='TRAI_PHIEU' THEN nvl(a.amt_lcy,0) ELSE 0 END) TRAI_PHIEU,
sum(CASE WHEN a.tk_type ='BAO_LANH' THEN nvl(a.amt_lcy,0) ELSE 0 END) BAO_LANH,
sum(CASE WHEN a.tk_type ='TTTM_LC' THEN nvl(a.amt_lcy,0) ELSE 0 END) TTTM_LC,
sum(CASE WHEN a.tk_type ='TTTM_FX' THEN nvl(a.amt_lcy,0) ELSE 0 END) TTTM_FX,
sum(CASE WHEN a.tk_type ='DU_PHONG' THEN nvl(a.amt_lcy,0) ELSE 0 END) DU_PHONG,
sum(CASE WHEN a.tk_type ='TTTM_CTQT' THEN nvl(a.amt_lcy,0) ELSE 0 END) TTTM_CTQT,
sum(CASE WHEN a.tk_type ='BANCA' THEN nvl(a.amt_lcy,0) ELSE 0 END) BANCA,
sum(CASE WHEN a.tk_type ='DT_KHAC' THEN nvl(a.amt_lcy,0) ELSE 0 END) DT_KHAC,
sum(CASE WHEN a.tk_type ='OPEX' THEN nvl(a.amt_lcy,0) ELSE 0 END) OPEX,
sum(CASE WHEN a.tk_type ='TAI_SAN' THEN nvl(a.amt_lcy,0) ELSE 0 END) TAI_SAN,
sum(CASE WHEN a.tk_type ='LUONG' THEN nvl(a.amt_lcy,0) ELSE 0 END) LUONG,
sum(CASE WHEN a.tk_type ='DINH_MUC' THEN nvl(a.amt_lcy,0) ELSE 0 END) DINH_MUC
FROM APPS.FIN_SMB_PNL_TRANS_MONTHLY  a
where a.transaction_date =to_date(${PRD_ID},'YYYYMMDD')
GROUP BY 
a.transaction_date,
a.ma_cnc2,
a.makh,
a.khoi,
a.product_code,
a.rm_code,
a.smb_name,
a.tk_type</sql>
