  <step>
    <name>TR_CRB</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>SELECT 
TRANSACTION_DATE,
CN,
NTE,
GL,
SOTK,
REF,
KYHAN,
SODU,
SODU_VND,
MAKH,
TENKH,
SECTOR,
INDUSTRY_CODE,
NGAYHIEULUC,
NGAYDAOHAN,
LAISUAT,
CATEGORY,
GLSCB_ID,
NHOMNO_XHTD,
NHOMNO_LINE,
MANHANVIEN,
SUB_PRODUCT,
LD_PER,
LD_RATE,
TSDB,
CUS_ACC_OFF,
MUCDICHVAY,
KYHAN_SOURCE,
KHOI,
MBLD_TYPE,
PRODUCT_CODE,
KEY_PRODUCT,
RM_BANCHEO,
CONSOL_KEY,
MA_NV,
WORKING_BAL,
ONLINE_ACTUAL,
OPEN_BAL
FROM APPS.TR_CRB
where TRANSACTION_DATE = 
(select max (dayid) from apps.mb_dim_time
where DAYID &lt;= to_date ('${PRD_ID}', 'YYYYMMDD')
and IS_WORKING_DAY = 1)
and GL in ('3710', '3720')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
