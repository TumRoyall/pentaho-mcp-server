    <connection>tckt_dc</connection>
    <sql>SELECT a.transaction_date, a.ma_cn, a.makh, a.khoi,a.product_code, sector,sum(a.sodu_vnd) sodu_vnd,
       sum(a.thulai_tindung_a1) thulai_tindung_a1, sum(a.thu_lai_khac_a2) thu_lai_khac_a2, sum(a.thulai_traiphieu_a3) thulai_traiphieu_a3,
       sum(a.chiftp_tindung_b1) chiftp_tindung_b1, sum(a.chiftp_khac_b2) chiftp_khac_b2, sum(a.chiftp_traiphieu_b3) chiftp_traiphieu_b3,
       sum(a.thuftp_duphongtd_b4) thuftp_duphongtd_b4, sum(a.thuftp_duphongkhac_b3) thuftp_duphongkhac_b3,
       sum(a.thuftp_duphongtp_b4)thuftp_duphongtp_b4, sum(a.chilai_huydong_c1) chilai_huydong_c1, sum(a.chilai_khac_c2) chilai_khac_c2,
       sum(a.chilai_traiphieu_c3) chilai_traiphieu_c3, sum(a.thuftp_huydong_d1)thuftp_huydong_d1, sum(a.thuftp_khac_d2)thuftp_khac_d2,
       sum(a.dv_baolanh_e1) dv_baolanh_e1, sum(a.dv_ttqt_e2) dv_ttqt_e2, sum(a.dv_tttn_e3) dv_tttn_e3, sum(a.dv_the_e4) dv_the_e4,
       sum(a.dv_utbhck_e5)dv_utbhck_e5, sum(a.dv_tuvan_e6)dv_tuvan_e6, sum(a.dv_nganquy_e7)dv_nganquy_e7, sum(a.dv_giuho_e8)dv_giuho_e8,
       sum(a.dv_kieuhoi_e9) dv_kieuhoi_e9, sum(a.dv_nhdt_e10)dv_nhdt_e10, sum(a.dv_commo_e13)dv_commo_e13, sum(a.dv_khac_e13)dv_khac_e13,
       sum(a.fx_nte_e14)fx_nte_e14,sum(a.fx_nte_e14a)fx_nte_e14a, sum(a.dtk_thu_e15)dtk_thu_e15, sum(a.dtk_chiftp_e16)dtk_chiftp_e16, sum(a.bt_khac_e17)bt_khac_e17,
       sum(a.bt_xln_e18)bt_xln_e18, sum(a.dp_dautu_f1)dp_dautu_f1, sum(a.dp_lc_f2)dp_lc_f2, sum(a.dp_bl_f3)dp_bl_f3, sum(a.dp_td_f4)dp_td_f4,
       sum(a.dp_k)dp_k, sum(a.chihoatdong)chihoatdong, 
       sum(a.chiftp_khac_k2)chiftp_khac_k2,sum(a.chiftp_traiphieu_k3)chiftp_traiphieu_k3,sum(a.thuftp_khac_m2)thuftp_khac_m2,
       sum(chilai_ftp_k)chilai_ftp_k,sum(thulai_ftp_m)thulai_ftp_m
FROM etl.mb_agg_toi_daily_tmp2 a
where transaction_date=to_date(${PRD_ID},'yyyyMMdd')
group by a.transaction_date, a.ma_cn, a.makh, a.khoi,a.product_code, sector</sql>
