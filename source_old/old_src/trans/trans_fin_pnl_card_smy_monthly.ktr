  <step>
    <name>MPA_TONGHOP_CHIKD</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>/*SELECT
    A.PARTITION_DATE AS TRANSACTION_DATE,
    A.CHG_CODE AS CHG_CODE,
    F.PL_CATEGORY_NAME AS CHG_NAME,
    'VND' AS NTE,
    SUM(A.TIENNO_VND) AS CHG_AMT_FCY,
    SUM(A.TIENNO_VND) AS CHG_AMT_LCY,
    A.LINE_T24 AS T24_LINE,
    A.TK AS COA_CODE,
    A.MA_CN AS MA_CNC2,
    A.ACCTNBR AS PL_CATEGORY,
    A.MAKH AS MAKH,
    G.HOTEN AS TENKH,
    A.SECTOR AS SECTOR,
    A.PKKH AS PHAN_KHUC,
    A.KHOI AS KHOI,
    '' AS CONSOL_KEY,
    '' AS RM_CODE,
    COALESCE(
        B.CARD_CHANNEL_TYPE,
        C.CARD_CHANNEL_TYPE,
        D.CARD_CHANNEL_TYPE,
        E.CARD_CHANNEL_TYPE,
        H.CARD_CHANNEL_TYPE,
        I.CARD_CHANNEL_TYPE
    ) AS CARD_CHANNEL_TYPE,
    COALESCE(
        B.CARD_TYPE,
        C.CARD_TYPE,
        D.CARD_TYPE,
        E.CARD_TYPE,
        H.CARD_TYPE,
        I.CARD_TYPE
    ) AS CARD_TYPE,
    COALESCE(
        B.CARD_MODULE,
        C.CARD_MODULE,
        D.CARD_MODULE,
        E.CARD_MODULE,
        H.CARD_MODULE,
        I.CARD_MODULE
    ) AS CARD_MODULE,
    COALESCE(
        B.CARD_SERVICE,
        C.CARD_SERVICE,
        D.CARD_SERVICE,
        E.CARD_SERVICE,
        H.CARD_SERVICE,
        I.CARD_SERVICE
    ) AS CARD_SERVICE,
    COALESCE(
        B.CARD_PRODUCT,
        C.CARD_PRODUCT,
        D.CARD_PRODUCT,
        E.CARD_PRODUCT,
        H.CARD_PRODUCT,
        I.CARD_PRODUCT
    ) AS CARD_PRODUCT,
    COALESCE(
        B.CARD_ISSUER,
        C.CARD_ISSUER,
        D.CARD_ISSUER,
        E.CARD_ISSUER,
        H.CARD_ISSUER,
        I.CARD_ISSUER
    ) AS CARD_ISSUER,
    A.SOURE_IMPORT AS SOURCE_IMPORT,
    A.BIN6 AS BIN6,
    A.BIN8 AS BIN8,
    A.PRODUCT_CODE AS PRODUCT_CODE,
    Z.chitieu chitieu
FROM
    ETL.MPA_TONGHOP_CHIKD A
    LEFT JOIN APPS.REF_CARD_BIN_MAP B ON B.TYPE_BIN = 'BIN6'
    AND A.SOURE_IMPORT = B.SOURCE_IMPORT
    AND A.BIN6 = B.VALUE_BIN
    LEFT JOIN APPS.REF_CARD_BIN_MAP C ON C.TYPE_BIN = 'BIN6'
    AND C.VALUE_BIN IS NULL
    AND A.SOURE_IMPORT = C.SOURCE_IMPORT
    LEFT JOIN APPS.REF_CARD_BIN_MAP D ON D.TYPE_BIN = 'BIN8'
    AND A.SOURE_IMPORT = D.SOURCE_IMPORT
    AND A.BIN8 = D.VALUE_BIN
    LEFT JOIN APPS.REF_CARD_BIN_MAP E ON E.TYPE_BIN = 'BIN8'
    AND E.VALUE_BIN IS NULL
    AND A.SOURE_IMPORT = E.SOURCE_IMPORT
    LEFT JOIN APPS.REF_CARD_BIN_MAP H ON H.TYPE_BIN = 'DEFAULT'
    AND A.SOURE_IMPORT = H.SOURCE_IMPORT
    LEFT JOIN (
        SELECT
            N.SOURCE_IMPORT,
            M.CHG_CODE,
            M.CARD_CHANNEL_TYPE,
            M.CARD_TYPE,
            M.CARD_MODULE,
            M.CARD_SERVICE,
            M.CARD_PRODUCT,
            M.CARD_ISSUER
        FROM
            APPS.REF_CARD_BIN_MAP N,
            APPS.REF_CARD_CHG_CODE_MAP M
        WHERE
            N.TYPE_BIN = 'CHG_CODE'
        GROUP BY
            N.SOURCE_IMPORT,
            M.CHG_CODE,
            M.CARD_CHANNEL_TYPE,
            M.CARD_TYPE,
            M.CARD_MODULE,
            M.CARD_SERVICE,
            M.CARD_PRODUCT,
            M.CARD_ISSUER
    ) I ON A.SOURE_IMPORT = I.SOURCE_IMPORT
    AND A.CHG_CODE = I.CHG_CODE
    LEFT JOIN (
        SELECT
            CHG_CODE,
            PL_CATEGORY_NAME
        FROM
            APPS.REF_CARD_CHG_CODE_MAP
        WHERE
            NOT (
                CHG_CODE IN (
                    'THEVSDNTT',
                    'THETDKHAC',
                    'THEVSDNPOS',
                    'THEVSDNKHAC',
                    'THEJCBCLTG'
                )
                AND CHG_CODE_TYPE = 'CHI'
            )
    ) F ON A.CHG_CODE = F.CHG_CODE
    LEFT JOIN ETL.ORS_TR_KHACHHANG_ACTIVE_M G ON G.DATA_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD')
    AND A.MAKH = G.MAKH
    left join 
(select distinct linet24,chitieu from APPS.MB_MAP_TOI_LINE
where DATE_TX = to_date('${PRD_ID}','YYYYMMDD')
 )z
on a.line_gl = z.linet24
WHERE 
A.PARTITION_DATE = to_date('${PRD_ID}','YYYYMMDD')
and
EXISTS (SELECT T24_LINE 
FROM APPS.FIN_PNL_CARD_TXN_DAILY K 
WHERE K.TRANSACTION_DATE BETWEEN TRUNC(TO_DATE ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') AND TO_DATE ('${PRD_ID}', 'YYYYMMDD') 
and a.LINE_T24 = k.T24_LINE ) 
group by 
a.partition_date,
A.CHG_CODE,
F.PL_CATEGORY_NAME,
A.LINE_T24,
A.TK ,
a.ma_cn ,
a.acctnbr ,
a.Makh,
g.hoten ,
a.SECTOR,
a.pkkh,
a.khoi,
coalesce(b.CARD_CHANNEL_TYPE, c.CARD_CHANNEL_TYPE, d.CARD_CHANNEL_TYPE, e.CARD_CHANNEL_TYPE, h.CARD_CHANNEL_TYPE, i.CARD_CHANNEL_TYPE) ,
coalesce(b.CARD_TYPE, c.CARD_TYPE, d.CARD_TYPE, e.CARD_TYPE, h.CARD_TYPE, i.CARD_TYPE) ,
coalesce(b.CARD_MODULE, c.CARD_MODULE, d.CARD_MODULE, e.CARD_MODULE, h.CARD_MODULE, i.CARD_MODULE)  ,
coalesce(b.CARD_SERVICE, c.CARD_SERVICE, d.CARD_SERVICE, e.CARD_SERVICE, h.CARD_SERVICE, i.CARD_SERVICE) ,
coalesce(b.CARD_PRODUCT, c.CARD_PRODUCT, d.CARD_PRODUCT, e.CARD_PRODUCT, h.CARD_PRODUCT, i.CARD_PRODUCT) ,
coalesce(b.CARD_ISSUER, c.CARD_ISSUER, d.CARD_ISSUER, e.CARD_ISSUER, h.CARD_ISSUER, i.CARD_ISSUER) ,
a.SOURE_IMPORT ,
a.BIN6,
a.BIN8,
a.PRODUCT_CODE,
z.chitieu*/
SELECT
    A.PARTITION_DATE AS TRANSACTION_DATE,
    A.CHG_CODE AS CHG_CODE,
    F.PL_CATEGORY_NAME AS CHG_NAME,
    'VND' AS NTE,
    SUM(A.TIENNO_VND) AS CHG_AMT_FCY,
    SUM(A.TIENNO_VND) AS CHG_AMT_LCY,
    A.LINE_T24 AS T24_LINE,
    A.TK AS COA_CODE,
    A.MA_CN AS MA_CNC2,
    A.ACCTNBR AS PL_CATEGORY,
    A.MAKH AS MAKH,
    G.HOTEN AS TENKH,
    A.SECTOR AS SECTOR,
    A.PKKH AS PHAN_KHUC,
    A.KHOI AS KHOI,
    '' AS CONSOL_KEY,
    '' AS RM_CODE,
    COALESCE(
        B.CARD_CHANNEL_TYPE,
        C.CARD_CHANNEL_TYPE,
        D.CARD_CHANNEL_TYPE,
        E.CARD_CHANNEL_TYPE,
        H.CARD_CHANNEL_TYPE,
        I.CARD_CHANNEL_TYPE
    ) AS CARD_CHANNEL_TYPE,
    COALESCE(
        B.CARD_TYPE,
        C.CARD_TYPE,
        D.CARD_TYPE,
        E.CARD_TYPE,
        H.CARD_TYPE,
        I.CARD_TYPE
    ) AS CARD_TYPE,
    COALESCE(
        B.CARD_MODULE,
        C.CARD_MODULE,
        D.CARD_MODULE,
        E.CARD_MODULE,
        H.CARD_MODULE,
        I.CARD_MODULE
    ) AS CARD_MODULE,
    COALESCE(
        B.CARD_SERVICE,
        C.CARD_SERVICE,
        D.CARD_SERVICE,
        E.CARD_SERVICE,
        H.CARD_SERVICE,
        I.CARD_SERVICE
    ) AS CARD_SERVICE,
    COALESCE(
        B.CARD_PRODUCT,
        C.CARD_PRODUCT,
        D.CARD_PRODUCT,
        E.CARD_PRODUCT,
        H.CARD_PRODUCT,
        I.CARD_PRODUCT
    ) AS CARD_PRODUCT,
    COALESCE(
        B.CARD_ISSUER,
        C.CARD_ISSUER,
        D.CARD_ISSUER,
        E.CARD_ISSUER,
        H.CARD_ISSUER,
        I.CARD_ISSUER
    ) AS CARD_ISSUER,
    A.SOURE_IMPORT AS SOURCE_IMPORT,
    A.BIN6 AS BIN6,
    A.BIN8 AS BIN8,
    A.PRODUCT_CODE AS PRODUCT_CODE,
    Z.chitieu chitieu
FROM
    ETL.MPA_TONGHOP_CHIKD A
    LEFT JOIN APPS.REF_CARD_BIN_MAP B ON B.TYPE_BIN = 'BIN6'
    AND A.SOURE_IMPORT = B.SOURCE_IMPORT
    AND A.BIN6 = B.VALUE_BIN
    LEFT JOIN APPS.REF_CARD_BIN_MAP C ON C.TYPE_BIN = 'BIN6'
    AND C.VALUE_BIN IS NULL
    AND A.SOURE_IMPORT = C.SOURCE_IMPORT
    LEFT JOIN APPS.REF_CARD_BIN_MAP D ON D.TYPE_BIN = 'BIN8'
    AND A.SOURE_IMPORT = D.SOURCE_IMPORT
    AND A.BIN8 = D.VALUE_BIN
    LEFT JOIN APPS.REF_CARD_BIN_MAP E ON E.TYPE_BIN = 'BIN8'
    AND E.VALUE_BIN IS NULL
    AND A.SOURE_IMPORT = E.SOURCE_IMPORT
    LEFT JOIN APPS.REF_CARD_BIN_MAP H ON H.TYPE_BIN = 'DEFAULT'
    AND A.SOURE_IMPORT = H.SOURCE_IMPORT
    LEFT JOIN (
        SELECT
            N.SOURCE_IMPORT,
            M.CHG_CODE,
            M.CARD_CHANNEL_TYPE,
            M.CARD_TYPE,
            M.CARD_MODULE,
            M.CARD_SERVICE,
            M.CARD_PRODUCT,
            M.CARD_ISSUER
        FROM
            APPS.REF_CARD_BIN_MAP N,
            APPS.REF_CARD_CHG_CODE_MAP M
        WHERE
            N.TYPE_BIN = 'CHG_CODE'
        GROUP BY
            N.SOURCE_IMPORT,
            M.CHG_CODE,
            M.CARD_CHANNEL_TYPE,
            M.CARD_TYPE,
            M.CARD_MODULE,
            M.CARD_SERVICE,
            M.CARD_PRODUCT,
            M.CARD_ISSUER
    ) I ON A.SOURE_IMPORT = I.SOURCE_IMPORT
    AND A.CHG_CODE = I.CHG_CODE
    LEFT JOIN (
        SELECT
            CHG_CODE,
            PL_CATEGORY_NAME
        FROM
            APPS.REF_CARD_CHG_CODE_MAP
        WHERE
            NOT (
                CHG_CODE IN (
                    'THEVSDNTT',
                    'THETDKHAC',
                    'THEVSDNPOS',
                    'THEVSDNKHAC',
                    'THEJCBCLTG'
                )
                AND CHG_CODE_TYPE = 'CHIDV'
            )
    ) F ON A.CHG_CODE = F.CHG_CODE
    LEFT JOIN ETL.ORS_TR_KHACHHANG_ACTIVE_M G ON G.DATA_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD')
    AND A.MAKH = G.MAKH
    left join 
(select distinct linet24,chitieu from APPS.MB_MAP_TOI_LINE
where DATE_TX = to_date('${PRD_ID}','YYYYMMDD')
 )z
on a.line_gl = z.linet24
WHERE 
A.PARTITION_DATE = to_date('${PRD_ID}','YYYYMMDD')
and
EXISTS (SELECT T24_LINE 
FROM APPS.FIN_PNL_CARD_TXN_DAILY K 
WHERE K.TRANSACTION_DATE BETWEEN TRUNC(TO_DATE ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') AND TO_DATE ('${PRD_ID}', 'YYYYMMDD') 
and a.LINE_T24 = k.T24_LINE ) 
group by 
a.partition_date,
A.CHG_CODE,
F.PL_CATEGORY_NAME,
A.LINE_T24,
A.TK ,
a.ma_cn ,
a.acctnbr ,
a.Makh,
g.hoten ,
a.SECTOR,
a.pkkh,
a.khoi,
coalesce(b.CARD_CHANNEL_TYPE, c.CARD_CHANNEL_TYPE, d.CARD_CHANNEL_TYPE, e.CARD_CHANNEL_TYPE, h.CARD_CHANNEL_TYPE, i.CARD_CHANNEL_TYPE) ,
coalesce(b.CARD_TYPE, c.CARD_TYPE, d.CARD_TYPE, e.CARD_TYPE, h.CARD_TYPE, i.CARD_TYPE) ,
coalesce(b.CARD_MODULE, c.CARD_MODULE, d.CARD_MODULE, e.CARD_MODULE, h.CARD_MODULE, i.CARD_MODULE)  ,
coalesce(b.CARD_SERVICE, c.CARD_SERVICE, d.CARD_SERVICE, e.CARD_SERVICE, h.CARD_SERVICE, i.CARD_SERVICE) ,
coalesce(b.CARD_PRODUCT, c.CARD_PRODUCT, d.CARD_PRODUCT, e.CARD_PRODUCT, h.CARD_PRODUCT, i.CARD_PRODUCT) ,
coalesce(b.CARD_ISSUER, c.CARD_ISSUER, d.CARD_ISSUER, e.CARD_ISSUER, h.CARD_ISSUER, i.CARD_ISSUER) ,
a.SOURE_IMPORT ,
a.BIN6,
a.BIN8,
a.PRODUCT_CODE,
z.chitieu</sql>
