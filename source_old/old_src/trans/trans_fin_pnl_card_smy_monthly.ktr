    <connection>tckt_dc</connection>
    <sql>/*WITH CREDIT_CARD_PRODUCT AS (
  SELECT
    T24_CUSTOMER_CODE,
    CONTRACT_NAME,
    CONTRACT_NUMBER,
    PRODUCT_CODE,
    ROW_NUMBER () OVER (
      PARTITION BY CONTRACT_NUMBER
      ORDER BY
        DATE_OPEN DESC
    ) RANK_NUM,
    ROW_NUMBER () OVER (
      PARTITION BY T24_CUSTOMER_CODE,
      REGEXP_SUBSTR(CONTRACT_NUMBER, '[A-Z]+')
      ORDER BY
        DATE_OPEN DESC
    ) RANK_NUM_MAKH
  FROM
    ETL.ORS_NHS_KPI_CREDIT_CARD_NOW
)
select
  A.POSTDATE AS TRANSACTION_DATE,
  E.CHG_CODE AS CHG_CODE,
  E.DESCRIPTION AS CHG_NAME,
  'VND' AS NTE,
  sum(a.tienno) AS CHG_AMT_FCY,
  sum(a.tienno_vnd) AS CHG_AMT_LCY,
  A.LINE_T24 AS T24_LINE,
  A.GL AS COA_CODE,
  A.MA_CN AS MA_CNC2,
  A.ACCTNBR AS PL_CATEGORY,
  A.MAKH AS MAKH,
  NVL(C.CONTRACT_NAME, D.CONTRACT_NAME) AS TENKH,
  A.SECTOR AS SECTOR,
  '' AS PHAN_KHUC,
  A.KHOI AS KHOI,
  '' AS CONSOL_KEY,
  '' AS RM_CODE,
  E.CARD_CHANNEL_TYPE AS CARD_CHANNEL_TYPE,
  E.CARD_TYPE AS CARD_TYPE,
  E.CARD_MODULE AS CARD_MODULE,
  E.CARD_SERVICE AS CARD_SERVICE,
  E.CARD_PRODUCT AS CARD_PRODUCT,
  E.CARD_ISSUER AS CARD_ISSUER,
  A.SOURE_IMPORT AS SOURCE_IMPORT,
  '' AS BIN6,
  '' AS BIN8,
  A.PRODUCT_CODE AS PRODUCT_CODE,
  B.CHITIEU AS CHITIEU
from
  etl.mb_agg_thlk_toi_tmp1_dc A
  LEFT JOIN (
    SELECT
      DISTINCT LINET24,
      CHITIEU
    FROM
      APPS.MB_MAP_TOI_LINE
    where
      DATE_TX = to_date('${PRD_ID}', 'YYYYMMDD')
  ) B ON A.LINET24 = B.LINET24
  left join CREDIT_CARD_PRODUCT C on C.RANK_NUM = '1'
  and a.SCT = C.CONTRACT_NUMBER
  left join CREDIT_CARD_PRODUCT D on D.RANK_NUM_MAKH = '1'
  AND REGEXP_SUBSTR(A.SCT, '[A-Z]+') = REGEXP_SUBSTR(D.CONTRACT_NUMBER, '[A-Z]+')
  AND A.MAKH = D.T24_CUSTOMER_CODE
  left join APPS.REF_CARD_CHG_CODE_MAP E on a.soure_import = E.SOURCE_NAME
  and NVL(C.PRODUCT_CODE, D.PRODUCT_CODE) = E.Product_Code_way4
where
  a.SOURE_IMPORT in (
    'DC THOAI PHI THE TD',
    'DC THOAI LAI THE TD',
    'DC PHI TRA GOP'
  )
group by
  A.POSTDATE,
  E.CHG_CODE,
  E.DESCRIPTION,
  a.LINE_T24,
  a.Gl,
  a.ma_cn,
  a.acctnbr,
  a.MAKH,
  NVL(C.CONTRACT_NAME, D.CONTRACT_NAME),
  a.SECTOR,
  a.KHOI,
  E.CARD_CHANNEL_TYPE,
  E.CARD_TYPE,
  E.CARD_MODULE,
  E.CARD_SERVICE,
  E.CARD_PRODUCT,
  E.CARD_ISSUER,
  A.Product_Code,
  B.CHITIEU,
A.SOURE_IMPORT*/
WITH CREDIT_CARD_PRODUCT AS (
  SELECT
    T24_CUSTOMER_CODE,
    CONTRACT_NAME,
    CONTRACT_NUMBER,
    PRODUCT_CODE,
    ROW_NUMBER () OVER (
      PARTITION BY CONTRACT_NUMBER
      ORDER BY
        DATE_OPEN DESC
    ) RANK_NUM,
    ROW_NUMBER () OVER (
      PARTITION BY T24_CUSTOMER_CODE,
      REGEXP_SUBSTR(CONTRACT_NUMBER, '[A-Z]+')
      ORDER BY
        DATE_OPEN DESC
    ) RANK_NUM_MAKH
  FROM
    ETL.ORS_NHS_KPI_CREDIT_CARD_NOW
)
select
  A.POSTDATE AS TRANSACTION_DATE,
  E.CHG_CODE AS CHG_CODE,
  E.DESCRIPTION AS CHG_NAME,
  'VND' AS NTE,
  sum(a.tienno) AS CHG_AMT_FCY,
  sum(a.tienno_vnd) AS CHG_AMT_LCY,
  A.LINE_T24 AS T24_LINE,
  A.GL AS COA_CODE,
  A.MA_CN AS MA_CNC2,
  A.ACCTNBR AS PL_CATEGORY,
  A.MAKH AS MAKH,
  NVL(C.CONTRACT_NAME, D.CONTRACT_NAME) AS TENKH,
  A.SECTOR AS SECTOR,
  '' AS PHAN_KHUC,
  A.KHOI AS KHOI,
  '' AS CONSOL_KEY,
  '' AS RM_CODE,
  E.CARD_CHANNEL_TYPE AS CARD_CHANNEL_TYPE,
  E.CARD_TYPE AS CARD_TYPE,
  E.CARD_MODULE AS CARD_MODULE,
  E.CARD_SERVICE AS CARD_SERVICE,
  E.CARD_PRODUCT AS CARD_PRODUCT,
  E.CARD_ISSUER AS CARD_ISSUER,
  A.SOURE_IMPORT AS SOURCE_IMPORT,
  '' AS BIN6,
  '' AS BIN8,
  A.PRODUCT_CODE AS PRODUCT_CODE,
  B.CHITIEU AS CHITIEU
from
  etl.mb_agg_thlk_toi_tmp1_dc A
  LEFT JOIN (
    SELECT
      DISTINCT LINET24,
      CHITIEU
    FROM
      APPS.MB_MAP_TOI_LINE
    where
      DATE_TX = to_date('${PRD_ID}', 'YYYYMMDD')
  ) B ON A.LINET24 = B.LINET24
  left join CREDIT_CARD_PRODUCT C on C.RANK_NUM = '1'
  and a.SCT = C.CONTRACT_NUMBER
  left join CREDIT_CARD_PRODUCT D on D.RANK_NUM_MAKH = '1'
  AND REGEXP_SUBSTR(A.SCT, '[A-Z]+') = REGEXP_SUBSTR(D.CONTRACT_NUMBER, '[A-Z]+')
  AND A.MAKH = D.T24_CUSTOMER_CODE
  left join APPS.REF_CARD_CHG_CODE_MAP E on a.soure_import = E.SOURCE_NAME
  and NVL(C.PRODUCT_CODE, D.PRODUCT_CODE) = E.Product_Code_way4
where
  a.SOURE_IMPORT in (
    'DC THOAI PHI THE TD',
    'DC THOAI LAI THE TD',
    'DC PHI TRA GOP',
	'DC THOAI PHI THE TD TC',
	'DC THOAI LAI THE TD TC',
	'DC PHI TRA GOP TC'
  )
group by
  A.POSTDATE,
  E.CHG_CODE,
  E.DESCRIPTION,
  a.LINE_T24,
  a.Gl,
  a.ma_cn,
  a.acctnbr,
  a.MAKH,
  NVL(C.CONTRACT_NAME, D.CONTRACT_NAME),
  a.SECTOR,
  a.KHOI,
  E.CARD_CHANNEL_TYPE,
  E.CARD_TYPE,
  E.CARD_MODULE,
  E.CARD_SERVICE,
  E.CARD_PRODUCT,
  E.CARD_ISSUER,
  A.Product_Code,
  B.CHITIEU,
A.SOURE_IMPORT</sql>
