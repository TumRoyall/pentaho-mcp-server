  <step>
    <name>FIN_PNL_CARD_TXN_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>/*SELECT
    TO_DATE('${PRD_ID}', 'YYYYMMDD') AS TRANSACTION_DATE,
    A.CHG_CODE AS CHG_CODE,
    A.CHG_NAME AS CHG_NAME,
    A.NTE AS NTE,
    SUM(A.CHG_AMT_FCY) AS CHG_AMT_FCY,
    SUM(A.CHG_AMT_LCY) AS CHG_AMT_LCY,
    A.T24_LINE AS T24_LINE,
    A.COA_CODE AS COA_CODE,
    A.CN AS MA_CNC2,
    A.PL_CATEGORY AS PL_CATEGORY,
    A.MAKH AS MAKH,
    A.TENKH AS TENKH,
    A.SECTOR AS SECTOR,
    '' AS PHAN_KHUC,
    A.KHOI AS KHOI,
    A.CONSOL_KEY AS CONSOL_KEY,
    A.RM_CODE AS RM_CODE,
    A.CARD_CHANNEL_TYPE AS CARD_CHANNEL_TYPE,
    A.CARD_TYPE AS CARD_TYPE,
    A.CARD_MODULE AS CARD_MODULE,
    A.CARD_SERVICE AS CARD_SERVICE,
    A.CARD_PRODUCT AS CARD_PRODUCT,
    A.CARD_ISSUER AS CARD_ISSUER,
    'PNL_DAILY' AS SOURCE_IMPORT,
    '' AS BIN6,
    '' AS BIN8,
    '' AS PRODUCT_CODE,
	B.CHITIEU CHITIEU
FROM
    APPS.FIN_PNL_CARD_TXN_DAILY A
	LEFT JOIN (SELECT DISTINCT LINET24,CHITIEU FROM APPS.MB_MAP_TOI_LINE
where DATE_TX = to_date('${PRD_ID}','YYYYMMDD')
) B
ON SUBSTR(A.T24_LINE,7,6) = B.LINET24
WHERE
    TRANSACTION_DATE BETWEEN TRUNC (TO_DATE ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
    AND TO_DATE ('${PRD_ID}', 'YYYYMMDD')
    AND NOT EXISTS (
        SELECT
            B.SCT
        FROM
            ETL.FILE_BUTTOAN_LOAITRU_TOI B
        WHERE
            B.PARTITION_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD') AND A.TRANS_REF = B.SCT
    )
GROUP BY
    A.CHG_CODE,
    A.CHG_NAME,
    A.NTE,
    A.T24_LINE,
    A.COA_CODE,
    A.CN,
    A.PL_CATEGORY,
    A.MAKH,
    A.TENKH,
    A.SECTOR,
    A.KHOI,
    A.CONSOL_KEY,
    A.RM_CODE,
    A.CARD_CHANNEL_TYPE,
    A.CARD_TYPE,
    A.CARD_MODULE,
    A.CARD_SERVICE,
    A.CARD_PRODUCT,
    A.CARD_ISSUER,
	B.CHITIEU
*/
SELECT
    TO_DATE('${PRD_ID}', 'YYYYMMDD') AS TRANSACTION_DATE,
    A.CHG_CODE AS CHG_CODE,
    A.CHG_NAME AS CHG_NAME,
    A.NTE AS NTE,
    SUM(A.CHG_AMT_FCY) AS CHG_AMT_FCY,
    SUM(A.CHG_AMT_LCY) AS CHG_AMT_LCY,
    A.T24_LINE AS T24_LINE,
    A.COA_CODE AS COA_CODE,
    A.CN AS MA_CNC2,
    A.PL_CATEGORY AS PL_CATEGORY,
    A.MAKH AS MAKH,
    A.TENKH AS TENKH,
    A.SECTOR AS SECTOR,
    m.PHAN_KHUC AS PHAN_KHUC,
    A.KHOI AS KHOI,
    A.CONSOL_KEY AS CONSOL_KEY,
    A.RM_CODE AS RM_CODE,
    A.CARD_CHANNEL_TYPE AS CARD_CHANNEL_TYPE,
    A.CARD_TYPE AS CARD_TYPE,
    A.CARD_MODULE AS CARD_MODULE,
    A.CARD_SERVICE AS CARD_SERVICE,
    A.CARD_PRODUCT AS CARD_PRODUCT,
    A.CARD_ISSUER AS CARD_ISSUER,
    'PNL_DAILY' AS SOURCE_IMPORT,
    '' AS BIN6,
    '' AS BIN8,
    '' AS PRODUCT_CODE,
  B.CHITIEU CHITIEU

From APPS.FIN_PNL_CARD_TXN_DAILY A
LEFT JOIN (SELECT DISTINCT LINET24,CHITIEU FROM APPS.MB_MAP_TOI_LINE
            where DATE_TX = to_date('${PRD_ID}','YYYYMMDD')
            ) B
     ON SUBSTR(A.T24_LINE,7,6) = B.LINET24
LEFT JOIN APPS.FIN_SMY_CUSTOMER_MONTHLY m
     on m.transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')
and a.MAKH = m.MAKH
WHERE A.TRANSACTION_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MONTH') AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
/*AND DATA_SOURCE not in ('SMY.ACG_LINE_TXN_DAILY', 'BACKDATE')
AND NOT EXISTS 
(SELECT C.SCT 
FROM ETL.FILE_BUTTOAN_LOAITRU_TOI C
WHERE C.PARTITION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
AND C.SCT = A.TRANS_REF )*/

-- https://dichvunoibo.mbbank.com.vn/WorkOrder.do?woMode=viewWO&amp;woID=74448&amp;PORTALID=1
AND NOT
(EXISTS (SELECT C.SCT
  FROM ETL.FILE_TOI_BUTTOAN_LOAITRU C --ETL.FILE_BUTTOAN_LOAITRU_TOI C
  WHERE C.PARTITION_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD')
  AND A.TRANS_REF = C.SCT) 
OR (DATA_SOURCE in ('SMY.ACG_LINE_TXN_DAILY', 'BACKDATE'))
)

GROUP BY
    A.CHG_CODE,
    A.CHG_NAME,
    A.NTE,
    A.T24_LINE,
    A.COA_CODE,
    A.CN,
    A.PL_CATEGORY,
    A.MAKH,
    A.TENKH,
    A.SECTOR,
    m.PHAN_KHUC,
    A.KHOI,
    A.CONSOL_KEY,
    A.RM_CODE,
    A.CARD_CHANNEL_TYPE,
    A.CARD_TYPE,
    A.CARD_MODULE,
    A.CARD_SERVICE,
    A.CARD_PRODUCT,
    A.CARD_ISSUER,
  B.CHITIEU</sql>
