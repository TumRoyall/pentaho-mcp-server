  <step>
    <name>FTP_CUS</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>/*
WITH CREDIT_CARD_PRODUCT AS (
    SELECT
        T24_CUSTOMER_CODE,
        CONTRACT_NAME,
        CONTRACT_NUMBER,
        PRODUCT_CODE,
        ROW_NUMBER () OVER (
            PARTITION BY CONTRACT_NUMBER
            ORDER BY
                DATE_OPEN DESC
        ) RANK_NUM,
        ROW_NUMBER () OVER (
            PARTITION BY T24_CUSTOMER_CODE,
            regexp_substr(CONTRACT_NUMBER, '[A-Z]+')
            ORDER BY
                DATE_OPEN DESC
        ) RANK_NUM_MAKH
    FROM
        ETL.ORS_NHS_KPI_CREDIT_CARD_NOW
)
select
    A.TRANSACTION_DATE AS TRANSACTION_DATE,
    E.CHG_CODE AS CHG_CODE,
    E.DESCRIPTION AS CHG_NAME,
    A.NTE AS NTE,
    SUM(AMT_FTP) AS CHG_AMT_FCY,
    SUM(AMT_LCY) AS CHG_AMT_LCY,
    CONCAT('GLSCB.', LINE_GL) AS T24_LINE,
    '' AS COA_CODE,
    A.CN AS MA_CNC2,
    SUBSTR(MA_SP_FTP, 3, 5) AS PL_CATEGORY,
    A.MAKH AS MAKH,
    NVL(C.CONTRACT_NAME, D.CONTRACT_NAME) AS TENKH,
    A.SECTOR AS SECTOR,
    '' AS PHAN_KHUC,
    A.KHOI AS KHOI,
    '' AS CONSOL_KEY,
    '' AS RM_CODE,
    E.CARD_CHANNEL_TYPE AS CARD_CHANNEL_TYPE,
    E.CARD_TYPE AS CARD_TYPE,
    E.CARD_MODULE AS CARD_MODULE,
    E.CARD_SERVICE AS CARD_SERVICE,
    E.CARD_PRODUCT AS CARD_PRODUCT,
    E.CARD_ISSUER AS CARD_ISSUER,
    'FTP_CUS' AS SOURCE_IMPORT,
    '' AS BIN6,
    '' AS BIN8,
    A.PRODUCT_CODE AS PRODUCT_CODE,
    B.CHITIEU AS CHITIEU
FROM
    APPS.TR_FTP_CUS A
    LEFT JOIN (
        SELECT
            DISTINCT LINET24,
            CHITIEU
        FROM
            APPS.MB_MAP_TOI_LINE
        where
            DATE_TX = to_date('${PRD_ID}', 'YYYYMMDD')
    ) B ON A.LINE_GL = B.LINET24
    LEFT JOIN CREDIT_CARD_PRODUCT C ON C.RANK_NUM = '1'
    AND A.TAIKHOAN = C.CONTRACT_NUMBER
    LEFT JOIN CREDIT_CARD_PRODUCT D ON D.RANK_NUM_MAKH = '1'
    AND regexp_substr(A.TAIKHOAN, '[A-Z]+') = regexp_substr(D.CONTRACT_NUMBER, '[A-Z]+')
    AND A.MAKH = D.T24_CUSTOMER_CODE
    LEFT JOIN APPS.REF_CARD_CHG_CODE_MAP E ON E.SOURCE_NAME = 'FTP'
    AND NVL(C.PRODUCT_CODE, D.PRODUCT_CODE) = E.PRODUCT_CODE_WAY4
WHERE
    A.TRANSACTION_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD')
    AND EXISTS (
        SELECT
            FTP_PROD
        FROM
            APPS.FTP_MAPPING_TOI Z
        WHERE
            FTP_SOURCE = 'THE'
            AND A.FTP_CODE = Z.FTP_PROD
    )
GROUP BY
    A.TRANSACTION_DATE,
    A.PRODUCT_CODE,
    E.CHG_CODE,
    E.DESCRIPTION,
    A.NTE,
    A.LINE_GL,
    A.CN,
    SUBSTR(MA_SP_FTP, 3, 5),
    A.MAKH,
    NVL(C.CONTRACT_NAME, D.CONTRACT_NAME),
    A.SECTOR,
    A.KHOI,
    E.CARD_CHANNEL_TYPE,
    E.CARD_TYPE,
    E.CARD_MODULE,
    E.CARD_SERVICE,
    E.CARD_PRODUCT,
    E.CARD_ISSUER,
    B.CHITIEU*/

WITH CREDIT_CARD_PRODUCT AS (
    SELECT
        T24_CUSTOMER_CODE,
        CONTRACT_NAME,
        CONTRACT_NUMBER,
        PRODUCT_CODE,
        ROW_NUMBER () OVER (
            PARTITION BY CONTRACT_NUMBER
            ORDER BY
                DATE_OPEN DESC
        ) RANK_NUM,
        ROW_NUMBER () OVER (
            PARTITION BY T24_CUSTOMER_CODE,
            regexp_substr(CONTRACT_NUMBER, '[A-Z]+')
            ORDER BY
                DATE_OPEN DESC
        ) RANK_NUM_MAKH
    FROM
        ETL.ORS_NHS_KPI_CREDIT_CARD_NOW
)
select
    A.TRANSACTION_DATE AS TRANSACTION_DATE,
    E.CHG_CODE AS CHG_CODE,
    E.DESCRIPTION AS CHG_NAME,
    A.NTE AS NTE,
    SUM(AMT_FTP) AS CHG_AMT_FCY,
    SUM(AMT_LCY) AS CHG_AMT_LCY,
    CONCAT('GLSCB.', LINE_GL) AS T24_LINE,
    '' AS COA_CODE,
    A.CN AS MA_CNC2,
    SUBSTR(MA_SP_FTP, 3, 5) AS PL_CATEGORY,
    A.MAKH AS MAKH,
    NVL(C.CONTRACT_NAME, D.CONTRACT_NAME) AS TENKH,
    A.SECTOR AS SECTOR,
    '' AS PHAN_KHUC,
    A.KHOI AS KHOI,
    '' AS CONSOL_KEY,
    '' AS RM_CODE,
    E.CARD_CHANNEL_TYPE AS CARD_CHANNEL_TYPE,
    E.CARD_TYPE AS CARD_TYPE,
    E.CARD_MODULE AS CARD_MODULE,
    E.CARD_SERVICE AS CARD_SERVICE,
    E.CARD_PRODUCT AS CARD_PRODUCT,
    E.CARD_ISSUER AS CARD_ISSUER,
    'FTP_CUS' AS SOURCE_IMPORT,
    '' AS BIN6,
    '' AS BIN8,
    A.PRODUCT_CODE AS PRODUCT_CODE,
    B.CHITIEU AS CHITIEU
FROM
    APPS.TR_FTP_CUS A
    LEFT JOIN (
        SELECT
            DISTINCT LINET24,
            CHITIEU
        FROM
            APPS.MB_MAP_TOI_LINE
        where
            DATE_TX = to_date('${PRD_ID}', 'YYYYMMDD')
    ) B ON A.LINE_GL = B.LINET24
    LEFT JOIN CREDIT_CARD_PRODUCT C ON C.RANK_NUM = '1'
    AND A.TAIKHOAN = C.CONTRACT_NUMBER
    LEFT JOIN CREDIT_CARD_PRODUCT D ON D.RANK_NUM_MAKH = '1'
    AND regexp_substr(A.TAIKHOAN, '[A-Z]+') = regexp_substr(D.CONTRACT_NUMBER, '[A-Z]+')
    AND A.MAKH = D.T24_CUSTOMER_CODE
    LEFT JOIN APPS.REF_CARD_CHG_CODE_MAP E ON E.SOURCE_NAME = 'FTP'
    AND NVL(C.PRODUCT_CODE, D.PRODUCT_CODE) = E.PRODUCT_CODE_WAY4
WHERE
    A.TRANSACTION_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD')
    AND EXISTS (
        SELECT
            FTP_PROD
        FROM
            APPS.FTP_MAPPING_TOI Z
        WHERE
            FTP_SOURCE = 'THE'
            AND A.FTP_CODE = Z.FTP_PROD
    )
GROUP BY
    A.TRANSACTION_DATE,
    A.PRODUCT_CODE,
    E.CHG_CODE,
    E.DESCRIPTION,
    A.NTE,
    A.LINE_GL,
    A.CN,
    SUBSTR(MA_SP_FTP, 3, 5),
    A.MAKH,
    NVL(C.CONTRACT_NAME, D.CONTRACT_NAME),
    A.SECTOR,
    A.KHOI,
    E.CARD_CHANNEL_TYPE,
    E.CARD_TYPE,
    E.CARD_MODULE,
    E.CARD_SERVICE,
    E.CARD_PRODUCT,
    E.CARD_ISSUER,
    B.CHITIEU</sql>
