    <connection>tckt_dc</connection>
    <sql>select ma_cn,b.branch_name tencn,a.makh,c.hoten tenkh,c.cus_status, 
0 BT_KHAC_E17,
0 BT_XLN_E18,
0 CHIFTP_KHAC_B2,
0 CHIFTP_KHAC_K2,
0 CHIFTP_TINDUNG_B1,
0 CHIFTP_TRAIPHIEU_B3,
0 CHIFTP_TRAIPHIEU_K3,
0 CHIHD_G,
0 CHIHOATDONG,
0 CHILAI_FTP_B,
0 CHILAI_FTP_K,
0 CHILAI_FTP_TINDUNG_K1,
0 CHILAI_HUYDONG_C1,
0 CHILAI_KHAC_C2,
0 CHILAI_KH_C,
0 CHILAI_KH_L,
0 CHILAI_TRAIPHIEU_C3,
0 CHI_DP_F,
--a.CUS_STATUS,
0 DP_BL_F3,
0 DP_DAUTU_F1,
0 DP_K,
0 DP_LC_F2,
0 DP_TD_F4,
0 DTK_CHIFTP_E16,
0 DTK_THU_E15,
sum(tienno_vnd)  DTTSRR_I,
sum(tienno_vnd)  DTTSRR_P,
sum(tienno_vnd)  DTTTRR_I,
sum(tienno_vnd)  DTTTRR_P,
0 DV_BAOLANH_E1,
0 DV_COMMO_E13,
0 DV_GIUHO_E8,
0 DV_KHAC_E13,
0 DV_KIEUHOI_E9,
0 DV_NGANQUY_E7,
0 DV_NHDT_E10,
0 DV_THE_E4,
0 DV_TTQT_E2,
0 DV_TTTN_E3,
0 DV_TUVAN_E6,
sum(tienno_vnd)  DV_UTBHCK_E5,
0 FX_NTE_E14,
0 FX_NTE_E14A,
a.KHOI,
a.MAKH,
a.MA_CN,
'DCEB${PRD_ID}'NOTE,
0 PRODUCT_CODE,
0 SODU_VND_H,
--a.TENKH,
--a.TEN_CN,
0 THUFTP_DUPHONGKHAC_B3,
0 THUFTP_DUPHONGTD_B4,
0 THUFTP_DUPHONGTP_B4,
0 THUFTP_HUYDONG_D1,
0 THUFTP_KHAC_D2,
0 THUFTP_KHAC_M2,
0 THUHOATDONG,
0 THULAITHUAN_N,
0 THULAI_FTP_D,
0 THULAI_FTP_M,
0 THULAI_FTP_M1,
0 THULAI_KH_A,
0 THULAI_KH_J,
0 THULAI_TINDUNG_A1,
0 THULAI_TRAIPHIEU_A3,
0 THU_LAI_KHAC_A2,
0 THU_LAI_THUAN,
sum(tienno_vnd)  THU_NGOAI_LAI_E,
sum(tienno_vnd)  THU_NGOAI_LAI_O,
0 TOI,
0 TOI_CSTD,
a.partition_Date TRANSACTION_DATE
from apps.mb_agg_thlk_toi_eb a
left join apps.aict_branch b
on a.ma_cn= b.branch_code_t24
left join etl.ORS_TR_KHACHHANG c
on a.makh= c.makh
where partition_Date= to_date('${PRD_ID}','yyyyMMdd')
--and note= 'DCEB20190331'
group by ma_cn,b.branch_name,a.makh,c.hoten,c.cus_status,--note,
a.khoi,a.partition_date</sql>
