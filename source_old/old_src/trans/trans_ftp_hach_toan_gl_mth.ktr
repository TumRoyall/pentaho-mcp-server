    <sql>select 
  TO_DATE('${PRD_ID}','YYYYMMDD') + 1 as TRANSACTION_DATE,
  substr(CN,7,3) as CN,
  '00' as KHOI,
  '00' as PHONG,
  '00' as BP,
  GL_CREDIT as LINE,
  '00000' as SEG6,
  '0000000' as SEG7,
  '00' as SEG8,
  '00' as SEG9,
  '00' as SEG10,
  '0' as SEG11,
  NTE as NTE,
  sum(-FTP_SDC) as SOTIEN,
  'HT DC FTP '||TO_CHAR(TO_DATE('${PRD_ID}','YYYYMMDD')+1,'YYYYMMDD') as DIEN_GIAI,
  'BT REVERSE' as GHI_CHU
FROM APPS.FTP_TONGHOP ft 
WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}','YYYYMMDD')
GROUP BY 
  CN,
  KHOI,
  GL_CREDIT,
  NTE</sql>
