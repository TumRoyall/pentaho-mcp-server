  <step>
    <name>HT DC FTP-BT BACKDATE-DEBIT-MONTH</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select 
  TO_DATE('${PRD_ID}','YYYYMMDD') as TRANSACTION_DATE,
  substr(CN,7,3) as CN,
  '00' as KHOI,
  '00' as PHONG,
  '00' as BP,
  GL_DEBIT as LINE,
  '00000' as SEG6,
  '0000000' as SEG7,
  '00' as SEG8,
  '00' as SEG9,
  '00' as SEG10,
  '0' as SEG11,
  NTE as NTE,
  sum(-FTP_SDC) as SOTIEN,
  'HT DC FTP '||'${PRD_ID}' as DIEN_GIAI,
  'BT BACKDATE' as GHI_CHU
FROM APPS.FTP_TONGHOP ft 
WHERE TRANSACTION_DATE >= TRUNC(TO_DATE('${PRD_ID}','YYYYMMDD'),'MONTH') and TRANSACTION_DATE &lt;= TO_DATE('${PRD_ID}','YYYYMMDD')
GROUP BY 
  CN,
  KHOI,
  GL_DEBIT,
  NTE</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
