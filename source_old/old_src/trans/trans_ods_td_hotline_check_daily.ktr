    <connection>ods_dc</connection>
    <sql>SELECT
    TXN_DATE,
    DIVISION,
    T24_PARENT_BRANCH_MB_CODE,
    T24_PARENT_BRANCH_MB_NAME,
    T24_PARENT_BRANCH_SBV_CODE,
    T24_PARENT_BRANCH_SBV_NAME,
    BRANCH_NAME_CNC2,
    BRANCH_CODE_CNC2,
    CUSTOMER_TYPE,
    TERM_ID,
    PRODUCT_TYPE,
    PRODUCT_CODE,
    CATE,
    CAMPAIGN_CODE_VOUCHER,
    CAMPAIGN_CODE,
    SECTOR,
    BOOK_KEY,
    CURR,
    CODE_APP,
    INTEREST_RATE_KEY,
    VALUE_DATE,
    MATURITY_DATE,
    CUSTOMER_CODE,
    CUSTOMER_NAME,
    BALANCE,
    LCY_AMT,
    INTEREST_RATE_TYPE,
    INTEREST_RATE_TABLES,
    INTEREST_RATE_REGION,
    INTEREST_RATE_BOOKS,
    LS_DIFF,
    TYPE_ROLL,
    OPEN_DATE
FROM RPT.TD_HOTLINE_CHECK_DAILY
WHERE TXN_DATE =to_date('${PRD_ID}','yyyyMMdd')</sql>
    <limit>0</limit>
    <lookup/>
