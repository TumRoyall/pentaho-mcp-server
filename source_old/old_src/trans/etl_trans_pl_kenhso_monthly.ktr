    <sql>select TRANSACTION_DATE	TRANSACTION_DATE
,MAKH	CUST
,CN	SUB_BRANCH_CODE
,PRODUCT_CODE	PRODUCT_CODE
,KHOI_TRUOCCHIASE	SEGMENT_PRE_SHARING
,CHITIEU_PLKHOI	PL_CODE
,CHITIEU_PLKHOI_NAME	PL_LINE
,SPSO_TYPE	PRODUCT_GROUP
,PRODUCT_TYPE	PRODUCT_TYPE
,AMT_SAUCHIASE	AMT_AF_SHARING
,KHOI_SAUCHIASE	SEGMENT_AF_SHARING
,PHAN_KHUC	SECTOR
,CUS_STATUS	CUS_STATUS
,APP_BIZ_STATUS	APP_BIZ_STATUS
,TEN_CN	SUB_BRANCH_NAME
,CNC1	BRANCH_CODE
,TEN_CNC1	BRANCH_NAME
,TYLE_CHIASE	SHARING_PERCENTAGE
,SOTK	ACCOUNT_NUMBER
,CHG_CODE	CHG_CODE
,KHOI_KH	CUS_SECTOR
,SOURCE_TABLE	SOURCE_TABLE
,LINEGL	LINEGL
,PLCATEGORY	PLCATEGORY
,FTP_CODE	FTP_CODE
,DIGITAL_SERVICE_LV1	DIGITAL_SERVICE_LV1
,DIGITAL_SERVICE_LV2	DIGITAL_SERVICE_LV2
,SERVICE_PARTNER	SERVICE_PARTNER
,SERVICE_TELECOM	SERVICE_TELECOM
 from apps.FIN_PNL_KENHSO_MONTHLY
where transaction_date = to_date(${PRD_ID},'yyyymmdd')</sql>
