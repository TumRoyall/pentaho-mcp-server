    <connection>tckt_dc</connection>
    <sql>WITH ma_bcao_12m AS 
(
SELECT  SO_BAOCAO,ma_ts,count(1) SL
FROM APPS.FIN_KSS_TSDB_CHITIET_MONTHLY
WHERE transaction_date BETWEEN  trunc(add_months(to_date('${PRD_ID}','yyyymmdd'),-12),'mm')  and add_months(to_date('${PRD_ID}','yyyymmdd'),-1) 
GROUP BY so_baocao,ma_ts)
,
TONGHOP AS 
(
SELECT 
T1. TRANSACTION_DATE,
t1.THANG_DOISOAT,
t1.NGAY_DENGHI,
t1.NGAY_PHEDUYET,
t1.NGAY_THAMDINHGANNHAT,
t1.SO_BAOCAO,
t1.MA_TS,
t1.CNC1,
t1.CNC2,
t1.CANBO_DENGHI,
t1.LOAI_KH,
t1.KHOI,
t1.TEN_KH,
t1.LOAI_TS,
t1.LAN_THAMDINH,
t1.GIATRI_DINHGIA,
t1.PHI_DINHGIA,
t1.DONVI_DINHGIA,
t1.TRANGTHAI_HOSO,
t1.HT_COUNT_MATS,
t1.HT_MATS_SOBCAO,
--t1.HT_NGAYTHAMDINH_SKE_TSBD,
--t1.HT_MA_MD_TSBD,
t1.HT_NGAYNHAP_TSBD,
t1.HT_NGAY_DENGHI,
t1.HT_NGAY_PHE_DUYET,
t1.HT_NGAY_THAMDINH_GANNHAT,
t1.HT_SO_BAOCAO,
t1.HT_MA_TS,
t1.HT_CNC1,
t1.HT_CNC2,
t1.HT_KHOI,
t1.HT_TEN_KHACH_HANG,
t1.HT_LOAI_TS,
t1.HT_GIATRI_DINHGIA,
t1.HT_LAN_THAMDINH,
t1.HT_TYLE_PHI,
t1.HT_PHI,
t1.HT_PHI_DINHGIA,
t1.HT_TRANG_THAI_HS,
t1.HT_TRANG_THAI_TT,
--t1.HT_PHI_NGUON_IMPORT,
t1.SS_NGAY_DENGHI,
t1.SS_NGAY_PHEDUYET,
t1.SS_NGAY_THAMDINH_GANNHAT,
t1.SS_SO_BC,
t1.SS_MA_TS,
t1.SS_CNC1,
t1.SS_CNC2,
t1.SS_KHOI,
t1.SS_TEN_KH,
t1.SS_LOAI_TS,
t1.SS_GIATRI_DINHGIA,
t1.SS_LAN_THAMDINH,
t1.SS_PHI_DINHGIA,
t1.SS_PHI_DINHGIA_NGUON_IMPORT,
t1.SS_NGAY_NHAP_TSDB,
t1.thang_doisoat_char,
(CASE WHEN t1.HT_COUNT_MATS > 1 THEN 1 ELSE 0 END) TDTSBD_RL_01,
(CASE WHEN t1.so_baocao IN (SELECT so_baocao FROM ma_bcao_12m) THEN 1 ELSE 0 END) TDTSBD_RL_02,
(CASE   when  t1.HT_MATS_SOBCAO IS NOT NULL AND t1.HT_NGAYNHAP_TSBD IS NOT NULL 
      AND t1.HT_NGAYNHAP_TSBD - T1.NGAY_PHEDUYET &lt;= 90 AND t1.HT_NGAYNHAP_TSBD - T1.NGAY_PHEDUYET > 0  THEN 1 ELSE 0 END) TDTSBD_RL_03, 
(CASE   when  t1.HT_MATS_SOBCAO IS NOT NULL AND t1.HT_NGAYNHAP_TSBD IS NOT NULL 
      AND t1.HT_NGAYNHAP_TSBD - T1.NGAY_PHEDUYET > 90  THEN  1 ELSE 0 END)TDTSBD_RL_04, 
(CASE   WHEN t1.ma_ts IN (SELECT ma_ts FROM ma_bcao_12m) THEN 1 ELSE 0 END) TDTSBD_RL_05, 
(CASE   when  to_char(t1.ht_trang_thai_tt) =  'Chờ MB thanh toán' THEN 0 ELSE 1 END) TDTSBD_RL_06, 
(CASE   when  to_char(t1.NGAY_PHEDUYET,'mm') &lt;&gt; substr(t1.thang_doisoat,1,2) THEN 1 ELSE 0 END) TDTSBD_RL_07, 
(CASE   WHEN t1.SS_NGAY_DENGHI &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_08,
(CASE   WHEN t1.SS_NGAY_PHEDUYET &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_09,
(CASE   WHEN t1.SS_NGAY_THAMDINH_GANNHAT &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_10,
(CASE   WHEN t1.SS_SO_BC &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_11,
(CASE   WHEN t1.SS_MA_TS &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_12,
(CASE   WHEN t1.SS_CNC1 &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_13,
(CASE   WHEN t1.SS_CNC2 &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_14,
(CASE   WHEN t1.SS_KHOI &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_15,
(CASE   WHEN t1.SS_TEN_KH &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_16,
(CASE   WHEN t1.SS_LOAI_TS &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_17,
(CASE   WHEN t1.SS_GIATRI_DINHGIA &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_18,
(CASE   WHEN t1.SS_LAN_THAMDINH &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_19,
(CASE   WHEN t1.SS_PHI_DINHGIA &lt;&gt; 0 THEN 1 ELSE 0 END) TDTSBD_RL_20,
(CASE   WHEN t1.SS_PHI_DINHGIA_NGUON_IMPORT &lt;&gt; t1.SS_PHI_DINHGIA_NGUON_IMPORT THEN 1 ELSE 0 END) TDTSBD_RL_21,
(CASE   when  t1.HT_MATS_SOBCAO IS NOT NULL AND t1.HT_NGAYNHAP_TSBD IS NOT NULL 
      AND t1.HT_NGAYNHAP_TSBD - T1.NGAY_PHEDUYET &lt; 0  THEN 1 ELSE 0 END) TDTSBD_RL_22
FROM APPS.FIN_KSS_TSDB_CHITIET_MONTHLY t1
)
SELECT 
a.*,
r.rule_name,
sysdate date_time 
FROM 
(
SELECT * FROM TONGHOP
UNPIVOT(
VALUE FOR RULE_CODE IN (TDTSBD_RL_01,TDTSBD_RL_02,TDTSBD_RL_03,TDTSBD_RL_04,TDTSBD_RL_05,TDTSBD_RL_06,TDTSBD_RL_07,TDTSBD_RL_08,TDTSBD_RL_09,
TDTSBD_RL_10,TDTSBD_RL_11,TDTSBD_RL_12,TDTSBD_RL_13,TDTSBD_RL_14,TDTSBD_RL_15,TDTSBD_RL_16,TDTSBD_RL_17,TDTSBD_RL_18,TDTSBD_RL_19,TDTSBD_RL_20, TDTSBD_RL_21,TDTSBD_RL_22)
)
WHERE VALUE &lt;&gt; 0 
) a 
LEFT JOIN etl.FILE_REF_KSS_RULES r 
ON a.rule_code =r.rule_code</sql>
    <limit>0</limit>
