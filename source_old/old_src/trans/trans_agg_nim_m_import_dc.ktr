  <step>
    <name>file_dieuchinh_nim_loan_monthly</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select nim.transaction_date,
nim.d_type,
nim.taikhoan,
nim.makh,
nim.nte,
nim.cn,
nvl(loan.mbld_type,dep.mbld_type) mbld_type,
nvl(loan.product_code,dep.product_code) product_code,
nvl(loan.productgr_code,dep.productgr_code) productgr_code,
nvl(loan.category,dep.category) category,
nvl(loan.sub_product,dep.sub_product) sub_product,
nvl(loan.loc_term,dep.sub_product) loc_term,
nvl(loan.loaikyhan,dep.loaikyhan) loaikyhan,
nvl(loan.sector,dep.sector) sector,
nvl(loan.nhomno_xhtd,dep.nhomno_xhtd) nhomno_xhtd,
nvl(loan.nhomno_liendoi,dep.nhomno_liendoi) nhomno_liendoi,
nim.khoi,
0 balance,
0 balance_vnd,
0 nominal_interest,
0 nominal_interest_vnd,
nim.real_interest_vnd real_interest,
nim.real_interest_vnd,
0 penalty_interest,
0 penalty_interest_vnd,
nim.interest_ftp_vnd interest_ftp,
nim.interest_ftp_vnd,
0 interest_ftp_tt,
0 interest_ftp_tt_vnd,
nvl(loan.ftp_code,dep.ftp_code) ftp_code,
'DC_THUCONG' NOTE
from etl.file_dieuchinh_nim_loan_monthly nim
left join etl.etl_tmp_loan_info loan
on nim.d_type = 'LOAN'
and nim.taikhoan = loan.taikhoan
left join etl.etl_tmp_deposit_info dep
on nim.d_type = 'DEPOSIT'
and nim.taikhoan = dep.taikhoan
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
