  <step>
    <name>CP BHTG1</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with v_data as (
  select 
    (a.date_tx+1) date_apply,
    a.ccy,
    case when a.cus_type= 'CN' THEN SUM(A.aMOUNT) ELSE 0 END INDIV_AMOUNT,
    case when a.cus_type= 'DN' THEN SUM(A.aMOUNT) ELSE 0 END GROUP_AMOUNT,
    a.date_tx
  from apps.ftp_hdv_bq_cp_BHTG a 
  where a.date_tx= (trunc(to_date(${PRD_ID},'yyyyMMdd'),'MONTH') -1)
  and a.ccy='VND'
  GROUP BY a.date_tx,a.cus_type,a.ccy
),
v_agg as (
  select 
    x.date_apply,
    x.ccy,
    sum(x.INDIV_AMOUNT) INDIV_AMOUNT,
    sum(x.GROUP_AMOUNT) GROUP_AMOUNT,
    sum(x.INDIV_AMOUNT)+ sum(x.GROUP_AMOUNT) total,
    round((sum(x.INDIV_AMOUNT) * 100/ (sum(x.INDIV_AMOUNT)+ sum(x.GROUP_AMOUNT) )),2) indiv_ratio,
    round((sum(x.GROUP_AMOUNT) * 100/ (sum(x.INDIV_AMOUNT)+ sum(x.GROUP_AMOUNT) )),2) group_ratio,
    x.date_tx  
  from v_data x
  group by x.date_apply,x.ccy,x.date_tx
)
select 
  y.date_apply,
  y.ccy,y.indiv_Amount,
  y.group_amount,
  y.total,
  y.indiv_Ratio,
  y.group_ratio,
  round(((0.15* y.indiv_Ratio)/100  +  0*  y.group_ratio ),2)tile_bhtg,
  Y.date_tx
from v_agg y</sql>
    <limit>0</limit>
