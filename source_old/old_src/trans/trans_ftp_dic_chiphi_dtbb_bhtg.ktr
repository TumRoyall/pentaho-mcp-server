  <step>
    <name>HD BQ CP DTBB 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with v_saoke_other as (
  select 
  (trunc(to_date(${PRD_ID},'yyyyMMdd'),'MONTH') -1) transaction_Date,
  b.*  
  from apps.FTP_TR_saoke_other b
  where b.date_tx = (
        select max(c.date_tx) from apps.FTP_TR_saoke_other c 
        where  c.date_tx &lt; to_date(${PRD_ID},'yyyyMMdd') 
  )
                 
),
v_data as (
   select 
     a.date_tx,
     a.thang_bc,
     a.ccy,
     case when a.kyhan='DUOI_12T' THEN A.AMOUNT ELSE 0 END AMOUNT_LE12,
     case when a.kyhan='TREN_12T' THEN A.AMOUNT ELSE 0 END AMOUNT_GT12,
     B.TYLE_DTBB_LE12,
     B.TYLE_DTBB_GT12,
     B.LS_DTBB_LE12,
     B.LS_DTBB_GT12,
     B.LS_KYHAN_TK LSLNH       
   from apps.ftp_hdv_bq_cp_dtbb a 
   join  v_saoke_other b 
   on a.date_tx = b.transaction_Date  and a.ccy = b.curr
   WHERE A.DATE_TX = (trunc(to_date(${PRD_ID},'yyyyMMdd'),'MONTH') -1)
),
v_agg as (
   SELECT 
      X.date_tx,
      X.thang_bc,
      X.ccy,
      ROUND(100*( SUM(X.AMOUNT_LE12) * (X.TYLE_DTBB_LE12/100) +  SUM(X.AMOUNT_GT12) * (X.TYLE_DTBB_GT12/100))/ (SUM(X.AMOUNT_LE12) +  SUM(X.AMOUNT_GT12)),2) TI_TRONG,
      X.TYLE_DTBB_LE12,
      X.TYLE_DTBB_GT12,
      X.LS_DTBB_LE12,
      X.LS_DTBB_GT12,
      X.LSLNH 
   FROM v_data X    
   GROUP BY X.date_tx,
       X.thang_bc,
       X.ccy,
       X.TYLE_DTBB_LE12,
       X.TYLE_DTBB_GT12,
       X.LS_DTBB_LE12,
       X.LS_DTBB_GT12,
       X.LSLNH
)
SELECT 
   X.date_tx,
   X.thang_bc,
   X.ccy,
   X.TI_TRONG,
   X.TYLE_DTBB_LE12,
   X.TYLE_DTBB_GT12,
   X.LS_DTBB_LE12,
   X.LS_DTBB_GT12,
   X.LSLNH,
   case 
     when round((X.TI_TRONG *( X.LSLNH - x.ls_dtbb_le12) / (100 - X.TI_TRONG)),2)>0 then 
          round((X.TI_TRONG *( X.LSLNH - x.ls_dtbb_le12) / (100 - X.TI_TRONG)),2)
     else 0 
   end cp_dtbb
FROM v_agg X</sql>
    <limit>0</limit>
