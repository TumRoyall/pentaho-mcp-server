  <order>
    <hop>
      <from>NEW 2</from>
      <to>TMP_CHI_PHI_CIC</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>NEW 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>select
    nvl(
        coalesce(b1.id, b2.id, b3.id),
        case
            when (
                a.DIVISION_CODE = 'KHCN'
                or upper(a.DIVISION_CODE) = 'TT THE'
            ) then '1700'
            when a.DIVISION_CODE = 'CIB' then '3000'
            when a.DIVISION_CODE = 'SME' then '1000'
            when UPPER(a.DIVISION_CODE) in ('NGAN HANG SO', 'NHS') then '1910'
            when a.DIVISION_CODE = 'FI' then '8000'
        end
    ) makh,
    NVL(
        coalesce(b1.KHOI, b2.khoi, b3.khoi),
        a.division_code
    ) khoi,
    a.TXN_DATE,
    a.TXN_MONTH,
    a.CIC_TICKET_ID,
    a.USER_CODE,
    a.CIC_CODE,
    a.USER_NAME,
    a.CIC_FULL_NAME,
    a.CIC_ADDRESS,
    a.REQUEST_DATE,
    a.RESPONSE_DATE,
    a.CIC_SEEKING_FEE_AMT,
    a.CREDIT_INSTITUTION_CODE,
    a.PRODUCT_CODE,
    a.PRODUCT_NAME,
    a.TAX_TYPE_CODE,
    a.CURRENCY_CODE,
    a.CONTRACT_TYPE,
    --a.TAX_NBR,
    a.USER_MB,
    a.GL_PARENT_BRANCH_SBV_CODE,
    a.BRANCH_CODE,
    a.GL_PARENT_BRANCH_SBV_NAME,
    a.BRANCH_NAME,
    a.DIVISION_CODE,
    case
        when UPPER(a.DIVISION_CODE) in('NGAN HANG SO', 'NHS') then 'NHS'
        when a.DIVISION_CODE = 'CIB' then 'CIB'
        when a.DIVISION_CODE = 'SME' then 'SME'
        when UPPER(a.DIVISION_CODE) in ('KHCN', 'TT THE') then 'INDIV'
        when a.DIVISION_CODE = 'FI' then 'FI'
    end KHOI_CHOT,
    '68086' PL_CATEGORY,
    case
        when upper(a.division_code) = 'TT THE' then '26111'
        else '27999'
    end PRODUCT_CODE
from
     /*( select * from ext.FILE_CIC_SEEKING_COST_his
			where txn_date  = '31jan26'
			union all
		select * from ext.FILE_CIC_SEEKING_COST
			where txn_date  = '28feb26')*/  ext.FILE_CIC_SEEKING_COST a
    left join (
        select
            id,
            national_id,
            khoi,
            row_number() over (
                partition by national_id
                order by
                    record_committed_time desc
            ) rnk
        from
            STG.T24_T24CORE_CUSTOMER
    ) b1 on b1.rnk = 1
    and a.TAX_NBR = b1.NATIONAL_ID
    left join (
        select
            id,
            ESTAB_LIC_CODE,
            khoi,
            row_number() over (
                partition by ESTAB_LIC_CODE
                order by
                    record_committed_time desc
            ) rnk
        from
            STG.T24_T24CORE_CUSTOMER
    ) b2 on b2.rnk = 1
    and a.TAX_NBR = b2.ESTAB_LIC_CODE
    left join (
        select
            id,
            VAT_INV_SERIAL,
            khoi,
            row_number() over (
                partition by VAT_INV_SERIAL
                order by
                    record_committed_time desc
            ) rnk
        from
            STG.T24_T24CORE_CUSTOMER
    ) b3 on b3.rnk = 1
    and a.TAX_NBR = b3.VAT_INV_SERIAL
where txn_date = add_months(to_date('${PRD_ID}','yyyyMMdd'),-1)</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
