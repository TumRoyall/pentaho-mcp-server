    <connection>ors_dc</connection>
    <sql>select 
t.soso taikhoan,
null as mbld_type,
t.product_code,
null as productgr_code,
t.nhomsp category,
null as sub_product,
(t.kyhan /30) loc_term,
'CKH' loaikyhan,
t.sector,
null as nhomno_xhtd,
null as nhomno_liendoi,
t.ftp_code
from 
(select y.soso,y.product_code,y.nhomsp,y.kyhan,y.sector,y.ftp_code,
dense_rank () over (partition by y.soso order by y.transaction_date desc) stt
from (select b.soso,b.product_code,b.nhomsp,b.kyhan,b.sector, transaction_date,b.ftp_code
from tr_tk b
where b.transaction_date = 
(select max(dayid) from apps.mb_dim_time where dayid &lt;=to_date(${PRD_ID},'yyyyMMdd') and is_working_day=1)
and substr (b.gl,1,2) in ('40', '42', '43')
and b.soso &lt;&gt; 'ORS_STK'
union all
select c.soso,c.product_code,c.nhomsp,c.kyhan,c.sector,transaction_date,''ftp_code from apps.mb_tr_tk_tattoan c
where c.transaction_date>= add_months(to_date(${PRD_ID},'yyyyMMdd')+1,-2)
and c.transaction_Date&lt;= to_date(${PRD_ID},'yyyyMMdd')
and substr (c.gl,1,2) in ('40', '42', '43')
and c.soso &lt;&gt; 'ORS_STK'
) y) t
where t.stt=1</sql>
    <limit>0</limit>
