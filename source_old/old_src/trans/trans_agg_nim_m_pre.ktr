    <connection>ors_dc</connection>
    <sql>/*select 
acc taikhoan,
null as mbld_type,
x.product_code,
null as productgr_code,
x.nhomsp category,
null as sub_product,
round ((x.kyhan /30),0) loc_term,
'KKH' loaikyhan,
x.sector,
null as nhomno_xhtd,
null as nhomno_liendoi,
x.ftp_code
from 
(select dense_rank () over (partition by a.acc order by a.transaction_date desc) stt, a.*
from tr_tg  partition for (to_date(${PRD_ID},'yyyyMMdd')) a
--where a.transaction_date >= add_months(to_date(${PRD_ID},'yyyyMMdd')+1,-2) and a.transaction_date &lt;= to_date(${PRD_ID},'yyyyMMdd')
where substr (a.gl,1,2) in ('40', '42', '43')
and a.acc &lt;&gt; 'ORS_STK'
) x
where x.stt = 1*/

with v_temp as(
select *
  from tr_tg  partition for (to_date(${PRD_ID},'yyyyMMdd')) 
  --where a.transaction_date >= add_months(to_date(${PRD_ID},'yyyyMMdd')+1,-2) and a.transaction_date &lt;= to_date(${PRD_ID},'yyyyMMdd')
  where substr (gl,1,2) in ('40', '42', '43')
  and acc &lt;&gt; 'ORS_STK'
  union all
  select *
  from tr_tg  partition for (add_months(to_date(${PRD_ID},'yyyyMMdd'),-1)) 
  --where a.transaction_date >= add_months(to_date(${PRD_ID},'yyyyMMdd')+1,-2) and a.transaction_date &lt;= to_date(${PRD_ID},'yyyyMMdd')
  where substr (gl,1,2) in ('40', '42', '43')
  and acc &lt;&gt; 'ORS_STK'
)
select 
acc taikhoan,
null as mbld_type,
x.product_code,
null as productgr_code,
x.nhomsp category,
null as sub_product,
round ((x.kyhan /30),0) loc_term,
'KKH' loaikyhan,
x.sector,
null as nhomno_xhtd,
null as nhomno_liendoi,
x.ftp_code
from 
(select dense_rank () over (partition by a.acc order by a.transaction_date desc) stt, a.*
from 
  v_temp a
) x
where x.stt = 1</sql>
