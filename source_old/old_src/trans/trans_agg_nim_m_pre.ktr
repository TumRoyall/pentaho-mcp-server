  <step>
    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select 
(case when x.soku like 'PD%' then substr (x.soku,1,14) else x.soku end) taikhoan,
x.mbld_type,
x.product_code,
x.productgr_code,
x.mjacctcd category,
x.miacctcd sub_product,
(case when to_number (x.mjacctcd) &lt; 10000 then 12 else to_number(x.kyhan) end) loc_term,
(case 
when to_number (x.mjacctcd) &lt; 10000 then 'NH'
when to_number (x.kyhan) &lt;=12 then 'NH'
when (to_number (x.kyhan) >12 and to_number (x.kyhan) &lt;= 60) then 'TH'
else 'DH' end) loaikyhan,
x.sector,
x.nhomno2 nhomno_xhtd,
x.nhomno nhomno_liendoi,x.khoi,x.product_type,x.project_id from apps.tr_ku_m x
where transaction_date= to_date(${PRD_ID},'yyyyMMdd')
group by (case when x.soku like 'PD%' then substr (x.soku,1,14) else x.soku end) ,
x.mbld_type,
x.product_code,
x.productgr_code,
x.mjacctcd ,
x.miacctcd ,
(case when to_number (x.mjacctcd) &lt; 10000 then 12 else to_number(x.kyhan) end) ,
(case 
when to_number (x.mjacctcd) &lt; 10000 then 'NH'
when to_number (x.kyhan) &lt;=12 then 'NH'
when (to_number (x.kyhan) >12 and to_number (x.kyhan) &lt;= 60) then 'TH'
else 'DH' end) ,
x.sector,
x.nhomno2 ,
x.nhomno,x.khoi,x.product_type,x.project_id</sql>
    <limit>0</limit>
    <lookup/>
