  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT   COALESCE (tmp1.transaction_date, tmp2.transaction_date)
             transaction_date,
         COALESCE (tmp1.d_type, tmp2.d_type) d_type,
         COALESCE (tmp1.sotk, tmp2.taikhoan) taikhoan,
         COALESCE (tmp1.makh, tmp2.makh) makh,
         COALESCE (tmp1.nte, tmp2.nte) nte,
         COALESCE (tmp1.cn, tmp2.cn) cn,
         COALESCE (tmp1.khoi, tmp2.khoi) khoi,
         COALESCE (tmp1.balance, 0) balance,
         COALESCE (tmp1.balance_vnd, 0) balance_vnd,
         COALESCE (tmp1.nominal_interest, 0) nominal_interest,
         COALESCE (tmp1.nominal_interest_vnd, 0) nominal_interest_vnd,
         COALESCE (tmp1.real_interest, 0) real_interest,
         COALESCE (tmp1.real_interest_vnd, 0) real_interest_vnd,
         COALESCE (tmp1.penalty_interest, 0) penalty_interest,
         COALESCE (tmp1.penalty_interest_vnd, 0) penalty_interest_vnd,
         COALESCE (tmp2.interest_ftp, 0) interest_ftp,
         COALESCE (tmp2.interest_ftp_vnd, 0) interest_ftp_vnd,
         COALESCE (tmp2.interest_ftp_tt, 0) interest_ftp_tt,
         COALESCE (tmp2.interest_ftp_tt_vnd, 0) interest_ftp_tt_vnd
  FROM     etl.etl_tmp_nim_interest tmp1
          FULL JOIN
              (  SELECT   to_date(a.transaction_date,'yyyyMMdd') transaction_date,
                          a.d_type,
                          a.taikhoan,
                          a.makh,
                          a.nte,
                          a.cn,
                          a.khoi,
                          SUM (amt_ftp) interest_ftp,
                          SUM (amt_lcy) interest_ftp_vnd,
                          SUM (amt_ftp_tt) interest_ftp_tt,
                          SUM (amt_lcy_tt) interest_ftp_tt_vnd
                   FROM  etl.etl_tmp_nim_ftpcus a
               GROUP BY   to_date(a.transaction_date,'yyyyMMdd'),
                          a.d_type,
                          a.taikhoan,
                          a.makh,
                          a.nte,
                          a.cn,
                          a.khoi) 
                          tmp2
          ON     tmp1.transaction_date = tmp2.transaction_date
             AND tmp1.d_type = tmp2.d_type
             AND tmp1.sotk = tmp2.taikhoan
             AND tmp1.makh = tmp2.makh
             AND tmp1.nte = tmp2.nte
             AND tmp1.cn = tmp2.cn
             AND tmp1.khoi = tmp2.khoi
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
