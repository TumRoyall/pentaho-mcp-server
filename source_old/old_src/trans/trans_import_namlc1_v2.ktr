  </step>
  <step>
    <name>Table input 3 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT CASE
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           A.Y_DR_KHOI
          WHEN (A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_CR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           A.Y_CR_KHOI
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR') THEN
           'NHS'
       END KHOI
      ,CASE
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           'CHI'
          WHEN (A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_CR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           'THU'
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR') THEN
           'THU'
       END LOAI_GD
      ,CASE
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           A.DR_CUS
          WHEN (A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_CR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           A.CR_CUS
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR') THEN
           '1910'
       END MAKH
      ,A.CO_CODE
      ,A.CHANNEL
      ,A.FT_TYPE
      ,A.PAYMENT_SYSTEM
      ,COUNT(A.FT_ID) SLGD
      ,A.PARTITION_DATE AS TRANSACTION_DATE
      ,B.PAYMENT_SYSTEM_NAME
      ,B.CHG_CODE CHG_CODE
      ,B.DON_GIA DON_GIA
      ,B.DON_GIA * COUNT(A.FT_ID) SOTIEN
      ,C.PRODUCT_CODE
      ,C.CATEGORY_ACCOUNT ACCTNBR
  FROM SMY.FT_ENTRY A
  LEFT JOIN ETL.REF_PAYMENT_SYSTEM_CHG_CODE_MAP B
    ON A.PAYMENT_SYSTEM = B.PAYMENT_SYSTEM
   AND (CASE
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           'CHI'
          WHEN (A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_CR_KHOI &lt;&gt; 'CUS.ERR - KHOI.ERR') THEN
           'THU'
          WHEN (A.Y_CR_KHOI = 'CUS.ERR - KHOI.ERR' AND A.Y_DR_KHOI = 'CUS.ERR - KHOI.ERR') THEN
           'THU'
       END) = B.LOAI_GD
  LEFT JOIN ETL.ODS_T24_CAL_COMMISSION_TYPE_MAPHI_CHIDV C
    ON B.CHG_CODE = C.ID
 WHERE A.PARTITION_DATE BETWEEN TO_DATE('${FIRST_DATA_DAY}', 'yyyymmdd') AND
       TO_DATE('${LAST_DATA_DAY}', 'yyyymmdd')
   AND A.PAYMENT_SYSTEM IN ('13', '14', '15')
 GROUP BY A.Y_DR_KHOI
         ,A.Y_CR_KHOI
         ,A.DR_CUS
         ,A.CR_CUS
         ,A.CO_CODE
         ,A.CHANNEL
         ,A.FT_TYPE
         ,A.PAYMENT_SYSTEM
		 ,A.PARTITION_DATE
         ,B.PAYMENT_SYSTEM_NAME
         ,B.CHG_CODE
         ,B.DON_GIA
         ,C.PRODUCT_CODE
         ,C.CATEGORY_ACCOUNT</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
