               'A11351' A11351,
               'A113523' A113523,
               'A12122' A12122,
               'A12131' A12131,
               'A2101' A2101,
               'A2102' A2102,
               'A211' A211,
               'A2141' A2141,
               'A21471' A21471,
               'G25' G25,
               'A31' A31,
               'A32' A32,
               'A3211' A3211,
               'A3222' A3222,
               'A12213' A12213,
               'A1222' A1222,
               'A1224' A1224,
               'A12311' A12311,
               'A12321' A12321,
               'A1312' A1312,
               'A354' A354,
               'A355' A355,
               'A356' A356,
               'A36' A36,
               'A452' A452,
               'A512' A512,
               'A521' A521,
               'A524' A524,
               'B2' B2,
               'A13432' A13432,
               'B24' B24,
               'E' E,
               'F' F,
               'G' G,
               'D422' D422,
               'D421' D421,
               'D4' D4,
               'D3' D3,
               'D2' D2,
               'D1' D1))),
TMP_FIN_GIAO_BAN AS
 (SELECT TRANSACTION_DATE, MA_CN, MA_CT, LINE, VALUE
    FROM TMP_GIAO_BAN UNPIVOT(VALUE FOR MA_CT IN(DOANH_THU_THUAN AS
                                                 'DOANH_THU_THUAN',
                                                 THU_THUAN_KINH_DOANH AS
                                                 'THU_THUAN_KINH_DOANH',
                                                 THU_LAI AS 'THU_LAI',
                                                 THU_THUAN_TIN_DUNG AS
                                                 'THU_THUAN_TIN_DUNG',
                                                 THU_LAI_TIN_DUNG AS
                                                 'THU_LAI_TIN_DUNG',
                                                 CHI_LAI_MUA_VON AS
                                                 'CHI_LAI_MUA_VON',
                                                 THU_TUONG_TU_LAI AS
                                                 'THU_TUONG_TU_LAI',
                                                 THU_CHIA_SE_NHS AS
                                                 'THU_CHIA_SE_NHS',
                                                 THU_THUAN_TRAI_PHIEU AS
                                                 'THU_THUAN_TRAI_PHIEU',
                                                 THU_LAI_TRAI_PHIEU AS
                                                 'THU_LAI_TRAI_PHIEU',
                                                 CHI_LAI_MUA_VON_TP AS
                                                 'CHI_LAI_MUA_VON_TP',
                                                 THU_THUAN_HUY_DONG AS
                                                 'THU_THUAN_HUY_DONG',
                                                 THU_LAI_FTP AS
                                                 'THU_LAI_FTP',
                                                 THU_LAI_FTP_KKH AS
                                                 'THU_LAI_FTP_KKH',
                                                 THU_LAI_FTP_CKH AS
                                                 'THU_LAI_FTP_CKH',
                                                 CHI_LAI_HUY_DONG AS
                                                 'CHI_LAI_HUY_DONG',
                                                 CHI_LAI_KKH AS
                                                 'CHI_LAI_KKH',
                                                 CHI_LAI_CKH AS
                                                 'CHI_LAI_CKH',
                                                 CHI_TUONG_TU_LAI AS
                                                 'CHI_TUONG_TU_LAI',
                                                 CHI_CHIA_SE_NHS AS
                                                 'CHI_CHIA_SE_NHS',
                                                 THU_DIEU_HOA_VON AS
                                                 'THU_DIEU_HOA_VON',
                                                 THU_NGOAI_LAI AS
                                                 'THU_NGOAI_LAI',
                                                 THU_THUAN_BAO_LANH AS
                                                 'THU_THUAN_BAO_LANH',
                                                 THU_THUAN_DICH_VU AS
                                                 'THU_THUAN_DICH_VU',
                                                 THU_THUAN_TTQT AS
                                                 'THU_THUAN_TTQT',
                                                 THU_THUAN_CHUYEN_TIEN AS
                                                 'THU_THUAN_CHUYEN_TIEN',
                                                 THU_THUAN_THE AS
                                                 'THU_THUAN_THE',
                                                 THU_THUAN_LK_DOI_TAC AS
                                                 'THU_THUAN_LK_DOI_TAC',
                                                 THU_THUAN_TU_VAN_IB AS
                                                 'THU_THUAN_TU_VAN_IB',
                                                 THU_THUAN_BAO_HIEM AS
                                                 'THU_THUAN_BAO_HIEM',
                                                 THU_THUAN_TKSD AS
                                                 'THU_THUAN_TKSD',
                                                 THU_THUAN_KHAC AS
                                                 'THU_THUAN_KHAC',
                                                 THU_FX_PS_VANG AS
                                                 'THU_FX_PS_VANG',
                                                 THU_TP_THU_CAP AS
                                                 'THU_TP_THU_CAP',
                                                 THU_TU_HDKD_KHAC AS
                                                 'THU_TU_HDKD_KHAC',
                                                 THU_NO_NGOAI_BANG AS
                                                 'THU_NO_NGOAI_BANG',
                                                 CHI_DP AS 'CHI_DP',
                                                 DTTSRR AS 'DTTSRR',
                                                 CHI_HD AS 'CHI_HD',
                                                 CHI_LUONG AS 'CHI_LUONG',
                                                 CHI_TAI_SAN AS
                                                 'CHI_TAI_SAN',
                                                 CHI_MARKETING AS
                                                 'CHI_MARKETING',
                                                 CHI_DAO_TAO AS
                                                 'CHI_DAO_TAO',
                                                 CHI_QLCV AS 'CHI_QLCV',
                                                 LNTT_TRUOC_PBCP AS 'LNTT',
                                                 CHI_HHMG_KDNT AS
                                                 'CHI_HHMG_KDNT',
                                                 CHI_HHMG_TD AS
                                                 'CHI_HHMG_TD',
                                                 CHI_HHMG_THKH AS
                                                 'CHI_HHMG_THKH',
                                                 CHI_HD_TD AS 'CHI_HD_TD',
                                                 CHI_DV_THE AS 'CHI_DV_THE',
                                                 CHI_DV_TK AS 'CHI_DV_TK',
                                                 CHI_DV_KHAC AS
                                                 'CHI_DV_KHAC'))),
TMP_V6 AS
 (SELECT TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
         MA_CN,
         LINE,
         NVL(LINE_1, 0) + NVL(LINE_2, 0) CHI_HHMG_TD,
         NVL(LINE_3, 0) + NVL(LINE_4, 0) + NVL(LINE_5, 0) CHI_HHMG_THKH,
         - NVL(LINE_1, 0) - NVL(LINE_2, 0) CHI_HD_TD,
         - NVL(LINE_4, 0) - NVL(LINE_5, 0) CHI_DV_TK,
         - NVL(LINE_3, 0) CHI_DV_KHAC
    FROM (SELECT CONCAT('VN0010', CN) MA_CN,
                 KHOI_THEOPLKHOI LINE,
                 LINE_GL,
                 SUM(NVL(CUOIKY_CREDIT, 0)) - SUM(NVL(CUOIKY_DEBIT, 0)) VALUE
            FROM APPS.MB_GL_V6_BALANCES A
            LEFT JOIN APPS.MB_MAP_TOI_LINE B
              ON LAST_DAY(A.TRANSACTION_DATE) = B.DATE_TX
             AND A.LINE_GL = B.LINET24
           WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
             AND LINE_GL IN
                 ('684300', '684000', '684002', '684305', '684705')
           GROUP BY CONCAT('VN0010', CN), B.KHOI_THEOPLKHOI, LINE_GL)
  PIVOT(SUM(VALUE)
     FOR LINE_GL IN('684300' LINE_1,
                   '684000' LINE_2,
                   '684002' LINE_3,
                   '684305' LINE_4,
                   '684705' LINE_5))),
TMP_V6_FIN AS
 (SELECT TRANSACTION_DATE,
         MA_CN,
         CASE
           WHEN LINE = 'KHOI KD-KXD' THEN
            'KHOI_KD_KXD'
           WHEN LINE = 'COST CENTER' THEN
            'NHS'
           ELSE
            LINE
         END LINE,
         MA_CT,
         VALUE
    FROM TMP_V6 UNPIVOT(VALUE FOR MA_CT IN(CHI_HHMG_TD AS 'CHI_HHMG_TD',
                                           CHI_HHMG_THKH AS 'CHI_HHMG_THKH',
                                           CHI_HD_TD AS 'CHI_HD_TD',
                                           CHI_DV_TK AS 'CHI_DV_TK',
                                           CHI_DV_KHAC AS 'CHI_DV_KHAC')))
SELECT A.TRANSACTION_DATE,
       A.MA_CN CN,
       B.BRANCH_NAME_T24,
       B.PARENT_BRANCH_CODE_T24,
       B.VUNG_MIEN,
       B.TIEU_VUNG,
       A.MA_CT,
       A.LINE,
       SUM(A.VALUE) VALUE
  FROM (SELECT TRANSACTION_DATE, MA_CN, LINE, MA_CT, VALUE
          FROM TMP_V6_FIN
         WHERE LINE NOT LIKE 'LINE%CHUNG'
        UNION ALL
        SELECT TRANSACTION_DATE, MA_CN, 'ALL' LINE, MA_CT, SUM(VALUE)
          FROM TMP_V6_FIN
         WHERE LINE NOT LIKE 'LINE%CHUNG'
         GROUP BY TRANSACTION_DATE, MA_CN, MA_CT
        UNION ALL
        SELECT TRANSACTION_DATE, MA_CN, LINE, MA_CT, VALUE
          FROM TMP_FIN_GIAO_BAN) A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
   AND A.MA_CN = B.BRANCH_CODE_T24
 GROUP BY A.TRANSACTION_DATE,
          A.MA_CN,
          B.BRANCH_NAME_T24,
          B.PARENT_BRANCH_CODE_T24,
          B.VUNG_MIEN,
          B.TIEU_VUNG,
          A.MA_CT,
          A.LINE</sql>
