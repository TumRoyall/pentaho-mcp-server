    <connection>tckt_dc</connection>
    <sql>/*
select a.transaction_date, ma_cn, 
BRANCH_NAME_T24,
PARENT_BRANCH_CODE_T24,
VUNG_MIEN,
TIEU_VUNG,
ma_ct, 'TOAN_HANG' line, value
from
(select 
data_date transaction_date,
a.cn ma_cn,
count(*) SLKH_LK,
sum(case when lc_st_fin = 'ACTIVE' then 1 end) SLKH_ACTIVE,
sum(case when lc_st_fin = 'ACTIVE' then 1 end)/count(*) TY_LE_KH_ACTIVE,
sum(case when CREATION_DATE between trunc(DATA_DATE,'MM') and DATA_DATE then 1 end) SLKH_MTD,
sum(case when CREATION_DATE between trunc(DATA_DATE,'YY') and DATA_DATE then 1 end) SLKH_YTD
from etl.ors_tr_khachhang_active_m a
where DATA_DATE = to_date('${PRD_ID}','YYYYMMDD')
group by data_date, cn)
unpivot
(value
for ma_ct in
(SLKH_LK as 'SLKH_LK',
SLKH_ACTIVE as 'SLKH_ACTIVE',
TY_LE_KH_ACTIVE as 'TY_LE_KH_ACTIVE',
SLKH_MTD as 'SLKH_NEW_MTD',
SLKH_YTD as 'SLKH_NEW_YTD')) a
left join etl.ref_aict_branch_m b
on a.ma_cn = b.branch_code_t24 
*/

SELECT A.TRANSACTION_DATE,
       MA_CN CN,
       BRANCH_NAME_T24,
       PARENT_BRANCH_CODE_T24,
       VUNG_MIEN,
       TIEU_VUNG,
       MA_CT,
       'TOAN_HANG' LINE,
       VALUE
  FROM (SELECT DATA_DATE TRANSACTION_DATE,
               A.CN MA_CN,
               COUNT(1) SLKH_LK,
               SUM(CASE
                       WHEN LC_ST_FIN = 'ACTIVE' THEN
                        1
                   END) SLKH_ACTIVE,
               SUM(CASE
                       WHEN LC_ST_FIN = 'ACTIVE' THEN
                        1
                   END) / COUNT(1) TY_LE_KH_ACTIVE,
               SUM(CASE
                       WHEN CREATION_DATE BETWEEN TRUNC(DATA_DATE, 'MM') AND
                            DATA_DATE THEN
                        1
                   END) SLKH_MTD,
               SUM(CASE
                       WHEN CREATION_DATE BETWEEN TRUNC(DATA_DATE, 'YY') AND
                            DATA_DATE THEN
                        1
                   END) SLKH_YTD
          FROM ETL.ORS_TR_KHACHHANG_ACTIVE_M A
         WHERE DATA_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
         GROUP BY DATA_DATE, CN) UNPIVOT(VALUE FOR MA_CT IN(SLKH_LK AS 'SLKH_LK',
                                                            SLKH_ACTIVE AS 'SLKH_ACTIVE',
                                                            TY_LE_KH_ACTIVE AS 'TY_LE_KH_ACTIVE',
                                                            SLKH_MTD AS 'SLKH_NEW_MTD',
                                                            SLKH_YTD AS 'SLKH_NEW_YTD')) A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B ON A.MA_CN = B.BRANCH_CODE_T24 AND A.TRANSACTION_DATE = B.TRANSACTION_DATE</sql>
