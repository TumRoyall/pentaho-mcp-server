  <step>
    <name>FIN_HDV_SMY_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH TMP_HDV AS
 (SELECT TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
         CN,
         KHOI LINE,
         A.LOC_TERM,
         CASE
           WHEN PRODUCT_CODE = '12111' THEN
            'TR_TG'
           WHEN SUBSTR(PRODUCT_CODE, 1, 2) IN ('12', '13') THEN
            'TR_TK'
           ELSE
            'TR_TG'
         END SOURCE_TABLE,
         CASE
           WHEN A.NTE = 'VND' THEN
            'VND'
           ELSE
            'FCY'
         END NTE,
         SUM(CASE
               WHEN A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD') THEN
                A.SODU_THOIDIEM_VND
               ELSE
                0
             END) SODU_THOIDIEM_VND,
         SUM(CASE
               WHEN A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD') THEN
                A.SODU_BINHQUAN_VND
               ELSE
                0
             END) SODU_BINHQUAN_VND,
         SUM(A.SODU_BINHQUAN_VND * TO_CHAR(TRANSACTION_DATE, 'DD') /
             TO_CHAR(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'DDD')) SODU_BINHQUAN_LK_VND
    FROM APPS.FIN_HDV_SMY_MONTHLY A
   WHERE TRANSACTION_DATE BETWEEN
         TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'YEAR') AND
         TO_DATE('${PRD_ID}', 'YYYYMMDD')
   GROUP BY CN,
            KHOI,
            A.LOC_TERM,
            CASE
              WHEN PRODUCT_CODE = '12111' THEN
               'TR_TG'
              WHEN SUBSTR(PRODUCT_CODE, 1, 2) IN ('12', '13') THEN
               'TR_TK'
              ELSE
               'TR_TG'
            END,
            CASE
              WHEN A.NTE = 'VND' THEN
               'VND'
              ELSE
               'FCY'
            END),
TMP_FIN_HDV AS
 (SELECT TRANSACTION_DATE,
         CN,
         LINE,
         SUM(NVL(SODU_THOIDIEM_VND, 0)) HDTD,
         SUM(CASE
               WHEN SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_KKH,
         SUM(CASE
               WHEN SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_CKH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_VND,
         SUM(CASE
               WHEN NTE = 'VND' AND SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_VND_KKH,
         SUM(CASE
               WHEN NTE = 'VND' AND SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_VND_CKH,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_FCY,
         SUM(CASE
               WHEN NTE = 'FCY' AND SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_FCY_KKH,
         SUM(CASE
               WHEN NTE = 'FCY' AND SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_FCY_CKH,
         SUM(CASE
               WHEN LOC_TERM BETWEEN 1 AND 6 THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_6M,
         SUM(CASE
               WHEN LOC_TERM BETWEEN 7 AND 12 THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_7M_12M,
         SUM(CASE
               WHEN LOC_TERM BETWEEN 13 AND 15 THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_13M_15M,
         SUM(CASE
               WHEN LOC_TERM BETWEEN 16 AND 18 THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_16M_18M,
         SUM(CASE
               WHEN LOC_TERM > 18 THEN
                NVL(SODU_THOIDIEM_VND, 0)
             END) HDTD_ABV_18M,
         SUM(NVL(SODU_BINHQUAN_VND, 0)) HDBQ,
         SUM(CASE
               WHEN SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_KKH,
         SUM(CASE
               WHEN SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_CKH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_VND,
         SUM(CASE
               WHEN NTE = 'VND' AND SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_VND_KKH,
         SUM(CASE
               WHEN NTE = 'VND' AND SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_VND_CKH,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_FCY,
         SUM(CASE
               WHEN NTE = 'FCY' AND SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_FCY_KKH,
         SUM(CASE
               WHEN NTE = 'FCY' AND SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_BINHQUAN_VND, 0)
             END) HDBQ_FCY_CKH,
         SUM(NVL(SODU_BINHQUAN_LK_VND, 0)) HDBQ_LK,
         SUM(CASE
               WHEN SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_KKH,
         SUM(CASE
               WHEN SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_CKH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_VND,
         SUM(CASE
               WHEN NTE = 'VND' AND SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_VND_KKH,
         SUM(CASE
               WHEN NTE = 'VND' AND SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_VND_CKH,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_FCY,
         SUM(CASE
               WHEN NTE = 'FCY' AND SOURCE_TABLE = 'TR_TG' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_FCY_KKH,
         SUM(CASE
               WHEN NTE = 'FCY' AND SOURCE_TABLE = 'TR_TK' THEN
                NVL(SODU_BINHQUAN_LK_VND, 0)
             END) HDBQ_LK_FCY_CKH
    FROM TMP_HDV
   GROUP BY TRANSACTION_DATE, CN, LINE),
TMP_FINAL_HDV AS
 (SELECT TRANSACTION_DATE, CN, MA_CT, LINE, VALUE
    FROM TMP_FIN_HDV UNPIVOT(VALUE FOR MA_CT IN(HDTD AS 'HDV_TD',
                                                HDTD_KKH AS 'HDV_TD_KKH',
                                                HDTD_CKH AS 'HDV_TD_CKH',
                                                HDTD_VND AS 'HDV_TD_VND',
                                                HDTD_VND_KKH AS
                                                'HDV_TD_VND_KKH',
                                                HDTD_VND_CKH AS
                                                'HDV_TD_VND_CKH',
                                                HDTD_FCY AS 'HDV_TD_FCY',
                                                HDTD_FCY_KKH AS
                                                'HDV_TD_FCY_KKH',
                                                HDTD_FCY_CKH AS
                                                'HDV_TD_FCY_CKH',
                                                HDTD_6M AS 'HDV_TD_6M',
                                                HDTD_7M_12M AS
                                                'HDV_TD_7M_12M',
                                                HDTD_13M_15M AS
                                                'HDV_TD_13M_15M',
                                                HDTD_16M_18M AS
                                                'HDV_TD_16M_18M',
                                                HDTD_ABV_18M AS
                                                'HDV_TD_ABV_18M',
                                                HDBQ AS 'HDV_BQ',
                                                HDBQ_KKH AS 'HDV_BQ_KKH',
                                                HDBQ_CKH AS 'HDV_BQ_CKH',
                                                HDBQ_VND AS 'HDV_BQ_VND',
                                                HDBQ_VND_KKH AS
                                                'HDV_BQ_VND_KKH',
                                                HDBQ_VND_CKH AS
                                                'HDV_BQ_VND_CKH',
                                                HDBQ_FCY AS 'HDV_BQ_FCY',
                                                HDBQ_FCY_KKH AS
                                                'HDV_BQ_FCY_KKH',
                                                HDBQ_FCY_CKH AS
                                                'HDV_BQ_FCY_CKH',
                                                HDBQ_LK AS 'HDV_BQ_LK',
                                                HDBQ_LK_KKH AS
                                                'HDV_BQ_LK_KKH',
                                                HDBQ_LK_CKH AS
                                                'HDV_BQ_LK_CKH',
                                                HDBQ_LK_VND AS
                                                'HDV_BQ_LK_VND',
                                                HDBQ_LK_VND_KKH AS
                                                'HDV_BQ_LK_VND_KKH',
                                                HDBQ_LK_VND_CKH AS
                                                'HDV_BQ_LK_VND_CKH',
                                                HDBQ_LK_FCY AS
                                                'HDV_BQ_LK_FCY',
                                                HDBQ_LK_FCY_KKH AS
                                                'HDV_BQ_LK_FCY_KKH',
                                                HDBQ_LK_FCY_CKH AS
                                                'HDV_BQ_LK_FCY_CKH')))
SELECT A.TRANSACTION_DATE,
       A.CN,
       B.BRANCH_NAME_T24,
       B.PARENT_BRANCH_CODE_T24,
       B.VUNG_MIEN,
       B.TIEU_VUNG,
       A.MA_CT,
       A.LINE,
       SUM(A.VALUE) VALUE
  FROM TMP_FINAL_HDV A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
   AND A.CN = B.BRANCH_CODE_T24
 GROUP BY A.TRANSACTION_DATE,
          A.CN,
          B.BRANCH_NAME_T24,
          B.PARENT_BRANCH_CODE_T24,
          B.VUNG_MIEN,
          B.TIEU_VUNG,
          A.MA_CT,
          A.LINE
</sql>
