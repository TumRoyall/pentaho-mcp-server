  <step>
    <name>FIN_LOAN_SMY_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH TMP_LOAN AS
 (SELECT TRANSACTION_DATE,
         CN,
         CASE
           WHEN A.NHOM_KYHAN = 1 THEN
            'NH'
           WHEN A.NHOM_KYHAN IN ('2', '3') THEN
            'TDH'
         END NHOM_KYHAN,
         A.NHOMNO_XHTD,
         CASE
           WHEN A.NTE = 'VND' THEN
            'VND'
           ELSE
            'FCY'
         END NTE,
         KHOI,
         SUM(A.DUNO_THOIDIEM_VND) DUNO_THOIDIEM_VND,
         SUM(A.DUNO_BINHQUAN_VND) DUNO_BINHQUAN_VND,
         SUM(A.DUNO_BINHQUAN_LK_VND) DUNO_BINHQUAN_LK_VND,
         SUM(A.DOANHSO_GIAINGAN_VND) DOANHSO_GIAINGAN_VND,
         SUM(A.DOANHSO_THUNO_VND) DOANHSO_THUNO_VND,
         SUM(A.REAL_INTEREST_VND) REAL_INTEREST_VND,
         SUM(A.REAL_INTEREST_VND_LK) REAL_INTEREST_VND_LK,
         SUM(A.INTEREST_FTP_VND) INTEREST_FTP_VND,
         SUM(A.INTEREST_FTP_VND_LK) INTEREST_FTP_VND_LK,
         SUM(A.RWA_CHOVAY_VND) RWA_CHOVAY_VND,
         SUM(A.DOANHSO_GIAINGAN_VND * A.INT_RATE) LAI_GN
    FROM APPS.FIN_LOAN_SMY_MONTHLY A
   WHERE A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   GROUP BY TRANSACTION_DATE,
            CN,
            CASE
              WHEN A.NHOM_KYHAN = 1 THEN
               'NH'
              WHEN A.NHOM_KYHAN IN ('2', '3') THEN
               'TDH'
            END,
            A.NHOMNO_XHTD,
            CASE
              WHEN A.NTE = 'VND' THEN
               'VND'
              ELSE
               'FCY'
            END,
            KHOI),
TMP_FIN_LOAN AS
 (SELECT TRANSACTION_DATE,
         CN,
         KHOI LINE,
         SUM(NVL(DUNO_THOIDIEM_VND, 0)) DNTD,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_TDH_FCY,
         SUM(CASE
               WHEN NHOMNO_XHTD = '1' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_N1,
         SUM(CASE
               WHEN NHOMNO_XHTD = '2' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_N2,
         SUM(CASE
               WHEN NHOMNO_XHTD = '3' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_N3,
         SUM(CASE
               WHEN NHOMNO_XHTD = '4' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_N4,
         SUM(CASE
               WHEN NHOMNO_XHTD = '5' THEN
                NVL(DUNO_THOIDIEM_VND, 0)
             END) DNTD_N5,
         SUM(NVL(DUNO_BINHQUAN_VND, 0)) DNBQ,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(DUNO_BINHQUAN_VND, 0)
             END) DNBQ_TDH_FCY,
         SUM(NVL(DUNO_BINHQUAN_LK_VND, 0)) DNBQ_LK,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(DUNO_BINHQUAN_LK_VND, 0)
             END) DNBQ_LK_TDH_FCY,
         SUM(NVL(DOANHSO_GIAINGAN_VND, 0)) DSGN,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(DOANHSO_GIAINGAN_VND, 0)
             END) DSGN_TDH_FCY,
         SUM(NVL(DOANHSO_THUNO_VND, 0)) DSTN,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(DOANHSO_THUNO_VND, 0)
             END) DSTN_TDH_FCY,
         SUM(NVL(REAL_INTEREST_VND, 0)) THULAI,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(REAL_INTEREST_VND, 0)
             END) THULAI_TDH_FCY,
         SUM(NVL(REAL_INTEREST_VND_LK, 0)) THULAI_LK,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(REAL_INTEREST_VND_LK, 0)
             END) THULAI_LK_TDH_FCY,
         SUM(NVL(INTEREST_FTP_VND, 0)) CHILAI_FTP,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(INTEREST_FTP_VND, 0)
             END) CHILAI_FTP_TDH_FCY,
         SUM(NVL(INTEREST_FTP_VND_LK, 0)) CHILAI_FTP_LK,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(INTEREST_FTP_VND_LK, 0)
             END) CHILAI_FTP_LK_TDH_FCY,
         SUM(NVL(LAI_GN, 0)) LGN,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' THEN
                NVL(LAI_GN, 0)
             END) LGN_NH,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' THEN
                NVL(LAI_GN, 0)
             END) LGN_TDH,
         SUM(CASE
               WHEN NTE = 'VND' THEN
                NVL(LAI_GN, 0)
             END) LGN_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'VND' THEN
                NVL(LAI_GN, 0)
             END) LGN_NH_VND,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'VND' THEN
                NVL(LAI_GN, 0)
             END) LGN_TDH_VND,
         SUM(CASE
               WHEN NTE = 'FCY' THEN
                NVL(LAI_GN, 0)
             END) LGN_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'NH' AND NTE = 'FCY' THEN
                NVL(LAI_GN, 0)
             END) LGN_NH_FCY,
         SUM(CASE
               WHEN NHOM_KYHAN = 'TDH' AND NTE = 'FCY' THEN
                NVL(LAI_GN, 0)
             END) LGN_TDH_FCY
    FROM TMP_LOAN
   GROUP BY TRANSACTION_DATE, CN, KHOI),
TMP_FINAL_LOAN AS
 (SELECT TRANSACTION_DATE, CN, MA_CT, LINE, VALUE
    FROM (SELECT A.*,
                 CASE
                   WHEN DSGN > 0 THEN
                    LGN / DSGN
                 END LSGN,
                 CASE
                   WHEN DSGN_NH > 0 THEN
                    LGN_NH / DSGN_NH
                 END LSGN_NH,
                 CASE
                   WHEN DSGN_TDH > 0 THEN
                    LGN_TDH / DSGN_TDH
                 END LSGN_TDH,
                 CASE
                   WHEN DSGN_VND > 0 THEN
                    LGN_VND / DSGN_VND
                 END LSGN_VND,
                 CASE
                   WHEN DSGN_NH_VND > 0 THEN
                    LGN_NH_VND / DSGN_NH_VND
                 END LSGN_NH_VND,
                 CASE
                   WHEN DSGN_TDH_VND > 0 THEN
                    LGN_TDH_VND / DSGN_TDH_VND
                 END LSGN_TDH_VND,
                 CASE
                   WHEN DSGN_FCY > 0 THEN
                    LGN_FCY / DSGN_FCY
                 END LSGN_FCY,
                 CASE
                   WHEN DSGN_NH_FCY > 0 THEN
                    LGN_NH_FCY / DSGN_NH_FCY
                 END LSGN_NH_FCY,
                 CASE
                   WHEN DSGN_TDH_FCY > 0 THEN
                    LGN_TDH_FCY / DSGN_TDH_FCY
                 END LSGN_TDH_FCY,
                 CASE
                   WHEN DNBQ > 0 THEN
                    THULAI / DNBQ * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ,
                 CASE
                   WHEN DNBQ_NH > 0 THEN
                    THULAI_NH / DNBQ_NH * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_NH,
                 CASE
                   WHEN DNBQ_TDH > 0 THEN
                    THULAI_TDH / DNBQ_TDH * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_TDH,
                 CASE
                   WHEN DNBQ_VND > 0 THEN
                    THULAI_VND / DNBQ_VND * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_VND,
                 CASE
                   WHEN DNBQ_NH_VND > 0 THEN
                    THULAI_NH_VND / DNBQ_NH_VND * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_NH_VND,
                 CASE
                   WHEN DNBQ_TDH_VND > 0 THEN
                    THULAI_TDH / DNBQ_TDH_VND * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_TDH_VND,
                 CASE
                   WHEN DNBQ_FCY > 0 THEN
                    THULAI_FCY / DNBQ_FCY * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_FCY,
                 CASE
                   WHEN DNBQ_NH_FCY > 0 THEN
                    THULAI_NH_FCY / DNBQ_NH_FCY * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_NH_FCY,
                 CASE
                   WHEN DNBQ_TDH_FCY > 0 THEN
                    THULAI_TDH / DNBQ_TDH_FCY * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'MM')) * 100
                 END LSBQ_TDH_FCY,
                 CASE
                   WHEN DNBQ_LK > 0 THEN
                    THULAI_LK / DNBQ_LK * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK,
                 CASE
                   WHEN DNBQ_LK_NH > 0 THEN
                    THULAI_LK_NH / DNBQ_LK_NH * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_NH,
                 CASE
                   WHEN DNBQ_LK_TDH > 0 THEN
                    THULAI_LK_TDH / DNBQ_LK_TDH * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_TDH,
                 CASE
                   WHEN DNBQ_LK_VND > 0 THEN
                    THULAI_LK_VND / DNBQ_LK_VND * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_VND,
                 CASE
                   WHEN DNBQ_LK_NH_VND > 0 THEN
                    THULAI_LK_NH_VND / DNBQ_LK_NH_VND * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_NH_VND,
                 CASE
                   WHEN DNBQ_LK_TDH_VND > 0 THEN
                    THULAI_LK_TDH / DNBQ_LK_TDH_VND * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_TDH_VND,
                 CASE
                   WHEN DNBQ_LK_FCY > 0 THEN
                    THULAI_LK_FCY / DNBQ_LK_FCY * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_FCY,
                 CASE
                   WHEN DNBQ_LK_NH_FCY > 0 THEN
                    THULAI_LK_NH_FCY / DNBQ_LK_NH_FCY * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_NH_FCY,
                 CASE
                   WHEN DNBQ_LK_TDH_FCY > 0 THEN
                    THULAI_LK_TDH / DNBQ_LK_TDH_FCY * 365 /
                    TO_NUMBER(TRANSACTION_DATE - TRUNC(TRANSACTION_DATE, 'Y')) * 100
                 END LSBQ_LK_TDH_FCY
            FROM TMP_FIN_LOAN A) UNPIVOT(VALUE FOR MA_CT IN(DNTD AS 'DN_TD',
                                                            DNTD_NH AS
                                                            'DN_TD_NH',
                                                            DNTD_TDH AS
                                                            'DN_TD_TDH',
                                                            DNTD_VND AS
                                                            'DN_TD_VND',
                                                            DNTD_NH_VND AS
                                                            'DN_TD_NH_VND',
                                                            DNTD_TDH_VND AS
                                                            'DN_TD_TDH_VND',
                                                            DNTD_FCY AS
                                                            'DN_TD_FCY',
                                                            DNTD_NH_FCY AS
                                                            'DN_TD_NH_FCY',
                                                            DNTD_TDH_FCY AS
                                                            'DN_TD_TDH_FCY',
                                                            DNTD_N1 AS
                                                            'DN_TD_N1',
                                                            DNTD_N2 AS
                                                            'DN_TD_N2',
                                                            DNTD_N3 AS
                                                            'DN_TD_N3',
                                                            DNTD_N4 AS
                                                            'DN_TD_N4',
                                                            DNTD_N5 AS
                                                            'DN_TD_N5',
                                                            DNBQ AS 'DN_BQ',
                                                            DNBQ_NH AS
                                                            'DN_BQ_NH',
                                                            DNBQ_TDH AS
                                                            'DN_BQ_TDH',
                                                            DNBQ_VND AS
                                                            'DN_BQ_VND',
                                                            DNBQ_NH_VND AS
                                                            'DN_BQ_NH_VND',
                                                            DNBQ_TDH_VND AS
                                                            'DN_BQ_TDH_VND',
                                                            DNBQ_FCY AS
                                                            'DN_BQ_FCY',
                                                            DNBQ_NH_FCY AS
                                                            'DN_BQ_NH_FCY',
                                                            DNBQ_TDH_FCY AS
                                                            'DN_BQ_TDH_FCY',
                                                            DNBQ_LK AS
                                                            'DN_BQ_LK',
                                                            DNBQ_LK_NH AS
                                                            'DN_BQ_LK_NH',
                                                            DNBQ_LK_TDH AS
                                                            'DN_BQ_LK_TDH',
                                                            DNBQ_LK_VND AS
                                                            'DN_BQ_LK_VND',
                                                            DNBQ_LK_NH_VND AS
                                                            'DN_BQ_LK_NH_VND',
                                                            DNBQ_LK_TDH_VND AS
                                                            'DN_BQ_LK_TDH_VND',
                                                            DNBQ_LK_FCY AS
                                                            'DN_BQ_LK_FCY',
                                                            DNBQ_LK_NH_FCY AS
                                                            'DN_BQ_LK_NH_FCY',
                                                            DNBQ_LK_TDH_FCY AS
                                                            'DN_BQ_LK_TDH_FCY',
                                                            DSGN AS 'DSGN',
                                                            DSGN_NH AS
                                                            'DSGN_NH',
                                                            DSGN_TDH AS
                                                            'DSGN_TDH',
                                                            DSGN_VND AS
                                                            'DSGN_VND',
                                                            DSGN_NH_VND AS
                                                            'DSGN_NH_VND',
                                                            DSGN_TDH_VND AS
                                                            'DSGN_TDH_VND',
                                                            DSGN_FCY AS
                                                            'DSGN_FCY',
                                                            DSGN_NH_FCY AS
                                                            'DSGN_NH_FCY',
                                                            DSGN_TDH_FCY AS
                                                            'DSGN_TDH_FCY',
                                                            DSTN AS 'DSTN',
                                                            DSTN_NH AS
                                                            'DSTN_NH',
                                                            DSTN_TDH AS
                                                            'DSTN_TDH',
                                                            DSTN_VND AS
                                                            'DSTN_VND',
                                                            DSTN_NH_VND AS
                                                            'DSTN_NH_VND',
                                                            DSTN_TDH_VND AS
                                                            'DSTN_TDH_VND',
                                                            DSTN_FCY AS
                                                            'DSTN_FCY',
                                                            DSTN_NH_FCY AS
                                                            'DSTN_NH_FCY',
                                                            DSTN_TDH_FCY AS
                                                            'DSTN_TDH_FCY',
                                                            THULAI AS
                                                            'THULAI',
                                                            THULAI_NH AS
                                                            'THULAI_NH',
                                                            THULAI_TDH AS
                                                            'THULAI_TDH',
                                                            THULAI_VND AS
                                                            'THULAI_VND',
                                                            THULAI_NH_VND AS
                                                            'THULAI_NH_VND',
                                                            THULAI_TDH_VND AS
                                                            'THULAI_TDH_VND',
                                                            THULAI_FCY AS
                                                            'THULAI_FCY',
                                                            THULAI_NH_FCY AS
                                                            'THULAI_NH_FCY',
                                                            THULAI_TDH_FCY AS
                                                            'THULAI_TDH_FCY',
                                                            THULAI_LK AS
                                                            'THULAI_LK',
                                                            THULAI_LK_NH AS
                                                            'THULAI_LK_NH',
                                                            THULAI_LK_TDH AS
                                                            'THULAI_LK_TDH',
                                                            THULAI_LK_VND AS
                                                            'THULAI_LK_VND',
                                                            THULAI_LK_NH_VND AS
                                                            'THULAI_LK_NH_VND',
                                                            THULAI_LK_TDH_VND AS
                                                            'THULAI_LK_TDH_VND',
                                                            THULAI_LK_FCY AS
                                                            'THULAI_LK_FCY',
                                                            THULAI_LK_NH_FCY AS
                                                            'THULAI_LK_NH_FCY',
                                                            THULAI_LK_TDH_FCY AS
                                                            'THULAI_LK_TDH_FCY',
                                                            CHILAI_FTP AS
                                                            'CHILAI_FTP',
                                                            CHILAI_FTP_NH AS
                                                            'CHILAI_FTP_NH',
                                                            CHILAI_FTP_TDH AS
                                                            'CHILAI_FTP_TDH',
                                                            CHILAI_FTP_VND AS
                                                            'CHILAI_FTP_VND',
                                                            CHILAI_FTP_NH_VND AS
                                                            'CHILAI_FTP_NH_VND',
                                                            CHILAI_FTP_TDH_VND AS
                                                            'CHILAI_FTP_TDH_VND',
                                                            CHILAI_FTP_FCY AS
                                                            'CHILAI_FTP_FCY',
                                                            CHILAI_FTP_NH_FCY AS
                                                            'CHILAI_FTP_NH_FCY',
                                                            CHILAI_FTP_TDH_FCY AS
                                                            'CHILAI_FTP_TDH_FCY',
                                                            CHILAI_FTP_LK AS
                                                            'CHILAI_FTP_LK',
                                                            CHILAI_FTP_LK_NH AS
                                                            'CHILAI_FTP_LK_NH',
                                                            CHILAI_FTP_LK_TDH AS
                                                            'CHILAI_FTP_LK_TDH',
                                                            CHILAI_FTP_LK_VND AS
                                                            'CHILAI_FTP_LK_VND',
                                                            CHILAI_FTP_LK_NH_VND AS
                                                            'CHILAI_FTP_LK_NH_VND',
                                                            CHILAI_FTP_LK_TDH_VND AS
                                                            'CHILAI_FTP_LK_TDH_VND',
                                                            CHILAI_FTP_LK_FCY AS
                                                            'CHILAI_FTP_LK_FCY',
                                                            CHILAI_FTP_LK_NH_FCY AS
                                                            'CHILAI_FTP_LK_NH_FCY',
                                                            CHILAI_FTP_LK_TDH_FCY AS
                                                            'CHILAI_FTP_LK_TDH_FCY',
                                                            LSGN AS 'LSGN',
                                                            LSGN_NH AS
                                                            'LSGN_NH',
                                                            LSGN_TDH AS
                                                            'LSGN_TDH',
                                                            LSGN_VND AS
                                                            'LSGN_VND',
                                                            LSGN_NH_VND AS
                                                            'LSGN_NH_VND',
                                                            LSGN_TDH_VND AS
                                                            'LSGN_TDH_VND',
                                                            LSGN_FCY AS
                                                            'LSGN_FCY',
                                                            LSGN_NH_FCY AS
                                                            'LSGN_NH_FCY',
                                                            LSGN_TDH_FCY AS
                                                            'LSGN_TDH_FCY',
                                                            LSBQ AS 'LSBQ',
                                                            LSBQ_NH AS
                                                            'LSBQ_NH',
                                                            LSBQ_TDH AS
                                                            'LSBQ_TDH',
                                                            LSBQ_VND AS
                                                            'LSBQ_VND',
                                                            LSBQ_NH_VND AS
                                                            'LSBQ_NH_VND',
                                                            LSBQ_TDH_VND AS
                                                            'LSBQ_TDH_VND',
                                                            LSBQ_FCY AS
                                                            'LSBQ_FCY',
                                                            LSBQ_NH_FCY AS
                                                            'LSBQ_NH_FCY',
                                                            LSBQ_TDH_FCY AS
                                                            'LSBQ_TDH_FCY',
                                                            LSBQ_LK AS
                                                            'LSBQ_LK',
                                                            LSBQ_LK_NH AS
                                                            'LSBQ_LK_NH',
                                                            LSBQ_LK_TDH AS
                                                            'LSBQ_LK_TDH',
                                                            LSBQ_LK_VND AS
                                                            'LSBQ_LK_VND',
                                                            LSBQ_LK_NH_VND AS
                                                            'LSBQ_LK_NH_VND',
                                                            LSBQ_LK_TDH_VND AS
                                                            'LSBQ_LK_TDH_VND',
                                                            LSBQ_LK_FCY AS
                                                            'LSBQ_LK_FCY',
                                                            LSBQ_LK_NH_FCY AS
                                                            'LSBQ_LK_NH_FCY',
                                                            LSBQ_LK_TDH_FCY AS
                                                            'LSBQ_LK_TDH_FCY')))
SELECT A.TRANSACTION_DATE,
       A.CN,
       B.BRANCH_NAME_T24,
       B.PARENT_BRANCH_CODE_T24,
       B.VUNG_MIEN,
       B.TIEU_VUNG,
       A.MA_CT,       
       A.LINE,
       SUM(A.VALUE) VALUE
  FROM TMP_FINAL_LOAN A
  LEFT JOIN ETL.REF_AICT_BRANCH_M B
    ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
   AND A.CN = B.BRANCH_CODE_T24
 GROUP BY A.TRANSACTION_DATE,
          A.CN,
          B.BRANCH_NAME_T24,
          B.PARENT_BRANCH_CODE_T24,
          B.VUNG_MIEN,
          B.TIEU_VUNG,
