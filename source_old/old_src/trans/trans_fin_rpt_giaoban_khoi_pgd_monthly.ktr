  <step>
    <name>MB_TR_PL_KHOI</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH TMP_PL_KHOI AS
 (SELECT TRANSACTION_DATE, MA_CN, IDX, LINE, VALUE
    FROM (SELECT *
            FROM APPS.MB_TR_PL_KHOI A
           WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')) UNPIVOT(VALUE FOR LINE IN(FI AS 'FI',
                                                                                             TOTAL AS
                                                                                             'ALL',
                                                                                             ALM AS
                                                                                             'ALM',
                                                                                             CIB AS
                                                                                             'CIB',
                                                                                             DVC AS
                                                                                             'DVC',
                                                                                             NHS AS
                                                                                             'NHS',
                                                                                             SMES AS
                                                                                             'SME',
                                                                                             INDIV AS
                                                                                             'INDIV',
                                                                                             OTHER AS
                                                                                             'OTHER',
                                                                                             INVEST AS
                                                                                             'INVEST',
                                                                                             TREASURY AS
                                                                                             'TREASURY',
                                                                                             KHOI_KD_KXD AS
                                                                                             'KHOI_KD_KXD'))),
TMP_GIAO_BAN AS
 (SELECT TRANSACTION_DATE,
         MA_CN,
         LINE,
         NVL(A, 0) DOANH_THU_THUAN,
         NVL(A, 0) - NVL(A532, 0) THU_THUAN_KINH_DOANH,
         NVL(A1, 0) THU_LAI,
         NVL(A1114, 0) + NVL(A1135, 0) + NVL(A112, 0) + NVL(A114, 0) +
         NVL(A115, 0) THU_THUAN_TIN_DUNG,
         NVL(A1114, 0) THU_LAI_TIN_DUNG,
         NVL(A1135, 0) CHI_LAI_MUA_VON,
         NVL(A112, 0) THU_TUONG_TU_LAI,
         NVL(A114, 0) + NVL(A115, 0) THU_CHIA_SE_NHS,
         NVL(A1113, 0) + NVL(A1134, 0) THU_THUAN_TRAI_PHIEU,
         NVL(A1113, 0) THU_LAI_TRAI_PHIEU,
         NVL(A1134, 0) CHI_LAI_MUA_VON_TP,
         NVL(A12151, 0) + NVL(A12152, 0) + NVL(A1224, 0) + NVL(A12322, 0) +
         NVL(A124, 0) + NVL(A125, 0) THU_THUAN_HUY_DONG,
         NVL(A12151, 0) + NVL(A12152, 0) THU_LAI_FTP,
         NVL(A12151, 0) THU_LAI_FTP_KKH,
         NVL(A12152, 0) THU_LAI_FTP_CKH,
         NVL(A1224, 0) CHI_LAI_HUY_DONG,
         NVL(A12241, 0) + NVL(A12244, 0) CHI_LAI_KKH,
         NVL(A12242, 0) + NVL(A12243, 0) + NVL(A12245, 0) + NVL(A12246, 0) CHI_LAI_CKH,
         NVL(A12322, 0) CHI_TUONG_TU_LAI,
         NVL(A124, 0) + NVL(A125, 0) CHI_CHIA_SE_NHS,
         NVL(A137, 0) + NVL(A1311, 0) + NVL(A1312, 0) + NVL(A1331, 0) +
         NVL(A1332, 0) + NVL(A1333, 0) + NVL(A136, 0) + NVL(A135, 0) +
         NVL(A1334, 0) + NVL(A134, 0) THU_DIEU_HOA_VON,
         NVL(A, 0) - NVL(A1, 0) - NVL(A532, 0) THU_NGOAI_LAI,
         NVL(A201, 0) THU_THUAN_BAO_LANH,
         NVL(A2, 0) - NVL(A201, 0) THU_THUAN_DICH_VU,
         NVL(A203, 0) THU_THUAN_TTQT,
         NVL(A204, 0) THU_THUAN_CHUYEN_TIEN,
         NVL(A205, 0) THU_THUAN_THE,
         NVL(A2148, 0) + NVL(A2149, 0) + NVL(A215, 0) THU_THUAN_LK_DOI_TAC,
         NVL(A216, 0) THU_THUAN_TU_VAN_IB,
         NVL(A207, 0) THU_THUAN_BAO_HIEM,
         NVL(A2147, 0) THU_THUAN_TKSD,
         NVL(A2, 0) - NVL(A201, 0) - NVL(A203, 0) - NVL(A204, 0) -
         NVL(A205, 0) - NVL(A2148, 0) - NVL(A2149, 0) - NVL(A215, 0) -
         NVL(A216, 0) - NVL(A207, 0) - NVL(A2147, 0) THU_THUAN_KHAC,
         NVL(A3, 0) THU_FX_PS_VANG,
         NVL(A41, 0) + NVL(A42, 0) + NVL(A45, 0) THU_TP_THU_CAP,
         NVL(A5, 0) - NVL(A532, 0) THU_TU_HDKD_KHAC,
         NVL(A532, 0) THU_NO_NGOAI_BANG,
         NVL(B, 0) CHI_DP,
         NVL(C, 0) DTTSRR,
         NVL(D, 0) CHI_HD,
         NVL(D1, 0) CHI_LUONG,
         NVL(D2, 0) CHI_TAI_SAN,
         NVL(D3, 0) CHI_MARKETING,
         NVL(D421, 0) + NVL(D422, 0) CHI_DAO_TAO,
         NVL(D4, 0) - NVL(D421, 0) - NVL(D422, 0) CHI_QLCV,
         NVL(H, 0) LNTT_TRUOC_PBCP,
         NVL(-A36, 0) CHI_HHMG_KDNT,
         0 CHI_HHMG_THKH,
         0 CHI_HHMG_TD,
         NVL(-A1123, 0) CHI_HD_TD,
         NVL(-A20512, 0) + NVL(-A20522, 0) CHI_DV_THE,
         NVL(-A2112, 0) + NVL(-A2152, 0) CHI_DV_TK,
         NVL(-A20312, 0) + NVL(-A2042, 0) + NVL(-A2102, 0) + NVL(-A2142, 0) +
         NVL(-A2143, 0) + NVL(-A2144, 0) CHI_DV_KHAC
    FROM TMP_PL_KHOI A
  PIVOT(SUM(VALUE)
     FOR IDX IN('A2' A2,
               'A2013' A2013,
               'A204' A204,
               'A2043' A2043,
               'A208' A208,
