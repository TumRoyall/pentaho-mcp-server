    <connection>tckt_dc</connection>
    <sql>with tmp_pl_toanhang as (
select
    LAST_DAY(transaction_date) transaction_date,
    sum(case when ind_code = 'A' then nvl(a.ALL_DUCUOI,0) end) DTTTRR,
    sum(case when ind_code in ('A1','A2') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_KINH_DOANH,
    sum(case when ind_code in ('A1') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_TU_LAI,
    sum(case when ind_code in ('A11') then nvl(a.ALL_DUCUOI,0) end) THU_LAI_CHO_VAY,
    sum(case when ind_code in ('A13') then nvl(a.ALL_DUCUOI,0) end) THU_LAI_TCTD,
    sum(case when ind_code in ('A15') then nvl(a.ALL_DUCUOI,0) end) THU_LAI_TRAI_PHIEU,
    sum(case when ind_code in ('A12','A14','A16') then nvl(-a.ALL_DUCUOI,0) end) TONG_CHI_LAI,
    sum(case when ind_code in ('A12') then nvl(-a.ALL_DUCUOI,0) end) CHI_LAI_HDV,
    sum(case when ind_code in ('A14') then nvl(-a.ALL_DUCUOI,0) end) CHI_LAI_TCTD,
    sum(case when ind_code in ('A16') then nvl(-a.ALL_DUCUOI,0) end) CHI_LAI_TRAI_PHIEU,
    sum(case when ind_code in ('A2') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_NGOAI_LAI,
    sum(case when ind_code in ('A21','A22') then nvl(a.ALL_DUCUOI,0) end) THU_DV_BL,
    sum(case when ind_code in ('A21') then nvl(a.ALL_DUCUOI,0) end) THU_BL,
    sum(case when ind_code in ('A22') then nvl(a.ALL_DUCUOI,0) end) THU_DV,
    sum(case when ind_code in ('A221','A224') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_TTQT,
    sum(case when ind_code in ('A223') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_THE,
    sum(case when ind_code in ('A227') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_IB,
    sum(case when ind_code in ('A228') then nvl(a.ALL_DUCUOI,0) end) THU_THUAN_BANCAS,
    sum(case when ind_code in ('A23') then nvl(a.ALL_DUCUOI,0) end) THU_FX_PS_VANG,
    sum(case when ind_code in ('A241') then nvl(a.ALL_DUCUOI,0) end) THU_CO_TUC,
    sum(case when ind_code in ('A242') then nvl(a.ALL_DUCUOI,0) end) THU_KDCK,
    sum(case when ind_code in ('A25') then nvl(a.ALL_DUCUOI,0) end) THU_TU_HDKD_KHAC,
    sum(case when ind_code in ('A3') then nvl(a.ALL_DUCUOI,0) end) THU_NO_NGOAI_BANG,
    sum(case when ind_code in ('B') then nvl(-a.ALL_DUCUOI,0) end) CHI_PHI_DP,
    sum(case when ind_code in ('C') then nvl(a.ALL_DUCUOI,0) end) DTTSRR,
    sum(case when ind_code in ('D') then nvl(-a.ALL_DUCUOI,0) end) CHI_PHI_HD,
    sum(case when ind_code in ('D1') then nvl(-a.ALL_DUCUOI,0) end) CHI_LUONG,
    sum(case when ind_code in ('D2') then nvl(-a.ALL_DUCUOI,0) end) CHI_TAI_SAN,
    sum(case when ind_code in ('D3') then nvl(-a.ALL_DUCUOI,0) end) CHI_MARKETING,
    sum(case when ind_code in ('D4') then nvl(-a.ALL_DUCUOI,0) end) CHI_QLCV_CDT,
    sum(case when ind_code in ('G') then nvl(a.ALL_DUCUOI,0) end) LNTT,
    sum(case when ind_code in ('H') then nvl(-a.ALL_DUCUOI,0) end) THUE_TNDN,
    sum(case when ind_code in ('I') then nvl(a.ALL_DUCUOI,0) end) LNST
from APPS.MB_GL_PLHOPNHAT_BSPL a
where transaction_date = LAST_DAY(to_date('${PRD_ID}','YYYYMMDD'))
group by transaction_date 
),

tmp_pl_khoi as (
select
    LAST_DAY(transaction_date) transaction_date,
    sum(case when b.IND_CODE in ('A11146') then nvl(b.TOTAL,0) end) THU_LAI_MUA_NO,
    sum(case when b.IND_CODE in ('A12321','A12322') then nvl(b.TOTAL,0) end) CHI_LAI_KHAC,
    sum(case when b.IND_CODE in ('A2148','A2149','A215') then nvl(b.TOTAL,0) end) THU_THUAN_LK_DOI_TAC,
    sum(case when b.IND_CODE in ('A2148','A2149') then nvl(b.TOTAL,0) end) THU_VI_DIEN_TU,
    sum(case when b.IND_CODE in ('A215') then nvl(b.TOTAL,0) end) THU_LK_CHIEN_LUOC,
    sum(case when b.IND_CODE in ('A211') then nvl(b.TOTAL,0) end) THU_THUAN_DVTK,
    sum(case when b.IND_CODE in ('A2111') then nvl(b.TOTAL,0) end) THU_NHDT,
    sum(case when b.IND_CODE in ('A2112') then nvl(b.TOTAL,0) end) CHI_NHDT,
    sum(case when b.IND_CODE in ('A204') then nvl(b.TOTAL,0) end) THU_THUAN_CHUYEN_TIEN,
    sum(case when b.IND_CODE in ('A2147') then nvl(b.TOTAL,0) end) THU_THUAN_TSDK,
    sum(case when b.IND_CODE in ('A41','A42','A45') then nvl(b.TREASURY,0) end) THU_KDCK_TRE,
    sum(case when b.IND_CODE in ('D421','D422') then nvl(b.TOTAL,0) end) CHI_DAO_TAO
from APPS.MB_GL_PL_KHOI_BSPL b
where transaction_date = LAST_DAY(to_date('${PRD_ID}','YYYYMMDD'))
group by transaction_date 
),

tmp_import as (
select 
    transaction_date, 
    value
from etl.TRANS_FINANCE_IMPORT_DATA
where transaction_date = to_date('${PRD_ID}','YYYYMMDD')
and ma_ct = 'PHI_HD_UT_OB'
),

tmp_fin as (
select
    LAST_DAY(a.TRANSACTION_DATE) TRANSACTION_DATE,
    nvl(DTTTRR,0) DTTTRR,
    nvl(THU_THUAN_KINH_DOANH,0) THU_THUAN_KINH_DOANH,
    nvl(THU_THUAN_TU_LAI,0) THU_THUAN_TU_LAI,
    nvl(THU_THUAN_TU_LAI,0) - nvl(CHI_LAI_HDV,0) - nvl(CHI_LAI_TCTD,0) - nvl(CHI_LAI_TRAI_PHIEU,0) - nvl(CHI_LAI_KHAC,0) - nvl(c.value,0) TONG_THU_LAI,
    nvl(THU_LAI_CHO_VAY,0) + nvl(THU_LAI_MUA_NO,0) THU_LAI_CHO_VAY,
    nvl(THU_LAI_TCTD,0) THU_LAI_TCTD,
    nvl(THU_LAI_TRAI_PHIEU,0) THU_LAI_TRAI_PHIEU,
    nvl(THU_THUAN_TU_LAI,0) - nvl(CHI_LAI_HDV,0) - nvl(CHI_LAI_TCTD,0) - nvl(CHI_LAI_TRAI_PHIEU,0) - nvl(CHI_LAI_KHAC,0) - nvl(c.value,0) - nvl(THU_LAI_CHO_VAY,0) - nvl(THU_LAI_MUA_NO,0) - nvl(THU_LAI_TCTD,0) - nvl(THU_LAI_TRAI_PHIEU,0) THU_LAI_KHAC,
    nvl(TONG_CHI_LAI,0) + nvl(CHI_LAI_KHAC,0) TONG_CHI_LAI,
    nvl(CHI_LAI_HDV,0) CHI_LAI_HDV,
    nvl(CHI_LAI_TCTD,0) CHI_LAI_TCTD,
    nvl(CHI_LAI_TRAI_PHIEU,0) CHI_LAI_TRAI_PHIEU,
    nvl(CHI_LAI_KHAC,0) CHI_LAI_KHAC,
    nvl(THU_THUAN_NGOAI_LAI,0) THU_THUAN_NGOAI_LAI,
    nvl(THU_DV_BL,0) THU_DV_BL,
    nvl(THU_BL,0) THU_BL,
    nvl(THU_DV,0) THU_DV,
    nvl(THU_THUAN_TTQT,0) THU_THUAN_TTQT,
    nvl(THU_THUAN_THE,0) THU_THUAN_THE,
    nvl(THU_THUAN_LK_DOI_TAC,0) THU_THUAN_LK_DOI_TAC,
    nvl(THU_VI_DIEN_TU,0) THU_VI_DIEN_TU,
    nvl(THU_LK_CHIEN_LUOC,0) THU_LK_CHIEN_LUOC,
    nvl(THU_THUAN_IB,0) THU_THUAN_IB,
    nvl(THU_THUAN_BANCAS,0) THU_THUAN_BANCAS,
    nvl(THU_THUAN_DVTK,0) THU_THUAN_DVTK,
    nvl(THU_NHDT,0) THU_NHDT,
    nvl(CHI_NHDT,0) CHI_NHDT,
    nvl(THU_DV,0) - nvl(THU_THUAN_TTQT,0) - nvl(THU_THUAN_THE,0) - nvl(THU_THUAN_LK_DOI_TAC,0) - nvl(THU_THUAN_DVTK, 0) - nvl(THU_THUAN_IB,0) - nvl(THU_THUAN_BANCAS,0) THU_THUAN_DICH_VU_KHAC,
    nvl(THU_THUAN_CHUYEN_TIEN,0) THU_THUAN_CHUYEN_TIEN,
    nvl(THU_THUAN_TSDK,0) THU_THUAN_TSDK,
    nvl(THU_DV,0) - nvl(THU_THUAN_TTQT,0) - nvl(THU_THUAN_THE,0) - nvl(THU_THUAN_LK_DOI_TAC,0) - nvl(THU_THUAN_DVTK,0) - nvl(THU_THUAN_IB,0) - nvl(THU_THUAN_BANCAS,0) - nvl(THU_THUAN_CHUYEN_TIEN,0) - nvl(THU_THUAN_TSDK,0) THU_DV_KHAC,
    nvl(THU_FX_PS_VANG,0) THU_FX_PS_VANG,
    nvl(THU_CO_TUC,0) THU_CO_TUC,
    nvl(THU_KDCK,0) THU_KDCK,
    nvl(THU_KDCK,0) - nvl(THU_KDCK_TRE,0) THU_KD_TP_THU_CAP,
    nvl(THU_KDCK_TRE,0) THU_KDCK_TRE,
    nvl(THU_TU_HDKD_KHAC,0) THU_TU_HDKD_KHAC,
    nvl(THU_NO_NGOAI_BANG,0) THU_NO_NGOAI_BANG,
    nvl(CHI_PHI_DP,0) CHI_PHI_DP,
    nvl(DTTSRR,0) DTTSRR,
    nvl(CHI_PHI_HD,0) CHI_PHI_HD,
    nvl(CHI_LUONG,0) CHI_LUONG,
    nvl(CHI_TAI_SAN,0) CHI_TAI_SAN,
    nvl(CHI_MARKETING,0) CHI_MARKETING,
    nvl(CHI_DAO_TAO,0) CHI_DAO_TAO,
    nvl(CHI_QLCV_CDT,0) - nvl(CHI_DAO_TAO,0) CHI_QLCV,
    nvl(LNTT,0) LNTT,
    nvl(THUE_TNDN,0) THUE_TNDN,
    nvl(LNST,0) LNST, 
    -nvl(CHI_PHI_DP,0)/nvl(DTTTRR,0) PIR,
    -nvl(CHI_PHI_HD,0)/nvl(DTTTRR,0) CIR,
    -nvl(CHI_LUONG,0)/nvl(DTTSRR,0) TY_LE_LUONG_DTTSRR,
    -nvl(CHI_MARKETING,0)/nvl(DTTTRR,0) TY_LE_MAR_DTTSRR,
    nvl(THU_DV_BL,0)/nvl(THU_THUAN_KINH_DOANH,0) TY_LE_TNL_TTNHD,
    nvl(THU_DV,0)/nvl(THU_THUAN_KINH_DOANH,0) TY_LE_THUDV_TTKD,
    nvl(THU_THUAN_NGOAI_LAI,0)/nvl(THU_THUAN_KINH_DOANH,0) TY_LE_THUNL_TTKD
from tmp_pl_toanhang a
left join tmp_pl_khoi b
    on a.transaction_date = b.transaction_date
left join tmp_import c
    on a.transaction_date = c.transaction_date
)

select 
    TRANSACTION_DATE,
    ma_ct, 
    'TOAN_HANG' line, 
    value
from tmp_fin
unpivot (
    value 
    for ma_ct in (
        DTTTRR as 'DTTTRR',
        THU_THUAN_KINH_DOANH as 'THU_THUAN_KINH_DOANH',
        THU_THUAN_TU_LAI as 'THU_THUAN_TU_LAI',
        TONG_THU_LAI as 'TONG_THU_LAI',
        THU_LAI_CHO_VAY as 'THU_LAI_CHO_VAY',
        THU_LAI_TCTD as 'THU_LAI_TCTD',
        THU_LAI_TRAI_PHIEU as 'THU_LAI_TRAI_PHIEU',
        THU_LAI_KHAC as 'THU_LAI_KHAC',
        TONG_CHI_LAI as 'TONG_CHI_LAI',
        CHI_LAI_HDV as 'CHI_LAI_HDV',
        CHI_LAI_TCTD as 'CHI_LAI_TCTD',
        CHI_LAI_TRAI_PHIEU as 'CHI_LAI_TRAI_PHIEU',
        CHI_LAI_KHAC as 'CHI_LAI_KHAC',
        THU_THUAN_NGOAI_LAI as 'THU_THUAN_NGOAI_LAI',
        THU_DV_BL as 'THU_THUAN_DV_BL',
        THU_BL as 'THU_THUAN_BL',
        THU_DV as 'THU_THUAN_DV',
        THU_THUAN_TTQT as 'THU_THUAN_TTQT',
        THU_THUAN_THE as 'THU_THUAN_THE',
        THU_THUAN_LK_DOI_TAC as 'THU_THUAN_LK_DOI_TAC',
        THU_VI_DIEN_TU as 'THU_VI_DIEN_TU',
        THU_LK_CHIEN_LUOC as 'THU_LK_CHIEN_LUOC',
        THU_THUAN_IB as 'THU_THUAN_IB',
        THU_THUAN_BANCAS as 'THU_THUAN_BANCAS',
        THU_THUAN_DVTK as 'THU_THUAN_NHDT',
        THU_NHDT as 'THU_NHDT',
        CHI_NHDT as 'CHI_NHDT',
        THU_THUAN_DICH_VU_KHAC as 'THU_THUAN_CT_TKSD_DVK',
        THU_THUAN_CHUYEN_TIEN as 'THU_THUAN_CHUYEN_TIEN',
        THU_THUAN_TSDK as 'THU_THUAN_TKSD',
        THU_DV_KHAC as 'THU_THUAN_DV_KHAC',
        THU_FX_PS_VANG as 'THU_FX_PS_VANG',
        THU_CO_TUC as 'THU_CO_TUC',
        THU_KDCK as 'THU_KDCK',
        THU_KD_TP_THU_CAP as 'THU_KD_TP_THU_CAP',
        THU_KDCK_TRE as 'THU_KDCK_TRE',
        THU_TU_HDKD_KHAC as 'THU_TU_HDKD_KHAC',
        THU_NO_NGOAI_BANG as 'THU_NO_NGOAI_BANG',
        CHI_PHI_DP as 'CHI_PHI_DP',
        DTTSRR as 'DTTSRR',
        CHI_PHI_HD as 'CHI_PHI_HD',
        CHI_LUONG as 'CHI_LUONG',
        CHI_TAI_SAN as 'CHI_TAI_SAN',
        CHI_MARKETING as 'CHI_MARKETING',
        CHI_DAO_TAO as 'CHI_DAO_TAO',
        CHI_QLCV as 'CHI_QLCV',
        LNTT as 'LNTT',
