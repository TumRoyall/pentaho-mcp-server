    <connection>tckt_dc</connection>
    <sql>with tmp_v6 as (
select 
  LAST_DAY(transaction_date) transaction_date, 
  sum(nvl(CUOIKY_CREDIT, 0)) - sum(nvl(CUOIKY_DEBIT, 0)) QUY_DU_TRU_BS_VDL
from APPS.MB_GL_V6_BALANCES
where TRANSACTION_DATE = to_date('${PRD_ID}','YYYYMMDD')
  and LINE_GL = '541000'
group by transaction_date
),

tmp_bs_hopnhat as (
select *
from
(select 
  LAST_DAY(transaction_date) transaction_date, 
  IND_CODE, 
  ALL_QD
from APPS.MB_GL_BSHOPNHAT_BSPL
where TRANSACTION_DATE = LAST_DAY(to_date('${PRD_ID}', 'YYYYMMDD')))
pivot (
  sum(all_qd)
  for ind_code in (
    'A' A,
