tmp_bs_fin as (
select 
  a.transaction_date,
  nvl(a.B42,0) HDV_TD_CKH,
  nvl(a.B43,0) HDV_TD_CDS,
  nvl(a.B41,0) / nvl(a.B4,0) TY_LE_CASA_QUAN_TRI,
  nvl(a.B41,0)/ (nvl(a.B41,0) + (nvl(a.B42, 0))) TY_LE_CASA_BCTC,
  nvl(a.B5,0) HDV_TD_TRAIPHIEU,
  nvl(a.B7,0) / nvl(a.B71,0)*10000 BVPS,
  nvl(a.B7,0) / nvl(a.B,0) TY_LE_VCSH_TTS,
  nvl(a.B71,0) / nvl(a.B7,0) TY_LE_VDL_VCSH,
  (nvl(a.A1,0) + nvl(a.A7,0) + nvl(a.A8,0) - nvl(a.A82,0))/nvl(a.A,0) TY_LE_TS_KSL_TTS,
  nvl(a.A7,0) / (nvl(a.B71,0) + nvl(b.QUY_DU_TRU_BS_VDL,0)) TY_LE_TSCD_VDL,
  nvl(a.A61,0) / (nvl(a.B71,0) + nvl(b.QUY_DU_TRU_BS_VDL,0) * 3) TY_LE_GVMCP_VDL,
  case when nvl(c.A,0) &lt;&gt; 0 then (nvl(a.A,0)/nvl(c.A,0)-1) end TANG_TRUONG_TTS,
  case when nvl(c.A4,0) &lt;&gt; 0 then (nvl(a.A4,0)/nvl(c.A4,0)-1) end TANG_TRUONG_CV,
  case when nvl(c.B4,0) &lt;&gt; 0 then(nvl(a.B4,0)/nvl(c.B4,0)-1) end TANG_TRUONG_HDV,
  (nvl(c.A,0) + nvl(a.A,0)) / 2 TSBQ,
  (nvl(c.A4,0) + nvl(a.A4,0)) / 2 TDBQ,
  (nvl(c.B7,0) + nvl(a.B7,0)) / 2 VCSHBQ,
  (nvl(c.A1,0) + nvl(c.A7,0) + nvl(c.A8,0) - nvl(c.A82,0) + nvl(a.A1,0) + nvl(a.A7,0) + nvl(a.A8,0) - nvl(a.A82,0)) / 2 TSKSLBQ
from tmp_bs_hopnhat a
left join tmp_v6 b on a.transaction_date = b.transaction_date
left join tmp_bs_hopnhat_his c on trunc(a.transaction_date, 'Y') - 1 = c.transaction_date
)

select 
  LAST_DAY(transaction_date) TRANSACTION_DATE, 
  ma_ct, 
  'TOAN_HANG' line, 
  value
from tmp_bs_fin
unpivot (
  value
  for ma_ct in (
    HDV_TD_CKH as 'HDV_TD_CKH',
    HDV_TD_CDS as 'HDV_TD_CCTG',
    TY_LE_CASA_QUAN_TRI as 'TY_LE_CASA_QUAN_TRI',
    TY_LE_CASA_BCTC as 'TY_LE_CASA_BCTC',
  HDV_TD_TRAIPHIEU as 'HDV_TD_TRAIPHIEU',
    BVPS as 'BVPS',
    TY_LE_VCSH_TTS as 'TY_LE_VCSH_TTS',
    TY_LE_VDL_VCSH as 'TY_LE_VDL_VCSH',
    TY_LE_TS_KSL_TTS as 'TY_LE_TS_KSL_TTS',
    TY_LE_TSCD_VDL as 'TY_LE_TSCD_VDL',
    TY_LE_GVMCP_VDL as 'TY_LE_GVMCP_VDL',
    TANG_TRUONG_TTS as 'TANG_TRUONG_TTS',
    TANG_TRUONG_CV as 'TANG_TRUONG_CV',
    TANG_TRUONG_HDV as 'TANG_TRUONG_HDV',
    TSBQ as 'TTS_BQ',
    TDBQ as 'TD_BQ',
    VCSHBQ as 'VCSH_BQ',
  TSKSLBQ as 'TSKSLBQ'
  )
)  </sql>
