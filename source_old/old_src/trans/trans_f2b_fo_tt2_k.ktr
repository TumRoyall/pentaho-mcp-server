  <step>
    <name>kplus.dbo.LoansDepositDeals</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>f2b_kplus_dc</connection>
    <sql>Select ldd.LoansDepositDeals_Id, ldd.DealType,
 bra.Branches_ShortName, por.Portfolios_ShortName, 
f.Folders_ShortName,ff.Folders_ShortName FolderOrg,
cpty.Cpty_ShortName, ccy.Currencies_ShortName, 
ldd.ValueDate, ldd.MaturityDate, ldd.Amount,

ls.StartDate, ls.EndDate, ls.Principal,
ls.Rate,
1 DaysInReport
			
, CONVERT(date,convert(char,'${PRD_ID}'),112) as DaysReport, 

round(case when ldd.DealType = 'L' then ls.Principal * 
1 / 1 else 0 end,ccy.NoDecimal) as L_Amt,



round(case when ldd.DealType = 'L' then ls.Principal * ls.Rate
*1 / 1 else 0 end,ccy.NoDecimal) as L_Int,


round(case when ldd.DealType = 'D' then ls.Principal * 
1/ 1 else 0 end,ccy.NoDecimal) as D_Amt,



round(case when ldd.DealType = 'D' then ls.Principal * ls.Rate
* 1 / 1 else 0 end,ccy.NoDecimal) as D_Int, isnull((
select T.Term from Kustom..MB_TermInDay T where
DATEDIFF(day,ldd.ValueDate,ldd.MaturityDate) >= T.StartDate and DATEDIFF(day,ldd.ValueDate,ldd.MaturityDate) &lt;= T.EndDate), '> 60 Thang')
as Term	,kcv.ItemDisplayName Basic

			
			
from kplus.dbo.LoansDepositDeals ldd
inner join kplus..LoansSchedule ls on ldd.LoansDepositDeals_Id = ls.LoansDepositDeals_Id and ls.CashFlowType = 'I'
and ls.Used IN ('U', 'L')
 inner join kplus.dbo.Cpty cpty on ldd.Cpty_Id = cpty.Cpty_Id
left join kplus.dbo.Folders f on cpty.Folders_Id = f.Folders_Id

inner join kplus.dbo.Portfolios por on f.Portfolios_Id = por.Portfolios_Id
inner join kplus.dbo.Branches bra on por.Branches_Id = bra.Branches_Id -- and bra.Branches_ShortName='ALM'
inner join kplus.dbo.Currencies ccy on ldd.Currencies_Id = ccy.Currencies_Id
--left join #KLSDeals KLS on KLS.DealId=ldd.LoansDepositDeals_Id and KLS.KdbTables_Id=108
--left join #MB_DBValidated VD on VD.DealId=ldd.LoansDepositDeals_Id and VD.KdbTables_Id=108
left join kplus..KdbChoicesValues kcv on ldd.Basis = kcv.InternalValue and kcv.KdbChoices_Id = 2
left join kplus..Folders ff on ldd.Folders_Id = ff.Folders_Id

Where 
--((KLS.DealId is null and VD.DealId is null) or (VD.Action ='V')) and 
f.Folders_ShortName IN
('ALMMSLD001',
'ALMMPAC001',
'ALMMREP001',
'ALMMSAL001',
'ALMMCAA001',
'ALMMIAM001',
'ALMMCAD001',
'ALMMSWP001',
'ALMMBON001',
'ALFITRA001',
'ALFIAFS001',
'ALFIHTM001',
'ALFXSPT001',
'ALFXSWP001',
'ALFXFWD001',
'ALFXFWO001',
'ALFXNDF001',
'ALFXNDS001',
'ALFXBNT001',
'ALFXBRO001',
'ALFXOPQ001',
'ALFXOPT001',
'ALFXSTB001',
'ALFXSTP001',
'ALFSSWP001',
'ALFSFWD001',
'ALFSBNT001',
'ALFSOPT001',
'ALFSVND001',
'ALDRCAP001',
'ALDRCCS001',
'ALDRFLO001',
'ALDRFRA001',
'ALDRFWD001',
'ALDRIRS001',
'ALDRMMT001',
'ALDRSPT001',
'ALSPGRO001',
'ALSPMMT001',
'ALSPOCR001',
'ALSPOPT001',
'ALSPDCD001',
'ALSPSPT001',
'ALCMFUT001',
'ALCMOPT001',
'ALCMSW001',
'ALFNDOC001',
'ALFNREF001',
'ALFNTRL001',
'ALGTFWD001',
'ALGTSPT001',
'ALGTSWP001',
'ALMMULD001')   
and ff.Folders_ShortName not like 'ALLI%'
and datediff(d, CONVERT(date,convert(char,'${PRD_ID}'),112),  ldd.ValueDate) &lt;= 0 and datediff(d, CONVERT(date,convert(char,'${PRD_ID}'),112), ldd.MaturityDate) > 0
--and datediff(d, CONVERT(date,convert(char,'20240424'),112),  ldd.ValueDate) >= 0 and datediff(d, CONVERT(date,convert(char,'20240425'),112), ldd.ValueDate) &lt;= 0
--and (por.Portfolios_ShortName = @Portfolios or @Portfolios is null)
--and (ccy.Currencies_ShortName = @Currency or @Currency is null)</sql>
