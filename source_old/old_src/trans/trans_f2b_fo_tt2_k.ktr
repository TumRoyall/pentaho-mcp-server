    <sql>Select *  from Kustom.dbo.MB_DBValidatedDeals a
where a.TransId =(select max(b.TransId) from Kustom.dbo.MB_DBValidatedDeals b
where a.DealId=b.DealId and a.KdbTables_Id=b.KdbTables_Id)</sql>
