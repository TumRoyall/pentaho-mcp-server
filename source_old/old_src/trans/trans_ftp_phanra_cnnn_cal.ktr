    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with v_raw_data as (
  SELECT 
      b.ccy,
      b.date_tx,
      b.Attribute_Id,
      b.type_id,
      sum(b.amount) Amount,
      source_id,
      row_number() OVER(
        partition by  b.ccy,
        b.Attribute_Id,
        b.type_id,
        b.source_id 
        order by date_Tx
      ) id
  FROM etl.TRE_AGG_Sk_KKH_LINE_cnnn_mer b
  where b.date_Tx &lt;= to_date('${PRD_ID}','yyyyMMdd') 
  having sum(b.amount)>0    
  group by 
      b.ccy,
      b.date_tx,
      b.Attribute_Id,
      b.type_id,
      b.source_id
  order by b.ccy,
      b.Attribute_Id,
      b.type_id,
      b.source_id,
      b.date_tx
),
v_temp1 as(
  select t.*, c.stt, c.kyhan,c.so_ngay, t.id+c.so_ngay -1 next_id
  from 
  v_raw_data t,  apps.trea_phanra_kyhan_check c
),
v_suygiam as (
     select 
       t1.id,
       t1.date_tx,
       t2.date_tx next_date_tx,
       t1.ccy,
       t1.attribute_id,
       t1.type_id,
       t1.source_id,
       t1.stt,
       t1.kyhan,
       t1.so_ngay,
       ROUND(((t2.amount - t1.amount)/t1.amount)*100,4) luong_suygiam     
     from v_temp1 t1
     join v_temp1 t2
     on t1.ccy = t2.ccy
     and t1.attribute_id = t2.attribute_id
     and t1.type_id = t2.type_id
     and t1.source_id = t2.source_id
     and t1.stt =t2.stt
     and t1.kyhan = t2.kyhan
     and t1.so_ngay = t2.so_ngay
     and t1.next_id = t2.id
),
v_suygiam_negative_values as (
     select t.*,
     abs(t.luong_suygiam) abs_suygiam,
     row_number() OVER(  
     partition by  
        t.ccy,
        t.Attribute_Id,
        t.type_id,
        t.source_id ,
        t.stt,
        t.kyhan,
        t.so_ngay
        ORDER BY ABS(t.luong_suygiam)
      ) row_id 
     from v_suygiam t
     where luong_suygiam&lt;0
     order by t.ccy,
        t.Attribute_Id,
        t.type_id,
        t.source_id ,
        t.stt,
        t.kyhan,
        t.so_ngay     
),
v_pecentile_ids as (
      select t.ccy,
        t.Attribute_Id,
        t.type_id,
        t.source_id ,
        t.stt,
        t.kyhan,
        t.so_ngay ,
        round(count(1)* 0.95,0)  percentile_id,
        count(1) count_rows
      from 
      v_suygiam_negative_values t
      group by t.ccy,
        t.Attribute_Id,
        t.type_id,
        t.source_id ,
        t.stt,
        t.kyhan,
        t.so_ngay 
),
v_percentiles as (
      select t1.*, t2.percentile_id, t2.count_rows 
      from v_suygiam_negative_values t1
      join v_pecentile_ids t2
      on t1.ccy = t2.ccy
     and t1.attribute_id = t2.attribute_id
     and t1.type_id = t2.type_id
     and t1.source_id = t2.source_id
     and t1.stt =t2.stt
     and t1.kyhan = t2.kyhan
     and t1.so_ngay = t2.so_ngay
     and t1.row_id = t2.percentile_id
),
v_agg as (
  select k.*, (
   select nvl(max(abs_suygiam), k.abs_suygiam)
   from v_percentiles a
   where 
    a.attribute_id = k.attribute_id
    and a.ccy = k.ccy
    --and a.kyhan = k.kyhan
    and a.type_id = k.type_id
    and a.source_id = k.source_id
    and a.stt &lt; k.stt
  ) max_suygiam
  from v_percentiles k
),
v_tilephanbo as (
  select (
    case 
      when t.stt = 1 then t.abs_suygiam
      when t.abs_suygiam &lt;= t.max_suygiam then 0
      when t.abs_suygiam > t.max_suygiam then t.abs_suygiam - t.max_suygiam
    end
  ) result, t.*
  from v_agg t
  order by 
        attribute_id,
        ccy,
        type_id,
        source_id,
        stt
),
--select * from v_tilephanbo
--;
v_result as (
SELECT 
    --x.date_Tx,
    x. ATTRIBUTE_ID   ,
    X.TYPE_ID,x.ccy,x.source_id,
    SUM(D) D,
    SUM(W1) W1,
   SUM(W2) W2,
      SUM(W3) W3,
   SUM(M1) M1,
     SUM(M2) M2,
       SUM(M3) M3,
       SUM(M4) M4,
     SUM(M5) M5,
     SUM(M6) M6,
       SUM(M7) M7,
     SUM(M8) M8,
      SUM(M9) M9,
        SUM(M10) M10,
      SUM(M11) M11,
     SUM(M12) M12,
      SUM(M24) M24,
      SUM(M36) M36,
     SUM(M48) M48,
     SUM(M60) M60,
     
     100 - (SUM(D)+SUM(W1)+SUM(W2)+SUM(W3)+SUM(M1) +
     SUM(M2) +SUM(M3) +SUM(M4) +SUM(M5) +SUM(M6)+
       SUM(M7) +SUM(M8) +SUM(M9) +SUM(M10)+SUM(M11)+
     SUM(M12)+SUM(M24) +SUM(M36) +SUM(M48)+SUM(M60) ) above_m60
   FROM (select 
  --  m.date_Tx,
    m. ATTRIBUTE_ID   ,
    M.TYPE_ID,m.ccy,m.source_id,
    case when m.kyhan ='1D' THEN M.result ELSE 0 END D,
    case when m.kyhan ='1W' THEN M.result ELSE 0 END W1,
    case when m.kyhan ='2W' THEN M.result ELSE 0 END W2,
    case when m.kyhan ='3W' THEN M.result ELSE 0 END W3,
      
     case when m.kyhan ='1M' THEN M.result ELSE 0 END M1,
    case when m.kyhan ='2M' THEN M.result ELSE 0 END M2,
    case when m.kyhan ='3M' THEN M.result ELSE 0 END M3, 
    case when m.kyhan ='4M' THEN M.result ELSE 0 END M4, 
    case when m.kyhan ='5M' THEN M.result ELSE 0 END M5, 
   case when m.kyhan ='6M' THEN M.result ELSE 0 END M6, 
    case when m.kyhan ='7M' THEN M.result ELSE 0 END M7, 
    case when m.kyhan ='8M' THEN M.result ELSE 0 END M8, 
   case when m.kyhan ='9M' THEN M.result ELSE 0 END M9, 
   case when m.kyhan ='10M' THEN M.result ELSE 0 END M10, 
  case when m.kyhan ='11M' THEN M.result ELSE 0 END M11, 
case when m.kyhan ='12M' THEN M.result ELSE 0 END M12, 
case when m.kyhan ='24M' THEN M.result ELSE 0 END M24, 
case when m.kyhan ='36M' THEN M.result ELSE 0 END M36, 
case when m.kyhan ='48M' THEN M.result ELSE 0 END M48, 
case when m.kyhan ='60M' THEN M.result ELSE 0 END M60
  
   from v_tilephanbo m
--    WHERE M.DATE_tX ='28-feb-2019'
    )X
    group by 
    -- x.date_Tx,
    x. ATTRIBUTE_ID   ,
    X.TYPE_ID,x.ccy,x.source_id
)
select t1.*, to_date('${PRD_ID}','yyyyMMdd') date_apply 
from v_result t1</sql>
