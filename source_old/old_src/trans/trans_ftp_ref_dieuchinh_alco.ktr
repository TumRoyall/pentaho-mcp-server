  <step>
    <name>SRC.02</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT
    TO_DATE('${PRD_ID}', 'YYYYMMDD') AS transaction_date,
    date_apply,
    ccy,
    term_ftp,
    ftp_code,
    khoi,
    amount
FROM
    (
        SELECT
            ROW_NUMBER() OVER(
                PARTITION BY ccy, term_ftp, ftp_code, khoi
                ORDER BY
                    date_apply DESC
            ) row_num,
            ccy,
            term_ftp,
            ftp_code,
            khoi,
            date_apply,
            amount
        FROM
            apps.file_ftp_ref_dieuchinh_alco
        WHERE FTP_code not in ('TD','HD')
          and substr(FTP_code,1,2) in('TD')      
          and date_apply &lt;= TO_DATE('${PRD_ID}', 'YYYYMMDD')
          and date_apply >= (select max(date_apply) 
                                    from apps.file_ftp_ref_dieuchinh_alco
                                    WHERE FTP_code in ('TD')  
                                          and date_apply &lt;= TO_DATE('${PRD_ID}', 'YYYYMMDD')
                                          )
    ) where row_num = 1</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
