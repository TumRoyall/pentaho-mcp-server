    <sql>/*SELECT 
pro.CONTRACT_NUMBER  SOTK,
pro.MAKH,
his.RM_CODE,
pro.CN MA_CNC2,
'DU_PHONG' TK_TYPE,
TO_DATE(${PRD_ID}, 'YYYYMMDD')  TRANSACTION_DATE
FROM ETL.TMP_TOI_PROVISION_MONTHLY pro
LEFT JOIN ETL.ORS_CRM_CUS_ASSIGN_CREDIT_HIS his 
ON pro.CONTRACT_NUMBER =his.CONTRACT_NUMBER 
WHERE his.RM_code IN (SELECT RM FROM ETL.SMB_RM_ID)*/




SELECT 
pro.CONTRACT_NUMBER  SOTK,
pro.MAKH,
his.RM_CODE,
pro.CN MA_CNC2,
'DU_PHONG' TK_TYPE,
TO_DATE(${PRD_ID}, 'YYYYMMDD')   TRANSACTION_DATE
FROM 
(SELECT contract_number, makh,cn FROM ETL.TMP_TOI_PROVISION_MONTHLY pro
GROUP BY contract_number,makh,CN 
) pro
LEFT JOIN ETL.ORS_CRM_CUS_ASSIGN_CREDIT_HIS his 
ON pro.CONTRACT_NUMBER =his.CONTRACT_NUMBER 
WHERE his.RM_code IN (SELECT RM FROM ETL.SMB_RM_ID)
and pro.CN in (select ma_cn from etl.smb_rm_id)
and 1=2</sql>
