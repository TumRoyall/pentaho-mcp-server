    <connection>ods_dc</connection>
    <sql>SELECT 
ft.ft_id SOTK,
ft.PROFIT_CUS makh,
ft.RM_CTQT RM_CODE,
ft.co_code  MA_CNC2,
'TTTM_CTQT' TK_TYPE,
LAST_DAY(FT.PARTITION_DATE) TRANSACTION_DATE
FROM SMY.FT_ENTRY ft
WHERE FT.PARTITION_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'),'MONTH') and TO_DATE('${PRD_ID}', 'YYYYMMDD') 
AND ft.rm_ctqt in (SELECT RM FROM ETL.SMB_RM_ID)
and ft.co_code in (select ma_cn from etl.smb_rm_id)</sql>
