  <step>
    <name>etl.ftp_pre_saoke_sc</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT --to_date(mat_date,'yyyyMMdd') mat_date,
to_date(y_ngay_tdls_tuonglai,'yyyyMMdd') y_ngay_tdls_tuonglai, a.*,
       CASE
         WHEN A.FTP_CODE IN ('TD556', 'TD559') THEN
          (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0)) *
          (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
          nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0)) / (case when a.y_ngay_tdls_daqua>='1-jan-2018' then 36500 else 36000 end)
         ELSE
          NULL
       END FTP_AMOUNT,
       CASE
         WHEN A.FTP_CODE IN ('TD556', 'TD559') THEN
          (nvl(abs(A.Sodu), 0) - nvl(a.SODU_DP, 0)) *
          (nvl(FTP_LS_BASE, 0) + nvl(FTP_CHIPHI_TK, 0) + nvl(cp_dtbb, 0) +
          nvl(tile_bhtg, 0) + nvl(FTP_PHUTROI_TK, 0) +
          nvl(FTP_DIEUCHINH_ALCO, 0)) / (case when a.y_ngay_tdls_daqua>='1-jan-2018' then 36500 else 36000 end)
         ELSE
          NULL
       END FTP_AMOUNT_WITH_ALCO,null biendo_khoi, null biendo_sanpham, null biendo_vungmien,ftp_line,ftp_category
  FROM ( select a.GL,
               a.SOTK,
               a.MA_TP,
               a.MAKH,
               a.TENKH,
               a.SODU,
               a.SODU_VND,
               a.KHOI,
               a.CN,
               a.CCY,
               a.ISSUER,
               a.INT_RATE,
               a.KY_HAN,
               a.VAL_DATE,
               a.MAT_DATE,
               a.MUCDICH,
               a.CHUYENDOI,
               a.NIEMYET,
               a.TSDB,
               a.TRANSACTION_DATE,
               a.Y_ISSUER_SECTOR,
               a.Y_ISSUER_SECTOR_NAME,
               a.Y_ISSUER_INDUSTRY,
               a.Y_ISSUER_INDUSTRY_NAME,
               a.LOAI_TP,
               a.GIATRI_TSDB,
               a.Y_AMOUNT_CUR,
               a.Y_AMOUNT_LCY,
               a.Y_MATURITY_DATE,
               a.FTP_CODE,
               a.Y_KY_TAILAISUAT,
               a.Y_NGAY_TDLS_DAQUA,
               a.Y_NGAY_TDLS_TUONGLAI,
               A.ISSUE_DATE,
               A.Y_ST_THUNO,
               A.Y_CO_CODE,
               A.Y_SC_CUSTOMER, -- 23/03
               a.KYHAN_TDG,
               VM.VUNG_MIEN,
               DP.SODU_DP,ftp_dieuchinh_alco,ftp_ls_base,tile_bhtg,cp_dtbb,ftp_chiphi_tk,ftp_phutroi_tk from etl.ftp_pre_saoke_tpdn2 a
LEFT JOIN apps.ftp_dic_vungmien_khuvuc VM
            on nvl(a.Y_CO_CODE, A.CN) = VM.cn_cap_2
        --so du du phong
          LEFT JOIN (select MA_TP, SUM(SODU_DP) SODU_DP
                      from apps.mb_tr_duphong_kh
                     where transaction_date ='30-sep-2018'
                         --  trunc(trunc(to_date('20180925', 'yyyyMMdd'),
                         --              'MONTH') - 1,
                         --        'MONTH') - 1
                       and loai_dp = 'DP_TRAIPHIEUDN'
          group by MA_TP
) DP --DPCT_TPDN
            ON A.SOTK = 'TP1824900002'--DP.MA_TP
--on a.tenkh= dp.ma_tp
) A
left join apps.ftp_mapping_toi m
on a.ftp_code= m.ftp_prod
and a.khoi = m.khoi</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
