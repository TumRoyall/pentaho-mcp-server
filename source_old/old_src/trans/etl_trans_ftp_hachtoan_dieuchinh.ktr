  </step>
  <step>
    <name>FTP_AMT positive FTP_CODE TD HO</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
      CASE 
         WHEN th.NTE = 'VND' THEN 'VND1625001030001'
         WHEN th.NTE = 'USD' THEN 'USD1625001030001'
         WHEN th.NTE = 'EUR' THEN 'EUR1625001030001'
         WHEN th.NTE = 'AUD' THEN 'AUD1625001030001'
      END DEBIT_ACCT_NO,
      th.NTE DEBIT_CURRENCY,
      CASE
         WHEN th.NTE = 'VND' THEN ROUND(th.FTP_AMT)
         ELSE ROUND(th.FTP_AMT, 2)
      END DEBIT_AMOUNT,
      th.TRANSACTION_DATE CREDIT_VALUE_DATE,
      CASE
         WHEN MV.PL_CREDIT IS NULL THEN NULL
         ELSE 'PL' || MV.PL_CREDIT
      END CREDIT_ACCT_NO,
      'HACH TOAN FTP ' || th.FTP_CODE PAYMENT_DETAILS_1,
      null PAYMENT_DETAILS_2,
      null PAYMENT_DETAILS_3,
      null PAYMENT_DETAILS_4,
      th.NTE CREDIT_CURRENCY,
      'Waive' COMMISSION_CODE,
      'Waive' CHARGE_CODE,
      null COMMISSION_TYPE,
      null CHARGES_ACCT_NO,
      null PROFIT_CENTRE_DEPT,
      71 TXN_PURPOSE,
      301 MB_PAY_METHOD,
      'MB' ORDERING_BANK,      
      'VN0010001' CO_CODE,
      mv.CUS_CREDIT PROFIT_CENTRE_CUST ,id, 'VN0010001.'||'${PRD_ID}'|| '.FTPDC.'|| id  filename   
FROM  ETL.FTP_HACHTOAN_DIEUCHINH_TONGHOP th
LEFT JOIN APPS.FTP_MAP_HTOAN_REV mv ON th.FTP_CODE = mv.FTP_CODE AND th.KHOI = mv.KHOI_DEBIT
WHERE th.FTP_AMT > 0 AND th.FTP_CODE LIKE 'TD%'</sql>
