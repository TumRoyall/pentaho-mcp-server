  <step>
    <name>kplus.dbo.KLSDealsToValidate</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select 
a.LoansDepositDeals_Id,
null BLOCKNUMBER,
a.Folders_ShortName,
a.Cpty_ShortName Cpty_Name,
a.DealType,
a.Portfolios_ShortName TYPEOFINSTR_SHORTNAME,
null PRDCODE,
a.Currencies_ShortName,
null TRADEDATE,
a.ValueDate,
a.MaturityDate,
a.Principal amount,
a.Rate valuerate,
case when  a.valuedate >= a.StartDate and a.valuedate &lt; a.EndDate then   (a.Principal*a.RATE/36500) 
else 0 end FTP_AMOUNT,
to_Date('${PRD_ID}','yyyy-MM-dd') TRANS_DATE,
b.PL_CHI,
b.PL_THU,
null T24CUSTOMERID
from etl.etl_ftp_f2b_tt2 a
left join apps.FILE_MAP_PL_FTP_TT2 b
on a.Portfolios_ShortName = b.Portfolios_ShortName
and a.Currencies_ShortName =b.Currencies_ShortName
and a.DealType = b.DealType
left join etl.etl_ftp_f2b_klsdeals KLS on KLS.DealId=a.LoansDepositDeals_Id and KLS.KdbTables_Id=108
left join etl.etl_ftp_f2b_ValidatedDeals VD on VD.DealId=a.LoansDepositDeals_Id and VD.KdbTables_Id=108
where (KLS.DealId is null and VD.DealId is null) or (VD.Action ='V')
--and a.valuedate= '24-apr-2024'
and a.rate>0</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
      <value-meta>
        <type>BigNumber</type>
        <storagetype>normal</storagetype>
        <name>LOANSDEPOSITDEALS_ID</name>
        <length>-1</length>
        <precision>-1</precision>
        <origin>kplus.dbo.KLSDealsToValidate</origin>
        <comments>LOANSDEPOSITDEALS_ID</comments>
        <conversion_Mask>######0.0###################;-######0.0###################</conversion_Mask>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol/>
        <currency_symbol/>
