    thulai_traiphieu_a3,
    chilai_ftp_b,
    chiftp_tindung_b1,
    chiftp_khac_b2,
    chiftp_traiphieu_b3,
    chilai_kh_c,
    chilai_huydong_c1,
    chilai_khac_c2,
    chilai_traiphieu_c3,
    thulai_ftp_d,
    thuftp_huydong_d1,
    thuftp_khac_d2,
    thu_ngoai_lai_e,
    chi_dp_f,
    dp_dautu_f1,
    dp_lc_f2,
    dp_bl_f3,
    dp_td_f4,
    dp_k,
    chihd_g,
    thuftp_duphongtd_b4,
    thuftp_duphongkhac_b3,
    thuftp_duphongtp_b4,
    dv_baolanh_e1,
    dv_ttqt_e2,
    dv_tttn_e3,
    dv_the_e4,
    dv_utbhck_e5,
    dv_tuvan_e6,
    dv_nganquy_e7,
    dv_giuho_e8,
    dv_kieuhoi_e9,
    dv_nhdt_e10,
    dv_commo_e13,
    dv_khac_e13,
    fx_nte_e14,
    dtk_thu_e15,
    dtk_chiftp_e16,
    bt_khac_e17,
    bt_xln_e18,
    chihoatdong,
    thuhoatdong,
    toi_cstd,
    dtttrr_p,
    thu_ngoai_lai_o,
    thulai_ftp_m,
    chilai_kh_l,
    chilai_ftp_k,
    thulai_kh_j,
    thulaithuan_n,
    chilai_ftp_tindung_k1,
    chiftp_khac_k2,
    chiftp_traiphieu_k3,
    thulai_ftp_m1,
    thuftp_khac_m2,
    fx_nte_e14a,
    dttsrr_i,
    dttsrr_p,
    makh_new,
    CHIFTP_BANNO,
    THULAI_BANNO
FROM
    apps.rep_toi_final_month_lk
WHERE transaction_date = TO_DATE(${PRD_ID}, 'yyyyMMdd')
--AND mod(DBMS_ROWID.ROWID_BLOCK_NUMBER(rowid),3) +1=1</sql>
