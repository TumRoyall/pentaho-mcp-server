    <connection>tckt_dc</connection>
    <sql>SELECT
	transaction_date txn_date,
    transaction_date,
    rep_type,
    ma_cn,
    ten_cn,
    makh,
    SUBSTR(tenkh,0,100) as tenkh,
    khoi,
    product_code,
