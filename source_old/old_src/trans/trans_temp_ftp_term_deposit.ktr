  <step>
    <name>ETL.ODS_TD_BAL </name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>with FTP_TERM_DEPOSIT as(
SELECT 
a.TXN_DATE TRANSACTION_DATE,
a.ARRANGEMENT_NBR SOTK,
a.CURRENCY_CODE CCY,
a.T24_LINE,
a.COA_CODE,
CASE WHEN g.RATE_KEY IS NOT NULL THEN '2'
	 WHEN h.GROUP_INT_RATE_KEY IS NOT NULL THEN  '2'
	 WHEN k.GROUP_INT_RATE_KEY IS NOT NULL THEN  '2'
	 ELSE '1' END INT_RATE_TYPE,
f.TERM_ID TERM_HD,
nvl(a.INT_RATE_CHANGE_TERM, f.TERM_ID) as TERM_FTP,
substr (a.PARTY_KEY, instr (a.PARTY_KEY,'.',1,2) + 1, length (a.PARTY_KEY) - instr (a.PARTY_KEY,'.',1,2)) MAKH,
NVL(a.INT_RATE,0) ARRANGEMENT_INT_RATE,
a.BRANCH_CODE CNC2,
UPPER(k.VUNG_MIEN) VUNG_MIEN,
a.PRODUCT_CODE,
------------ thêm mới phân biệt hotline 
CASE WHEN a.FTP_CODE = 'HD116' and t.BOOK_KEY is null then 'HD100'
     WHEN a.FTP_CODE = 'HD117' and t.BOOK_KEY is null then 'HD103'
     else a.FTP_CODE end FTP_CODE,
----
SUBSTR(a.FTP_CODE,1,2) FTP_TYPE,
a.DIVISION_CODE KHOI,
a.VALUE_DATE,
a.MATURITY_DATE,
nvl(a.LAST_INT_RATE_CHANGE_DATE,a.VALUE_DATE) NGAY_TDLS,
a.SECTOR_CODE SECTOR,
a.RM_CODE RM_CODE,
r.CONVERSION_RATE TYGIA,
a.FCY_AMT,
a.LCY_AMT,
'SMY.TD_BAL' SOURCE_TABLE,
----------- cập nhật lại cách phân biệt FTP_GROUP
CASE WHEN substr(a.COA_CODE,1,2) IN ('41') THEN 'CKH_NONBANK'  
     WHEN g.RATE_KEY IS NOT NULL THEN 'CKH_FLOAT'
	 WHEN h.GROUP_INT_RATE_KEY IS NOT NULL THEN  'CKH_FLOAT'
	 WHEN k.GROUP_INT_RATE_KEY IS NOT NULL THEN  'CKH_FLOAT'
	 ELSE 'CKH_FIX' END
     FTP_GROUP,
---
coalesce(b.AMOUNT,c.AMOUNT,0) INT_FIX
FROM ETL.ODS_TD_BAL a
LEFT JOIN APPS.FILE_NSLD_AICT_BRANCH_M k on k.TRANSACTION_DATE = TRUNC(to_date('${PRD_ID}','YYYYMMDD'),'MONTH') -1 and a.BRANCH_CODE = k.BRANCH_CODE_T24
LEFT JOIN ETL.ORS_GL_DAILY_RATES r on a.TXN_DATE = r.conversion_date and r.TO_CURRENCY = 'VND' and a.CURRENCY_CODE = r.FROM_CURRENCY
LEFT JOIN APPS.FTP_REF_FTPDB b on a.TXN_DATE = b.TRANSACTION_DATE and a.FTP_CODE = b.FTP_CODE
LEFT JOIN APPS.FTP_REF_HDDB c on a.TXN_DATE = C.TRANSACTION_DATE and a.ARRANGEMENT_NBR = c.SOTK
LEFT JOIN APPS.FTP_MAP_TERM f on a.MATURITY_DATE- greatest(a.VALUE_DATE,to_date('20160118','yyyyMMdd')) >= f.from_day
                             and a.MATURITY_DATE - greatest(a.VALUE_DATE,to_date('20160118','yyyyMMdd')) &lt;= f.to_day
LEFT JOIN ETL.ODS_CAL_AZ_PRODUCT_PARAMETER g ON a.PRODUCT_CONDITION =g.PARAMETER_NO
LEFT JOIN ETL.ODS_CAL_ARRANGEMENT_DIR h ON a.ARRANGEMENT_NBR= h.ARRANGEMENT_NBR
LEFT JOIN ETL.ODS_CAL_ARRANGEMENT_CIR k ON a.ARRANGEMENT_NBR= k.ARRANGEMENT_NBR
---------- thêm mới phân biệt hotline 
LEFT JOIN ETL.ODS_TD_HOTLINE_CHECK_DAILY t ON a.ARRANGEMENT_NBR = t.BOOK_KEY and a.MATURITY_DATE = t.MATURITY_DATE
----
where  1=1
And (substr(a.coa_code,1,2) in('42','43') 
and substr(a.product_code,1,2) in ('11','12','13') 
and a.FTP_CODE not in ('HD106', 'HD104') ) 
or  
(substr(a.coa_code,1,2) in ('41')  
And a.SECTOR_CODE between '5000' and '6999') 
)
select 
a.TRANSACTION_DATE,
a.SOTK,
a.CCY,
a.T24_LINE,
a.COA_CODE,
a.INT_RATE_TYPE,
a.TERM_HD,
a.TERM_FTP,
a.MAKH,
a.ARRANGEMENT_INT_RATE,
a.CNC2,
a.VUNG_MIEN,
a.PRODUCT_CODE,
a.FTP_CODE,
a.FTP_TYPE,
a.KHOI,
a.VALUE_DATE,
a.MATURITY_DATE,
a.NGAY_TDLS,
a.SECTOR,
a.RM_CODE,
a.TYGIA,
a.FCY_AMT,
a.LCY_AMT,
a.SOURCE_TABLE,
a.FTP_GROUP,
o.FTP_CATEGORY,
o.FTP_LINE,
o.GL_LINE,
a.INT_FIX,
case when nvl(P.INT_BHTG_FLAG,'N') = 'Y' then nvl(C.AMOUNT,0)
    else 0 end INT_BHTG,
case when nvl(P.INT_DTBB_FLAG,'N') = 'Y' then nvl(D.AMOUNT,0)
    else 0 end INT_DTBB,
case when nvl(P.INT_TK_FLAG,'N') = 'Y' then nvl(E.AMOUNT,0)
   else 0 end INT_TK,
case when nvl(P.INT_PHUTROI_FLAG,'N') = 'Y' then coalesce(F1.PTTK, F2.AMOUNT, F3.AMOUNT , 0)
    else 0 end INT_PHUTROI,
case when nvl(P.INT_DC_ALCO_FLAG,'N') = 'Y' then coalesce(G1.AMOUNT,G2.AMOUNT,0)
    else 0 end INT_DC_ALCO,
case when nvl(P.INT_BASE_FLAG,'N') = 'Y' then nvl(H.AMOUNT,0)
    else 0 end INT_BASE,
case when nvl(P.INT_NIM_HD_FLAG,'N') = 'Y' then nvl(I.AMOUNT,0)
    else 0 end INT_NIM_HD, 
case when nvl(P.TYLE_PHANRA_FLAG,'N') = 'Y' then nvl(K.AMOUNT,0)
    else 0 end INT_PHANRA,  
case when nvl(P.INT_VAYDH_FLAG,'N') = 'Y' then nvl(L.AMOUNT,0)
    else 0 end INT_VAYDH,
case when nvl(P.INT_HDVLSC_FLAG,'N') = 'Y' then nvl(M.AMOUNT,0)
    else 0 end INT_HDVLSC,
case when nvl(P.INT_BASE_MARGIN_FLAG,'N') = 'Y' then coalesce(N1.AMOUNT,N2.AMOUNT,0)
    else 0 end INT_BASE_MARGIN,
case when nvl(P.INT_LS_HD_FLAG,'N') = 'Y' then nvl(a.ARRANGEMENT_INT_RATE,0)
    else 0 end INT_LS_HD,
case when nvl(P.INT_NIM_MARGIN_FLAG,'N') = 'Y' then coalesce(U2.AMOUNT, U1.AMOUNT, 0)
    else 0 end INT_NIM_MARGIN
from FTP_TERM_DEPOSIT A
left join APPS.FTP_MAP_GROUP P on a.FTP_GROUP = P.FTP_GROUP
Left join APPS.FTP_MAP_HTOAN O on a.FTP_CODE = O.FTP_PROD and a.KHOI = O.KHOI
LEFT JOIN APPS.FTP_REF_BASE_MARGIN N1 ON A.KHOI = N1.KHOI AND A.NGAY_TDLS = N1.TRANSACTION_DATE AND A.CCY = N1.CCY AND A.TERM_FTP = N1.TERM_FTP AND A.FTP_TYPE = N1.FTP_TYPE AND A.FTP_CODE = N1.FTP_CODE AND A.FCY_AMT >= N1.AMT_FROM AND A.FCY_AMT &lt;  N1.AMT_TO
LEFT JOIN APPS.FTP_REF_BASE_MARGIN N2 ON A.KHOI = N2.KHOI AND A.NGAY_TDLS = N2.TRANSACTION_DATE AND A.CCY = N2.CCY AND A.TERM_FTP = N2.TERM_FTP AND A.FTP_TYPE = N2.FTP_TYPE AND A.FTP_TYPE = N2.FTP_CODE AND A.FCY_AMT >= N2.AMT_FROM AND A.FCY_AMT &lt;  N2.AMT_TO
---------- thay đổi logic theo NIM_MARGIN_HD 
LEFT JOIN APPS.FTP_REF_NIM_MARGIN_HD U1 ON A.NGAY_TDLS = U1.TRANSACTION_DATE AND A.CCY = U1.CCY AND A.FTP_TYPE = U1.FTP_TYPE and A.TERM_HD = U1.TERM_HD AND A.ARRANGEMENT_INT_RATE >= U1.AMT_FROM AND A.ARRANGEMENT_INT_RATE &lt;  U1.AMT_TO
LEFT JOIN APPS.FTP_REF_NIM_MARGIN_HD U2 ON A.NGAY_TDLS = U2.TRANSACTION_DATE AND A.CCY = U2.CCY AND A.FTP_CODE = U2.FTP_TYPE and A.TERM_HD = U2.TERM_HD AND A.ARRANGEMENT_INT_RATE >= U2.AMT_FROM AND A.ARRANGEMENT_INT_RATE &lt;  U2.AMT_TO
----
LEFT JOIN APPS.FTP_REF_CHIPHI_BHTG C ON A.NGAY_TDLS = C.TRANSACTION_DATE AND A.CCY = C.CCY
LEFT JOIN APPS.FTP_REF_CHIPHI_DTBB D ON A.NGAY_TDLS = D.TRANSACTION_DATE AND A.CCY = D.CCY
LEFT JOIN APPS.FTP_REF_CHIPHI_TK E ON A.NGAY_TDLS = E.TRANSACTION_DATE AND A.CCY = E.CCY
LEFT JOIN APPS.FTP_LICHTRAGOC_LSPHUTROI F1 on  A.SOTK = F1.SOKU
LEFT JOIN APPS.FTP_REF_PHUTROI F2 ON A.NGAY_TDLS = F2.TRANSACTION_DATE AND A.CCY = F2.CCY AND A.TERM_HD = F2.TERM_HD AND A.FTP_CODE = F2.FTP_CODE 
LEFT JOIN APPS.FTP_REF_PHUTROI F3 ON A.NGAY_TDLS = F3.TRANSACTION_DATE AND A.CCY = F3.CCY AND A.TERM_HD = F3.TERM_HD AND A.FTP_TYPE = F3.FTP_CODE 
LEFT JOIN APPS.FTP_REF_DIEUCHINH_ALCO G1 ON A.NGAY_TDLS = G1.TRANSACTION_DATE AND A.FTP_CODE = G1.FTP_CODE AND A.CCY = G1.CCY AND A.TERM_FTP = G1.TERM_FTP AND A.KHOI = G1.KHOI
LEFT JOIN APPS.FTP_REF_DIEUCHINH_ALCO G2 ON A.NGAY_TDLS = G2.TRANSACTION_DATE AND A.FTP_TYPE = G2.FTP_CODE AND A.CCY = G2.CCY AND A.KHOI = G2.KHOI AND A.TERM_FTP = G2.TERM_FTP
LEFT JOIN APPS.FTP_REF_FTP_BASE H ON A.NGAY_TDLS = H.TRANSACTION_DATE AND A.CCY = H.CCY AND A.TERM_FTP = H.TERM_FTP AND A.FTP_TYPE = H.FTP_TYPE
LEFT JOIN APPS.FTP_REF_NIM_HD I ON A.NGAY_TDLS = I.TRANSACTION_DATE AND A.CCY = I.CCY AND A.TERM_FTP = I.TERM_FTP AND A.FTP_TYPE = I.FTP_TYPE 
LEFT JOIN APPS.FTP_REF_TYLE_PHANRA K ON A.TRANSACTION_DATE = K.TRANSACTION_DATE AND A.CCY = K.CCY AND A.KHOI = K.KHOI
LEFT JOIN APPS.FTP_REF_CHIPHI_VAYDAIHAN L ON A.NGAY_TDLS = L.TRANSACTION_DATE AND A.CCY = L.CCY AND A.FTP_TYPE = L.FTP_TYPE AND (CASE WHEN A.NGAY_TDLS &lt; '01JAN2025' THEN A.TERM_FTP ELSE A.TERM_HD END) = L.TERM_FTP
LEFT JOIN APPS.FTP_REF_CHIPHI_HDVLSCAO M ON A.NGAY_TDLS = M.TRANSACTION_DATE AND A.CCY = M.CCY AND A.FTP_TYPE = M.FTP_TYPE AND (CASE WHEN A.NGAY_TDLS &lt; '01JAN2025' THEN A.TERM_FTP ELSE A.TERM_HD END) = M.TERM_FTP


</sql>
