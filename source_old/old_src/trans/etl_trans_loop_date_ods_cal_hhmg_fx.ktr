    <sql>SELECT to_char(trunc(to_date(${PRD_ID},'yyyyMMdd'),'MM')+ LEVEL - 1,'yyyyMMdd') AS PRD_ID1
FROM dual
CONNECT BY LEVEL &lt;= TO_NUMBER(TO_CHAR(last_day(to_date(${PRD_ID},'yyyyMMdd')), 'DD'))</sql>
