    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH toi_pkkh as
   (SELECT to_date(${PRD_ID}, 'YYYYMMDD') transaction_date,
        b.khoi,
        CASE
          WHEN a.makh IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
          ELSE nvl(b.PHAN_KHUC, 'KXD')
        END pkkh,
        nvl(a.product_code, 'KXD') product_code,
        sum(a.dtttrr_i) / 1e9 dtttrr,
        sum(a.dttsrr_i) / 1e9 dttsrr
  FROM apps.REP_TOI_FINAL_MONTH_LK a
  LEFT JOIN APPS.FIN_SMY_CUSTOMER_MONTHLY b
    ON a.makh = b.MAKH
    AND a.transaction_date = b.TRANSACTION_DATE
  WHERE a.transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')
    AND b.khoi in ('NHS', 'INDIV', 'CIB', 'SME')
  GROUP BY b.khoi,
        CASE
          WHEN a.makh IN ('3000','8000','1000','1100','1910','100','999999','1700') THEN 'KXD'
          ELSE nvl(b.PHAN_KHUC, 'KXD')
        END,
        nvl(a.product_code, 'KXD')
),
rwa AS
   (SELECT *
   FROM (
       SELECT khoi, pkkh, product_code, TYPE, rwa
       FROM ETL.TMP_RWA_PKKH
       WHERE khoi in ('NHS', 'INDIV', 'CIB', 'SME')
   )
   PIVOT (
       sum(rwa)
       FOR TYPE IN (
          'RWA_CR_TT2' AS RWA_CR_TT2,
          'RWA_MR' AS RWA_MR,
          'RWA_OR' AS RWA_OR,
          'RWA_CR_TSK' AS RWA_CR_TSK,
          'RWA_CR_TT1' AS RWA_CR_TT1
          ))),
cphd AS
  (SELECT khoi, pkkh, product_code, sum(cphd) cphd
  from
    (SELECT khoi, pkkh, product_code, sum(value_TCS) cphd
    FROM ETL.MPA_CAL_MPA03_05
    WHERE TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD') AND KHOI IN ('NHS', 'INDIV', 'CIB', 'SME')
    GROUP BY khoi, pkkh, product_code
    UNION ALL
    SELECT khoi, pkkh, 'KXD' product_code, cphd
    FROM ETL.FILE_RAROC_DC_CHITIEU
    WHERE TRANSACTION_DATE = to_date('${PRD_ID}', 'YYYYMMDD')
      AND pkkh IS NOT NULL
    GROUP BY khoi, pkkh)
  GROUP BY khoi, pkkh, product_code
  )
SELECT to_date('${PRD_ID}', 'YYYYMMDD') TRANSACTION_date,
      COALESCE(a.khoi, b.khoi, c.khoi) khoi,
      COALESCE(a.pkkh, b.pkkh, c.pkkh) pkkh,
      COALESCE(a.product_code, b.product_code, c.product_code) product_code,
      nvl(b.RWA_CR_TSK,0) RWA_CR_TSK,
      nvl(b.RWA_CR_TT1,0) RWA_CR_TT1,
      nvl(b.RWA_OR,0) RWA_OR,
      nvl(b.RWA_CR_TT2,0) RWA_CR_TT2,
      nvl(b.RWA_MR,0) RWA_MR,
      nvl(a.dtttrr,0) dtttrr,
      nvl(a.dttsrr,0) dttsrr,
      nvl(c.Value_TCS,0) cphd,
      nvl(a.dttsrr,0) + nvl(c.Value_TCS,0) LNTT_CPHD,
      nvl(b.RWA_CR_TT1,0) + nvl(b.RWA_CR_TSK,0) + nvl(b.RWA_OR,0) + nvl(b.RWA_MR,0) + nvl(b.RWA_CR_TT2,0) RWA_TOTAL,
      nvl(b.RWA_CR_TT1,0)*0.11  VONPB_CR_TT1,
      nvl(b.RWA_CR_TSK,0)*0.11  VONPB_CR_TSK,
      nvl(b.RWA_OR,0)*0.11 VONPB_OR,
      nvl(b.RWA_CR_TT2,0)*0.11 VONPB_CR_TT2,
      nvl(b.RWA_MR,0)*0.11 VONPB_MR,
      (nvl(b.RWA_CR_TT1,0) + nvl(b.RWA_CR_TSK,0) + nvl(b.RWA_OR,0) + nvl(b.RWA_MR,0) + nvl(b.RWA_CR_TT2,0))*0.11 VONPB_TOTAL
FROM toi_pkkh a
FULL JOIN rwa b
   ON a.khoi = b.KHOI
   AND a.pkkh = b.pkkh
   AND a.product_code = b.product_code
FULL JOIN ETL.MPA_CAL_MPA03_05 c
   ON COALESCE(a.khoi, b.khoi) = c.khoi
   AND COALESCE(a.pkkh, b.pkkh) = c.pkkh
   AND COALESCE(a.product_code, b.product_code) = c.product_code
   AND c.khoi IN ('NHS', 'INDIV', 'CIB', 'SME')</sql>
