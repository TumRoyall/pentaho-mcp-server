  <step>
    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH RWA AS
 (SELECT *
    FROM (SELECT KHOI, TYPE, SUM(RWA) RWA
            FROM ETL.TMP_RWA_PKKH
           WHERE KHOI IN ('NHS', 'INDIV', 'CIB', 'SME', 'TRE')
           GROUP BY KHOI, TYPE)
  PIVOT(SUM(RWA)
     FOR TYPE IN('RWA_CR_TT2' AS RWA_CR_TT2,
                'RWA_MR' AS RWA_MR,
                'RWA_OR' AS RWA_OR,
                'RWA_CR_TSK' AS RWA_CR_TSK,
                'RWA_CR_TT1' AS RWA_CR_TT1))),
PL_KHOI AS
 (SELECT A.KHOI,
         A.DTTTRR + NVL(B.DTTTRR, 0) DTTTRR,
         A.DTTSRR + NVL(B.DTTSRR, 0) DTTSRR
    FROM (SELECT TRANSACTION_DATE,
                 KHOI,
                 SUM(CASE
                       WHEN IDX = 'A' THEN
                        AMOUNT
                       ELSE
                        0
                     END) / 1E9 DTTTRR,
                 SUM(CASE
                       WHEN IDX = 'C' THEN
                        AMOUNT
                       ELSE
                        0
                     END) / 1E9 DTTSRR
            FROM (SELECT TRANSACTION_DATE, KHOI, IDX, AMOUNT
                    FROM APPS.MB_TR_PL_KHOI UNPIVOT(AMOUNT FOR KHOI IN(TREASURY AS
                                                                       'TRE',
                                                                       INDIV AS
                                                                       'INDIV',
                                                                       CIB AS
                                                                       'CIB',
                                                                       SMES AS
                                                                       'SME',
                                                                       NHS AS
                                                                       'NHS',
                                                                       FI AS
                                                                       'TRE'))
                   WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD'))
           GROUP BY TRANSACTION_DATE, KHOI) A
    LEFT JOIN ETL.FILE_RAROC_DC_CHITIEU B
      ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
     AND A.KHOI = B.KHOI
     AND B.PKKH IS NULL),
CPHD AS
 (SELECT A.KHOI, A.CPHD_SCS + B.CPHD CPHD
    FROM ETL.MPA_CAL_MPA01 A
    LEFT JOIN ETL.FILE_RAROC_DC_CHITIEU B
      ON A.TRANSACTION_DATE = B.TRANSACTION_DATE
     AND A.KHOI = B.KHOI
     AND B.PKKH IS NULL)
SELECT TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
       A.KHOI,
       NVL(B.RWA_CR_TSK, 0) RWA_CR_TSK,
       NVL(B.RWA_CR_TT1, 0) RWA_CR_TT1,
       NVL(B.RWA_OR, 0) RWA_OR,
       NVL(B.RWA_CR_TT2, 0) RWA_CR_TT2,
       NVL(B.RWA_MR, 0) RWA_MR,
       NVL(A.DTTTRR, 0) DTTTRR,
       NVL(A.DTTSRR, 0) DTTSRR,
       NVL(C.CPHD, 0) CPHD,
       NVL(A.DTTSRR, 0) + NVL(C.CPHD, 0) LNTT_CPHD,
       NVL(B.RWA_CR_TT1, 0) + NVL(B.RWA_CR_TSK, 0) + NVL(B.RWA_OR, 0) +
       NVL(B.RWA_MR, 0) + NVL(B.RWA_CR_TT2, 0) RWA_TOTAL,
       NVL(B.RWA_CR_TT1, 0) * 0.11 VONPB_CR_TT1,
       NVL(B.RWA_CR_TSK, 0) * 0.11 VONPB_CR_TSK,
       NVL(B.RWA_OR, 0) * 0.11 VONPB_OR,
       NVL(B.RWA_CR_TT2, 0) * 0.11 VONPB_CR_TT2,
       NVL(B.RWA_MR, 0) * 0.11 VONPB_MR,
       (NVL(B.RWA_CR_TT1, 0) + NVL(B.RWA_CR_TSK, 0) + NVL(B.RWA_OR, 0) +
       NVL(B.RWA_MR, 0) + NVL(B.RWA_CR_TT2, 0)) * 0.11 VONPB_TOTAL
  FROM PL_KHOI A
  LEFT JOIN RWA B
    ON A.KHOI = B.KHOI
  LEFT JOIN CPHD C
    ON A.KHOI = C.KHOI</sql>
