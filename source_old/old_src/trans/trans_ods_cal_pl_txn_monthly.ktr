    <sql>SELECT *
FROM   APPS.MB_TR_SAOKE_DIEUCHINH DC
WHERE   LAST_DAY(DC.SEL_DATE)=  TO_DATE('${PRD_ID}','yyyyMMdd')
AND DC.HACH_TOAN_VND &lt;&gt; 0
</sql>
