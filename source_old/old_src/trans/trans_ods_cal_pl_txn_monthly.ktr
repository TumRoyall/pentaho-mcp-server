  <step>
    <name>APPS.TR_CHOVAY_BQ</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>SELECT TRANSACTION_DATE,
       'LOAN' D_TYPE,
       SOTK,
       MAKH,
       NTE,
       CN,
       KHOI,
       SUM(SODU) BALANCE,
       SUM(SODU_VND) BALANCE_VND,
       SUM(SODU * LS * TO_NUMBER(SUBSTR(TO_CHAR(TRANSACTION_DATE, 'YYYYMMDD'), 7, 2)) / 365) NOMINAL_INTEREST,
       SUM(SODU_VND * LS * TO_NUMBER(SUBSTR(TO_CHAR(TRANSACTION_DATE, 'YYYYMMDD'), 7, 2)) / 365) NOMINAL_INTEREST_VND
  FROM APPS.TR_CHOVAY_BQ
 WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
 GROUP BY TRANSACTION_DATE, SOTK, MAKH, NTE, CN, KHOI</sql>
    <limit>0</limit>
    <lookup/>
