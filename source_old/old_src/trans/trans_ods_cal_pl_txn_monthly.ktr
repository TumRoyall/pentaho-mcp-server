  <step>
    <name>APPS.MB_TR_SK_TPDN_BQ_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>WITH ORS_TPDN_BQ AS (
SELECT
    TRANS_DATE TRANSACTION_DATE,
    BONDS_DEALS,
    BONDS,
    SHORT_NAME,
    OPERATION,
    TYPE,
    BONDS_DEALS_SECOND,
    PORTFOLIOS,
    VALUE_DATE,
    ISSUE_DATE,
    MATURITY_DATE,
    CURRENCY,
    RATE,
    FREQ,
    COMPANY_BUY,
    COMPANY,
    CUSTOMER_MIS,
    ISSUER,
    ISSUER_NAME,
    ISSUER_KHOI,
    ISSUER_SECTOR,
    COA,
    PRODUCT_CODE,
    CUSTOMER_MIS_NAME,
    KYHANFTP,
    BONDS_TYPE,
    SUM (NVL (FACE_AMOUNT,0) + NVL (CKPT_CONLAI,0)) TPDN_BQ_VND
FROM APPS.MB_TR_SK_TPDN_BQ_DAILY
WHERE TRANS_DATE = TO_DATE ('${PRD_ID}', 'YYYYMMDD')
GROUP BY
    TRANS_DATE,
    BONDS_DEALS,
    BONDS,
    SHORT_NAME,
    OPERATION,
    TYPE,
    BONDS_DEALS_SECOND,
    PORTFOLIOS,
    VALUE_DATE,
    ISSUE_DATE,
    MATURITY_DATE,
    CURRENCY,
    RATE,
    FREQ,
    COMPANY_BUY,
    COMPANY,
    CUSTOMER_MIS,
    ISSUER,
    ISSUER_NAME,
    ISSUER_KHOI,
    ISSUER_SECTOR,
    COA,
    PRODUCT_CODE,
    CUSTOMER_MIS_NAME,
    KYHANFTP,
    BONDS_TYPE 
)
SELECT TRANSACTION_DATE,
       'BOND' D_TYPE,
       BONDS_DEALS SOTK,
       ISSUER MAKH,
       CURRENCY NTE,
       COMPANY CN,
       ISSUER_KHOI KHOI,
       SUM(NVL(TPDN_BQ_VND, 0)) BALANCE,
       SUM(NVL(TPDN_BQ_VND, 0)) BALANCE_VND,
       SUM(NVL(TPDN_BQ_VND, 0) * RATE * TO_NUMBER(SUBSTR(TO_CHAR(TRANSACTION_DATE, 'YYYYMMDD'), 7, 2)) / 36500) NOMINAL_INTEREST,
       SUM(NVL(TPDN_BQ_VND, 0) * RATE * TO_NUMBER(SUBSTR(TO_CHAR(TRANSACTION_DATE, 'YYYYMMDD'), 7, 2)) / 36500) NOMINAL_INTEREST_VND
  FROM ORS_TPDN_BQ
 WHERE 1 = 1
 GROUP BY TRANSACTION_DATE,
          BONDS_DEALS,
          ISSUER,
          CURRENCY,
          COMPANY,
          ISSUER_KHOI</sql>
