  <step>
    <name>SMY.PL_TXN_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT T.*, SUM(T.FCY_AMT) AMT, SUM(T.LCY_AMT) AMT_VND
  FROM (SELECT LAST_DAY(A.TXN_DATE) TRANSACTION_DATE,
               A.T24_CUST_ID MAKH,
               A.PL_CATE_CODE PL_CATEG,

		/*
	ngapt.os
	creat_date: 20250213
	jira: YCPT-23500
	thay doi mapping truong SCT, loai bo dieu kien SUBSTR(A.REPORT_ITEM_CODE, 1, 5) = 'A1223'

*/



               --A.RELATION_TXN_NBR SCT,
				case when SUBSTR(COA_CODE, 1, 1) = '7' then nvl(a.ARRANGEMENT_NBR, a.RELATION_TXN_NBR) ELSE a.RELATION_TXN_NBR END SCT,
               A.COA_CODE GL,
               A.BRANCH_CODE CN,
               A.GL_LINE LINE_GL,
               A.FCY_AMT,
               A.LCY_AMT,
               A.CURRENCY_CODE NTE,
               CASE
                 WHEN UPPER(A.REPORT_DIVISION_CODE) = 'SMES' THEN
                  'SME'
                 WHEN UPPER(A.REPORT_DIVISION_CODE) = 'COST CENTER' THEN
                  'NHS'
                 ELSE
                  A.REPORT_DIVISION_CODE
               END KHOI,
               NVL(A.CHG_PRODUCT_CODE, A.ARRANGEMENT_PRODUCT_CODE) PRODUCT_CODE
          FROM SMY.PL_TXN_DAILY A
         WHERE A.TXN_DATE BETWEEN
               TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'), 'MM') AND
               LAST_DAY(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
           AND SUBSTR(COA_CODE, 1, 1) IN ('7', '8')
           AND A.SOURCE_TABLE_NAME &lt;&gt; 'SMY.ACG_LINE_TXN_DAILY'
           AND A.PL_CATE_CODE &lt;&gt; '67010'
           AND ((PL_CATE_CODE = '52430') OR
               SUBSTR(A.REPORT_ITEM_CODE, 1, 5) IN
               ('A1113', 'A1114', 'A1224'))
			   AND nvl(TXN_CODE,'0') NOT IN ('904','905')) T
 GROUP BY TRANSACTION_DATE,
          MAKH,
          PL_CATEG,
          SCT,
          GL,
          CN,
          LINE_GL,
          FCY_AMT,
          LCY_AMT,
          NTE,
          KHOI,
          PRODUCT_CODE</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
