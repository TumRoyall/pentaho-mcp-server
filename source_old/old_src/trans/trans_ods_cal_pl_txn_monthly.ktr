  <step>
    <name>APPS.FIN_SAOKE_MUANO_BQ_DAILY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT TRANSACTION_DATE,
       'MUA_NO' D_TYPE,
       SOTK,
       MAKH,
       NTE,
       CN,
       KHOI,
       SUM(A.SODU) BALANCE,
       SUM(A.SODU_VND) BALANCE_VND,
       0 NOMINAL_INTEREST,
       0 NOMINAL_INTEREST_VND
  FROM APPS.FIN_SAOKE_MUANO_BQ_DAILY A
 WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
 GROUP BY TRANSACTION_DATE, SOTK, MAKH, NTE, CN, KHOI</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
