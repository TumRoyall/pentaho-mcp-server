  <step>
    <name>Table input 2 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>WITH CRD AS (
    SELECT T24_CUSTOMER_CODE MAKH,
        CARD_ID,
        STT_THE,
        ROW_NUMBER() OVER(
            PARTITION BY T24_CUSTOMER_CODE
            ORDER BY RANK_STT
        ) AS RN
    FROM -- MAP LAI STATUS CUA THE, RANK LAY THU TU UU TIEN LAY STATUS CHO TUNG KHACH HANG
        (
            SELECT T24_CUSTOMER_CODE,
                CARD_ID,
                CASE
                    WHEN CARD_STATUS IN ('THE_SAN_SANG_SU_DUNG', 'THE_KHOA_TAM_THOI') THEN 'SSHD'
                    WHEN CARD_STATUS IN ('THE_DA_KICH_HOAT_CHUA_SAN_SANG_SU_DUNG') THEN 'KICH_HOAT'
                    WHEN CARD_STATUS IN (
                        'THE_DONG',
                        'THE_HET_HAN_SU_DUNG',
                        'THE_KHOA_VINH_VIEN'
                    ) THEN 'NGUNG_SU_DUNG'
                    WHEN CARD_STATUS IN (
                        'THE_CHUA_KICH_HOAT',
                        'THE_TRONG_QUA_TRINH_PHAT_HANH'
                    ) THEN 'CHUA_SU_DUNG'
                END AS STT_THE,
                CASE
                    WHEN CARD_STATUS IN ('THE_SAN_SANG_SU_DUNG', 'THE_KHOA_TAM_THOI') THEN 1
                    WHEN CARD_STATUS IN ('THE_DA_KICH_HOAT_CHUA_SAN_SANG_SU_DUNG') THEN 2
                    WHEN CARD_STATUS IN (
                        'THE_DONG',
                        'THE_HET_HAN_SU_DUNG',
                        'THE_KHOA_VINH_VIEN'
                    ) THEN 3
                    WHEN CARD_STATUS IN (
                        'THE_CHUA_KICH_HOAT',
                        'THE_TRONG_QUA_TRINH_PHAT_HANH'
                    ) THEN 4
                END AS RANK_STT
            FROM ETL.ORS_NHS_KPI_CREDIT_CARD_NOW_TMP
        )
),
DB AS (
    SELECT T24_CUSTOMER_CODE MAKH,
        CARD_ID,
        STT_THE,
        ROW_NUMBER() OVER(
            PARTITION BY T24_CUSTOMER_CODE
            ORDER BY RANK_STT
        ) AS RN
    FROM -- MAP LAI STATUS CUA THE, RANK LAY THU TU UU TIEN LAY STATUS CHO TUNG KHACH HANG
        (
            SELECT T24_CUSTOMER_CODE,
                CARD_ID,
                CASE
                    WHEN CARD_STATUS IN ('THE_SAN_SANG_SU_DUNG', 'THE_KHOA_TAM_THOI') THEN 'SSHD'
                    WHEN CARD_STATUS IN ('THE_DA_KICH_HOAT_CHUA_SAN_SANG_SU_DUNG') THEN 'KICH_HOAT'
                    WHEN CARD_STATUS IN (
                        'THE_DONG',
                        'THE_HET_HAN_SU_DUNG',
                        'THE_KHOA_VINH_VIEN'
                    ) THEN 'NGUNG_SU_DUNG'
                    WHEN CARD_STATUS IN (
                        'THE_CHUA_KICH_HOAT',
                        'THE_TRONG_QUA_TRINH_PHAT_HANH'
                    ) THEN 'CHUA_SU_DUNG'
                END AS STT_THE,
                CASE
                    WHEN CARD_STATUS IN ('THE_SAN_SANG_SU_DUNG', 'THE_KHOA_TAM_THOI') THEN 1
                    WHEN CARD_STATUS IN ('THE_DA_KICH_HOAT_CHUA_SAN_SANG_SU_DUNG') THEN 2
                    WHEN CARD_STATUS IN (
                        'THE_DONG',
                        'THE_HET_HAN_SU_DUNG',
                        'THE_KHOA_VINH_VIEN'
                    ) THEN 3
                    WHEN CARD_STATUS IN (
                        'THE_CHUA_KICH_HOAT',
                        'THE_TRONG_QUA_TRINH_PHAT_HANH'
                    ) THEN 4
                END AS RANK_STT
            FROM ETL.ORS_NHS_KPI_DEBIT_CARD_NOW
        )
),
QR AS (
    SELECT Y.MAKH,
        '1' QR_IND
    FROM ETL.ODS_APIGW_USER_QR_CFG X
        LEFT JOIN ETL.ODS_CASA_CONTRACT Y ON X.ACCT_NO = Y.ARRANGEMENT_NBR
    GROUP BY Y.MAKH
),
IB_SME AS (
    SELECT CST_CODE MAKH
    FROM ETL.DWH_CST_SEG_TVR
    WHERE IVSM_AMT > 0
    GROUP BY CST_CODE
)
SELECT A.TXN_DATE TRANSACTION_DATE,
    A.T24_CUST_ID MAKH,
    A.PARTY_FULL_NAME HOTEN,
    A.DIVISION_CODE KHOI,
    A.SECTOR_CODE SECTOR,
    A.CONTACT_DATE CREATION_DATE,
    nvl(D.FIRST_LOGIN_DATE_APP, A.FIRST_LOGIN_DATE)  FIRST_LOGIN_DATE_APP,
    A.BRANCH_CODE CN,
    CASE
        WHEN A.DIVISION_CODE = 'CIB' THEN
            CASE
                WHEN A.T24_CUST_ID IN (
                    SELECT DISTINCT MAKH
                    FROM ETL.FILE_CIB_KH_DUAN) THEN 'IB'
                WHEN A.SECTOR_CODE IN ('3035', '3535') THEN 'FDI'
                ELSE 'PTKD'
            END
        WHEN A.DIVISION_CODE = 'SME' THEN decode(
            B.STANDARD_SEGMENT_NAME,
            'SME_MICRO',
            'SIEUNHO',
            'SME_SMALL',
            'NHO',
            'SME_MEDIUM',
            'VUA',
            'KXD'
        )
        WHEN A.DIVISION_CODE IN ('INDIV', 'NHS') THEN
            CASE
                WHEN A.SECTOR_CODE IN ('1688','1689','1690','1691','1699','1666','1660') THEN 'PRIVATE'
                WHEN A.SEGMENT_CODE = '3' THEN 'PRIORITY-E'
                WHEN A.SEGMENT_CODE = '4' THEN 'PRIORITY-H'
                WHEN A.SEGMENT_CODE = '5' THEN 'PRIORITY-F'
                ELSE 'MASS'
            END
        WHEN A.DIVISION_CODE = 'DVC' THEN DECODE(
            A.SECTOR_CODE,
            '1095',
            'BHXH VN',
            '1096',
            'BHXH BQP',
            '1097',
            'KBNN',
            '1098',
            'Du an ODA',
            '1099',
            'Bo ban nganh',
            'DVC'
        )
        ELSE NVL(A.DIVISION_CODE, 'KXD')
    END PHAN_KHUC,
    CASE
        WHEN A.DIVISION_CODE = 'CIB'
        AND A.T24_CUST_ID IN (
            SELECT DISTINCT MAKH
            FROM ETL.FILE_CIB_KH_DUAN
        ) THEN 1
        WHEN A.DIVISION_CODE = 'SME'
        AND H.MAKH is not null THEN 1
        ELSE 0
    END AS IS_KH_DUAN,
    NVL(G.QR_IND, '0') IS_VIETQR,
    A.ACTIVE_STATUS CUS_STATUS,
    --KH MOI CO CREATION_DATE TRONG THANG
    CASE
        WHEN TO_CHAR(LAST_DAY(A.CONTACT_DATE), 'yyyymmdd') = TO_CHAR(A.TXN_DATE, 'yyyymmdd') THEN 1
        ELSE 0
    END IS_NEW_CUST,
    A.EB_USED_STATUS APP_BIZ_STATUS,
    --KH APP/BIZ MOI CO FIRST_LOGIN_DATE_APP TRONG THANG
    CASE
        WHEN TO_CHAR(LAST_DAY(D.FIRST_LOGIN_DATE_APP), 'yyyymmdd') = TO_CHAR(A.TXN_DATE, 'yyyymmdd') THEN 1
        ELSE 0
    END AS IS_NEW_APP_BIZ,
    CASE
        WHEN A.SECTOR_CODE IN ('1917', '1906') THEN 'LEVEL1'
        WHEN A.SECTOR_CODE IN ('1918', '1907') THEN 'LEVEL2'
        ELSE 'LEVEL3'
    END AS KYC_LEVEL,
    C.PARENT_BRANCH_CODE_T24 CNC1,
    C.TINH_THANH,
    C.VUNG_MIEN,
    C.TIEU_VUNG,
    E.STT_THE CREDIT_CARD_STATUS,
    F.STT_THE DEBIT_CARD_STATUS,
    A.INDUSTRY_CODE,
    A.CREDIT_RATING NHOMNO_XHTD,
    A.BAAS_IND,
    A.BANKHUB_IND,
    A.BANKHUB_ACTIVE_IND,
    A.CHANNEL_CODE,
    A.BAAS_ACTIVE_IND,
    A.SOURCE_GROUP_CHANNEL,
    A.LAST_LOGIN_DATE LAST_LOGIN_DATE_APP,
    decode(A.KH_TIEUTHUONG_IND, 'N', 0, 'Y', 1) IS_TIEUTHUONG,
    decode(A.EB_USED_IND, 'N', 0, 'Y', 1) IS_APP_BIZ
FROM ETL.ODS_CUST_INFO_MTH A
LEFT JOIN ETL.ODS_CUST_SEGMENT_DAILY B
    ON A.T24_CUST_ID = B.T24_CUST_ID
    AND B.PARTY_TYPE_CODE = 'CUS'
LEFT JOIN ETL.REF_AICT_BRANCH_M_TMP C ON C.TRANSACTION_DATE = A.TXN_DATE
    AND A.BRANCH_CODE = C.BRANCH_CODE_T24
LEFT JOIN (
        SELECT HOST_CIF_ID MAKH,
            MIN(OPEN_APP_DATE) FIRST_LOGIN_DATE_APP
        FROM ETL.ORS_NHS_EMB_USER_KPI
        GROUP BY HOST_CIF_ID
    ) D
    ON A.T24_CUST_ID = D.MAKH --2 BANG THE LAY RECORD DAU CUA TUNG KH THEO RANK
LEFT JOIN CRD E ON A.T24_CUST_ID = E.MAKH
    AND E.RN = 1
LEFT JOIN DB F ON A.T24_CUST_ID = F.MAKH
    AND F.RN = 1
LEFT JOIN QR G ON A.T24_CUST_ID = G.MAKH
LEFT JOIN IB_SME H ON A.T24_CUST_ID = H.MAKH
WHERE A.TXN_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
