    <connection>ors_dc</connection>
    <sql>select
  SOTK,
  t.CATEGORY,
  REF,
  MAKH,
  TENKH,
  t.SECTOR,
  INDUSTRY_CODE,
  NTE,
  SODU,
  NGAYBATDAU,
  NGAYHIEULUC,
  NGAYDAOHAN,
  PHIBAOLANH,
  KYQUY,
  SOTIENKYQUY,
  CN,
  MATHUHUONG,
  TENTHUHUONG,
  UPDATE_LIMIT,
  PROVISION,
  KYQUY_FLAG,
  KYQUY2,
  LIQUIDATION_MODE,
  LOAIPHI,
  TANSUAT,
  TUDONGDAOHAN,
  NONAME,
  CONSOL_KEY,
  t.TRANSACTION_DATE,
  KHOI,
  MASP,
  TENSP,
  CMS_DATE,
  CMS_AMT,
  CSN_FREQ,
  DIENGIAI,
  SOBLBANDAU,
  SODU_VND,
  TYGIA,
  RM_CODE,
  t.PRODUCT_CODE,
  MBLD_TYPE,
  MD_AC_OFF,
  CUS_AC_OFF,
  RM_BANCHEO,
  MD_REF,
  UOL,
  Y_GUARANTEE_REF,
  BP_THAMDINH,
  LIMIT_REF,
  Y_NGAYTH_KSS,
  Y_NGAYHT_KSS,
  BL_DB,
  LOAI_BL,
  KYQUY_BL,
  BL_DB_NOTE,
  LOAI_BL_DESC,
  KYQUY_BL_DESC,
  PRODUCT_GR,
  PRODUCT_TYPE,
  BC_NHNN,
  Y_MA_BPM,
  Y_PROJECT_ID,
  Y_LEGACY_ID,
  Y_TMP_MAT_DATE,
  PROJECT_ID,
  (
    case
      when b.SP_DV in ('SPSO', 'DVSO', 'SPS1', 'DVS1') then 'ONLINE'
      else 'QUAY'
    END
  ) KENH_GD,
  row_number () over (
    partition by t.SOTK
    order by
      t.SODU desc
  ) RANK_NUM
from
  apps.TR_MD t
  left join apps.mb_product_code b on t.PRODUCT_CODE = b.product_code
where
  t.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')</sql>
