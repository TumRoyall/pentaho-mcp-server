  <step>
    <name>MB_TR_MD_TATTOAN</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select t.* ,
(case when b.SP_DV in ('SPSO', 'DVSO', 'SPS1', 'DVS1') then 'ONLINE' else 'QUAY' END) KENH_GD,
row_number () over (partition by t.SOTK order by t.SODU desc) RANK_NUM
from apps.MB_TR_MD_TATTOAN t
left join apps.mb_product_code b
on t.PRODUCT_CODE = b.product_code
where t.transaction_date  = to_date ('${PRD_ID}','yyyyMMdd')</sql>
