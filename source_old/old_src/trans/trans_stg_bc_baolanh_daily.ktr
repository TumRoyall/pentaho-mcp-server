  <step>
    <name>TR_THLK</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>SELECT
  MATK,
  POSTDATE,
  MAKH,
  TENKH,
  ACCTNBR,
  SCT,
  TKNO,
  TKCO,
  TIENNO,
  TELLER,
  DESCRIPTION,
  CURRENCYCD,
  MJ,
  MI,
  SOURCE,
  CASHBOXNBR,
  RTXNTYPCD,
  REF,
  LINE_T24,
  DEPARTMENT,
  RATE,
  INDUSTRY_CODE,
  SECTOR,
  KHOI,
  SOURCE_OF_FUND,
  MAGD,
  MUCDICHVAY,
  TRANSACTION_REF,
  SOURCE_IMPORT,
  IMPORT_DATE,
  ENTRY_ID,
  CONSOL_KEY,
  ACCOUNT_OFFICER,
  INPUTTER_NAME,
  AUTHORISE_ID,
  AUTHORISE_NAME,
  LOC_TERM,
  APP_ID,
  NARR,
  OPEN_DATE,
  ACCT_TYPE,
  PRODUCT_CODE,
  LD_CO_CODE,
  KIEMNGAN_ID,
  KIEMNGAN_NAME,
  KIEMNGAN_CHUCDANH,
  REVERSAL_MARKER,
  ID_LINE,
  RECORD_STATUS,
  USER_AUTH_FULL,
  MA_BPM,
  Y_NBC_COA,
  Y_DESC,
  Y_DR_CR,
  Y_ENTRY_FILE,
  Y_PCC,
  Y_VALUE_DATE
FROM
  APPS.TR_THLK PARTITION FOR (TO_DATE('${PRD_ID}', 'YYYYMMDD'))
WHERE
  (RTXNTYPCD IN ('955', '957')
  and substr (nvl (TKNO, TKCO), 1, 2) in ('42', '45')
)
  OR (
    nvl (TKNO, TKCO) = '7040'
    and RTXNTYPCD not in ('904', '905')
    and substr (LINE_T24, 7, 4) in ('6002', '6003', '6004', '6005', '6006', '6007')
  )
  OR (
    nvl (TKNO, TKCO) = '3970'
    AND substr (SCT, 1, 2) = 'MD'
    and substr (ACCTNBR, 1, 2) = 'MD'
  )</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
