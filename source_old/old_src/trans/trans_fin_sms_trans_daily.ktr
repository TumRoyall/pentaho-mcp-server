  <step>
    <name>other</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>micro_arc</connection>
    <sql>SELECT TO_DATE('${PRD_ID}','yyyyMMdd') MSG_CREATED_DT,RECEIVER_ID, PARTNER_ID, TELCO, SOURCE_APP_ID, a.MSG_TYPE,a.MSG_TYPE_2,'OTHER' PHANBO, 'OTHER' PHANLOAI, COUNT(ID) SOLUONG, SUM(TOTAL_MESS_SHORT) TOTAL_MESS_SHORT ,msg_type.msg_type_desc, SOURCE
FROM 
other A
LEFT JOIN etl.mb_pm_message_type_info msg_type on  A.MSG_TYPE = msg_type.msg_type
GROUP BY RECEIVER_ID, PARTNER_ID, TELCO, SOURCE_APP_ID, a.MSG_TYPE,a.MSG_TYPE_2, msg_type.msg_type_desc, SOURCE</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <row-meta>
      <value-meta>
        <type>Date</type>
        <storagetype>normal</storagetype>
        <name>MSG_CREATED_DT</name>
        <length>0</length>
        <precision>-1</precision>
        <origin>other</origin>
        <comments>MSG_CREATED_DT</comments>
        <conversion_Mask/>
        <decimal_symbol>.</decimal_symbol>
        <grouping_symbol>,</grouping_symbol>
        <currency_symbol/>
        <trim_type>none</trim_type>
        <case_insensitive>N</case_insensitive>
        <collator_disabled>Y</collator_disabled>
        <collator_strength>0</collator_strength>
