    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>micro_arc</connection>
    <sql>SELECT TO_DATE('${PRD_ID}','yyyyMMdd') MSG_CREATED_DT,RECEIVER_ID, PARTNER_ID, TELCO, SOURCE_APP_ID, a.MSG_TYPE,a.MSG_TYPE_2,A.PHANBO, A.PHANLOAI, COUNT(ID) SOLUONG, SUM(TOTAL_MESS_SHORT) TOTAL_MESS_SHORT ,msg_type.msg_type_desc, SOURCE
FROM 
BUSINESS A
LEFT JOIN etl.mb_pm_message_type_info msg_type on  A.MSG_TYPE = msg_type.msg_type
GROUP BY RECEIVER_ID, PARTNER_ID, TELCO, SOURCE_APP_ID, a.MSG_TYPE,A.PHANBO, A.PHANLOAI,a.MSG_TYPE_2, msg_type.msg_type_desc, SOURCE</sql>
