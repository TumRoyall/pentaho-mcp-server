  <step>
    <name>BDSD_tckt 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>micro_arc</connection>
    <sql>SELECT TO_DATE('${PRD_ID}','yyyyMMdd') MSG_CREATED_DT,RECEIVER_ID, PARTNER_ID, TELCO, SOURCE_APP_ID,a.gtgd, a.MSG_TYPE, a.MSG_TYPE,a.MSG_TYPE_2,a.phanbo, a.phanloai, COUNT(ID) SOLUONG, SUM(TOTAL_MESS_SHORT) TOTAL_MESS_SHORT ,msg_type.msg_type_desc, SOURCE
FROM 
bdsd A
LEFT JOIN etl.mb_pm_message_type_info msg_type on  A.MSG_TYPE = msg_type.msg_type
GROUP BY RECEIVER_ID, PARTNER_ID, TELCO, SOURCE_APP_ID,a.gtgd, a.MSG_TYPE,a.MSG_TYPE_2,a.phanbo, a.phanloai, msg_type.msg_type_desc, SOURCE</sql>
    <limit>0</limit>
