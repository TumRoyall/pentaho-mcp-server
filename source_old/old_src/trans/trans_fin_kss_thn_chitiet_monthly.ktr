    <connection>tckt_dc</connection>
    <sql>with import_2_3 
as 
(
-- import2
SELECT 
A1.transaction_date,
a1.cus_id makh,
a1.cus_name tenkh,
a1.ma_cnc2,
a1.ten_cnc2,
a1.ma_cnc1,
a1.ten_cnc1,
a1.loai_buttoan,
a1.contract_nbr,
a1.arrangement_nbr,
to_date(a1.trans_date,'yyyy-mm-dd') ngay_thuno,
sum(a1.fee_repay_amt) no_thuhoi,
--a1.loai_giaodich loaino_thuhoi,
a1.pl_tinhsothu note_thongtinthuno,
to_date(a1.date_allocation,'yyyy-mm-dd') ngay_bangiao,
a1.company DVXL_MB,
a1.collateral_allocation TSDB,
a1.division_fn khoi_khoanvay,
a1.over90days book_snqh,
a1.pl_allocation_t note_thongtin_bangiao,
a1.bucket_bom bucket_dauky,
a1.bucket_eom bucket_cuoiky,
decode(a1.totung,'Y','1','0') totung,
a1.debt_group_contract_t_1 nhomno,
a1.debt_group_fee debt_type,
a1.project_name no_du_an,
a1.roll_status,
null duno_tinh_rollback,
a1.fee_repay_rate ty_le_phi,
SUM(NVL(a1.fee_repay_pay,0)) phi_thn_phaitra,
a1.fee_form loai_phi,
a1.fee_schedule bieu_phi
FROM ETL.FILE_KSS_THN_FEE_MONTHLY A1
group by 
A1.transaction_date ,
a1.cus_id ,
a1.cus_name ,
a1.ma_cnc2,
a1.ten_cnc2,
a1.ma_cnc1,
a1.ten_cnc1,
a1.loai_buttoan,
a1.contract_nbr,
a1.arrangement_nbr,
to_date(a1.trans_date,'yyyy-mm-dd'),
--a1.loai_giaodich ,
a1.pl_tinhsothu ,
a1.date_allocation ,
a1.company ,
a1.collateral_allocation ,
a1.division_fn ,
a1.over90days ,
a1.pl_allocation_t ,
a1.bucket_bom,
a1.bucket_eom ,
a1.totung,
a1.debt_group_contract_t_1 ,
a1.debt_group_fee ,
a1.project_name ,
a1.roll_status,
a1.fee_repay_rate ,
--a1.fee_repay_pay ,
a1.fee_form ,
a1.fee_schedule
union all
-- import3
SELECT 
a2.transaction_date partition_date,
a2.cus_id makh,
a2.cus_name tenkh,
a2.ma_cnc2,
a2.ten_cnc2,
a2.ma_cnc1,
a2.ten_cnc1,
null loai_buttoan,
null contract_nbr,
null arrangement_nbr,
null ngay_thuno,
null no_thuhoi,
--null loaino_thuhoi,
null note_thongtinthuno,
to_date(a2.date_allocation,'yyyy-mm-dd') ngay_bangiao,
a2.company DVXL_MB,
a2.collateral_allocation TSDB,
a2.division_fn khoi_khoanvay,
a2.over90days book_snqh,
a2.pl_allocation_t note_thongtin_bangiao,
a2.bucket_bom bucket_dauky,
a2.bucket_eom bucket_cuoiky,
'0'totung,
''nhomno,
a2.debt_group_fee debt_type,
''no_du_an,
a2.roll_status,
a2.EXP_BOM duno_tinh_rollback,
a2.FEE_ROLL_RATE ty_le_phi,
SUM(NVL(a2.fee_roll_pay,0)) phi_thn_phaitra,
a2.fee_form loai_phi,
a2.fee_schedule bieu_phi
FROM ETL.FILE_KSS_THN_FEE_ROLL_MONTHLY A2
GROUP BY
a2.transaction_date,
a2.cus_id ,
a2.cus_name ,
a2.ma_cnc2,
a2.ten_cnc2,
a2.ma_cnc1,
a2.ten_cnc1,
to_date(a2.date_allocation,'yyyy-mm-dd'),
a2.company ,
a2.collateral_allocation ,
a2.division_fn ,
a2.over90days,
a2.pl_allocation_t ,
a2.bucket_bom ,
a2.bucket_eom ,
a2.debt_group_fee ,
a2.roll_status,
a2.EXP_BOM ,
a2.FEE_ROLL_RATE,
a2.fee_form ,
a2.fee_schedule 
) 
,
ver_3  as 
(
select 
a.*,
case when a.loai_phi ='THOAI_DUCHI' then 0
    when a.bieu_phi='VIN'  and a.debt_type in ('NOIBANG','NGOAIBANG') and a.DVXL_MB ='MBAMC_XLTT' then 0.15
    else nvl(bp.TYLE_PHI,0) END HT_TY_LE_PHI,
(case when A.loai_phi='PHI_THUHOI_NO' THEN nvl(a.no_thuhoi,0)
        when a.loai_phi='PHI_ROLLBACK' THEN nvl(a.duno_tinh_rollback,0) 
        else 0 end )
*
(case when a.loai_phi ='THOAI_DUCHI' then 0
    when a.bieu_phi='VIN'  and a.debt_type in ('NOIBANG','NGOAIBANG') and a.DVXL_MB ='MBAMC_XLTT' then 0.15
    else nvl(bp.TYLE_PHI,0) END) 
    HT_PHI_THN_PHAITRA
from import_2_3 a
left join ETL.FILE_KSS_THN_BIEUPHI bp
on a.debt_type=bp.ht_pl_noi_ngoaibang
and bp.ht_book = 
    (case when  a.book_snqh IN ('DUOI_90NGAY','DUOI_90_NGAY') then 'DUOI_90NGAY'
        when  a.book_snqh in ('TREN_90NGAY','TREN_90_NGAY') then 'TREN_90NGAY' END)  
and a.khoi_khoanvay =bp.khoi
and nvl(a.tsdb,0)=nvl(bp.ht_tsbd,0)
and a.loai_phi=bp.ht_loai_phi
and a.totung=bp.to_tung
and a.dvxl_mb =bp.dvxl_mb
and nvl(a.bucket_dauky,0)=  nvl(bp.ht_bucket_dauky,0)  
)
select 
v3.*,
case when v3.TY_LE_PHI = v3.HT_TY_LE_PHI then 0 else 1 end SS_TY_LE_PHI,
nvl(V3.PHI_THN_PHAITRA,0) - nvl(V3.ht_phi_thn_phaitra,0) ss_phi_THN_PHAITRA
from ver_3 v3
--where v3.contract_nbr ='056-J0021600'

</sql>
    <limit>0</limit>
    <lookup/>
