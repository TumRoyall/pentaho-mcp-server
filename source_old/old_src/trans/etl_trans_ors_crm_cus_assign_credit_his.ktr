  <step>
    <name>crm_tr_employee_account_ors</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>SELECT X.employee_code,
                X.account_code,
                X.EMPLOYEE_BRANCH,
                to_Date('${PRD_ID}','yyyyMMdd') TRANSACTION_DATE
           FROM (select DENSE_RANK() OVER(PARTITION BY e.account_code, e.EMPLOYEE_BRANCH order by trunc(assigned_date) DESC,EMPLOYEE_ACCOUNT_ID) STT,
                        trunc(assigned_date) assigned_date,
                        e.employee_code,
                        e.account_code,
                        e.EMPLOYEE_BRANCH
          from apps.crm_tr_employee_account e
                  where trunc(assigned_date) &lt;=
                        to_Date(${PRD_ID} , 'yyyyMMdd')
                    and (e.is_owner = 1 or
                         (e.is_owner = 0 and
                         trunc(e.end_date) >=
                         to_Date(${PRD_ID} , 'yyyyMMdd') + 1))
                    and e.account_code is not null
                    and e.employee_code is not null
                    and e.account_id is not null
                  group by e.employee_code,
                           e.account_code,
                           e.EMPLOYEE_BRANCH,
                           trunc(assigned_date),
              EMPLOYEE_ACCOUNT_ID
                  ORDER BY trunc(assigned_date) DESC) x
          WHERE X.STT = 1
         and x.employee_code in 
                        (select rm from  ETL.SMB_RM_ID)  -- bảng này ở engine 
          GROUP BY X.employee_code,
                   X.account_code,
                   X.EMPLOYEE_BRANCH</sql>
    <limit>0</limit>
