    <name>CRM_CUS_ASSIGN_CREDIT_HIS</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>SELECT * 
		FROM 
		(
		SELECT b.*, 
		ROW_NUMBER () OVER (PARTITION BY b.CONTRACT_NUMBER ORDER BY b.ASSIGNED_DATE desc) rn
		FROM etl.CRM_CUS_ASSIGN_CREDIT_HIS b
		WHERE TO_DATE(${PRD_ID}, 'YYYYMMDD') between b.ASSIGNED_DATE and nvl (b.END_DATE, '31-DEC-2999') - 1
				AND b.IS_ACTIVE='1'
				) a
				WHERE a.rn = '1' </sql>
    <limit>0</limit>
    <lookup/>
