  <step>
    <name>FTP_CHUNGCHI_TG_ONLINE_THUCAP</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select
to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
CD_ID,
CI_ID,
MAKH_SOCAP,
MAKH_THUCAP,
CURRENCY,
sum (LAI_SOCAP) LAI_THUCAP,
sum (FTP_SOCAP) FTP_THUCAP
from
(select 
KEY CD_ID,
CI_ID, 
ASSIGNEE MAKH_SOCAP,
ASSIGNER MAKH_THUCAP,
CURRENCY,
LAI_SOCAP,
FTP_SOCAP 
from apps.FTP_CHUNGCHI_TG_ONLINE_THUCAP
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') and to_date ('${PRD_ID}', 'YYYYMMDD')
UNION ALL
SELECT
KEY CD_ID,
CI_ID,
ASSIGNEE MAKH_SOCAP,
ASSIGNER MAKH_THUCAP,
CURRENCY,
LAI_SOCAP_BS,
FTP_SOCAP_BS
FROM APPS.FTP_CD_ONLINE_THUCAP_BS
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH') and to_date ('${PRD_ID}', 'YYYYMMDD'))
group by
CD_ID,
CI_ID,
MAKH_SOCAP,
MAKH_THUCAP,
CURRENCY</sql>
