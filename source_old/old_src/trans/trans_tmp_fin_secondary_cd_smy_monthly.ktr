    <sql>SELECT RPT_DATE,
DATE_TIME,
BRANCH_CODE,
PARENT_BRANCH_CODE,
KEY CD_ID,
REF_ID,
OPERATION,
CI_ID,
PRIMARY_INTEREST_RATE,
PRIMARY_TERM,
ASSIGNEE,
ASSIGNEE_NAME,
ASSIGNER,
ASSIGNER_NAME,
ASSIGNER_SECTOR,
ASSIGNER_BRANCH_CODE,
ASSIGNER_LOB,
QUANTITY,
FACE_AMOUNT,
GROSS_AMOUNT,
CURRENCY,
TO_DATE(VALUE_DATE, 'YYYYMMDD') VALUE_DATE,
TERM,
TO_DATE(MAT_DATE, 'YYYYMMDD') MAT_DATE,
INTEREST_RATE,
EARLY_RATE,
CURRENT_ACCOUNT,
CUSTOMER_ACCOUNT,
CF_ID,
FT_REF,
RM_ID,
CHANNEL 
FROM RPT.RPT_CD_DEALS_HD30
WHERE RPT_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')</sql>
    <limit>0</limit>
