  <step>
    <name>MB_TR_CD_BQ_LK</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ors_dc</connection>
    <sql>select
to_date ('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
CD_CONTRACT CD_ID,
CI_ID,
MAKH,
CURRENCY,
TERM,
INTEREST_RATE,
RM_CODE,
CURRENT_ACCOUNT,
sum (nvl (SODU,0) * to_char (TRANSACTION_DATE, 'DD')/ to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')) SODU_CD_BQ_LK,
sum (nvl (SODU_VND,0) * to_char (TRANSACTION_DATE, 'DD')/ to_char (to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')) SODU_CD_BQ_LK_VND
from etl.MB_TR_CD_BQ_DAILY
where TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') and to_date ('${PRD_ID}', 'YYYYMMDD')
and TRANSACTION_DATE = last_day (TRANSACTION_DATE)
group by
CD_CONTRACT,
CI_ID,
MAKH,
CURRENCY,
TERM,
INTEREST_RATE,
RM_CODE,
CURRENT_ACCOUNT</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
