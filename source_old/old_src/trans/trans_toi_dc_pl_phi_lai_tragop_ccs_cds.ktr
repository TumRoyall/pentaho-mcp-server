  <step>
    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>SELECT 
NULL PHAN_LOAI_THE,
NULL LOAI_GIAO_DICH,
NULL SECTOR_CODE,
NULL CHG_CODE,
t1.branch_code MA_CN,
t1.T24_CUST_ID MAKH,
t1.division_code KHOI,
t1.LCY_AMT TIENNO,
'DC THOAI PHI THE TD TC' SOURE_IMPORT,
t1.PL_PRODUCT_CODE PRODUCT_CODE,
last_day (t1.txn_date) PARTITION_DATE,
t1.LCY_AMT TIENNO_VND,
NULL BIN8,
NULL BIN6,
t1.PL_CATE_CODE ACCTNBR,
'GLSCB.602904'  LINE_T24, -- chinh
'602904'  LINE_GL, -- chinh
t1.coa_code TK,
t2.SECTOR,
t2.PHAN_KHUC PKKH,
t1.ARRANGEMENT_NBR SCT
--t1.TXN_DATE
FROM etl.CDT_PL_CARD_FEE_TXN_DAILY  t1
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY t2
ON t2.TRANSACTION_DATE = TO_DATE (${PRD_ID}, 'YYYYMMDD') AND t1.t24_cust_id = t2.MAKH 
WHERE TXN_DATE BETWEEN TRUNC (TO_DATE (${PRD_ID}, 'YYYYMMDD'), 'MONTH') AND TO_DATE (${PRD_ID}, 'YYYYMMDD')
AND SOURCE_TYPE IN ('N14', 'N15', 'N16')
UNION ALL 
SELECT 
NULL PHAN_LOAI_THE,
NULL LOAI_GIAO_DICH,
NULL SECTOR_CODE,
NULL CHG_CODE,
t1.branch_code MA_CN,
t1.T24_CUST_ID MAKH,
t1.division_code KHOI,
t1.LCY_AMT TIENNO,
'DC PHI TRA GOP TC' SOURE_IMPORT,
t1.PL_PRODUCT_CODE PRODUCT_CODE,
last_day (t1.txn_date) PARTITION_DATE,
t1.LCY_AMT TIENNO_VND,
NULL BIN8,
NULL BIN6,
t1.PL_CATE_CODE ACCTNBR,
'GLSCB.606200' LINE_T24, -- chinh
'606200'  LINE_GL, -- chinh
t1.coa_code TK,
t2.SECTOR,
t2.PHAN_KHUC PKKH,
t1.ARRANGEMENT_NBR SCT
--t1.TXN_DATE
FROM etl.CDT_PL_CARD_FEE_TXN_DAILY  t1
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY t2
ON t2.TRANSACTION_DATE = TO_DATE (${PRD_ID}, 'YYYYMMDD') AND t1.t24_cust_id = t2.MAKH 
WHERE TXN_DATE BETWEEN TRUNC (TO_DATE (${PRD_ID}, 'YYYYMMDD'), 'MONTH') AND TO_DATE (${PRD_ID}, 'YYYYMMDD')
AND SOURCE_TYPE IN ('N20')</sql>
