    <connection>tckt_dc</connection>
    <sql>SELECT 
NULL PHAN_LOAI_THE,
NULL LOAI_GIAO_DICH,
NULL SECTOR_CODE,
NULL CHG_CODE,
t1.branch_code MA_CN,
t1.T24_CUST_ID MAKH,
t1.division_code KHOI,
t1.AMT_SBV_7020 TIENNO,
'DC THOAI LAI THE TD TC' SOURE_IMPORT,
t1.PL_PRODUCT_CODE PRODUCT_CODE,
last_day (t1.txn_date) PARTITION_DATE, -- lay ngay cuoi cung cua thang
t1.AMT_SBV_7020 TIENNO_VND,
NULL BIN8,
NULL BIN6,
t1.CATE_CODE_7020 ACCTNBR,
CASE WHEN t1.division_code IN ('INDIV','KHCN') THEN 'GLSCB.595200' 
   WHEN t1.division_code = 'SME' THEN 'GLSCB.595100'
   WHEN t1.division_code = 'CIB' THEN 'GLSCB.595300' end LINE_T24,
CASE WHEN t1.division_code IN ('INDIV','KHCN') THEN '595200' 
   WHEN t1.division_code = 'SME' THEN '595100'
   WHEN t1.division_code = 'CIB' THEN '595300' end  LINE_GL,
'7110' TK,
T2.SECTOR,
T2.PHAN_KHUC PKKH,
t1.ARRANGEMENT_NBR SCT
FROM ETL.cdt_PL_CARD_INT_TXN_DAILY  t1
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY t2
ON t2.TRANSACTION_DATE = TO_DATE (${PRD_ID}, 'YYYYMMDD') AND t1.t24_cust_id = t2.MAKH 
WHERE T1.SOURCE_TYPE IN ('N1','N2','N5')</sql>
