  <step>
    <name>--d) Input ETL.TMP_F2B_PNL_FX</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--d) Input ETL.TMP_F2B_PNL_FX --APPS.REP_FTP_F2B_PNL_FX
SELECT TRANS_DATE TRANSACTION_DATE,
   DEALID sotk,
   CUS_ID makh,
   CO_CODE cn,
   a.PRODUCT_CODE,
   NULL linegl,
   NULL PLCATEGORY,
   NULL FTP_CODE,
   khoi,
   sum(AMOUNT) LCY_AMT,
   NULL chg_code,
    'ETL.TMP_F2B_PNL_FX' SOURCE_TABLE,
    'TRE' KHOI_THEOPLKHOI,
    'A3532' CHITIEU_PLKHOI,
    'Thu KDNT' CHITIEU_PLKHOI_NAME,
    b.SP_DV,
    'KDNT' SPSO_TYPE,
   'O2O' product_type,
    sum(AMOUNT) LCY_AMT
from ETL.TMP_F2B_PNL_FX a
left join ETL.ORS_MB_PRODUCT_CODE b
   on a.PRODUCT_CODE = b.PRODUCT_CODE
where PHAN_LOAI = 'KENHSO'
GROUP BY TRANS_DATE,
   DEALID,
   khoi,
   CUS_ID,
   CO_CODE,
   a.PRODUCT_CODE,
  -- khoi_chot,
    b.SP_DV
</sql>
