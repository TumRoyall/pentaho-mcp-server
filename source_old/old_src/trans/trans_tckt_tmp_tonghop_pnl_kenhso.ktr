  </step>
  <step>
    <name>--c) Input APPS.FIN_HDV_SMY_MONTHLY</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--c)	Input APPS.FIN_HDV_SMY_MONTHLY
WITH list_baas_bankhub AS
	(SELECT SOTK
	FROM (SELECT account_number SOTK
		FROM APPS.ACC_BAAS_BANKHUB
		WHERE TRANSACTION_date = to_date(${PRD_ID}, 'YYYYMMDD')
			AND TYPE = 'BAAS'
		UNION ALL
		SELECT a.sotk
		FROM APPS.FIN_HDV_SMY_MONTHLY a
		WHERE TRANSACTION_date = to_date(${PRD_ID}, 'YYYYMMDD')
			AND loaikyhan = 'KKH'
			AND exists (
				SELECT 1
				FROM APPS.ACC_BAAS_BANKHUB b
				WHERE b.CUSTOMER = a.MAKH
				AND b.TRANSACTION_date = a.TRANSACTION_DATE
				AND b.TYPE = 'BANKHUB'
				AND b.status = 'ACTIVE'
			))
	GROUP BY SOTK)

select transaction_date,
   sotk,
   makh,
   cn,
   product_code,
   NULL linegl,
   NULL PLCATEGORY,
   FTP_CODE,
   khoi,
   sum(Value) LCY_AMT,
   NULL CHG_CODE,
   'APPS.FIN_HDV_SMY_MONTHLY' SOURCE_TABLE,
   khoi KHOI_THEOPLKHOI,
   case 
	    when PL_line = '- Chi lai huy dong khach hang KKH' then 'A1224'
	    when PL_line = '- Thu lai FTP ban von KKH' then 'A1215'
	end || pl_code_type CHITIEU_PLKHOI,
   PL_line || pl_name_type CHITIEU_PLKHOI_NAME,

   SP_DV,
   'CASA' SPSO_TYPE,
   'E2E' product_type
from
    (select t.transaction_date,
            t.sotk,
            t.makh,
            t.KHOI,
            t.cn,
            t.product_code,
            t.real_interest_vnd,
            t.INTEREST_FTP_VND,
            t.ftp_code, 
            case
		        when d.ARRANGEMENT_NBR IS NOT NULL then 'TKCD'
		        when t.khoi IN ('INDIV', 'NHS') AND a.app_biz_status = 'ACTIVE' then 'APP'
		        when t.khoi NOT IN ('INDIV', 'NHS') and a.app_biz_status = 'ACTIVE' then 'BIZ'
		        when c.sotk IS NOT NULL then 'BAAS'
		    END pl_code_type,
		    case
		        when d.ARRANGEMENT_NBR IS NOT NULL then ' - TK chuyen dung'
		        when t.khoi IN ('INDIV', 'NHS') AND a.app_biz_status = 'ACTIVE' then ' - App Active'
		        when t.khoi NOT IN ('INDIV', 'NHS') and a.app_biz_status = 'ACTIVE' then ' - Biz Active'
		        when c.sotk IS NOT NULL then ' - TK Baas/Bankhub'
		    END pl_name_type,
            t.kenh_gd,
            b.sp_dv,
            a.app_biz_status,
            a.first_login_date_app
    from APPS.FIN_HDV_SMY_MONTHLY t
    left join apps.fin_smy_customer_monthly a
        on t.makh = a.makh
        and t.transaction_date = a.transaction_date
    left join etl.ORS_MB_PRODUCT_CODE b
        on t.product_code = b.product_code
    LEFT JOIN list_baas_bankhub c
    	ON t.sotk = c.sotk
    LEFT JOIN APPS.REF_DS_TK_CHUYENDUNG d
    	ON t.sotk = d.ARRANGEMENT_NBR
    	AND d.khoi = 'CIB'

    where t.transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
        and t.loaikyhan = 'KKH'
            and (c.sotk IS NOT NULL
        	OR d.ARRANGEMENT_NBR IS NOT NULL
            or a.app_biz_status = 'ACTIVE'))
 
unpivot(
      Value
      for PL_line
      in (
         real_interest_vnd as '- Chi lai huy dong khach hang KKH',
         INTEREST_FTP_VND as '- Thu lai FTP ban von KKH'
      )
   )
group by transaction_date,
   sotk,
   makh,
   cn,
   product_code,
   FTP_CODE,
   khoi,
   case 
	    when PL_line = '- Chi lai huy dong khach hang KKH' then 'A1224'
	    when PL_line = '- Thu lai FTP ban von KKH' then 'A1215'
	end || pl_code_type,
   PL_line || pl_name_type,
   SP_DV</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
