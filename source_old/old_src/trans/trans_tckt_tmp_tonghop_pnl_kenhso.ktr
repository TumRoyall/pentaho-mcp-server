  </step>
  <step>
    <name>--b) Input APPS.TR_FTP_CUS/APPS.TR_FTP_CUS_DIEUCHINH</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--b)	Input APPS.TR_FTP_CUS/APPS.TR_FTP_CUS_DIEUCHINH
SELECT a.TRANSACTION_DATE,
   a.taikhoan sotk,
   a.makh,
   a.cn,
   a.product_code,
   a.line_gl linegl,
   substr(a.ma_sp_ftp, 3, 5) PLCATEGORY,
   a.ftp_code,
   a.khoi,
   sum(AMT_LCY) LCY_AMT,
   NULL chg_code,
   'APPS.TR_FTP_CUS/APPS.TR_FTP_CUS_DIEUCHINH' source_table,
    CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TRE'
		ELSE b.KHOI_THEOPLKHOI
	END KHOI_THEOPLKHOI,
   case
        when a.ftp_code = 'HD112' then 'A121512'
        when a.ftp_code in ('TD402', 'TD404', 'TD405') then 'A113521'
        else nvl(c.REPORT_ITEM_CODE, e.REPORT_ITEM_CODE)
    end CHITIEU_PLKHOI,
    case
        when a.ftp_code = 'HD112' then '- Thu lai FTP ban von KKH SP SO'
        when a.ftp_code in ('TD402', 'TD404', 'TD405') then '- Chi lai FTP mua von cho vay KH von MB'
        else b.CHITIEU_PLKHOI_NAME 
    END CHITIEU_PLKHOI_NAME,
    d.SP_DV,
    case
        when ftp_code in ('HD112', 'TD402', 'TD404', 'TD405') then 'THE'
        else c.type
    end SPSO_TYPE,
    case
        when ftp_code in ('HD112', 'TD402', 'TD404', 'TD405') then 'E2E'
        when c.SPSO = 'PRODUCT' THEN
          CASE
            WHEN d.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
            WHEN d.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
          END
        else c.SPSO
    end PRODUCT_TYPE

FROM 
    (SELECT a.TRANSACTION_DATE,
   a.taikhoan,
   a.makh,
   a.cn,
   a.product_code,
   a.line_gl,
   a.ma_sp_ftp,
   a.ftp_code,
   a.khoi,
   a.AMT_LCY FROM apps.TR_FTP_CUS a WHERE transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
    UNION ALL
    SELECT  a.TRANSACTION_DATE,
   a.taikhoan,
   a.makh,
   a.cn,
   a.product_code,
   a.line_gl,
   a.ma_sp_ftp,
   a.ftp_code,
   a.khoi,
   a.AMT_LCY FROM apps.TR_FTP_CUS_DIEUCHINH a WHERE transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')) a
left join apps.MB_MAP_TOI_LINE b
    ON a.LINE_GL = b.LINET24
    AND b.date_tx = to_date(${PRD_ID}, 'YYYYMMDD')
left join APPS.REF_SPSO_PLKHOI_MAP c
    ON b.CHITIEU_PLKHOI_NAME = c.REPORT_ITEM_NAME
left join etl.ORS_MB_PRODUCT_CODE d
    on a.product_code = d.product_code
left join etl.ODS_GL_REPORT_DEFN_REF_FULL e
	ON b.CHITIEU_PLKHOI_NAME = e.REPORT_ITEM_NAME
      AND e.REPORT_DEFN_CODE = '60219'
where c.type = 'CHO VAY' 
    or c.REPORT_ITEM_NAME = '- Thu lai FTP ban von CKH SP SO'
    --or (c.REPORT_ITEM_NAME= '- Thu lai FTP ban von KKH SP SO' and a.khoi &lt;&gt; 'SME')
    or ftp_code in ('HD112', 'TD402', 'TD404', 'TD405')
group by a.TRANSACTION_DATE,
   a.taikhoan,
   a.makh,
   a.cn,
   a.product_code,
   a.line_gl,
   substr(a.ma_sp_ftp, 3, 5),
   a.ftp_code,
   a.khoi,
    CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI = 'TREASURY' THEN 'TRE'
		ELSE b.KHOI_THEOPLKHOI
	END,
   case
        when a.ftp_code = 'HD112' then 'A121512'
        when a.ftp_code in ('TD402', 'TD404', 'TD405') then 'A113521'
        else nvl(c.REPORT_ITEM_CODE, e.REPORT_ITEM_CODE)
    end,
    case
        when a.ftp_code = 'HD112' then '- Thu lai FTP ban von KKH SP SO'
        when a.ftp_code in ('TD402', 'TD404', 'TD405') then '- Chi lai FTP mua von cho vay KH von MB'
        else b.CHITIEU_PLKHOI_NAME 
    END,
    d.SP_DV,
    case
        when ftp_code in ('HD112', 'TD402', 'TD404', 'TD405') then 'THE'
        else c.type
    END,
    case
        when ftp_code in ('HD112', 'TD402', 'TD404', 'TD405') then 'E2E'
        when c.SPSO = 'PRODUCT' THEN
          CASE
            WHEN d.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
            WHEN d.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
          END
        else c.SPSO
    end
</sql>
