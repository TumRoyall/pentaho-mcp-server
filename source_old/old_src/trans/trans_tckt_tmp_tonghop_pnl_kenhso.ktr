  <step>
    <name>--e) Input UPAS_LC ONLINE</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--e)	Input UPAS_LC ONLINE
WITH ld_lc as
	(SELECT a.ARRANGEMENT_NBR LD_ID, substr(a.INT_RATE_INFO, 1, 12) TF_ID
	FROM etl.ODS_LOAN_CONTRACT a
	WHERE 
	EXISTS (
		SELECT 1
		FROM ETL.ODS_CAL_BPMLC_BPM_LCNK b
		WHERE b.ARRANGEMENT_NBR = substr(a.INT_RATE_INFO, 1, 12)
		)
	)
SELECT a.transaction_date,
	a.sct sotk,
	a.makh,
	a.ma_cn cn,
	a.product_code,
	a.linegl,
	a.acctnbr PLCATEGORY,
	NULL FTP_CODE,
	a.KHOI,
	sum(a.TIENNO_VND) LCY_AMT,
	a.chg_code,
    'APPS.TOI_SOURCE_INPUT' source_table,
	CASE 
		WHEN a.KHOI_PLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN a.KHOI_PLKHOI IN ('TREASURY', 'TRE') THEN 'TREA'
		ELSE a.KHOI_PLKHOI
	END KHOI_THEOPLKHOI,
	'A1114UPAS' CHITIEU_PLKHOI,--d.REPORT_ITEM_CODE CHITIEU_PLKHOI,
	'Thu lai UPASLC online' CHITIEU_PLKHOI_NAME,--a.CHITIEU_PLKHOI_NAME,
    c.SP_DV,
    'TTTM' SPSO_TYPE,
	'O2O' product_type
FROM etl.TMP_TOI_SOURCE_INPUT a --APPS.TOI_SOURCE_INPUT a
INNER JOIN ld_lc b
	ON a.sct = b.LD_ID
LEFT JOIN etl.ORS_MB_PRODUCT_CODE c
    ON a.PRODUCT_CODE = c.PRODUCT_CODE
LEFT JOIN etl.ODS_GL_REPORT_DEFN_REF_FULL d
	ON a.chitieu_plkhoi_name = d.REPORT_ITEM_NAME and d.REPORT_DEFN_CODE = '60219' 
WHERE a.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
	AND a.chitieu_plkhoi LIKE 'A203%'
GROUP BY a.transaction_date,
	a.sct,
	a.makh,
	a.ma_cn,
	a.product_code,
	a.linegl,
	a.ACCTNBR,
	a.KHOI,
	a.chg_code,
	CASE 
		WHEN a.KHOI_PLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN a.KHOI_PLKHOI IN ('TREASURY', 'TRE') THEN 'TREA'
		ELSE a.KHOI_PLKHOI
	END,
	d.REPORT_ITEM_CODE,
	a.CHITIEU_PLKHOI_NAME,
    c.SP_DV,
    a.product_code
UNION ALL
SELECT a.TRANSACTION_DATE,
    a.taikhoan sotk,
    a.makh,
    a.cn,
    a.product_code,
    a.line_gl,
    substr(a.ma_sp_ftp, 3, 5) PLCATEGORY,
    a.ftp_code,
    a.khoi,
    sum(AMT_LCY) LCY_AMT,
    NULL chg_code,
    'APPS.TR_FTP_CUS/APPS.TR_FTP_CUS_DIEUCHINH' source_table,
	CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI IN ('TREASURY', 'TRE') THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END KHOI_THEOPLKHOI,
	'A1135UPAS' CHITIEU_PLKHOI,--e.REPORT_ITEM_CODE CHITIEU_PLKHOI,
	'Chi lai FTP UPASLC online' CHITIEU_PLKHOI_NAME,--b.CHITIEU_PLKHOI_NAME,
	d.SP_DV,
    'TTTM' SPSO_TYPE,
	'O2O' product_type
FROM 
    (SELECT a.TRANSACTION_DATE, a.taikhoan, a.makh, a.cn, a.product_code, a.line_gl, a.ma_sp_ftp, a.ftp_code, a.khoi, a.AMT_LCY FROM apps.TR_FTP_CUS a WHERE transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
    UNION ALL
    SELECT a.TRANSACTION_DATE, a.taikhoan, a.makh, a.cn, a.product_code, a.line_gl, a.ma_sp_ftp, a.ftp_code, a.khoi, a.AMT_LCY FROM apps.TR_FTP_CUS_DIEUCHINH a WHERE transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')) a
left join apps.MB_MAP_TOI_LINE b
    ON a.LINE_GL = b.LINET24
    AND b.date_tx = to_date(${PRD_ID}, 'YYYYMMDD')
INNER JOIN ld_lc c
	ON a.taikhoan = c.LD_ID
LEFT JOIN etl.ORS_MB_PRODUCT_CODE d
    ON a.PRODUCT_CODE = d.PRODUCT_CODE
LEFT JOIN etl.ODS_GL_REPORT_DEFN_REF_FULL e
	ON a.line_gl = e.gl_line and e.REPORT_DEFN_CODE = '60219' 
WHERE e.REPORT_DEFN_VERSION_CODE IN ('A113511', 'A113521', 'A113523')
GROUP BY a.TRANSACTION_DATE,
    a.taikhoan,
    a.makh,
    a.cn,
    a.product_code,
    a.line_gl,
    substr(a.ma_sp_ftp, 3, 5),
    a.ftp_code,
    a.khoi,
    CASE 
		WHEN b.KHOI_THEOPLKHOI = 'COST CENTER' THEN 'NHS'
		WHEN b.KHOI_THEOPLKHOI IN ('TREASURY', 'TRE') THEN 'TREA'
		ELSE b.KHOI_THEOPLKHOI
	END,
    e.REPORT_ITEM_CODE,
	b.CHITIEU_PLKHOI_NAME,
	d.SP_DV
</sql>
