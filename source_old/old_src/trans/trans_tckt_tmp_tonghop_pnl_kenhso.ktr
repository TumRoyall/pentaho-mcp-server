  <step>
    <name>--f) Input COMBO_BLOCK_PHANBO</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--f)	Input COMBO_BLOCK_PHANBO
SELECT TRANSACTION_DATE,
	SOTK,
	MAKH,
	CN,
	PRODUCT_CODE,
        linet24 linegl,
	acctnbr plcategory,
	NULL ftp_code,
	khoi,
	sum(PHI_PHANBO_HOPDONG) lcy_amt,
	chg_code,
	'APPS.FIN_CHIASE_PHI_COMBO_MTH' SOURCE_table,
	khoi_theoplkhoi,
	CHITIEU_PLKHOI,
	CHITIEU_PLKHOI_NAME,
	sp_dv,
	SPSO_TYPE,
	PRODUCT_TYPE
FROM APPS.FIN_CHIASE_PHI_COMBO_MTH
WHERE transaction_date = to_date(${PRD_ID}, 'YYYYMMDD') and KENH_GD = 'ONLINE'
GROUP BY TRANSACTION_DATE,
	SOTK,
	MAKH,
	CN,
	PRODUCT_CODE,
        linet24,
	acctnbr,
	khoi,
	chg_code,
	khoi_theoplkhoi,
	CHITIEU_PLKHOI,
	CHITIEU_PLKHOI_NAME,
	sp_dv,
	SPSO_TYPE,
	PRODUCT_TYPE
</sql>
