  <step>
    <name>--h) Thu lai FTP Viettel Pay</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--h) Thu lai FTP Viettel Pay
SELECT a.TRANSACTION_DATE,
 a.taikhoan sotk,
 a.makh,
 a.cn,
 a.PRODUCT_CODE,
 NULL linegl,
 NULL PLCATEGORY,
 a.FTP_CODE,
 a.khoi,
 sum(INTEREST_FTP_VND) lcy_amt,
 NULL chg_code,
 'APPS.MB_AGG_NIM_M' source_table,
 a.khoi khoi_theoplkhoi,
 'A1215VTPAY' chitieu_plkhoi,
 '- Thu lai FTP ban von KKH - TK tra truoc Viettelpay'
chitieu_plkhoi_name,
 b.sp_dv,
 'CASA' SPSO_TYPE,
 'E2E' product_type
FROM apps.MB_AGG_NIM_M a
LEFT JOIN etl.ORS_MB_PRODUCT_CODE b
 ON a.PRODUCT_CODE = b.PRODUCT_CODE
/*
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY c
 ON a.makh = c.makh
 AND c.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
LEFT JOIN etl.REF_AICT_BRANCH_M d ON a.cn = d.BRANCH_CODE_T24
 AND d.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
*/
WHERE a.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
 AND a.TAIKHOAN in ('97042292', 'VND1142600400001')
GROUP BY a.TRANSACTION_DATE,
 a.taikhoan,
 a.makh,
 a.cn,
 a.PRODUCT_CODE,
 a.FTP_CODE,
 a.khoi,
 b.sp_dv</sql>
