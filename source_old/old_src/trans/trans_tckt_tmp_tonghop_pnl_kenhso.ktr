  <step>
    <name>--g) Input DUPHONG_SPSO</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>--g) Input DUPHONG_SPSO
SELECT a.TRANSACTION_DATE,
	a.CONTRACT_NUMBER sotk,
	a.MAKH,
	a.cn,
	b.PRODUCT_CODE,
	NULL LINEGL,
	NULL PLCATEGORY,
	NULL FTP_CODE,
	a.khoi,
	sum(PROVISION_COST) lcy_amt,
	NULL chg_code,
	'FIN_PNL_PROVISION_HACHTOAN' source_table,
	a.khoi khoi_theoplkhoi,
    'B' CHITIEU_PLKHOI,
	'DUPHONG_SPSO' CHITIEU_PLKHOI_NAME,
	b.SP_DV,
	'DU PHONG' SPSO_TYPE,
	CASE
		WHEN b.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
		WHEN b.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
	END product_type

FROM etl.TMP_TOI_PROVISION_MONTHLY a
LEFT JOIN etl.ORS_MB_PRODUCT_CODE b
	ON a.PRODUCT_CODE = b.PRODUCT_CODE
WHERE a.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
AND b.SP_DV IN ('SPS1', 'SPSO', 'DVS1', 'DVSO', 'SPS2', 'DVS2')
GROUP BY a.TRANSACTION_DATE,
	a.CONTRACT_NUMBER,
	a.MAKH,
	a.cn,
	b.PRODUCT_CODE,
	a.khoi,
	b.SP_DV,
	CASE
		WHEN b.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
		WHEN b.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
	END
</sql>
