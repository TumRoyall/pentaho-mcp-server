  <step>
    <name>--a) Input APPS.MB_AGG_THLK_TOI_SP_TMP3</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>-- a) Input: APPS.MB_AGG_THLK_TOI_SP_TMP3

SELECT
    a.TRANSACTION_DATE,
    a.SCT                          AS SOTK,
    a.MAKH,
    a.MA_CN                        AS CN,
    a.PRODUCT_CODE,
    a.LINEGL,
    a.ACCTNBR                      AS PLCATEGORY,
    NULL                           AS FTP_CODE,
    a.KHOI,
    SUM(a.TIENNO_VND)              AS LCY_AMT,
    a.CHG_CODE,
    'APPS.TOI_SOURCE_INPUT'        AS SOURCE_TABLE,
    CASE
        WHEN a.LINEGL = '604402'               THEN a.KHOI
        WHEN KHOI_PLKHOI = 'COST CENTER'       THEN 'NHS'
        WHEN KHOI_PLKHOI IN ('TREASURY', 'TRE') THEN 'TREA'
        ELSE KHOI_PLKHOI
    END                            AS KHOI_THEOPLKHOI,
    NVL(b.REPORT_ITEM_CODE, d.REPORT_ITEM_CODE) AS CHITIEU_PLKHOI,
    a.CHITIEU_PLKHOI_NAME,
    c.SP_DV,
    CASE
        WHEN ACCTNBR IN ('52796','67026','52795','52294') THEN 'THE'
        ELSE b.TYPE
    END                            AS SPSO_TYPE,
    CASE
        WHEN ACCTNBR IN ('52796','67026','52795','52294') THEN 'E2E'
        WHEN b.SPSO = 'PRODUCT' THEN
          CASE
            WHEN c.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
            WHEN c.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
          END
      ELSE b.SPSO
    END 							AS PRODUCT_TYPE  -- sua logic PRODUCT_TYPE

FROM etl.TMP_TOI_SOURCE_INPUT a   -- APPS.TOI_SOURCE_INPUT a
LEFT JOIN APPS.REF_SPSO_PLKHOI_MAP b
       ON a.CHITIEU_PLKHOI_NAME = b.REPORT_ITEM_NAME
LEFT JOIN etl.ORS_MB_PRODUCT_CODE c
       ON a.PRODUCT_CODE = c.PRODUCT_CODE
LEFT JOIN etl.ODS_GL_REPORT_DEFN_REF_FULL d
       ON a.CHITIEU_PLKHOI_NAME = d.REPORT_ITEM_NAME
      AND d.REPORT_DEFN_CODE = '60219'

WHERE a.TRANSACTION_DATE = TO_DATE(${PRD_ID}, 'yyyymmdd')
  AND (
        (
            b.REPORT_ITEM_NAME IS NOT NULL
            AND b.TYPE &lt;&gt; 'CASA'
            AND a.CHITIEU_PLKHOI_NAME NOT IN (
                '- Chi lai FTP mua von CKH von MB SP SO',
                '- Chi lai FTP KKH SP SO',
                '- Thu lai FTP ban von CKH SP SO'
            )
            AND ACCTNBR NOT IN ('52796','67026','52795','52294')
        )
        OR ACCTNBR IN ('52796','67026','52795','52294')
      )   -- sua bo dieu kien lay CASA

GROUP BY
    a.TRANSACTION_DATE,
    a.SCT,
    a.MAKH,
    a.MA_CN,
    a.PRODUCT_CODE,
    a.LINEGL,
    a.ACCTNBR,
    a.KHOI,
    a.CHG_CODE,
    CASE
        WHEN a.LINEGL = '604402'               THEN a.KHOI
        WHEN KHOI_PLKHOI = 'COST CENTER'       THEN 'NHS'
        WHEN KHOI_PLKHOI IN ('TREASURY', 'TRE') THEN 'TREA'
        ELSE KHOI_PLKHOI
    END,
    NVL(b.REPORT_ITEM_CODE, d.REPORT_ITEM_CODE),
    a.CHITIEU_PLKHOI_NAME,
    c.SP_DV,
    CASE
        WHEN ACCTNBR IN ('52796','67026','52795','52294') THEN 'THE'
        ELSE b.TYPE
    END,
	CASE
        WHEN ACCTNBR IN ('52796','67026','52795','52294') THEN 'E2E'
        WHEN b.SPSO = 'PRODUCT' THEN
          CASE
            WHEN c.SP_DV IN ('SPS1', 'DVS1', 'SPS2', 'DVS2') THEN 'E2E'
            WHEN c.SP_DV IN ('SPSO', 'DVSO') THEN 'O2O'
          END
      ELSE b.SPSO
    END
</sql>
