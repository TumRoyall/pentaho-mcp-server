    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ods_dc</connection>
    <sql>SELECT LAST_DAY(TXN_DATE) transaction_date
, T24_CUST_ID makh
, SERVICE_CODE product_code
, INVOLVED_PARTY_KEY
, PAYMENT_SYSTEM
, CHANNEL
, IN_OUT
, CURRENCY_CODE
, sum(FCY_AMT) FCY_AMT
, sum(LCY_AMT) LCY_AMT
, sum(TXN_QTY) TXN_QTY
, count(DISTINCT TXN_DATE) TXN_FRQ
, SUB_SERVICE
, b.PRODUCT_DESC product_name
, b.product_type sp_dv
, c.NAME PAYMENT_SYSTEM_NAME
, d.CHANNEL_NAME
, d.CHANNEL_GROUP
, NULL INVOLVED_PARTY_NAME -- Bang chua golive, bo NULL lay e.INVOLVED_PARTY_NAME khi bang golive
FROM smy.SERVICE_INFO a
LEFT JOIN ods.PRODUCT b
ON a.SERVICE_CODE = b.PRODUCT_CODE
AND b.CURRENT_FLAG = 'Y'
LEFT JOIN ods.PAYMENT_SYSTEM_REF c
ON a.PAYMENT_SYSTEM = c.id
AND c.CURRENT_FLAG = 'Y'
LEFT JOIN ods.CHANNEL_REF d
ON a.CHANNEL = d.CHANNEL_CODE
AND d.CURRENT_FLAG = 'Y'
--LEFT JOIN ods.partner_ref e -- Bang chua golive, ghep join khi bang golive
-- ON a.INVOLVED_PARTY_KEY = e.INVOLVED_PARTY_KEY
WHERE TXN_DATE BETWEEN trunc(TO_DATE('${PRD_ID}','YYYYMMDD'), 'MONTH') AND
TO_DATE('${PRD_ID}','YYYYMMDD')
GROUP BY LAST_DAY(TXN_DATE)
, T24_CUST_ID
, SERVICE_CODE
, INVOLVED_PARTY_KEY
, PAYMENT_SYSTEM
, CHANNEL
, IN_OUT
, CURRENCY_CODE
, SUB_SERVICE
, b.PRODUCT_DESC
, b.product_type
, c.NAME
, d.CHANNEL_NAME
, d.CHANNEL_GROUP</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
