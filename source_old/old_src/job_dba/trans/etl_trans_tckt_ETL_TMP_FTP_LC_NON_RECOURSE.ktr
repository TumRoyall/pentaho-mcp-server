    <connection>tckt_dc</connection>
    <sql>WITH FTP_LC_MIENTRUYDOI as
(SELECT A.TXN_DATE TRANSACTION_DATE,
        A.ARRANGEMENT_NBR SOTK,
        A.CURRENCY_CODE CCY,
        NULL T24_LINE,
        NULL COA_CODE,
        NULL INT_RATE_TYPE,
        F.TERM_ID TERM_HD,
        F.TERM_ID TERM_FTP,
        A.T24_CUST_ID MAKH,
        a.COMM_RATE ARRANGEMENT_INT_RATE,
        A.BRANCH_CODE CNC2,
        UPPER(K.VUNG_MIEN) VUNG_MIEN,
        NULL PRODUCT_CODE,
        a.FTP_CODE,
        SUBSTR(A.FTP_CODE,1,2) FTP_TYPE,
        A.DIVISION_CODE KHOI,
        to_date(A.VALUE_DATE,'YYYYMMDD') VALUE_DATE,
        to_date(A.MATURITY_DATE,'YYYYMMDD') MATURITY_DATE,
        to_date(A.VALUE_DATE,'YYYYMMDD') NGAY_TDLS,
        NULL SECTOR,
        NULL RM_CODE,
        R.CONVERSION_RATE TYGIA,
        A.PNP_AMT_ACCRUED FCY_AMT,
        A.PNP_AMT_ACCRUED *R.CONVERSION_RATE LCY_AMT,
        'SMY.LC_NON_RECOURSE_BAL' SOURCE_TABLE,
        'LC_MTD' FTP_GROUP,
        COALESCE(B.AMOUNT,C.AMOUNT,0) INT_FIX
FROM ETL.ODS_LC_NON_RECOURSE_BAL A
LEFT JOIN APPS.FILE_NSLD_AICT_BRANCH_M K ON K.TRANSACTION_DATE = TRUNC(TO_DATE(${INPUT_DATE},'YYYYMMDD'),'MONTH') - 1 AND A.BRANCH_CODE = K.BRANCH_CODE_T24
LEFT JOIN ETL.ORS_GL_DAILY_RATES R ON A.TXN_DATE = R.CONVERSION_DATE AND R.TO_CURRENCY = 'VND' AND A.CURRENCY_CODE = R.FROM_CURRENCY
LEFT JOIN APPS.FTP_REF_FTPDB B ON A.TXN_DATE = B.TRANSACTION_DATE AND A.FTP_CODE = B.FTP_CODE
LEFT JOIN APPS.FTP_REF_HDDB C ON A.TXN_DATE = C.TRANSACTION_DATE AND A.ARRANGEMENT_NBR = C.SOTK
LEFT JOIN APPS.FTP_MAP_TERM F ON to_date (A.MATURITY_DATE,'YYYYMMDD') - GREATEST( to_date(A.VALUE_DATE,'YYYYMMDD'), TO_DATE ('20160118','yyyyMMdd')) >= F.FROM_DAY AND to_date(A.MATURITY_DATE,'YYYYMMDD') - GREATEST ( to_date (A.VALUE_DATE,'YYYYMMDD'), TO_DATE('20160118','yyyyMMdd')) &lt;= F.TO_DAY
)
select a.TRANSACTION_DATE,
       a.SOTK,
       a.CCY,
       a.T24_LINE,
       a.COA_CODE,
       a.INT_RATE_TYPE,
       a.TERM_HD,
       a.TERM_FTP,
       a.MAKH,
       a.ARRANGEMENT_INT_RATE,
       a.CNC2,
       a.VUNG_MIEN,
       a.PRODUCT_CODE,
       a.FTP_CODE,
       a.FTP_TYPE,
       a.KHOI,
       a.VALUE_DATE,
       a.MATURITY_DATE,
       a.NGAY_TDLS,
       a.SECTOR,
       a.RM_CODE,
       a.TYGIA,
       a.FCY_AMT,
       a.LCY_AMT,
       a.SOURCE_TABLE,
       a.FTP_GROUP,
       o.FTP_CATEGORY,
       o.FTP_LINE,
       o.GL_LINE,
       a.INT_FIX,
       case when nvl(P.INT_BHTG_FLAG,'N') = 'Y' then nvl(C.AMOUNT,0) else 0 end INT_BHTG,
       case when nvl(P.INT_DTBB_FLAG,'N') = 'Y' then nvl(D.AMOUNT,0) else 0 end INT_DTBB,
       case when nvl(P.INT_TK_FLAG,'N') = 'Y' then nvl(E.AMOUNT,0) else 0 end INT_TK,
       case when nvl(P.INT_PHUTROI_FLAG,'N') = 'Y' then coalesce(F1.PTTK, F2.AMOUNT, F3.AMOUNT , 0) else 0 end INT_PHUTROI,
       case when nvl(P.INT_DC_ALCO_FLAG,'N') = 'Y' then coalesce(G1.AMOUNT,G2.AMOUNT,0) else 0 end INT_DC_ALCO,
       case when nvl(P.INT_BASE_FLAG,'N') = 'Y' then nvl(H.AMOUNT,0) else 0 end INT_BASE,
       case when nvl(P.INT_NIM_HD_FLAG,'N') = 'Y' then nvl(I.AMOUNT,0) else 0 end INT_NIM_HD,
       case when nvl(P.TYLE_PHANRA_FLAG,'N') = 'Y' then nvl(K.AMOUNT,0) else 0 end INT_PHANRA,
       case when nvl(P.INT_VAYDH_FLAG,'N') = 'Y' then nvl(L.AMOUNT,0) else 0 end INT_VAYDH,
       case when nvl(P.INT_HDVLSC_FLAG,'N') = 'Y' then nvl(M.AMOUNT,0) else 0 end INT_HDVLSC,
       case when nvl(P.INT_BASE_MARGIN_FLAG,'N') = 'Y' then coalesce(N1.AMOUNT,N2.AMOUNT,0) else 0 end INT_BASE_MARGIN,
       case when nvl(P.INT_LS_HD_FLAG,'N') = 'Y' then nvl(a.ARRANGEMENT_INT_RATE,0) else 0 end INT_LS_HD,
       case when nvl(P.INT_NIM_MARGIN_FLAG,'N') = 'Y' then coalesce(U2.AMOUNT, U1.AMOUNT, 0) else 0 end INT_NIM_MARGIN
from FTP_LC_MIENTRUYDOI A
left join APPS.FTP_MAP_GROUP P on a.FTP_GROUP = P.FTP_GROUP
Left join APPS.FTP_MAP_HTOAN O on a.FTP_CODE = O.FTP_PROD and a.KHOI = O.KHOI
LEFT JOIN APPS.ftp_ref_base_margin N1 ON A.KHOI = N1.KHOI AND A.NGAY_TDLS = N1.TRANSACTION_DATE AND A.CCY = N1.CCY AND A.TERM_FTP = N1.TERM_FTP AND A.FTP_TYPE = N1.FTP_TYPE AND A.FTP_CODE = N1.FTP_CODE AND A.FCY_AMT >= N1.AMT_FROM AND A.FCY_AMT &lt;  N1.AMT_TO
LEFT JOIN APPS.ftp_ref_base_margin N2 ON A.KHOI = N2.KHOI AND A.NGAY_TDLS = N2.TRANSACTION_DATE AND A.CCY = N2.CCY AND A.TERM_FTP = N2.TERM_FTP AND A.FTP_TYPE = N2.FTP_TYPE AND A.FTP_TYPE = N2.FTP_CODE AND A.FCY_AMT >= N2.AMT_FROM AND A.FCY_AMT &lt;  N2.AMT_TO
LEFT JOIN APPS.FTP_REF_NIM_MARGIN U1 ON A.NGAY_TDLS = U1.TRANSACTION_DATE AND A.CCY = U1.CCY AND A.FTP_TYPE = U1.FTP_CODE AND A.TERM_HD = U1.TERM_HD
LEFT JOIN APPS.FTP_REF_NIM_MARGIN U2 ON A.NGAY_TDLS = U2.TRANSACTION_DATE AND A.CCY = U2.CCY AND A.FTP_CODE = U2.FTP_CODE AND A.TERM_HD = U2.TERM_HD
LEFT JOIN APPS.FTP_REF_CHIPHI_BHTG C ON A.NGAY_TDLS = C.TRANSACTION_DATE AND A.CCY = C.CCY
LEFT JOIN APPS.FTP_REF_CHIPHI_DTBB D ON A.NGAY_TDLS = D.TRANSACTION_DATE AND A.CCY = D.CCY
LEFT JOIN APPS.FTP_REF_CHIPHI_TK E ON A.NGAY_TDLS = E.TRANSACTION_DATE AND A.CCY = E.CCY
LEFT JOIN APPS.FTP_LICHTRAGOC_LSPHUTROI F1 on  A.SOTK = F1.SOKU
LEFT JOIN APPS.FTP_REF_PHUTROI F2 ON A.NGAY_TDLS = F2.TRANSACTION_DATE AND A.CCY = F2.CCY AND A.TERM_HD = F2.TERM_HD AND A.FTP_CODE = F2.FTP_CODE
LEFT JOIN APPS.FTP_REF_PHUTROI F3 ON A.NGAY_TDLS = F3.TRANSACTION_DATE AND A.CCY = F3.CCY AND A.TERM_HD = F3.TERM_HD AND A.FTP_TYPE = F3.FTP_CODE
LEFT JOIN APPS.FTP_REF_DIEUCHINH_ALCO G1 ON A.NGAY_TDLS = G1.TRANSACTION_DATE AND A.FTP_CODE = G1.FTP_CODE AND A.CCY = G1.CCY AND A.TERM_FTP = G1.TERM_FTP AND A.KHOI = G1.KHOI
LEFT JOIN APPS.FTP_REF_DIEUCHINH_ALCO G2 ON A.NGAY_TDLS = G2.TRANSACTION_DATE AND A.FTP_TYPE = G2.FTP_CODE AND A.CCY = G2.CCY AND A.KHOI = G2.KHOI AND A.TERM_FTP = G2.TERM_FTP
LEFT JOIN APPS.FTP_REF_FTP_BASE H ON A.NGAY_TDLS = H.TRANSACTION_DATE AND A.CCY = H.CCY AND A.TERM_FTP = H.TERM_FTP AND A.FTP_TYPE = H.FTP_TYPE
LEFT JOIN APPS.FTP_REF_NIM_HD I ON A.NGAY_TDLS = I.TRANSACTION_DATE AND A.CCY = I.CCY AND A.TERM_FTP = I.TERM_FTP AND A.FTP_TYPE = I.FTP_TYPE
LEFT JOIN APPS.FTP_REF_TYLE_PHANRA K ON A.TRANSACTION_DATE = K.TRANSACTION_DATE AND A.CCY = K.CCY AND A.KHOI = K.KHOI
LEFT JOIN APPS.FTP_REF_CHIPHI_VAYDAIHAN L ON A.NGAY_TDLS = L.TRANSACTION_DATE AND A.CCY = L.CCY AND A.FTP_TYPE = L.FTP_TYPE AND (CASE WHEN A.NGAY_TDLS &lt; to_date(20250101,'yyyyMMdd') THEN A.TERM_FTP ELSE A.TERM_HD END) = L.TERM_FTP
LEFT JOIN APPS.FTP_REF_CHIPHI_HDVLSCAO M ON A.NGAY_TDLS = M.TRANSACTION_DATE AND A.CCY = M.CCY AND A.FTP_TYPE = M.FTP_TYPE AND (CASE WHEN A.NGAY_TDLS &lt; to_date(20250101,'yyyyMMdd') THEN A.TERM_FTP ELSE A.TERM_HD END) = M.TERM_FTP </sql>
