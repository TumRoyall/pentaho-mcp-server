      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here

var parts = [];

parts.push("client_id=" + encodeURIComponent(client_id));
parts.push("client_secret=" + encodeURIComponent(client_secret));
parts.push("grant_type=" + encodeURIComponent(grant_type));

//if (scope &amp;&amp; scope.length > 0) {
//  parts.push("scope=" + encodeURIComponent(scope));
//}

// Nếu dùng grant_type=password
if (grant_type === "password") {
  parts.push("username=" + encodeURIComponent(username));
  parts.push("password=" + encodeURIComponent(password));
}

// Nếu dùng refresh_token
// parts.push("refresh_token=" + encodeURIComponent(refresh_token));

var body_form = parts.join("&amp;");</jsScript_script>
      </jsScript>
