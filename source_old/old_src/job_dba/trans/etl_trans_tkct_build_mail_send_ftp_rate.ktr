"&lt;td>&lt;/td>" +
"&lt;/tr>" +

ALL_ROWS_USD +

"&lt;/table>" +

"&lt;br>&lt;br>" +

"&lt;p>Trân trọng,&lt;/p>" +

"&lt;/body>" +
"&lt;/html>";

var Subject_mail = "FTP Thị trường 2 ngày " + transaction_date;</jsScript_script>
