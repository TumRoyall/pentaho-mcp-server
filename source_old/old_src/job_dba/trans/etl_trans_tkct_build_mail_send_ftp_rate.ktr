        <jsScript_script>transaction_date_raw = getVariable('NGAY_DU_LIEU','');

day   = transaction_date_raw.substring(6,8);
month = transaction_date_raw.substring(4,6);
year  = transaction_date_raw.substring(0,4);

transaction_date = day + "/" + month + "/" + year;

var EMAIL_BODY =
"&lt;html>" +
"&lt;body style='font-family:Times New Roman;font-size:16px'>" +

"&lt;p>&lt;b>Kính gửi các Anh/Chị,&lt;/b>&lt;/p>" +

"&lt;p>Phòng ALM thông báo FTP Thị trường 2 ngày " +
"&lt;span style='color:red'>&lt;b>" +
transaction_date +
"&lt;/b>&lt;/span> như sau:&lt;/p>" +

// ===== VND =====
"&lt;table border='1' cellpadding='6' cellspacing='0' " +
"style='border-collapse:collapse;width:220px;margin-bottom:20px'>" +

"&lt;tr>" +
"&lt;td style='background-color:yellow'>&lt;b>VND&lt;/b>&lt;/td>" +
"&lt;td>&lt;/td>" +
"&lt;/tr>" +

ALL_ROWS_VND +

