    <name>Table input 2</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>tckt_dc</connection>
    <sql>select term, ftp_rate
from APPS.REF_FTP_SM_MM_RATE
where
transaction_date = to_date(${NGAY_DU_LIEU},'yyyymmdd')
and ccy = 'USD'
order by case term
    when 'ON' then 1
    when '1W' then 2
    when '2W' then 3
    when '3W' then 4
    when '1M' then 5
    when '2M' then 6
    when '3M' then 7
    when '6M' then 8
    else 999
end</sql>
