      <attributes_kjc/>
    </entry>
    <entry>
      <name>APPS.FIN_LOYALTY_TXN_MONTHLY</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DELETE ETL.OTS_TRANS_LOYALTY_TXN_MONTHLY --WHERE TRANSACTION_DATE BETWEEN TRUNC(to_date(${PRD_ID},'YYYYMMDD'),'MONTH') AND last_day(to_date(${PRD_ID},'YYYYMMDD')) +1 -interval '1' second;
WHERE TRANSACTION_DATE &lt; TRUNC(to_date(${PRD_ID},'YYYYMMDD'),'MONTH') ;

DELETE APPS.FIN_LOYALTY_TXN_MONTHLY --WHERE TRANSACTION_DATE BETWEEN TRUNC(to_date(${PRD_ID},'YYYYMMDD'),'MONTH') AND last_day(to_date(${PRD_ID},'YYYYMMDD')) +1 -interval '1' second;
where  transaction_date  >= TRUNC(to_date(${PRD_ID},'YYYYMMDD'),'MONTH') and transaction_date &lt;= last_day(to_date(${PRD_ID},'YYYYMMDD'));
COMMIT;
INSERT INTO APPS.FIN_LOYALTY_TXN_MONTHLY
(TRANSACTION_DATE, TRANSACTION_REF_NO, TRANSACTION_TYPE, LOYALTY_ACCOUNT_NO, POINT_EARNED, POINT_REDEEMED, POINT_ADJUSTED, PRODUCT_ACCOUNT_NO, PRODUCT_CODE, BANK_REF_NO, AMT_OF_TXN, EXPIRY_DATE, CARD_ID, CSN, MAKH, KHOI, PHAN_KHUC, SCHEME_ID, SCHEME_NAME, ITEM_CODE, ITEM_NAME)
SELECT a.transaction_date 
, a.TRANSACTION_REF_NO 
, a.TRANSACTION_TYPE 
, a.LOYALTY_ACCOUNT_NO 
, a.POINT_EARNED 
, a.POINT_REDEEMED 
, a.point_adjusted 
, a.PRODUCT_ACCOUNT_NO 
, a.PRODUCT_CODE 
, a.BANK_REF_NO 
, a.AMT_OF_TXN 
, a.EXPIRY_DATE 
, a.CARD_ID 
, a.CSN 
, a.MAKH 
, b.KHOI 
, b.PHAN_KHUC 
, a.SCHEME_ID 
, a.SCHEME_NAME 
, a.ITEM_CODE 
, a.ITEM_NAME
FROM etl.ots_trans_loyalty_txn_monthly a
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY b ON  b.transaction_date = to_date(${PRD_ID},'YYYYMMDD') AND a.makh = b.makh
where a.transaction_date  >= TRUNC(to_date(${PRD_ID},'YYYYMMDD'),'MONTH') and a.transaction_date &lt;= last_day(to_date(${PRD_ID},'YYYYMMDD'))
;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>816</xloc>
      <yloc>272</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>APPS.FIN_LOYALTY_TONGHOP_MONTHLY</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DELETE APPS.FIN_LOYALTY_TONGHOP_MONTHLY --WHERE TRANSACTION_DATE = last_day(to_date(${PRD_ID},'YYYYMMDD'));
WHERE  transaction_date  >= TRUNC(to_date('${PRD_ID}','YYYYMMDD'),'MONTH') and transaction_date &lt;= last_day(to_date('${PRD_ID}','YYYYMMDD'));

COMMIT;
INSERT INTO APPS.FIN_LOYALTY_TONGHOP_MONTHLY
(TRANSACTION_DATE, LOYALTY_ACCOUNT_NO, LOYALTY_ACCOUNT_STATUS, POINT_EARNED, POINT_REDEEMED, POINT_ADJUSTED, POINT_EARNED_BAL, NO_OF_TXN, CSN, MAKH, KHOI, PHAN_KHUC)
WITH tmp_txn AS
( SELECT a.transaction_date 
, a.LOYALTY_ACCOUNT_NO 
, SUM(NVL(a.POINT_EARNED,0)) POINT_EARNED 
, SUM(NVL(a.POINT_REDEEMED,0)) POINT_REDEEMED 
, SUM(NVL(a.point_adjusted,0)) point_adjusted 
, NVL(COUNT(DISTINCT(a.transaction_ref_no)),0) NO_OF_TXN 
, a.CSN 
, a.MAKH 
, a.KHOI 
, a.PHAN_KHUC
FROM APPS.FIN_LOYALTY_TXN_MONTHLY a
WHERE a.transaction_date BETWEEN TRUNC(to_date(${PRD_ID},'YYYYMMDD' ),'MONTH') AND last_day(to_date(${PRD_ID} ,'YYYYMMDD'))
GROUP BY a.transaction_date, a.LOYALTY_ACCOUNT_NO, a.CSN, a.MAKH, a.KHOI, a.PHAN_KHUC
)
SELECT NVL(a.TRANSACTION_DATE, b.transaction_date) transaction_date 
, NVL(a.LOYALTY_ACCOUNT_NO, b.LOYALTY_ACCOUNT_NO) LOYALTY_ACCOUNT_NO 
, b.status LOYALTY_ACCOUNT_STATUS
, NVL(a.POINT_EARNED,0) POINT_EARNED
, NVL(a.POINT_REDEEMED,0) POINT_REDEEMED
, NVL(a.point_adjusted,0) point_adjusted
, NVL(b.balance,0) POINT_EARNED_BAL
, NVL(a.NO_OF_TXN,0) NO_OF_TXN
, a.CSN
, a.MAKH
, a.KHOI
, a.PHAN_KHUC
FROM tmp_txn a
FULL JOIN etl.ots_cal_account_balance_snpst b ON a.transaction_date = b.transaction_date AND
a.LOYALTY_ACCOUNT_NO = b.LOYALTY_ACCOUNT_NO;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>816</xloc>
      <yloc>352</yloc>
