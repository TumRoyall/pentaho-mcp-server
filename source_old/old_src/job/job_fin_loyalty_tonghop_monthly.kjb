    <entry>
      <name>syn_log co du lieu</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO APPS.SYN_LOG
(TABLE_NAME, STATUS, SYN_DATE, ETL_DATE,TRANSACTION_DATE,SOURCE_SYSTEM,SO_LUONG, NOTE)
SELECT UPPER('APPS.FIN_LOYALTY_TONGHOP_MONTHLY'),
1,
TO_DATE('${PRD_ID}','YYYYMMDD'), 
SYSDATE ,
TO_DATE('${PRD_ID}','YYYYMMDD'),
'${Internal.Job.Name}', 
count(*), 
SYS_CONTEXT('USERENV', 'OS_USER')|| '_'||SYS_CONTEXT('USERENV', 'HOST')|| '_'||SYS_CONTEXT('USERENV', 'IP_ADDRESS')
from APPS.FIN_LOYALTY_TONGHOP_MONTHLY WHERE TRANSACTION_DATE BETWEEN TRUNC(to_date('${PRD_ID}','YYYYMMDD' ),'MONTH') AND last_day(to_date('${PRD_ID}' ,'YYYYMMDD'))</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>816</xloc>
      <yloc>448</yloc>
      <attributes_kjc/>
    </entry>
