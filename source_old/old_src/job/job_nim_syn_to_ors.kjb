    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>delete from apps.mb_agg_nim_lk
 where transaction_date = to_date('${PRD_ID}', 'YYYYMMDD');
commit;
insert into apps.mb_agg_nim_lk
  SELECT to_date('${PRD_ID}', 'YYYYMMDD') transaction_date,
         d_type,
         taikhoan,
         makh,
         mbld_type,
         product_code,
         productgr_code,
         category,
         sub_product,
         ROUND(loc_term, 2) loc_term,
         loaikyhan,
         sector,
         khoi,
         cn,
         nhomno_xhtd,
         nhomno_liendoi,
         nte,
         PROJECT_ID,
         FTP_CODE,
         PRODUCT_TYPE,
         round(SUM(balance *
                   to_number(substr(to_char(transaction_date, 'YYYYMMDD'),
                                    7,
                                    2)) /
                   to_number(to_char(to_date('${PRD_ID}', 'YYYYMMDD'), 'DDD'))),
               2) balance,
         round(SUM(balance_vnd *
                   to_number(substr(to_char(transaction_date, 'YYYYMMDD'),
                                    7,
                                    2)) /
                   to_number(to_char(to_date('${PRD_ID}', 'YYYYMMDD'), 'DDD'))),
               2) balance_vnd,
         round(SUM(nominal_interest), 2) INTEREST_CONTRACT_NOMINAL,
         round(SUM(nominal_interest_vnd), 2) INTEREST_CONTRACT_NOMINAL_VND,
         round(SUM(real_interest), 2) INTEREST_CONTRACT_REAL,
         round(SUM(real_interest_vnd), 2) INTEREST_CONTRACT_REAL_VND,
         round(SUM(INTEREST_FTP), 2) INTEREST_FTP_ACTUAL,
         round(SUM(INTEREST_FTP_VND), 2) INTEREST_FTP_ACTUAL_VND,
         round(SUM(INTEREST_FTP_TT), 2) INTEREST_FTP_REGULAR,
         round(SUM(INTEREST_FTP_TT_VND), 2) INTEREST_FTP_REGULAR_VND,
         round(SUM(PENALTY_INTEREST), 2) PENALTY_INTEREST,
         round(SUM(PENALTY_INTEREST_VND), 2) PENALTY_INTEREST_VND
    FROM apps.mb_agg_nim_m
   WHERE transaction_date BETWEEN
         trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'YEAR') and
         to_date('${PRD_ID}', 'YYYYMMDD')
   GROUP BY d_type,
            taikhoan,
            makh,
            mbld_type,
            product_code,
            productgr_code,
            category,
            sub_product,
            ROUND(loc_term, 2),
            loaikyhan,
            sector,
            khoi,
            cn,
            nhomno_xhtd,
            nhomno_liendoi,
            nte,
            PROJECT_ID,
            FTP_CODE,
            PRODUCT_TYPE;
commit;
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
