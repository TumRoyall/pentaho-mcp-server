    <entry>
      <name>update sync_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'MB_AGG_NIM_M',1,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(1),'etl_job_agg_nim_monthly'
from apps.MB_AGG_NIM_M a
where transaction_date = to_date(${PRD_ID},'yyyyMMdd');


insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'MB_AGG_NIM_LK',1,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(1),'etl_job_agg_nim_monthly'
from apps.MB_AGG_NIM_LK a
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')</sql>
