    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'FIN_PNL_CARD_TXN_DAILY' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'tckt_repo/etl_job/etl_job_FIN_PNL_CARD_TXN_DAILY' SOURCE_SYSTEM
FROM
  APPS.FIN_PNL_CARD_TXN_DAILY
  WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>880</xloc>
      <yloc>512</yloc>
      <attributes_kjc/>
