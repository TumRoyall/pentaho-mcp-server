    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'MAIL/FIN_PNL_CARD_TXN_DAILY' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  1 SO_LUONG,
  'tckt_repo/etl_job/etl_job_FIN_PNL_CARD_TXN_DAILY' SOURCE_SYSTEM
FROM
  DUAL
</sql>
