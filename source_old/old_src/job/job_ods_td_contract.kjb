      <name>ins syn_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'ODS_TD_CONTRACT' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  count(1) SO_LUONG,
  'TCKT_REPO/etl_job/etl_job_ODS_TD_CONTRACT' SOURCE_SYSTEM
FROM
  ETL.ODS_TD_CONTRACT
--where last_update_date between to_date('${PRD_ID}', 'yyyyMMDD') - 1 and to_date('${PRD_ID}', 'yyyyMMDD')
--and rownum =1
  --WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')</sql>
