    <entry>
      <name>has SMY.PL_TXN_DAILY?</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>ods_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>with tmp_log as (
select count(1) soluong from (
SELECT distinct syn_date from ETL.syn_log
where upper(table_name) = 'SMY.PL_TXN_DAILY'
and syn_date between trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
and to_date('${PRD_ID}', 'YYYYMMDD')
AND SO_LUONG &lt;&gt; 0
)
),
tmp_working_day as (
SELECT count(1) working_day FROM
ODS.DATES_REF
where CALENDAR_DATE between 
trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
and to_date('${PRD_ID}', 'YYYYMMDD')
and WORKING_DATE_IND = 'W'
)
select 1
from
tmp_log log
full join tmp_working_day wrk
on 1=1
where log.soluong = wrk.working_day</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>848</xloc>
      <yloc>144</yloc>
      <attributes_kjc/>
    </entry>
