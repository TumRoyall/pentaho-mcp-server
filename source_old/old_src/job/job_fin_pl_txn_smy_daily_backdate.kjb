    <entry>
      <name>insert syn log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM,
    NOTE
  )
SELECT
  'APPS.FIN_PL_TXN_DAILY_SMY_DAILY (BACKDATE)' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'TCKT_REPO/Engine TCKT/batch/jobs/job_fin_pl_txn_daily_smy_daily_backdate' SOURCE_SYSTEM,
  '${NOTE}' NOTE
FROM
  APPS.FIN_PL_TXN_DAILY_SMY_DAILY
