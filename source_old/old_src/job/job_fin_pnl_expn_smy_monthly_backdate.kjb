    <entry>
      <name>insert syn log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM,
    NOTE
  )
SELECT
  'FIN_PNL_EXPN_SMY_MONTHLY' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'TCKT_REPO/ETL_Jobs/etl_job_FIN_PNL_EXPN_SMY_MONTHLY_backdate' SOURCE_SYSTEM,
  'DU_LIEU_BACKDATE' NOTE
FROM
  APPS.FIN_PNL_EXPN_SMY_MONTHLY
WHERE TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MM') AND LAST_DAY(TO_DATE('${PRD_ID}', 'YYYYMMDD'))
  AND NGUON = 'DU_LIEU_BACKDATE' ;

INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'FIN_PNL_EXPN_SMY_MONTHLY_BACKDATE' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'TCKT_REPO/ETL_Jobs/etl_job_FIN_PNL_EXPN_SMY_MONTHLY_backdate' SOURCE_SYSTEM
FROM
  APPS.FIN_PNL_EXPN_SMY_MONTHLY
WHERE TXN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MM') AND LAST_DAY(TO_DATE('${PRD_ID}', 'YYYYMMDD'))
  AND NGUON = 'DU_LIEU_BACKDATE' ;

COMMIT ;</sql>
