      <replytoname/>
      <subject>[CANH BAO CHECK DU LIEU] Yeu cau check du lieu bang lien quan den luong dong bo bang ${TARGET_TABLE} ngay ${PRD_ID}</subject>
      <include_date>N</include_date>
      <contact_person/>
      <contact_phone/>
      <comment>Yeu cau check du lieu bang sau lien quan den luong dong bo bang ${TARGET_TABLE} ngay ${PRD_ID}
&lt;br>
ETL.ODS_GL_REPORT_DEFN_REF_FULL
&lt;br>
APPS.REF_SPSO_PLKHOI_MAP
&lt;br>

&lt;br>
WITH 
CHECK_CHI_TIEU AS
(SELECT REPORT_ITEM_CODE, REPORT_ITEM_NAME
FROM ETL.ODS_GL_REPORT_DEFN_REF_FULL
WHERE UPPER(REPORT_ITEM_NAME) LIKE '%SP%SO'
GROUP BY REPORT_ITEM_CODE, REPORT_ITEM_NAME
MINUS
SELECT REPORT_ITEM_CODE, REPORT_ITEM_NAME
FROM APPS.REF_SPSO_PLKHOI_MAP)
SELECT * FROM CHECK_CHI_TIEU
&lt;br>

&lt;br>
Tran trong.</comment>
