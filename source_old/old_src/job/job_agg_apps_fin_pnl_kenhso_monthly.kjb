      <name>syn_log co du lieu</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO APPS.SYN_LOG
(TABLE_NAME, STATUS, SYN_DATE, ETL_DATE,TRANSACTION_DATE,SOURCE_SYSTEM,SO_LUONG, NOTE)
SELECT UPPER('APPS.FIN_PNL_KENHSO_MONTHLY'),
1,
TO_DATE('${PRD_ID}','YYYYMMDD'), 
SYSDATE ,
TO_DATE('${PRD_ID}','YYYYMMDD'),
'${Internal.Job.Name}', 
COUNT(1), 
'DAT LICH TREN JOE'
FROM APPS.FIN_PNL_KENHSO_MONTHLY WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}','YYYYMMDD')</sql>
