    <entry>
      <name>APPS.FIN_CHIASE_PHI_COMBO_MTH</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>DELETE APPS.FIN_CHIASE_PHI_COMBO_MTH WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD');
COMMIT;
INSERT INTO APPS.FIN_CHIASE_PHI_COMBO_MTH 
( 
TRANSACTION_DATE 
, CHITIEU_PLKHOI_NAME 
, CHITIEU_PLKHOI 
, KHOI 
, KHOI_THEOPLKHOI 
, PRODUCT_TYPE 
, SOURCE_TABLE 
, SP_DV 
, PRODUCT_CODE 
, SPSO_TYPE 
, LINET24 
, ACCTNBR 
, SOTK 
, MAKH 
, CHG_CODE 
, CN 
, KENH_GD 
, DOANHSO_KH 
, DOANHSO_HOPDONG 
, PHI_COMBO_KH 
, PHI_PHANBO_HOPDONG 
, PHAN_KHUC 
, CUS_STATUS 
, APP_BIZ_STATUS 
)
/*
with fee_kh AS
    (SELECT PARTITION_DATE,
        MAKH,
        CHITIEU_PLKHOI,
        CHITIEU_PLKHOI_NAME,
        khoi,
        a.chg_code,
        linet24,
        acctnbr,
        khoi_theoplkhoi,
        b.SPSO_TYPE,
        a.PRODUCT_CODE,
        sum(TIENNO_VND) PHI_COMBO
    FROM apps.MB_AGG_THLK_TOI_SP_TMP3 a
    INNER JOIN APPS.COMBO_BLOCK_CHG_CODE b
    	ON a.CHG_CODE = b.CHG_CODE
    WHERE PARTITION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
    GROUP BY PARTITION_DATE,
        MAKH,
        CHITIEU_PLKHOI,
        CHITIEU_PLKHOI_NAME,
        khoi,
        khoi_theoplkhoi,
        a.chg_code,
        a.PRODUCT_CODE,
        linet24,
        acctnbr,
        b.spso_type)*/
with fee_kh AS
    (SELECT TRANSACTION_DATE PARTITION_DATE,
        MAKH,
        CHITIEU_PLKHOI,
        CHITIEU_PLKHOI_NAME,
        khoi,
        a.chg_code,
        linegl linet24,
        acctnbr,
        khoi_plkhoi khoi_theoplkhoi,
        b.SPSO_TYPE,
        a.PRODUCT_CODE,
        sum(TIENNO_VND) PHI_COMBO
    FROM ETL.TMP_TOI_SOURCE_INPUT a
    INNER JOIN APPS.COMBO_BLOCK_CHG_CODE b
    	ON a.CHG_CODE = b.CHG_CODE
    WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
    GROUP BY TRANSACTION_DATE,
        MAKH,
        CHITIEU_PLKHOI,
        CHITIEU_PLKHOI_NAME,
        khoi,
        khoi_plkhoi,
        a.chg_code,
        a.PRODUCT_CODE,
        linegl,
        acctnbr,
        b.spso_type)
, ds_kh AS
    (SELECT TRANSACTION_DATE,
        MAKH,
        khoi,
        CASE
            WHEN t.CONTRACT_ID LIKE 'FT%' AND t.Y_IMP_EXP = 'TTR NK' THEN 'TTTM_TTR'
            WHEN t.CONTRACT_ID LIKE 'TF%' THEN 'TTTM_TTQT'
        END SPSO_TYPE,
        sum(nvl(t.DOANHSO,0) * a.CONVERSION_RATE) DOANHSO_KH
    FROM apps.FIN_TTTM_TRANS_DAILY t
    LEFT JOIN etl.ORS_GL_DAILY_RATES a
        ON t.ngay_ps = a.CONVERSION_DATE
        AND t.CCY = a.FROM_CURRENCY
        AND a.TO_CURRENCY = 'USD'
    WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
        AND t.TTTM_TYPE = 'TTQT'
    GROUP BY TRANSACTION_DATE,
        MAKH,
        khoi,
        CASE
            WHEN t.CONTRACT_ID LIKE 'FT%' AND t.Y_IMP_EXP = 'TTR NK' THEN 'TTTM_TTR'
            WHEN t.CONTRACT_ID LIKE 'TF%' THEN 'TTTM_TTQT'
        END
    HAVING sum(nvl(t.DOANHSO,0) * a.CONVERSION_RATE) > 0
    UNION ALL
    SELECT TRANSACTION_DATE,
        MAKH,
        khoi,
        'BAO LANH' SPSO_TYPE,
        sum(DOANHSO_BL_MOI_THANG) DOANHSO_KH
    FROM apps.FIN_GUARANTEE_SMY_MONTHLY
    WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
    GROUP BY TRANSACTION_DATE,
        MAKH,
        khoi
    HAVING sum(DOANHSO_BL_MOI_THANG) > 0),
ds_hopdong as
    (SELECT TRANSACTION_DATE,
        t.CONTRACT_ID SOTK,
        t.MAKH,
        t.khoi,
        t.CN CN,
        CASE
            WHEN t.CONTRACT_ID LIKE 'FT%' AND t.Y_IMP_EXP = 'TTR NK' THEN 'TTTM_TTR'
            WHEN t.CONTRACT_ID LIKE 'TF%' THEN 'TTTM_TTQT'
        END SPSO_TYPE,
        CHANNEL KENH_GD,
        NULL product_code,
        sum(nvl(t.DOANHSO,0) * a.CONVERSION_RATE) DOANHSO_HOPDONG
    FROM apps.FIN_TTTM_TRANS_DAILY t
    LEFT JOIN etl.ORS_GL_DAILY_RATES a
        ON t.ngay_ps = a.CONVERSION_DATE
        AND t.CCY = a.FROM_CURRENCY
        AND a.TO_CURRENCY = 'USD'
    WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
        AND t.TTTM_TYPE = 'TTQT'
    GROUP BY TRANSACTION_DATE,
        t.CONTRACT_ID,
        t.MAKH,
        t.khoi,
        t.CN,
        CASE
            WHEN t.CONTRACT_ID LIKE 'FT%' AND t.Y_IMP_EXP = 'TTR NK' THEN 'TTTM_TTR'
            WHEN t.CONTRACT_ID LIKE 'TF%' THEN 'TTTM_TTQT'
        END,
        CHANNEL
    HAVING sum(nvl(t.DOANHSO,0) * a.CONVERSION_RATE) > 0
    UNION ALL
    SELECT TRANSACTION_DATE,
        MD_ID SOTK,
        MAKH,
        khoi,
        CN,
        'BAO LANH' SPSO_TYPE,
        KENH_GD,
        PRODUCT_CODE,
        sum(DOANHSO_BL_MOI_THANG) DOANHSO_HOPDONG
    FROM apps.FIN_GUARANTEE_SMY_MONTHLY
    WHERE TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD')
    GROUP BY TRANSACTION_DATE,
        MD_ID,
        MAKH,
        khoi,
        CN,
        KENH_GD,
        PRODUCT_CODE
    HAVING sum(DOANHSO_BL_MOI_THANG) > 0)
SELECT a.PARTITION_DATE transaction_date,
    a.CHITIEU_PLKHOI_NAME,
    a.CHITIEU_PLKHOI,
    f.khoi,
    a.khoi_theoplkhoi,
    'O2O' product_type,
    'PHAN_BO_COMBO/BLOCK' SOURCE_table,
    d.sp_dv,
    coalesce(c.PRODUCT_CODE, e.PRODUCT_CODE, a.product_code) PRODUCT_CODE,
    a.SPSO_TYPE,
    a.linet24,
    a.acctnbr,
    c.sotk,
    a.makh,
    a.chg_code,
    c.cn,
    nvl(c.KENH_GD, f.KENH_GD) KENH_GD,
    nvl(b.DOANHSO_KH, 0) DOANHSO_KH,
    c.DOANHSO_HOPDONG,
    a.PHI_COMBO PHI_COMBO_KH,
    CASE
        WHEN nvl(b.DOANHSO_KH, 0) = 0 THEN a.PHI_COMBO/2
        ELSE c.DOANHSO_HOPDONG/b.DOANHSO_KH * a.PHI_COMBO
    END PHI_PHANBO_HOPDONG,
    f.phan_khuc,
    f.cus_status,
    f.app_biz_status
FROM fee_kh a
LEFT JOIN ds_kh b
    ON a.makh = b.makh
    and a.SPSO_TYPE = b.SPSO_TYPE
    and b.SPSO_TYPE IS NOT NULL
LEFT JOIN ds_hopdong c
    on b.makh = c.makh
    and b.SPSO_TYPE = c.SPSO_TYPE
    AND c.SPSO_TYPE IS NOT NULL
LEFT JOIN etl.ODS_TF_CONTRACT e
    ON c.sotk = e.ARRANGEMENT_NBR
LEFT JOIN etl.ORS_MB_PRODUCT_CODE d
    ON coalesce(c.PRODUCT_CODE, e.PRODUCT_CODE, a.PRODUCT_CODE) = d.PRODUCT_CODE
LEFT JOIN (
        SELECT 'ONLINE' KENH_GD FROM dual
        UNION
        SELECT 'OFFLINE' KENH_GD FROM dual
    ) f
    ON nvl(b.DOANHSO_KH, 0) = 0
    AND 1 = 1
LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY f
    ON a.makh = f.makh
    AND f.transaction_date = to_date(${PRD_ID}, 'YYYYMMDD')
;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>944</xloc>
      <yloc>32</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
