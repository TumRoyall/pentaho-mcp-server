    <entry>
      <name>ETL.TMP_FTP_CD_ONLINES</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.TMP_FTP_CD_ONLINES;

INSERT INTO ETL.TMP_FTP_CD_ONLINES
    ( 
    ID 
    , REPORT_ITEM_CODE 
    , REPORT_ITEM_NAME 
    , GL_LINE 
    , FTP_CODE 
    , LCY_AMT 
    )
SELECT taikhoan id,
'A12246FTP' REPORT_ITEM_CODE,
'- Thu FTP ban von CCTG phat hanh SP SO' REPORT_ITEM_NAME,
NULL GL_line,
FTP_CODE,
sum(amt_lcy) lcy_amt
FROM
(SELECT a.taikhoan, a.FTP_CODE, a.amt_lcy FROM apps.TR_FTP_CUS a WHERE TRANSACTION_DATE = to_date(${PRD_ID},'YYYYMMDD') AND PRODUCT_CODE = '12912'
UNION ALL
SELECT taikhoan, FTP_CODE, amt_lcy  FROM apps.TR_FTP_CUS_DIEUCHINH WHERE TRANSACTION_DATE = to_date(${PRD_ID},'YYYYMMDD') AND PRODUCT_CODE = '12912')
GROUP BY taikhoan, FTP_CODE;
/*
SELECT id
    , 'A12246FTP' REPORT_ITEM_CODE
    , '- Thu FTP ban von CCTG phat hanh SP SO' REPORT_ITEM_NAME
    , NULL GL_LINE
    , FTP_PROD FTP_CODE
    , SUM (NVL (FTP_SDC, 0) + NVL (FTP_HDDB, 0)) lcy_amt
FROM APPS.FTP_CHUNGCHI_TG_ONLINE
WHERE TRANSACTION_DATE BETWEEN TRUNC (to_date(${PRD_ID}, 'YYYYMMDD'), 'MONTH') AND to_date(${PRD_ID}, 'YYYYMMDD')
AND FTP_PROD = 'HD106'
GROUP BY id, FTP_PROD;
*/</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
