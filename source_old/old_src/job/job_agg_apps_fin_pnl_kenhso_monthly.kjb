      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1328</xloc>
      <yloc>400</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>ETL.CD_ONLINE_CHIASE_SOCAP</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.CD_ONLINE_CHIASE_SOCAP;

INSERT INTO ETL.CD_ONLINE_CHIASE_SOCAP
    ( 
    TRANSACTION_DATE 
    , CI_CONTRACT 
    , REPORT_ITEM_CODE 
    , REPORT_ITEM_NAME 
    , KHOI 
    , GL_LINE 
    , FTP_CODE 
    , LCY_AMT 
    , TYLE_KHOI_PB 
    )
WITH tmp_tyle_phanbo AS 
    ( SELECT ( CASE WHEN a2.KHOI = 'NHS' AND a2.SECTOR BETWEEN '1910' AND '1969' THEN 'INDIV' WHEN 
                a2.KHOI = 'NHS' AND a2.SECTOR BETWEEN '1970' AND '1979' THEN 'CIB' WHEN a2.KHOI = 
                'NHS' AND a2.SECTOR BETWEEN '1980' AND '1989' THEN 'SME' ELSE a2.KHOI END ) KHOI 
        , SUM(a1.LAI_SOCAP) - SUM(a1.FTP_SOCAP) Net_off
    FROM etl.ors_cal_ftp_chungchi_tg_online_thucap a1 --b? ch? cal -- b?ng 
        -- apps.ftp_chungchi_tg_online_thucap ??ng b? t? ors
    LEFT JOIN apps.FIN_SMY_CUSTOMER_MONTHLY a2 ON a2.TRANSACTION_DATE = to_date(${PRD_ID}, 'YYYYMMDD') AND a1.ASSIGNER = a2.MAKH
    GROUP BY ( CASE WHEN a2.KHOI = 'NHS' AND a2.SECTOR BETWEEN '1910' AND '1969' THEN 'INDIV' WHEN 
                a2.KHOI = 'NHS' AND a2.SECTOR BETWEEN '1970' AND '1979' THEN 'CIB' WHEN a2.KHOI = 
                'NHS' AND a2.SECTOR BETWEEN '1980' AND '1989' THEN 'SME' ELSE a2.KHOI END )
    )
SELECT to_date(${PRD_ID}, 'YYYYMMDD') transaction_date 
    , id CI_CONTRACT 
    , REPORT_ITEM_CODE 
    , REPORT_ITEM_NAME 
    , c.khoi 
    , GL_LINE 
    , FTP_CODE 
    , lcy_amt * c.TYLE_KHOI_PB lcy_amt 
    , c.TYLE_KHOI_PB
FROM (SELECT * 
    FROM ETL.TMP_FTP_CD_ONLINES
     
    UNION ALL
     
    SELECT * 
    FROM ETL.TMP_CHI_LAI_CD_ONLINES) b
JOIN 
    ( SELECT khoi 
        , net_off / 
        ( SELECT SUM(net_off)
        FROM tmp_tyle_phanbo ) TYLE_KHOI_PB
    FROM tmp_tyle_phanbo ) c ON 1 = 1;</sql>
