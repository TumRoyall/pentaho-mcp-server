    <entry>
      <name>update sync_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'MB_AGG_NIM_M',1,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
so_luong,'etl_job_agg_nim_monthly'
from (select count(*) so_luong from 
apps.MB_AGG_NIM_M a
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')) a</sql>
