    <entry>
      <name>xoa du lieu cu 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>delete from apps.mb_agg_nim_m
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and d_type = 'LOAN'
and taikhoan in ('FT18253675134394','FT18253675134396');

update apps.mb_agg_nim_m
set khoi = 'INDIV'
where  transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and khoi is null
and sector in ('1913','1746','1910','1706','1899','1701','1607','1704','1843',
'1800','1705','1745','1880','1801','1606','1830','1740','1702','1741','1803',
'1700','1912','1730','1850','1605','1742','1840','1743','1703','1802','1841');

update apps.mb_agg_nim_m
set khoi = 'SME'
where  transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and khoi is null
and sector in ('9000','1201','1900','1200','1600','1905','1202','1301',
'1001','1103','1102','9002','1002','1300');
</sql>
