    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log(table_name, syn_date, etl_date, so_luong)
select 'APPS.ACTIVE_SMS' table_name, TO_DATE('${PRD_ID}','yyyyMMdd') syn_date, sysdate etl_date, count(1) so_luong
from  apps.ACTIVE_SMS
where txn_date  = to_date('${PRD_ID}', 'yyyyMMdd')
</sql>
