    <entry>
      <name>check source</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>gl_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
      <limit>5</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>SELECT DISTINCT(REPORT_CODE) 
FROM MBG.MBG_RPT_DATA_STATUS 
WHERE STATUS_FLAG = 'Y'
AND REPORT_CODE IN ('CDPS', 'KQKD', 'CDKT', 'SCTTK', 'KQKDQT')
AND SOURCE_TYPE = 'A'
AND PERIOD_TYPE = 'MTH'
--AND COMPANY_CODE='MBAL'
--AND PERIOD_CODE LIKE '${PRD_M}'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
