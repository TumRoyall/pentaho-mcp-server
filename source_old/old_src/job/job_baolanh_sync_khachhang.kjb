    <entry>
      <name>update sync_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,source_system,so_luong)
select upper('ORS_TR_KHACHHANG'),1,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')),'etl_job_baolanh_sync_khachhang'
,count(*)
from etl.ORS_TR_KHACHHANG</sql>
