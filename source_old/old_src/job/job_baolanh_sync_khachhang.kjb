    <entry>
      <name>Insert cus data</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>create table etl.ORS_TR_KHACHHANG as
(
  SELECT 
CN,
MAKH,
KHOI,
HOTEN,
QUOCTICH,
RESEDENCE,
SECTOR,
INDUSTRY_CODE,
CREATION_DATE,
GIOITINH,
MARITAL_STATUS,
SIGNATURE_T24,
CUS_STATUS,
SHOP_CODE,
cmnd_bk, msthue_bk, LAST_UPDATEd_DATE, gpdkkd_bk
  from etl.ORS_TR_KHACHHANG_old
  where makh not in (
  select makh 
  from etl.ORS_TR_KHACHHANG_update
  )
  union all
  SELECT 
CN,
MAKH,
KHOI,
HOTEN,
QUOCTICH,
RESEDENCE,
SECTOR,
INDUSTRY_CODE,
CREATION_DATE,
GIOITINH,
MARITAL_STATUS,
SIGNATURE_T24,
CUS_STATUS,
SHOP_CODE,
cmnd_bk, msthue_bk, LAST_UPDATEd_DATE, gpdkkd_bk
  from etl.ORS_TR_KHACHHANG_update
)

;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
