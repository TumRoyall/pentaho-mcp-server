    <entry>
      <name>check log MA tool</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>matool_postgres_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>select 
     a.upload_code,
     a.uploaded_at,
     a.uploaded_by,
     a.approved_at,
     a.approved_by,
     a.status,
     a.num_record,
     inf.db_type,
     inf.schema_name,
     inf."name" as table_name,
a.file_name,
a.description
 
from public.app_upload a
left join public.app_tableupload inf
on a.table_id = inf.id
 
where 1=1
     and a.status = '5'
     and a.approved_at is not null
     and inf.db_type = 'ORACLE-STAGING-OTHER'
     and inf.schema_name = 'EXT'
	 and name  = 'MA_FILE_FTP_HACHTOAN_DIEUCHINH'
     and a.approved_at >= to_date('${PRD_ID}','yyyyMMdd')
order by
     a.approved_at desc</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>304</xloc>
      <yloc>64</yloc>
      <attributes_kjc/>
    </entry>
