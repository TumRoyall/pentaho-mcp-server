  <entries>
    <entry>
      <name>PROCESS 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>

CREATE TABLE mb_pm_messages_receivers
AS
    SELECT /*+ parallel(4) */
          mri.receiver_id,
           mri.messages_id,
           mri.id,
           mri.partner_id,
           CHANNEL_ID
      FROM PUSHMESSAGE.MB_PM_MESSAGES_RECEIVERS--_ARCHIVE
           PARTITION FOR (TO_DATE ('${PRD_ID}', 'YYYYMMDD')) mri
     WHERE     mri.status = 'SUCCESS'
           AND mri.channel_id = 'SMS'
           AND partner_id IN ('8062', '8264', '8664');
           
 

create table MB_PM_MESSAGES 
as  


select /*+ parallel(6) */   id , mi.MSG_TYPE,
mi.SOURCE_APP_ID,
MSG_CREATED_DT,
to_char(mi.BODY_SHORT_CONTENT)   BODY_SHORT_CONTENT

 from PUSHMESSAGE.MB_PM_MESSAGES   PARTITION FOR (TO_DATE ('${PRD_ID}', 'YYYYMMDD')) mi
 where   mi.MSG_TYPE IN(SELECT MSG_TYPE FROM ETL.mb_pm_message_type_info)
;

create table bdsd
as  
 
SELECT
/*+ parallel(6) */ 

CASE
WHEN LENGTH(BODY_SHORT_CONTENT) &lt;= 160 THEN 1
when LENGTH(BODY_SHORT_CONTENT) > 160 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 306 then 2
when LENGTH(BODY_SHORT_CONTENT) > 306 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 459 then 3
ELSE 4
END TOTAL_MESS_SHORT,
---
CASE 
  WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_BD' and lower(mi.body_short_content) like '%tra lai tien gui%' THEN 'BDSD_TRALAI'
  ELSE 'OTHER'
END MSG_TYPE_2,
---
CASE
WHEN mnp.mobile is not null and mnp.created_date &lt; mi.MSG_CREATED_DT THEN mnp.provider
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8486', '8496', '8497', '8498', '8432', '8433', '8434', '8435', '8436', '8437', '8438', '8439') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('086', '096', '097', '098', '032', '033', '034', '035', '036', '037', '038', '039') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8489', '8490', '8493', '8470', '8479', '8477', '8476', '8478') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('089', '090', '093', '070', '079', '077', '076', '078') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8488', '8491', '8494', '8483', '8484', '8485', '8481', '8482') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('088', '091', '094', '083', '084', '085', '081', '082') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('055') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8455') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('052', '056', '058', '092') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8452', '8456', '8458', '8492') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('087') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8487') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('099','059') THEN 'BELINE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8499','8459') THEN 'BELINE'
ELSE 'OTHER'
END TELCO,
CASE 
  WHEN TO_NUMBER(regexp_replace(SUBSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1), INSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1),' ', -1)), '[^0-9]')) &lt; 50000 THEN '1' 
  WHEN TO_NUMBER(regexp_replace(SUBSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1), INSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1),' ', -1)), '[^0-9]')) &lt; 100000 THEN '2' 
  WHEN TO_NUMBER(regexp_replace(SUBSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1), INSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1),' ', -1)), '[^0-9]')) &lt; 200000 THEN '3' 
  WHEN TO_NUMBER(regexp_replace(SUBSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1), INSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1),' ', -1)), '[^0-9]')) &lt; 500000 THEN '4' 
  WHEN TO_NUMBER(regexp_replace(SUBSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1), INSTR(substr(mi.BODY_SHORT_CONTENT, 1, instr(mi.BODY_SHORT_CONTENT,'VND') -1),' ', -1)), '[^0-9]')) &lt; 1000000 THEN '5'
  ELSE '6'
END GTGD,
---

---
case
  when lower(mi.BODY_SHORT_CONTENT) like '%viettelpay%' then 'viettelpay'
  when lower(mi.BODY_SHORT_CONTENT) like '%viettel%' then 'viettel'
  when lower(mi.BODY_SHORT_CONTENT) like '%bankplus%' then 'bankplus'
  when lower(mi.BODY_SHORT_CONTENT) like '%cob bnk%' -- canh bao cob t24
       or lower(mi.BODY_SHORT_CONTENT) like '%[dwh]%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_dn]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_ho]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_hcm]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%monitor%'
       or lower(mi.BODY_SHORT_CONTENT) like '%cob%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mb alert:%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: warning%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: critical%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: fatal%' then 'cntt' -- canh bao cua cntt
  when lower(mi.BODY_SHORT_CONTENT) like '%mb kinh moi quy khach khao sat%' then 'mangluoi'
  when lower(mi.BODY_SHORT_CONTENT) like '%d/c%' then 'hanhchinh'
  when lower(mi.BODY_SHORT_CONTENT) like '%bieu lai suat%'
       or (lower(mi.BODY_SHORT_CONTENT) like '%gia tb%' and lower(mi.BODY_SHORT_CONTENT) like '%kl:%') 
       or lower(mi.BODY_SHORT_CONTENT) like 'chuyen/nhan tien quoc te' then 'treasury'
  when lower(mi.BODY_SHORT_CONTENT) like '%phong van%'
       or lower(mi.BODY_SHORT_CONTENT) like '%finding captain%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tuyen dung%' then 'nhansu'   
  when lower(mi.BODY_SHORT_CONTENT) like '%sd the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%so du the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%ma xac thuc gd online cua quy khach la%' -- otp 3d secure
       or lower(mi.BODY_SHORT_CONTENT) like '%gia tri giao dich dau tien%' --
       or lower(mi.BODY_SHORT_CONTENT) like '%atm%'
       or lower(mi.BODY_SHORT_CONTENT) like '%pos%'
       or lower(mi.BODY_SHORT_CONTENT) like '%jcb%'
       or lower(mi.BODY_SHORT_CONTENT) like '%visa%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mbcard%'
       or lower(mi.BODY_SHORT_CONTENT) like '%way4%'
       or lower(mi.BODY_SHORT_CONTENT) like '%w4%' then 'ttkdthe'
 when (lower(mi.BODY_SHORT_CONTENT) like '%tk %' and lower(mi.BODY_SHORT_CONTENT) like '%|sd:%') then 'bdsd tk'
 when lower(mi.BODY_SHORT_CONTENT) like '%mb star%'
      or lower(mi.BODY_SHORT_CONTENT) like '%loyalty%'
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan duoc qua tang%' --
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan qua%' then 'loyalty' 
when lower(mi.BODY_SHORT_CONTENT) like '%tra lai tien gui%' then 'tra lai tien gui'
when lower(mi.BODY_SHORT_CONTENT) like '%dang ky online%'
    or lower(mi.BODY_SHORT_CONTENT) like '%dang chuyen tien%' --
    or lower(mi.BODY_SHORT_CONTENT) like '%tat toan: az%'
    or lower(mi.BODY_SHORT_CONTENT) like '%chao mung quy khach den voi dv mb ebanking%'
    or lower(mi.BODY_SHORT_CONTENT) like '%cap lai mat khau thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%vui long su dung ten dang nhap%'
    or lower(mi.BODY_SHORT_CONTENT) like '%gioi thieu nhieu nhan tien%'
    or lower(mi.BODY_SHORT_CONTENT) like '%emb%'
    or lower(mi.BODY_SHORT_CONTENT) like '%biz mbbank%'
    or lower(mi.BODY_SHORT_CONTENT) like '%tk thau chi%'
    or lower(mi.BODY_SHORT_CONTENT) like '%: tktc%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%so du%' and lower(mi.BODY_SHORT_CONTENT) like '%thanh toan%')
    or lower(mi.BODY_SHORT_CONTENT) like '%app mbbank%'
   or lower(mi.BODY_SHORT_CONTENT) like '%ban da tat toan thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%ebanking%' then 'nhs-kenh so'
 when lower(mi.BODY_SHORT_CONTENT) like '%cash by code%' then 'cash by code' 
 when lower(mi.BODY_SHORT_CONTENT) like '%tai khoan so dep%' then 'nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%otp%' then 'otp nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%sms banking%' then 'sms banking'
  when lower(mi.BODY_SHORT_CONTENT) like '%khdn%'
    or lower(mi.BODY_SHORT_CONTENT) like '%hddt so%'
    or lower(mi.BODY_SHORT_CONTENT) like '%sme%' 
    or lower(mi.BODY_SHORT_CONTENT) like '%business package%'
    or lower(mi.BODY_SHORT_CONTENT) like '%visa commerce%' then 'khdn'
  when lower(mi.BODY_SHORT_CONTENT) like '%ld%'
      or lower(mi.BODY_SHORT_CONTENT) like '%ban da vay thanh cong%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%khoan vay%' and lower(mi.BODY_SHORT_CONTENT) like '%qhkh%') then 'vay ld'
 when lower(mi.BODY_SHORT_CONTENT) like '%the tin dung%'
  or lower(mi.BODY_SHORT_CONTENT) like '%giao dich the%'
        or lower(mi.BODY_SHORT_CONTENT) like '%dich vu the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%mb:the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%the%' then 'the'
else 'other'
end PHANBO,
CASE
  WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_BD' and lower(mi.body_short_content) like '%tra lai tien gui%' THEN 'TRALAITIENGUI'
    WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_CD' and (upper(mi.body_short_content) like '%CONG TY CO PHAN TRUYEN THONG IRIS%' or upper(mi.body_short_content) like '%CTCP CONG NGHE VA DICH VU MOCA%') THEN 'IRIS_MOCA'
    --WHEN mi.MSG_TYPE = 'MSG_SMS_OTP_BANKING' and lower(mi.body_short_content) like '%ma xac thuc co hieu luc trong vong 5 phut.qk luu y khong cung cap otp cho bat ky ai. cam on quy khach da su dung%' THEN 'OTP_BANKING'
      END PHANLOAI,
---
mri.ID,
mi.MSG_TYPE,
mi.SOURCE_APP_ID,
RECEIVER_ID,
mri.PARTNER_ID,
'BDSD' SOURCE

FROM  etl.MB_PM_MESSAGES_RECEIVERS mri
INNER JOIN etl.MB_PM_MESSAGES mi ON mi.ID = mri.MESSAGES_ID AND MI.MSG_TYPE IN ('MSG_SMS_BDSD_BULKSMS_CD','MSG_SMS_BDSD_BULKSMS_BD','MSG_SMS_BDSD_T24_DIRECT', 'MSG_SMS_BDSD_W4_VTPAY')
left join ETL.Tb_Mnp mnp on mri.receiver_id = mnp.mobile  ;

--------------------------------------------------OTP
create table otp NOLOGGING as
SELECT /*+ parallel(6) */ 
---
CASE
WHEN LENGTH(BODY_SHORT_CONTENT) &lt;= 160 THEN 1
when LENGTH(BODY_SHORT_CONTENT) > 160 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 306 then 2
when LENGTH(BODY_SHORT_CONTENT) > 306 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 459 then 3
ELSE 4
END TOTAL_MESS_SHORT,
---
CASE
WHEN mnp.mobile is not null and mnp.created_date &lt; mi.MSG_CREATED_DT THEN mnp.provider
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8486', '8496', '8497', '8498', '8432', '8433', '8434', '8435', '8436', '8437', '8438', '8439') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('086', '096', '097', '098', '032', '033', '034', '035', '036', '037', '038', '039') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8489', '8490', '8493', '8470', '8479', '8477', '8476', '8478') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('089', '090', '093', '070', '079', '077', '076', '078') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8488', '8491', '8494', '8483', '8484', '8485', '8481', '8482') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('088', '091', '094', '083', '084', '085', '081', '082') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('055') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8455') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('052', '056', '058', '092') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8452', '8456', '8458', '8492') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('087') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8487') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('099','059') THEN 'BELINE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8499','8459') THEN 'BELINE'
ELSE 'OTHER'
END TELCO,
CASE
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang BAT DANG NHAP KHUON MAT')) >=1 THEN 'OTP_01'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang BAT DANG NHAP VAN TAY')) >=1 THEN 'OTP_02'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang BAT TRA CUU TAI KHOAN QUA SO DIEN THOAI')) >=1 THEN 'OTP_03'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang CAP NHAT HINH THUC THANH TOAN SAO KE')) >=1 THEN 'OTP_04'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang CHUYEN TIEN')) >=1 THEN 'OTP_05'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang dang ky APP CTV')) >=1 THEN 'OTP_06'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang DANG KY ONLINE')) >=1 THEN 'OTP_07'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang DOI EMAIL')) >=1 THEN 'OTP_08'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang DOI MAT KHAU')) >=1 THEN 'OTP_09'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang DONG INTERNET')) >=1 THEN 'OTP_10'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang DONG TAI KHOAN THANH TOAN')) >=1 THEN 'OTP_11'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang GD DANG KY THANH TOAN TU DONG')) >=1 THEN 'OTP_12'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang GD DIEU CHINH DANG KY THANH TOAN TU DONG')) >=1 THEN 'OTP_13'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang GIA HAN THE')) >=1 THEN 'OTP_14'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang HUY LIEN KET THIET BI')) >=1 THEN 'OTP_15'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang IN THE VAT LY')) >=1 THEN 'OTP_16'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang KHOA THE')) >=1 THEN 'OTP_17'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang kich hoat phuong thuc xac thuc Digital OTP tren may')) >=1 THEN 'OTP_18'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang KICH HOAT THE')) >=1 THEN 'OTP_19'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang MO KHOA THE')) >=1 THEN 'OTP_20'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang PHAT HANH THE')) >=1 THEN 'OTP_21'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang TAT TOAN TKS')) >=1 THEN 'OTP_22'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang THANH TOAN')) >=1 THEN 'OTP_23'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien CHUYEN TIEN')) >=1 THEN 'OTP_24'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien RUT TIEN ATM')) >=1 THEN 'OTP_25'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien THANH TOAN')) >=1 THEN 'OTP_26'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien TRA NO')) >=1 THEN 'OTP_27'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien TRA NO VAY')) >=1 THEN 'OTP_28'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien VAY THEM')) >=1 THEN 'OTP_29'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang thuc hien VAY TRUC TUYEN')) >=1 THEN 'OTP_30'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang TIEN GUI SO')) >=1 THEN 'OTP_31'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang VAY TRUC TUYEN')) >=1 THEN 'OTP_32'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang XEM SO THE FULL')) >=1 THEN 'OTP_33'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban dang YEU CAU CAP LAI MAT KHAU')) >=1 THEN 'OTP_34'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ban thuc hien tat toan goi dau tu')) >=1 THEN 'OTP_35'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Chao mung Quy Khach den voi DV MB eBanking')) >=1 THEN 'OTP_36'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'de mo lien ket tai khoan MB tren ung dung eTax')) >=1 THEN 'OTP_37'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'de thanh toan khoan nop thue tren ung dung eTax')) >=1 THEN 'OTP_38'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'dung cho dich vu Cash by code')) >=1 THEN 'OTP_39'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc GD online cua QK')) >=1  AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Cam on QK da su dung dich vu the MB')) >=1 THEN 'OTP_40'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich chuyen tien va co hieu luc 2 phut')) >=1 THEN 'OTP_41'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich co hieu luc trong vong 2 phut')) >=1 THEN 'OTP_42'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich tren MB eBanking')) >=1 THEN 'OTP_43'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc yeu cau topup')) >=1 THEN 'OTP_44'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'QK dang thuc hien GD Dong vi/TKDT tren app doi tac cua MB')) >=1 THEN 'OTP_45'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'QK hoac ai do dang dang ky Digital OTP tren app MBBANK tren 1 thiet bi moi')) >=1 THEN 'OTP_46'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach da dang ky thanh cong BIZ MBBank')) >=1 THEN 'OTP_47'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach da huy tinh nang xac thuc bang Digital OTP tren thiet bi')) >=1 THEN 'OTP_48'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach da kich hoat thanh cong Digital OTP de xac thuc giao dich qua App BIZ MB')) >=1 THEN 'OTP_49'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach da nhap sai ma xac thuc 3 lan')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'MO3D')) >=1 THEN 'OTP_50'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach da thuc hien mo Tai khoan so dep')) >=1 THEN 'OTP_51'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach dang thuc hien giao dich tren BIZ MBBank')) >=1 THEN 'OTP_52'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'THE')) >=1  AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD KHONG THANH CONG DO CHUA DANG KY CHI TIEU ONLINE')) >=1 THEN 'OTP_53'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'xac thuc giao dich nap tien tu the MB vao VIETTELPAY')) >=1 THEN 'OTP_54'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_BANKING' AND  INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich tren co hieu luc trong vong 2 phut')) >=1 THEN 'OTP_BANKING_01'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_BANKING' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich tren vi co hieu luc trong vong 2 phut')) >=1 THEN 'OTP_BANKING_02'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_BANKING' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc lien ket vi va kich hoat chi tieu internet tren the co hieu luc trong vong 2p')) >=1 THEN 'OTP_BANKING_03'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_BANKING' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach da dang ky thanh cong BIZ MBBank')) >=1 THEN 'OTP_BANKING_04'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_BANKING' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach dang thuc hien dang ky dich vu tai www.mbbank.com.vn')) >=1 THEN 'OTP_BANKING_05'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_BANKING' AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Quy khach dang thuc hien GD tren MB Star')) >=1 THEN 'OTP_BANKING_06'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_VNPOST' AND  INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich chuyen tien va co hieu luc 2 phut')) >=1 THEN 'OTP_VNPOST_01'
  WHEN MI.MSG_TYPE = 'MSG_SMS_OTP_VNPOST' AND  INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc giao dich tren vi co hieu luc trong vong 2 phut')) >=1 THEN 'OTP_VNPOST_02'
  else 'OTHER'
END MSG_TYPE_2,
---

case
  when lower(mi.BODY_SHORT_CONTENT) like '%viettelpay%' then 'viettelpay'
  when lower(mi.BODY_SHORT_CONTENT) like '%viettel%' then 'viettel'
  when lower(mi.BODY_SHORT_CONTENT) like '%bankplus%' then 'bankplus'
  when lower(mi.BODY_SHORT_CONTENT) like '%cob bnk%' -- canh bao cob t24
       or lower(mi.BODY_SHORT_CONTENT) like '%[dwh]%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_dn]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_ho]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_hcm]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%monitor%'
       or lower(mi.BODY_SHORT_CONTENT) like '%cob%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mb alert:%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: warning%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: critical%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: fatal%' then 'cntt' -- canh bao cua cntt
  when lower(mi.BODY_SHORT_CONTENT) like '%mb kinh moi quy khach khao sat%' then 'mangluoi'
  when lower(mi.BODY_SHORT_CONTENT) like '%d/c%' then 'hanhchinh'
  when lower(mi.BODY_SHORT_CONTENT) like '%bieu lai suat%'
       or (lower(mi.BODY_SHORT_CONTENT) like '%gia tb%' and lower(mi.BODY_SHORT_CONTENT) like '%kl:%') 
       or lower(mi.BODY_SHORT_CONTENT) like 'chuyen/nhan tien quoc te' then 'treasury'
  when lower(mi.BODY_SHORT_CONTENT) like '%phong van%'
       or lower(mi.BODY_SHORT_CONTENT) like '%finding captain%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tuyen dung%' then 'nhansu'   
  when lower(mi.BODY_SHORT_CONTENT) like '%sd the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%so du the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%ma xac thuc gd online cua quy khach la%' -- otp 3d secure
       or lower(mi.BODY_SHORT_CONTENT) like '%gia tri giao dich dau tien%' --
       or lower(mi.BODY_SHORT_CONTENT) like '%atm%'
       or lower(mi.BODY_SHORT_CONTENT) like '%pos%'
       or lower(mi.BODY_SHORT_CONTENT) like '%jcb%'
       or lower(mi.BODY_SHORT_CONTENT) like '%visa%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mbcard%'
       or lower(mi.BODY_SHORT_CONTENT) like '%way4%'
       or lower(mi.BODY_SHORT_CONTENT) like '%w4%' then 'ttkdthe'
 when (lower(mi.BODY_SHORT_CONTENT) like '%tk %' and lower(mi.BODY_SHORT_CONTENT) like '%|sd:%') then 'bdsd tk'
 when lower(mi.BODY_SHORT_CONTENT) like '%mb star%'
      or lower(mi.BODY_SHORT_CONTENT) like '%loyalty%'
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan duoc qua tang%' --
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan qua%' then 'loyalty' 
when lower(mi.BODY_SHORT_CONTENT) like '%tra lai tien gui%' then 'tra lai tien gui'
when lower(mi.BODY_SHORT_CONTENT) like '%dang ky online%'
    or lower(mi.BODY_SHORT_CONTENT) like '%dang chuyen tien%' --
    or lower(mi.BODY_SHORT_CONTENT) like '%tat toan: az%'
    or lower(mi.BODY_SHORT_CONTENT) like '%chao mung quy khach den voi dv mb ebanking%'
    or lower(mi.BODY_SHORT_CONTENT) like '%cap lai mat khau thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%vui long su dung ten dang nhap%'
    or lower(mi.BODY_SHORT_CONTENT) like '%gioi thieu nhieu nhan tien%'
    or lower(mi.BODY_SHORT_CONTENT) like '%emb%'
    or lower(mi.BODY_SHORT_CONTENT) like '%biz mbbank%'
    or lower(mi.BODY_SHORT_CONTENT) like '%tk thau chi%'
    or lower(mi.BODY_SHORT_CONTENT) like '%: tktc%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%so du%' and lower(mi.BODY_SHORT_CONTENT) like '%thanh toan%')
    or lower(mi.BODY_SHORT_CONTENT) like '%app mbbank%'
   or lower(mi.BODY_SHORT_CONTENT) like '%ban da tat toan thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%ebanking%' then 'nhs-kenh so'
 when lower(mi.BODY_SHORT_CONTENT) like '%cash by code%' then 'cash by code' 
 when lower(mi.BODY_SHORT_CONTENT) like '%tai khoan so dep%' then 'nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%otp%' then 'otp nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%sms banking%' then 'sms banking'
  when lower(mi.BODY_SHORT_CONTENT) like '%khdn%'
    or lower(mi.BODY_SHORT_CONTENT) like '%hddt so%'
    or lower(mi.BODY_SHORT_CONTENT) like '%sme%' 
    or lower(mi.BODY_SHORT_CONTENT) like '%business package%'
    or lower(mi.BODY_SHORT_CONTENT) like '%visa commerce%' then 'khdn'
  when lower(mi.BODY_SHORT_CONTENT) like '%ld%'
      or lower(mi.BODY_SHORT_CONTENT) like '%ban da vay thanh cong%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%khoan vay%' and lower(mi.BODY_SHORT_CONTENT) like '%qhkh%') then 'vay ld'
 when lower(mi.BODY_SHORT_CONTENT) like '%the tin dung%'
  or lower(mi.BODY_SHORT_CONTENT) like '%giao dich the%'
        or lower(mi.BODY_SHORT_CONTENT) like '%dich vu the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%mb:the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%the%' then 'the'
else 'other'
end PHANBO,
CASE
  --WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_BD' and lower(mi.body_short_content) like '%tra lai tien gui%' THEN 'TRALAITIENGUI'
    --WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_CD' and (upper(mi.body_short_content) like '%CONG TY CO PHAN TRUYEN THONG IRIS%' or upper(mi.body_short_content) like '%CTCP CONG NGHE VA DICH VU MOCA%') THEN 'IRIS_MOCA'
    WHEN mi.MSG_TYPE = 'MSG_SMS_OTP_BANKING' and lower(mi.body_short_content) like '%ma xac thuc co hieu luc trong vong 5 phut.qk luu y khong cung cap otp cho bat ky ai. cam on quy khach da su dung%' THEN 'OTP_BANKING'
      END PHANLOAI,

---
---
mri.ID,
mi.MSG_TYPE,
mi.SOURCE_APP_ID,
RECEIVER_ID,
mri.PARTNER_ID,
'OTP' SOURCE
FROM etl.MB_PM_MESSAGES_RECEIVERS mri
----------
INNER JOIN etl.MB_PM_MESSAGES mi ON mi.ID = mri.MESSAGES_ID AND MI.MSG_TYPE IN ('MSG_SMS_OTP','MSG_SMS_OTP_VNPOST','MSG_SMS_OTP_BANKING','MSG_SMS_OTP_VIETTELPAY')
left join ETL.Tb_Mnp mnp on mri.receiver_id = mnp.mobile;

--------------------------------------------------------------------
CREATE TABLE CARD NOLOGGING AS
SELECT /*+ parallel(6) */ 
---
CASE
WHEN LENGTH(BODY_SHORT_CONTENT) &lt;= 160 THEN 1
when LENGTH(BODY_SHORT_CONTENT) > 160 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 306 then 2
when LENGTH(BODY_SHORT_CONTENT) > 306 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 459 then 3
ELSE 4
END TOTAL_MESS_SHORT,
---
CASE
WHEN mnp.mobile is not null and mnp.created_date &lt; mi.MSG_CREATED_DT THEN mnp.provider
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8486', '8496', '8497', '8498', '8432', '8433', '8434', '8435', '8436', '8437', '8438', '8439') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('086', '096', '097', '098', '032', '033', '034', '035', '036', '037', '038', '039') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8489', '8490', '8493', '8470', '8479', '8477', '8476', '8478') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('089', '090', '093', '070', '079', '077', '076', '078') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8488', '8491', '8494', '8483', '8484', '8485', '8481', '8482') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('088', '091', '094', '083', '084', '085', '081', '082') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('055') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8455') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('052', '056', '058', '092') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8452', '8456', '8458', '8492') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('087') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8487') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('099','059') THEN 'BELINE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8499','8459') THEN 'BELINE'
ELSE 'OTHER'
END TELCO,
CASE
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'Han muc con lai')) >=1 THEN 'CARD_01'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'quy khach dang ky tra gop thanh cong')) >=1 THEN 'CARD_02'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc lien ket vi ApplePay')) >=1 THEN 'CARD_03'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich khong thanh cong do loi xac thuc 3DS')) >=1 THEN 'CARD_04'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 and INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD TRU TIEN THE')) >=1 THEN 'CARD_05'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich khong thanh cong do vuot han muc giao dich duoc cap')) >=1 THEN 'CARD_06'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'tam khoa do khong du so du thuc hien GD')) >=1 THEN 'CARD_07'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'tam khoa do phat sinh giao dich cham canh bao rui ro')) >=1 THEN 'CARD_08'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Giao dich cong tien vao the qua EMB')) >=1 THEN 'CARD_09'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'MB: So du the')) >=1 THEN 'CARD_10'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'chua dang ky chi tieu internet')) >=1 THEN 'CARD_11'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich khong thanh cong do vuot han muc giao dich tung lan hoac trong ngay')) >=1 THEN 'CARD_12'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'tu nguon TKTT')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Giao dich chi tieu')) >=1  THEN 'CARD_13'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich khong thanh cong do chua kich hoat/het han')) >=1 THEN 'CARD_14'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'da duoc mo khoa thanh cong khi hoan thanh tra no qua han')) >=1 THEN 'CARD_15'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'tu nguon TKTT')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'Giao dich rut tien')) >=1 THEN 'CARD_16'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD khong thanh cong do vuot han muc giao dich duoc cap')) >=1 THEN 'CARD_17'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'da khong con no qua han lien doi')) >=1 THEN 'CARD_18'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'da bi khoa do phat sinh no qua han lien doi')) >=1 THEN 'CARD_19'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD khong thanh cong do vuot han muc GD tung lan hoac trong ngay')) >=1 THEN 'CARD_20'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'phat sinh giao dich cham canh bao rui ro')) >=1 THEN 'CARD_21'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD khong thanh cong do chua kich hoat/het han')) >=1 THEN 'CARD_22'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ma xac thuc lien ket vi')) >=1 THEN 'CARD_23'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'chua dang ky dich vu quang cao')) >=1 THEN 'CARD_24'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich khong thanh cong do vuot han muc the tren POS hoac vuot so lan quy dinh rut tien tren ATM/ngay')) >=1 THEN 'CARD_25'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD CHI TIEU TAI')) >=1  THEN 'CARD_26'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD CONG TIEN THE')) >=1 THEN 'CARD_27'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'Hoan tra giao dich tai')) >=1 THEN 'CARD_28'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich loi do thanh toan dai bang tu')) >=1 THEN 'CARD_29'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'Ty le giao dich loi the Debit')) >=1 THEN 'CARD_30'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD HOAN TRA TAI')) >=1 THEN 'CARD_31'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'TU NGUON TKTT')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD TRU TIEN THE')) >=1 THEN 'CARD_32'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD HOAN TRA')) >=1 THEN 'CARD_33'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'giao dich khong thanh cong. The dang bi khoa do khong thanh toan 2 ky sao ke')) >=1 THEN 'CARD_34'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'da duoc kich hoat thanh cong')) >=1 THEN 'CARD_35'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD RUT TIEN TAI ATM')) >=1 THEN 'CARD_36'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD RUT TIEN')) >=1 THEN 'CARD_37'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD NOP TIEN')) >=1 THEN 'CARD_38'
  WHEN INSTR(upper(BODY_SHORT_CONTENT), upper( 'SD THE')) >=1 AND INSTR(upper(BODY_SHORT_CONTENT), upper( 'GD THU PHI THUONG NIEN')) >=1 THEN 'CARD_39'
  ELSE 'OTHER'
END MSG_TYPE_2,
---
case
  when lower(mi.BODY_SHORT_CONTENT) like '%viettelpay%' then 'viettelpay'
  when lower(mi.BODY_SHORT_CONTENT) like '%viettel%' then 'viettel'
  when lower(mi.BODY_SHORT_CONTENT) like '%bankplus%' then 'bankplus'
  when lower(mi.BODY_SHORT_CONTENT) like '%cob bnk%' -- canh bao cob t24
       or lower(mi.BODY_SHORT_CONTENT) like '%[dwh]%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_dn]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_ho]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_hcm]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%monitor%'
       or lower(mi.BODY_SHORT_CONTENT) like '%cob%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mb alert:%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: warning%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: critical%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: fatal%' then 'cntt' -- canh bao cua cntt
  when lower(mi.BODY_SHORT_CONTENT) like '%mb kinh moi quy khach khao sat%' then 'mangluoi'
  when lower(mi.BODY_SHORT_CONTENT) like '%d/c%' then 'hanhchinh'
  when lower(mi.BODY_SHORT_CONTENT) like '%bieu lai suat%'
       or (lower(mi.BODY_SHORT_CONTENT) like '%gia tb%' and lower(mi.BODY_SHORT_CONTENT) like '%kl:%') 
       or lower(mi.BODY_SHORT_CONTENT) like 'chuyen/nhan tien quoc te' then 'treasury'
  when lower(mi.BODY_SHORT_CONTENT) like '%phong van%'
       or lower(mi.BODY_SHORT_CONTENT) like '%finding captain%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tuyen dung%' then 'nhansu'   
  when lower(mi.BODY_SHORT_CONTENT) like '%sd the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%so du the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%ma xac thuc gd online cua quy khach la%' -- otp 3d secure
       or lower(mi.BODY_SHORT_CONTENT) like '%gia tri giao dich dau tien%' --
       or lower(mi.BODY_SHORT_CONTENT) like '%atm%'
       or lower(mi.BODY_SHORT_CONTENT) like '%pos%'
       or lower(mi.BODY_SHORT_CONTENT) like '%jcb%'
       or lower(mi.BODY_SHORT_CONTENT) like '%visa%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mbcard%'
       or lower(mi.BODY_SHORT_CONTENT) like '%way4%'
       or lower(mi.BODY_SHORT_CONTENT) like '%w4%' then 'ttkdthe'
 when (lower(mi.BODY_SHORT_CONTENT) like '%tk %' and lower(mi.BODY_SHORT_CONTENT) like '%|sd:%') then 'bdsd tk'
 when lower(mi.BODY_SHORT_CONTENT) like '%mb star%'
      or lower(mi.BODY_SHORT_CONTENT) like '%loyalty%'
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan duoc qua tang%' --
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan qua%' then 'loyalty' 
when lower(mi.BODY_SHORT_CONTENT) like '%tra lai tien gui%' then 'tra lai tien gui'
when lower(mi.BODY_SHORT_CONTENT) like '%dang ky online%'
    or lower(mi.BODY_SHORT_CONTENT) like '%dang chuyen tien%' --
    or lower(mi.BODY_SHORT_CONTENT) like '%tat toan: az%'
    or lower(mi.BODY_SHORT_CONTENT) like '%chao mung quy khach den voi dv mb ebanking%'
    or lower(mi.BODY_SHORT_CONTENT) like '%cap lai mat khau thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%vui long su dung ten dang nhap%'
    or lower(mi.BODY_SHORT_CONTENT) like '%gioi thieu nhieu nhan tien%'
    or lower(mi.BODY_SHORT_CONTENT) like '%emb%'
    or lower(mi.BODY_SHORT_CONTENT) like '%biz mbbank%'
    or lower(mi.BODY_SHORT_CONTENT) like '%tk thau chi%'
    or lower(mi.BODY_SHORT_CONTENT) like '%: tktc%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%so du%' and lower(mi.BODY_SHORT_CONTENT) like '%thanh toan%')
    or lower(mi.BODY_SHORT_CONTENT) like '%app mbbank%'
   or lower(mi.BODY_SHORT_CONTENT) like '%ban da tat toan thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%ebanking%' then 'nhs-kenh so'
 when lower(mi.BODY_SHORT_CONTENT) like '%cash by code%' then 'cash by code' 
 when lower(mi.BODY_SHORT_CONTENT) like '%tai khoan so dep%' then 'nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%otp%' then 'otp nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%sms banking%' then 'sms banking'
  when lower(mi.BODY_SHORT_CONTENT) like '%khdn%'
    or lower(mi.BODY_SHORT_CONTENT) like '%hddt so%'
    or lower(mi.BODY_SHORT_CONTENT) like '%sme%' 
    or lower(mi.BODY_SHORT_CONTENT) like '%business package%'
    or lower(mi.BODY_SHORT_CONTENT) like '%visa commerce%' then 'khdn'
  when lower(mi.BODY_SHORT_CONTENT) like '%ld%'
      or lower(mi.BODY_SHORT_CONTENT) like '%ban da vay thanh cong%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%khoan vay%' and lower(mi.BODY_SHORT_CONTENT) like '%qhkh%') then 'vay ld'
 when lower(mi.BODY_SHORT_CONTENT) like '%the tin dung%'
  or lower(mi.BODY_SHORT_CONTENT) like '%giao dich the%'
        or lower(mi.BODY_SHORT_CONTENT) like '%dich vu the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%mb:the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%the%' then 'the'
else 'other'
end PHANBO,
case WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_BD' and lower(mi.body_short_content) like '%tra lai tien gui%' THEN 'TRALAITIENGUI' end PHANLOAI,
---
---
mri.ID,
mi.MSG_TYPE,
mi.SOURCE_APP_ID,
RECEIVER_ID,
mri.PARTNER_ID,
'CARD' SOURCE
FROM etl.MB_PM_MESSAGES_RECEIVERS mri
----------
INNER JOIN etl.MB_PM_MESSAGES mi ON mi.ID = mri.MESSAGES_ID AND mi.MSG_TYPE IN ('MSG_SMS_CARD_PRIORITY_LOW')
left join ETL.Tb_Mnp mnp on mri.receiver_id = mnp.mobile ;


---------------------------------------------------business
CREATE TABLE business NOLOGGING AS
SELECT /*+ parallel(4) */ 
---
CASE
WHEN LENGTH(BODY_SHORT_CONTENT) &lt;= 160 THEN 1
when LENGTH(BODY_SHORT_CONTENT) > 160 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 306 then 2
when LENGTH(BODY_SHORT_CONTENT) > 306 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 459 then 3
ELSE 4
END TOTAL_MESS_SHORT,
---
CASE
WHEN mnp.mobile is not null and mnp.created_date &lt; mi.MSG_CREATED_DT THEN mnp.provider
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8486', '8496', '8497', '8498', '8432', '8433', '8434', '8435', '8436', '8437', '8438', '8439') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('086', '096', '097', '098', '032', '033', '034', '035', '036', '037', '038', '039') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8489', '8490', '8493', '8470', '8479', '8477', '8476', '8478') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('089', '090', '093', '070', '079', '077', '076', '078') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8488', '8491', '8494', '8483', '8484', '8485', '8481', '8482') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('088', '091', '094', '083', '084', '085', '081', '082') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('055') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8455') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('052', '056', '058', '092') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8452', '8456', '8458', '8492') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('087') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8487') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('099','059') THEN 'BELINE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8499','8459') THEN 'BELINE'
ELSE 'OTHER'
END TELCO,
CASE
  WHEN mi.MSG_TYPE IN ('MSG_SMS_BPM','MSG_SMS_NHAC_NO', 'MSG_SMS_T24', 'MSG_SMS_LOANS_TRASOAT', 'MSG_SMS_LOANS') THEN 'BUSINESS_LD'
  WHEN mi.MSG_TYPE = 'MSG_SMS_HRIS' THEN 'BUSINESS_HR'
  WHEN mi.MSG_TYPE = 'MSG_SMS_TRADING' THEN 'BUSINESS_CAPITAL'
  WHEN mi.MSG_TYPE IN ('MSG_SMS_WARNING','MSG_NOTI1', 'MSG_SMS_PASSWORD_TTATTT', 'MSG_SMS_MONITOR') THEN 'BUSINESS_IT'
  ELSE 'OTHER'
END MSG_TYPE_2,

case
  when lower(mi.BODY_SHORT_CONTENT) like '%viettelpay%' then 'viettelpay'
  when lower(mi.BODY_SHORT_CONTENT) like '%viettel%' then 'viettel'
  when lower(mi.BODY_SHORT_CONTENT) like '%bankplus%' then 'bankplus'
  when lower(mi.BODY_SHORT_CONTENT) like '%cob bnk%' -- canh bao cob t24
       or lower(mi.BODY_SHORT_CONTENT) like '%[dwh]%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_dn]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_ho]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%[network_it_hcm]%'
       or lower(mi.BODY_SHORT_CONTENT) like '%monitor%'
       or lower(mi.BODY_SHORT_CONTENT) like '%cob%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mb alert:%' 
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: warning%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: critical%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tb: fatal%' then 'cntt' -- canh bao cua cntt
  when lower(mi.BODY_SHORT_CONTENT) like '%mb kinh moi quy khach khao sat%' then 'mangluoi'
  when lower(mi.BODY_SHORT_CONTENT) like '%d/c%' then 'hanhchinh'
  when lower(mi.BODY_SHORT_CONTENT) like '%bieu lai suat%'
       or (lower(mi.BODY_SHORT_CONTENT) like '%gia tb%' and lower(mi.BODY_SHORT_CONTENT) like '%kl:%') 
       or lower(mi.BODY_SHORT_CONTENT) like 'chuyen/nhan tien quoc te' then 'treasury'
  when lower(mi.BODY_SHORT_CONTENT) like '%phong van%'
       or lower(mi.BODY_SHORT_CONTENT) like '%finding captain%'
       or lower(mi.BODY_SHORT_CONTENT) like '%tuyen dung%' then 'nhansu'   
  when lower(mi.BODY_SHORT_CONTENT) like '%sd the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%so du the%'
       or lower(mi.BODY_SHORT_CONTENT) like '%ma xac thuc gd online cua quy khach la%' -- otp 3d secure
       or lower(mi.BODY_SHORT_CONTENT) like '%gia tri giao dich dau tien%' --
       or lower(mi.BODY_SHORT_CONTENT) like '%atm%'
       or lower(mi.BODY_SHORT_CONTENT) like '%pos%'
       or lower(mi.BODY_SHORT_CONTENT) like '%jcb%'
       or lower(mi.BODY_SHORT_CONTENT) like '%visa%'
       or lower(mi.BODY_SHORT_CONTENT) like '%mbcard%'
       or lower(mi.BODY_SHORT_CONTENT) like '%way4%'
       or lower(mi.BODY_SHORT_CONTENT) like '%w4%' then 'ttkdthe'
 when (lower(mi.BODY_SHORT_CONTENT) like '%tk %' and lower(mi.BODY_SHORT_CONTENT) like '%|sd:%') then 'bdsd tk'
 when lower(mi.BODY_SHORT_CONTENT) like '%mb star%'
      or lower(mi.BODY_SHORT_CONTENT) like '%loyalty%'
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan duoc qua tang%' --
      or lower(mi.BODY_SHORT_CONTENT) like '%nhan qua%' then 'loyalty' 
when lower(mi.BODY_SHORT_CONTENT) like '%tra lai tien gui%' then 'tra lai tien gui'
when lower(mi.BODY_SHORT_CONTENT) like '%dang ky online%'
    or lower(mi.BODY_SHORT_CONTENT) like '%dang chuyen tien%' --
    or lower(mi.BODY_SHORT_CONTENT) like '%tat toan: az%'
    or lower(mi.BODY_SHORT_CONTENT) like '%chao mung quy khach den voi dv mb ebanking%'
    or lower(mi.BODY_SHORT_CONTENT) like '%cap lai mat khau thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%vui long su dung ten dang nhap%'
    or lower(mi.BODY_SHORT_CONTENT) like '%gioi thieu nhieu nhan tien%'
    or lower(mi.BODY_SHORT_CONTENT) like '%emb%'
    or lower(mi.BODY_SHORT_CONTENT) like '%biz mbbank%'
    or lower(mi.BODY_SHORT_CONTENT) like '%tk thau chi%'
    or lower(mi.BODY_SHORT_CONTENT) like '%: tktc%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%so du%' and lower(mi.BODY_SHORT_CONTENT) like '%thanh toan%')
    or lower(mi.BODY_SHORT_CONTENT) like '%app mbbank%'
   or lower(mi.BODY_SHORT_CONTENT) like '%ban da tat toan thanh cong%'
    or lower(mi.BODY_SHORT_CONTENT) like '%ebanking%' then 'nhs-kenh so'
 when lower(mi.BODY_SHORT_CONTENT) like '%cash by code%' then 'cash by code' 
 when lower(mi.BODY_SHORT_CONTENT) like '%tai khoan so dep%' then 'nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%otp%' then 'otp nhs' 
 when lower(mi.BODY_SHORT_CONTENT) like '%sms banking%' then 'sms banking'
  when lower(mi.BODY_SHORT_CONTENT) like '%khdn%'
    or lower(mi.BODY_SHORT_CONTENT) like '%hddt so%'
    or lower(mi.BODY_SHORT_CONTENT) like '%sme%' 
    or lower(mi.BODY_SHORT_CONTENT) like '%business package%'
    or lower(mi.BODY_SHORT_CONTENT) like '%visa commerce%' then 'khdn'
  when lower(mi.BODY_SHORT_CONTENT) like '%ld%'
      or lower(mi.BODY_SHORT_CONTENT) like '%ban da vay thanh cong%'
    or (lower(mi.BODY_SHORT_CONTENT) like '%khoan vay%' and lower(mi.BODY_SHORT_CONTENT) like '%qhkh%') then 'vay ld'
 when lower(mi.BODY_SHORT_CONTENT) like '%the tin dung%'
  or lower(mi.BODY_SHORT_CONTENT) like '%giao dich the%'
        or lower(mi.BODY_SHORT_CONTENT) like '%dich vu the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%mb:the%'
  or lower(mi.BODY_SHORT_CONTENT) like '%the%' then 'the'
else 'other'
end PHANBO,
case WHEN mi.MSG_TYPE = 'MSG_SMS_BDSD_BULKSMS_BD' and lower(mi.body_short_content) like '%tra lai tien gui%' THEN 'TRALAITIENGUI' end PHANLOAI,

---
---
mri.ID,
mi.MSG_TYPE,
mi.SOURCE_APP_ID,
RECEIVER_ID,
mri.PARTNER_ID,
'BUSINESS' SOURCE
FROM etl.MB_PM_MESSAGES_RECEIVERS mri
----------
INNER JOIN etl.MB_PM_MESSAGES mi ON mi.ID = mri.MESSAGES_ID AND mi.MSG_TYPE IN (
'MSG_SMS_MONITOR',
'MSG_SMS_PASSWORD_TTATTT',
'MSG_NOTI1',
'MSG_SMS_WARNING',
'MSG_SMS_TRADING',
'MSG_SMS_HRIS',
'MSG_SMS_BPM',
'MSG_SMS_NHAC_NO',
'MSG_SMS_T24',
'MSG_SMS_LOANS_TRASOAT',
'MSG_SMS_LOANS', 'MSG_SMS_BPM_DISBUR', 'MSG_SMS_DFORM', 'MSG_SMS_EMB', 'MSG_SMS_PASSWORD_EMB', 'MSG_SMS_PAYMENT_SYSTEM', 'MSG_SMS_RPA', 'MSG_SMS_SAVING', 'MSG_SMS_WARNING', 'MSG_SMS_SC_BATCH', 'MSG_SMS_CANCEL_SMS_T24', 'MSG_SMS_REGISTER_BDSD' 
,'MSG_NOTI_APP_QTRR_PCRT' )
left join ETL.Tb_Mnp mnp on mri.receiver_id = mnp.mobile ;




-----------------------
CREATE TABLE OTHER NOLOGGING AS
SELECT /*+ parallel(6) */ 
---
CASE
WHEN LENGTH(BODY_SHORT_CONTENT) &lt;= 160 THEN 1
when LENGTH(BODY_SHORT_CONTENT) > 160 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 306 then 2
when LENGTH(BODY_SHORT_CONTENT) > 306 AND LENGTH(BODY_SHORT_CONTENT) &lt;= 459 then 3
ELSE 4
END TOTAL_MESS_SHORT,
---
CASE
WHEN mnp.mobile is not null and mnp.created_date &lt; mi.MSG_CREATED_DT THEN mnp.provider
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8486', '8496', '8497', '8498', '8432', '8433', '8434', '8435', '8436', '8437', '8438', '8439') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('086', '096', '097', '098', '032', '033', '034', '035', '036', '037', '038', '039') THEN 'VIETTEL'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8489', '8490', '8493', '8470', '8479', '8477', '8476', '8478') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('089', '090', '093', '070', '079', '077', '076', '078') THEN 'MOBIFONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8488', '8491', '8494', '8483', '8484', '8485', '8481', '8482') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('088', '091', '094', '083', '084', '085', '081', '082') THEN 'VINAPHONE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('055') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8455') THEN 'REDDI'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('052', '056', '058', '092') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8452', '8456', '8458', '8492') THEN 'VIETNAMOBILE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('087') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('8487') THEN 'ITELECOM'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,3) in ('099','059') THEN 'BELINE'
when mnp.mobile is null and SUBSTR(mri.receiver_id,1,4) in ('8499','8459') THEN 'BELINE'
ELSE 'OTHER'
END TELCO,
'OTHER' MSG_TYPE_2,
---
 'OTHER' PHANLOAI,
---
---
mri.ID,
mi.MSG_TYPE,
mi.SOURCE_APP_ID,
RECEIVER_ID,
mri.PARTNER_ID,
'OTHER' SOURCE
FROM etl.MB_PM_MESSAGES_RECEIVERS mri
----------
INNER JOIN etl.MB_PM_MESSAGES mi ON mi.ID = mri.MESSAGES_ID AND mi.MSG_TYPE not IN ('MSG_SMS_BDSD_BULKSMS_CD','MSG_SMS_BDSD_BULKSMS_BD','MSG_SMS_BDSD_T24_DIRECT', 'MSG_SMS_BDSD_W4_VTPAY','MSG_SMS_OTP','MSG_SMS_OTP_VNPOST','MSG_SMS_OTP_BANKING','MSG_SMS_OTP_VIETTELPAY', 'MSG_SMS_CARD_PRIORITY_LOW', 'MSG_SMS_MONITOR',
'MSG_SMS_PASSWORD_TTATTT',
'MSG_NOTI1',
'MSG_SMS_TRADING',
'MSG_SMS_HRIS',
'MSG_SMS_BPM',
'MSG_SMS_NHAC_NO',
'MSG_SMS_T24',
'MSG_SMS_LOANS_TRASOAT',
'MSG_SMS_LOANS', 'MSG_SMS_BPM_DISBUR', 'MSG_SMS_DFORM', 'MSG_SMS_EMB', 'MSG_SMS_PASSWORD_EMB', 'MSG_SMS_PAYMENT_SYSTEM', 'MSG_SMS_RPA', 'MSG_SMS_SAVING', 'MSG_SMS_WARNING', 'MSG_SMS_SC_BATCH', 'MSG_SMS_CANCEL_SMS_T24', 
'MSG_SMS_REGISTER_BDSD', 'MSG_NOTI_APP_QTRR_PCRT'
)  
  
left join ETL.Tb_Mnp mnp on mri.receiver_id = mnp.mobile

</sql>
