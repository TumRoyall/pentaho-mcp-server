      <name>Mail Error</name>
      <description/>
      <type>MAIL</type>
      <attributes/>
      <server>mail.mbbank.com.vn</server>
      <port>25</port>
      <destination>hoanglh2@mbbank.com.vn</destination>
      <destinationCc>lynt6@mbbank.com.vn</destinationCc>
      <destinationBCc/>
      <replyto>sbv@mbbank.com.vn</replyto>
      <replytoname>Canh bao import cau phan FTP</replytoname>
      <subject>Canh bao so lieu FTP du phong</subject>
      <include_date>Y</include_date>
      <contact_person/>
      <contact_phone/>
      <comment>Luong FTP du phong bi loi
&lt;br />
Vui Long kiem tra theo cau lenh sau

WITH bs_view as
(select sum(all_vnd) total from apps.mb_gl_bshopnhat_bspl
where transaction_date = to_date ('${PRD_ID}','YYYYMMDD')
and IND_CODE in('A42','A52','A92') ),

traiphieu_view as (
select sum(DPCT_PHAI_TRICH_XHTD_TONG + DPC_PHAI_TRICH_XHTD) total
from ETL.FILE_DUPHONG_TRAIPHIEU_MTH
where transaction_date = (select max(transaction_date)
from ETL.FILE_DUPHONG_TRAIPHIEU_MTH
where transaction_date &lt;= to_date ('${PRD_ID}','YYYYMMDD'))
),

chovay_view as (
select sum(DUQUY_DPCT_FINAL + DUQUY_DPC_FINAL) total
from ETL.FILE_DUPHONG_CHOVAY_MTH
where transaction_date = (
  select max(transaction_date)
  from ETL.FILE_DUPHONG_CHOVAY_MTH
  where transaction_date &lt;= to_date ('${PRD_ID}','YYYYMMDD')))

select 1 from bs_view bs left join traiphieu_view tp on 1 = 1 left join chovay_view cv on 2 = 2
where abs(bs.total + tp.total + cv.total) > 1000
</comment>
