    <entry>
      <name>insert syn log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_DUPHONG_DAILY', 1,trunc(to_date('${PRD_ID}','yyyyMMdd')), sysdate ,trunc(to_date('${PRD_ID}','yyyyMMdd')),
count(1),'job_file_duphong_daily' 
from APPS.FTP_DUPHONG_DAILY 
where TRANSACTION_DATE = To_DATE('${PRD_ID}' ,  'yyyyMMdd');

COMMIT;</sql>
