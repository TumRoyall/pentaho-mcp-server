    <entry>
      <name>Insert_log_TCKT</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_TR_F2B',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(*),'job_ftp_tr_f2b' from APPS.FTP_TR_F2B
where trans_date = to_date(${PRD_ID},'yyyyMMdd')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
