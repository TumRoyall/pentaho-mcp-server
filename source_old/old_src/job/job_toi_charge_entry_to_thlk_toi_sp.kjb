    <entry>
      <name>Update khoi charge entry</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>update etl.tmp_toi_charge_entry
set khoi =
case
when sector >= 1910 and sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1910 and sector &lt;= 1969 then 'INDIV'
when sector >= 1970 and sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1970 and sector &lt;= 1979 then 'CIB'
when sector >= 1980 and sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end
where (gl = '7020' or acctnbr = '52430')
and apps.fn_map_sector(sector)= 'NHS';

update etl.tmp_toi_charge_entry
set khoi = 'NHS'
where gl = '8010'
and product_code = '11219';

update etl.tmp_toi_charge_entry
set khoi = 'NHS'
where acctnbr &lt;&gt; '67010'
and gl = '8010'
and to_number (sector) between 1910 and 1999
and product_code in ('11111', '11141');

update etl.tmp_toi_charge_entry
set khoi =
case
when sector >= 1910 and sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1910 and sector &lt;= 1969 then 'INDIV'
when sector >= 1970 and sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1970 and sector &lt;= 1979 then 'CIB'
when sector >= 1980 and sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end
where gl = '8010'
and product_code not in ('11111', '11141', '11219')
and apps.fn_map_sector(sector)= 'NHS';
commit;
update etl.tmp_toi_charge_entry 
set khoi = 
case 
when sector >= 1910 and sector &lt;= 1969 then 'INDIV' 
when sector >= 1970 and sector &lt;= 1979 then 'CIB' 
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end 
where apps.fn_map_sector(sector)= 'NHS' 
and acctnbr not in ('52033','52051','52052','52053','52054','52055','52059', 
'52061','52062','52063','52451','52452','52453','52454','52455','52456','52457', 
'52458','52459','52461','52469','52491','52492','52493','52494','52495','52496', 
'52497','52720','52770','52771','52772','52773','52776','52777','52778','52779', 
'52780','52781','52782','52783','52784','52785','52786','52787','52788','52789', 
'52790','52792','68116','68291','68292','68293','68294','68299','68781','68782', 
'68783','68784','68785','68786','68787','68790','68804','52795','52799')
and gl not in  ('8010', '7020');
commit;
update etl.tmp_toi_charge_entry 
set khoi = 'NHS'
where  apps.fn_map_sector(sector)= 'NHS'
and gl = '7020'
and acctnbr = '52795';
commit;</sql>
