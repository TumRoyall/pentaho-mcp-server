    <entry>
      <name>update sync_log ftp_tonghop</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,source_system,so_luong)
select 'FTP_TONGHOP',3,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')),'etl_ftp_jobs_tonghop'
,count(*)
from APPS.FTP_TONGHOP
WHERE TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd')


</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
