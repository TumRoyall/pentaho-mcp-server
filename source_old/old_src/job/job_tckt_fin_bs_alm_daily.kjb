    <entry>
      <name>update log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO apps.SYN_LOG
(TABLE_NAME, STATUS, SYN_DATE, ETL_DATE,TRANSACTION_DATE,SOURCE_SYSTEM,SO_LUONG)
SELECT UPPER('APPS.FIN_BS_ALM_DAILY'),1,TO_DATE(${PRD_ID},'yyyyMMdd'), SYSDATE ,TO_DATE(${PRD_ID},'yyyyMMdd'),'job_tckt_fin_bs_alm_daily', count(1)
FROM APPS.FIN_BS_ALM_DAILY
WHERE TRANSACTION_DATE = TO_DATE(${PRD_ID},'yyyyMMdd')
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>656</xloc>
      <yloc>432</yloc>
      <attributes_kjc/>
    </entry>
