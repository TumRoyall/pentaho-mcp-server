    <entry>
      <name>truncate etl_tmp_loan_info</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>truncate table etl.etl_tmp_loan_info;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>356</xloc>
      <yloc>165</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>ins data</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into etl.etl_tmp_loan_info
(TAIKHOAN,
MBLD_TYPE,
PRODUCT_CODE,
PRODUCTGR_CODE,
CATEGORY,
SUB_PRODUCT,
LOC_TERM,
LOAIKYHAN,
SECTOR,
NHOMNO_XHTD,
NHOMNO_LIENDOI,
KHOI,
PRODUCT_TYPE,
FTP_CODE,
PROJECT_ID)
select
    a.TAIKHOAN,
    a.MBLD_TYPE,
    a.PRODUCT_CODE,
    a.PRODUCTGR_CODE,
    a.CATEGORY,
    a.SUB_PRODUCT,
    a.LOC_TERM,
    a.LOAIKYHAN,
    d.SECTOR,
    a.NHOMNO_XHTD,
    null NHOMNO_LIENDOI,
    d.KHOI,
    a.PRODUCT_TYPE,
    nvl(b.FTP_CODE, c.ftp_code) ftp_code,
    a.PROJECT_ID
from
    (
        select
            makh,
            arrangement_nbr TAIKHOAN,
            campaign_code MBLD_TYPE,
            PRODUCT_CODE,
            product_group_code PRODUCTGR_CODE,
            cate_code CATEGORY,
            SUB_PRODUCT_CODE SUB_PRODUCT,
            replace(arrangement_term, 'M') LOC_TERM,
            case
                when replace(arrangement_term, 'M') &lt;= 12 then 'NH'
                when replace(arrangement_term, 'M') &lt;= 60 then 'TH'
                else 'DH'
            end LOAIKYHAN,
            credit_status NHOMNO_XHTD,
            program_code product_type,
            PROJECT_ID
        from
            etl.ods_loan_contract
        union
        all
        select
            a.makh,
            a.arrangement_nbr TAIKHOAN,
            b.campaign_code MBLD_TYPE,
            b.PRODUCT_CODE,
            a.product_group_code PRODUCTGR_CODE,
            a.cate_code CATEGORY,
            a.SUB_PRODUCT_CODE SUB_PRODUCT,
            replace(a.arrangement_term, 'M') LOC_TERM,
            case
                when replace(a.arrangement_term, 'M') &lt;= 12 then 'NH'
                when replace(a.arrangement_term, 'M') &lt;= 60 then 'TH'
                else 'DH'
            end LOAIKYHAN,
            a.credit_status NHOMNO_XHTD,
            b.program_code product_type,
            b.PROJECT_ID
        from
            etl.ods_pd_contract a
            left join etl.ods_loan_contract b on a.arrangement_nbr = 'PD' || b.arrangement_nbr
        where
            a.rank_num = 1
        union
        all
        select
            makh,
            arrangement_nbr TAIKHOAN,
            campaign_code MBLD_TYPE,
            PRODUCT_CODE,
            product_group_code PRODUCTGR_CODE,
            cate_code CATEGORY,
            SUB_PRODUCT_CODE SUB_PRODUCT,
            '12' LOC_TERM,
            'NH' LOAIKYHAN,
            credit_status NHOMNO_XHTD,
            null product_type,
            null PROJECT_ID
        from
            etl.ods_OVD_CONTRACT
        union
        all
		select t24_customer_code makh,
            CONTRACT_NUMBER TAIKHOAN,
			null MBLD_TYPE,
			t24_prod_code PRODUCT_CODE,
			null PRODUCTGR_CODE,
            null CATEGORY,
            null SUB_PRODUCT,
            null LOC_TERM,
            null LOAIKYHAN,
            null NHOMNO_XHTD,
            null product_type,
            null PROJECT_ID

 from (
        select
            t24_customer_code,
            CONTRACT_NUMBER,
            t24_prod_code ,
			row_number() over (partition by contract_number order by card_id desc) rn
        from
            etl.ORS_NHS_KPI_CREDIT_CARD_NOW
		)
		where rn = 1
    ) a
    left join (
        select
            taikhoan,
            ftp_code,
            row_number() over(
                partition by taikhoan
                order by
                    transaction_date
            ) rank_num
        from
            apps.tr_ftp_cus b
        where
            transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')
            and substr(product_code, 1, 1) in ('2', '5')
    ) b on b.rank_num = 1
    and a.taikhoan = b.taikhoan
    left join (
        select
            taikhoan,
            ftp_code,
            row_number() over(
                partition by taikhoan
                order by
                    transaction_date
            ) rank_num
        from
            apps.tr_ftp_cus_dieuchinh c
        where
            transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')
            and substr(product_code, 1, 1) in ('2', '5')
    ) c on c.rank_num = 1
    and a.taikhoan = c.taikhoan
    left join etl.ors_tr_khachhang d on a.makh = d.makh</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>502</xloc>
      <yloc>167</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>truncate etl_tmp_deposit_info</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>truncate table etl.etl_tmp_deposit_info;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>640</xloc>
      <yloc>170</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>ins data 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into
    etl.etl_tmp_deposit_info (
        TAIKHOAN,
        PRODUCT_CODE,
        CATEGORY,
        LOC_TERM,
        LOAIKYHAN,
        SECTOR,
        MBLD_TYPE,
        SUB_PRODUCT,
        NHOMNO_XHTD,
        NHOMNO_LIENDOI,
        PRODUCTGR_CODE,
        FTP_CODE
    )
select
    a.TAIKHOAN,
    a.PRODUCT_CODE,
    a.CATEGORY,
    a.LOC_TERM,
    a.LOAIKYHAN,
    b.SECTOR,
    null MBLD_TYPE,
    a.SUB_PRODUCT,
    null NHOMNO_XHTD,
    null NHOMNO_LIENDOI,
    null PRODUCTGR_CODE,
    a.FTP_CODE
from
    (
        select
            makh,
            arrangement_nbr TAIKHOAN,
            PRODUCT_CODE,
            cate_code CATEGORY,
            0 LOC_TERM,
            --'KKH' LOAIKYHAN,
      case when PRODUCT_CODE = '12419' then 'CKH' else 'KKH' end LOAIKYHAN,
            SUB_PRODUCT_CODE SUB_PRODUCT,
            FTP_CODE
        from
            etl.ods_casa_contract
        union
    
        select
            makh,
            taikhoan,
            product_code,
            category,
            loc_term,
            loaikyhan,
            sub_product,
            ftp_code
        from
            (
                select
                    makh,
                    arrangement_nbr TAIKHOAN,
                    PRODUCT_CODE,
                    cate_code CATEGORY,
                    case
              when upper(arrangement_term) = '.' then 0
                        when upper(arrangement_term) like '%M' then to_number (replace (upper(arrangement_term), 'M'))
                        when upper(arrangement_term) like '%T' then to_number (replace (upper(arrangement_term), 'T'))
                        when upper(arrangement_term) like '%D' then case
                            when to_number (replace (upper(arrangement_term), 'D')) between 0
                            and 27 then 0
                            when to_number (replace (upper(arrangement_term), 'D')) between 28
                            and 59 then 1
                            when to_number (replace (upper(arrangement_term), 'D')) between 60
                            and 89 then 2
                            when to_number (replace (upper(arrangement_term), 'D')) between 90
                            and 119 then 3
                            when to_number (replace (upper(arrangement_term), 'D')) between 120
                            and 149 then 4
                            when to_number (replace (upper(arrangement_term), 'D')) between 150
                            and 179 then 5
                            when to_number (replace (upper(arrangement_term), 'D')) between 180
                            and 209 then 6
                            when to_number (replace (upper(arrangement_term), 'D')) between 210
                            and 239 then 7
                            when to_number (replace (upper(arrangement_term), 'D')) between 240
                            and 269 then 8
                            when to_number (replace (upper(arrangement_term), 'D')) between 270
                            and 299 then 9
                            when to_number (replace (upper(arrangement_term), 'D')) between 300
                            and 329 then 10
                            when to_number (replace (upper(arrangement_term), 'D')) between 330
                            and 364 then 11
                            when to_number (replace (upper(arrangement_term), 'D')) between 365
                            and 389 then 12
                            when to_number (replace (upper(arrangement_term), 'D')) between 390
                            and 449 then 13
                            when to_number (replace (upper(arrangement_term), 'D')) between 450
                            and 539 then 15
                            when to_number (replace (upper(arrangement_term), 'D')) between 540
                            and 729 then 18
                            when to_number (replace (upper(arrangement_term), 'D')) between 730
                            and 1094 then 24
                            when to_number (replace (upper(arrangement_term), 'D')) between 1095
                            and 1459 then 36
                            when to_number (replace (upper(arrangement_term), 'D')) between 1460
                            and 1824 then 48
                            when to_number (replace (upper(arrangement_term), 'D')) between 1825
                            and 2554 then 60
                            when to_number (replace (upper(arrangement_term), 'D')) between 2555
                            and 3649 then 84
                            when to_number (replace (upper(arrangement_term), 'D')) >= 3650 then 120
                        end
                        when upper(arrangement_term) like '%W' then case
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 0
                            and 27 then 0
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 28
                            and 59 then 1
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 60
                            and 89 then 2
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 90
                            and 119 then 3
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 120
                            and 149 then 4
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 150
                            and 179 then 5
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 180
                            and 209 then 6
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 210
                            and 239 then 7
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 240
                            and 269 then 8
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 270
                            and 299 then 9
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 300
                            and 329 then 10
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 330
                            and 364 then 11
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 365
                            and 389 then 12
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 390
                            and 449 then 13
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 450
                            and 539 then 15
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 540
                            and 729 then 18
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 730
                            and 1094 then 24
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 1095
                            and 1459 then 36
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 1460
                            and 1824 then 48
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 1825
                            and 2554 then 60
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 between 2555
                            and 3649 then 84
                            when to_number (replace (upper(arrangement_term), 'W')) * 7 >= 3650 then 120
                        end
                        else to_number(REGEXP_REPLACE(arrangement_term, '[A-Za-z]', ''))--9999--to_number (arrangement_term) --0
                    end LOC_TERM,
                    'CKH' LOAIKYHAN,
                    SUB_PRODUCT_CODE SUB_PRODUCT,
                    FTP_CODE,
                    row_number() over (
                        partition by arrangement_nbr
                        order by
                            creation_date desc
                    ) rn
                from
                    etl.ods_td_contract
            )
        where
            rn = 1 
        union
        select
            makh,
            arrangement_nbr TAIKHOAN,
            PRODUCT_CODE,
            cate_code CATEGORY,
            null LOC_TERM,
            'KKH' LOAIKYHAN,
            SUB_PRODUCT_CODE SUB_PRODUCT,
            FTP_CODE
        from
            etl.ODS_INTERNAL_CONTRACT a
        where
            not exists (
                select
                    arrangement_nbr
                from
                    etl.ods_casa_contract b
                where
                    a.arrangement_nbr = b.arrangement_nbr
            )
    --20240201 anhlv6 bo sung them nguon etl.ods_ovd_contract theo ycpt: KDL-252
    union
    select
      makh,
      arrangement_nbr TAIKHOAN,
      PRODUCT_CODE,
      cate_code CATEGORY,
      0 LOC_TERM,
      case when PRODUCT_CODE = '12419' then 'CKH' else 'KKH' end LOAIKYHAN,
      SUB_PRODUCT_CODE SUB_PRODUCT,
      FTP_CODE
    from
      etl.ods_ovd_contract

    ) a
    left join etl.ors_tr_khachhang b on a.makh = b.makh</sql>
