    <entry>
      <name>Set variables</name>
      <description/>
      <type>SET_VARIABLES</type>
      <attributes/>
      <replacevars>Y</replacevars>
      <filename/>
      <file_variable_type>JVM</file_variable_type>
      <fields>
        <field>
          <variable_name>IS_DAY_OFF</variable_name>
          <variable_value>0</variable_value>
          <variable_type>CURRENT_JOB</variable_type>
        </field>
      </fields>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>432</xloc>
      <yloc>48</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Evaluate rows number in a table</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>tckt_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>WITH V_SYN_LOG_MTH AS (
  SELECT
    *
  FROM
    (
      SELECT
        a.*,
        ROW_NUMBER() OVER (
          PARTITION BY TABLE_NAME
          ORDER BY
            ETL_DATE DESC
        ) RN
      FROM
        APPS.SYN_LOG A
      WHERE
        A.SYN_DATE = LAST_DAY(ADD_MONTHS(TO_DATE('${PRD_ID}', 'YYYYMMDD'), -1))
    )
    WHERE RN = 1
),
V_SYN_LOG AS (
  SELECT 
  *
  FROM
  (
    SELECT A.*,
    ROW_NUMBER() OVER (
      PARTITION BY TABLE_NAME
      ORDER BY ETL_DATE DESC
    ) RN
    FROM 
    APPS.SYN_LOG A
    WHERE A.SYN_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
  )
  WHERE RN = 1
)
SELECT
  *
FROM
  (
    SELECT
      A.*,
      B.ETL_DATE,
      B.SO_LUONG
    FROM
      ETL.EXPECTED_DAILY_TIME_SYN_LOG A
      LEFT JOIN V_SYN_LOG_MTH B ON UPPER(A.TABLE_NAME) = UPPER(B.TABLE_NAME)
    WHERE
      TO_DATE(A.EXPECTED_DAILY_TIME, 'HH24:MI:SS') &lt; TO_DATE(TO_CHAR(SYSDATE, 'HH24:MI:SS'), 'HH24:MI:SS') -- l?y nh?ng job c� ng�y ch?y job + expected_time &lt; th?i gian ch?y job
      AND (
        B.ETL_DATE IS NULL -- l?y nh?ng job ch?a c� etl_date
        OR B.SO_LUONG = 0
      )
      AND A.ACTIVE = 1
      AND A.RUNNING_ON_DAY_OFF >= ${IS_DAY_OFF}
      AND A.IS_MONTHLY_JOB = 1
    UNION
    ALL
    SELECT
      A.*,
      B.ETL_DATE,
      B.SO_LUONG
    FROM
      ETL.EXPECTED_DAILY_TIME_SYN_LOG A
      LEFT JOIN V_SYN_LOG B ON UPPER(A.TABLE_NAME) = UPPER(B.TABLE_NAME)
    WHERE
      TO_DATE(A.EXPECTED_DAILY_TIME, 'HH24:MI:SS') &lt; TO_DATE(TO_CHAR(SYSDATE, 'HH24:MI:SS'), 'HH24:MI:SS') -- l?y nh?ng job c� ng�y ch?y job + expected_time &lt; th?i gian ch?y job
      AND (
        B.ETL_DATE IS NULL -- l?y nh?ng job ch?a c� etl_date
        OR B.SO_LUONG = 0
      )
      AND A.ACTIVE = 1
      AND A.RUNNING_ON_DAY_OFF >= ${IS_DAY_OFF}
      AND A.IS_MONTHLY_JOB = 0
	  AND A.IS_WEEKLY_JOB &lt;= ${IS_MONDAY}
  )
ORDER BY
  PRIORITY ASC,
  PIC ASC,
  TABLE_NAME ASC</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>912</xloc>
      <yloc>48</yloc>
      <attributes_kjc/>
    </entry>
