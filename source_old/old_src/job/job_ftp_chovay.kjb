    <entry>
      <name>update sync_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_CHOVAY_TT_DAILY',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(*),'job_ftp_chovay_tt_daily' from APPS.FTP_CHOVAY_TT_DAILY
where TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd');

insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_CHOVAY_THAUCHI_DAILY',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(*),'job_ftp_chovay_thauchi_daily' from APPS.FTP_CHOVAY_THAUCHI_DAILY
where TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd');


insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_CHOVAY_UPASLC_DAILY',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(*),'ftp_chovay_upaslc_daily' from APPS.FTP_CHOVAY_UPASLC_DAILY
where TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd')
;

insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_CHOVAY_RDF_DAILY',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(*),'job_ftp_chovay_rdf_daily' from APPS.FTP_CHOVAY_RDF_DAILY
where TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd');

insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_CHOVAY_NOQUAHAN_DAILY',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
count(*),'job_ftp_chovay_noquahan_daily' from APPS.FTP_CHOVAY_NOQUAHAN_DAILY
where TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>400</xloc>
      <yloc>640</yloc>
      <attributes_kjc/>
    </entry>
