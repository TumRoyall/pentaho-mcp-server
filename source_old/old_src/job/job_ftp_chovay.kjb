      <custom_sql>
-- check data in etl table
select * from apps.syn_log 
where table_name ='APPS.FILE_NSLD_AICT_BRANCH_M'
and syn_date = TRUNC(to_date('${PRD_ID}','yyyyMMdd'), 'MONTH') - 1
