where table_name in ('APPS.FTP_CHOVAY_TT_DAILY', 'APPS.FTP_CHOVAY_THAUCHI_DAILY', 'APPS.FTP_CHOVAY_UPASLC_DAILY', 'APPS.FTP_CHOVAY_RDF_DAILY','APPS.FTP_CHOVAY_NOQUAHAN_DAILY')
and syn_date =to_date('${PRD_ID}','yyyyMMdd')
and so_luong&lt;&gt;0</custom_sql>
      <add_rows_result>N</add_rows_result>
