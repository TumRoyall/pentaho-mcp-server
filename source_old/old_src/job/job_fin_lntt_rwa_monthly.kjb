FROM APPS.SYN_LOG
WHERE TABLE_NAME = 'ETL.FILE_RAROC_DC_CHITIEU'
  AND SYN_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')</custom_sql>
