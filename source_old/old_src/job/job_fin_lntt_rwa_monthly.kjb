    <entry>
      <name>ins syn log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM,
    NOTE
  )
SELECT
  'APPS.FIN_RPT_RAROC_VTC' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'job_fin_lntt_rwa_monthly' SOURCE_SYSTEM,
  '${NOTE}' NOTE
FROM
  ${TARGET_TABLE_SCHEMA}.FIN_RPT_RAROC_VTC
  WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
</sql>
