    <entry>
      <name>create as  3 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>create table etl.MPA_TONGHOP_CHIKD_TEMP as
(
select
    a.phan_loai_the,
    a.loai_giao_dich,
    b.sector_code,
    case
        when a.soure_import in (
            'MPA.MPA_INTERCHANGE_ISS_ATM_MB_VISA',
            'MPA.NAPAS_PHAN_BO'
        ) then c.chg_code
        else a.chg_code
    end as chg_code,
    a.ma_cn,
    a.makh,
    nvl(a.khoi, cus.khoi) khoi,
    a.tienno,
    a.soure_import,
    a.product_code,
    a.partition_date,
    a.tienno_vnd,
    a.bin8,
    a.bin6,
    case
        when soure_import in (
            'MPA.FILE_CHI_PHI_MARGIN_MBS',
            'MPA.ORS_HHMG',
            'MPA.MPA_BILLING_VISA_ACQ_POS',
            'MPA.MPA_BILLING_VISA_ACQ_CHUNG_POS',
            'MPA.MPA_BILLING_VISA_ACQ_ATM',
            'MPA.MPA_BILLING_VISA_ACQ_CHUNG_ATM',
            'MPA.MPA_BILLING_ISS_VISA_DETAIL',
            'MPA.MPA_BILLING_ISS_VISA_CHUNG_SME',
            'MPA.MPA_BILLING_ISS_VISA_CHUNG_KHCN',
            'MPA.MPA_BILLING_ISS_JCB',
            'MPA.MPA_BILLING_JCB_CHUNG',
            'MPA.MPA_BILLING_JCB_ACQ_POS',
            'MPA.MPA_BILLING_JCB_ACQ_ATM',
            'MPA.TMP_CHI_PHI_SMS',
			'MPA.ORS_PHANBO_TOI_NGANQUY',
			'MPA.ORS_PHANBO_TOI_BANKPLUS'
        ) then a.acctnbr
        else d.category_account
    end as acctnbr,
    nvl(sa.t24_line, sab.t24_line) || nvl(sa.t24_line_seq_nbr, sab.t24_line_seq_nbr) line_t24,
    substr(nvl(sa.t24_line, sab.t24_line), -4) || nvl(sa.t24_line_seq_nbr, sab.t24_line_seq_nbr) line_gl,
    nvl(sa.level3_coa_code, sab.level3_coa_code) tk,
	cus.sector,
    cus.phan_khuc as pkkh,
	ct.CHG_TYPE
from
    etl.MPA_MBP_TONGHOP_CHIKD a
  --20250428: hoanglh4 cap nhat theo yc chi diepbtb.ho
    left join apps.FIN_SMY_CUSTOMER_MONTHLY cus on a.makh = cus.makh and cus.transaction_date = last_day(to_date(${PRD_ID}, 'yyyymmdd'))
  --20241023- anhlv6 bo sung
  	left join ETL.STG_T24_FT_COMMISSION_TYPE ct on a.CHG_CODE = ct.COMMISSION_TYPE
    left join etl.mpa_mapping_sector b on nvl(a.khoi,cus.khoi) = b.khoi  -- bo sung cuss.khoi (a.khoi = b.khoi)
    left join etl.mpa_chg_code c on c.table_name = a.soure_import
    and c.value = (
        case
            when a.soure_import = 'MPA.MPA_INTERCHANGE_ISS_ATM_MB_VISA' then a.phan_loai_the
            when a.soure_import = 'MPA.NAPAS_PHAN_BO' then a.loai_giao_dich
        end
    )
    left join etl.ODS_T24_CAL_COMMISSION_TYPE_MAPHI_CHIDV d on nvl(d.id, 'A') = case
        when a.soure_import in (
            'MPA.MPA_INTERCHANGE_ISS_ATM_MB_VISA',
            'MPA.NAPAS_PHAN_BO'
        ) then c.chg_code
        else a.chg_code
    end
    left join 
           (
select sector_code, t24_line,level3_coa_code,t24_line_seq_nbr, cate_code, cate_range 
from etl.sub_acg_line_map_daily
where sector_code is not null
union all
select 
sector_code, 
t24_line, 
level3_coa_code, 
t24_line_seq_nbr,
 cate_code, 
 cate_range
 from
 (
select 
sector_code, 
t24_line, 
level3_coa_code, 
t24_line_seq_nbr,
 cate_code, 
 cate_range,
 row_number() over(partition by cate_code order by cate_range nulls last) rn
from etl.sub_acg_line_map_daily
where sector_code is null
) where rn = 1
)  sa 
on case
        when b.khoi = 'SME'
        and b.sector_code is null and sa.sector_code is null  then 1
        else case
            when sa.sector_code is not null then instr(b.sector_code, sa.sector_code)
            else 0
        end
    end > 0
    and case
        when soure_import in (
            'MPA.FILE_CHI_PHI_MARGIN_MBS',
            'MPA.ORS_HHMG',
            'MPA.MPA_BILLING_VISA_ACQ_POS',
            'MPA.MPA_BILLING_VISA_ACQ_CHUNG_POS',
            'MPA.MPA_BILLING_VISA_ACQ_ATM',
            'MPA.MPA_BILLING_VISA_ACQ_CHUNG_ATM',
            'MPA.MPA_BILLING_ISS_VISA_DETAIL',
            'MPA.MPA_BILLING_ISS_VISA_CHUNG_SME',
            'MPA.MPA_BILLING_ISS_VISA_CHUNG_KHCN',
            'MPA.MPA_BILLING_ISS_JCB',
            'MPA.MPA_BILLING_JCB_CHUNG',
            'MPA.MPA_BILLING_JCB_ACQ_POS',
            'MPA.MPA_BILLING_JCB_ACQ_ATM',
            'MPA.TMP_CHI_PHI_SMS',
			'MPA.ORS_PHANBO_TOI_NGANQUY',
			'MPA.ORS_PHANBO_TOI_BANKPLUS'
        ) then a.acctnbr
        else d.category_account
    end = sa.cate_code
    left join (
select sector_code, t24_line,level3_coa_code,t24_line_seq_nbr, cate_code, cate_range 
from etl.sub_acg_line_map_daily
where sector_code is not null
union all
select 
sector_code, 
t24_line, 
level3_coa_code, 
t24_line_seq_nbr,
 cate_code, 
 cate_range
 from
 (
select 
sector_code, 
t24_line, 
level3_coa_code, 
t24_line_seq_nbr,
 cate_code, 
 cate_range,
 row_number() over(partition by cate_code order by cate_range nulls last) rn
from etl.sub_acg_line_map_daily
where sector_code is null
) where rn = 1
) sab
    on case
        when soure_import in (
            'MPA.FILE_CHI_PHI_MARGIN_MBS',
            'MPA.ORS_HHMG',
            'MPA.MPA_BILLING_VISA_ACQ_POS',
            'MPA.MPA_BILLING_VISA_ACQ_CHUNG_POS',
            'MPA.MPA_BILLING_VISA_ACQ_ATM',
            'MPA.MPA_BILLING_VISA_ACQ_CHUNG_ATM',
            'MPA.MPA_BILLING_ISS_VISA_DETAIL',
            'MPA.MPA_BILLING_ISS_VISA_CHUNG_SME',
            'MPA.MPA_BILLING_ISS_VISA_CHUNG_KHCN',
            'MPA.MPA_BILLING_ISS_JCB',
            'MPA.MPA_BILLING_JCB_CHUNG',
            'MPA.MPA_BILLING_JCB_ACQ_POS',
            'MPA.MPA_BILLING_JCB_ACQ_ATM',
            'MPA.TMP_CHI_PHI_SMS',
			'MPA.ORS_PHANBO_TOI_NGANQUY',
			'MPA.ORS_PHANBO_TOI_BANKPLUS'
        ) then a.acctnbr
        else d.category_account
    end = sab.cate_code
    and case when b.khoi = 'SME'
        and b.sector_code is null and sab.sector_code is null then 1
        else case
            when sab.sector_code is null then 1
              else 0
        end 
        end > 0
    left join etl.ors_tr_khachhang_active_m e on e.makh = a.makh
    left join etl.ors_mb_sme_pkkh_m f on a.makh = f.makh and f.PK_TYPE = 'PK_100' and f.DTT_TYPE = '3'
);</sql>
