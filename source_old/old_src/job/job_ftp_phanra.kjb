    <entry>
      <name>update sync_log </name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,source_system,so_luong)
select upper('FTP_DIC_PERCENTILE_VN'),3,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')),'etl_job_ftp_phan_ra_vn_agg'
,count(*)
from apps.FTP_DIC_PERCENTILE t
where t.date_apply =to_date('${PRD_ID}','yyyyMMdd')
and t.source_id='VN'
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>304</xloc>
      <yloc>400</yloc>
      <attributes_kjc/>
    </entry>
