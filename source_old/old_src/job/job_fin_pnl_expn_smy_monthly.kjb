WHERE GL_LINE IS NOT NULL 

MINUS

SELECT DISTINCT GL_LINE
FROM APPS.FILE_EXPN_CODE_MAP )

UNION ALL

(SELECT DISTINCT  GL_LINE
FROM APPS.FILE_EXPN_CODE_MAP 

MINUS

