    <entry>
      <name>update sync_log rep_toi_final_daily</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,source_system,so_luong)
select 'REP_FTP_CUS_KH_DAILY',1,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')),'etl_job_ftp_cus_daily_pre_cal'
,count(*)
from etl.rep_ftp_cus_kh_daily
WHERE TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
