    <entry>
      <name>check log table tckt</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>tckt_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>16</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>select distinct table_name from apps.syn_log 
where table_name in (--'APPS.FTP_MAP_TERM','APPS.FTP_MAP_GROUP','APPS.FTP_MAP_HTOAN',
'APPS.FTP_REF_TYLE_PHANRA','APPS.FTP_REF_FTPDB',
'APPS.FTP_REF_HDDB','APPS.FTP_REF_BASE_MARGIN','APPS.FTP_REF_NIM_MARGIN','APPS.FTP_REF_CHIPHI_BHTG','APPS.FTP_REF_CHIPHI_DTBB','APPS.FTP_REF_CHIPHI_TK','APPS.FTP_LICHTRAGOC_LSPHUTROI','APPS.FTP_REF_PHUTROI',
'APPS.FTP_REF_DIEUCHINH_ALCO','APPS.FTP_REF_FTP_BASE','APPS.FTP_REF_NIM_HD','APPS.FTP_REF_CHIPHI_VAYDAIHAN','APPS.FTP_REF_CHIPHI_HDVLSCAO','ORS_GL_DAILY_RATES')
and TRANSACTION_DATE = TO_DATE(${PRD_ID},'YYYYMMDD')
UNION ALL

select distinct table_name from apps.syn_log 
where table_name in ('APPS.FILE_NSLD_AICT_BRANCH_M')
and TRANSACTION_DATE = TRUNC(TO_DATE(${PRD_ID},'YYYYMMDD'),'MM')-1</custom_sql>
      <add_rows_result>N</add_rows_result>
