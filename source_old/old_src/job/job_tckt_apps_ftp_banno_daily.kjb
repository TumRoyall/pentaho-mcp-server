    <entry>
      <name>insert synlog 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into APPS.syn_log(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'APPS.FTP_BANNO_DAILY',2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')), COUNT(1),
'job_tckt_apps_ftp_banno_daily'
from APPS.FTP_BANNO_DAILY
WHERE TRANSACTION_DATE = to_date(${PRD_ID},'yyyyMMdd');
commit;</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
