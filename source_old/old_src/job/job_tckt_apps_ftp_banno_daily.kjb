    <entry>
      <name>insert bu du lieu</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>--XOA DU LIEU 
DELETE APPS.FTP_BANNO_DAILY
WHERE TRANSACTION_DATE = to_date('${PRD_ID}','yyyyMMdd');
COMMIT;

--INSERT DU LIEU NGAY LAM VIEC GAN NHAT
INSERT INTO APPS.FTP_BANNO_DAILY
SELECT to_date('${PRD_ID}','yyyyMMdd') TRANSACTION_DATE, SOTK, CCY, T24_LINE, COA_CODE, INT_RATE_TYPE, TERM_HD, TERM_FTP, MAKH, ARRANGEMENT_INT_RATE, CNC2, VUNG_MIEN, PRODUCT_CODE, FTP_CODE, FTP_TYPE, KHOI, VALUE_DATE, MATURITY_DATE, NGAY_TDLS, SECTOR, RM_CODE, TYGIA, FCY_AMT, LCY_AMT, SOURCE_TABLE, FTP_GROUP, FTP_CATEGORY, FTP_LINE, GL_LINE, INT_FIX, INT_BHTG, INT_DTBB, INT_TK, INT_PHUTROI, INT_DC_ALCO, INT_BASE, INT_NIM_HD, INT_PHANRA, INT_VAYDH, INT_HDVLSC, INT_BASE_MARGIN, INT_LS_HD, INT_NIM_MARGIN, FTP_RATE_HT, FTP_RATE_TT, FTP_HT_FCY, FTP_HT_LCY, FTP_TT_FCY, FTP_TT_LCY
FROM APPS.FTP_BANNO_DAILY
WHERE TRANSACTION_DATE = (SELECT MAX(DAYID) FROM apps.MB_DIM_TIME b
WHERE b.DAYID &lt;= TO_DATE('${PRD_ID}', 'YYYYMMDD')
AND IS_WORKING_DAY = 1);</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
