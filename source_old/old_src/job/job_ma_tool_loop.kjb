    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  '${TABLE_NAME}' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${DATE_}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${DATE_}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'job_ma_tool_all' SOURCE_SYSTEM
FROM
  ${SCHEMA_NAME}.${TABLE_NAME}
where ${COLM_DEL} = TO_DATE('${DATE_}', 'YYYYMMDD')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>880</xloc>
      <yloc>64</yloc>
      <attributes_kjc/>
    </entry>
