            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'D'
            )
          ) BETWEEN 150 
          AND 179 THEN 5 WHEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'D'
            )
          ) BETWEEN 180 
          AND 209 THEN 6 WHEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'D'
            )
          ) BETWEEN 210 
          AND 239 THEN 7 WHEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'D'
            )
          ) BETWEEN 240 
          AND 269 THEN 8 WHEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'D'
            )
          ) BETWEEN 270 
