            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'D'
            )
          ) BETWEEN 0 
          AND 27 THEN 0 WHEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
