      ) * 7 >= 3650 THEN 120 END ELSE TO_NUMBER(
        REGEXP_REPLACE(ARRANGEMENT_TERM, '[A-Za-z]', '')
      ) 
      --9999--TO_NUMBER (ARRANGEMENT_TERM) --0 
      END LOC_TERM, 
      'CKH' LOAIKYHAN, 
      null SUB_PRODUCT, 
      NULL FTP_CODE 
    FROM 
      etl.ODS_SECOND_TD_CONTRACT
  ) A 
  LEFT JOIN ETL.ORS_TR_KHACHHANG B ON A.MAKH = B.MAKH;</sql>
