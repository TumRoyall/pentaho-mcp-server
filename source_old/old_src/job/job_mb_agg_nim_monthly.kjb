    <entry>
      <name>ETL_TMP_NIM_LTT</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.ETL_TMP_NIM_LTT ;

INSERT INTO ETL.ETL_TMP_NIM_LTT
  (TRANSACTION_DATE,
   D_TYPE,
   SOTK,
   MAKH,
   NTE,
   CN,
   KHOI,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND)
  SELECT B.TRANSACTION_DATE,
         B.D_TYPE,
         B.SOTK,
         B.MAKH,
         B.NTE,
         B.CN,
         B.KHOI,
         SUM(B.REAL_INTEREST) REAL_INTEREST,
         SUM(B.REAL_INTEREST_VND) REAL_INTEREST_VND,
         SUM(B.PENALTY_INTEREST) PENALTY_INTEREST,
         SUM(B.PENALTY_INTEREST_VND) PENALTY_INTEREST_VND
    FROM ETL.ETL_TMP_NIM_LTT_PRE B
   GROUP BY B.TRANSACTION_DATE,
            B.D_TYPE,
            B.SOTK,
            B.MAKH,
            B.NTE,
            B.CN,
            B.KHOI ;

COMMIT ;</sql>
