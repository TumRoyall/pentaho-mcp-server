    <entry>
      <name>ETL_TMP_LOAN_INFO</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.ETL_TMP_LOAN_INFO ;

INSERT INTO ETL.ETL_TMP_LOAN_INFO
    (TAIKHOAN,
     MBLD_TYPE,
     PRODUCT_CODE,
     PRODUCTGR_CODE,
     CATEGORY,
     SUB_PRODUCT,
     LOC_TERM,
     LOAIKYHAN,
     SECTOR,
     NHOMNO_XHTD,
     NHOMNO_LIENDOI,
     KHOI,
     PRODUCT_TYPE,
     FTP_CODE,
     PROJECT_ID)
    SELECT A.TAIKHOAN,
           A.MBLD_TYPE,
           A.PRODUCT_CODE,
           A.PRODUCTGR_CODE,
           A.CATEGORY,
           A.SUB_PRODUCT,
           A.LOC_TERM,
           A.LOAIKYHAN,
           D.SECTOR,
           A.NHOMNO_XHTD,
           NULL NHOMNO_LIENDOI,
           D.KHOI,
           A.PRODUCT_TYPE,
           A.FTP_CODE,
           A.PROJECT_ID
      FROM (SELECT MAKH,
                   ARRANGEMENT_NBR TAIKHOAN,
                   CAMPAIGN_CODE MBLD_TYPE,
                   PRODUCT_CODE,
                   PRODUCT_GROUP_CODE PRODUCTGR_CODE,
                   CATE_CODE CATEGORY,
                   SUB_PRODUCT_CODE SUB_PRODUCT,
                   REPLACE(ARRANGEMENT_TERM, 'M') LOC_TERM,
					
					/*
					ngapt.os
					creat_date: 20250213
					jira: YCPT-23500
					thay doi mapping truong LOAIKYHAN,*/

                   /*CASE
                       WHEN REPLACE(ARRANGEMENT_TERM, 'M') &lt;= 12 THEN
                        'NH'
                       WHEN REPLACE(ARRANGEMENT_TERM, 'M') &lt;= 60 THEN
                        'TH'
                       ELSE
                        'DH'
                   END LOAIKYHAN,*/

					case WHEN REPLACE(ARRANGEMENT_TERM, 'M') between 0 and 12 then 'NH'
						 WHEN REPLACE(ARRANGEMENT_TERM, 'M') between 12 and 60 then 'TH'
						 WHEN REPLACE(ARRANGEMENT_TERM, 'M') > 60 then 'DH' else 'NH' end LOAIKYHAN,
	
                   CREDIT_STATUS NHOMNO_XHTD,
                   PROGRAM_CODE PRODUCT_TYPE,
                   PROJECT_ID,
                   FTP_CODE
              FROM ETL.ODS_LOAN_CONTRACT
            UNION ALL
            SELECT A.MAKH,
                   A.ARRANGEMENT_NBR TAIKHOAN,
                   B.CAMPAIGN_CODE MBLD_TYPE,
                   A.PRODUCT_CODE,
                   A.PRODUCT_GROUP_CODE PRODUCTGR_CODE,
                   A.CATE_CODE CATEGORY,
                   A.SUB_PRODUCT_CODE SUB_PRODUCT,
                   REPLACE(A.ARRANGEMENT_TERM, 'M') LOC_TERM,
					
					/*
					ngapt.os
					creat_date: 20250213
					jira: YCPT-23500
					thay doi mapping truong LOAIKYHAN,*/

	
                   /*CASE
                       WHEN REPLACE(A.ARRANGEMENT_TERM, 'M') &lt;= 12 THEN
                        'NH'
                       WHEN REPLACE(A.ARRANGEMENT_TERM, 'M') &lt;= 60 THEN
                        'TH'
                       ELSE
                        'DH'
                   END LOAIKYHAN,*/

					CASE WHEN REPLACE(a.ARRANGEMENT_TERM, 'M') BETWEEN 0 AND 12 THEN 'NH'
						 WHEN REPLACE(a.ARRANGEMENT_TERM, 'M') BETWEEN 12 AND 60 THEN 'TH'
						 WHEN REPLACE(a.ARRANGEMENT_TERM, 'M') > 60 THEN 'DH' ELSE 'NH' END LOAIKYHAN,

                   A.CREDIT_STATUS NHOMNO_XHTD,
                   B.PROGRAM_CODE PRODUCT_TYPE,
                   B.PROJECT_ID,
                   A.FTP_CODE
              FROM ETL.ODS_PD_CONTRACT A
              LEFT JOIN ETL.ODS_LOAN_CONTRACT B
                ON A.ARRANGEMENT_NBR = 'PD' || B.ARRANGEMENT_NBR
             WHERE A.RANK_NUM = 1
            UNION ALL
            SELECT MAKH,
                   ARRANGEMENT_NBR TAIKHOAN,
                   CAMPAIGN_CODE MBLD_TYPE,
                   PRODUCT_CODE,
                   PRODUCT_GROUP_CODE PRODUCTGR_CODE,
                   CATE_CODE CATEGORY,
                   SUB_PRODUCT_CODE SUB_PRODUCT,
                   '12' LOC_TERM,
                   'NH' LOAIKYHAN,
                   CREDIT_STATUS NHOMNO_XHTD,
                   NULL PRODUCT_TYPE,
                   NULL PROJECT_ID,
                   CASE
                       WHEN NVL(SUB_PRODUCT_CODE, 0) IN ('378', '380') THEN
                        'TD403'
                       ELSE
                        'TD401'
                   END FTP_CODE
              FROM ETL.ODS_OVD_CONTRACT
            
            UNION ALL
            SELECT T24_CUSTOMER_CODE MAKH,
                   CONTRACT_NUMBER   TAIKHOAN,
                   NULL              MBLD_TYPE,
                   T24_PROD_CODE     PRODUCT_CODE,
                   NULL              PRODUCTGR_CODE,
                   NULL              CATEGORY,
                   NULL              SUB_PRODUCT,
                   NULL              LOC_TERM,
                   NULL              LOAIKYHAN,
                   NULL              NHOMNO_XHTD,
                   NULL              PRODUCT_TYPE,
                   NULL              PROJECT_ID,
                   B.FTP_CODE        FTP_CODE
              FROM (SELECT T24_CUSTOMER_CODE,
                           CONTRACT_NUMBER,
                           T24_PROD_CODE,
                           card_class,
                           ROW_NUMBER() OVER(PARTITION BY CONTRACT_NUMBER ORDER BY CARD_ID DESC) RN
                      FROM ETL.ORS_NHS_KPI_CREDIT_CARD_NOW) A
              LEFT JOIN ETL.FTP_MAP_CARD_CREDIT B
                ON A.T24_PROD_CODE = B.PRODUCT_CODE AND a.CARD_CLASS = b.CARD_CLASS
             WHERE A.RN = 1
            ) A
      LEFT JOIN ETL.ORS_TR_KHACHHANG D
        ON A.MAKH = D.MAKH ;

COMMIT;
</sql>
