      <name>ins MB_AGG_NIM_M dieu chinh</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO APPS.MB_AGG_NIM_M
  (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   INTEREST_FTP,
   INTEREST_FTP_VND,
   INTEREST_FTP_TT,
   INTEREST_FTP_TT_VND,
   MBLD_TYPE,
   PRODUCT_CODE,
   PRODUCTGR_CODE,
   CATEGORY,
   SUB_PRODUCT,
   LOC_TERM,
   LOAIKYHAN,
   SECTOR,
   NHOMNO_XHTD,
   NHOMNO_LIENDOI,
   PROJECT_ID,
   FTP_CODE,
   PRODUCT_TYPE)
  SELECT TRANSACTION_DATE,
         D_TYPE,
         TAIKHOAN,
         MAKH,
         NTE,
         CN,
         KHOI,
         BALANCE,
         BALANCE_VND,
         NOMINAL_INTEREST,
         NOMINAL_INTEREST_VND,
         REAL_INTEREST,
         REAL_INTEREST_VND,
         PENALTY_INTEREST,
         PENALTY_INTEREST_VND,
         INTEREST_FTP,
         INTEREST_FTP_VND,
         INTEREST_FTP_TT,
         INTEREST_FTP_TT_VND,
         MBLD_TYPE,
         PRODUCT_CODE,
         PRODUCTGR_CODE,
         CATEGORY,
         SUB_PRODUCT,
         LOC_TERM,
         LOAIKYHAN,
         SECTOR,
         NHOMNO_XHTD,
         NHOMNO_LIENDOI,
         PROJECT_ID,
         FTP_CODE,
         PRODUCT_TYPE
    FROM ETL.MB_AGG_NIM_M_IMPORT_DC;</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
