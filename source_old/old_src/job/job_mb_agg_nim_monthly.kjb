    <entry>
      <name>ETL_TMP_NIM_LTT_PRE</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.ETL_TMP_NIM_LTT_PRE ;
 
INSERT INTO ETL.ETL_TMP_NIM_LTT_PRE
  (TRANSACTION_DATE,
   D_TYPE,
   SOTK,
   MAKH,
   NTE,
   CN,
   KHOI,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   PL_CATEG)
    SELECT LAST_DAY(DC.transaction_date) TRANSACTION_DATE,
         'LOAN' D_TYPE,
         DC.ld_id SOTK,
         dc.makh MAKH,
         DC.nte NTE,
         DC.cn CN,
         LOAN.KHOI,
         DC.DOANHSO_THOAITHU_VND REAL_INTEREST,
         DC.DOANHSO_THOAITHU_VND REAL_INTEREST_VND,
         0 PENALTY_INTEREST,
         0 PENALTY_INTEREST_VND,
         '67010' PL_CATEG
    FROM apps.FIN_TRANS_INT_ADJUST_DAILY DC
    LEFT JOIN ETL.ETL_TMP_LOAN_INFO LOAN
      ON DC.ld_id = LOAN.TAIKHOAN 
    WHERE TRANSACTION_DATE BETWEEN trunc(TO_DATE('${PRD_ID}', 'yyyyMMdd'),'MONTH') AND TO_DATE('${PRD_ID}', 'yyyyMMdd') AND DOANHSO_THOAITHU_VND &lt;&gt; 0 ;
 
INSERT INTO ETL.ETL_TMP_NIM_LTT_PRE
  (TRANSACTION_DATE,
   D_TYPE,
   SOTK,
   MAKH,
   NTE,
   CN,
   KHOI,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   PL_CATEG)
SELECT TRANSACTION_DATE,
       CASE WHEN B.CHITIEU_PLKHOI = 'A11146' THEN 'MUA_NO'
           WHEN A.PL_CATEG = '52430' OR substr(B.CHITIEU_PLKHOI, 1, 5) = 'A1114' THEN 'LOAN'
           WHEN substr(B.CHITIEU_PLKHOI, 1, 5) = 'A1224' THEN 'DEPOSIT'
           WHEN substr(B.CHITIEU_PLKHOI, 1, 5) IN ('A1113', 'A1223') THEN 'BOND'
           ELSE NULL
       END D_TYPE,
       CASE
           WHEN SCT LIKE '%;%' THEN SUBSTR(SCT, 1, INSTR(SCT, ';', 1, 1) - 1)
           ELSE SCT
       END SOTK,
       MAKH,
       NTE,
       CN,
       KHOI,
       CASE
           WHEN PL_CATEG &lt;&gt; '52430' THEN AMT
       END REAL_INTEREST,
       CASE
           WHEN PL_CATEG &lt;&gt; '52430' THEN AMT_VND
       END REAL_INTEREST_VND,
       CASE
           WHEN PL_CATEG = '52430' THEN AMT
       END PENALTY_INTEREST,
       CASE
           WHEN PL_CATEG = '52430' THEN AMT_VND
       END PENALTY_INTEREST_VND,
       A.PL_CATEG
  FROM ETL.ODS_CAL_PL_TXN_MONTHLY A
  LEFT JOIN APPS.MB_MAP_TOI_LINE B
    ON A.TRANSACTION_DATE = B.DATE_TX
   AND A.LINE_GL = B.LINET24
   AND B.ACCTNBR IS NULL
WHERE A.TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
   AND SUBSTR(SCT, 1, 2) NOT IN ('FT', 'CD', 'CH', 'RV', 'DC')
   AND (PL_CATEG = '52430' 
       OR (substr(B.CHITIEU_PLKHOI, 1, 5) IN ('A1114', 'A1224', 'A1113', 'A1223')--, 'A11146') 
         AND B.KHOI_THEOPLKHOI NOT LIKE '%ALM%' 
         AND B.KHOI_THEOPLKHOI NOT LIKE '%TREASURY%')) ;
 
COMMIT ;</sql>
