      <sql>TRUNCATE TABLE ETL.ETL_TMP_DEPOSIT_INFO ;
 
INSERT INTO ETL.ETL_TMP_DEPOSIT_INFO
    (TAIKHOAN,
     PRODUCT_CODE,
     CATEGORY,
     LOC_TERM,
     LOAIKYHAN,
     SECTOR,
     MBLD_TYPE,
     SUB_PRODUCT,
     NHOMNO_XHTD,
     NHOMNO_LIENDOI,
     PRODUCTGR_CODE,
     FTP_CODE)
SELECT 
  A.TAIKHOAN, 
  A.PRODUCT_CODE, 
  A.CATEGORY, 
  A.LOC_TERM, 
  A.LOAIKYHAN, 
  B.SECTOR, 
  NULL MBLD_TYPE, 
  A.SUB_PRODUCT, 
  NULL NHOMNO_XHTD, 
  NULL NHOMNO_LIENDOI, 
  NULL PRODUCTGR_CODE, 
  A.FTP_CODE 
FROM 
  (
    SELECT 
      MAKH, 
      ARRANGEMENT_NBR TAIKHOAN, 
      PRODUCT_CODE, 
      CATE_CODE CATEGORY, 
      0 LOC_TERM, 
      CASE WHEN PRODUCT_CODE = '12419' THEN 'CKH' ELSE 'KKH' END LOAIKYHAN, 
      SUB_PRODUCT_CODE SUB_PRODUCT, 
      FTP_CODE 
    FROM 
      ETL.ODS_CASA_CONTRACT 
    UNION 
    SELECT 
      MAKH, 
      TAIKHOAN, 
      PRODUCT_CODE, 
      CATEGORY, 
      LOC_TERM, 
      LOAIKYHAN, 
      SUB_PRODUCT, 
      FTP_CODE 
    FROM 
      (
        SELECT 
          MAKH, 
          ARRANGEMENT_NBR TAIKHOAN, 
          PRODUCT_CODE, 
          CATE_CODE CATEGORY, 
          CASE WHEN UPPER(ARRANGEMENT_TERM) = '.' THEN 0 WHEN UPPER(ARRANGEMENT_TERM) LIKE '%M' THEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'M'
            )
          ) WHEN UPPER(ARRANGEMENT_TERM) LIKE '%T' THEN TO_NUMBER(
            REPLACE(
              UPPER(ARRANGEMENT_TERM), 
              'T'
            )
