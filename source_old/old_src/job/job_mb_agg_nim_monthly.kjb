    <entry>
      <name>MB_AGG_NIM_M</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO ${TARGET_TABLE_SCHEMA}.MB_AGG_NIM_M
  (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   MBLD_TYPE,
   PRODUCT_CODE,
   PRODUCTGR_CODE,
   CATEGORY,
   SUB_PRODUCT,
   LOC_TERM,
   LOAIKYHAN,
   SECTOR,
   NHOMNO_XHTD,
   NHOMNO_LIENDOI,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   INTEREST_FTP,
   INTEREST_FTP_VND,
   INTEREST_FTP_TT,
   INTEREST_FTP_TT_VND,
   PRODUCT_TYPE,
   PROJECT_ID,
   FTP_CODE)
  SELECT NIM.TRANSACTION_DATE,
         NIM.D_TYPE,
         NIM.TAIKHOAN,
         NIM.MAKH,
         NIM.NTE,
         NIM.CN,
         LOAN.MBLD_TYPE MBLD_TYPE,
         LOAN.PRODUCT_CODE PRODUCT_CODE,
         LOAN.PRODUCTGR_CODE PRODUCTGR_CODE,
         DECODE(PRE.SOTK, NULL, LOAN.CATEGORY, '17001') CATEGORY,
         LOAN.SUB_PRODUCT SUB_PRODUCT,
         LOAN.LOC_TERM LOC_TERM,
         LOAN.LOAIKYHAN LOAIKYHAN,
         LOAN.SECTOR SECTOR,
         LOAN.NHOMNO_XHTD NHOMNO_XHTD,
         LOAN.NHOMNO_LIENDOI NHOMNO_LIENDOI,
         CASE
           WHEN NIM.TAIKHOAN IN
                ('0511100267866', '2555139298958', '0511104635002') THEN
            'NHS'
           WHEN NVL(PDC.SP_DV, 0) IN ('SPS1', 'DVS1') THEN
            'NHS'
           ELSE
            NVL(NIM.KHOI, KH.KHOI)
         END KHOI,
         NIM.BALANCE,
         NIM.BALANCE_VND,
         NIM.NOMINAL_INTEREST,
         NIM.NOMINAL_INTEREST_VND,
         NIM.REAL_INTEREST,
         NIM.REAL_INTEREST_VND,
         NIM.PENALTY_INTEREST,
         NIM.PENALTY_INTEREST_VND,
         NIM.INTEREST_FTP,
         NIM.INTEREST_FTP_VND,
         NIM.INTEREST_FTP_TT,
         NIM.INTEREST_FTP_TT_VND,
         LOAN.PRODUCT_TYPE,
         LOAN.PROJECT_ID,
         LOAN.FTP_CODE
    FROM ETL.ETL_TMP_NIM_PRE NIM
    LEFT JOIN ETL.ETL_TMP_LOAN_INFO LOAN
      ON NIM.TAIKHOAN = LOAN.TAIKHOAN
    LEFT JOIN ETL.ETL_TMP_NIM_LTT_PRE PRE
      ON NIM.TAIKHOAN = PRE.SOTK
     AND PRE.PL_CATEG IN ('67026', '52795', '67021')
    LEFT JOIN ETL.ORS_TR_KHACHHANG KH
      ON NIM.MAKH = KH.MAKH
    LEFT JOIN ETL.ORS_MB_PRODUCT_CODE PDC
      ON LOAN.PRODUCT_CODE = PDC.PRODUCT_CODE
   WHERE NIM.D_TYPE = 'LOAN' ;

INSERT INTO ${TARGET_TABLE_SCHEMA}.MB_AGG_NIM_M
  (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   MBLD_TYPE,
   PRODUCT_CODE,
   PRODUCTGR_CODE,
   CATEGORY,
   SUB_PRODUCT,
   LOC_TERM,
   LOAIKYHAN,
   SECTOR,
   NHOMNO_XHTD,
   NHOMNO_LIENDOI,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   INTEREST_FTP,
   INTEREST_FTP_VND,
   INTEREST_FTP_TT,
   INTEREST_FTP_TT_VND,
   PRODUCT_TYPE,
   PROJECT_ID,
   FTP_CODE)
  SELECT NIM.TRANSACTION_DATE,
         NIM.D_TYPE,
         NIM.TAIKHOAN,
         NIM.MAKH,
         NIM.NTE,
         NIM.CN,
         DEP.MBLD_TYPE MBLD_TYPE,
         DEP.PRODUCT_CODE PRODUCT_CODE,
         DEP.PRODUCTGR_CODE PRODUCTGR_CODE,
         (CASE
           WHEN NIM.TAIKHOAN LIKE 'CHG%' AND
                NIM.TAIKHOAN IN
                (SELECT PRE.SOTK
                   FROM ETL.ETL_TMP_NIM_LTT_PRE PRE
                  WHERE PL_CATEG IN ('67026', '52795', '67021')) THEN
            '17001'
           ELSE
            DEP.CATEGORY
         END) CATEGORY,
         DEP.SUB_PRODUCT SUB_PRODUCT,
         DEP.LOC_TERM LOC_TERM,
         DEP.LOAIKYHAN LOAIKYHAN,
         DEP.SECTOR SECTOR,
         DEP.NHOMNO_XHTD NHOMNO_XHTD,
         DEP.NHOMNO_LIENDOI NHOMNO_LIENDOI,
         CASE
           WHEN NIM.TAIKHOAN IN
                ('0511100267866', '2555139298958', '0511104635002') THEN
            'NHS'
           WHEN NVL(PDC.SP_DV, 0) IN ('SPS1', 'DVS1') THEN
            'NHS'
           ELSE
            NVL(NIM.KHOI, KH.KHOI)
         END KHOI,
         NIM.BALANCE,
         NIM.BALANCE_VND,
         NIM.NOMINAL_INTEREST,
         NIM.NOMINAL_INTEREST_VND,
         NIM.REAL_INTEREST,
         NIM.REAL_INTEREST_VND,
         NIM.PENALTY_INTEREST,
         NIM.PENALTY_INTEREST_VND,
         NIM.INTEREST_FTP,
         NIM.INTEREST_FTP_VND,
         NIM.INTEREST_FTP_TT,
         NIM.INTEREST_FTP_TT_VND,
         NULL PRODUCT_TYPE,
         NULL PROJECT_ID,
         DEP.FTP_CODE
    FROM ETL.ETL_TMP_NIM_PRE NIM
    LEFT JOIN ETL.ETL_TMP_DEPOSIT_INFO DEP
      ON NIM.TAIKHOAN = DEP.TAIKHOAN
    LEFT JOIN ETL.ORS_TR_KHACHHANG KH
      ON NIM.MAKH = KH.MAKH
    LEFT JOIN ETL.ORS_MB_PRODUCT_CODE PDC
      ON DEP.PRODUCT_CODE = PDC.PRODUCT_CODE
   WHERE D_TYPE = 'DEPOSIT'; 

INSERT INTO ${TARGET_TABLE_SCHEMA}.MB_AGG_NIM_M
     (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   INTEREST_FTP,
   INTEREST_FTP_VND,
   INTEREST_FTP_TT,
   INTEREST_FTP_TT_VND,
   MBLD_TYPE,
   PRODUCT_CODE,
   PRODUCTGR_CODE,
   CATEGORY,
   SUB_PRODUCT,
   LOC_TERM,
   LOAIKYHAN,
   SECTOR,
   NHOMNO_XHTD,
   NHOMNO_LIENDOI)
    SELECT NIM.TRANSACTION_DATE,
           NIM.D_TYPE,
           NIM.TAIKHOAN,
           NIM.MAKH MAKH,
           NIM.NTE,
           NIM.CN,
           COALESCE(NIM.KHOI, KH.KHOI) KHOI,
           NIM.BALANCE,
           NIM.BALANCE_VND,
           NIM.NOMINAL_INTEREST,
           NIM.NOMINAL_INTEREST_VND,
           NIM.REAL_INTEREST,
           NIM.REAL_INTEREST_VND,
           NIM.PENALTY_INTEREST,
           NIM.PENALTY_INTEREST_VND,
           NIM.INTEREST_FTP,
           NIM.INTEREST_FTP_VND,
           NIM.INTEREST_FTP_TT,
           NIM.INTEREST_FTP_TT_VND,
           NULL MBLD_TYPE,
           BOND.PRODUCT_CODE,
           NULL PRODUCTGR_CODE,
           NULL CATEGORY,
           NULL SUB_PRODUCT,
           BOND.LOC_TERM,
           BOND.LOAIKYHAN,
           KH.SECTOR SECTOR,
           NULL NHOMNO_XHTD,
           NULL NHOMNO_LIENDOI
      FROM ETL.ETL_TMP_NIM_PRE NIM
      LEFT JOIN ETL.ETL_TMP_BOND_INFO BOND
        ON NIM.TAIKHOAN = BOND.TAIKHOAN
      LEFT JOIN ETL.ORS_TR_KHACHHANG KH
        ON NIM.MAKH = KH.MAKH
     WHERE NIM.D_TYPE = 'BOND';

INSERT INTO ${TARGET_TABLE_SCHEMA}.MB_AGG_NIM_M
    (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   INTEREST_FTP,
   INTEREST_FTP_VND,
   INTEREST_FTP_TT,
   INTEREST_FTP_TT_VND,
   MBLD_TYPE,
   PRODUCT_CODE,
   PRODUCTGR_CODE,
   CATEGORY,
   SUB_PRODUCT,
   LOC_TERM,
   LOAIKYHAN,
   SECTOR,
   NHOMNO_XHTD,
   NHOMNO_LIENDOI)
    SELECT NIM.TRANSACTION_DATE,
           NIM.D_TYPE,
           NIM.TAIKHOAN,
           NIM.MAKH,
           NIM.NTE,
           NIM.CN,
           NIM.KHOI,
           NIM.BALANCE,
           NIM.BALANCE_VND,
           NIM.NOMINAL_INTEREST,
           NIM.NOMINAL_INTEREST_VND,
           NIM.REAL_INTEREST,
           NIM.REAL_INTEREST_VND,
           NIM.PENALTY_INTEREST,
           NIM.PENALTY_INTEREST_VND,
           NIM.INTEREST_FTP,
           NIM.INTEREST_FTP_VND,
           NIM.INTEREST_FTP_TT,
           NIM.INTEREST_FTP_TT_VND,
           NULL MBLD_TYPE,
           NULL PRODUCT_CODE,
           NULL PRODUCTGR_CODE,
           SUBSTR(NIM.TAIKHOAN, 4, 5) CATEGORY,
           NULL SUB_PRODUCT,
           NULL LOC_TERM,
           NULL LOAIKYHAN,
           NULL SECTOR,
           NULL NHOMNO_XHTD,
           NULL NHOMNO_LIENDOI
      FROM ETL.ETL_TMP_NIM_PRE NIM
     WHERE NIM.D_TYPE = 'MUA_NO';

INSERT INTO ${TARGET_TABLE_SCHEMA}.MB_AGG_NIM_M
    (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND,
   INTEREST_FTP,
   INTEREST_FTP_VND,
   INTEREST_FTP_TT,
   INTEREST_FTP_TT_VND,
   MBLD_TYPE,
   PRODUCT_CODE,
   PRODUCTGR_CODE,
   CATEGORY,
   SUB_PRODUCT,
   LOC_TERM,
   LOAIKYHAN,
   SECTOR,
   NHOMNO_XHTD,
   NHOMNO_LIENDOI)
    SELECT NIM.TRANSACTION_DATE,
           NIM.D_TYPE,
           SOTK TAIKHOAN,
           NIM.MAKH,
           NIM.NTE,
           NIM.CN,
           NIM.KHOI,
           0 BALANCE,
           0 BALANCE_VND,
           0 NOMINAL_INTEREST,
           0 NOMINAL_INTEREST_VND,
           NIM.REAL_INTEREST,
           NIM.REAL_INTEREST_VND,
           NIM.PENALTY_INTEREST,
           NIM.PENALTY_INTEREST_VND,
           0 INTEREST_FTP,
           0 INTEREST_FTP_VND,
           0 INTEREST_FTP_TT,
           0 INTEREST_FTP_TT_VND,
           NULL MBLD_TYPE,
           NIM.PRODUCT_CODE PRODUCT_CODE,
           NULL PRODUCTGR_CODE,
           CASE
               WHEN NIM.PL_CATEG IN ('67026', '52795', '67021', '52294') THEN
                '17001'
               ELSE
                NULL
           END CATEGORY,
           NULL SUB_PRODUCT,
           NULL LOC_TERM,
           NULL LOAIKYHAN,
           NULL SECTOR,
           NULL NHOMNO_XHTD,
           NULL NHOMNO_LIENDOI
      FROM ETL.ETL_TMP_NIM_LTT_PRE_FT NIM ;

COMMIT;</sql>
