    <entry>
      <name>ETL_TMP_NIM_INTEREST</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.ETL_TMP_NIM_INTEREST ;

INSERT INTO ETL.ETL_TMP_NIM_INTEREST
  (TRANSACTION_DATE,
   D_TYPE,
   SOTK,
   MAKH,
   NTE,
   CN,
   KHOI,
   BALANCE,
   BALANCE_VND,
   NOMINAL_INTEREST,
   NOMINAL_INTEREST_VND,
   REAL_INTEREST,
   REAL_INTEREST_VND,
   PENALTY_INTEREST,
   PENALTY_INTEREST_VND)
  SELECT COALESCE(BQ.TRANSACTION_DATE, LTT.TRANSACTION_DATE) TRANSACTION_DATE,
         COALESCE(BQ.D_TYPE, LTT.D_TYPE) D_TYPE,
         COALESCE(BQ.SOTK, LTT.SOTK) SOTK,
         COALESCE(BQ.MAKH, LTT.MAKH) MAKH,
         COALESCE(BQ.NTE, LTT.NTE) NTE,
         COALESCE(BQ.CN, LTT.CN) CN,
         COALESCE(BQ.KHOI, LTT.KHOI) KHOI,
         COALESCE(BQ.BALANCE, 0) BALANCE,
         COALESCE(BQ.BALANCE_VND, 0) BALANCE_VND,
         COALESCE(BQ.NOMINAL_INTEREST, 0) NOMINAL_INTEREST,
         COALESCE(BQ.NOMINAL_INTEREST_VND, 0) NOMINAL_INTEREST_VND,
         COALESCE(LTT.REAL_INTEREST, 0) REAL_INTEREST,
         COALESCE(LTT.REAL_INTEREST_VND, 0) REAL_INTEREST_VND,
         COALESCE(LTT.PENALTY_INTEREST, 0) PENALTY_INTEREST,
         COALESCE(LTT.PENALTY_INTEREST_VND, 0) PENALTY_INTEREST_VND
    FROM ETL.ETL_TMP_NIM_BQ BQ
    FULL JOIN ETL.ETL_TMP_NIM_LTT LTT
      ON BQ.TRANSACTION_DATE = LTT.TRANSACTION_DATE
        
     AND BQ.D_TYPE = LTT.D_TYPE
     AND BQ.SOTK = LTT.SOTK
     AND BQ.MAKH = LTT.MAKH
     AND BQ.NTE = LTT.NTE
     AND BQ.CN = LTT.CN
     AND BQ.KHOI = LTT.KHOI;

COMMIT ;</sql>
