    <entry>
      <name>ETL_TMP_BOND_INFO</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.ETL_TMP_BOND_INFO ;

INSERT INTO ETL.ETL_TMP_BOND_INFO
    (TAIKHOAN,
     PRODUCT_CODE,
     LOC_TERM,
     LOAIKYHAN,
     FTP_CODE)
    SELECT A.ARRANGEMENT_NBR TAIKHOAN,
       CASE
         WHEN A.PORTFOLIO_IND = 'AFS' THEN
          '74231'
         WHEN A.PORTFOLIO_IND = 'HTM' THEN
          '74331'
         ELSE
          NULL
       END PRODUCT_CODE,
       CASE
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 0 AND 27 THEN
          0
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 28 AND 59 THEN
          1
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 60 AND 89 THEN
          2
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 90 AND 119 THEN
          3
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 120 AND 149 THEN
          4
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 150 AND 179 THEN
          5
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 180 AND 209 THEN
          6
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 210 AND 239 THEN
          7
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 240 AND 269 THEN
          8
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 270 AND 299 THEN
          9
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 300 AND 329 THEN
          10
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 330 AND 364 THEN
          11
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 365 AND 389 THEN
          12
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 390 AND 449 THEN
          13
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 450 AND 539 THEN
          15
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 540 AND 729 THEN
          18
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 730 AND 1094 THEN
          24
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 1095 AND 1459 THEN
          36
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 1460 AND 1824 THEN
          48
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 1825 AND 2554 THEN
          60
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE BETWEEN 2555 AND 3649 THEN
          84
         WHEN A.MATURITY_DATE - A.ARRANGEMENT_VALUE_DATE >= 3650 THEN
          120
       END LOC_TERM,
       'TDH' LOAIKYHAN,
       'TD556' FTP_CODE
  FROM ETL.ODS_BOND_CONTRACT A ;

COMMIT;

</sql>
