    <entry>
      <name>ETL_TMP_NIM_FTPCUS</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>TRUNCATE TABLE ETL.ETL_TMP_NIM_FTPCUS ;

INSERT INTO ETL.ETL_TMP_NIM_FTPCUS
  (TRANSACTION_DATE,
   D_TYPE,
   TAIKHOAN,
   MAKH,
   NTE,
   CN,
   KHOI,
   AMT_FTP,
   AMT_LCY,
   AMT_FTP_TT,
   AMT_LCY_TT)
SELECT TO_CHAR(TRANSACTION_DATE, 'YYYYMMDD') TRANSACTION_DATE,
       (CASE
         when b.chitieu_plkhoi = 'A113525' THEN 'MUA_NO'
         WHEN substr(B.CHITIEU_PLKHOI,1,5) = 'A1135' THEN 'LOAN'
         WHEN substr(B.CHITIEU_PLKHOI,1,5) = 'A1215' THEN 'DEPOSIT'
         WHEN substr(B.CHITIEU_PLKHOI,1,5) = 'A1134' THEN 'BOND'
         ELSE NULL
       END) D_TYPE,
       (CASE
         WHEN SUBSTR(TAIKHOAN, 1, 2) = 'PD' THEN SUBSTR(TAIKHOAN, 1, 14)
         ELSE TAIKHOAN
       END) TAIKHOAN,
       MAKH,
       NTE,
       CN,
       KHOI,
       AMT_FTP,
       AMT_LCY,
       AMT_FTP_TT,
       AMT_LCY_TT
  FROM APPS.TR_FTP_CUS A
  LEFT JOIN APPS.MB_MAP_TOI_LINE B
    ON A.TRANSACTION_DATE = B.DATE_TX
   AND A.LINE_GL = B.LINET24
WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
   AND substr(B.CHITIEU_PLKHOI,1,5) IN ('A1135', 'A1215', 'A1134')
   AND B.KHOI_THEOPLKHOI NOT LIKE '%ALM%'
   AND B.KHOI_THEOPLKHOI NOT LIKE '%TREASURY%'
UNION ALL
SELECT TO_CHAR(TRANSACTION_DATE, 'YYYYMMDD') TRANSACTION_DATE,
       (CASE
         when b.chitieu_plkhoi = 'A113525' THEN 'MUA_NO'
         WHEN substr(B.CHITIEU_PLKHOI,1,5) = 'A1135' THEN 'LOAN'
         WHEN substr(B.CHITIEU_PLKHOI,1,5) = 'A1215' THEN 'DEPOSIT'
         WHEN substr(B.CHITIEU_PLKHOI,1,5) = 'A1134' THEN 'BOND'
         ELSE NULL
       END) D_TYPE,
       (CASE
         WHEN SUBSTR(TAIKHOAN, 1, 2) = 'PD' THEN SUBSTR(TAIKHOAN, 1, 14)
         ELSE TAIKHOAN
       END) TAIKHOAN,
       MAKH,
       NTE,
       CN,
       KHOI,
       AMT_FTP,
       AMT_LCY,
       AMT_FTP_TT,
       AMT_LCY_TT
  FROM APPS.TR_FTP_CUS_DIEUCHINH A
  LEFT JOIN APPS.MB_MAP_TOI_LINE B
    ON A.TRANSACTION_DATE = B.DATE_TX
   AND A.LINE_GL = B.LINET24
WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
   AND substr(B.CHITIEU_PLKHOI,1,5) IN ('A1135', 'A1215', 'A1134')
   AND B.KHOI_THEOPLKHOI NOT LIKE '%ALM%'
   AND B.KHOI_THEOPLKHOI NOT LIKE '%TREASURY%' ;
COMMIT ;</sql>
