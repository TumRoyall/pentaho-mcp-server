    <entry>
      <name>check syn log ors</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>ors_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater_equal</success_condition>
      <limit>5</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>SELECT DISTINCT TABLE_NAME
  FROM APPS.SYN_LOG T
 WHERE (UPPER(TABLE_NAME) IN ('TR_CHOVAY_BQ',
                              'MB_TR_SK_TPDN_BQ_DAILY',
                              'MB_REP_MVMT_INTEREST_M',
                              'TR_HDV_BQ') 
       AND SYN_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd') 
       AND SO_LUONG &lt;&gt; 0)
    OR (UPPER(TABLE_NAME) = 'MB_TR_SAOKE_DIEUCHINH' 
       AND SYN_DATE = (SELECT MAX(NGAY)
                      FROM APPS.MB_TR_HOLIDAY_FUTURE
                     WHERE NGAY &lt;= TO_DATE('${PRD_ID}', 'yyyyMMdd')
                       AND TRANG_THAI = 'W') 
       AND SO_LUONG &lt;&gt; 0)</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>144</xloc>
      <yloc>512</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>check syn log ods</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>ods_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>WITH TMP_LOG AS
 (SELECT COUNT(1) SOLUONG
    FROM (SELECT DISTINCT SYN_DATE
            FROM ETL.SYN_LOG
           WHERE UPPER(TABLE_NAME) = 'SMY.PL_TXN_DAILY'
             AND SYN_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MONTH') 
               AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
             AND SO_LUONG &lt;&gt; 0)),

TMP_WORKING_DAY AS
 (SELECT COUNT(1) WORKING_DAY
    FROM ODS.DATES_REF
   WHERE CALENDAR_DATE BETWEEN TRUNC(TO_DATE('${PRD_ID}', 'YYYYMMDD'), 'MONTH') 
       AND TO_DATE('${PRD_ID}', 'YYYYMMDD')
     AND WORKING_DATE_IND = 'W')

SELECT 1
  FROM TMP_LOG LOG
  FULL JOIN TMP_WORKING_DAY WRK
    ON 1 = 1
 WHERE LOG.SOLUONG = WRK.WORKING_DAY</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>144</xloc>
      <yloc>400</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>check syn log tckt</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>tckt_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater_equal</success_condition>
      <limit>2</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>SELECT DISTINCT TABLE_NAME
FROM APPS.SYN_LOG
WHERE SYN_DATE = TO_DATE('${PRD_ID}','yyyyMMdd')
AND TABLE_NAME IN ( 'MB_MAP_TOI_LINE' , 'FIN_SAOKE_MUANO_BQ_DAILY' )</custom_sql>
