      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>delete from apps.MB_AGG_THLK_TOI_SP_TMP3 where PARTITION_DATE = to_date('${PRD_ID}','YYYYMMDD');
commit;
;
insert into apps.MB_AGG_THLK_TOI_SP_TMP3
select * from ETL.ETL_MB_AGG_THLK_TOI_SP_TMP3 
where PARTITION_DATE = to_date('${PRD_ID}','YYYYMMDD')
;
commit</sql>
