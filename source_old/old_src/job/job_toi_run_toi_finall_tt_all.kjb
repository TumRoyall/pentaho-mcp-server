      <sql>insert into apps.syn_log(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select upper('APPS.MB_AGG_THLK_TOI_SP_TMP3'),2,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')), so_luong,'etl_job_toi_run_toi_finall_tt_all'
