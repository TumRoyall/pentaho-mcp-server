      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )      
 SELECT
  'ETL.ORS_TR_HDV_BQ' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  count(1) SO_LUONG,
  'TCKT_REPO/etl_job/etl_job_FIN_HDV_SMY_MONTHLY' SOURCE_SYSTEM
FROM
  ETL.ORS_TR_HDV_BQ
  WHERE 
1=1--ROWNUM = 1
  AND TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')</sql>
