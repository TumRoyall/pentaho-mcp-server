    <entry>
      <name>move data</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>create table ETL.ORS_CAL_TR_HDV_BQ_LK as
(
select
    transaction_date,
    SOTK,
    NTE,
    MAKH,
    KYHAN,
    CN,
    GL,
    CATEGORY,
    SECTOR,
    KHOI,
    PRODUCT_CODE,
    LS,
    sum(SODU_BQ_VND_LK) SODU_BQ_VND_LK
from
    (
        select
            to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
            SOTK,
            NTE,
            MAKH,
            KYHAN,
            CN,
            GL,
            CATEG_CODE CATEGORY,
            SECTOR,
            KHOI,
            PRODUCT_CODE,
            LS,
            sum (
                SODU_VND * to_char(TRANSACTION_DATE, 'DD') / to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD')
            ) SODU_BQ_VND_LK
        from
            etl.ors_tr_hdv_bq
        where
            TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
			and substr (gl,1,2) in ('42', '43')
and substr (product_code,1,2) in ('11', '12', '13')
        group by
            SOTK,
            NTE,
            MAKH,
            KYHAN,
            CN,
            GL,
            CATEG_CODE,
            SECTOR,
            KHOI,
            PRODUCT_CODE,
            LS
        UNION
        ALL
        select
            to_date('${PRD_ID}', 'YYYYMMDD') transaction_date,
            SOTK,
            NTE,
            MAKH,
            KYHAN,
            CN,
            GL,
            CATEGORY,
            SECTOR,
            KHOI,
            PRODUCT_CODE,
            LS,
            SODU_BQ_VND_LK * to_char(
                to_char(
                    last_day(
                        ADD_MONTHS(TO_DATE('${PRD_ID}', 'YYYYMMDD'), -1)
                    ),
                    'DDD'
                )
            ) / to_char(to_date ('${PRD_ID}', 'YYYYMMDD'), 'DDD') SODU_BQ_VND_LK
        from
            etl.ORS_CAL_TR_HDV_BQ_LK_old
        where
            SUBSTR('${PRD_ID}', 5, 2) > 1
            AND transaction_date = last_day(ADD_MONTHS(to_date('${PRD_ID}', 'YYYYMMDD'), -1))
			and substr (gl,1,2) in ('42', '43')
and substr (product_code,1,2) in ('11', '12', '13')
    )
group by
    transaction_date,
    SOTK,
    NTE,
    MAKH,
    KYHAN,
    CN,
    GL,
    CATEGORY,
    SECTOR,
    KHOI,
    PRODUCT_CODE,
    LS
);

drop table ETL.ORS_CAL_TR_HDV_BQ_LK_old purge;

create index etl.idx_sotk_hdv_bq_lk on etl.ORS_CAL_TR_HDV_BQ_LK(sotk);</sql>
