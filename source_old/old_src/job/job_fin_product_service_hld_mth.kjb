      <sql>insert into apps.syn_log (table_name,STATUS,TRANSACTION_DATE,syn_date, etl_date, source_system, so_luong )
select 'APPS.FIN_PRODUCT_SERVICE_HLD_MTH' table_name ,2 as STATUS,to_date(${PRD_ID},'yyyyMMDD') as TRANSACTION_DATE, to_date(${PRD_ID},'yyyyMMDD')  syn_date, sysdate etl_date,'job_fin_product_service_hld_mth' source_syste, count(1) so_luong
from APPS.FIN_PRODUCT_SERVICE_HLD_MTH
 </sql>
