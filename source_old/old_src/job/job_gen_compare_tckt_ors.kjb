      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>
INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'COMPARE/${TABLE_NAME_TCKT}' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  1 so_luong,
  'tckt_minio/batch/job/etl_job_compare_tckt_ors' SOURCE_SYSTEM
FROM
  dual</sql>
