    <entry>
      <name>syn_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
select 'FIN_TRANS_INT_ADJUST_DAILY',1,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd'))  ,
so_luong,'job_fin_trans_int_adjust_daily'
from (select count(*) so_luong from 
apps.FIN_TRANS_INT_ADJUST_DAILY a
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')) a</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
