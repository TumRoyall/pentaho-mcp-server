    <entry>
      <name>chay SSQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>delete from apps.mb_rep_mvmt_interest_m
where transaction_date = to_date(${PRD_ID},'yyyyMMdd');
commit;
insert into apps.mb_rep_mvmt_interest_m
(MAKH,PL_CATEG,SCT,GL,CN,AMT,amt_vnd,NTE,TRANS_CODE,
LINE_T24,SECTOR,KHOI,PRODUCT_CODE,transaction_date)
select 
MAKH,
PL_CATEG,
SCT,
GL,
CN,
sum(amt) AMT,
sum(amt_vnd) amt_vnd,
NTE,
TRANS_CODE,
LINE_T24,
SECTOR,
KHOI,
PRODUCT_CODE,
last_day(transaction_date) transaction_date
from etl.MB_int_mvmt_interest_m
where transaction_date between trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'MONTH') and to_date('${PRD_ID}', 'YYYYMMDD')
group by MAKH,PL_CATEG,SCT,GL,CN,NTE,TRANS_CODE,
LINE_T24,SECTOR,KHOI,PRODUCT_CODE,last_day(transaction_date);
commit;
update apps.mb_rep_mvmt_interest_m
set khoi =
case
when sector >= 1910 and sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1910 and sector &lt;= 1969 then 'INDIV'
when sector >= 1970 and sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1970 and sector &lt;= 1979 then 'CIB'
when sector >= 1980 and sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and (gl = '7020' or pl_categ = '52430')
and apps.fn_map_sector(sector)= 'NHS';

update apps.mb_rep_mvmt_interest_m
set khoi = 'NHS'
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and gl = '7020'
and pl_categ = '52795'
and apps.fn_map_sector(sector)= 'NHS';

update apps.mb_rep_mvmt_interest_m
set khoi = 'NHS'
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and gl = '8010'
and product_code = '11219';

update apps.mb_rep_mvmt_interest_m
set khoi = 'NHS'
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and pl_categ &lt;&gt; '67010'
and gl = '8010'
and apps.fn_map_sector(sector)= 'NHS'
and product_code in ('11111', '11141');

update apps.mb_rep_mvmt_interest_m
set khoi =
case
when sector >= 1910 and sector &lt;= 1969 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1910 and sector &lt;= 1969 then 'INDIV'
when sector >= 1970 and sector &lt;= 1979 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1970 and sector &lt;= 1979 then 'CIB'
when sector >= 1980 and sector &lt;= 1999 and product_code in (select product_code from etl.etl_nhs_product_code)
then 'NHS'
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and gl = '8010'
and apps.fn_map_sector(sector)= 'NHS'
and product_code not in ('11111', '11141', '11219');
commit;
update apps.mb_rep_mvmt_interest_m 
set khoi = 'NHS' 
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
and gl = '7020' 
and pl_categ = '52796';</sql>
