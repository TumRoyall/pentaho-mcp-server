    <entry>
      <name>ins log tckt</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  upper('ors/mb_int_mvmt_interest_m') TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  1 SO_LUONG,
  'tckt_repo/etl_job/etl_job_pilot_mvmt_interest_m' SOURCE_SYSTEM
FROM
  dual</sql>
