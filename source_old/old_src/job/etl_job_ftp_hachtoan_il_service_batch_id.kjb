    <entry>
      <name>ghi log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO APPS.SYN_LOG (TABLE_NAME, STATUS, TRANSACTION_DATE, SYN_DATE, ETL_DATE, SOURCE_SYSTEM)
values ('etl_job_ftp_hachtoan_dieuchinh', 1, to_date('${PRD_ID}', 'yyyyMMdd'), to_date('${PRD_ID}', 'yyyyMMdd'), sysdate, 'etl_job_ftp_hachtoan_il_service_batch_id');

</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
