      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>N</is_usevars>
      <custom_sql>SELECT *
FROM ETL.ETL_PUT_NOTIFY_TOKEN t
WHERE t.EXPIRED_DATE >= SYSDATE
