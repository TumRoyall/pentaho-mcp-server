      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE ETL.ETL_JOB_LOGS
   SET TO_DATE = SYSDATE,
       STATE = 1,
       MSG_ERROR = '${MSG_ERROR}',
       LAST_UPDATE_DATE = SYSDATE
 WHERE ETL_JOB_LOGS_ID = (
   SELECT MAX(ETL_JOB_LOGS_ID)
   FROM ETL.ETL_JOB_LOGS
   WHERE UNIKEY_ID = '${UNIKEY_ID}'
 );

COMMIT;</sql>
