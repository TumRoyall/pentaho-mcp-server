      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO ETL.ETL_JOB_LOGS (
    UNIKEY_ID,
    CHANNEL,
    NODE,
    JOB_NAME,
    PARAMETERS,
    FROM_DATE,
    STATE,
    CREATE_DATE,
    LAST_UPDATE_DATE
)
VALUES (
    '${UNIKEY_ID}',   
    '${CHANNEL}',                                -- CHANNEL 
    '${NODE}',                                   -- NODE/IP 
    '${JOB_NAME}',                               -- tên job
    '${PARAMETERS}',                          -- tham s job
    SYSDATE,                                     -- FROM_DATE 
    2,                                           -- STATE (2=running, 1=fail, 0 = success)
    SYSDATE,                                     -- CREATE_DATE
    SYSDATE                                      -- LAST_UPDATE_DATE
);

COMMIT;</sql>
