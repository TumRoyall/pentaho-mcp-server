      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM,
	NOTE
  )
SELECT
  'TMP_THU_CHI_SONGPHUONG' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  count(1) SO_LUONG,
  'tckt_repo/etl_job/job_tmp_thu_chi_songphuong' SOURCE_SYSTEM,
  '${NOTE}' NOTE
FROM
  ETL.TMP_THU_CHI_SONGPHUONG</sql>
