    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'FIN_SECONDARY_CD_SMY_MONTHLY' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  count(1) SO_LUONG,
  'TCKT_REPO/etl_job/etl_job_FIN_SECONDARY_CD_SMY_MONTHLY' SOURCE_SYSTEM
FROM
  APPS.FIN_SECONDARY_CD_SMY_MONTHLY
  WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>672</xloc>
      <yloc>561</yloc>
      <attributes_kjc/>
    </entry>
