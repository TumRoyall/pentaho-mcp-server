    <entry>
      <name>ins syn log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM,
    NOTE
  )
SELECT
  '${TARGET_TABLE_SCHEMA}.FIN_TOI_RWA_CR_MONTHLY' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'job_fin_toi_rwa_cr_monthly' SOURCE_SYSTEM,
  '${NOTE}' NOTE
FROM
  ${TARGET_TABLE_SCHEMA}.FIN_TOI_RWA_CR_MONTHLY
  WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')

</sql>
