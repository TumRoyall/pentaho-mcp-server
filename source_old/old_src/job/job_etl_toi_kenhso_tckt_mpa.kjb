    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>drop table etl.PNL_KENHSO_MONTHLY_tmp purge; 
create table etl.PNL_KENHSO_MONTHLY_tmp as
SELECT a.TRANSACTION_DATE,
      a.CN MA_CN,
      a.MAKH,
      case
          when a.SPSO_TYPE = 'KDNT' then a.KHOI_KH
          else a.KHOI_TRUOCCHIASE
      end khoi_plkhoi,
      a.PHAN_KHUC,
      a.PRODUCT_CODE,
      a.CHITIEU_PLKHOI,
      a.CHITIEU_PLKHOI_NAME,
      a.LINEGL,
      PRODUCT_TYPE ||
      CASE
         WHEN b.CHANNEL = 'I0' THEN '_GN_OFFLINE'
         WHEN b.CHANNEL = 'IC' AND b.ma_bpm is null THEN '_GN_ONLINE'
         WHEN b.CHANNEL = 'IC' AND b.ma_bpm is not null THEN '_GN_ONLINE_BPM'
      END KENH,
      sum(AMT_SAUCHIASE) TIENNO_VND,
      c.MA_CHITIEU_TOI MACHITIEU,
      c.TEN_CHITIEU_TOI CHITIEU,
      a.khoi_kh khoi
   FROM apps.FIN_PNL_KENHSO_MONTHLY partition for (to_date(${PRD_ID}, 'YYYYMMDD')) a
   LEFT JOIN ETL.ODS_T24_LD_LOANS_AND_DEPOSITS b
      ON a.SOTK = b.ID
   LEFT JOIN etl.FILE_RPT_PNL_KENHSO_MAP c
      ON a.CHITIEU_PLKHOI_NAME = c.PL_LINE
   WHERE a.PRODUCT_TYPE is not null
   group by a.TRANSACTION_DATE,
      a.CN,
      a.MAKH,
      case
          when a.SPSO_TYPE = 'KDNT' then a.KHOI_KH
          else a.KHOI_TRUOCCHIASE
      end,
      a.PHAN_KHUC,
      a.PRODUCT_CODE,
      a.CHITIEU_PLKHOI,
      a.CHITIEU_PLKHOI_NAME,
      a.LINEGL,
      PRODUCT_TYPE ||
      CASE
         WHEN b.CHANNEL = 'I0' THEN '_GN_OFFLINE'
         WHEN b.CHANNEL = 'IC' AND b.ma_bpm is null THEN '_GN_ONLINE'
         WHEN b.CHANNEL = 'IC' AND b.ma_bpm is not null THEN '_GN_ONLINE_BPM'
      END,
      c.MA_CHITIEU_TOI,
      c.TEN_CHITIEU_TOI,
      a.khoi_kh</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1136</xloc>
      <yloc>192</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>SQL 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>create table etl.PNL_KENHSO_MONTHLY_tmp_step2 as
select TRANSACTION_DATE,
        MA_CN,
        MAKH,
        KHOI,
        KHOI_PLKHOI,
        PHAN_KHUC CUS_STATUS,
        PRODUCT_CODE,
        KENH,
        sum(case when MACHITIEU = 'A1' then TIENNO_VND else 0 end) as THULAI_TINDUNG_A1 ,
        sum(case when MACHITIEU = 'A2' then TIENNO_VND else 0 end) as THU_LAI_KHAC_A2,
        sum(case when MACHITIEU = 'A3' then TIENNO_VND else 0 end) as THULAI_TRAIPHIEU_A3,
        sum(case when MACHITIEU = 'B1' then TIENNO_VND else 0 end) as CHIFTP_TINDUNG_B1,
        sum(case when MACHITIEU = 'B2' then TIENNO_VND else 0 end) as CHIFTP_KHAC_B2,
        sum(case when MACHITIEU = 'B3' then TIENNO_VND else 0 end) as CHIFTP_TRAIPHIEU_B3,
        sum(case when MACHITIEU = 'B41' then TIENNO_VND else 0 end) as THUFTP_DUPHONGTD_B4,
        sum(case when MACHITIEU = 'B32' then TIENNO_VND else 0 end) THUFTP_DUPHONGKHAC_B3,
        sum(case when MACHITIEU = 'B42' then TIENNO_VND else 0 end) as THUFTP_DUPHONGTP_B4,
        sum(case when MACHITIEU = 'C1' then TIENNO_VND else 0 end) as CHILAI_HUYDONG_C1,
        sum(case when MACHITIEU = 'C2' then TIENNO_VND else 0 end) as CHILAI_KHAC_C2,
        sum(case when MACHITIEU = 'C3' then TIENNO_VND else 0 end) as CHILAI_TRAIPHIEU_C3,
        sum(case when MACHITIEU = 'D1' then TIENNO_VND else 0 end) as THUFTP_HUYDONG_D1,
        sum(case when MACHITIEU = 'D2' then TIENNO_VND else 0 end) as THUFTP_KHAC_D2,
        sum(case when MACHITIEU = 'E1' then TIENNO_VND else 0 end) as DV_BAOLANH_E1, 
        sum(case when MACHITIEU = 'E2' then TIENNO_VND else 0 end) as DV_TTQT_E2,
        sum(case when MACHITIEU = 'E3' then TIENNO_VND else 0 end) as DV_TTTN_E3,
        sum(case when MACHITIEU = 'E4' then TIENNO_VND else 0 end) as DV_THE_E4,
        sum(case when MACHITIEU = 'E5' then TIENNO_VND else 0 end) as DV_UTBHCK_E5,
        sum(case when MACHITIEU = 'E6' then TIENNO_VND else 0 end) as DV_TUVAN_E6,
        sum(case when MACHITIEU = 'E7' then TIENNO_VND else 0 end) as DV_NGANQUY_E7,
        sum(case when MACHITIEU = 'E8' then TIENNO_VND else 0 end) as DV_GIUHO_E8,
        sum(case when MACHITIEU = 'E9' then TIENNO_VND else 0 end) as DV_KIEUHOI_E9,
        sum(case when MACHITIEU = 'E10' then TIENNO_VND else 0 end) as DV_NHDT_E10,
        sum(case when MACHITIEU = 'E131' then TIENNO_VND else 0 end) as DV_COMMO_E13,
        sum(case when MACHITIEU = 'E132' then TIENNO_VND else 0 end) as DV_KHAC_E13,
        sum(case when MACHITIEU = 'E14' then TIENNO_VND else 0 end) as FX_NTE_E14,
        sum(case when MACHITIEU = 'E15' then TIENNO_VND else 0 end) as DTK_THU_E15,
        sum(case when MACHITIEU = 'E16' then TIENNO_VND else 0 end) as DTK_CHIFTP_E16,
        sum(case when MACHITIEU = 'E17' then TIENNO_VND else 0 end) as BT_KHAC_E17,
        sum(case when MACHITIEU = 'E18' then TIENNO_VND else 0 end) as BT_XLN_E18,
        sum(case when MACHITIEU = 'F1' then TIENNO_VND else 0 end) as DP_DAUTU_F1,
        sum(case when MACHITIEU = 'F2' then TIENNO_VND else 0 end) as DP_LC_F2,
        sum(case when MACHITIEU = 'F3' then TIENNO_VND else 0 end) as DP_BL_F3,
        sum(case when MACHITIEU = 'F4' then TIENNO_VND else 0 end) as DP_TD_F4,
        sum(case when MACHITIEU = 'F5' then TIENNO_VND else 0 end) as DP_K,
        0 TOI_CSTD,
        0 CHILAI_FTP_TINDUNG_K1,
        0 CHIFTP_KHAC_K2,
        0 CHIFTP_TRAIPHIEU_K3,
        0 THULAI_FTP_M1,
        0 THUFTP_KHAC_M2,
        sum(case when MACHITIEU = 'E14' then TIENNO_VND else 0 end) as FX_NTE_E14A,
        0 THUFTP_DUPHONGTD_K4
    from etl.PNL_KENHSO_MONTHLY_tmp
    group by TRANSACTION_DATE,
        MA_CN,
        MAKH,
        KHOI,
        KHOI_PLKHOI,
        PHAN_KHUC,
        PRODUCT_CODE,
        KENH</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1136</xloc>
      <yloc>272</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>SQL 3</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>drop table etl.TMP_TOI_KENHSO_MONTHLY purge;
create table etl.TMP_TOI_KENHSO_MONTHLY as
SELECT a.TRANSACTION_DATE,
    a.MA_CN,
    a.MAKH,
    a.KHOI_PLKHOI KHOI,
    a.CUS_STATUS,
    a.PRODUCT_CODE,
    a.kenh,
    (
        NVL(a.THULAI_TINDUNG_A1, 0) + NVL(a.THU_LAI_KHAC_A2, 0) + NVL(a.THULAI_TRAIPHIEU_A3, 0)
    ) + (
        NVL(a.CHIFTP_TINDUNG_B1, 0) + NVL(a.CHIFTP_KHAC_B2, 0) + NVL(a.CHIFTP_TRAIPHIEU_B3, 0) + NVL(a.THUFTP_DUPHONGTD_B4, 0) + NVL(a.THUFTP_DUPHONGKHAC_B3, 0) + NVL(a.THUFTP_DUPHONGTP_B4, 0)
    ) + (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) + (
        NVL(a.THUFTP_HUYDONG_D1, 0) + NVL(a.THUFTP_KHAC_D2, 0)
    ) + (
        NVL(a.DV_BAOLANH_E1, 0) + NVL(a.DV_TTQT_E2, 0) + NVL(a.DV_TTTN_E3, 0) + NVL(a.DV_THE_E4, 0) + NVL(a.DV_UTBHCK_E5, 0) + NVL(a.DV_TUVAN_E6, 0) + NVL(a.DV_NGANQUY_E7, 0) + NVL(a.DV_GIUHO_E8, 0) + NVL(a.DV_KIEUHOI_E9, 0) + NVL(a.DV_NHDT_E10, 0) + NVL(a.DV_COMMO_E13, 0) + NVL(a.DV_KHAC_E13, 0) + NVL(a.FX_NTE_E14, 0) + NVL(a.DTK_THU_E15, 0) + NVL(a.DTK_CHIFTP_E16, 0) + NVL(a.BT_KHAC_E17, 0) + NVL(a.BT_XLN_E18, 0)
    ) AS DTTTRR_I,
    (
        NVL(a.THULAI_TINDUNG_A1, 0) + NVL(a.THU_LAI_KHAC_A2, 0) + NVL(a.THULAI_TRAIPHIEU_A3, 0)
    ) + (
        NVL(a.CHIFTP_TINDUNG_B1, 0) + NVL(a.CHIFTP_KHAC_B2, 0) + NVL(a.CHIFTP_TRAIPHIEU_B3, 0) + NVL(a.THUFTP_DUPHONGTD_B4, 0) + NVL(a.THUFTP_DUPHONGKHAC_B3, 0) + NVL(a.THUFTP_DUPHONGTP_B4, 0)
    ) + (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) + (
        NVL(a.THUFTP_HUYDONG_D1, 0) + NVL(a.THUFTP_KHAC_D2, 0)
    ) AS THU_LAI_THUAN,
    (
        NVL(a.THULAI_TINDUNG_A1, 0) + NVL(a.THU_LAI_KHAC_A2, 0) + NVL(a.THULAI_TRAIPHIEU_A3, 0)
    ) AS THULAI_KH_A,
    (
        NVL(a.CHIFTP_TINDUNG_B1, 0) + NVL(a.CHIFTP_KHAC_B2, 0) + NVL(a.CHIFTP_TRAIPHIEU_B3, 0) + NVL(a.THUFTP_DUPHONGTD_B4, 0) + NVL(a.THUFTP_DUPHONGKHAC_B3, 0) + NVL(a.THUFTP_DUPHONGTP_B4, 0)
    ) AS CHILAI_FTP_B,
    (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) AS CHILAI_KH_C,
    (
        NVL(a.THUFTP_HUYDONG_D1, 0) + NVL(a.THUFTP_KHAC_D2, 0)
    ) AS THULAI_FTP_D,
    (
        NVL(a.DV_BAOLANH_E1, 0) + NVL(a.DV_TTQT_E2, 0) + NVL(a.DV_TTTN_E3, 0) + NVL(a.DV_THE_E4, 0) + NVL(a.DV_UTBHCK_E5, 0) + NVL(a.DV_TUVAN_E6, 0) + NVL(a.DV_NGANQUY_E7, 0) + NVL(a.DV_GIUHO_E8, 0) + NVL(a.DV_KIEUHOI_E9, 0) + NVL(a.DV_NHDT_E10, 0) + NVL(a.DV_COMMO_E13, 0) + NVL(a.DV_KHAC_E13, 0) + NVL(a.FX_NTE_E14, 0) + NVL(a.DTK_THU_E15, 0) + NVL(a.DTK_CHIFTP_E16, 0) + NVL(a.BT_KHAC_E17, 0) + NVL(a.BT_XLN_E18, 0)
    ) AS THU_NGOAI_LAI_E,
    (
        nvl(a.DP_DAUTU_F1, 0) + nvl(a.DP_LC_F2, 0) + nvl(a.DP_BL_F3, 0) + nvl(a.DP_TD_F4, 0) + nvl(a.DP_K, 0)
    ) AS CHI_DP_F,
    a.THULAI_TINDUNG_A1,
    a.THU_LAI_KHAC_A2,
    a.THULAI_TRAIPHIEU_A3,
    a.CHIFTP_TINDUNG_B1,
    a.CHIFTP_KHAC_B2,
    a.CHIFTP_TRAIPHIEU_B3,
    a.THUFTP_DUPHONGTD_B4,
    a.THUFTP_DUPHONGKHAC_B3,
    a.THUFTP_DUPHONGTP_B4,
    a.CHILAI_HUYDONG_C1,
    a.CHILAI_KHAC_C2,
    a.CHILAI_TRAIPHIEU_C3,
    a.THUFTP_HUYDONG_D1,
    a.THUFTP_KHAC_D2,
    a.DV_BAOLANH_E1,
    a.DV_TTQT_E2,
    a.DV_TTTN_E3,
    a.DV_THE_E4,
    a.DV_UTBHCK_E5,
    a.DV_TUVAN_E6,
    a.DV_NGANQUY_E7,
    a.DV_GIUHO_E8,
    a.DV_KIEUHOI_E9,
    a.DV_NHDT_E10,
    a.DV_COMMO_E13,
    a.DV_KHAC_E13,
    a.FX_NTE_E14,
    a.DTK_THU_E15,
    a.DTK_CHIFTP_E16,
    a.BT_KHAC_E17,
    a.BT_XLN_E18,
    a.DP_DAUTU_F1,
    a.DP_LC_F2,
    a.DP_BL_F3,
    a.DP_TD_F4,
    a.DP_K,
    (nvl(a.THULAI_FTP_M1, 0) + nvl(a.THUFTP_KHAC_M2, 0)) + (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) + (
        Nvl(a.CHILAI_FTP_TINDUNG_K1, 0) + nvl(a.CHIFTP_KHAC_K2, 0) + nvl(a.CHIFTP_TRAIPHIEU_K3, 0) + nvl(a.thuftp_duphongtd_k4, 0)
    ) + (
        NVL(THULAI_TINDUNG_A1, 0) + NVL(THU_LAI_KHAC_A2, 0) + NVL(THULAI_TRAIPHIEU_A3, 0)
    ) + (
        NVL(a.DV_BAOLANH_E1, 0) + NVL(a.DV_TTQT_E2, 0) + NVL(a.DV_TTTN_E3, 0) + NVL(a.DV_THE_E4, 0) + NVL(a.DV_UTBHCK_E5, 0) + NVL(a.DV_TUVAN_E6, 0) + NVL(a.DV_NGANQUY_E7, 0) + NVL(a.DV_GIUHO_E8, 0) + NVL(a.DV_KIEUHOI_E9, 0) + NVL(a.DV_NHDT_E10, 0) + NVL(a.DV_COMMO_E13, 0) + NVL(a.DV_KHAC_E13, 0) + NVL(a.FX_NTE_E14, 0) + NVL(a.DTK_THU_E15, 0) + NVL(a.DTK_CHIFTP_E16, 0) + NVL(a.BT_KHAC_E17, 0) + NVL(a.BT_XLN_E18, 0)
    ) AS DTTTRR_P,
    (
        NVL(a.DV_BAOLANH_E1, 0) + NVL(a.DV_TTQT_E2, 0) + NVL(a.DV_TTTN_E3, 0) + NVL(a.DV_THE_E4, 0) + NVL(a.DV_UTBHCK_E5, 0) + NVL(a.DV_TUVAN_E6, 0) + NVL(a.DV_NGANQUY_E7, 0) + NVL(a.DV_GIUHO_E8, 0) + NVL(a.DV_KIEUHOI_E9, 0) + NVL(a.DV_NHDT_E10, 0) + NVL(a.DV_COMMO_E13, 0) + NVL(a.DV_KHAC_E13, 0) + NVL(a.FX_NTE_E14, 0) + NVL(a.DTK_THU_E15, 0) + NVL(a.DTK_CHIFTP_E16, 0) + NVL(a.BT_KHAC_E17, 0) + NVL(a.BT_XLN_E18, 0)
    ) AS thu_ngoai_lai_o,
    (nvl(a.THULAI_FTP_M1, 0) + nvl(a.THUFTP_KHAC_M2, 0)) AS THULAI_FTP_M,
    (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) AS CHILAI_KH_L,
    (
        Nvl(a.CHILAI_FTP_TINDUNG_K1, 0) + nvl(a.CHIFTP_KHAC_K2, 0) + nvl(a.CHIFTP_TRAIPHIEU_K3, 0) + nvl(a.thuftp_duphongtd_k4, 0)
    ) AS CHILAI_FTP_K,
    (
        NVL(THULAI_TINDUNG_A1, 0) + NVL(THU_LAI_KHAC_A2, 0) + NVL(THULAI_TRAIPHIEU_A3, 0)
    ) AS THULAI_KH_J,
    (nvl(a.THULAI_FTP_M1, 0) + nvl(a.THUFTP_KHAC_M2, 0)) + (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) + (
        Nvl(a.CHILAI_FTP_TINDUNG_K1, 0) + nvl(a.CHIFTP_KHAC_K2, 0) + nvl(a.CHIFTP_TRAIPHIEU_K3, 0) + nvl(a.thuftp_duphongtd_k4, 0)
    ) + (
        NVL(THULAI_TINDUNG_A1, 0) + NVL(THU_LAI_KHAC_A2, 0) + NVL(THULAI_TRAIPHIEU_A3, 0)
    ) AS THULAITHUAN_N,
    a.CHILAI_FTP_TINDUNG_K1,
    a.CHIFTP_KHAC_K2,
    a.CHIFTP_TRAIPHIEU_K3,
    a.THULAI_FTP_M1,
    a.THUFTP_KHAC_M2,
    a.FX_NTE_E14A,
    (
        NVL(a.THULAI_TINDUNG_A1, 0) + NVL(a.THU_LAI_KHAC_A2, 0) + NVL(a.THULAI_TRAIPHIEU_A3, 0)
    ) + (
        NVL(a.CHIFTP_TINDUNG_B1, 0) + NVL(a.CHIFTP_KHAC_B2, 0) + NVL(a.CHIFTP_TRAIPHIEU_B3, 0) + NVL(a.THUFTP_DUPHONGTD_B4, 0) + NVL(a.THUFTP_DUPHONGKHAC_B3, 0) + NVL(a.THUFTP_DUPHONGTP_B4, 0)
    ) + (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) + (
        NVL(a.THUFTP_HUYDONG_D1, 0) + NVL(a.THUFTP_KHAC_D2, 0)
    ) + (
        NVL(a.DV_BAOLANH_E1, 0) + NVL(a.DV_TTQT_E2, 0) + NVL(a.DV_TTTN_E3, 0) + NVL(a.DV_THE_E4, 0) + NVL(a.DV_UTBHCK_E5, 0) + NVL(a.DV_TUVAN_E6, 0) + NVL(a.DV_NGANQUY_E7, 0) + NVL(a.DV_GIUHO_E8, 0) + NVL(a.DV_KIEUHOI_E9, 0) + NVL(a.DV_NHDT_E10, 0) + NVL(a.DV_COMMO_E13, 0) + NVL(a.DV_KHAC_E13, 0) + NVL(a.FX_NTE_E14, 0) + NVL(a.DTK_THU_E15, 0) + NVL(a.DTK_CHIFTP_E16, 0) + NVL(a.BT_KHAC_E17, 0) + NVL(a.BT_XLN_E18, 0)
    ) + (
        nvl(a.DP_DAUTU_F1, 0) + nvl(a.DP_LC_F2, 0) + nvl(a.DP_BL_F3, 0) + nvl(a.DP_TD_F4, 0) + nvl(a.DP_K, 0)
    ) AS DTTSRR_I,
    (nvl(a.THULAI_FTP_M1, 0) + nvl(a.THUFTP_KHAC_M2, 0)) + (
        NVL(a.CHILAI_HUYDONG_C1, 0) + NVL(a.CHILAI_KHAC_C2, 0) + NVL(a.CHILAI_TRAIPHIEU_C3, 0)
    ) + (
        Nvl(a.CHILAI_FTP_TINDUNG_K1, 0) + nvl(a.CHIFTP_KHAC_K2, 0) + nvl(a.CHIFTP_TRAIPHIEU_K3, 0) + nvl(a.thuftp_duphongtd_k4, 0)
    ) + (
        NVL(THULAI_TINDUNG_A1, 0) + NVL(THU_LAI_KHAC_A2, 0) + NVL(THULAI_TRAIPHIEU_A3, 0)
    ) + (
        NVL(a.DV_BAOLANH_E1, 0) + NVL(a.DV_TTQT_E2, 0) + NVL(a.DV_TTTN_E3, 0) + NVL(a.DV_THE_E4, 0) + NVL(a.DV_UTBHCK_E5, 0) + NVL(a.DV_TUVAN_E6, 0) + NVL(a.DV_NGANQUY_E7, 0) + NVL(a.DV_GIUHO_E8, 0) + NVL(a.DV_KIEUHOI_E9, 0) + NVL(a.DV_NHDT_E10, 0) + NVL(a.DV_COMMO_E13, 0) + NVL(a.DV_KHAC_E13, 0) + NVL(a.FX_NTE_E14, 0) + NVL(a.DTK_THU_E15, 0) + NVL(a.DTK_CHIFTP_E16, 0) + NVL(a.BT_KHAC_E17, 0) + NVL(a.BT_XLN_E18, 0)
    ) + (
        nvl(a.DP_DAUTU_F1, 0) + nvl(a.DP_LC_F2, 0) + nvl(a.DP_BL_F3, 0) + nvl(a.DP_TD_F4, 0) + nvl(a.DP_K, 0)
    ) AS DTTSRR_P,
    a.thuftp_duphongtd_k4,
    0 THULAI_BANNO,
    0 CHIFTP_BANNO
FROM etl.PNL_KENHSO_MONTHLY_tmp_step2  a
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>1136</xloc>
      <yloc>352</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>SQL 4</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>--drop table etl.PNL_KENHSO_MONTHLY_tmp_step3 purge; 
create table etl.PNL_KENHSO_MONTHLY_tmp_step3 as
   select transaction_date,
 MA_CN,
 CAST(makh AS VARCHAR2(50)) makh,
 khoi,
 CUS_STATUS,
 CAST(PRODUCT_CODE AS VARCHAR2(50)) PRODUCT_CODE,
 'OFFLINE' KENH,
 DTTTRR_I,
 THU_LAI_THUAN,
 THULAI_KH_A,
 CHILAI_FTP_B,
 CHILAI_KH_C,
 THULAI_FTP_D,
 THU_NGOAI_LAI_E,
 CHI_DP_F,
 THULAI_TINDUNG_A1,
 THU_LAI_KHAC_A2,
