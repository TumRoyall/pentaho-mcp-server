    <entry>
      <name>insert syn log for tables</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
SELECT 'ETL.ODS_CAL_CRB_BAL_MUANO' TABLE_NAME , 1 STATUS , TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) SYN_DATE, SYSDATE ETL_DATE ,TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) TRANSACTION_DATE ,
COUNT(*) SO_LUONG,'job_ftp_crb_bal_daily' SOURCE_SYSTEM FROM ETL.ODS_CAL_CRB_BAL_MUANO 
UNION ALL
SELECT 'ETL.ODS_CAL_CRB_BAL_THE_TRATRUOC' TABLE_NAME , 1 STATUS , TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) SYN_DATE, SYSDATE ETL_DATE ,TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) TRANSACTION_DATE ,
COUNT(*) SO_LUONG,'job_ftp_crb_bal_daily' SOURCE_SYSTEM FROM ETL.ODS_CAL_CRB_BAL_THE_TRATRUOC
UNION ALL
SELECT 'ETL.ODS_CAL_FTP_TIENMAT' TABLE_NAME , 1 STATUS , TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) SYN_DATE, SYSDATE ETL_DATE ,TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) TRANSACTION_DATE ,
COUNT(*) SO_LUONG,'job_ftp_crb_bal_daily' SOURCE_SYSTEM FROM ETL.ODS_CAL_FTP_TIENMAT
UNION ALL
SELECT 'ETL.CDT_CARD_BAL_PRI_INT_FEE' TABLE_NAME , 1 STATUS , TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) - 1 SYN_DATE, SYSDATE ETL_DATE ,TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) - 1 TRANSACTION_DATE ,
COUNT(*) SO_LUONG,'job_ftp_crb_bal_daily' SOURCE_SYSTEM FROM ETL.CDT_CARD_BAL_PRI_INT_FEE</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
