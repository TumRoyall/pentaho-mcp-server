    <entry>
      <name>insert syn log for job success</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,so_luong,source_system)
SELECT 'FRP_CRB_BAL_DAILY' TABLE_NAME , 1 STATUS , TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) SYN_DATE, SYSDATE ETL_DATE ,TRUNC(TO_DATE('${PRD_ID}','yyyyMMdd')) TRANSACTION_DATE ,
1 SO_LUONG,'job_ftp_crb_bal_daily' SOURCE_SYSTEM FROM DUAL</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>528</xloc>
