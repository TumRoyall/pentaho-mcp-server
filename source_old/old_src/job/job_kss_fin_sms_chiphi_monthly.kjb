    <entry>
      <name>SQL</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'APPS.FIN_SMS_CHIPHI_MONTHLY' TABLE_NAME,
  '1' STATUS,
  trunc(sysdate) TRANSACTION_DATE,
  trunc(sysdate) SYN_DATE,
  SYSDATE ETL_DATE,
  COUNT(1) SO_LUONG,
  'job_kss_fin_sms_chiphi_monthly' SOURCE_SYSTEM
FROM
  apps.FIN_SMS_CHIPHI_MONTHLY
where transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
--where ${COLM_DEL} = TO_DATE('${DATE_}', 'YYYYMMDD')</sql>
