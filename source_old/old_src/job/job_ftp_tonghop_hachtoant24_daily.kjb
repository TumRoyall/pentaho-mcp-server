      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO ETL.ETL_JOB_RUNNING (
    UNIKEY_ID,
    CHANNEL,
    NODE,
    JOB_NAME,
    PARAMETERS,
    CREATE_DATE
)
VALUES (
    '${UNIKEY_ID}',   
    '${CHANNEL}',                                
    '${NODE}',                                   
    '${JOB_NAME}',                               
    '${PARAMETERS}',         				
    SYSDATE                                                                                               
);

COMMIT;</sql>
