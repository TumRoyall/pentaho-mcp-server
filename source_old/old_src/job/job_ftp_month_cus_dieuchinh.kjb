      <type>SQL</type>
      <attributes/>
      <sql>insert into apps.syn_log
(table_name, status, syn_date, etl_date,transaction_date,source_system,so_luong)
select upper('manual_tr_ftp_cus_dieuchinh'),3,trunc(to_date(${PRD_ID},'yyyyMMdd')), sysdate ,trunc(to_date(${PRD_ID},'yyyyMMdd')),'etl_job_ftp_month_cus_dieuchinh'
,count(*) 
from apps.tr_ftp_cus_dieuchinh
where transaction_date = to_date(${PRD_ID},'yyyyMMdd')
</sql>
