    <entry>
      <name>Update product code 2</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>-- update cho product_code cho trai phieu
/*
Anhlv6 bo doan code nay theo y.c YCPT-19707
update apps.tr_ftp_cus_dieuchinh t
set t.product_code = '74331'
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and t.line_gl in ('666610','666810')
and t.product_code is null;

commit;
*/
-- update khoi cho NHS
update apps.tr_ftp_cus_dieuchinh
set khoi = 'NHS'
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPS1', 'DVS1'));


update apps.tr_ftp_cus_dieuchinh
set khoi = 'NHS'
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and apps.fn_map_sector(sector)= 'NHS'
and product_code in ('11111', '11141');

update apps.tr_ftp_cus_dieuchinh
set khoi =
case
when sector >= 1910 and sector &lt;= 1969 and 
product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPSO', 'DVSO'))

then 'NHS'
when sector >= 1910 and sector &lt;= 1969 then 'INDIV'
when sector >= 1970 and sector &lt;= 1979 and 
product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPSO', 'DVSO'))
then 'NHS'
when sector >= 1970 and sector &lt;= 1979 then 'CIB'
when sector >= 1980 and sector &lt;= 1999 and 
product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPSO', 'DVSO'))
then 'NHS'
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and apps.fn_map_sector(sector)= 'NHS'
and substr (product_code,1,2) in ('11', '12', '13')
and product_code not in ('11111', '11141', '11219');

update apps.tr_ftp_cus_dieuchinh
set khoi =
case
when sector >= 1910 and sector &lt;= 1969 and 
product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPSO', 'DVSO'))
then 'NHS'
when sector >= 1910 and sector &lt;= 1969 then 'INDIV'
when sector >= 1970 and sector &lt;= 1979 and 
product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPSO', 'DVSO'))
then 'NHS'
when sector >= 1970 and sector &lt;= 1979 then 'CIB'
when sector >= 1980 and sector &lt;= 1999 and 
product_code in (select product_code from apps.mb_product_code where SP_DV in ('SPSO', 'DVSO'))
then 'NHS'
when sector >= 1980 and sector &lt;= 1999 then 'SME' 
end
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and apps.fn_map_sector(sector)= 'NHS'
and substr (product_code,1,1) in ('2', '5');
;

-- upate khoi theo line_gl
update apps.tr_ftp_cus_dieuchinh t
set khoi = 'INDIV'
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and t.line_gl='666900';
update apps.tr_ftp_cus_dieuchinh t
set khoi = 'NHS'
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and t.line_gl='668511';
commit;


-- update cho product_code cho trai phieu
/*
Anhlv6 bo doan code nay theo y.c YCPT-19707
update apps.tr_ftp_cus_dieuchinh t
set t.product_code = '74331'
where transaction_date = to_date('${PRD_ID}','yyyyMMdd')
and t.line_gl in ('666610','666810')
and t.product_code is null;

commit;
*/

</sql>
