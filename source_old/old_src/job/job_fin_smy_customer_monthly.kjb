      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>select distinct table_name 
from etl.syn_log
where upper(table_name) in (
	'SMY.CUST_SEGMENT_DAILY'
)
and syn_date = ( SELECT
    CASE
      WHEN WORKING_DATE_IND = 'H' THEN LAST_WORKING_DATE
      WHEN WORKING_DATE_IND = 'W' THEN CALENDAR_DATE
    END TXN_DATE
  FROM ods.DATES_REF
  WHERE CALENDAR_DATE = to_date('${PRD_ID}', 'YYYYMMDD'))</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
