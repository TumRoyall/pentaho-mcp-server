    <entry>
      <name>check log ods 2</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>ods_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_equal</success_condition>
