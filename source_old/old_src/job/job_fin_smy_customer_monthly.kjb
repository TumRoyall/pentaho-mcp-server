    <entry>
      <name>Check source dwh</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>stg_oth_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>/*SELECT JOB_NAME
	,  A.JOB_RUN_START_DATETIME
	, A.JOB_RUN_END_DATETIME
	, JOB_RUN_STATUS
FROM PRD_SOR..JOB_RUN_DETAIL a 
JOIN PRD_SOR..JOB_DETAIL b ON a.JOB_ID = b.JOB_ID 
WHERE a.DATA_DATE = '${PRD_ID}'
    AND a.JOB_RUN_STATUS = 'SUCCEEDED'
    AND b.JOB_NAME = 'CST_SEG_TVR'*/


SELECT B.JOB_NAME,A.* 
FROM MON.JOB_RUN_DETAIL A
JOIN MON.JOB_DETAIL B ON A.JOB_ID = B.JOB_ID 
WHERE B.JOB_NAME  IN ('CST_SEG_TVR'
)
AND A.ETL_DATE = TO_DATE('${PRD_ID}','YYYYMMDD')  --pDate: Ngày dữ liệu t-1
AND A.JOB_RUN_STATUS = 'SUCCEEDED'</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>N</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>800</xloc>
      <yloc>128</yloc>
      <attributes_kjc/>
