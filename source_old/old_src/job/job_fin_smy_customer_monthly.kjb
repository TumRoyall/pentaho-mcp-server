    <entry>
      <name>Insert log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO APPS.SYN_LOG
   (TABLE_NAME,
    STATUS,
    SYN_DATE,
    ETL_DATE,
    TRANSACTION_DATE,
    SO_LUONG,
    SOURCE_SYSTEM)
   SELECT 'APPS.FIN_SMY_CUSTOMER_MONTHLY'
         ,1
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,SYSDATE
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,COUNT(1)
         ,'etl_job_fin_smy_customer_monthly'
     FROM APPS.FIN_SMY_CUSTOMER_MONTHLY
    WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'yyyyMMdd')
   UNION ALL
   SELECT 'ETL.ORS_NHS_EMB_USER_KPI'
         ,1
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,SYSDATE
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,COUNT(1)
         ,'etl_job_fin_smy_customer_monthly'
     FROM ETL.ORS_NHS_EMB_USER_KPI
   UNION ALL
   SELECT 'ETL.ODS_APIGW_USER_QR_CFG'
         ,1
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,SYSDATE
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,COUNT(1)
         ,'etl_job_fin_smy_customer_monthly'
     FROM ETL.ODS_APIGW_USER_QR_CFG
   UNION ALL
   SELECT 'ETL.ORS_NHS_KPI_DEBIT_CARD_NOW'
         ,1
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,SYSDATE
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,COUNT(1)
         ,'etl_job_fin_smy_customer_monthly'
     FROM ETL.ORS_NHS_KPI_DEBIT_CARD_NOW
   UNION ALL
   SELECT 'ETL.ORS_NHS_KPI_CREDIT_CARD_NOW_TMP'
         ,1
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,SYSDATE
         ,TRUNC(TO_DATE('${PRD_ID}', 'yyyyMMdd'))
         ,COUNT(1)
         ,'etl_job_fin_smy_customer_monthly'
     FROM ETL.ORS_NHS_KPI_CREDIT_CARD_NOW_TMP
</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
