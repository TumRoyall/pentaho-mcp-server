    <entry>
      <name>syn_log co du lieu</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO APPS.SYN_LOG
(TABLE_NAME, STATUS, SYN_DATE, ETL_DATE,TRANSACTION_DATE,SOURCE_SYSTEM,SO_LUONG, NOTE)
SELECT UPPER('APPS.FIN_SMS_SMY_MONTHLY'),
1,
TO_DATE('${PRD_ID}','YYYYMMDD'), 
SYSDATE ,
TO_DATE('${PRD_ID}','YYYYMMDD'),
'${Internal.Job.Name}', 
count(1), 
'DAT LICH TREN JOE'
FROM APPS.FIN_SMS_SMY_MONTHLY WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}','YYYYMMDD')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>720</xloc>
