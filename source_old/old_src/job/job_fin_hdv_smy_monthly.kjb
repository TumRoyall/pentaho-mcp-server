  <entries>
    <entry>
      <name> move data to target table</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
    APPS.FIN_HDV_SMY_MONTHLY (
        transaction_date,
        SOTK,
        COA_CODE,
        MAKH,
        NTE,
        VAL_DATE,
        MAT_DATE,
        LOC_TERM,
        SECTOR,
        KHOI,
        CUS_TYPE,
        PHAN_KHUC,
        CUS_STATUS,
        INDUSTRY_CODE,
        CN,
        BRANCH_NAME_T24,
        PARENT_BRANCH_CODE_T24,
        PARENT_BRANCH_NAME_T24,
        TINH_THANH,
        VUNG_MIEN,
        TIEU_VUNG,
        CATEGORY,
        SUB_PRODUCT,
        PRODUCT_CODE,
        KENH_GD,
        LINE_T24,
        FTP_CODE,
        START_DATE,
        INT_RATE,
        source_table,
        SODU_THOIDIEM_VND,
        SODU_BINHQUAN_VND,
        SODU_BINHQUAN_LK_VND,
        DOANHSO_MO_MOI_VND,
        DOANHSO_QUAY_VONG_VND,
        DOANHSO_NOP_THEM_VND,
        DOANHSO_RUT_MOT_PHAN_VND,
        DOANHSO_TAT_TOAN_DH_VND,
        DOANHSO_TAT_TOAN_TH_VND,
        NOMINAL_INTEREST_VND,
        REAL_INTEREST_VND,
        INTEREST_FTP_VND,
        INTEREST_FTP_TT_VND,
        NOMINAL_INTEREST_VND_LK,
        REAL_INTEREST_VND_LK,
        INTEREST_FTP_VND_LK,
        INTEREST_FTP_TT_VND_LK
    ) (
        select
            to_date ('${PRD_ID}', 'YYYYMMDD') transaction_date,
            coalesce (a.SOTK, b.SOTK, c.SOTK, d.SOTK, e.SOTK) SOTK,
            a.GL COA_CODE,
            coalesce (
                a.MAKH,
                b.MAKH,
                c.MAKH,
                d.MAKH,
                g.MAKH,
                t.makh,
                u.makh
            ) MAKH,
            coalesce (
                a.NTE,
                g.CURRENCY_CODE,
                t.CURRENCY_CODE,
                u.CURRENCY_CODE
            ) NTE,
            coalesce (
                a.NGAYMS,
                g.ARRANGEMENT_OPENING_DATE,
                t.ARRANGEMENT_VALUE_DATE,
                u.ARRANGEMENT_OPENING_DATE
            ) VAL_DATE,
            coalesce (a.NGAYDH, t.MATURITY_DATE) MAT_DATE,
            a.KYHAN_THANG LOC_TERM,
            coalesce (a.SECTOR, h.sector) SECTOR,
            coalesce (a.KHOI, h.khoi) KHOI,
            (
                case
                    when h.creation_date >= trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'YEAR') THEN 'MOI'
                    else 'CU'
                end
            ) CUS_TYPE,
            (
                case
                    when nvl (a.KHOI, h.khoi) = 'CIB'
                    and nvl (a.SECTOR, h.sector) = '3035' then 'FDI'
                    when nvl (a.KHOI, h.khoi) = 'CIB' then 'CIB_CONLAI'
                    when nvl (a.KHOI, h.khoi) = 'SME' then m.PKKH
                    when nvl (a.SECTOR, h.sector) in (
                        '1688',
                        '1689',
                        '1690',
                        '1691',
                        '1699',
                        '1666',
                        '1660'
                    ) then 'INDIV_PRIVATE'
                    when nvl (a.SECTOR, h.sector) in ('1888', '1889', '1890', '1891', '1746', '1747') then 'INDIV_PRIORITY'
                    when nvl (a.KHOI, h.khoi) = 'INDIV' then 'INDIV_MASS'
                    else nvl (a.KHOI, h.khoi)
                END
            ) PHAN_KHUC,
            n.LC_ST_FIN CUS_STATUS,
            h.INDUSTRY_CODE INDUSTRY_CODE,
            coalesce (
                a.CN,
                g.BRANCH_CODE,
                t.BRANCH_CODE,
                u.BRANCH_CODE
            ) CN,
            k.BRANCH_NAME_T24 BRANCH_NAME_T24,
            k.PARENT_BRANCH_CODE_T24 PARENT_BRANCH_CODE_T24,
            k.PARENT_BRANCH_NAME_T24 PARENT_BRANCH_NAME_T24,
            k.TINH_THANH,
            k.VUNG_MIEN,
            k.TIEU_VUNG,
            coalesce (
                a.CATEGORY,
                g.CATE_CODE,
                t.CATE_CODE,
                u.CATE_CODE
            ) CATEGORY,
            coalesce (
                a.SUB_PRODUCT,
                g.SUB_PRODUCT_CODE,
                t.SUB_PRODUCT_CODE,
                u.SUB_PRODUCT_CODE
            ) SUB_PRODUCT,
            coalesce (
                a.PRODUCT_CODE,
                g.PRODUCT_CODE,
                t.PRODUCT_CODE,
                u.PRODUCT_CODE
            ) PRODUCT_CODE,
            case
                when nvl (l.SP_DV, '0') in ('SPSO', 'DVSO', 'SPS1', 'DVS1') then 'ONLINE'
                else 'OFFLINE'
            end KENH_GD,
            A.LINE_T24,
            A.FTP_CODE,
            nvl (a.START_DATE, t.ARRANGEMENT_OPENING_DATE) START_DATE,
            nvl (a.LS, t.INT_RATE) INT_RATE,
            a.source_table,
            nvl (a.DUCUOI_VND, 0) SODU_THOIDIEM_VND,
            nvl (b.SODU_BINHQUAN, 0) SODU_BINHQUAN_VND,
            nvl (c.SODU_BINHQUAN_LK, 0) SODU_BINHQUAN_LK_VND,
            nvl (d.DOANHSO_MO_MOI_VND, 0) DOANHSO_MO_MOI_VND,
            nvl (d.DOANHSO_QUAY_VONG_VND, 0) DOANHSO_QUAY_VONG_VND,
            nvl (d.DOANHSO_NOP_THEM_VND, 0) DOANHSO_NOP_THEM_VND,
            nvl (d.DOANHSO_RUT_MOT_PHAN_VND, 0) DOANHSO_RUT_MOT_PHAN_VND,
            nvl (d.DOANHSO_TAT_TOAN_DH_VND, 0) DOANHSO_TAT_TOAN_DH_VND,
            nvl (d.DOANHSO_TAT_TOAN_TH_VND, 0) DOANHSO_TAT_TOAN_TH_VND,
            nvl (e.NOMINAL_INTEREST_VND, 0) NOMINAL_INTEREST_VND,
            nvl (e.REAL_INTEREST_VND, 0) REAL_INTEREST_VND,
            nvl (e.INTEREST_FTP_VND, 0) INTEREST_FTP_VND,
            nvl (e.INTEREST_FTP_TT_VND, 0) INTEREST_FTP_TT_VND,
            nvl (e.NOMINAL_INTEREST_VND_LK, 0) NOMINAL_INTEREST_VND_LK,
            nvl (e.REAL_INTEREST_VND_LK, 0) REAL_INTEREST_VND_LK,
            nvl (e.INTEREST_FTP_VND_LK, 0) INTEREST_FTP_VND_LK,
            nvl (e.INTEREST_FTP_TT_VND_LK, 0) INTEREST_FTP_TT_VND_LK
        from
            (
                select
                    TRANSACTION_DATE,
                    SOTK,
                    NTE,
                    CATEGORY,
                    SUB_PRODUCT,
                    NGAYMS,
                    NGAYDH,
                    START_DATE,
                    MAKH,
                    TENKH,
                    SECTOR,
                    KHOI,
                    LINE_T24,
                    GL,
                    KYHAN_THANG,
                    PRODUCT_CODE,
                    FTP_CODE,
                    CN,
                    LS,
                    SOURCE_TABLE,
                    sum(SODU) SODU,
                    sum(DUCUOI_VND) DUCUOI_VND
                from
                    ETL.ORS_CAL_TR_TG_TK_M
                where
                    transaction_date = TO_DATE('${PRD_ID}', 'YYYYMMDD')
                group by
                    TRANSACTION_DATE,
                    SOTK,
                    NTE,
                    CATEGORY,
                    SUB_PRODUCT,
                    NGAYMS,
                    NGAYDH,
                    START_DATE,
                    MAKH,
                    TENKH,
                    SECTOR,
                    KHOI,
                    LINE_T24,
                    GL,
                    KYHAN_THANG,
                    PRODUCT_CODE,
                    FTP_CODE,
                    CN,
                    LS,
                    SOURCE_TABLE
            ) a full
            join ETL.TMP_TR_HDV_BQ b on a.sotk = b.sotk full
            join (
                select
                    SOTK,
                    makh,
                    sum (SODU_BQ_VND_LK) SODU_BINHQUAN_LK
                from
                    etl.ORS_CAL_TR_HDV_BQ_LK
                where
                    TRANSACTION_DATE = to_date ('${PRD_ID}', 'YYYYMMDD')
                group by
                    SOTK,
                    makh
            ) c on coalesce (a.SOTK, b.SOTK) = c.SOTK full
            join (
                select
                    SOTK,
                    MAKH,
                    sum (DOANHSO_MO_MOI_VND) DOANHSO_MO_MOI_VND,
                    sum (DOANHSO_QUAY_VONG_VND) DOANHSO_QUAY_VONG_VND,
                    sum (DOANHSO_NOP_THEM_VND) DOANHSO_NOP_THEM_VND,
                    sum (DOANHSO_RUT_MOT_PHAN_VND) DOANHSO_RUT_MOT_PHAN_VND,
                    sum (DOANHSO_TAT_TOAN_DH_VND) DOANHSO_TAT_TOAN_DH_VND,
                    sum (DOANHSO_TAT_TOAN_TH_VND) DOANHSO_TAT_TOAN_TH_VND
                from
                    apps.FIN_HDV_TRANS_DAILY
                where
                    TRANSACTION_DATE between trunc (to_date ('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
                    and to_date ('${PRD_ID}', 'YYYYMMDD')
                group by
                    SOTK,
                    MAKH
            ) d on coalesce (a.SOTK, b.SOTK, c.SOTK) = d.SOTK full
            join ETL.TMP_MB_AGG_NIM_M e on coalesce (a.SOTK, b.SOTK, c.SOTK, d.SOTK) = e.SOTK
            left join ETL.ODS_CASA_CONTRACT g on coalesce (a.SOTK, b.SOTK, c.SOTK, d.SOTK, e.SOTK) = g.ARRANGEMENT_NBR
            left join ETL.ODS_TD_CONTRACT t on coalesce (a.SOTK, b.SOTK, c.SOTK, d.SOTK, e.SOTK) = t.ARRANGEMENT_NBR
            left join ETL.ODS_INTERNAL_CONTRACT U on coalesce (a.SOTK, b.SOTK, c.SOTK, d.SOTK, e.SOTK) = u.ARRANGEMENT_NBR
            left join etl.ORS_TR_KHACHHANG h on coalesce (
                a.MAKH,
                b.MAKH,
                c.MAKH,
                d.MAKH,
                g.MAKH,
                t.makh,
                u.makh
            ) = h.makh
            left join ETL.TMP_REF_AICT_BRANCH_M k on k.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
            and coalesce (
                a.CN,
                g.BRANCH_CODE,
                t.BRANCH_CODE,
                u.BRANCH_CODE
            ) = k.BRANCH_CODE_T24
            left join etl.ORS_MB_PRODUCT_CODE l on coalesce (
                a.PRODUCT_CODE,
                g.PRODUCT_CODE,
                t.PRODUCT_CODE,
                u.PRODUCT_CODE
            ) = l.product_code
            left join etl.TMP_MB_SME_PKKH_M m on m.transaction_date = to_date ('${PRD_ID}', 'YYYYMMDD')
            and coalesce (
                a.MAKH,
                b.MAKH,
                c.MAKH,
                d.MAKH,
                g.MAKH,
                t.makh,
                u.makh
            ) = m.makh
            left join etl.ORS_TR_KHACHHANG_ACTIVE_M n 
--on n.data_date = to_date ('${PRD_ID}', 'YYYYMMDD')
            on coalesce (
                a.MAKH,
                b.MAKH,
                c.MAKH,
                d.MAKH,
                g.MAKH,
                t.makh,
                u.makh
            ) = n.makh
    )</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>tckt_dc</connection>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>784</xloc>
      <yloc>384</yloc>
      <attributes_kjc/>
    </entry>
