      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>SELECT 1
  FROM ETL.ODS_LOAN_CONTRACT
 WHERE ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.ORS_TR_KHACHHANG
 WHERE ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.ODS_OVD_CONTRACT
 WHERE ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.ODS_PD_CONTRACT
 WHERE ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.ORS_MB_PRODUCT_CODE
 WHERE ROWNUM = 1
UNION ALL
 SELECT 1
  FROM ETL.ORS_MB_CAR_RRTD_KHOANPHAIDOI
 WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD') AND ROWNUM = 1
UNION ALL
 SELECT 1 FROM DUAL WHERE '${NOTE}' = 'CHAY KHI CHUA CO KHOANPHAIDOI'
UNION ALL
SELECT 1
  FROM ETL.ORS_TR_KHACHHANG_ACTIVE_M
 WHERE DATA_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   AND ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.ODS_LOAN_BAL_MTH --ETL.ORS_TR_KU_M
 WHERE TXN_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   AND ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.ODS_LOAN_BAL_AVG_MTH
 WHERE TXN_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   AND ROWNUM = 1
UNION ALL
SELECT 1
  FROM ETL.REF_AICT_BRANCH_M
 WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
   AND ROWNUM = 1</custom_sql>
