    <entry>
      <name>ins syn_log FIN_LOAN_SMY_MONTHLY</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM,
	NOTE
  )
SELECT
  'FIN_LOAN_SMY_MONTHLY' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  count(1) SO_LUONG,
  'tckt_repo/etl_job/etl_job_FIN_LOAN_SMY_MONTHLY_v2' SOURCE_SYSTEM,
  '${NOTE}' NOTE
FROM
  APPS.FIN_LOAN_SMY_MONTHLY
WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')
</sql>
