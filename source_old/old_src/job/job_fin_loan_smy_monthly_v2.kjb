    <entry>
      <name>has FIN_LOAN_TRANS_DAILY</name>
      <description/>
      <type>EVAL_TABLE_CONTENT</type>
      <attributes/>
      <connection>tckt_dc</connection>
      <schemaname/>
      <tablename/>
      <success_condition>rows_count_greater</success_condition>
      <limit>0</limit>
      <is_custom_sql>Y</is_custom_sql>
      <is_usevars>Y</is_usevars>
      <custom_sql>/*
SELECT 1
FROM APPS.SYN_LOG
WHERE TABLE_NAME = 'FIN_LOAN_TRANS_DAILY'
      AND TRUNC(SYSDATE - 1) = SYN_DATE
*/
with tmp_log as (
select count(1) soluong from (
SELECT distinct syn_date from APPS.syn_log
where upper(table_name) = 'FIN_LOAN_TRANS_DAILY'
and syn_date between trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
and to_date('${PRD_ID}', 'YYYYMMDD')
AND SO_LUONG &lt;&gt; 0
)
),
tmp_working_day as (
SELECT count(1) working_day FROM
apps.mb_dim_time
where day_date between 
trunc(to_date('${PRD_ID}', 'YYYYMMDD'), 'MONTH')
and to_date('${PRD_ID}', 'YYYYMMDD')
and is_working_day = 1
)
select 1
from
tmp_log log
full join tmp_working_day wrk
on 1=1
where log.soluong = wrk.working_day</custom_sql>
      <add_rows_result>N</add_rows_result>
      <clear_result_rows>Y</clear_result_rows>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>608</xloc>
      <yloc>96</yloc>
      <attributes_kjc/>
