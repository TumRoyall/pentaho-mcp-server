    <entry>
      <name>move data</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>create table etl.ods_casa_contract as (
    select
        CASA_CONTRACT_ID,
        SOURCE_TABLE_NAME,
        ARRANGEMENT_KEY,
        ARRANGEMENT_NBR,
        BRANCH_CODE,
        CATE_CODE,
        OPEN_CATE_CODE,
        SUB_PRODUCT_ID,
        PRODUCT_CONDITION,
        CURRENCY_CODE,
        PARTY_KEY,
        MAKH,
        REFERRAL_PARTY_KEY,
        OPEN_CHANNEL_CODE,
        PARTNER_SHOP_CODE,
        CAMPAIGN_CODE,
        ARRANGEMENT_OPENING_DATE,
        ARRANGEMENT_CLOSED_DATE,
        ARRANGEMENT_STATUS,
        LEGACY_CONTRACT_ID,
        HIGH_VOLUME_TXN_FLAG,
        ARRANGEMENT_TTL_1,
        ARRANGEMENT_TTL_2,
        ARRANGEMENT_SHORT_TTL,
        ARRANGEMENT_MNEMONIC,
        NXT_ACCOUNT_CAP_DATE,
        CONSOL_KEY,
        PATT_ACCOUNT_CODE,
        CONDITION_GROUP_ACCOUNT,
        RM_CODE,
        TILL_TELLER_CODE,
        INITIATE_RECORD_TIME,
        INPUTTER,
        COMMIT_DATE_TIME,
        AUTHORISER,
        AUTH_DEPT_CODE,
        AUTH_DATE_TIME,
        DATA_LAST_UPDATE_DATE,
        CREATED_BY,
        CREATION_DATE,
        LAST_UPDATED_BY,
        LAST_UPDATE_DATE,
        PRODUCT_CODE,
        SUB_PRODUCT_CODE,
        LAST_TXN_DATE,
        BEAUTY_NBR_ACCOUNT_FLAG,
        ANTCP_ACCRUED_INT_AMT,
        FTP_CODE,
        FTP_FLAG,
        CHQ_WD_ALLOWED_FLAG
    from
        etl.ods_casa_contract_old
    where
        ARRANGEMENT_NBR not in (
            select ARRANGEMENT_NBR from etl.tmp_ods_casa_contract
        )
    union
    all
    select
        CASA_CONTRACT_ID,
        SOURCE_TABLE_NAME,
        ARRANGEMENT_KEY,
        ARRANGEMENT_NBR,
        BRANCH_CODE,
        CATE_CODE,
        OPEN_CATE_CODE,
        SUB_PRODUCT_ID,
        PRODUCT_CONDITION,
        CURRENCY_CODE,
        PARTY_KEY,
        MAKH,
        REFERRAL_PARTY_KEY,
        OPEN_CHANNEL_CODE,
        PARTNER_SHOP_CODE,
        CAMPAIGN_CODE,
        ARRANGEMENT_OPENING_DATE,
        ARRANGEMENT_CLOSED_DATE,
        ARRANGEMENT_STATUS,
        LEGACY_CONTRACT_ID,
        HIGH_VOLUME_TXN_FLAG,
        ARRANGEMENT_TTL_1,
        ARRANGEMENT_TTL_2,
        ARRANGEMENT_SHORT_TTL,
        ARRANGEMENT_MNEMONIC,
        NXT_ACCOUNT_CAP_DATE,
        CONSOL_KEY,
        PATT_ACCOUNT_CODE,
        CONDITION_GROUP_ACCOUNT,
        RM_CODE,
        TILL_TELLER_CODE,
        INITIATE_RECORD_TIME,
        INPUTTER,
        COMMIT_DATE_TIME,
        AUTHORISER,
        AUTH_DEPT_CODE,
        AUTH_DATE_TIME,
        DATA_LAST_UPDATE_DATE,
        CREATED_BY,
        CREATION_DATE,
        LAST_UPDATED_BY,
        LAST_UPDATE_DATE,
        PRODUCT_CODE,
        SUB_PRODUCT_CODE,
        LAST_TXN_DATE,
        BEAUTY_NBR_ACCOUNT_FLAG,
        ANTCP_ACCRUED_INT_AMT,
        FTP_CODE,
        FTP_FLAG,
        CHQ_WD_ALLOWED_FLAG
    from
        etl.tmp_ods_casa_contract
);

drop table etl.ods_casa_contract_old purge;

create index idx_arrangement_nbr on etl.ods_casa_contract(ARRANGEMENT_NBR) nologging;</sql>
