      <name>ins syn_log</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO
  APPS.SYN_LOG (
    TABLE_NAME,
    STATUS,
    TRANSACTION_DATE,
    SYN_DATE,
    ETL_DATE,
    SO_LUONG,
    SOURCE_SYSTEM
  )
SELECT
  'ODS_CASA_CONTRACT' TABLE_NAME,
  '1' STATUS,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') TRANSACTION_DATE,
  TO_DATE('${PRD_ID}', 'YYYYMMDD') SYN_DATE,
  SYSDATE ETL_DATE,
  count(1) SO_LUONG,
  'TCKT_REPO/etl_job/etl_job_ODS_CASA_CONTRACT' SOURCE_SYSTEM
FROM
  ETL.ODS_CASA_CONTRACT
--where transaction_date = to_date('${PRD_ID}', 'YYYYMMDD')
--and rownum =1
  --WHERE TRANSACTION_DATE = TO_DATE('${PRD_ID}', 'YYYYMMDD')</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
