  "description": "MCP server for knowledge-first Pentaho Kettle job/transformation inspection, editing, static validation, and optional local PDI runtime tools.",
  "type": "module",
  "bin": {
    "pentaho-mcp-server": "src/index.js"
  },
  "scripts": {
