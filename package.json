    "docs/development.md",
    "docs/documentation-facts.md",
    "docs/install.md",
    "docs/operations.md",
    "docs/pdi94-evidence-report.md",
    "docs/tools-reference.md",
    "docs/workflow-guide.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6"
  }
}
